  /* ── Explore: Yield Strength ──────────────────────────── */
  function drawExploreYieldStrength(cx, cy) {
    var ox = cx - 180, oy = cy + 120;
    var gw = 350, gh = 250;

    /* Axes */
    eCtx.strokeStyle = '#6b7a99';
    eCtx.lineWidth = 1.5;
    eCtx.beginPath(); eCtx.moveTo(ox, oy); eCtx.lineTo(ox, oy - gh); eCtx.stroke();
    eCtx.beginPath(); eCtx.moveTo(ox, oy); eCtx.lineTo(ox + gw, oy); eCtx.stroke();

    /* Curve */
    eCtx.strokeStyle = '#1e88e5';
    eCtx.lineWidth = 2.5;
    eCtx.beginPath();
    eCtx.moveTo(ox, oy);
    for (var t = 0; t <= 1; t += 0.02) {
      var x, y;
      if (t < 0.15) {
        x = t * gw;
        y = t * gh * 1.3;
      } else {
        x = t * gw;
        y = (0.15 * 1.3 + (t - 0.15) * 0.4) * gh;
        y = Math.min(y, gh * 0.85);
      }
      eCtx.lineTo(ox + x, oy - y);
    }
    eCtx.stroke();

    /* 0.2% offset line */
    var offsetX = 0.05 * gw;
    eCtx.strokeStyle = '#4caf50';
    eCtx.lineWidth = 1.5;
    eCtx.setLineDash([4, 3]);
    eCtx.beginPath();
    eCtx.moveTo(ox + offsetX, oy);
    eCtx.lineTo(ox + offsetX + 100, oy - 170);
    eCtx.stroke();
    eCtx.setLineDash([]);

