  if (elBtnNewQuiz) {
    elBtnNewQuiz.addEventListener('click', startQuiz);
  }

  /* Window resize */
  window.addEventListener('resize', function () {
    initCanvases();
    if (state.mode === 'simulate') {
      drawMachine();
      drawGraph();
    }
    if (state.mode === 'explore') {
      selectConcept(state.expIdx);
    }
  });

  /* Keyboard shortcuts */
  document.addEventListener('keydown', function (e) {
    if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
    if (e.key === '1') setMode('simulate');
    if (e.key === '2') setMode('explore');
    if (e.key === '3') setMode('practice');
    if (e.key === '4') setMode('quiz');
    if (e.key === ' ' && state.mode === 'simulate') {
      e.preventDefault();
      if (state.animPhase === 'idle' && state.mounted) {
        startTest();
      } else if (state.animPhase === 'idle' && !state.mounted) {
        advanceStep(4);
        startMount();
      }
