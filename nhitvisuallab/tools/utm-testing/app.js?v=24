  /* ================================================================
     S19 — UNIT TOGGLE, STEPPER, & EXPORT
     ================================================================ */

  /* ── Unit toggle ── */
  (function () {
    var toggle = $('unit-toggle');
    if (!toggle) return;
    var pills = toggle.querySelectorAll('.pill');
    for (var ui = 0; ui < pills.length; ui++) {
      (function (pill) {
        pill.addEventListener('click', function () {
          unitSystem = pill.dataset.value;
          for (var p = 0; p < pills.length; p++) {
            var isActive = pills[p] === pill;
            pills[p].classList.toggle('active', isActive);
            pills[p].setAttribute('aria-pressed', isActive ? 'true' : 'false');
          }
          refreshUnits();
        });
      })(pills[ui]);
    }
  })();

  function refreshUnits() {
    /* Update slider labels */
    var lblDia = $('lbl-dia');
    var lblGL = $('lbl-gl');
    var lblSpeed = $('lbl-speed');
    if (lblDia) lblDia.textContent = 'Diameter (' + uLabel('length') + ')';
    if (lblGL) lblGL.textContent = 'Gauge Length (' + uLabel('length') + ')';
    if (lblSpeed) lblSpeed.textContent = 'Speed (' + uLabel('speed') + ')';

    /* Update stepper display values (display only — internal stays SI) */
    var inDia = $('input-dia');
    var inGL = $('input-gl');
    var inSpeed = $('input-speed');
    if (inDia) inDia.value = roundN(toD(state.dia, 'length'), 2);
    if (inGL) inGL.value = roundN(toD(state.gl, 'length'), 2);
    if (inSpeed) inSpeed.value = roundN(toD(state.speed, 'speed'), 2);

    /* Re-render displays */
    updateBadges();
    /* Card captions otherwise only get written inside displayResults(), so
       before the first test they showed SI under an Imperial toggle. */
    updateResultUnits();
    if (state.results) displayResults();
    drawGraph();
    drawMachine();
    if (typeof updateAllFills === 'function') updateAllFills();
  }

  /* ── Stepper inputs with fill-bar ── */
  var elInputDia = $('input-dia');
  var elInputGL = $('input-gl');
  var elInputSpeed = $('input-speed');
  var elFillDia = $('fill-dia');
  var elFillGL = $('fill-gl');
  var elFillSpeed = $('fill-speed');

  /* Update fill-bar width as percentage of range */
  function updateFillBar(fillEl, val, min, max) {
    if (!fillEl) return;
    var pct = clamp((val - min) / (max - min) * 100, 0, 100);
    fillEl.style.width = pct + '%';
  }
  function updateAllFills() {
    updateFillBar(elFillDia, state.dia, 6, 25);
    updateFillBar(elFillGL, state.gl, 25, 200);
    updateFillBar(elFillSpeed, state.speed, 1, 50);
  }

  /* Live update when mounted — regenerate curve without losing mount */
  function liveUpdateGeometry() {
    state.curveData = generateCurveData(MATERIALS[state.matIdx], state.testType);
    drawMachine();
    drawGraph();
  }

  function syncStepper(inputEl, sliderEl, stateKey, stepSize, fillEl, sMin, sMax) {
    if (!inputEl || !sliderEl) return;

    /* Input change → state + slider */
    inputEl.addEventListener('change', function () {
      var displayVal = parseFloat(this.value);
      if (isNaN(displayVal)) return;
      var siVal = unitSystem === 'imperial' ? displayVal / U(stateKey === 'speed' ? 'speed' : 'length').factor : displayVal;
      siVal = clamp(Math.round(siVal / stepSize) * stepSize, parseFloat(sliderEl.min), parseFloat(sliderEl.max));
      state[stateKey] = siVal;
      sliderEl.value = siVal;
      this.value = roundN(toD(siVal, stateKey === 'speed' ? 'speed' : 'length'), 2);
      updateFillBar(fillEl, siVal, sMin, sMax);
      if (state.mounted && state.animPhase === 'idle') {
        liveUpdateGeometry();
      } else {
        drawMachine(); drawGraph();
      }
    });

    /* Slider change → state + input (hidden slider still used by stepper buttons) */
    sliderEl.addEventListener('input', function () {
      state[stateKey] = parseFloat(this.value);
      inputEl.value = roundN(toD(state[stateKey], stateKey === 'speed' ? 'speed' : 'length'), 2);
      updateFillBar(fillEl, state[stateKey], sMin, sMax);
      if (!state.mounted) {
        if (stateKey === 'dia' || stateKey === 'gl') advanceStep(1);
        else if (stateKey === 'speed') advanceStep(3);
      }
      if (state.mounted && state.animPhase === 'idle') {
        liveUpdateGeometry();
      } else {
        drawMachine();
      }
    });
  }

  syncStepper(elInputDia, elSliderDia, 'dia', 1, elFillDia, 6, 25);
  syncStepper(elInputGL, elSliderGL, 'gl', 5, elFillGL, 25, 200);
  syncStepper(elInputSpeed, elSliderSpeed, 'speed', 1, elFillSpeed, 1, 50);
  updateAllFills();

  /* Stepper +/- buttons with hold-to-repeat */
  (function () {
    var btns = document.querySelectorAll('.stepper-btn');
    for (var bi = 0; bi < btns.length; bi++) {
      (function (btn) {
        var timer = null, interval = null;
        function doStep() {
          var target = $(btn.dataset.target);
          if (!target) return;
          var step = parseFloat(target.step) || 1;
          var dir = parseInt(btn.dataset.dir);
          var val = parseFloat(target.value) + step * dir;
          val = clamp(val, parseFloat(target.min), parseFloat(target.max));
          target.value = val;
          target.dispatchEvent(new Event('input'));
        }
        btn.addEventListener('pointerdown', function (e) {
          e.preventDefault();
          doStep();
          timer = setTimeout(function () {
            interval = setInterval(doStep, 80);
          }, 400);
        });
        function stopRepeat() {
          clearTimeout(timer);
          clearInterval(interval);
        }
        btn.addEventListener('pointerup', stopRepeat);
        btn.addEventListener('pointerleave', stopRepeat);
      })(btns[bi]);
    }
  })();

  /* ── Export CSV ── */
  var elExportRow = $('export-row');
  var elBtnCSV = $('btn-export-csv');
  var elBtnPNG = $('btn-export-png');

  if (elBtnCSV) {
    elBtnCSV.addEventListener('click', function () {
      if (!state.curveData || state.curveData.length === 0) return;
      var mat = MATERIALS[state.matIdx];
      var A0 = Math.PI * Math.pow(state.dia / 2, 2);
      var rows = ['Strain,Stress (' + uLabel('stress') + '),Load (' + uLabel('force') + '),Extension (' + uLabel('length') + ')'];
      for (var ci = 0; ci < state.curveData.length; ci++) {
        var pt = state.curveData[ci];
        var load = pt.stress * A0 / 1000;
        var ext = pt.strain * state.gl;
        rows.push(
          pt.strain.toFixed(6) + ',' +
          toD(pt.stress, 'stress').toFixed(2) + ',' +
          toD(load, 'force').toFixed(3) + ',' +
          toD(ext, 'length').toFixed(4)
        );
      }
      var blob = new Blob([rows.join('\n')], { type: 'text/csv' });
      var url = URL.createObjectURL(blob);
      var a = document.createElement('a');
      a.href = url;
      a.download = 'utm-' + mat.id + '-' + state.testType + '.csv';
      a.click();
      URL.revokeObjectURL(url);
    });
  }

  /* ── Export PNG (graph canvas with watermark) ── */
  if (elBtnPNG) {
    elBtnPNG.addEventListener('click', function () {
      var graphCanvas = $('graph-canvas');
      if (!graphCanvas) return;
      var mat = MATERIALS[state.matIdx];

      /* Capture the CURRENT graph state. The toggle panel is an HTML
         overlay (not canvas pixels) so it is never exported; just clear
         any transient hover tooltip and repaint so the snapshot is clean. */
      if (state.ghostHover) { state.ghostHover = null; }
      drawGraph();

      /* Draw watermark on a temporary canvas copy */
      var tmp = document.createElement('canvas');
      tmp.width = graphCanvas.width;
      tmp.height = graphCanvas.height;
      var tc = tmp.getContext('2d');
      tc.drawImage(graphCanvas, 0, 0);

      /* Watermark — bottom-right corner */
      var fontSize = Math.round(tmp.width * 0.022);
      if (fontSize < 10) fontSize = 10;
      tc.font = '600 ' + fontSize + 'px "Segoe UI", system-ui, sans-serif';
      tc.textAlign = 'right';
      tc.textBaseline = 'bottom';
      tc.fillStyle = 'rgba(255,255,255,0.25)';
      tc.fillText('mechsimulator.com', tmp.width - 12, tmp.height - 8);

      var a = document.createElement('a');
      a.href = tmp.toDataURL('image/png');
      a.download = 'utm-' + mat.id + '-' + state.testType + '-curve.png';
      a.click();
    });
  }

