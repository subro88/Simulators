  /* ── Explore: UTS ──────────────────────────────── */
  function drawExploreUTS(cx, cy) {
    var ox = cx - 180, oy = cy + 120;
    var gw = 350, gh = 250;

    /* Axes */
    eCtx.strokeStyle = '#6b7a99';
    eCtx.lineWidth = 1.5;
    eCtx.beginPath(); eCtx.moveTo(ox, oy); eCtx.lineTo(ox, oy - gh); eCtx.stroke();
    eCtx.beginPath(); eCtx.moveTo(ox, oy); eCtx.lineTo(ox + gw, oy); eCtx.stroke();

    /* Full curve with peak */
    eCtx.strokeStyle = '#1e88e5';
    eCtx.lineWidth = 2.5;
    eCtx.beginPath();
    eCtx.moveTo(ox, oy);
    var peakX = 0, peakY = 0;
    for (var t = 0; t <= 1; t += 0.01) {
      var x = t * gw;
      var y;
      if (t < 0.08) {
        y = t * gh * 3;
      } else if (t < 0.5) {
        y = 0.08 * 3 * gh + (t - 0.08) * 1.1 * gh;
        y = Math.min(y, gh * 0.9);
      } else if (t < 0.55) {
        y = gh * 0.9;
      } else {
        y = gh * 0.9 - (t - 0.55) * 1.2 * gh;
        y = Math.max(y, gh * 0.3);
      }
      eCtx.lineTo(ox + x, oy - y);
      if (y > peakY) { peakY = y; peakX = x; }
    }
    eCtx.stroke();

    /* Peak marker */
    eCtx.fillStyle = '#f44336';
    eCtx.beginPath();
    eCtx.arc(ox + peakX, oy - peakY, 5, 0, Math.PI * 2);
    eCtx.fill();

    /* Horizontal dashed line at UTS */
    eCtx.strokeStyle = 'rgba(244,67,54,0.4)';
    eCtx.lineWidth = 1;
    eCtx.setLineDash([4, 3]);
    eCtx.beginPath();
    eCtx.moveTo(ox, oy - peakY);
    eCtx.lineTo(ox + peakX, oy - peakY);
    eCtx.stroke();
    eCtx.setLineDash([]);

    /* Label */
    eCtx.fillStyle = '#f44336';
    eCtx.font = 'bold 12px "Courier New", monospace';
    eCtx.textAlign = 'left';
    eCtx.fillText('UTS = F_max / A\u2080', ox + peakX + 12, oy - peakY - 5);

    /* Annotations */
    eCtx.fillStyle = '#81c784';
    eCtx.font = '500 9px "Courier New", monospace';
    eCtx.textAlign = 'center';
    eCtx.fillText('Necking begins', ox + peakX + 30, oy - peakY + 25);

    drawExploreTitleLabel('Ultimate Tensile Strength (UTS)');
  }

