  /* 13. Force Arrows */
  function drawForceArrows(chY) {
    if (state.animPhase !== 'testing' && state.animPhase !== 'fracture') return;

    var curLoad = getCurrentLoad();
    /* Arrow shaft length scales with load up to a cap */
    var arrowLen = Math.min(curLoad / 2, 30) + 12;
    /* Thickness scales with load: 1.6 → 4.2 over 0 → 100 kN */
    var lw = 1.6 + Math.min(curLoad / 100, 1) * 2.6;
    var arrowHeadH = 7 + lw * 0.7;
    var arrowHeadW = 4 + lw * 0.9;

    mCtx.save();
    mCtx.globalAlpha = 0.85;
    mCtx.strokeStyle = '#ff5252';
    mCtx.fillStyle = '#ff5252';
    mCtx.lineWidth = lw;
    mCtx.lineCap = 'round';

    var labelX, labelY;

    if (state.testType === 'tensile') {
      var ax = MCX - 38;
      /* Upper arrow — pointing UP (tension pulls grip up) */
      var topShaftBot = chY + 14 + 5 + arrowLen;
      var topShaftTop = chY + 14 + 5;
      mCtx.beginPath();
      mCtx.moveTo(ax, topShaftBot);
      mCtx.lineTo(ax, topShaftTop + arrowHeadH);
      mCtx.stroke();
      mCtx.beginPath();
      mCtx.moveTo(ax, topShaftTop);
      mCtx.lineTo(ax - arrowHeadW, topShaftTop + arrowHeadH);
      mCtx.lineTo(ax + arrowHeadW, topShaftTop + arrowHeadH);
      mCtx.closePath();
      mCtx.fill();

      /* Lower arrow — pointing DOWN */
      var botShaftTop = MPLATFORM_Y + MPLATFORM_H + 5;
      var botShaftBot = botShaftTop + arrowLen;
      mCtx.beginPath();
      mCtx.moveTo(ax, botShaftTop);
      mCtx.lineTo(ax, botShaftBot - arrowHeadH);
      mCtx.stroke();
      mCtx.beginPath();
      mCtx.moveTo(ax, botShaftBot);
      mCtx.lineTo(ax - arrowHeadW, botShaftBot - arrowHeadH);
      mCtx.lineTo(ax + arrowHeadW, botShaftBot - arrowHeadH);
      mCtx.closePath();
      mCtx.fill();

      labelX = ax - 4;
      labelY = topShaftTop + arrowLen / 2 + 3;
    } else {
      var axC = MCX + 38;
      /* Upper arrow — pointing DOWN (compression pushes down) */
      var topCY = chY + 14 + 5;
      var topCBot = topCY + arrowLen;
      mCtx.beginPath();
      mCtx.moveTo(axC, topCY);
      mCtx.lineTo(axC, topCBot - arrowHeadH);
      mCtx.stroke();
      mCtx.beginPath();
      mCtx.moveTo(axC, topCBot);
      mCtx.lineTo(axC - arrowHeadW, topCBot - arrowHeadH);
      mCtx.lineTo(axC + arrowHeadW, topCBot - arrowHeadH);
      mCtx.closePath();
      mCtx.fill();

      /* Lower arrow — pointing UP */
      var botCBot = MPLATFORM_Y + MPLATFORM_H + arrowLen;
      var botCTop = MPLATFORM_Y + MPLATFORM_H;
      mCtx.beginPath();
      mCtx.moveTo(axC, botCBot);
      mCtx.lineTo(axC, botCTop + arrowHeadH);
      mCtx.stroke();
      mCtx.beginPath();
      mCtx.moveTo(axC, botCTop);
      mCtx.lineTo(axC - arrowHeadW, botCTop + arrowHeadH);
      mCtx.lineTo(axC + arrowHeadW, botCTop + arrowHeadH);
      mCtx.closePath();
      mCtx.fill();

      labelX = axC + 4;
      labelY = topCY + arrowLen / 2 + 3;
    }

    /* F = X pill — sits next to the upper arrow, tracks chY (unit-aware) */
    var labelText = 'F = ' + toD(curLoad, 'force').toFixed(1) + ' ' + uLabel('force');
    mCtx.globalAlpha = 0.95;
    mCtx.font = 'bold 10px "Courier New", monospace';
    mCtx.textAlign = state.testType === 'tensile' ? 'right' : 'left';
    var textW = mCtx.measureText(labelText).width;
    var pillPad = 5;
    var pillW = textW + pillPad * 2;
    var pillH = 14;
    var pillX = state.testType === 'tensile' ? (labelX - pillW) : labelX;
    var pillY = labelY - 10;
    mCtx.fillStyle = 'rgba(20,10,10,0.78)';
    roundRect(mCtx, pillX, pillY, pillW, pillH, 3);
    mCtx.fill();
    mCtx.strokeStyle = '#ff5252';
    mCtx.lineWidth = 0.8;
    roundRect(mCtx, pillX, pillY, pillW, pillH, 3);
    mCtx.stroke();
    mCtx.fillStyle = '#ffcdd2';
    mCtx.textAlign = 'center';
    mCtx.fillText(labelText, pillX + pillW / 2, pillY + 10);

    mCtx.restore();
  }

