  });
  if (gabReset) gabReset.addEventListener('click', function () {
    resetTest(); drawMachine(); drawGraph();
  });
  if (gabCSV) gabCSV.addEventListener('click', function () {
    var btn = $('btn-export-csv'); if (btn) btn.click();
  });
  if (gabPNG) gabPNG.addEventListener('click', function () {
