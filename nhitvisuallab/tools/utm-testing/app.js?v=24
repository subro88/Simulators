       (low-hardening alloys like Al 6061) hold σu over a plateau, and the UTS
       point — where necking begins — is at the END of that plateau, not the
       first touch. */
    var maxStress = 0;
    var maxIdx = 0;
    for (var i = 0; i < curveData.length; i++) {
      if (curveData[i].stress >= maxStress) {
        maxStress = curveData[i].stress;
        maxIdx = i;
      }
    }
    return maxIdx;
  }

