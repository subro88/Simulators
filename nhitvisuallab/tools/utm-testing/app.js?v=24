  /* ── Guide blink — highlight the next action button ── */
  function updateGuideBlink() {
    if (gabMount) gabMount.classList.remove('cp-guide-blink');
    if (gabStart) gabStart.classList.remove('cp-guide-blink');
    if (gabReset) gabReset.classList.remove('cp-guide-blink');
    if (state.animPhase === 'complete') {
      if (gabReset) gabReset.classList.add('cp-guide-blink');
    } else if (state.animPhase === 'idle' && state.mounted) {
      if (gabStart) gabStart.classList.add('cp-guide-blink');
    } else if (state.animPhase === 'idle' && !state.mounted) {
      if (gabMount) gabMount.classList.add('cp-guide-blink');
