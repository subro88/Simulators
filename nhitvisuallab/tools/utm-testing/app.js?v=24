    eCtx.fill();
    eCtx.strokeStyle = '#455a64';
    eCtx.lineWidth = 1;
    eCtx.beginPath();
    eCtx.ellipse(cx, sy + sh, sw / 2, 12, 0, 0, Math.PI);
    eCtx.stroke();

    /* Dimension: diameter */
    eCtx.strokeStyle = '#f5c842';
    eCtx.lineWidth = 1;
    eCtx.beginPath();
    eCtx.moveTo(sx - 20, sy);
    eCtx.lineTo(sx + sw + 20, sy);
    eCtx.stroke();
    eCtx.fillStyle = '#f5c842';
    eCtx.font = 'bold 10px "Courier New", monospace';
    eCtx.textAlign = 'center';
    eCtx.fillText('d = 20 mm', cx, sy - 20);

    /* Dimension: height */
    eCtx.strokeStyle = '#4caf50';
    eCtx.beginPath();
    eCtx.moveTo(sx + sw + 30, sy);
    eCtx.lineTo(sx + sw + 30, sy + sh);
    eCtx.stroke();
    eCtx.fillStyle = '#4caf50';
    eCtx.textAlign = 'left';
    eCtx.fillText('L = 50 mm', sx + sw + 35, cy + 4);
    eCtx.fillText('(L/d = 2.5)', sx + sw + 35, cy + 18);

    /* Compression arrows */
    eCtx.strokeStyle = '#f44336';
    eCtx.lineWidth = 2;
    eCtx.beginPath(); eCtx.moveTo(cx, sy - 40); eCtx.lineTo(cx, sy - 15); eCtx.stroke();
    eCtx.fillStyle = '#f44336';
    eCtx.beginPath(); eCtx.moveTo(cx, sy - 12); eCtx.lineTo(cx - 5, sy - 20); eCtx.lineTo(cx + 5, sy - 20); eCtx.closePath(); eCtx.fill();
    eCtx.beginPath(); eCtx.moveTo(cx, sy + sh + 40); eCtx.lineTo(cx, sy + sh + 15); eCtx.stroke();
    eCtx.beginPath(); eCtx.moveTo(cx, sy + sh + 12); eCtx.lineTo(cx - 5, sy + sh + 20); eCtx.lineTo(cx + 5, sy + sh + 20); eCtx.closePath(); eCtx.fill();

