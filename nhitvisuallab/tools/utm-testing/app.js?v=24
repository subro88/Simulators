  /* ================================================================
     S10 — SPECIMEN DEFORMATION
     ================================================================ */
  /* ASTM E8 dog-bone profile multiplier vs frac [0..1] along the VISIBLE
     specimen length (between grip jaws). Shoulders are mostly hidden inside
     the jaws, so the visible portion is a long parallel gauge with short
     fillet flares at each grip interface. */
  function dogBoneShape(frac) {
    var shoulderMul = 1.28;     /* small visible flare at grip ends */
    var filletEnd = 0.12;        /* upper fillet ends here */
    var filletStart = 0.88;     /* lower fillet starts here */
    if (frac >= filletEnd && frac <= filletStart) return 1.0;
    var t;
    if (frac < filletEnd) {
      t = frac / filletEnd;      /* 0 at grip, 1 at gauge */
      return shoulderMul + (1.0 - shoulderMul) * 0.5 * (1 - Math.cos(Math.PI * t));
    }
    t = (frac - filletStart) / (1 - filletStart);
    return 1.0 + (shoulderMul - 1.0) * 0.5 * (1 - Math.cos(Math.PI * t));
  }

  function getSpecimenProfile() {
    var mat = MATERIALS[state.matIdx];
    var baseDia = state.dia;
    var baseHW = baseDia / 2;
    var profile = [];
    /* Dog-bone only makes sense for tensile specimens (ASTM E8).
       Compression uses a short cylinder per ASTM E9. */
    var useDogBone = state.testType === 'tensile';

    if (state.animPhase === 'idle' && !state.mounted) {
      /* Default specimen shape — dog-bone for tensile, cylinder for compression */
      for (var i = 0; i <= 40; i++) {
        var fi = i / 40;
        profile.push({ frac: fi, hw: baseHW * (useDogBone ? dogBoneShape(fi) : 1) });
      }
      return { profile: profile, fractured: false };
    }

    if (state.testType === 'tensile') {
      var curStrain = getCurStrain();
      var utsIdx = state.curveData.length > 0 ? findUTSIndex(state.curveData) : 0;
      var tUTS = utsIdx / Math.max(state.curveData.length, 1);

      for (var ti = 0; ti <= 40; ti++) {
        var frac = ti / 40;
        var dbMul = dogBoneShape(frac);
        var inGauge = dbMul < 1.05; /* parallel gauge & inner fillet */
        var hw = baseHW * dbMul;

        /* Poisson narrowing — only in the gauge region (shoulders don't neck) */
        if (inGauge) {
          hw *= (1 - mat.nu * Math.abs(curStrain) * 0.3);
        }

        /* Necking after UTS — localized at center */
        if (state.testProgress > tUTS && mat.type !== 'brittle' && mat.type !== 'hyperelastic' && tUTS > 0) {
          var neckFrac = (state.testProgress - tUTS) / Math.max(1 - tUTS, 0.01);
          neckFrac = clamp(neckFrac, 0, 1);
          var distCenter = Math.abs(frac - 0.5) * 2;
          var neckReduce = neckFrac * 0.55 * Math.exp(-distCenter * distCenter * 8);
          hw *= (1 - neckReduce);
        }

        /* Brittle: very slight narrowing */
        if (mat.type === 'brittle' && inGauge) {
          hw *= (1 - Math.abs(curStrain) * 0.05);
        }

        profile.push({ frac: frac, hw: Math.max(hw, 0.5) });
      }
    } else {
      /* Compression: shortening + barreling */
      var curStrainC = Math.abs(getCurStrain());

      for (var ci = 0; ci <= 40; ci++) {
        var fracC = ci / 40;
        var hwC = baseHW;
        var distCenterC = Math.abs(fracC - 0.5) * 2;

        /* Barreling: center bulges outward */
        hwC *= (1 + mat.nu * curStrainC * (1 - distCenterC * distCenterC) * 1.5);

        /* Brittle materials: minimal barreling */
        if (mat.type === 'brittle') {
          hwC = baseHW * (1 + curStrainC * 0.1 * (1 - distCenterC * distCenterC));
        }

        profile.push({ frac: fracC, hw: Math.max(hwC, 0.5) });
      }
    }

    return { profile: profile, fractured: state.fractured };
  }

  function getCurStrain() {
    if (state.curveData.length === 0) return 0;
    var idx = clamp(state.plotIdx, 0, state.curveData.length - 1);
    return state.curveData[idx].strain;
  }

  function getCurrentStress() {
    if (state.curveData.length === 0) return 0;
    var idx = clamp(state.plotIdx, 0, state.curveData.length - 1);
    return state.curveData[idx].stress;
  }

  function getCurrentLoad() {
    var stress = getCurrentStress();
    var A0 = Math.PI * Math.pow(state.dia / 2, 2);
    return stress * A0 / 1000;
  }

  function getCurrentExtension() {
    return getCurStrain() * state.gl;
  }

  function initFracture() {
    state.fractured = true;
    state.fractureFlashT = performance.now();
    state.fractureParts = [];
    for (var fi = 0; fi < 8; fi++) {
      state.fractureParts.push({
        x: (Math.random() - 0.5) * 8,
        y: (Math.random() - 0.5) * 4,
        vx: (Math.random() - 0.5) * 4,
        vy: (Math.random() - 0.5) * 6,
        alpha: 1,
        size: 1.5 + Math.random() * 3,
        rot: Math.random() * Math.PI
      });
    }
    playFractureSound();
  }

  /* ── Fracture Sound (Web Audio API — no external files) ── */
  var audioCtx = null;

  function ensureAudio() {
    if (!audioCtx) {
      try { audioCtx = new (window.AudioContext || window.webkitAudioContext)(); }
      catch (e) { /* audio unavailable */ }
    }
    if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();
    return audioCtx;
  }

  /* Init audio context on first user interaction */
  document.addEventListener('pointerdown', function () { ensureAudio(); }, { once: true });

  function playFractureSound() {
    var ctx = ensureAudio();
    if (!ctx) return;

    var now = ctx.currentTime;

    /* White noise burst (crack) — 60ms */
    var noiseLen = 0.06;
    var noiseBuf = ctx.createBuffer(1, Math.ceil(ctx.sampleRate * noiseLen), ctx.sampleRate);
    var noiseData = noiseBuf.getChannelData(0);
    for (var ni = 0; ni < noiseData.length; ni++) {
      noiseData[ni] = (Math.random() * 2 - 1) * 0.6;
    }
    var noiseSrc = ctx.createBufferSource();
    noiseSrc.buffer = noiseBuf;

    /* Bandpass filter for crack character */
    var bpf = ctx.createBiquadFilter();
    bpf.type = 'bandpass';
    bpf.frequency.value = 2000;
    bpf.Q.value = 0.8;

    var noiseGain = ctx.createGain();
    noiseGain.gain.setValueAtTime(0.5, now);
    noiseGain.gain.exponentialRampToValueAtTime(0.001, now + noiseLen);

    noiseSrc.connect(bpf);
    bpf.connect(noiseGain);
    noiseGain.connect(ctx.destination);
    noiseSrc.start(now);
    noiseSrc.stop(now + noiseLen);

    /* Low thump — 100ms */
    var osc = ctx.createOscillator();
    osc.type = 'sine';
    osc.frequency.setValueAtTime(80, now);
    osc.frequency.exponentialRampToValueAtTime(30, now + 0.1);

    var thumpGain = ctx.createGain();
    thumpGain.gain.setValueAtTime(0.35, now);
    thumpGain.gain.exponentialRampToValueAtTime(0.001, now + 0.12);

    osc.connect(thumpGain);
    thumpGain.connect(ctx.destination);
    osc.start(now);
    osc.stop(now + 0.15);
  }

  /* ================================================================
     S11 — GRAPH CANVAS DRAWING
     ================================================================ */
  var GOX = 70, GOY = 400, GGW = 440, GGH = 360;

  function drawGraph() {
    if (!gCtx) return;
    gCtx.clearRect(0, 0, GW, GH);

    drawGraphBackground();
    drawGraphGrid();
    drawGraphAxes();
    if (state.compare) drawGhostCurve();
    drawStressStrainCurve();
    drawCursorDot();
    if (state.lblMarkers) drawKeyPoints();
    if (state.lblRegions) drawRegionLabels();
    if (state.lblEnergy) drawStrainEnergyArea();
    drawGraphTitle();
    if (state.compare && state.ghostHover) drawGhostTooltip();
  }

  /* Ghost overlay — previous completed test drawn faded on the
     CURRENT axes so the two are directly comparable. Stores screen
     points in state._ghostPts for hover hit-testing. */
  function drawGhostCurve() {
    state._ghostPts = null;
    var g = state.ghost;
    if (!g || !g.curveData || g.curveData.length === 0) return;
    var scales = getGraphScales();
    var pts = [];
    gCtx.save();
    gCtx.strokeStyle = 'rgba(150,160,180,0.55)';
    gCtx.lineWidth = 1.6;
    gCtx.setLineDash([5, 4]);
    gCtx.beginPath();
    for (var i = 0; i < g.curveData.length; i++) {
      var d = g.curveData[i];
      var px = GOX + (d.strain / scales.maxStrain) * GGW;
      var py = GOY - (d.stress / scales.maxStress) * GGH;
      px = clamp(px, GOX, GOX + GGW);
      py = clamp(py, GOY - GGH, GOY);
      if (i === 0) gCtx.moveTo(px, py); else gCtx.lineTo(px, py);
      pts.push({ x: px, y: py });
    }
    gCtx.stroke();
    gCtx.setLineDash([]);
    /* Faint inline tag at the curve end (always-on hint) */
    var last = pts[pts.length - 1];
    gCtx.fillStyle = 'rgba(170,180,200,0.7)';
    gCtx.font = '600 9px "Segoe UI", system-ui, sans-serif';
    gCtx.textAlign = 'left';
    var tagX = Math.min(last.x + 6, GOX + GGW - 70);
    gCtx.fillText('prev: ' + g.matName, tagX, clamp(last.y - 4, GOY - GGH + 10, GOY - 4));
    gCtx.restore();
    state._ghostPts = pts;
  }

  /* Tooltip shown while hovering the ghost curve */
  function drawGhostTooltip() {
    var h = state.ghostHover;
    if (!h) return;
    var label = h.name;
    gCtx.save();
    gCtx.font = 'bold 11px "Segoe UI", system-ui, sans-serif';
    var tw = gCtx.measureText(label).width;
    var pad = 7, bw = tw + pad * 2, bh = 20;
    var bx = clamp(h.x + 12, 4, GW - bw - 4);
    var by = clamp(h.y - bh - 6, 4, GH - bh - 4);
    gCtx.fillStyle = 'rgba(20,26,38,0.95)';
    roundRect(gCtx, bx, by, bw, bh, 5);
    gCtx.fill();
    gCtx.strokeStyle = 'rgba(150,160,180,0.8)';
    gCtx.lineWidth = 1;
    roundRect(gCtx, bx, by, bw, bh, 5);
    gCtx.stroke();
    gCtx.fillStyle = '#cfd6e4';
    gCtx.textAlign = 'left';
    gCtx.textBaseline = 'middle';
    gCtx.fillText(label, bx + pad, by + bh / 2 + 0.5);
    gCtx.textBaseline = 'alphabetic';
    /* marker dot on the curve */
    gCtx.fillStyle = '#aab4c8';
    gCtx.beginPath();
    gCtx.arc(h.px, h.py, 3.5, 0, Math.PI * 2);
    gCtx.fill();
    gCtx.restore();
  }

  /* Graph Background */
  function drawGraphBackground() {
    gCtx.fillStyle = '#0d1117';
    gCtx.fillRect(0, 0, GW, GH);
  }

  /* Graph Grid */
  function drawGraphGrid() {
    if (!showGrid) return;
    gCtx.strokeStyle = 'rgba(42,48,80,0.08)';
    gCtx.lineWidth = 0.5;
    for (var gx = GOX; gx <= GOX + GGW; gx += 44) {
      gCtx.beginPath(); gCtx.moveTo(gx, GOY - GGH); gCtx.lineTo(gx, GOY); gCtx.stroke();
    }
    for (var gy = GOY; gy >= GOY - GGH; gy -= 40) {
      gCtx.beginPath(); gCtx.moveTo(GOX, gy); gCtx.lineTo(GOX + GGW, gy); gCtx.stroke();
    }
  }

  /* Graph Axes */
  function drawGraphAxes() {
    var mat = MATERIALS[state.matIdx];
    var scales = getGraphScales();

    /* Y axis */
    gCtx.strokeStyle = '#6b7a99';
    gCtx.lineWidth = 1.5;
    gCtx.beginPath();
    gCtx.moveTo(GOX, GOY);
    gCtx.lineTo(GOX, GOY - GGH);
    gCtx.stroke();

    /* X axis */
    gCtx.beginPath();
    gCtx.moveTo(GOX, GOY);
    gCtx.lineTo(GOX + GGW, GOY);
    gCtx.stroke();

    /* Y-axis ticks and labels */
    gCtx.fillStyle = '#6b7a99';
    gCtx.font = '500 9px "Courier New", monospace';
    gCtx.textAlign = 'right';
    var numYTicks = 5;
    for (var yti = 0; yti <= numYTicks; yti++) {
      var sigVal = (yti / numYTicks) * scales.maxStress;
      var yPos = GOY - (yti / numYTicks) * GGH;
      /* Tick mark */
      gCtx.beginPath();
      gCtx.moveTo(GOX - 4, yPos);
      gCtx.lineTo(GOX, yPos);
      gCtx.stroke();
      /* Label */
      gCtx.fillText(Math.round(toD(sigVal, 'stress')), GOX - 8, yPos + 3);
    }

    /* X-axis ticks and labels */
    gCtx.textAlign = 'center';
    var numXTicks = 5;
    for (var xti = 0; xti <= numXTicks; xti++) {
      var epsVal = (xti / numXTicks) * scales.maxStrain;
      var xPos = GOX + (xti / numXTicks) * GGW;
      gCtx.beginPath();
      gCtx.moveTo(xPos, GOY);
      gCtx.lineTo(xPos, GOY + 4);
      gCtx.stroke();
      if (scales.maxStrain >= 1) {
        gCtx.fillText(roundN(epsVal * 100, 0) + '%', xPos, GOY + 16);
      } else {
        gCtx.fillText(roundN(epsVal, 3), xPos, GOY + 16);
      }
    }

    /* Axis labels */
    gCtx.fillStyle = '#8899b0';
    gCtx.font = '600 11px "Segoe UI", system-ui, sans-serif';
    gCtx.textAlign = 'center';
    gCtx.fillText(scales.maxStrain >= 1 ? 'Strain (%)' : 'Strain (\u03B5)', GOX + GGW / 2, GOY + 32);

    gCtx.save();
    gCtx.translate(18, GOY - GGH / 2);
    gCtx.rotate(-Math.PI / 2);
    gCtx.fillText('Stress \u03C3 (' + uLabel('stress') + ')', 0, 0);
    gCtx.restore();
  }

  function getGraphScales() {
    var mat = MATERIALS[state.matIdx];
    var maxStress, maxStrain;

    if (state.testType === 'tensile') {
      if (mat.type === 'hyperelastic') {
        maxStress = 35;
        maxStrain = mat.epsF * 1.1;
      } else if (mat.type === 'brittle') {
        maxStress = mat.sigmaU * 1.2;
        maxStrain = mat.epsF * 1.5;
      } else {
        maxStress = mat.sigmaU * 1.2;
        maxStrain = mat.epsF * 1.15;
      }
    } else {
      /* Compression */
      if (mat.type === 'brittle') {
        /* Scale from actual curve max using each material's comp/tensile ratio */
        var compMax = mat.sigmaU * (mat.compRatio || (mat.id === 'glass' ? 10 : 3.5));
        maxStress = compMax * 1.2;
        maxStrain = mat.id === 'glass' ? 0.01 : 0.015;
      } else if (mat.type === 'hyperelastic') {
        maxStress = 40;
        maxStrain = 0.9;
      } else {
        var compEps = Math.min(mat.epsF * 1.5, 0.5);
        maxStress = (mat.sigmaU || 400) * 1.5;
        maxStrain = compEps * 1.15;
      }
    }

    return { maxStress: maxStress, maxStrain: maxStrain };
  }

  /* Stress-Strain Curve */
  function drawStressStrainCurve() {
    if (state.curveData.length === 0) return;

    var scales = getGraphScales();
    var endIdx = state.plotIdx;
    if (state.animPhase === 'complete') endIdx = state.curveData.length;
    if (endIdx <= 0) return;

    gCtx.strokeStyle = '#1e88e5';
    gCtx.lineWidth = 2.5;
    gCtx.lineCap = 'round';
    gCtx.lineJoin = 'round';
    gCtx.beginPath();
    for (var ci = 0; ci < endIdx; ci++) {
      var pt = state.curveData[ci];
      var px = GOX + (pt.strain / scales.maxStrain) * GGW;
      var py = GOY - (pt.stress / scales.maxStress) * GGH;
      px = clamp(px, GOX, GOX + GGW);
      py = clamp(py, GOY - GGH, GOY);
      if (ci === 0) gCtx.moveTo(px, py);
      else gCtx.lineTo(px, py);
    }
    gCtx.stroke();
  }

  /* Cursor Dot */
  function drawCursorDot() {
    if (state.animPhase !== 'testing' || state.curveData.length === 0 || state.plotIdx <= 0) return;

    var scales = getGraphScales();
    var idx = clamp(state.plotIdx - 1, 0, state.curveData.length - 1);
    var pt = state.curveData[idx];
    var px = GOX + (pt.strain / scales.maxStrain) * GGW;
    var py = GOY - (pt.stress / scales.maxStress) * GGH;
    px = clamp(px, GOX, GOX + GGW);
    py = clamp(py, GOY - GGH, GOY);

    /* Outer glow */
    gCtx.fillStyle = 'rgba(30,136,229,0.2)';
    gCtx.beginPath();
    gCtx.arc(px, py, 12, 0, Math.PI * 2);
    gCtx.fill();

    /* Inner dot */
    gCtx.fillStyle = '#1e88e5';
    gCtx.beginPath();
    gCtx.arc(px, py, 5, 0, Math.PI * 2);
    gCtx.fill();

    /* White center */
    gCtx.fillStyle = '#fff';
    gCtx.beginPath();
    gCtx.arc(px, py, 2, 0, Math.PI * 2);
    gCtx.fill();
  }

  /* Key Points on curve */
  function drawKeyPoints() {
    if (state.curveData.length === 0) return;
    var scales = getGraphScales();
    var mat = MATERIALS[state.matIdx];
    var endIdx = state.plotIdx;
    if (state.animPhase === 'complete') endIdx = state.curveData.length;

    /* Yield point */
    if (mat.sigmaY > 0 && mat.type !== 'hyperelastic') {
      var yIdx = findYieldIndex(state.curveData, mat);
      if (yIdx >= 0 && yIdx < endIdx) {
        var yPt = state.curveData[yIdx];
        var ypx = GOX + (yPt.strain / scales.maxStrain) * GGW;
        var ypy = GOY - (yPt.stress / scales.maxStress) * GGH;

        /* Green dot */
        gCtx.fillStyle = '#4caf50';
        gCtx.beginPath();
        gCtx.arc(ypx, ypy, 4, 0, Math.PI * 2);
        gCtx.fill();

        /* Label */
        gCtx.fillStyle = '#4caf50';
        gCtx.font = 'bold 10px "Courier New", monospace';
        gCtx.textAlign = 'left';
        gCtx.fillText('\u03C3y = ' + Math.round(toD(yPt.stress, 'stress')) + ' ' + uLabel('stress'), ypx + 8, ypy - 4);

        /* 0.2% offset construction line for ductile-gradual materials.
           Parallel to the initial elastic slope (E), shifted right by ε=0.002.
           Its intersection with the curve defines σy. Shown after the test
           completes so it doesn't clutter the live curve. */
        if (state.lblOffset
            && mat.type === 'ductile-gradual'   /* very-ductile yield is marked
               at σy on the elastic line, not by the offset construction */
            && state.animPhase === 'complete') {
          gCtx.save();
          gCtx.strokeStyle = 'rgba(129,212,134,0.85)';
          gCtx.lineWidth = 1.2;
          gCtx.setLineDash([5, 3]);
          /* Use the actual yield point as the upper anchor — the line
             must visibly pass through the σy marker. */
          var offStart = 0.002;
          var ox1 = GOX + (offStart / scales.maxStrain) * GGW;
          var oy1 = GOY;
          /* Extend slightly beyond σy for visual clarity */
          var topStress = yPt.stress * 1.12;
          var topStrain = offStart + topStress / mat.E;
          var ox2 = GOX + (topStrain / scales.maxStrain) * GGW;
          var oy2 = GOY - (topStress / scales.maxStress) * GGH;
          gCtx.beginPath();
          gCtx.moveTo(ox1, oy1);
          gCtx.lineTo(ox2, oy2);
          gCtx.stroke();
          gCtx.setLineDash([]);

          /* Foot tick mark at ε=0.002 on the strain axis */
          gCtx.strokeStyle = 'rgba(129,212,134,0.7)';
          gCtx.lineWidth = 1.2;
          gCtx.beginPath();
          gCtx.moveTo(ox1, GOY);
          gCtx.lineTo(ox1, GOY + 4);
          gCtx.stroke();

          /* Label */
          gCtx.fillStyle = 'rgba(129,212,134,0.95)';
          gCtx.font = '600 9px "Courier New", monospace';
          gCtx.textAlign = 'left';
          gCtx.fillText('0.2% offset', ox1 + 3, GOY - 4);
          gCtx.restore();
        }
      }
    }

    /* UTS */
    var utsIdx = findUTSIndex(state.curveData);
    if (utsIdx > 0 && utsIdx < endIdx) {
      var utsPt = state.curveData[utsIdx];
      var utsPx = GOX + (utsPt.strain / scales.maxStrain) * GGW;
      var utsPy = GOY - (utsPt.stress / scales.maxStress) * GGH;

      /* Red dot */
      gCtx.fillStyle = '#f44336';
      gCtx.beginPath();
      gCtx.arc(utsPx, utsPy, 4, 0, Math.PI * 2);
      gCtx.fill();

      /* Label */
      gCtx.fillStyle = '#f44336';
      gCtx.font = 'bold 10px "Courier New", monospace';
      gCtx.textAlign = 'right';
      gCtx.fillText('UTS = ' + Math.round(toD(utsPt.stress, 'stress')) + ' ' + uLabel('stress'), utsPx - 8, utsPy - 6);
    }

    /* Fracture point */
    if (state.animPhase === 'complete' || state.fractured) {
      var lastPt = state.curveData[state.curveData.length - 1];
      var fpx = GOX + (lastPt.strain / scales.maxStrain) * GGW;
      var fpy = GOY - (lastPt.stress / scales.maxStress) * GGH;

      /* X mark */
      gCtx.strokeStyle = '#ff5722';
      gCtx.lineWidth = 2;
      gCtx.beginPath();
      gCtx.moveTo(fpx - 5, fpy - 5);
      gCtx.lineTo(fpx + 5, fpy + 5);
      gCtx.stroke();
      gCtx.beginPath();
      gCtx.moveTo(fpx + 5, fpy - 5);
      gCtx.lineTo(fpx - 5, fpy + 5);
      gCtx.stroke();

      /* Label */
      gCtx.fillStyle = '#ff5722';
      gCtx.font = 'bold 9px "Courier New", monospace';
      gCtx.textAlign = 'left';
      gCtx.fillText('Fracture', fpx + 8, fpy + 3);
    }
  }

  /* Strain Energy Area (after test complete) */
  function drawStrainEnergyArea() {
    if (state.animPhase !== 'complete' || state.curveData.length === 0) return;

    var scales = getGraphScales();

    /* Toughness — full area under curve */
    gCtx.fillStyle = 'rgba(30,136,229,0.08)';
    gCtx.beginPath();
    gCtx.moveTo(GOX, GOY);
    for (var ai = 0; ai < state.curveData.length; ai++) {
      var pt = state.curveData[ai];
      var px = GOX + (pt.strain / scales.maxStrain) * GGW;
      var py = GOY - (pt.stress / scales.maxStress) * GGH;
      gCtx.lineTo(px, py);
    }
    var lastPt = state.curveData[state.curveData.length - 1];
    gCtx.lineTo(GOX + (lastPt.strain / scales.maxStrain) * GGW, GOY);
    gCtx.closePath();
    gCtx.fill();

    /* Resilience — elastic region only */
    var mat = MATERIALS[state.matIdx];
    if (mat.sigmaY > 0) {
      var yIdx = findYieldIndex(state.curveData, mat);
      if (yIdx < 0) yIdx = Math.min(20, state.curveData.length - 1);

      gCtx.fillStyle = 'rgba(76,175,80,0.12)';
      gCtx.beginPath();
      gCtx.moveTo(GOX, GOY);
      for (var ri = 0; ri <= yIdx; ri++) {
        var rpt = state.curveData[ri];
        var rpx = GOX + (rpt.strain / scales.maxStrain) * GGW;
        var rpy = GOY - (rpt.stress / scales.maxStress) * GGH;
        gCtx.lineTo(rpx, rpy);
      }
      var yPt = state.curveData[yIdx];
      gCtx.lineTo(GOX + (yPt.strain / scales.maxStrain) * GGW, GOY);
      gCtx.closePath();
      gCtx.fill();
    }

    /* D16: strain-energy legend — top-LEFT of the plot (the top-right is
       occupied by the Display control panel overlay). */
    if (state.results) {
      var legX = GOX + 10;
      var legY = GOY - GGH + 10;
      var sw = 10, swh = 8, lineH = 13;
      gCtx.save();
      gCtx.textAlign = 'left';
      gCtx.font = '500 9px "Segoe UI", system-ui, sans-serif';

      /* Toughness swatch (blue tint, full area) */
      gCtx.fillStyle = 'rgba(30,136,229,0.35)';
      gCtx.fillRect(legX, legY, sw, swh);
      gCtx.strokeStyle = 'rgba(100,181,246,0.6)';
      gCtx.lineWidth = 0.6;
      gCtx.strokeRect(legX, legY, sw, swh);
      gCtx.fillStyle = 'rgba(170,210,255,0.85)';
      var tVal = (typeof state.results.toughness === 'number') ? state.results.toughness.toFixed(1) : state.results.toughness;
      gCtx.fillText('Toughness ' + tVal + ' MJ/m³', legX + sw + 4, legY + swh - 1);

      /* Resilience swatch (green tint, elastic only) */
      if (state.results.resilience && state.results.resilience !== '—') {
        gCtx.fillStyle = 'rgba(76,175,80,0.40)';
        gCtx.fillRect(legX, legY + lineH, sw, swh);
        gCtx.strokeStyle = 'rgba(129,212,134,0.7)';
        gCtx.strokeRect(legX, legY + lineH, sw, swh);
        gCtx.fillStyle = 'rgba(180,235,180,0.88)';
        var rVal = (typeof state.results.resilience === 'number') ? state.results.resilience.toFixed(3) : state.results.resilience;
        gCtx.fillText('Resilience ' + rVal + ' MJ/m³', legX + sw + 4, legY + lineH + swh - 1);
      }
      gCtx.restore();
    }
  }

  /* Graph Title */
  function drawGraphTitle() {
    gCtx.fillStyle = '#8899b0';
    gCtx.font = '600 12px "Segoe UI", system-ui, sans-serif';
    gCtx.textAlign = 'center';
    var titleText = 'Engineering Stress\u2013Strain Curve';
    if (state.testType === 'compression') titleText = 'Compression Stress\u2013Strain Curve';
    gCtx.fillText(titleText, GW / 2, 20);

    /* Material label */
    var mat = MATERIALS[state.matIdx];
    gCtx.fillStyle = '#546e7a';
    gCtx.font = '500 10px "Segoe UI", system-ui, sans-serif';
    gCtx.fillText(mat.name + ' \u2014 ' + (state.testType === 'tensile' ? 'Tensile' : 'Compression'), GW / 2, 36);
  }

  /* Region labels on the graph (Elastic, Plastic, Necking) */
  function drawRegionLabels() {
    if (state.animPhase !== 'complete' || state.curveData.length === 0) return;
    var mat = MATERIALS[state.matIdx];
    var scales = getGraphScales();
    if (mat.type === 'hyperelastic') return; /* rubber has different regions */

    var yIdx = findYieldIndex(state.curveData, mat);
    var utsIdx = findUTSIndex(state.curveData);
    if (yIdx < 0) yIdx = Math.floor(state.curveData.length * 0.05);

    gCtx.font = '600 10px "Segoe UI", system-ui, sans-serif';
    gCtx.textAlign = 'center';

    /* Helper: vertical divider tick at a transition x */
    function regionDivider(divX, color) {
      gCtx.strokeStyle = color;
      gCtx.lineWidth = 0.8;
      gCtx.setLineDash([2, 3]);
      gCtx.beginPath();
      gCtx.moveTo(divX, GOY - 6);
      gCtx.lineTo(divX, GOY - GGH + 12);
      gCtx.stroke();
      gCtx.setLineDash([]);
    }

    /* Elastic region label */
    if (yIdx > 2) {
      var midElastic = Math.floor(yIdx / 2);
      var elPt = state.curveData[midElastic];
      var elPx = GOX + (elPt.strain / scales.maxStrain) * GGW;
      var elPy = GOY - 10;

      gCtx.fillStyle = 'rgba(129,212,134,0.75)';
      gCtx.fillText('Elastic', elPx, elPy);

      /* Bracket */
      var e0x = GOX;
      var e1x = GOX + (state.curveData[yIdx].strain / scales.maxStrain) * GGW;
      gCtx.strokeStyle = 'rgba(76,175,80,0.45)';
      gCtx.lineWidth = 0.8;
      gCtx.beginPath();
      gCtx.moveTo(e0x, elPy + 4);
      gCtx.lineTo(e0x, elPy + 8);
      gCtx.lineTo(e1x, elPy + 8);
      gCtx.lineTo(e1x, elPy + 4);
      gCtx.stroke();
    }

    /* Strain hardening region label */
    if (yIdx > 0 && utsIdx > yIdx && state.testType === 'tensile') {
      var midHarden = Math.floor((yIdx + utsIdx) / 2);
      var hPt = state.curveData[midHarden];
      var hPx = GOX + (hPt.strain / scales.maxStrain) * GGW;
      var hPy = GOY - 10;

      gCtx.fillStyle = 'rgba(255,193,7,0.75)';
      gCtx.fillText('Strain Hardening', hPx, hPy);

      var h0x = GOX + (state.curveData[yIdx].strain / scales.maxStrain) * GGW;
      var h1x = GOX + (state.curveData[utsIdx].strain / scales.maxStrain) * GGW;
      gCtx.strokeStyle = 'rgba(255,183,77,0.45)';
      gCtx.lineWidth = 0.8;
      gCtx.beginPath();
      gCtx.moveTo(h0x, hPy + 4);
      gCtx.lineTo(h0x, hPy + 8);
      gCtx.lineTo(h1x, hPy + 8);
      gCtx.lineTo(h1x, hPy + 4);
      gCtx.stroke();
      regionDivider(h0x, 'rgba(255,193,7,0.30)');
    }

    /* Necking region label */
    if (utsIdx > 0 && utsIdx < state.curveData.length - 10 && mat.type !== 'brittle' && state.testType === 'tensile') {
      var midNeck = Math.floor((utsIdx + state.curveData.length) / 2);
      if (midNeck >= state.curveData.length) midNeck = state.curveData.length - 1;
      var nPt = state.curveData[midNeck];
      var nPx = GOX + (nPt.strain / scales.maxStrain) * GGW;
      var nPy = GOY - 10;

      gCtx.fillStyle = 'rgba(255,138,128,0.78)';
      gCtx.fillText('Necking', nPx, nPy);

      var n0x = GOX + (state.curveData[utsIdx].strain / scales.maxStrain) * GGW;
      var n1x = GOX + (state.curveData[state.curveData.length - 1].strain / scales.maxStrain) * GGW;
      gCtx.strokeStyle = 'rgba(244,67,54,0.45)';
      gCtx.lineWidth = 0.8;
      gCtx.beginPath();
      gCtx.moveTo(n0x, nPy + 4);
      gCtx.lineTo(n0x, nPy + 8);
      gCtx.lineTo(n1x, nPy + 8);
      gCtx.lineTo(n1x, nPy + 4);
      gCtx.stroke();
      regionDivider(n0x, 'rgba(244,67,54,0.30)');
    }

    /* For ductile-yield: label the yield plateau */
    if (mat.type === 'ductile-yield' && state.testType === 'tensile') {
      var plateauStart = yIdx;
      var plateauEnd = -1;
      /* Find where stress starts rising again after plateau */
      for (var pi = yIdx + 5; pi < state.curveData.length - 1; pi++) {
        if (state.curveData[pi].stress > mat.sigmaY * 1.02 &&
            state.curveData[pi].stress > state.curveData[pi - 1].stress + 0.5) {
          plateauEnd = pi;
          break;
        }
      }
      if (plateauEnd > plateauStart + 10) {
        var midPlat = Math.floor((plateauStart + plateauEnd) / 2);
        var ppPt = state.curveData[midPlat];
        var ppPx = GOX + (ppPt.strain / scales.maxStrain) * GGW;
        var ppPy = GOY - (ppPt.stress / scales.maxStress) * GGH - 15;

        gCtx.fillStyle = 'rgba(156,204,101,0.4)';
        gCtx.font = 'italic 8px "Segoe UI", system-ui, sans-serif';
        gCtx.fillText('Yield Plateau', ppPx, ppPy);
      }
    }
  }

  /* ================================================================
     S12 — ANIMATION ENGINE
     ================================================================ */
  var PHASE_DUR = { mounting: 1200, testing: 8000, fracture: 600 };
  var animRAF = null;

  function startMount() {
    if (state.animPhase !== 'idle') return;
    state.animPhase = 'mounting';
    state.animStart = performance.now();
    state.animProgress = 0;
    state.gripOpen = 1;
    state.fractured = false;
    state.fractureParts = [];
    state.testProgress = 0;
    state.plotIdx = 0;
    state.results = null;
    hide(elResultsRow);

    elBtnMount.disabled = true;
    elBtnStart.disabled = true;
    if (typeof updateGuideBlink === 'function') updateGuideBlink();

    tick(performance.now());
  }

  function startTest() {
    if (state.animPhase !== 'idle' || !state.mounted) return;

    /* Pre-generate curve data */
    state.curveData = generateCurveData(MATERIALS[state.matIdx], state.testType);
    state.plotIdx = 0;
    state.testProgress = 0;
    state.fractured = false;
    state.fractureParts = [];
    state.results = null;
    hide(elResultsRow);

    /* Adjust duration based on speed */
    PHASE_DUR.testing = Math.max(4000, 12000 / (state.speed / 5));

    state.animPhase = 'testing';
    state.animStart = performance.now();

    elBtnStart.disabled = true;
    elBtnMount.disabled = true;
    if (typeof updateGuideBlink === 'function') updateGuideBlink();

    /* Collapse the Display panel when the test starts so it doesn't
       obscure the live curve; the user can reopen it via the arrow. */
    var goPanel = $('graph-opts'), goToggle = $('gopt-toggle');
    if (goPanel && !goPanel.classList.contains('collapsed')) {
      goPanel.classList.add('collapsed');
      if (goToggle) goToggle.setAttribute('aria-expanded', 'false');
    }

    advanceStep(5);
    tick(performance.now());
  }

  function tick(now) {
    var elapsed = now - state.animStart;
    var dur = PHASE_DUR[state.animPhase] || 1;
    state.animProgress = clamp(elapsed / dur, 0, 1);

    /* Phase-specific updates */
    if (state.animPhase === 'mounting') {
      state.gripOpen = 1 - easeInOut(state.animProgress);
    } else if (state.animPhase === 'testing') {
      state.testProgress = easeInOut(state.animProgress);
      state.plotIdx = Math.floor(state.testProgress * (state.curveData.length - 1));
      /* Detect yield-crossing event (once per test, tensile only) */
      if (!state.yieldFired && state.testType === 'tensile' && state.curveData.length > 0) {
        var matY = MATERIALS[state.matIdx];
        var yIdxNow = findYieldIndex(state.curveData, matY);
        if (yIdxNow > 0 && state.plotIdx >= yIdxNow) {
          state.yieldFired = true;
          state.yieldFlashT = now;
        }
      }
      /* Detect UTS-crossing event (once per test, tensile only) */
      if (!state.utsFired && state.testType === 'tensile' && state.curveData.length > 0) {
        var uIdxNow = findUTSIndex(state.curveData);
        if (uIdxNow > 0 && state.plotIdx >= uIdxNow) {
          state.utsFired = true;
          state.utsPulseT = now;
        }
      }
      updateBadges();
    } else if (state.animPhase === 'fracture') {
      /* Update fracture particles */
      for (var fp = 0; fp < state.fractureParts.length; fp++) {
        var p = state.fractureParts[fp];
        p.x += p.vx;
        p.y += p.vy;
        p.vy += 0.2;
        p.alpha *= 0.95;
        p.rot += 0.05;
      }
    }

    /* Render */
    drawMachine();
    drawGraph();

    /* Phase transitions */
    if (state.animProgress >= 1) {
      if (state.animPhase === 'mounting') {
        state.mounted = true;
        state.animPhase = 'idle';
        state.gripOpen = 0;
        elBtnStart.disabled = false;
        elBtnMount.disabled = true;
        advanceStep(4);
        drawMachine();
        drawGraph();
        if (typeof updateGuideBlink === 'function') updateGuideBlink();
        return;
      }

      if (state.animPhase === 'testing') {
        var mat = MATERIALS[state.matIdx];
        /* Determine if fracture occurs */
        if (mat.type !== 'hyperelastic') {
          initFracture();
          state.animPhase = 'fracture';
          state.animStart = performance.now();
          state.animProgress = 0;
          tick(performance.now());
          return;
        } else {
          /* Rubber: test completes without fracture */
          completeTest();
          return;
        }
      }

      if (state.animPhase === 'fracture') {
        completeTest();
        return;
      }
    } else {
      animRAF = requestAnimationFrame(tick);
    }
  }

  function completeTest() {
    state.animPhase = 'complete';
    state.testProgress = 1;
    state.plotIdx = state.curveData.length;
    state.results = calculateResults();
    /* Rotate compare history: the test that just finished becomes the
       "last completed"; the one before it becomes the ghost overlay. */
    state.ghost = state._lastCompleted;
    state._lastCompleted = {
      curveData: state.curveData.slice(),
      matName: MATERIALS[state.matIdx].name,
      testType: state.testType
    };
    displayResults();
    advanceStep(6);
    updateBadges();
    drawMachine();
    drawGraph();

    elBtnStart.disabled = true;
    elBtnMount.disabled = true;
    if (typeof updateGuideBlink === 'function') updateGuideBlink();

    /* Export buttons are now always visible in action bar */
  }

  /* ================================================================
     S13 — LAB PROCEDURE STATE MACHINE
     ================================================================ */
  var LAB_STEPS = [
    { label: 'Select Material', icon: '1' },
    { label: 'Specimen Geometry', icon: '2' },
    { label: 'Test Type', icon: '3' },
    { label: 'Crosshead Speed', icon: '4' },
    { label: 'Mount Specimen', icon: '5' },
    { label: 'Run Test', icon: '6' },
    { label: 'View Results', icon: '7' }
  ];

  function buildLabSteps() {
    if (!elLabSteps) return;
    elLabSteps.innerHTML = '';
    for (var si = 0; si < LAB_STEPS.length; si++) {
      var step = LAB_STEPS[si];
      var div = document.createElement('div');
      var cls = 'lab-step';
      if (si === state.labStep) cls += ' active';
      if (si < state.labStep) cls += ' done';
      div.className = cls;

      var numSpan = document.createElement('span');
      numSpan.className = 'lab-step-num';
      numSpan.textContent = si < state.labStep ? '\u2713' : step.icon;
      div.appendChild(numSpan);

      var labelSpan = document.createElement('span');
      labelSpan.textContent = step.label;
      div.appendChild(labelSpan);

      (function (idx) {
        div.addEventListener('click', function () {
          if (idx <= state.labStep && state.animPhase === 'idle') {
            state.labStep = idx;
            buildLabSteps();
          }
        });
      })(si);

      elLabSteps.appendChild(div);
    }
  }

  function advanceStep(target) {
    if (target > state.labStep) state.labStep = target;
    buildLabSteps();
  }

  /* Build material tabs */
  function buildMaterialTabs() {
    if (!elMatTabs) return;
    elMatTabs.innerHTML = '';
    for (var mi = 0; mi < MATERIALS.length; mi++) {
      var mat = MATERIALS[mi];
      var btn = document.createElement('button');
      btn.className = 'pill' + (mi === state.matIdx ? ' active' : '');
      btn.textContent = mat.name;
      btn.dataset.value = mi;
      (function (idx) {
        btn.addEventListener('click', function () {
          selectMaterial(idx);
        });
      })(mi);
      elMatTabs.appendChild(btn);
    }
    /* "+ Custom" button */
    var customBtn = document.createElement('button');
    customBtn.className = 'pill';
    customBtn.textContent = '+ Custom';
    customBtn.style.cssText = 'border:1px dashed var(--accent);color:var(--accent);';
    customBtn.addEventListener('click', openCustomMaterialModal);
    elMatTabs.appendChild(customBtn);
  }

  function selectMaterial(idx) {
    state.matIdx = idx;
    var pills = elMatTabs.querySelectorAll('.pill');
    for (var p = 0; p < pills.length; p++) {
      pills[p].classList.toggle('active', parseInt(pills[p].dataset.value) === idx);
    }
    advanceStep(1);
    resetTest();
    drawMachine();
    drawGraph();
  }

  /* ── Custom Material Modal ── */
  var CM_FIELDS = [
    { key: 'name',    label: 'Material Name',         type: 'text',   min: null, max: null, unit: '', siUnit: '', impFactor: 1 },
    { key: 'E',       label: "Young's Modulus",        type: 'number', min: 1,    max: 500000, unit: 'stress', siUnit: 'MPa', impFactor: 145.04 },
    { key: 'sigmaY',  label: 'Yield Strength (0 if brittle)', type: 'number', min: 0, max: 5000, unit: 'stress', siUnit: 'MPa', impFactor: 145.04 },
    { key: 'sigmaU',  label: 'Ultimate Tensile Strength', type: 'number', min: 1, max: 5000, unit: 'stress', siUnit: 'MPa', impFactor: 145.04 },
    { key: 'epsF',    label: 'Fracture Strain',        type: 'number', min: 0.0001, max: 10, unit: '', siUnit: '', impFactor: 1 },
    { key: 'nu',      label: "Poisson's Ratio",        type: 'number', min: 0.01, max: 0.50, unit: '', siUnit: '', impFactor: 1 },
    { key: 'density', label: 'Density',                type: 'number', min: 100,  max: 25000, unit: 'density', siUnit: 'kg/m\u00B3', impFactor: 0.06243 }
  ];

  function openCustomMaterialModal() {
    var overlay = document.createElement('div');
    overlay.className = 'cm-overlay';

    var modal = document.createElement('div');
    modal.className = 'cm-modal';

    var isImp = unitSystem === 'imperial';

    modal.innerHTML =
      '<div class="cm-title">Custom Material</div>' +
      '<div class="cm-subtitle">Enter material properties' + (isImp ? ' (Imperial units)' : ' (SI units)') + '. All fields required.</div>' +
      '<div class="cm-grid" id="cm-grid"></div>' +
      '<div class="cm-error-msg" id="cm-error"></div>' +
      '<div class="cm-actions">' +
        '<button class="btn btn-ghost" id="cm-cancel">Cancel</button>' +
        '<button class="btn btn-primary" id="cm-submit">Add Material</button>' +
      '</div>';

    overlay.appendChild(modal);
    document.body.appendChild(overlay);

    var grid = modal.querySelector('#cm-grid');

    for (var fi = 0; fi < CM_FIELDS.length; fi++) {
      var f = CM_FIELDS[fi];
      var field = document.createElement('div');
      field.className = 'cm-field' + (f.key === 'name' ? ' full' : '');

      var unitLabel = '';
      if (f.unit === 'stress') unitLabel = isImp ? 'psi' : 'MPa';
      else if (f.unit === 'density') unitLabel = isImp ? 'lb/ft\u00B3' : 'kg/m\u00B3';

      /* Compute display range */
      var dispMin = f.min, dispMax = f.max;
      if (f.unit && f.impFactor !== 1 && isImp) {
        dispMin = f.min !== null ? roundN(f.min * f.impFactor, 1) : null;
        dispMax = f.max !== null ? roundN(f.max * f.impFactor, 1) : null;
      }

      var rangeText = '';
      if (dispMin !== null && dispMax !== null) {
        rangeText = dispMin + ' – ' + dispMax + (unitLabel ? ' ' + unitLabel : '');
      }

      field.innerHTML =
        '<span class="cm-label">' + f.label + (unitLabel ? ' (' + unitLabel + ')' : '') + '</span>' +
        (rangeText ? '<span class="cm-range">Range: ' + rangeText + '</span>' : '') +
        '<input class="cm-input" id="cm-' + f.key + '" type="' + f.type + '"' +
        (f.type === 'number' ? ' step="any"' : '') +
        ' placeholder="' + (f.key === 'name' ? 'e.g. Titanium Ti-6Al-4V' : '') + '">';

      grid.appendChild(field);
    }

    /* Cancel */
    modal.querySelector('#cm-cancel').addEventListener('click', function () {
      overlay.remove();
    });
    overlay.addEventListener('click', function (e) {
      if (e.target === overlay) overlay.remove();
    });

    /* Submit */
    modal.querySelector('#cm-submit').addEventListener('click', function () {
      var errEl = modal.querySelector('#cm-error');
      errEl.textContent = '';

      var vals = {};
      var isImpNow = unitSystem === 'imperial';

      for (var vi = 0; vi < CM_FIELDS.length; vi++) {
        var cf = CM_FIELDS[vi];
        var inp = modal.querySelector('#cm-' + cf.key);
        var raw = inp.value.trim();
        inp.classList.remove('error');

        if (!raw) {
          inp.classList.add('error');
          errEl.textContent = cf.label + ' is required.';
          inp.focus();
          return;
        }

        if (cf.type === 'number') {
          var num = parseFloat(raw);
          if (isNaN(num)) {
            inp.classList.add('error');
            errEl.textContent = cf.label + ': enter a valid number.';
            inp.focus();
            return;
          }
          /* Convert from Imperial to SI if needed */
          var siVal = (cf.unit && cf.impFactor !== 1 && isImpNow) ? num / cf.impFactor : num;

          if (cf.min !== null && siVal < cf.min) {
            inp.classList.add('error');
            errEl.textContent = cf.label + ' is below minimum (' + cf.min + ' ' + cf.siUnit + ').';
            inp.focus();
            return;
          }
          if (cf.max !== null && siVal > cf.max) {
            inp.classList.add('error');
            errEl.textContent = cf.label + ' exceeds maximum (' + cf.max + ' ' + cf.siUnit + ').';
            inp.focus();
            return;
          }
          vals[cf.key] = siVal;
        } else {
          if (raw.length > 20) {
            inp.classList.add('error');
            errEl.textContent = 'Name too long (max 20 characters).';
            inp.focus();
            return;
          }
          vals[cf.key] = raw;
        }
      }

      /* Validate σu > σy */
      if (vals.sigmaY > 0 && vals.sigmaU <= vals.sigmaY) {
        errEl.textContent = 'UTS must be greater than Yield Strength.';
        return;
      }

      /* Auto-detect material type */
      var matType;
      if (vals.sigmaY === 0 && vals.epsF < 0.01) matType = 'brittle';
      else if (vals.sigmaY === 0 && vals.epsF >= 1) matType = 'hyperelastic';
      else if (vals.epsF >= 0.35) matType = 'very-ductile';
      else if (vals.E >= 150000 && vals.epsF >= 0.15) matType = 'ductile-yield';
      else matType = 'ductile-gradual';

      /* Auto-derive K and n for power law hardening */
      var K = 0, nExp = 0;
      if (matType === 'ductile-gradual' || matType === 'ductile-yield') {
        K = vals.sigmaU * 1.4;
        nExp = 0.002 + (vals.epsF - vals.sigmaY / vals.E) * 0.8;
        nExp = clamp(nExp, 0.05, 0.6);
      } else if (matType === 'very-ductile') {
        K = vals.sigmaU * 1.5;
        nExp = 0.3 + vals.epsF * 0.3;
        nExp = clamp(nExp, 0.2, 0.7);
      }

      /* Create the material object */
      var customMat = {
        id: 'custom-' + Date.now(),
        name: vals.name,
        E: vals.E,
        sigmaY: vals.sigmaY,
        sigmaU: vals.sigmaU,
        epsF: vals.epsF,
        nu: vals.nu,
        type: matType,
        color: '#e040fb',
        density: vals.density,
        K: K,
        n: nExp
      };

      /* Add to materials and select it */
      MATERIALS.push(customMat);
      buildMaterialTabs();
      selectMaterial(MATERIALS.length - 1);
      overlay.remove();
    });

    /* Focus first input */
    setTimeout(function () {
      var first = modal.querySelector('#cm-name');
      if (first) first.focus();
    }, 100);
  }

  /* Calculate results */
  function calculateResults() {
    var mat = MATERIALS[state.matIdx];
    var dia = Math.max(state.dia, 1); /* guard: min 1 mm */
    var gl = Math.max(state.gl, 1);   /* guard: min 1 mm */
    var A0 = Math.PI * Math.pow(dia / 2, 2);
    var maxLoad = mat.sigmaU * A0 / 1000;

    /* For compression, find actual max stress in curve */
    if (state.testType === 'compression') {
      var maxStressComp = 0;
      for (var mc = 0; mc < state.curveData.length; mc++) {
        if (state.curveData[mc].stress > maxStressComp) maxStressComp = state.curveData[mc].stress;
      }
      maxLoad = maxStressComp * A0 / 1000;
    }

    /* Fracture load from the final point of the generated curve, so the
       reported value matches the fracture marker plotted on the graph
       (0.60–0.70 σu depending on material type; σu for brittle). */
    var fracLoad = maxLoad;
    if (state.curveData.length > 0) {
      fracLoad = state.curveData[state.curveData.length - 1].stress * A0 / 1000;
    }

    /* Toughness by trapezoidal integration */
    var toughness = 0;
    for (var ti = 1; ti < state.curveData.length; ti++) {
      var ds = state.curveData[ti].strain - state.curveData[ti - 1].strain;
      var avgS = (state.curveData[ti].stress + state.curveData[ti - 1].stress) / 2;
      toughness += avgS * ds;
    }

    var resilience = (mat.sigmaY > 0) ? (mat.sigmaY * mat.sigmaY) / (2 * mat.E) : 0;

    var percentEL = state.testType === 'tensile' ? roundN(mat.epsF * 100, 1) : '\u2014';

    var percentRA;
    if (state.testType === 'compression' || mat.type === 'brittle' || mat.type === 'hyperelastic') {
      percentRA = '\u2014';
    } else {
      /* Material-specific %RA from textbook data */
      var raMap = {
        'mild-steel': 60, 'aluminium': 25, 'copper': 70, 'brass': 45, 'hc-steel': 30,
        'ss304': 70, 'ti-6al-4v': 35, 'alloy-4340': 50, 'inconel-718': 30,
        'magnesium-az31': 15, 'nickel': 65, 'lead': 80, 'nylon66': 45, 'polycarbonate': 55
      };
      var raBase = raMap[mat.id] || clamp(mat.nu * mat.epsF * 100 * 1.5, 5, 80);
      percentRA = roundN(raBase, 1);
    }

    return {
      E: roundN(mat.E / 1000, 1),
      sigmaY: mat.sigmaY > 0 ? mat.sigmaY : '\u2014',
      sigmaU: state.testType === 'tensile' ? mat.sigmaU : roundN(maxLoad * 1000 / A0, 0),
      percentEL: percentEL,
      percentRA: percentRA,
      toughness: roundN(toughness, 2),
      resilience: roundN(resilience, 4),
      maxLoad: roundN(maxLoad, 2),
      fracLoad: roundN(fracLoad, 2),
      area: roundN(A0, 2)
    };
  }

  function displayResults() {
    if (!state.results) return;
    var r = state.results;

    if (elResE) elResE.textContent = fmtD(r.E, 'modulus', 1);
    if (elResSY) elResSY.textContent = (r.sigmaY === '\u2014') ? '\u2014' : fmtD(r.sigmaY, 'stress', 0);
    if (elResUTS) elResUTS.textContent = fmtD(r.sigmaU, 'stress', 0);
    if (elResEL) elResEL.textContent = r.percentEL;
    if (elResRA) elResRA.textContent = r.percentRA;
    if (elResTough) elResTough.textContent = fmtD(r.toughness, 'energy', 2);
    if (elResResil) elResResil.textContent = fmtD(r.resilience, 'energy', 4);
    if (elResFLoad) elResFLoad.textContent = fmtD(r.fracLoad, 'force', 2);

    /* Update unit labels in readout cards */
    updateResultUnits();

    show(elResultsRow);
  }

  function updateResultUnits() {
    var unitMap = {
      'res-E': 'modulus', 'res-sy': 'stress', 'res-uts': 'stress',
      'res-tough': 'energy', 'res-resil': 'energy', 'res-fload': 'force'
    };
    for (var id in unitMap) {
      var card = document.getElementById(id);
      if (card) {
        var unitEl = card.parentElement.querySelector('.readout-unit');
        if (unitEl) unitEl.textContent = uLabel(unitMap[id]);
      }
    }
  }

  function updateBadges() {
    var load = getCurrentLoad();
    var ext = getCurrentExtension();
    var stress = getCurrentStress();
    var strain = getCurStrain();

    if (elBadgeLoad) elBadgeLoad.textContent = toD(load, 'force').toFixed(2) + ' ' + uLabel('force');
    if (elBadgeExt) elBadgeExt.textContent = toD(ext, 'length').toFixed(3) + ' ' + uLabel('length');
    if (elBadgeStress) elBadgeStress.textContent = toD(stress, 'stress').toFixed(2) + ' ' + uLabel('stress');
    if (elBadgeStrain) elBadgeStrain.textContent = strain.toFixed(5);
  }

  function resetTest() {
    if (animRAF) cancelAnimationFrame(animRAF);
    animRAF = null;
    state.animPhase = 'idle';
    state.animProgress = 0;
    state.testProgress = 0;
    state.plotIdx = 0;
    state.curveData = [];
    state.fractured = false;
    state.fractureParts = [];
    state.results = null;
    state.mounted = false;
    state.gripOpen = 1;
    state.labStep = 0;
    state.yieldFlashT = 0; state.utsPulseT = 0; state.fractureFlashT = 0;
    state.yieldFired = false; state.utsFired = false;

    hide(elResultsRow);
    /* Export buttons always visible in action bar — no hide needed */
    elBtnMount.disabled = false;
    elBtnStart.disabled = true;

    updateBadges();
    buildLabSteps();
    if (typeof updateGuideBlink === 'function') updateGuideBlink();
  }

  /* ================================================================
     S14 — MODE SWITCHING
     ================================================================ */
  function setMode(m) {
    state.mode = m;

    /* Update pills */
    var modePills = $('mode-tabs');
    if (modePills) {
      var pills = modePills.querySelectorAll('.pill');
      for (var pi = 0; pi < pills.length; pi++) {
        pills[pi].classList.toggle('active', pills[pi].dataset.value === m);
      }
    }

    /* Show/hide wrappers */
    if (elSimWrapper) elSimWrapper.style.display = m === 'simulate' ? '' : 'none';
    if (elExpWrapper) elExpWrapper.style.display = m === 'explore' ? '' : 'none';
    if (elPracWrapper) elPracWrapper.style.display = m === 'practice' ? '' : 'none';
    if (elQuizWrapper) elQuizWrapper.style.display = m === 'quiz' ? '' : 'none';

    if (m === 'explore') {
      buildConceptGrid();
      selectConcept(state.expIdx);
    }
    if (m === 'practice') {
      if (!state.pProb) newPractice();
    }
    if (m === 'quiz') {
      if (state.qSet.length === 0) startQuiz();
    }

    if (m === 'simulate') {
      drawMachine();
      drawGraph();
    }
  }

  /* ================================================================
     S15 — EXPLORE MODE
     ================================================================ */
  function buildConceptGrid() {
    if (!elISGrid) return;
    elISGrid.innerHTML = '';

    var filtered = CONCEPTS.filter(function (c) { return c.cat === state.expCat; });
    filtered.forEach(function (c) {
      var absIdx = CONCEPTS.indexOf(c);
      var btn = document.createElement('button');
      btn.className = 'is-btn' + (absIdx === state.expIdx ? ' active' : '');
      btn.innerHTML = '<span class="is-btn-name">' + c.name + '</span><span class="is-btn-sym">' + c.symbol + '</span>';
      btn.addEventListener('click', function () {
        state.expIdx = absIdx;
        buildConceptGrid();
        selectConcept(absIdx);
      });
      elISGrid.appendChild(btn);
    });
  }

  function selectConcept(idx) {
    var c = CONCEPTS[idx];
    if (!c) return;

    if (elIIName) elIIName.textContent = c.name;
    if (elIIDesc) elIIDesc.textContent = c.desc;

    if (elFormulaBox) {
      if (c.formula && c.formula !== '\u2014') {
        show(elFormulaBox);
        if (elFBFormula) elFBFormula.textContent = c.formula;
        if (elFBUnit) elFBUnit.textContent = c.unit;
      } else {
        hide(elFormulaBox);
      }
    }

    if (elExampleBox && elEBBody) {
      if (c.example) {
        show(elExampleBox);
        var html = '';
        if (c.example.problem) {
          html += '<p class="eb-problem">' + c.example.problem + '</p>';
        }
        if (c.example.steps) {
          c.example.steps.forEach(function (s) {
            html += '<div class="eb-step">' + s + '</div>';
          });
        }
        elEBBody.innerHTML = html;
      } else {
        hide(elExampleBox);
      }
    }

    drawExploreDiagram(c);
  }

  /* Explore canvas diagram drawing */
  function drawExploreDiagram(concept) {
    if (!eCtx) return;
    eCtx.clearRect(0, 0, EW, EH);

    /* Dark background */
    eCtx.fillStyle = '#0d1117';
    eCtx.fillRect(0, 0, EW, EH);

    /* Subtle grid */
    eCtx.strokeStyle = 'rgba(42,48,80,0.12)';
    eCtx.lineWidth = 0.5;
    for (var gx = 0; gx < EW; gx += 30) {
      eCtx.beginPath(); eCtx.moveTo(gx, 0); eCtx.lineTo(gx, EH); eCtx.stroke();
    }
    for (var gy = 0; gy < EH; gy += 30) {
      eCtx.beginPath(); eCtx.moveTo(0, gy); eCtx.lineTo(EW, gy); eCtx.stroke();
    }

    var cx = EW / 2, cy = EH / 2;

    switch (concept.id) {
      case 'load-frame': drawExploreLoadFrame(cx, cy); break;
      case 'load-cell': drawExploreLoadCell(cx, cy); break;
      case 'grips': drawExploreGrips(cx, cy); break;
      case 'extensometer': drawExploreExtensometer(cx, cy); break;
      case 'astm-e8': drawExploreASTME8(cx, cy); break;
      case 'astm-e9': drawExploreASTME9(cx, cy); break;
      case 'iso-6892': drawExploreISO(cx, cy); break;
      case 'youngs-modulus': drawExploreYoungsModulus(cx, cy); break;
      case 'yield-strength': drawExploreYieldStrength(cx, cy); break;
      case 'uts': drawExploreUTS(cx, cy); break;
      case 'ductile-fracture': drawExploreDuctileFrac(cx, cy); break;
      case 'brittle-fracture': drawExploreBrittleFrac(cx, cy); break;
    }
  }

  /* ── Explore: Load Frame ──────────────────────────────── */
  function drawExploreLoadFrame(cx, cy) {
    /* Simplified UTM outline */
    var fx = cx - 120, fy = cy - 150, fw = 240, fh = 300;

    /* Base */
    eCtx.fillStyle = '#455a64';
    roundRect(eCtx, fx, fy + fh - 20, fw, 20, 3);
    eCtx.fill();

    /* Left column */
    eCtx.fillStyle = '#607d8b';
    eCtx.fillRect(fx + 20, fy + 20, 16, fh - 40);
    /* Right column */
    eCtx.fillRect(fx + fw - 36, fy + 20, 16, fh - 40);

    /* Top beam */
    eCtx.fillStyle = '#546e7a';
    roundRect(eCtx, fx + 20, fy, fw - 40, 20, 3);
    eCtx.fill();

    /* Crosshead */
    eCtx.fillStyle = '#1e88e5';
    roundRect(eCtx, fx + 36, fy + 100, fw - 72, 10, 2);
    eCtx.fill();

    /* Lower platform */
    eCtx.fillStyle = '#546e7a';
    roundRect(eCtx, fx + 36, fy + 200, fw - 72, 10, 2);
    eCtx.fill();

    /* Labels */
    eCtx.fillStyle = '#dde3f0';
    eCtx.font = '600 11px "Segoe UI", system-ui, sans-serif';
