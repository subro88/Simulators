    eCtx.fillText('Top Beam', cx + 130, fy + 12);
    eCtx.fillText('Crosshead (movable)', cx + 130, fy + 108);
    eCtx.fillText('Columns', cx + 130, fy + 160);
    eCtx.fillText('Lower Platform', cx + 130, fy + 208);
    eCtx.fillText('Base Plate', cx + 130, fy + fh - 8);

    /* Annotation lines */
    eCtx.strokeStyle = '#6b7a99';
    eCtx.lineWidth = 0.8;
    eCtx.setLineDash([3, 3]);
    eCtx.beginPath(); eCtx.moveTo(cx + 80, fy + 10); eCtx.lineTo(cx + 128, fy + 10); eCtx.stroke();
    eCtx.beginPath(); eCtx.moveTo(cx + 80, fy + 105); eCtx.lineTo(cx + 128, fy + 105); eCtx.stroke();
    eCtx.beginPath(); eCtx.moveTo(cx + 80, fy + 157); eCtx.lineTo(cx + 128, fy + 157); eCtx.stroke();
    eCtx.beginPath(); eCtx.moveTo(cx + 80, fy + 205); eCtx.lineTo(cx + 128, fy + 205); eCtx.stroke();
    eCtx.setLineDash([]);

    drawExploreTitleLabel('Load Frame Components');
  }

  /* ── Explore: Load Cell ──────────────────────────────── */
  function drawExploreLoadCell(cx, cy) {
    /* Draw Wheatstone bridge circuit */
    var bx = cx, by = cy;
    var s = 60;

    /* Diamond shape */
    eCtx.strokeStyle = '#64b5f6';
    eCtx.lineWidth = 2;
    eCtx.beginPath();
    eCtx.moveTo(bx, by - s);
    eCtx.lineTo(bx + s, by);
    eCtx.lineTo(bx, by + s);
    eCtx.lineTo(bx - s, by);
    eCtx.closePath();
    eCtx.stroke();

    /* Resistor symbols on each arm */
    var arms = [
      { x1: bx - s / 2, y1: by - s / 2, label: 'R1' },
      { x1: bx + s / 2, y1: by - s / 2, label: 'R2' },
      { x1: bx + s / 2, y1: by + s / 2, label: 'R3' },
      { x1: bx - s / 2, y1: by + s / 2, label: 'R4' }
    ];

    eCtx.fillStyle = '#dde3f0';
    eCtx.font = 'bold 11px "Courier New", monospace';
    eCtx.textAlign = 'center';
    arms.forEach(function (a) {
      eCtx.fillRect(a.x1 - 12, a.y1 - 4, 24, 8);
      eCtx.fillStyle = '#0d1117';
      eCtx.fillText(a.label, a.x1, a.y1 + 3);
      eCtx.fillStyle = '#dde3f0';
    });

    /* Excitation voltage labels */
    eCtx.fillStyle = '#ff9800';
    eCtx.font = '600 10px "Courier New", monospace';
    eCtx.fillText('V_in', bx, by - s - 15);
    eCtx.fillText('GND', bx, by + s + 18);
    eCtx.fillStyle = '#4caf50';
    eCtx.fillText('V_out +', bx - s - 30, by);
    eCtx.fillText('V_out \u2212', bx + s + 30, by);

    /* Load cell body to the right */
    eCtx.fillStyle = '#455a64';
    roundRect(eCtx, cx + 180, cy - 40, 100, 80, 6);
    eCtx.fill();
    eCtx.strokeStyle = '#78909c';
    eCtx.lineWidth = 1;
    roundRect(eCtx, cx + 180, cy - 40, 100, 80, 6);
    eCtx.stroke();
    eCtx.fillStyle = '#dde3f0';
    eCtx.font = '600 10px "Segoe UI", system-ui, sans-serif';
    eCtx.fillText('LOAD CELL', cx + 230, cy);

    /* Arrow showing force */
    eCtx.strokeStyle = '#f44336';
    eCtx.lineWidth = 2;
    eCtx.beginPath();
    eCtx.moveTo(cx + 230, cy - 60);
    eCtx.lineTo(cx + 230, cy - 42);
    eCtx.stroke();
    eCtx.fillStyle = '#f44336';
    eCtx.beginPath();
    eCtx.moveTo(cx + 230, cy - 40);
    eCtx.lineTo(cx + 225, cy - 48);
    eCtx.lineTo(cx + 235, cy - 48);
    eCtx.closePath();
    eCtx.fill();
    eCtx.fillStyle = '#ef9a9a';
    eCtx.font = 'bold 10px "Courier New", monospace';
    eCtx.fillText('F', cx + 230, cy - 68);

    drawExploreTitleLabel('Load Cell & Wheatstone Bridge');
  }

  /* ── Explore: Grips ──────────────────────────────── */
  function drawExploreGrips(cx, cy) {
