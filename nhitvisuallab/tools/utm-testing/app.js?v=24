    var specMidY = (chY + 14 + 20 + contactDepthF + MPLATFORM_Y - contactDepthF) / 2;
    var mat = MATERIALS[state.matIdx];

    mCtx.save();
    for (var pi = 0; pi < state.fractureParts.length; pi++) {
      var p = state.fractureParts[pi];
      if (p.alpha < 0.02) continue;
      mCtx.globalAlpha = p.alpha;
      mCtx.fillStyle = mat.color;
      mCtx.save();
      mCtx.translate(MCX + p.x, specMidY + p.y);
      mCtx.rotate(p.rot);
      mCtx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size);
      mCtx.restore();
    }
    mCtx.restore();
  }

