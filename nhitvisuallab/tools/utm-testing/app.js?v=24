            if (CONCEPTS[fi].cat === state.expCat) { firstInCat = fi; break; }
          }
          if (firstInCat >= 0) state.expIdx = firstInCat;
          buildConceptGrid();
          selectConcept(state.expIdx);
        });
      })(pills[ci]);
    }
  })();

  /* Practice buttons */
  if (elBtnCheck) {
    elBtnCheck.addEventListener('click', checkPractice);
  }
  if (elBtnShowSol) {
    elBtnShowSol.addEventListener('click', showSolBtn);
  }
  if (elBtnNextP) {
    elBtnNextP.addEventListener('click', newPractice);
  }
  if (elPPInput) {
    elPPInput.addEventListener('keydown', function (e) {
