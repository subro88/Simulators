  /* ================================================================
     S16 — PRACTICE MODE
     ================================================================ */
  function newPractice() {
    var generators = genProblems();
    var gen = generators[randInt(0, generators.length - 1)];
    state.pProb = gen();
    state.pDone = false;

    if (elPPPrompt) elPPPrompt.textContent = state.pProb.prompt;
    if (elPPUnit) elPPUnit.textContent = state.pProb.unit;
    if (elPPInput) { elPPInput.value = ''; elPPInput.disabled = false; }
    if (elPracFeedback) { elPracFeedback.textContent = ''; elPracFeedback.className = 'feedback'; }
    hide(elSolPanel);
    show(elBtnCheck);
    show(elBtnShowSol);
    hide(elBtnNextP);
    if (elPPInput) elPPInput.focus();
  }

  function checkPractice() {
    if (state.pDone || !state.pProb) return;
    var val = parseFloat(elPPInput.value);
    if (isNaN(val)) {
      elPracFeedback.textContent = 'Please enter a number.';
      elPracFeedback.className = 'feedback err';
      return;
    }
    state.pDone = true;
    state.pTotal++;

    var prob = state.pProb;
    var correct = Math.abs(val - prob.answer) <= (prob.tol || 1);

    if (correct) {
      state.pScore++;
      elPracFeedback.textContent = 'Correct! Well done.';
      elPracFeedback.className = 'feedback ok';
    } else {
      elPracFeedback.textContent = 'Incorrect. Answer: ' + prob.answer + ' ' + prob.unit;
      elPracFeedback.className = 'feedback err';
    }

    showSolution();
    elPPInput.disabled = true;
    hide(elBtnCheck);
    hide(elBtnShowSol);
    show(elBtnNextP);
    if (elPScore) elPScore.textContent = state.pScore;
    if (elPTotal) elPTotal.textContent = state.pTotal;
  }

  function showSolution() {
    if (!state.pProb || !elSolPanel) return;
    var html = '<h4>Step-by-step Solution</h4>';
    state.pProb.solution.forEach(function (s) {
      html += '<div class="sol-step">' + s + '</div>';
    });
    elSolPanel.innerHTML = html;
    show(elSolPanel);
  }

  function showSolBtn() {
    if (state.pDone) return;
    state.pDone = true;
    state.pTotal++;
    elPracFeedback.textContent = 'Answer: ' + state.pProb.answer + ' ' + state.pProb.unit;
    elPracFeedback.className = 'feedback';
    showSolution();
    elPPInput.disabled = true;
    hide(elBtnCheck);
    hide(elBtnShowSol);
    show(elBtnNextP);
    if (elPScore) elPScore.textContent = state.pScore;
    if (elPTotal) elPTotal.textContent = state.pTotal;
  }

  /* ================================================================
     S17 — QUIZ MODE
     ================================================================ */
  function startQuiz() {
    state.qSet = shuffleArr(QUIZ_POOL).slice(0, 5);
    state.qIdx = 0;
    state.qScore = 0;
    state.qDone = false;
    state.qAnswered = false;
    state.qResults = [];

    hide(elQuizResult);
    show(elQuizPanel);
    if (elQTotal) elQTotal.textContent = '5';
    showQuestion();
  }

  function showQuestion() {
    var q = state.qSet[state.qIdx];
    state.qAnswered = false;

    if (elQNum) elQNum.textContent = state.qIdx + 1;
    if (elQPPrompt) elQPPrompt.textContent = q.q;
    if (elQuizFeedback) { elQuizFeedback.textContent = ''; elQuizFeedback.className = 'feedback'; }
    hide(elBtnQuizNext);

    if (!elQuizAnswers) return;
    elQuizAnswers.innerHTML = '';

    if (q.type === 'mcq') {
      q.choices.forEach(function (ch, ci) {
        var btn = document.createElement('button');
        btn.className = 'answer-btn';
        btn.textContent = ch;
        btn.dataset.ci = ci;
        btn.addEventListener('click', function () {
          if (state.qAnswered) return;
          handleMCQ(ci);
        });
        elQuizAnswers.appendChild(btn);
      });
    } else {
      /* Numeric */
      var row = document.createElement('div');
      row.className = 'quiz-input-row';
      row.innerHTML = '<input class="qi-input" id="qi-val" type="number" step="any" placeholder="Answer">' +
        '<span class="qi-unit">' + q.unit + '</span>' +
        '<button class="btn btn-primary" id="qi-sub">Submit</button>';
      elQuizAnswers.appendChild(row);

      var subBtn = document.getElementById('qi-sub');
      var qiVal = document.getElementById('qi-val');
      if (subBtn) subBtn.addEventListener('click', handleNumeric);
      if (qiVal) {
        qiVal.addEventListener('keydown', function (e) {
          if (e.key === 'Enter') handleNumeric();
        });
        qiVal.focus();
      }
    }
  }

  function handleMCQ(chosenIdx) {
    if (state.qAnswered) return;
    state.qAnswered = true;
    var q = state.qSet[state.qIdx];
    var correct = chosenIdx === q.correct;
    if (correct) state.qScore++;

    state.qResults.push({
      q: q.q,
      correct: correct,
      userAnswer: q.choices[chosenIdx],
      rightAnswer: q.choices[q.correct]
    });

    /* Highlight buttons */
    var btns = elQuizAnswers.querySelectorAll('.answer-btn');
    for (var bi = 0; bi < btns.length; bi++) {
      btns[bi].classList.add('locked');
      if (bi === q.correct) btns[bi].classList.add('correct');
      if (bi === chosenIdx && !correct) btns[bi].classList.add('wrong');
    }

    if (elQuizFeedback) {
      elQuizFeedback.textContent = correct ? 'Correct!' : 'Incorrect. Answer: ' + q.choices[q.correct];
      elQuizFeedback.className = 'feedback ' + (correct ? 'ok' : 'err');
    }

    show(elBtnQuizNext);
  }

  function handleNumeric() {
    if (state.qAnswered) return;
    var qiVal = document.getElementById('qi-val');
    if (!qiVal) return;
    var val = parseFloat(qiVal.value);
    if (isNaN(val)) return;

    state.qAnswered = true;
    var q = state.qSet[state.qIdx];
    var correct = Math.abs(val - q.answer) <= (q.tol || 0.5);
    if (correct) state.qScore++;

    state.qResults.push({
      q: q.q,
      correct: correct,
      userAnswer: val + ' ' + q.unit,
      rightAnswer: q.answer + ' ' + q.unit
    });

    if (elQuizFeedback) {
      elQuizFeedback.textContent = correct ? 'Correct!' : 'Incorrect. Answer: ' + q.answer + ' ' + q.unit;
      elQuizFeedback.className = 'feedback ' + (correct ? 'ok' : 'err');
    }

    qiVal.disabled = true;
    var subBtn = document.getElementById('qi-sub');
    if (subBtn) subBtn.disabled = true;

    show(elBtnQuizNext);
  }

  function advanceQuiz() {
    state.qIdx++;
    if (state.qIdx >= state.qSet.length) {
      showQuizResult();
    } else {
      showQuestion();
    }
  }

  function showQuizResult() {
    hide(elQuizPanel);
    hide(elBtnQuizNext);
    show(elQuizResult);

    var pct = Math.round(state.qScore / state.qSet.length * 100);
    var stars = '', verdict = '';
    if (pct === 100) { stars = '\u2605\u2605\u2605\u2605\u2605'; verdict = 'Perfect score!'; }
    else if (pct >= 80) { stars = '\u2605\u2605\u2605\u2605\u2606'; verdict = 'Great job!'; }
    else if (pct >= 60) { stars = '\u2605\u2605\u2605\u2606\u2606'; verdict = 'Good effort!'; }
    else if (pct >= 40) { stars = '\u2605\u2605\u2606\u2606\u2606'; verdict = 'Room for improvement.'; }
    else { stars = '\u2605\u2606\u2606\u2606\u2606'; verdict = 'Keep studying!'; }

    if (elQRScore) elQRScore.textContent = state.qScore + ' / ' + state.qSet.length + ' (' + pct + '%)';
    if (elQRStars) elQRStars.textContent = stars;
    if (elQRVerdict) elQRVerdict.textContent = verdict;

    if (elQRTable) {
      var html = '';
      state.qResults.forEach(function (r, ri) {
        var cls = r.correct ? 'ok' : 'err';
        html += '<div class="qr-row ' + cls + '">';
        html += '<span class="qr-qnum">Q' + (ri + 1) + '</span>';
        html += '<span class="qr-detail">' + r.q.substring(0, 80) + (r.q.length > 80 ? '...' : '') + '</span>';
        html += '<span class="qr-answer">' + r.rightAnswer + '</span>';
        html += '<span class="qr-mark">' + (r.correct ? '\u2713' : '\u2717') + '</span>';
        html += '</div>';
      });
      elQRTable.innerHTML = html;
    }
  }

