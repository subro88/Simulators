  /* ── Explore: ASTM E8 specimen ──────────────────────── */
  function drawExploreASTME8(cx, cy) {
    /* Standard round specimen outline */
    var sx = cx - 180, sy = cy - 20;
    var totalLen = 360, gaugeLen = 160, diaBody = 40, diaGrip = 60;

    /* Grip end (left) */
    eCtx.fillStyle = '#607d8b';
    roundRect(eCtx, sx, sy - diaGrip / 2 + diaBody / 2, 60, diaGrip, 4);
    eCtx.fill();

    /* Fillet (left) */
    eCtx.beginPath();
    eCtx.moveTo(sx + 60, sy - diaGrip / 2 + diaBody / 2);
    eCtx.quadraticCurveTo(sx + 80, sy, sx + 100, sy);
    eCtx.lineTo(sx + 100, sy + diaBody);
    eCtx.quadraticCurveTo(sx + 80, sy + diaBody, sx + 60, sy + diaGrip / 2 + diaBody / 2);
    eCtx.fill();

    /* Gauge section */
    eCtx.fillStyle = '#78909c';
    eCtx.fillRect(sx + 100, sy, gaugeLen, diaBody);

    /* Fillet (right) */
    eCtx.fillStyle = '#607d8b';
    eCtx.beginPath();
    eCtx.moveTo(sx + 260, sy);
    eCtx.quadraticCurveTo(sx + 280, sy, sx + 300, sy - diaGrip / 2 + diaBody / 2);
    eCtx.lineTo(sx + 300, sy + diaGrip / 2 + diaBody / 2);
    eCtx.quadraticCurveTo(sx + 280, sy + diaBody, sx + 260, sy + diaBody);
    eCtx.closePath();
    eCtx.fill();

    /* Grip end (right) */
    roundRect(eCtx, sx + 300, sy - diaGrip / 2 + diaBody / 2, 60, diaGrip, 4);
    eCtx.fill();

    /* Dimension: gauge length */
    eCtx.strokeStyle = '#f5c842';
    eCtx.lineWidth = 1;
    eCtx.beginPath();
    eCtx.moveTo(sx + 100, sy + diaBody + 20);
    eCtx.lineTo(sx + 260, sy + diaBody + 20);
    eCtx.stroke();
    eCtx.beginPath(); eCtx.moveTo(sx + 100, sy + diaBody + 15); eCtx.lineTo(sx + 100, sy + diaBody + 25); eCtx.stroke();
    eCtx.beginPath(); eCtx.moveTo(sx + 260, sy + diaBody + 15); eCtx.lineTo(sx + 260, sy + diaBody + 25); eCtx.stroke();
    eCtx.fillStyle = '#f5c842';
    eCtx.font = 'bold 10px "Courier New", monospace';
    eCtx.textAlign = 'center';
    eCtx.fillText('L\u2080 = 50 mm (4 \u00D7 d\u2080)', sx + 180, sy + diaBody + 35);

    /* Dimension: diameter */
    eCtx.strokeStyle = '#4caf50';
    eCtx.beginPath();
    eCtx.moveTo(sx + 180, sy - 15);
    eCtx.lineTo(sx + 180, sy + diaBody + 5);
    eCtx.stroke();
    eCtx.fillStyle = '#4caf50';
    eCtx.fillText('d\u2080 = 12.5 mm', sx + 180, sy - 20);

    drawExploreTitleLabel('ASTM E8 Standard Tensile Specimen');
  }

  /* ── Explore: ASTM E9 ──────────────────────────────── */
  function drawExploreASTME9(cx, cy) {
    /* Short cylinder for compression */
