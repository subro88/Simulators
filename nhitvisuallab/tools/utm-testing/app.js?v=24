  function kpiCard(label, val, unit) {
    return '<div class="kpi"><div class="lbl">' + label + '</div>' +
      '<div class="val">' + val +
      '<span class="unit"> ' + unit + '</span></div></div>';
  }

  function escapeHtml(s) {
    if (s === null || s === undefined) return '';
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;')
      .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  /* Re-render the stress-strain curve onto a private canvas with a
     light theme (white background, dark text/lines) so the report
     prints cleanly on paper. Returns a PNG dataURL. */
  function buildReportGraph(mat) {
    var W = 1100, H = 620;
    var c = document.createElement('canvas');
    c.width = W; c.height = H;
    var x = c.getContext('2d');
    /* Background */
    x.fillStyle = '#ffffff';
    x.fillRect(0, 0, W, H);
    /* Plot area */
    var pad = { l: 80, r: 30, t: 50, b: 60 };
    var pw = W - pad.l - pad.r;
    var ph = H - pad.t - pad.b;
    /* Title */
    x.fillStyle = '#0d47a1';
    x.font = 'bold 20px "Segoe UI", system-ui, sans-serif';
    x.textAlign = 'center';
    x.fillText('Engineering Stress–Strain Curve', W / 2, 24);
    x.fillStyle = '#37474f';
    x.font = '13px "Segoe UI", system-ui, sans-serif';
    x.fillText(mat.name + '  —  ' +
      (state.testType === 'tensile' ? 'Tensile (ASTM E8)' : 'Compression (ASTM E9)'),
      W / 2, 44);

    if (!state.curveData || state.curveData.length === 0) return c.toDataURL('image/png');

    /* Scales — same logic as live graph but isolated */
    var maxStrain = 0, maxStress = 0;
    for (var i = 0; i < state.curveData.length; i++) {
      if (state.curveData[i].strain > maxStrain) maxStrain = state.curveData[i].strain;
      if (state.curveData[i].stress > maxStress) maxStress = state.curveData[i].stress;
    }
    maxStrain = Math.max(maxStrain * 1.1, 0.01);
    maxStress = Math.max(maxStress * 1.15, 1);

    /* Grid + ticks */
    x.strokeStyle = '#cfd8dc';
    x.lineWidth = 0.6;
    x.font = '11px "Courier New", monospace';
    x.fillStyle = '#455a64';
    x.textAlign = 'right';
    for (var gy = 0; gy <= 5; gy++) {
      var y0 = pad.t + ph - (gy / 5) * ph;
      x.beginPath(); x.moveTo(pad.l, y0); x.lineTo(pad.l + pw, y0); x.stroke();
      x.fillText(Math.round((gy / 5) * maxStress), pad.l - 6, y0 + 4);
    }
    x.textAlign = 'center';
    for (var gx = 0; gx <= 5; gx++) {
      var x0 = pad.l + (gx / 5) * pw;
      x.beginPath(); x.moveTo(x0, pad.t); x.lineTo(x0, pad.t + ph); x.stroke();
      x.fillText(((gx / 5) * maxStrain).toFixed(3), x0, pad.t + ph + 16);
    }

    /* Axes */
    x.strokeStyle = '#263238';
    x.lineWidth = 1.5;
    x.beginPath();
    x.moveTo(pad.l, pad.t);
    x.lineTo(pad.l, pad.t + ph);
    x.lineTo(pad.l + pw, pad.t + ph);
    x.stroke();
    /* Axis labels */
    x.fillStyle = '#263238';
    x.font = '600 13px "Segoe UI", sans-serif';
    x.textAlign = 'center';
    x.fillText('Strain  ε', pad.l + pw / 2, H - 18);
    x.save();
    x.translate(22, pad.t + ph / 2);
    x.rotate(-Math.PI / 2);
    x.textAlign = 'center';
    x.fillText('Stress  σ  (' + uLabel('stress') + ')', 0, 0);
    x.restore();

    var sx = function (s) { return pad.l + (s / maxStrain) * pw; };
    var sy = function (st) { return pad.t + ph - (st / maxStress) * ph; };

    /* Toughness fill (light blue) */
    x.fillStyle = 'rgba(30,136,229,0.13)';
    x.beginPath();
    x.moveTo(sx(0), sy(0));
    for (var ai = 0; ai < state.curveData.length; ai++) {
      x.lineTo(sx(state.curveData[ai].strain), sy(state.curveData[ai].stress));
    }
    var lastA = state.curveData[state.curveData.length - 1];
    x.lineTo(sx(lastA.strain), sy(0));
    x.closePath();
    x.fill();

    /* Curve */
    x.strokeStyle = '#1565c0';
    x.lineWidth = 2.2;
    x.beginPath();
    for (var pi = 0; pi < state.curveData.length; pi++) {
      var px = sx(state.curveData[pi].strain);
      var py = sy(state.curveData[pi].stress);
      if (pi === 0) x.moveTo(px, py); else x.lineTo(px, py);
    }
    x.stroke();

    /* Yield marker */
    if (mat.sigmaY > 0 && mat.type !== 'hyperelastic') {
      var yIdx = findYieldIndex(state.curveData, mat);
      if (yIdx > 0) {
        var yPt = state.curveData[yIdx];
        x.fillStyle = '#2e7d32';
        x.beginPath();
        x.arc(sx(yPt.strain), sy(yPt.stress), 5, 0, Math.PI * 2);
        x.fill();
        x.fillStyle = '#1b5e20';
        x.font = '600 11px "Courier New", monospace';
        x.textAlign = 'left';
        x.fillText('σy = ' + Math.round(yPt.stress) + ' MPa',
          sx(yPt.strain) + 8, sy(yPt.stress) - 6);
      }
    }
    /* UTS marker */
    var utsIdx = findUTSIndex(state.curveData);
    if (utsIdx > 0) {
      var uPt = state.curveData[utsIdx];
      x.fillStyle = '#c62828';
      x.beginPath();
      x.arc(sx(uPt.strain), sy(uPt.stress), 5, 0, Math.PI * 2);
      x.fill();
      x.fillStyle = '#b71c1c';
      x.font = '600 11px "Courier New", monospace';
      x.textAlign = 'center';
      x.fillText('UTS = ' + Math.round(uPt.stress) + ' MPa',
        sx(uPt.strain), sy(uPt.stress) - 10);
    }
    /* Fracture marker */
    if (mat.type !== 'hyperelastic' && lastA) {
      x.strokeStyle = '#c62828';
      x.lineWidth = 2;
      var fx = sx(lastA.strain), fy = sy(lastA.stress);
      x.beginPath();
      x.moveTo(fx - 5, fy - 5); x.lineTo(fx + 5, fy + 5);
      x.moveTo(fx + 5, fy - 5); x.lineTo(fx - 5, fy + 5);
      x.stroke();
      x.fillStyle = '#b71c1c';
      x.font = '600 11px "Courier New", monospace';
      x.textAlign = 'left';
      x.fillText('Fracture', fx + 8, fy + 4);
    }

    /* Footer watermark */
    x.fillStyle = 'rgba(0,0,0,0.30)';
    x.font = '11px "Segoe UI", sans-serif';
    x.textAlign = 'right';
    x.fillText('mechsimulator.com', W - 14, H - 6);

    return c.toDataURL('image/png');
  }

  /* ================================================================
     S19b — CONTEXT MENU (Graph + Machine canvases)
     ================================================================ */
  var ctxMenu = null;

  function removeCtxMenu() {
    if (ctxMenu && ctxMenu.parentNode) ctxMenu.parentNode.removeChild(ctxMenu);
    ctxMenu = null;
  }

  document.addEventListener('pointerdown', function (e) {
    if (ctxMenu && !ctxMenu.contains(e.target)) removeCtxMenu();
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') removeCtxMenu();
  });

  function showCtxMenu(x, y, items) {
    removeCtxMenu();
    ctxMenu = document.createElement('div');
    ctxMenu.className = 'ctx-menu';

    for (var ci = 0; ci < items.length; ci++) {
      if (items[ci].sep) {
        var sep = document.createElement('div');
        sep.className = 'ctx-sep';
        ctxMenu.appendChild(sep);
        continue;
      }
      var item = document.createElement('div');
      item.className = 'ctx-item';
      item.innerHTML = '<span class="ctx-item-icon">' + items[ci].icon + '</span>' + items[ci].label;
      (function (fn) {
        item.addEventListener('click', function () { removeCtxMenu(); fn(); });
      })(items[ci].action);
      ctxMenu.appendChild(item);
    }

    document.body.appendChild(ctxMenu);

    /* Clamp to viewport */
    var rect = ctxMenu.getBoundingClientRect();
    if (x + rect.width > window.innerWidth) x = window.innerWidth - rect.width - 8;
    if (y + rect.height > window.innerHeight) y = window.innerHeight - rect.height - 8;
    ctxMenu.style.left = x + 'px';
    ctxMenu.style.top = y + 'px';
  }

  /* ── Helper: find nearest curve point at canvas X ── */
  function getNearestCurvePoint(canvasX) {
    if (!state.curveData || state.curveData.length === 0) return null;
    var graphCanvas = $('graph-canvas');
    if (!graphCanvas) return null;
    var scales = getGraphScales();
    var cssW = graphCanvas.getBoundingClientRect().width || GW;
    /* canvasX is in CSS px [0..cssW]; GOX/GGW are in logical px [0..GW]. */
    var px = canvasX * (GW / cssW);
    var strain = ((px - GOX) / GGW) * scales.maxStrain;
    if (strain < 0) strain = 0;

    var bestIdx = 0, bestDist = Infinity;
    for (var i = 0; i < state.curveData.length; i++) {
      var d = Math.abs(state.curveData[i].strain - strain);
      if (d < bestDist) { bestDist = d; bestIdx = i; }
    }
    return state.curveData[bestIdx];
  }

  /* ── Graph canvas context menu ── */
  var graphCanvasEl = $('graph-canvas');

  /* ── Collapsible Display panel ── */
  (function () {
    var toggle = $('gopt-toggle');
    var panel = $('graph-opts');
    if (toggle && panel) {
      toggle.addEventListener('click', function () {
        var collapsed = panel.classList.toggle('collapsed');
        toggle.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
      });
    }
  })();

  /* ── Graph display controls: All-Labels master + per-category + grid + compare ── */
  (function () {
    var labelIds = ['opt-markers', 'opt-regions', 'opt-offset', 'opt-energy'];
    var master = $('opt-all-labels');

    /* Reflect the 4 label categories onto the master checkbox
       (checked = all on, indeterminate = some on). */
    function syncMaster() {
      if (!master) return;
      var on = 0;
      for (var i = 0; i < labelIds.length; i++) {
        var el = $(labelIds[i]); if (el && el.checked) on++;
      }
      master.checked = on === labelIds.length;
      master.indeterminate = on > 0 && on < labelIds.length;
    }

    function bindCategory(id, apply) {
      var el = $(id);
      if (!el) return;
      el.addEventListener('change', function () {
        apply(this.checked);
        syncMaster();
        drawGraph();
      });
    }
    bindCategory('opt-markers', function (v) { state.lblMarkers = v; });
    bindCategory('opt-regions', function (v) { state.lblRegions = v; });
    bindCategory('opt-offset',  function (v) { state.lblOffset = v; });
    bindCategory('opt-energy',  function (v) { state.lblEnergy = v; });

    /* Master toggles all four label categories at once. */
    if (master) {
      master.addEventListener('change', function () {
        var v = this.checked;
        this.indeterminate = false;
        state.lblMarkers = state.lblRegions = state.lblOffset = state.lblEnergy = v;
        for (var i = 0; i < labelIds.length; i++) {
          var el = $(labelIds[i]); if (el) el.checked = v;
        }
        drawGraph();
      });
    }

    /* Canvas controls */
    var optGrid = $('opt-grid');
    if (optGrid) optGrid.addEventListener('change', function () { showGrid = this.checked; drawGraph(); });
    var optCompare = $('opt-compare');
    if (optCompare) optCompare.addEventListener('change', function () {
      state.compare = this.checked;
      if (!this.checked) state.ghostHover = null;
      drawGraph();
    });

    /* Sync initial checked state to defaults */
    var defaults = { 'opt-markers': state.lblMarkers, 'opt-regions': state.lblRegions,
      'opt-offset': state.lblOffset, 'opt-energy': state.lblEnergy,
      'opt-grid': showGrid, 'opt-compare': state.compare };
    for (var id in defaults) { var d = $(id); if (d) d.checked = defaults[id]; }
    syncMaster();
  })();

  /* ── Ghost-curve hover → show previous material's name ── */
  if (graphCanvasEl) {
    graphCanvasEl.addEventListener('mousemove', function (e) {
      if (!state.compare || !state._ghostPts || !state.ghost) {
        if (state.ghostHover) { state.ghostHover = null; drawGraph(); }
        return;
      }
      var rect = graphCanvasEl.getBoundingClientRect();
      if (!rect.width || !rect.height) return;
      var lx = (e.clientX - rect.left) * (GW / rect.width);
      var ly = (e.clientY - rect.top) * (GH / rect.height);
      var best = 1e9, bp = null;
      for (var i = 0; i < state._ghostPts.length; i++) {
        var p = state._ghostPts[i];
        var d = Math.hypot(p.x - lx, p.y - ly);
        if (d < best) { best = d; bp = p; }
      }
      if (best < 14 && bp) {
        if (!state.ghostHover || state.ghostHover.px !== bp.x || state.ghostHover.py !== bp.y) {
          state.ghostHover = { x: lx, y: ly, px: bp.x, py: bp.y, name: state.ghost.matName };
          drawGraph();
        }
      } else if (state.ghostHover) {
        state.ghostHover = null;
        drawGraph();
      }
    });
    graphCanvasEl.addEventListener('mouseleave', function () {
      if (state.ghostHover) { state.ghostHover = null; drawGraph(); }
    });
  }

  if (graphCanvasEl) {
    graphCanvasEl.addEventListener('contextmenu', function (e) {
      e.preventDefault();
      var cRect = graphCanvasEl.getBoundingClientRect();
      var localX = e.clientX - cRect.left;

      var items = [];

      /* Copy value at cursor (only if we have curve data) */
      if (state.curveData && state.curveData.length > 0) {
        var pt = getNearestCurvePoint(localX);
        if (pt) {
          var copyText = 'Strain: ' + pt.strain.toFixed(5) +
            '  Stress: ' + toD(pt.stress, 'stress').toFixed(2) + ' ' + uLabel('stress');
          items.push({
            icon: '\uD83D\uDCCB', label: 'Copy Value (' + toD(pt.stress, 'stress').toFixed(0) + ' ' + uLabel('stress') + ')',
            action: function () {
              navigator.clipboard.writeText(copyText).catch(function () {});
            }
          });
        }
      }

      items.push({
        icon: '\uD83D\uDCC8', label: 'Save Graph as PNG',
        action: function () { var btn = $('btn-export-png'); if (btn) btn.click(); }
      });
      items.push({
        icon: '\uD83D\uDCC4', label: 'Export CSV Data',
        action: function () { var btn = $('btn-export-csv'); if (btn) btn.click(); }
      });

      items.push({ sep: true });

      items.push({
        icon: showGrid ? '\u2611' : '\u2610', label: showGrid ? 'Hide Grid' : 'Show Grid',
        action: function () { showGrid = !showGrid; drawGraph(); }
      });

      items.push({ sep: true });

      items.push({
        icon: '\u21BA', label: 'Reset Test',
        action: function () { resetTest(); drawMachine(); drawGraph(); }
      });

      showCtxMenu(e.clientX, e.clientY, items);
    });
  }

  /* ── Machine canvas context menu ── */
  var machineCanvasEl = $('machine-canvas');
  if (machineCanvasEl) {
    machineCanvasEl.addEventListener('contextmenu', function (e) {
      e.preventDefault();
      var items = [
        {
          icon: '\u21BA', label: 'Reset Test',
          action: function () { resetTest(); drawMachine(); drawGraph(); }
        }
      ];

      if (state.curveData && state.curveData.length > 0) {
        items.unshift({
          icon: '\uD83D\uDCC8', label: 'Save Graph as PNG',
          action: function () { var btn = $('btn-export-png'); if (btn) btn.click(); }
        });
        items.unshift({
          icon: '\uD83D\uDCC4', label: 'Export CSV Data',
          action: function () { var btn = $('btn-export-csv'); if (btn) btn.click(); }
        });
      }

      showCtxMenu(e.clientX, e.clientY, items);
    });
  }

