  /* ================================================================
     S8 — CANVAS SETUP
     ================================================================ */
  var mCanvas = $('machine-canvas'), mCtx = mCanvas.getContext('2d');
  var gCanvas = $('graph-canvas'),   gCtx = gCanvas.getContext('2d');
  var eCanvas = $('explore-canvas'), eCtx = eCanvas ? eCanvas.getContext('2d') : null;

  var MW = 720, MH = 700, GW = 560, GH = 450;
  var EW = 900, EH = 400;
  var dpr = Math.min(window.devicePixelRatio || 1, 2);

  /* Fluid DPR-aware canvas sizing.
     Logical drawing coords remain in (logW × logH) space. The backing store
     is sized to cssW × dpr (where cssW is the canvas's actual rendered CSS
     width, capped at logW to avoid upscaling). ctx is scaled so existing
     draw code at logical coords renders correctly. */
  function sizeCanvasFluid(canvas, ctx, logW, logH, fillMax) {
    if (!canvas || !ctx) return;
    /* Record refs so ResizeObserver can resize later (e.g. when an
       initially-hidden mode is shown for the first time). */
    canvas._logW = logW; canvas._logH = logH; canvas._ctxRef = ctx;
    canvas._fillMax = fillMax || 0;
    var newDpr = Math.min(window.devicePixelRatio || 1, 2);
    /* Available width: parent's content-box width — we read this BEFORE
       writing any style.width on the canvas, so changing our own style
       can never cause a ResizeObserver feedback loop. */
    var parent = canvas.parentElement;
    if (!parent) return;
    var pcs = window.getComputedStyle(parent);
    var availW = parent.clientWidth
      - parseFloat(pcs.paddingLeft || 0)
      - parseFloat(pcs.paddingRight || 0);
    if (!isFinite(availW) || availW < 60) {
      /* Parent not laid out yet (e.g. hidden mode). Skip — will retry on show/resize. */
      return;
    }
    /* Width: normally capped at logical size to avoid upscaling. When a
       fillMax is given (graph canvas), let it fill the card up to fillMax —
       the graph is vector-drawn so it stays crisp at any scale, and filling
       removes the right-hand margin so the Display panel overlays the canvas. */
    var cssW = canvas._fillMax
      ? Math.min(availW, canvas._fillMax)
      : Math.min(availW, logW);
    var cssH = cssW * (logH / logW);
    /* No-op when CSS size and DPR are unchanged — keeps RO storms from
       redrawing every frame and prevents mid-test transform resets. */
    if (canvas._appliedCssW === cssW && canvas._appliedDpr === newDpr) {
      return;
    }
    dpr = newDpr;
    canvas._appliedCssW = cssW;
    canvas._appliedDpr = newDpr;
    canvas.width  = Math.max(1, Math.round(cssW * dpr));
    canvas.height = Math.max(1, Math.round(cssH * dpr));
    canvas.style.width  = cssW + 'px';
    canvas.style.height = cssH + 'px';
    var s = (cssW * dpr) / logW;
    ctx.setTransform(s, 0, 0, s, 0, 0);
    canvas.style.touchAction = 'none';
  }

  function initCanvases() {
    sizeCanvasFluid(mCanvas, mCtx, MW, MH);
    sizeCanvasFluid(gCanvas, gCtx, GW, GH, 960);   /* graph fills its card (panel overlays it) */
    if (eCanvas) sizeCanvasFluid(eCanvas, eCtx, EW, EH);
    attachCanvasResizeObservers();
  }

  var _roAttached = false;
  function attachCanvasResizeObservers() {
    if (_roAttached || typeof ResizeObserver === 'undefined') return;
    _roAttached = true;
    var ro = new ResizeObserver(function (entries) {
      for (var i = 0; i < entries.length; i++) {
        var el = entries[i].target;
        if (!el._logW) continue;
        var prev = el.clientWidth;
        sizeCanvasFluid(el, el._ctxRef, el._logW, el._logH, el._fillMax);
        /* After resize, redraw whichever canvas this is */
        if (el === mCanvas) drawMachine();
        else if (el === gCanvas) drawGraph();
        else if (el === eCanvas && state.mode === 'explore') {
          if (typeof selectConcept === 'function') selectConcept(state.expIdx);
        }
      }
    });
    if (mCanvas) ro.observe(mCanvas);
    if (gCanvas) ro.observe(gCanvas);
    if (eCanvas) ro.observe(eCanvas);
  }

  /* ================================================================
     S9 — MACHINE CANVAS DRAWING (~700 lines)
     ================================================================ */

  /* Main machine draw entry point */
  function drawMachine() {
    if (!mCtx) return;
    mCtx.clearRect(0, 0, MW, MH);

    /* Phase-3: fracture camera shake — wraps the entire frame.
       Decays to zero over ~220 ms. */
    var nowMs = performance.now();
    var shakeAge = state.fractureFlashT ? nowMs - state.fractureFlashT : 9999;
    var didShake = false;
    if (shakeAge < 220) {
      var decay = 1 - shakeAge / 220;
      var amp = 4 * decay;
      var sx = Math.sin(nowMs / 9) * amp;
      var sy = Math.cos(nowMs / 11) * amp;
      mCtx.save();
      mCtx.translate(sx, sy);
      didShake = true;
    }

    drawMachineBackground();
    drawBasePlate();
    drawColumns();
    drawTopBeam();

    var crossheadY = getCrossheadY();
    drawCrosshead(crossheadY);
    drawLoadCell(crossheadY);
    drawUpperGrip(crossheadY);
    drawLowerPlatform();
    drawLowerGrip();
    drawSpecimen(crossheadY);
    /* On-canvas Digital Readout, Status LEDs, and Test Status panels were
       removed in Phase 1: they duplicated the live-strip badges + lab-step
       chips that live as HTML below the canvas, and they forced the right
       ~180px of the machine canvas to be reserved for instrument panels.
       Removing them frees that space for the machine illustration. */
    drawScaleMarkings(crossheadY);
    drawForceArrows(crossheadY);
    drawFractureParticles(crossheadY);
    drawSafetyGuard();
    drawMachineLabel();

    /* Phase-3: UTS ring pulse — expanding red circle at specimen middle */
    var utsAge = state.utsPulseT ? nowMs - state.utsPulseT : 9999;
    if (utsAge < 1200 && state.mounted) {
      var contactDepthU = state.testType === 'compression' ? 14 : 35;
      var upperGripBot = crossheadY + 14 + 20 + contactDepthU;
      var lowerGripTop = MPLATFORM_Y - contactDepthU;
      var midY = (upperGripBot + lowerGripTop) / 2;
      var t = utsAge / 1200;
      var r = 14 + t * 60;
      var a = (1 - t) * 0.85;
      mCtx.save();
      mCtx.strokeStyle = 'rgba(255,82,82,' + a.toFixed(3) + ')';
      mCtx.lineWidth = 2.5 * (1 - t * 0.6);
      mCtx.beginPath();
      mCtx.arc(MCX, midY, r, 0, Math.PI * 2);
      mCtx.stroke();
      /* inner second ring */
      if (t < 0.6) {
        mCtx.strokeStyle = 'rgba(255,160,160,' + (a * 0.5).toFixed(3) + ')';
        mCtx.lineWidth = 1.5;
        mCtx.beginPath();
        mCtx.arc(MCX, midY, r * 0.6, 0, Math.PI * 2);
        mCtx.stroke();
      }
      mCtx.restore();
    }

    /* Phase-3: fracture white-flash — top overlay during shake window */
    var flashAge = state.fractureFlashT ? nowMs - state.fractureFlashT : 9999;
    if (flashAge < 130) {
      mCtx.save();
      mCtx.setTransform(1, 0, 0, 1, 0, 0); /* identity for full-canvas overlay */
      mCtx.fillStyle = 'rgba(255,255,255,' + (0.55 * (1 - flashAge / 130)).toFixed(3) + ')';
      mCtx.fillRect(0, 0, mCanvas.width, mCanvas.height);
      mCtx.restore();
    }

    if (didShake) mCtx.restore();

    /* Keep animating while any effect is active */
    if (state.animPhase !== 'testing' && state.animPhase !== 'fracture' && state.animPhase !== 'mounting') {
      if (shakeAge < 220 || utsAge < 1200 || flashAge < 130 ||
          (state.yieldFlashT && nowMs - state.yieldFlashT < 800)) {
        requestAnimationFrame(drawMachine);
      }
    }
  }

  /* 1. Machine Background — studio gradient + cool-steel spotlight so the
     load frame sits in a lit space instead of floating on flat fill. */
  function drawMachineBackground() {
    var bg = mCtx.createLinearGradient(0, 0, 0, MH);
    bg.addColorStop(0, '#121926');
    bg.addColorStop(0.55, '#0d1117');
    bg.addColorStop(1, '#080b10');
    mCtx.fillStyle = bg;
    mCtx.fillRect(0, 0, MW, MH);

    /* Accent spotlight behind the working zone (specimen area) */
    var glow = mCtx.createRadialGradient(MCX, 330, 40, MCX, 330, 470);
    glow.addColorStop(0, 'rgba(30,136,229,0.10)');
    glow.addColorStop(1, 'rgba(30,136,229,0)');
    mCtx.fillStyle = glow;
    mCtx.fillRect(0, 0, MW, MH);

    /* Subtle grid (softened over the gradient) */
    mCtx.strokeStyle = 'rgba(42,48,80,0.12)';
    mCtx.lineWidth = 0.5;
    for (var gx = 0; gx < MW; gx += 20) {
      mCtx.beginPath(); mCtx.moveTo(gx, 0); mCtx.lineTo(gx, MH); mCtx.stroke();
    }
    for (var gy = 0; gy < MH; gy += 20) {
      mCtx.beginPath(); mCtx.moveTo(0, gy); mCtx.lineTo(MW, gy); mCtx.stroke();
    }

    /* Lab-floor band under the feet — grounds the machine */
    var floorY = MBASE_Y + MBASE_H + 26;
    var floor = mCtx.createLinearGradient(0, floorY, 0, MH);
    floor.addColorStop(0, 'rgba(26,33,48,0.85)');
    floor.addColorStop(1, 'rgba(10,13,19,0.9)');
    mCtx.fillStyle = floor;
    mCtx.fillRect(0, floorY, MW, MH - floorY);
    mCtx.strokeStyle = 'rgba(120,140,170,0.14)';
    mCtx.lineWidth = 1;
    mCtx.beginPath();
    mCtx.moveTo(0, floorY + 0.5);
    mCtx.lineTo(MW, floorY + 0.5);
    mCtx.stroke();
  }

  /* Machine geometry constants */
  var MCOL_X1 = 180;               /* left column left edge */
  var MCOL_X2 = 510;               /* right column left edge */
  var MCOL_W = 30;                 /* column width */
  var MCOL_TOP = 60;               /* top of columns */
  var MCOL_BOT = 620;              /* bottom of columns — flush with base plate */
  var MBASE_Y = 620;               /* base plate top */
  var MBASE_H = 40;                /* base plate height */
  var MBEAM_Y = 45;                /* top beam top */
  var MBEAM_H = 18;                /* top beam height */
  var MPLATFORM_Y = 520;           /* lower platform y */
  var MPLATFORM_H = 14;            /* lower platform height */
  var MCX = (MCOL_X1 + MCOL_X2 + MCOL_W) / 2; /* machine center x */

  /* Default crosshead Y (resting position) */
  var DEFAULT_CH_Y = 220;

  function getCrossheadY() {
    var mat = MATERIALS[state.matIdx];
    var baseY = DEFAULT_CH_Y;

    if (state.animPhase === 'idle' && !state.mounted) return baseY;
    if (state.animPhase === 'idle' && state.mounted && state.testProgress === 0) return baseY;

    if (state.animPhase === 'mounting') return baseY;

    /* During test: crosshead moves based on specimen extension/compression */
    var maxTravel = 0;
    if (state.testType === 'tensile') {
      /* Upward movement for tensile */
      maxTravel = mat.epsF * state.gl * 0.8;
      /* Cap visual movement */
      maxTravel = Math.min(maxTravel, 120);
      if (mat.type === 'hyperelastic') maxTravel = 100;
      return baseY - state.testProgress * maxTravel;
    } else {
      /* Downward movement for compression */
      maxTravel = 30;
      if (mat.type === 'brittle') maxTravel = 5;
      if (mat.type === 'hyperelastic') maxTravel = 50;
      return baseY + state.testProgress * maxTravel;
    }
  }

  /* 2. Base Plate */
  function drawBasePlate() {
    var bx = MCX - 210, by = MBASE_Y, bw = 420, bh = MBASE_H;

    /* Main base plate — heavy industrial look */
    var grad = mCtx.createLinearGradient(bx, by, bx, by + bh);
    grad.addColorStop(0, '#607d8b');
    grad.addColorStop(0.08, '#78909c');
    grad.addColorStop(0.3, '#546e7a');
    grad.addColorStop(0.7, '#455a64');
    grad.addColorStop(0.92, '#546e7a');
    grad.addColorStop(1, '#37474f');
    mCtx.fillStyle = grad;
    roundRect(mCtx, bx, by, bw, bh, 5);
    mCtx.fill();

    /* Top chamfer highlight */
    mCtx.strokeStyle = 'rgba(255,255,255,0.2)';
    mCtx.lineWidth = 1.5;
    mCtx.beginPath();
    mCtx.moveTo(bx + 5, by + 1);
    mCtx.lineTo(bx + bw - 5, by + 1);
    mCtx.stroke();

    /* T-slot grooves across the base plate */
    mCtx.strokeStyle = 'rgba(0,0,0,0.25)';
    mCtx.lineWidth = 2;
    var slotY = by + bh * 0.5;
    for (var si = 0; si < 3; si++) {
      var sx = bx + 60 + si * 130;
      mCtx.beginPath();
      mCtx.moveTo(sx, slotY - 4);
      mCtx.lineTo(sx + 40, slotY - 4);
      mCtx.stroke();
      /* Slot shadow */
      mCtx.fillStyle = 'rgba(0,0,0,0.15)';
      mCtx.fillRect(sx, slotY - 3, 40, 3);
    }

    /* Mounting bolts at corners */
    var boltPositions = [
      [bx + 18, by + bh / 2], [bx + bw - 18, by + bh / 2],
      [bx + 60, by + bh / 2], [bx + bw - 60, by + bh / 2]
    ];
    for (var bi = 0; bi < boltPositions.length; bi++) {
      var bpx = boltPositions[bi][0], bpy = boltPositions[bi][1];
      mCtx.fillStyle = '#37474f';
      mCtx.beginPath();
      mCtx.arc(bpx, bpy, 5, 0, Math.PI * 2);
      mCtx.fill();
      mCtx.fillStyle = '#546e7a';
      mCtx.beginPath();
      mCtx.arc(bpx, bpy, 3.5, 0, Math.PI * 2);
      mCtx.fill();
      /* Hex socket */
      mCtx.fillStyle = '#37474f';
      mCtx.beginPath();
      mCtx.arc(bpx, bpy, 1.5, 0, Math.PI * 2);
      mCtx.fill();
    }

    /* Bottom edge / bevel */
    mCtx.strokeStyle = 'rgba(0,0,0,0.3)';
    mCtx.lineWidth = 1;
    mCtx.beginPath();
    mCtx.moveTo(bx + 5, by + bh);
    mCtx.lineTo(bx + bw - 5, by + bh);
    mCtx.stroke();

    /* Shadow under base plate */
    mCtx.fillStyle = 'rgba(0,0,0,0.25)';
    roundRect(mCtx, bx + 8, by + bh + 1, bw - 16, 4, 2);
    mCtx.fill();

    /* Feet — 4 heavy ribbed levelling feet */
    var footW = 50, footH = 22;
    var feetX = [bx + 30, bx + bw - 30 - footW];
    for (var fti = 0; fti < feetX.length; fti++) {
      var fx = feetX[fti], fy = by + bh + 4;

      /* Foot body */
      var fGrad = mCtx.createLinearGradient(fx, fy, fx, fy + footH);
      fGrad.addColorStop(0, '#455a64');
      fGrad.addColorStop(0.4, '#37474f');
      fGrad.addColorStop(1, '#263238');
      mCtx.fillStyle = fGrad;
      roundRect(mCtx, fx, fy, footW, footH, 4);
      mCtx.fill();

      /* Ribs */
      mCtx.strokeStyle = 'rgba(255,255,255,0.06)';
      mCtx.lineWidth = 1;
      for (var ri = 0; ri < 3; ri++) {
        var ry = fy + 5 + ri * 6;
        mCtx.beginPath();
        mCtx.moveTo(fx + 4, ry);
        mCtx.lineTo(fx + footW - 4, ry);
        mCtx.stroke();
      }

      /* Adjustable pad at bottom */
      mCtx.fillStyle = '#1a2430';
      roundRect(mCtx, fx + footW / 2 - 12, fy + footH - 4, 24, 6, 3);
      mCtx.fill();
    }

    /* Floor shadow */
    mCtx.fillStyle = 'rgba(0,0,0,0.12)';
    mCtx.beginPath();
    mCtx.ellipse(MCX, by + bh + footH + 8, bw * 0.45, 4, 0, 0, Math.PI * 2);
    mCtx.fill();
  }

  /* 3. Columns */
  function drawColumns() {
    drawOneColumn(MCOL_X1, MCOL_TOP, MCOL_W, MCOL_BOT - MCOL_TOP);
    drawOneColumn(MCOL_X2, MCOL_TOP, MCOL_W, MCOL_BOT - MCOL_TOP);
  }

  function drawOneColumn(x, y, w, h) {
    /* Brushed-steel barrel — multi-stop horizontal gradient */
    var grad = mCtx.createLinearGradient(x, y, x + w, y);
    grad.addColorStop(0, '#263238');
    grad.addColorStop(0.18, '#546e7a');
    grad.addColorStop(0.40, '#8b9da7');
    grad.addColorStop(0.55, '#90a4ae');
    grad.addColorStop(0.72, '#607d8b');
    grad.addColorStop(1, '#1a2229');
    mCtx.fillStyle = grad;
    mCtx.fillRect(x, y, w, h);

    /* Specular highlight stripe (off-center) */
    var hiX = x + w * 0.42;
    var hiGrad = mCtx.createLinearGradient(hiX - 2, 0, hiX + 4, 0);
    hiGrad.addColorStop(0, 'rgba(255,255,255,0)');
    hiGrad.addColorStop(0.5, 'rgba(255,255,255,0.18)');
    hiGrad.addColorStop(1, 'rgba(255,255,255,0)');
    mCtx.fillStyle = hiGrad;
    mCtx.fillRect(hiX - 2, y, 6, h);

    /* Brushed-steel vertical micro-streaks */
    mCtx.strokeStyle = 'rgba(255,255,255,0.04)';
    mCtx.lineWidth = 0.5;
    for (var sx = x + 2; sx < x + w - 2; sx += 3) {
      mCtx.beginPath();
      mCtx.moveTo(sx, y);
      mCtx.lineTo(sx, y + h);
      mCtx.stroke();
    }

    /* Lead-screw threading in upper third — angled grooves */
    var threadTop = y;
    var threadBot = y + h * 0.32;
    mCtx.save();
    mCtx.beginPath();
    mCtx.rect(x, threadTop, w, threadBot - threadTop);
    mCtx.clip();
    mCtx.strokeStyle = 'rgba(0,0,0,0.32)';
    mCtx.lineWidth = 0.8;
    for (var ty = threadTop - w; ty < threadBot + w; ty += 5) {
      mCtx.beginPath();
      mCtx.moveTo(x - 2, ty);
      mCtx.lineTo(x + w + 2, ty + w * 0.45);
      mCtx.stroke();
    }
    /* Thread highlight */
    mCtx.strokeStyle = 'rgba(255,255,255,0.10)';
    for (var ty2 = threadTop - w; ty2 < threadBot + w; ty2 += 5) {
      mCtx.beginPath();
      mCtx.moveTo(x - 2, ty2 + 1.2);
      mCtx.lineTo(x + w + 2, ty2 + 1.2 + w * 0.45);
      mCtx.stroke();
    }
    mCtx.restore();

    /* Subtle horizontal seam at thread/smooth transition */
    mCtx.strokeStyle = 'rgba(0,0,0,0.35)';
    mCtx.lineWidth = 0.6;
    mCtx.beginPath();
    mCtx.moveTo(x, threadBot);
    mCtx.lineTo(x + w, threadBot);
    mCtx.stroke();

    /* Column edge shadows */
    mCtx.strokeStyle = 'rgba(0,0,0,0.55)';
    mCtx.lineWidth = 0.8;
    mCtx.beginPath();
    mCtx.moveTo(x + 0.4, y);
    mCtx.lineTo(x + 0.4, y + h);
    mCtx.stroke();
    mCtx.beginPath();
    mCtx.moveTo(x + w - 0.4, y);
    mCtx.lineTo(x + w - 0.4, y + h);
    mCtx.stroke();
  }

  /* 4. Top Beam */
  function drawTopBeam() {
    var bx = MCOL_X1, by = MBEAM_Y;
    var bw = MCOL_X2 + MCOL_W - MCOL_X1, bh = MBEAM_H;
    var grad = mCtx.createLinearGradient(bx, by, bx, by + bh);
    grad.addColorStop(0, '#546e7a');
    grad.addColorStop(0.3, '#78909c');
    grad.addColorStop(0.7, '#546e7a');
    grad.addColorStop(1, '#455a64');
    mCtx.fillStyle = grad;
    roundRect(mCtx, bx, by, bw, bh, 3);
    mCtx.fill();

    /* Highlight */
    mCtx.strokeStyle = 'rgba(255,255,255,0.12)';
    mCtx.lineWidth = 1;
    mCtx.beginPath();
    mCtx.moveTo(bx + 3, by + 1);
    mCtx.lineTo(bx + bw - 3, by + 1);
    mCtx.stroke();
  }

  /* 5. Crosshead */
  function drawCrosshead(chY) {
    var chX = MCOL_X1 + MCOL_W + 3;
    var chW = MCOL_X2 - MCOL_X1 - MCOL_W - 6;
    var chH = 14;

    /* Column collar rings first (so bar sits on top) */
    var collarGrad = mCtx.createLinearGradient(0, chY - 4, 0, chY + chH + 4);
    collarGrad.addColorStop(0, '#37474f');
    collarGrad.addColorStop(0.5, '#546e7a');
    collarGrad.addColorStop(1, '#263238');
    mCtx.fillStyle = collarGrad;
    roundRect(mCtx, MCOL_X1 - 3, chY - 4, MCOL_W + 6, chH + 8, 2);
    mCtx.fill();
    roundRect(mCtx, MCOL_X2 - 3, chY - 4, MCOL_W + 6, chH + 8, 2);
    mCtx.fill();

    /* Crosshead bar — main body */
    var grad = mCtx.createLinearGradient(chX, chY, chX, chY + chH);
    grad.addColorStop(0, '#0d47a1');
    grad.addColorStop(0.18, '#1565c0');
    grad.addColorStop(0.5, '#42a5f5');
    grad.addColorStop(0.82, '#1565c0');
    grad.addColorStop(1, '#0d47a1');
    mCtx.fillStyle = grad;
    roundRect(mCtx, chX, chY, chW, chH, 4);
    mCtx.fill();

    /* Top bevel highlight */
    mCtx.strokeStyle = 'rgba(255,255,255,0.42)';
    mCtx.lineWidth = 1.2;
    mCtx.beginPath();
    mCtx.moveTo(chX + 4, chY + 1.5);
    mCtx.lineTo(chX + chW - 4, chY + 1.5);
    mCtx.stroke();
    /* Bottom bevel shadow */
    mCtx.strokeStyle = 'rgba(0,0,0,0.35)';
    mCtx.lineWidth = 1;
    mCtx.beginPath();
    mCtx.moveTo(chX + 4, chY + chH - 1.5);
    mCtx.lineTo(chX + chW - 4, chY + chH - 1.5);
    mCtx.stroke();

    /* Bolt heads at four corners */
    var boltR = 1.8;
    var boltOffX = 7;
    var boltPositions = [
      { x: chX + boltOffX, y: chY + 3.5 },
      { x: chX + chW - boltOffX, y: chY + 3.5 },
      { x: chX + boltOffX, y: chY + chH - 3.5 },
      { x: chX + chW - boltOffX, y: chY + chH - 3.5 }
    ];
    for (var bi = 0; bi < boltPositions.length; bi++) {
      var bp = boltPositions[bi];
      var bgrad = mCtx.createRadialGradient(bp.x - 0.6, bp.y - 0.6, 0.4, bp.x, bp.y, boltR);
      bgrad.addColorStop(0, '#eceff1');
      bgrad.addColorStop(0.6, '#90a4ae');
      bgrad.addColorStop(1, '#37474f');
      mCtx.fillStyle = bgrad;
      mCtx.beginPath();
      mCtx.arc(bp.x, bp.y, boltR, 0, Math.PI * 2);
      mCtx.fill();
      /* Slot mark */
      mCtx.strokeStyle = 'rgba(0,0,0,0.55)';
      mCtx.lineWidth = 0.6;
      mCtx.beginPath();
      mCtx.moveTo(bp.x - boltR * 0.6, bp.y);
      mCtx.lineTo(bp.x + boltR * 0.6, bp.y);
      mCtx.stroke();
    }

    /* Direction-of-travel LED strip (centered, 3 dots) — only during test */
    if (state.animPhase === 'testing' || state.animPhase === 'mounting') {
      var goingUp = state.testType === 'tensile';
      var t = performance.now() / 220;
      var dotsX = MCX - 18;
      for (var di = 0; di < 3; di++) {
        var phaseDi = (goingUp ? -di : di);
        var lit = Math.floor(t + phaseDi) % 3 === 0;
        var dotX = dotsX + di * 18;
        mCtx.fillStyle = lit ? '#80d8ff' : 'rgba(120,144,156,0.45)';
        if (lit) mCtx.shadowColor = '#80d8ff', mCtx.shadowBlur = 6;
        mCtx.beginPath();
        mCtx.arc(dotX, chY + chH / 2, 1.6, 0, Math.PI * 2);
        mCtx.fill();
        mCtx.shadowBlur = 0;
      }
    }
  }

  /* 6. Load Cell */
  function drawLoadCell(chY) {
    var lcW = 50, lcH = 20;
    var lcX = MCX - lcW / 2;
    var lcY = chY + 14;

    var lcGrad = mCtx.createLinearGradient(lcX, lcY, lcX, lcY + lcH);
    lcGrad.addColorStop(0, '#26314c');
    lcGrad.addColorStop(0.45, '#1a2030');
    lcGrad.addColorStop(1, '#12172a');
    mCtx.fillStyle = lcGrad;
    roundRect(mCtx, lcX, lcY, lcW, lcH, 3);
    mCtx.fill();
    mCtx.strokeStyle = '#1e88e5';
    mCtx.lineWidth = 1.5;
    roundRect(mCtx, lcX, lcY, lcW, lcH, 3);
    mCtx.stroke();

    /* Load value text — respects SI / Imperial unit system */
    var curLoad = getCurrentLoad();
    mCtx.fillStyle = '#64b5f6';
    mCtx.font = 'bold 9px "Courier New", monospace';
    mCtx.textAlign = 'center';
    mCtx.textBaseline = 'middle';
    mCtx.fillText(toD(curLoad, 'force').toFixed(1) + ' ' + uLabel('force'), MCX, lcY + lcH / 2);
    mCtx.textBaseline = 'alphabetic';
  }

  /* 7. Upper Grip */
  function drawUpperGrip(chY) {
    var gripTopY = chY + 14 + 20; /* below load cell */
    var gripH = 35;

    if (state.testType === 'compression') {
      drawCompressionPlaten(gripTopY, /*upper=*/true);
      return;
    }

    var jawGap = 8 * state.gripOpen;

    /* Grip housing — beveled metal block */
    var housingGrad = mCtx.createLinearGradient(0, gripTopY, 0, gripTopY + 12);
    housingGrad.addColorStop(0, '#37474f');
    housingGrad.addColorStop(0.5, '#607d8b');
    housingGrad.addColorStop(1, '#263238');
    mCtx.fillStyle = housingGrad;
    roundRect(mCtx, MCX - 24, gripTopY, 48, 12, 2);
    mCtx.fill();

    /* Wedge jaws — left & right */
    var jawGrad = mCtx.createLinearGradient(0, gripTopY + 12, 0, gripTopY + gripH);
    jawGrad.addColorStop(0, '#78909c');
    jawGrad.addColorStop(1, '#455a64');
    mCtx.fillStyle = jawGrad;
    mCtx.beginPath();
    mCtx.moveTo(MCX - 22, gripTopY + 12);
    mCtx.lineTo(MCX - 6 - jawGap, gripTopY + gripH);
    mCtx.lineTo(MCX - 22, gripTopY + gripH);
    mCtx.closePath();
    mCtx.fill();
    mCtx.beginPath();
    mCtx.moveTo(MCX + 22, gripTopY + 12);
    mCtx.lineTo(MCX + 6 + jawGap, gripTopY + gripH);
    mCtx.lineTo(MCX + 22, gripTopY + gripH);
    mCtx.closePath();
    mCtx.fill();

    /* Serrated teeth on inner jaw faces */
    drawJawTeeth(MCX - 6 - jawGap, gripTopY + gripH, MCX - 22, gripTopY + 12, /*pointRight=*/true);
    drawJawTeeth(MCX + 6 + jawGap, gripTopY + gripH, MCX + 22, gripTopY + 12, /*pointRight=*/false);

    /* Knurled outer edges */
    mCtx.strokeStyle = 'rgba(255,255,255,0.10)';
    mCtx.lineWidth = 1;
    mCtx.beginPath();
    mCtx.moveTo(MCX - 22, gripTopY + 12);
    mCtx.lineTo(MCX - 22, gripTopY + gripH);
    mCtx.stroke();
    mCtx.beginPath();
    mCtx.moveTo(MCX + 22, gripTopY + 12);
    mCtx.lineTo(MCX + 22, gripTopY + gripH);
    mCtx.stroke();
  }

  /* Serrated teeth along a jaw's inner face (the line from inner-tip to outer-top). */
  function drawJawTeeth(tipX, tipY, baseX, baseY, pointRight) {
    var nTeeth = 6;
    var dx = baseX - tipX, dy = baseY - tipY;
    var len = Math.sqrt(dx * dx + dy * dy);
    if (len < 4) return;
    var ux = dx / len, uy = dy / len;
    /* Inward normal (toward specimen): perpendicular, toward MCX */
    var nx = pointRight ? -uy : uy;
    var ny = pointRight ? ux : -ux;
    var toothD = 1.6;
    mCtx.strokeStyle = 'rgba(0,0,0,0.55)';
    mCtx.lineWidth = 0.6;
    for (var ti = 0; ti < nTeeth; ti++) {
      var t = (ti + 0.5) / nTeeth;
      var px = tipX + ux * len * t;
      var py = tipY + uy * len * t;
      mCtx.beginPath();
      mCtx.moveTo(px, py);
      mCtx.lineTo(px + nx * toothD, py + ny * toothD);
      mCtx.stroke();
    }
    /* Tooth highlight */
    mCtx.strokeStyle = 'rgba(255,255,255,0.18)';
    for (var ti2 = 0; ti2 < nTeeth; ti2++) {
      var t2 = (ti2 + 0.5) / nTeeth;
      var px2 = tipX + ux * len * t2 + ux * 0.6;
      var py2 = tipY + uy * len * t2 + uy * 0.6;
      mCtx.beginPath();
      mCtx.moveTo(px2, py2);
      mCtx.lineTo(px2 + nx * toothD * 0.7, py2 + ny * toothD * 0.7);
      mCtx.stroke();
    }
  }

  /* Compression mode: flat hardened platen disc replaces grip jaws. */
  function drawCompressionPlaten(refY, upper) {
    /* refY = the gripTopY for upper, or the gripBotY origin for lower */
    var platenH = 14;
    var platenW = 70;
    var pTop = upper ? refY : (refY - platenH);
    var grad = mCtx.createLinearGradient(0, pTop, 0, pTop + platenH);
    grad.addColorStop(0, upper ? '#455a64' : '#37474f');
    grad.addColorStop(0.5, '#90a4ae');
    grad.addColorStop(1, upper ? '#37474f' : '#455a64');
    mCtx.fillStyle = grad;
    roundRect(mCtx, MCX - platenW / 2, pTop, platenW, platenH, 2);
    mCtx.fill();
    /* Bevel highlights */
    mCtx.strokeStyle = 'rgba(255,255,255,0.30)';
    mCtx.lineWidth = 0.8;
    mCtx.beginPath();
    mCtx.moveTo(MCX - platenW / 2 + 3, pTop + 1.4);
    mCtx.lineTo(MCX + platenW / 2 - 3, pTop + 1.4);
    mCtx.stroke();
    mCtx.strokeStyle = 'rgba(0,0,0,0.35)';
    mCtx.beginPath();
    mCtx.moveTo(MCX - platenW / 2 + 3, pTop + platenH - 1.4);
    mCtx.lineTo(MCX + platenW / 2 - 3, pTop + platenH - 1.4);
    mCtx.stroke();
    /* Contact-face thin Teflon sheet cue (white sliver) */
    var contactY = upper ? (pTop + platenH) : pTop;
    mCtx.fillStyle = 'rgba(255,255,255,0.45)';
    mCtx.fillRect(MCX - platenW / 2 + 5, contactY - (upper ? 1.2 : 0), platenW - 10, 1.2);
  }

  /* 8. Lower Grip */
  function drawLowerGrip() {
    var gripBotY = MPLATFORM_Y; /* sits on platform */
    var gripH = 35;
    var gripTopY = gripBotY - gripH;

    if (state.testType === 'compression') {
      drawCompressionPlaten(gripBotY, /*upper=*/false);
      return;
    }

    var jawGap = 8 * state.gripOpen;

    /* Housing */
    var housingGrad = mCtx.createLinearGradient(0, gripBotY - 12, 0, gripBotY);
    housingGrad.addColorStop(0, '#263238');
    housingGrad.addColorStop(0.5, '#607d8b');
    housingGrad.addColorStop(1, '#37474f');
    mCtx.fillStyle = housingGrad;
    roundRect(mCtx, MCX - 24, gripBotY - 12, 48, 12, 2);
    mCtx.fill();

    /* Wedge jaws (inverted) */
    var jawGrad = mCtx.createLinearGradient(0, gripTopY, 0, gripBotY - 12);
    jawGrad.addColorStop(0, '#455a64');
    jawGrad.addColorStop(1, '#78909c');
    mCtx.fillStyle = jawGrad;
    mCtx.beginPath();
    mCtx.moveTo(MCX - 22, gripBotY - 12);
    mCtx.lineTo(MCX - 6 - jawGap, gripTopY);
    mCtx.lineTo(MCX - 22, gripTopY);
    mCtx.closePath();
    mCtx.fill();
    mCtx.beginPath();
    mCtx.moveTo(MCX + 22, gripBotY - 12);
    mCtx.lineTo(MCX + 6 + jawGap, gripTopY);
    mCtx.lineTo(MCX + 22, gripTopY);
    mCtx.closePath();
    mCtx.fill();

    /* Teeth */
    drawJawTeeth(MCX - 6 - jawGap, gripTopY, MCX - 22, gripBotY - 12, /*pointRight=*/true);
    drawJawTeeth(MCX + 6 + jawGap, gripTopY, MCX + 22, gripBotY - 12, /*pointRight=*/false);

    /* Knurled outer edges */
    mCtx.strokeStyle = 'rgba(255,255,255,0.10)';
    mCtx.lineWidth = 1;
    mCtx.beginPath();
    mCtx.moveTo(MCX - 22, gripBotY - 12);
    mCtx.lineTo(MCX - 22, gripTopY);
    mCtx.stroke();
    mCtx.beginPath();
    mCtx.moveTo(MCX + 22, gripBotY - 12);
    mCtx.lineTo(MCX + 22, gripTopY);
    mCtx.stroke();
  }

  /* 9. Lower Platform */
  function drawLowerPlatform() {
    var px = MCOL_X1 + MCOL_W + 3;
    var pw = MCOL_X2 - MCOL_X1 - MCOL_W - 6;
    var py = MPLATFORM_Y;
    var ph = MPLATFORM_H;

    var grad = mCtx.createLinearGradient(px, py, px, py + ph);
    grad.addColorStop(0, '#455a64');
    grad.addColorStop(0.4, '#607d8b');
    grad.addColorStop(1, '#455a64');
    mCtx.fillStyle = grad;
    roundRect(mCtx, px, py, pw, ph, 3);
    mCtx.fill();

    /* Connection to columns */
    mCtx.fillStyle = '#455a64';
    mCtx.fillRect(MCOL_X1 - 2, py - 2, MCOL_W + 4, ph + 4);
    mCtx.fillRect(MCOL_X2 - 2, py - 2, MCOL_W + 4, ph + 4);
    mCtx.fillStyle = grad;
    roundRect(mCtx, px, py, pw, ph, 3);
    mCtx.fill();
  }

  /* 10. Specimen */
  function drawSpecimen(chY) {
    if (!state.mounted && state.animPhase !== 'mounting') return;

    var mat = MATERIALS[state.matIdx];
    /* Specimen sits between grip contact faces. Tensile uses the wedge jaw
       depth (35 px); compression uses the much shallower platen depth (14 px)
       so the specimen ends visibly touch the platen faces. */
    var contactDepth = state.testType === 'compression' ? 14 : 35;
    var upperGripBot = chY + 14 + 20 + contactDepth;
    var lowerGripTop = MPLATFORM_Y - contactDepth;
    var specInfo = getSpecimenProfile();

    if (state.fractured && state.testType === 'tensile') {
      drawFracturedSpecimen(upperGripBot, lowerGripTop, specInfo, mat);
      return;
    }

    var specLen = lowerGripTop - upperGripBot;
    var profile = specInfo.profile;

    /* Build path */
    mCtx.save();

    /* Shadow */
    mCtx.fillStyle = 'rgba(0,0,0,0.2)';
    mCtx.beginPath();
    for (var si3 = 0; si3 <= 40; si3++) {
      var frac3 = si3 / 40;
      var py3 = upperGripBot + frac3 * specLen;
      var hw3 = profile[si3].hw * 2.2 + 3;
      if (si3 === 0) mCtx.moveTo(MCX + hw3, py3 + 2);
      else mCtx.lineTo(MCX + hw3, py3 + 2);
    }
    for (var si4 = 40; si4 >= 0; si4--) {
      var frac4 = si4 / 40;
      var py4 = upperGripBot + frac4 * specLen;
      var hw4 = profile[si4].hw * 2.2 + 3;
      mCtx.lineTo(MCX - hw4, py4 + 2);
    }
    mCtx.closePath();
    mCtx.fill();

    /* Specimen fill — cylindrical metal gradient sized to the bar radius */
    var specSpan = (state.dia / 2) * 2.2 + 2;
    mCtx.fillStyle = specimenGradient(mCtx, MCX, specSpan, mat.color);
    mCtx.beginPath();
    for (var si5 = 0; si5 <= 40; si5++) {
      var frac5 = si5 / 40;
      var py5 = upperGripBot + frac5 * specLen;
      var hw5 = profile[si5].hw * 2.2;
      if (si5 === 0) mCtx.moveTo(MCX + hw5, py5);
      else mCtx.lineTo(MCX + hw5, py5);
    }
    for (var si6 = 40; si6 >= 0; si6--) {
      var frac6 = si6 / 40;
      var py6 = upperGripBot + frac6 * specLen;
      var hw6 = profile[si6].hw * 2.2;
      mCtx.lineTo(MCX - hw6, py6);
    }
    mCtx.closePath();
    mCtx.fill();

    /* Specular streak — follows the profile at the gradient's highlight band */
    mCtx.strokeStyle = 'rgba(255,255,255,0.26)';
    mCtx.lineWidth = 1.4;
    mCtx.lineCap = 'round';
    mCtx.beginPath();
    for (var si7 = 0; si7 <= 40; si7++) {
      var frac7 = si7 / 40;
      var py7 = upperGripBot + frac7 * specLen;
      var hw7 = profile[si7].hw * 2.2 * 0.56;
      if (si7 === 0) mCtx.moveTo(MCX - hw7, py7);
      else mCtx.lineTo(MCX - hw7, py7);
    }
    mCtx.stroke();

    /* Phase-3: yield-event amber overlay — pulses on gauge region for ~800ms */
    var ageY = state.yieldFlashT ? performance.now() - state.yieldFlashT : 9999;
    if (ageY < 800) {
      var aY = (1 - ageY / 800) * 0.55;
      mCtx.fillStyle = 'rgba(255,193,7,' + aY.toFixed(3) + ')';
      mCtx.beginPath();
      for (var yi = 0; yi <= 40; yi++) {
        var fy = yi / 40;
        var pyY = upperGripBot + fy * specLen;
        var hwY = profile[yi].hw * 2.2;
        if (yi === 0) mCtx.moveTo(MCX + hwY, pyY);
        else mCtx.lineTo(MCX + hwY, pyY);
      }
      for (var yi2 = 40; yi2 >= 0; yi2--) {
        var fy2 = yi2 / 40;
        var pyY2 = upperGripBot + fy2 * specLen;
        var hwY2 = profile[yi2].hw * 2.2;
        mCtx.lineTo(MCX - hwY2, pyY2);
      }
      mCtx.closePath();
      mCtx.fill();
    }

    mCtx.restore();
  }

  function drawFracturedSpecimen(upperGripBot, lowerGripTop, specInfo, mat) {
    var specLen = lowerGripTop - upperGripBot;
    var profile = specInfo.profile;
    var fracIdx = 20; /* fracture at midpoint */
    var gapSize = 6 + state.animProgress * 14; /* gap grows */

    /* Upper half — same cylindrical shading as the intact bar */
    mCtx.save();
    var specSpanF = (state.dia / 2) * 2.2 + 2;
    mCtx.fillStyle = specimenGradient(mCtx, MCX, specSpanF, mat.color);

    mCtx.beginPath();
    for (var u = 0; u <= fracIdx; u++) {
      var fy = u / 40;
      var py = upperGripBot + fy * specLen - gapSize / 2;
      var hw = profile[u].hw * 2.2;
      if (u === 0) mCtx.moveTo(MCX + hw, py);
      else mCtx.lineTo(MCX + hw, py);
    }
    /* Jagged fracture edge */
    var fracY = upperGripBot + (fracIdx / 40) * specLen - gapSize / 2;
    var fracHW = profile[fracIdx].hw * 2.2;
    mCtx.lineTo(MCX + fracHW * 0.5, fracY + 2);
    mCtx.lineTo(MCX, fracY - 1);
    mCtx.lineTo(MCX - fracHW * 0.5, fracY + 3);
    mCtx.lineTo(MCX - fracHW, fracY);
    for (var u2 = fracIdx; u2 >= 0; u2--) {
      var fy2 = u2 / 40;
      var py2 = upperGripBot + fy2 * specLen - gapSize / 2;
      var hw2 = profile[u2].hw * 2.2;
      mCtx.lineTo(MCX - hw2, py2);
    }
    mCtx.closePath();
    mCtx.fill();

    /* Upper fracture face — darker torn-metal surface along the jagged edge */
    mCtx.strokeStyle = shadeHex(mat.color, 0.42);
    mCtx.lineWidth = 2.2;
    mCtx.lineJoin = 'round';
    mCtx.beginPath();
    mCtx.moveTo(MCX + fracHW, fracY);
    mCtx.lineTo(MCX + fracHW * 0.5, fracY + 2);
    mCtx.lineTo(MCX, fracY - 1);
    mCtx.lineTo(MCX - fracHW * 0.5, fracY + 3);
    mCtx.lineTo(MCX - fracHW, fracY);
    mCtx.stroke();

    /* Lower half */
    mCtx.beginPath();
    var fracYLow = upperGripBot + (fracIdx / 40) * specLen + gapSize / 2;
    mCtx.moveTo(MCX - profile[fracIdx].hw * 2.2, fracYLow);
    mCtx.lineTo(MCX - profile[fracIdx].hw * 2.2 * 0.5, fracYLow - 2);
    mCtx.lineTo(MCX, fracYLow + 1);
    mCtx.lineTo(MCX + profile[fracIdx].hw * 2.2 * 0.5, fracYLow - 1);
    mCtx.lineTo(MCX + profile[fracIdx].hw * 2.2, fracYLow);
    for (var lo = fracIdx + 1; lo <= 40; lo++) {
      var fy3 = lo / 40;
      var py3 = upperGripBot + fy3 * specLen + gapSize / 2;
      var hw3 = profile[lo].hw * 2.2;
      mCtx.lineTo(MCX + hw3, py3);
    }
    for (var lo2 = 40; lo2 >= fracIdx; lo2--) {
      var fy4 = lo2 / 40;
      var py4 = upperGripBot + fy4 * specLen + gapSize / 2;
      var hw4 = profile[lo2].hw * 2.2;
      mCtx.lineTo(MCX - hw4, py4);
    }
    mCtx.closePath();
    mCtx.fill();

    /* Lower fracture face — matching torn surface on the mating half */
    var fracHWL = profile[fracIdx].hw * 2.2;
    mCtx.strokeStyle = shadeHex(mat.color, 0.42);
    mCtx.lineWidth = 2.2;
    mCtx.lineJoin = 'round';
    mCtx.beginPath();
    mCtx.moveTo(MCX - fracHWL, fracYLow);
    mCtx.lineTo(MCX - fracHWL * 0.5, fracYLow - 2);
    mCtx.lineTo(MCX, fracYLow + 1);
    mCtx.lineTo(MCX + fracHWL * 0.5, fracYLow - 1);
    mCtx.lineTo(MCX + fracHWL, fracYLow);
    mCtx.stroke();

    mCtx.restore();
  }

