  /* ================================================================
     S5 — PROBLEM GENERATORS (12)
     ================================================================ */
  function genProblems() {
    var pool = [];

    /* 1. Engineering stress = F / A0 */
    pool.push(function () {
      var d = [8, 10, 12, 14, 16][randInt(0, 4)];
      var A = roundN(Math.PI / 4 * d * d, 2);
      var F = roundN(randFloat(10, 120), 1);
      var sigma = roundN(F * 1000 / A, 2);
      return {
        prompt: 'A tensile specimen has diameter d\u2080 = ' + d + ' mm (A\u2080 = ' + A + ' mm\u00B2). An applied load of ' + F + ' kN produces what engineering stress?',
        answer: sigma, unit: 'MPa', tol: 2,
        solution: [
          '\u03C3 = F / A\u2080',
          '\u03C3 = ' + (F * 1000) + ' N / ' + A + ' mm\u00B2',
          '<strong>\u03C3 = ' + sigma + ' MPa</strong>'
        ]
      };
    });

    /* 2. Engineering strain = dL / L0 */
    pool.push(function () {
      var L0 = [25, 50, 75, 100][randInt(0, 3)];
      var dL = roundN(randFloat(0.05, 5), 3);
      var eps = roundN(dL / L0, 5);
      return {
        prompt: 'A specimen with gauge length L\u2080 = ' + L0 + ' mm extends by \u0394L = ' + dL + ' mm. Calculate the engineering strain.',
        answer: eps, unit: '', tol: 0.0005,
        solution: [
          '\u03B5 = \u0394L / L\u2080',
          '\u03B5 = ' + dL + ' / ' + L0,
          '<strong>\u03B5 = ' + eps + '</strong>'
        ]
      };
    });

    /* 3. Young's modulus E = sigma / epsilon */
    pool.push(function () {
      var sigma3 = roundN(randFloat(50, 400), 1);
      var E3 = [69, 100, 117, 120, 200, 210][randInt(0, 5)];
      var eps3 = roundN(sigma3 / (E3 * 1000), 6);
      return {
        prompt: 'In the elastic region, a stress of ' + sigma3 + ' MPa corresponds to a strain of ' + eps3 + '. Calculate Young\u2019s modulus E in GPa.',
        answer: roundN(E3, 1), unit: 'GPa', tol: 3,
        solution: [
          'E = \u03C3 / \u03B5',
          'E = ' + sigma3 + ' / ' + eps3,
          'E = ' + roundN(sigma3 / eps3, 0) + ' MPa',
          '<strong>E = ' + roundN(E3, 1) + ' GPa</strong>'
        ]
      };
    });

    /* 4. UTS = Fmax / A0 */
    pool.push(function () {
      var d4 = [8, 10, 12, 14][randInt(0, 3)];
      var A4 = roundN(Math.PI / 4 * d4 * d4, 2);
      var Fmax = roundN(randFloat(15, 80), 1);
      var uts4 = roundN(Fmax * 1000 / A4, 1);
      return {
        prompt: 'A specimen (d\u2080 = ' + d4 + ' mm, A\u2080 = ' + A4 + ' mm\u00B2) fractures with maximum load F_max = ' + Fmax + ' kN. Calculate UTS.',
        answer: uts4, unit: 'MPa', tol: 3,
        solution: [
          'UTS = F_max / A\u2080',
          'UTS = ' + roundN(Fmax * 1000, 0) + ' / ' + A4,
          '<strong>UTS = ' + uts4 + ' MPa</strong>'
        ]
      };
    });

    /* 5. % Elongation */
    pool.push(function () {
      var L05 = 50;
      var Lf = roundN(randFloat(50.5, 65), 1);
      var el = roundN((Lf - L05) / L05 * 100, 1);
      return {
        prompt: 'After fracture, the gauge length increased from L\u2080 = ' + L05 + ' mm to L_f = ' + Lf + ' mm. Calculate % elongation.',
        answer: el, unit: '%', tol: 0.5,
        solution: [
          '%EL = (L_f \u2212 L\u2080) / L\u2080 \u00D7 100',
          '%EL = (' + Lf + ' \u2212 ' + L05 + ') / ' + L05 + ' \u00D7 100',
          '%EL = ' + roundN(Lf - L05, 1) + ' / ' + L05 + ' \u00D7 100',
          '<strong>%EL = ' + el + '%</strong>'
        ]
      };
    });

    /* 6. % Reduction of area */
    pool.push(function () {
      var d0 = [10, 12, 14][randInt(0, 2)];
      var A06 = roundN(Math.PI / 4 * d0 * d0, 2);
      var df = roundN(randFloat(d0 * 0.5, d0 * 0.85), 1);
      var Af = roundN(Math.PI / 4 * df * df, 2);
      var ra = roundN((A06 - Af) / A06 * 100, 1);
      return {
        prompt: 'A specimen (d\u2080 = ' + d0 + ' mm) has a fractured neck diameter of d_f = ' + df + ' mm. Calculate % reduction of area.',
        answer: ra, unit: '%', tol: 1,
        solution: [
          'A\u2080 = \u03C0/4 \u00D7 ' + d0 + '\u00B2 = ' + A06 + ' mm\u00B2',
          'A_f = \u03C0/4 \u00D7 ' + df + '\u00B2 = ' + Af + ' mm\u00B2',
          '%RA = (A\u2080 \u2212 A_f) / A\u2080 \u00D7 100',
          '<strong>%RA = ' + ra + '%</strong>'
        ]
      };
    });

    /* 7. Toughness approximation */
    pool.push(function () {
      var sY = [200, 250, 300, 350][randInt(0, 3)];
      var sU = roundN(sY * randFloat(1.3, 1.8), 0);
      var epsF7 = roundN(randFloat(0.10, 0.30), 2);
      var tough = roundN(0.5 * (sY + sU) * epsF7, 1);
      return {
        prompt: 'A material has \u03C3y = ' + sY + ' MPa, UTS = ' + sU + ' MPa, and fracture strain \u03B5_f = ' + epsF7 + '. Estimate toughness using the trapezoidal approximation.',
        answer: tough, unit: 'MJ/m\u00B3', tol: 3,
        solution: [
          'Toughness \u2248 \u00BD(\u03C3y + \u03C3u) \u00D7 \u03B5_f',
          'Toughness \u2248 \u00BD(' + sY + ' + ' + sU + ') \u00D7 ' + epsF7,
          'Toughness \u2248 ' + roundN(0.5 * (sY + sU), 1) + ' \u00D7 ' + epsF7,
          '<strong>Toughness \u2248 ' + tough + ' MJ/m\u00B3</strong>'
        ]
      };
    });

    /* 8. Resilience = sigmaY^2 / (2E) */
    pool.push(function () {
      var sY8 = [200, 250, 276, 350, 500][randInt(0, 4)];
      var E8 = [69, 100, 200, 210][randInt(0, 3)] * 1000;
      var resil = roundN(sY8 * sY8 / (2 * E8), 4);
      return {
        prompt: 'Calculate the modulus of resilience for a material with \u03C3y = ' + sY8 + ' MPa and E = ' + (E8 / 1000) + ' GPa.',
        answer: resil, unit: 'MJ/m\u00B3', tol: 0.01,
        solution: [
          'U_r = \u03C3y\u00B2 / (2E)',
          'U_r = ' + sY8 + '\u00B2 / (2 \u00D7 ' + E8 + ')',
          'U_r = ' + (sY8 * sY8) + ' / ' + (2 * E8),
          '<strong>U_r = ' + resil + ' MJ/m\u00B3</strong>'
        ]
      };
    });

    /* 9. True stress from engineering values */
    pool.push(function () {
      var sigE = roundN(randFloat(200, 500), 1);
      var epsE = roundN(randFloat(0.02, 0.15), 3);
      var sigT = roundN(sigE * (1 + epsE), 1);
      return {
        prompt: 'At a point on the curve, engineering stress = ' + sigE + ' MPa and engineering strain = ' + epsE + '. Calculate the true stress.',
        answer: sigT, unit: 'MPa', tol: 2,
        solution: [
          '\u03C3_true = \u03C3_eng \u00D7 (1 + \u03B5_eng)',
          '\u03C3_true = ' + sigE + ' \u00D7 (1 + ' + epsE + ')',
          '\u03C3_true = ' + sigE + ' \u00D7 ' + roundN(1 + epsE, 3),
          '<strong>\u03C3_true = ' + sigT + ' MPa</strong>'
        ]
      };
    });

    /* 10. True strain from engineering strain */
    pool.push(function () {
      var epsE10 = roundN(randFloat(0.01, 0.20), 3);
      var epsT = roundN(Math.log(1 + epsE10), 4);
      return {
        prompt: 'Calculate the true strain corresponding to an engineering strain of ' + epsE10 + '.',
        answer: epsT, unit: '', tol: 0.005,
        solution: [
          '\u03B5_true = ln(1 + \u03B5_eng)',
          '\u03B5_true = ln(1 + ' + epsE10 + ')',
          '\u03B5_true = ln(' + roundN(1 + epsE10, 3) + ')',
          '<strong>\u03B5_true = ' + epsT + '</strong>'
        ]
      };
    });

    /* 11. Load from stress: F = sigma * A */
    pool.push(function () {
      var d11 = [8, 10, 12, 14][randInt(0, 3)];
      var A11 = roundN(Math.PI / 4 * d11 * d11, 2);
      var sig11 = [200, 250, 300, 400, 500][randInt(0, 4)];
      var F11 = roundN(sig11 * A11 / 1000, 2);
      return {
        prompt: 'A specimen (d\u2080 = ' + d11 + ' mm, A\u2080 = ' + A11 + ' mm\u00B2) is loaded to \u03C3 = ' + sig11 + ' MPa. What is the applied load in kN?',
        answer: F11, unit: 'kN', tol: 0.5,
        solution: [
          'F = \u03C3 \u00D7 A\u2080',
          'F = ' + sig11 + ' \u00D7 ' + A11 + ' = ' + roundN(sig11 * A11, 0) + ' N',
          '<strong>F = ' + F11 + ' kN</strong>'
        ]
      };
    });

    /* 12. Poisson's ratio: lateral strain change */
    pool.push(function () {
      var nu = [0.29, 0.30, 0.33, 0.34][randInt(0, 3)];
      var d12 = [10, 12, 14][randInt(0, 2)];
      var epsAx = roundN(randFloat(0.001, 0.005), 4);
      var dD = roundN(-nu * epsAx * d12, 4);
      return {
        prompt: 'A specimen (d\u2080 = ' + d12 + ' mm, \u03BD = ' + nu + ') is strained axially by \u03B5 = ' + epsAx + '. Calculate the diameter change \u0394d.',
        answer: dD, unit: 'mm', tol: 0.001,
        solution: [
          '\u03B5_lateral = \u2212\u03BD \u00D7 \u03B5_axial = \u2212' + nu + ' \u00D7 ' + epsAx + ' = ' + roundN(-nu * epsAx, 6),
          '\u0394d = \u03B5_lateral \u00D7 d\u2080 = ' + roundN(-nu * epsAx, 6) + ' \u00D7 ' + d12,
          '<strong>\u0394d = ' + dD + ' mm</strong> (negative = shrinkage)'
        ]
      };
    });

    return pool;
  }

