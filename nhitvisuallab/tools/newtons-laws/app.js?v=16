        html += '<div class="eq-line">\\(a = \\dfrac{('+law2_mA.toFixed(1)+' - '+law2_mB.toFixed(1)+') \\cdot 9.81}{'+law2_mA.toFixed(1)+' + '+law2_mB.toFixed(1)+'} = \\mathbf{'+pa.accel.toFixed(2)+'\\;\\mathrm{m/s^2}}\\)</div>';
        html += '<div class="eq-line">\\[ T = \\dfrac{2\\,m_a\\,m_b\\,g}{m_a + m_b} \\]</div>';
        html += '<div class="eq-line">\\(T = \\dfrac{2 \\cdot '+law2_mA.toFixed(1)+' \\cdot '+law2_mB.toFixed(1)+' \\cdot 9.81}{'+(law2_mA+law2_mB).toFixed(1)+'} = \\mathbf{'+pa.tension.toFixed(1)+'\\;\\mathrm{N}}\\)</div>';
