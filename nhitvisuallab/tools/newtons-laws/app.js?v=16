    try {
      var o = ac.createOscillator(); var g = ac.createGain();
      o.type = type || 'sine'; o.frequency.value = freq;
      g.gain.value = 0; g.gain.linearRampToValueAtTime(gain || 0.15, ac.currentTime + 0.01);
      g.gain.exponentialRampToValueAtTime(0.001, ac.currentTime + dur);
      o.connect(g); g.connect(ac.destination);
      o.start(); o.stop(ac.currentTime + dur);
    } catch(e){}
  }
  function playCannonBoom(){
    var ac = getAC(); if (!ac) return;
    try {
      var buf = ac.createBuffer(1, ac.sampleRate*0.4, ac.sampleRate);
      var d = buf.getChannelData(0);
      for (var i=0;i<d.length;i++) d[i] = (Math.random()*2-1) * Math.exp(-i/(ac.sampleRate*0.08));
      var src = ac.createBufferSource(); src.buffer = buf;
      var g = ac.createGain(); g.gain.value = 0.35;
      var lp = ac.createBiquadFilter(); lp.type='lowpass'; lp.frequency.value = 500;
      src.connect(lp); lp.connect(g); g.connect(ac.destination); src.start();
    } catch(e){}
  }
  function playPush(){ playSound(180, 0.18, 'square', 0.08); }
  function playStop(){ playSound(120, 0.12, 'sine', 0.06); }

  /* ================================================================
     UNDO / REDO
     ================================================================ */
  var undoStack = [], redoStack = [], MAX_UNDO = 60;
  function snapState() {
    return {
      law: selectedLaw, sc2: law2_scenario, sc3: law3_scenario,
      l1v: law1_initV, l1m: law1_mass, l1mu: law1_mu,
      l2f: law2_force, l2m: law2_mass, l2mu: law2_mu, l2a: law2_angle,
      l2mA: law2_mA, l2mB: law2_mB,
      l3f: law3_force, l3ma: law3_massA, l3mb: law3_massB,
      sFBD: showFBD, sVec: showVectors, sEq: showEquation,
      sTr: showTrail, sMk: showMarkers, sGr: showGrid,
      imp: useImperial, sp: animSpeed
    };
  }
  function loadState(s) {
    if (!s) return;
    selectedLaw = s.law; law2_scenario = s.sc2; law3_scenario = s.sc3;
    law1_initV = s.l1v; law1_mass = s.l1m; law1_mu = s.l1mu;
    law2_force = s.l2f; law2_mass = s.l2m; law2_mu = s.l2mu; law2_angle = s.l2a;
    law2_mA = s.l2mA != null ? s.l2mA : law2_mA;
    law2_mB = s.l2mB != null ? s.l2mB : law2_mB;
    law3_force = s.l3f; law3_massA = s.l3ma; law3_massB = s.l3mb;
    showFBD = s.sFBD !== undefined ? !!s.sFBD : true;
    showVectors = s.sVec !== undefined ? !!s.sVec : true;
    showEquation = s.sEq !== undefined ? !!s.sEq : true;
    showTrail = s.sTr !== undefined ? !!s.sTr : true;
    showMarkers = s.sMk !== undefined ? !!s.sMk : true;
    showGrid = s.sGr !== undefined ? !!s.sGr : false;
    useImperial = !!s.imp;
    animSpeed = s.sp || 0.5;
    syncAllInputs();
    setLaw(selectedLaw, true);
    setScenario(law2_scenario, true);
    setScenario3(law3_scenario, true);
    invalidateOutput();
    updateReadouts();
    updateLearnPanels();
    render();
  }
  function saveUndo() {
    undoStack.push(JSON.stringify(snapState()));
    if (undoStack.length > MAX_UNDO) undoStack.shift();
    redoStack = [];
    updateUndoBtns();
  }
  function doUndo() {
    if (undoStack.length === 0) return;
    redoStack.push(JSON.stringify(snapState()));
    var s = JSON.parse(undoStack.pop());
    loadState(s); updateUndoBtns();
  }
  function doRedo() {
    if (redoStack.length === 0) return;
    undoStack.push(JSON.stringify(snapState()));
    var s = JSON.parse(redoStack.pop());
    loadState(s); updateUndoBtns();
  }
  function updateUndoBtns() {
    var u = $('btn-undo'), r = $('btn-redo');
    if (u) u.disabled = undoStack.length === 0;
    if (r) r.disabled = redoStack.length === 0;
  }

  /* ================================================================
     PHYSICS HELPERS
     ================================================================ */
  function law2_physics_flat() {
    var wt = law2_mass * G, N = wt;
    var maxF = law2_mu * N;
    var fActual, fnet, accel;
    if (law2_force <= maxF) { fActual = law2_force; fnet = 0; accel = 0; }
    else { fActual = maxF; fnet = law2_force - fActual; accel = fnet / law2_mass; }
    return { weight:wt, normal:N, maxFriction:maxF, friction:fActual, fnet:fnet, accel:accel, isMoving:Math.abs(fnet) > 0.001 };
  }
  function law2_physics_incline() {
    var rad = law2_angle * Math.PI / 180;
    var wt = law2_mass * G, N = wt * Math.cos(rad);
    var Wpar = wt * Math.sin(rad);
    var maxF = law2_mu * N;
    var netDriving = law2_force - Wpar;
    var fActual, fnet, accel;
    if (Math.abs(netDriving) <= maxF) { fActual = Math.abs(netDriving); fnet = 0; accel = 0; }
    else {
      fActual = maxF;
      if (netDriving > 0) fnet = netDriving - fActual;
      else fnet = netDriving + fActual;
      accel = fnet / law2_mass;
    }
    return { weight:wt, normal:N, Wpar:Wpar, maxFriction:maxF, friction:fActual, fnet:fnet, accel:accel, isMoving:Math.abs(fnet) > 0.001 };
  }
  /* Slope length for the incline scenario. Shared by the renderer and the tick's
     stop condition so the two can never disagree about where the ramp ends. */
  function inclineSlopeLen() {
    var rad = law2_angle * Math.PI / 180;
    var incW = Math.min(640, W * 0.7), incH = incW * Math.tan(rad);
    if (incH > 280) { incH = 280; incW = incH / Math.tan(rad); }
    return Math.sqrt(incW * incW + incH * incH);
  }

  function law2_physics_atwood() {
    var a = (law2_mA - law2_mB) * G / (law2_mA + law2_mB);
    var T = 2 * law2_mA * law2_mB * G / (law2_mA + law2_mB);
    return { accel:Math.abs(a), accelSigned:a, tension:T, weight:(law2_mA+law2_mB)*G, isMoving:Math.abs(a) > 0.001 };
  }
  function law2_physics_connected() {
    /* Two blocks A (front), B (back), pulled forward by F, friction on both */
    var totalM = law2_mA + law2_mB;
    var Wtot = totalM * G;
    var fric = law2_mu * Wtot;
    var fnet = Math.max(0, law2_force - fric);
    var a = fnet / totalM;
    /* Tension in rope = F_back = m_B * a + friction on B */
    var fB = law2_mu * law2_mB * G;
    var T = law2_mB * a + fB;
    return { accel:a, tension:T, friction:fric, fnet:fnet, weight:Wtot, normal:Wtot, isMoving:a > 0.001 };
  }
  function law2_physics() {
    if (law2_scenario === 'incline') return law2_physics_incline();
    if (law2_scenario === 'atwood') return law2_physics_atwood();
    if (law2_scenario === 'connected') return law2_physics_connected();
    return law2_physics_flat();
  }
  function law3_accelA(){ return law3_force / law3_massA; }
  function law3_accelB(){ return law3_force / law3_massB; }

  function invalidateOutput() {
    if (law1_running || law2_running || law3_running) return;
    rollFactor = 0;
    trail = [];
  }

  /* ================================================================
     DRAWING HELPERS
     ================================================================ */
  var ARROW_SCALE = 1.2, MAX_ARROW_LEN = 140;
  function forceToLen(fN){ return Math.min(MAX_ARROW_LEN, Math.max(12, Math.abs(fN)*ARROW_SCALE)); }

  function drawArrow(x1,y1,x2,y2,color,head) {
    head = head || 8;
    var dx=x2-x1, dy=y2-y1, len=Math.sqrt(dx*dx+dy*dy);
    if (len < 2) return;
    var ux=dx/len, uy=dy/len;
    ctx.strokeStyle = color; ctx.lineWidth = 3;
    ctx.beginPath(); ctx.moveTo(x1,y1);
    ctx.lineTo(x2-ux*head*0.5, y2-uy*head*0.5); ctx.stroke();
    ctx.fillStyle = color;
    ctx.beginPath();
    ctx.moveTo(x2,y2);
    ctx.lineTo(x2-ux*head - uy*head*0.5, y2-uy*head + ux*head*0.5);
    ctx.lineTo(x2-ux*head + uy*head*0.5, y2-uy*head - ux*head*0.5);
    ctx.closePath(); ctx.fill();
  }

  function drawSurface(y, label, textured) {
    /* grounded band receding below the surface */
    var g = ctx.createLinearGradient(0,y,0,y+64);
    g.addColorStop(0,'rgba(42,50,78,0.5)'); g.addColorStop(1,'rgba(16,20,33,0)');
    ctx.fillStyle = g; ctx.fillRect(0, y, W, 64);
    /* bright front edge */
    ctx.strokeStyle = 'rgba(150,168,208,0.7)'; ctx.lineWidth = 2.5;
    ctx.beginPath(); ctx.moveTo(30,y); ctx.lineTo(W-30,y); ctx.stroke();
    if (textured) {
      ctx.strokeStyle = 'rgba(141,110,99,0.85)'; ctx.lineWidth = 1.2;
      for (var x=40;x<W-30;x+=20){ ctx.beginPath(); ctx.moveTo(x,y); ctx.lineTo(x-6, y+10); ctx.stroke(); }
    }
    if (label) {
      ctx.font='600 10px "Segoe UI", sans-serif'; ctx.fillStyle='#6b7a99';
      ctx.textAlign='left'; ctx.textBaseline='top'; ctx.fillText(label, 35, y+14);
    }
  }
  function drawBlock(x,y,w,h, label, color, strokeColor) {
    var stroke = strokeColor || '#f9a825';
    ctx.save();
    /* drop shadow under the body */
    ctx.shadowColor = 'rgba(0,0,0,0.4)'; ctx.shadowBlur = 8; ctx.shadowOffsetY = 3;
    /* vertical material gradient derived from the theme colour */
    var g = ctx.createLinearGradient(x, y, x, y+h);
    g.addColorStop(0, hexA(stroke, 0.5));
    g.addColorStop(0.5, hexA(stroke, 0.28));
    g.addColorStop(1, hexA(stroke, 0.42));
    ctx.fillStyle = g;
    ctx.beginPath(); ctx.roundRect(x,y,w,h,5); ctx.fill();
    ctx.shadowColor = 'transparent';
    ctx.strokeStyle = stroke; ctx.lineWidth = 2.5; ctx.stroke();
    /* top specular highlight */
    ctx.strokeStyle = 'rgba(255,255,255,0.3)'; ctx.lineWidth = 1.4;
    ctx.beginPath(); ctx.moveTo(x+6, y+2.4); ctx.lineTo(x+w-6, y+2.4); ctx.stroke();
    ctx.restore();
    ctx.font='700 14px "Segoe UI",sans-serif';
    ctx.fillStyle = stroke;
    ctx.textAlign='center'; ctx.textBaseline='middle';
    ctx.fillText(label, x+w/2, y+h/2);
  }
  function drawForceLabel(x,y,label,color,align) {
    ctx.font='700 11px "Segoe UI",sans-serif'; ctx.fillStyle=color;
    ctx.textAlign=align||'center'; ctx.textBaseline='middle'; ctx.fillText(label,x,y);
  }
  function drawBadge(x,y,w,h, title, val, color) {
    ctx.fillStyle='rgba(249,168,37,0.12)'; ctx.strokeStyle='rgba(249,168,37,0.35)'; ctx.lineWidth=1.5;
    ctx.beginPath(); ctx.roundRect(x,y,w,h,8); ctx.fill(); ctx.stroke();
    ctx.font='600 9px "Segoe UI",sans-serif'; ctx.fillStyle='#6b7a99';
    ctx.textAlign='center'; ctx.textBaseline='top'; ctx.fillText(title, x+w/2, y+5);
    ctx.font='700 14px "Courier New",monospace'; ctx.fillStyle=color||'#f9a825';
    ctx.fillText(val, x+w/2, y+22);
  }

  /* ── Scene grounding / material kit (graphics upgrade) ───────────── */
  function hexA(hex, a){
    hex = hex.replace('#','');
    if (hex.length === 3) hex = hex[0]+hex[0]+hex[1]+hex[1]+hex[2]+hex[2];
    var n = parseInt(hex, 16);
    return 'rgba('+((n>>16)&255)+','+((n>>8)&255)+','+(n&255)+','+a+')';
  }
  /* Vertical studio gradient + accent radial spotlight over the working area. */
  function drawSceneBackground(glowX, glowY) {
    var g = ctx.createLinearGradient(0,0,0,H);
    g.addColorStop(0,'#121829'); g.addColorStop(0.55,'#0d1220'); g.addColorStop(1,'#090c15');
    ctx.fillStyle = g; ctx.fillRect(0,0,W,H);
    var r = ctx.createRadialGradient(glowX, glowY, 20, glowX, glowY, Math.max(W,H)*0.72);
    r.addColorStop(0,'rgba(249,168,37,0.11)');
    r.addColorStop(0.5,'rgba(249,168,37,0.035)');
    r.addColorStop(1,'rgba(249,168,37,0)');
    ctx.fillStyle = r; ctx.fillRect(0,0,W,H);
  }
  /* Soft elliptical contact shadow grounding an object on a surface at y. */
  function contactShadow(cx, y, rx) {
    ctx.save();
    var g = ctx.createRadialGradient(cx, y, 0, cx, y, rx);
    g.addColorStop(0,'rgba(0,0,0,0.42)'); g.addColorStop(1,'rgba(0,0,0,0)');
    ctx.fillStyle = g;
    ctx.beginPath(); ctx.ellipse(cx, y, rx, Math.max(4, rx*0.22), 0, 0, Math.PI*2); ctx.fill();
    ctx.restore();
  }

  function drawBgGrid() {
    if (!showGrid) return;
    ctx.strokeStyle = 'rgba(74,85,120,0.18)'; ctx.lineWidth = 0.7;
    var step = PPM;  /* 1 m per cell */
    for (var x=0; x<W; x+=step) { ctx.beginPath(); ctx.moveTo(x,0); ctx.lineTo(x,H); ctx.stroke(); }
    for (var y=0; y<H; y+=step) { ctx.beginPath(); ctx.moveTo(0,y); ctx.lineTo(W,y); ctx.stroke(); }
    /* Label every 5th line */
    ctx.fillStyle = 'rgba(107,122,153,0.5)'; ctx.font = '600 8px "Courier New",monospace';
    ctx.textAlign='left'; ctx.textBaseline='top';
    for (var gx=0,c=0; gx<W; gx+=step, c++) if (c%5===0) ctx.fillText(UNIT.dist(c) + UNIT.distU(), gx+2, 2);
  }

  /* ── Classical color-coded equation overlay (Pattern 3) ────────── */
  function drawEquationOverlay(law) {
    if (!showEquation) return;
    var roll = clamp(rollFactor, 0, 1);
    var stale = roll < 0.001 && !(law1_running||law2_running||law3_running);

    var x0 = W/2;
    var y0 = 50;  /* near top */
    var C_F = '#ff8a65', C_m = '#42a5f5', C_a = '#3ddc84', C_EQ = '#ffd54f';
    var serif = '"Cambria Math","Times New Roman",serif';

    var sVal = 14, sVar = 18, sEq = 22;

    if (law === '1st') {
      var v = law1_running ? Math.abs(law1_blockV) : law1_initV;
      var displayedV = stale ? '—' : v.toFixed(1);
      drawCenteredEq(x0, y0, [
        {t:'ΣF', f:'italic 700 '+sVar+'px '+serif, c:C_F},
        {t:' = ', f:'700 '+sEq+'px '+serif, c:C_EQ},
        {t:'0', f:'700 '+sVal+'px "JetBrains Mono","Courier New",monospace', c:'#e6edf6'},
        {t:'  →  ', f:'700 '+sEq+'px '+serif, c:C_EQ},
        {t:'v', f:'italic 700 '+sVar+'px '+serif, c:C_a},
        {t:' = '+displayedV+' m/s', f:'700 '+sVal+'px "JetBrains Mono",monospace', c:'#e6edf6'}
      ]);
      return;
    }
    if (law === '2nd' && law2_scenario !== 'atwood') {
      var p = law2_physics();
      var aRoll = stale ? '—' : (p.accel*roll).toFixed(2)+' m/s²';
      var fnetRoll = stale ? '—' : (p.fnet*roll).toFixed(1)+' N';
      drawCenteredEq(x0, y0, [
        {t:'F', f:'italic 700 '+sVar+'px '+serif, c:C_F},
        {t:'ₙₑₜ', f:'700 '+(sVar*0.65)+'px '+serif, c:C_F, sub:true},
        {t:' = ', f:'700 '+sEq+'px '+serif, c:C_EQ},
        {t:'m', f:'italic 700 '+sVar+'px '+serif, c:C_m},
        {t:' · ', f:'700 '+sEq+'px '+serif, c:C_EQ},
        {t:'a', f:'italic 700 '+sVar+'px '+serif, c:C_a},
        {t:'   →   ', f:'700 '+sEq+'px '+serif, c:C_EQ},
        {t:fnetRoll, f:'700 '+sVal+'px "JetBrains Mono",monospace', c:'#ff8a65'},
        {t:' = ', f:'700 '+sEq+'px '+serif, c:C_EQ},
        {t:law2_mass.toFixed(1)+' kg', f:'700 '+sVal+'px "JetBrains Mono",monospace', c:'#42a5f5'},
        {t:' · ', f:'700 '+sEq+'px '+serif, c:C_EQ},
        {t:aRoll, f:'700 '+sVal+'px "JetBrains Mono",monospace', c:'#3ddc84'}
      ]);
      return;
    }
    if (law === '2nd' && law2_scenario === 'atwood') {
      var pa = law2_physics_atwood();
      var aRoll = stale ? '—' : (pa.accel*roll).toFixed(2)+' m/s²';
      drawCenteredEq(x0, y0, [
        {t:'a', f:'italic 700 '+sVar+'px '+serif, c:C_a},
        {t:' = ', f:'700 '+sEq+'px '+serif, c:C_EQ},
        {t:'(mₐ−mₘ)g / (mₐ+mₘ)', f:'italic 700 '+(sVar-2)+'px '+serif, c:C_m},
        {t:'  →  ', f:'700 '+sEq+'px '+serif, c:C_EQ},
        {t:aRoll, f:'700 '+sVal+'px "JetBrains Mono",monospace', c:'#3ddc84'}
      ]);
      return;
    }
    if (law === '3rd') {
      var fA = (law3_force*roll).toFixed(1), fB = (law3_force*roll).toFixed(1);
      var aA = (law3_accelA()*roll).toFixed(2), aB = (law3_accelB()*roll).toFixed(2);
      if (stale) { fA = fB = '—'; aA = aB = '—'; }
      drawCenteredEq(x0, y0, [
        {t:'F₁₂', f:'italic 700 '+sVar+'px '+serif, c:C_F},
        {t:' = −', f:'700 '+sEq+'px '+serif, c:C_EQ},
        {t:'F₂₁', f:'italic 700 '+sVar+'px '+serif, c:C_F},
        {t:'   →   ', f:'700 '+sEq+'px '+serif, c:C_EQ},
        {t:'aₘ/aₙ = mₙ/mₘ = ', f:'italic 700 '+(sVar-2)+'px '+serif, c:C_a},
        {t:(law3_massA/law3_massB).toFixed(1)+'×', f:'700 '+sVal+'px "JetBrains Mono",monospace', c:'#ffd54f'}
      ]);
      return;
    }
  }
  function drawCenteredEq(cx, cy, parts) {
    ctx.textAlign='left'; ctx.textBaseline='middle';
    var total = 0;
    for (var i=0;i<parts.length;i++){ ctx.font=parts[i].f; total += ctx.measureText(parts[i].t).width; }
    var x = Math.round(cx - total/2);
    /* Background pill */
    ctx.fillStyle = 'rgba(13,17,23,0.78)';
    ctx.strokeStyle = 'rgba(245,200,66,0.35)';
    ctx.lineWidth = 1.2;
    ctx.beginPath(); ctx.roundRect(x-12, cy-16, total+24, 30, 8); ctx.fill(); ctx.stroke();
    for (var j=0;j<parts.length;j++){
      ctx.font = parts[j].f; ctx.fillStyle = parts[j].c;
      var dy = parts[j].sub ? 6 : 0;
      ctx.fillText(parts[j].t, x, cy+dy);
      x += ctx.measureText(parts[j].t).width;
    }
  }

  /* ================================================================
     1st LAW
     ================================================================ */
  function draw1stLaw() {
    var SY = 320;
    var BW = 80, BH = 55;
    var bx = law1_blockX, by = SY - BH;

    /* Title */
    ctx.font='700 14px "Segoe UI",sans-serif'; ctx.fillStyle='#dde3f0';
    ctx.textAlign='center'; ctx.textBaseline='top';
    ctx.fillText("Newton’s First Law — Law of Inertia", W/2, 12);

    var surfLabel = law1_mu === 0 ? 'Frictionless (Ice)' : 'Surface (μ = '+law1_mu.toFixed(2)+')';
    drawSurface(SY, surfLabel, law1_mu > 0);

    /* Trail */
    if (showTrail && trail.length > 1) {
      ctx.strokeStyle='rgba(245,200,66,0.55)'; ctx.lineWidth=2;
      ctx.beginPath();
      for (var ti=0; ti<trail.length; ti++) {
        if (ti===0) ctx.moveTo(trail[ti].x, trail[ti].y);
        else ctx.lineTo(trail[ti].x, trail[ti].y);
      }
      ctx.stroke();
    }

    contactShadow(bx + BW/2, SY, BW*0.62);
    drawBlock(bx, by, BW, BH, law1_mass.toFixed(1)+' kg');
    var cx = bx + BW/2;

    /* FBD */
    if (showFBD) {
      var wt = law1_mass * G, wLen = forceToLen(wt);
      drawArrow(cx-15, SY, cx-15, SY+wLen, '#ff5555', 6);
      drawForceLabel(cx-15, SY+wLen+10, 'W = '+wt.toFixed(1)+' N', '#ff5555');
      drawArrow(cx+15, SY, cx+15, SY-wLen, '#3ddc84', 6);
      drawForceLabel(cx+15, SY-wLen-10, 'N = '+wt.toFixed(1)+' N', '#3ddc84');
      if (law1_mu > 0 && Math.abs(law1_blockV) > 0.1) {
        var fForce = law1_mu * law1_mass * G, fLen = forceToLen(fForce);
        var fDir = law1_blockV > 0 ? -1 : 1, cy = by + BH/2;
        drawArrow(cx, cy, cx + fLen*fDir, cy, '#ff5555', 6);
        drawForceLabel(cx + fLen*fDir*0.7, cy-14, 'f = '+fForce.toFixed(1)+' N', '#ff5555');
      }
    }
    /* Velocity vector */
    if (showVectors && Math.abs(law1_blockV) > 0.1) {
      var vLen = Math.min(120, Math.abs(law1_blockV)*8);
      var vDir = law1_blockV > 0 ? 1 : -1;
      drawArrow(cx, by-20, cx + vLen*vDir, by-20, '#f5c842', 7);
      drawForceLabel(cx + vLen*vDir*0.5, by-35, 'v = '+Math.abs(law1_blockV).toFixed(1)+' m/s', '#f5c842');
    }

    /* State label */
    var stateLabel = '', stateColor = '#f9a825';
    if (!law1_running && Math.abs(law1_blockV) < 0.1) { stateLabel='AT REST — No net force needed'; stateColor='#6b7a99'; }
    else if (law1_running && law1_mu === 0 && Math.abs(law1_blockV) > 0.1) { stateLabel='CONSTANT VELOCITY — No friction'; stateColor='#3ddc84'; }
    else if (law1_running && law1_mu > 0 && Math.abs(law1_blockV) > 0.1) { stateLabel='DECELERATING — Friction acts'; stateColor='#ff5555'; }
    else if (law1_running && Math.abs(law1_blockV) < 0.1) { stateLabel='STOPPED'; stateColor='#6b7a99'; }
    if (stateLabel) {
      ctx.font='700 12px "Segoe UI",sans-serif'; ctx.fillStyle=stateColor;
      ctx.textAlign='center'; ctx.textBaseline='top';
      ctx.fillText(stateLabel, W/2, SY + 60);
    }

    var netF = (law1_mu > 0 && Math.abs(law1_blockV) > 0.1) ? -(law1_mu*law1_mass*G) : 0;
    var decel = (law1_mu > 0 && Math.abs(law1_blockV) > 0.1) ? law1_mu*G : 0;
    drawBadge(30, SY+80, 160, 42, 'NET FORCE', netF.toFixed(1)+' N', netF===0?'#3ddc84':'#ff5555');
    drawBadge(210, SY+80, 130, 42, 'VELOCITY', Math.abs(law1_blockV).toFixed(1)+' m/s', '#f5c842');
    drawBadge(360, SY+80, 130, 42, 'TIME', law1_time.toFixed(1)+' s', '#f9a825');
    drawBadge(510, SY+80, 170, 42, 'DECEL. (μg)', decel.toFixed(2)+' m/s²', law1_mu===0?'#3ddc84':'#42a5f5');
  }

  /* ================================================================
     2nd LAW — FLAT
     ================================================================ */
  function draw2ndLawFlat() {
    var p = law2_physics_flat();
    var SY = 230, BW = 60, BH = 42;

    drawSurface(SY, 'μ = '+law2_mu.toFixed(2), law2_mu > 0);

    /* Markers */
    if (showMarkers) {
      for (var mi=0; mi<law2_markers.length; mi++) {
        var mx = law2_markers[mi].x + BW/2;
        if (mx > 40 && mx < W-40) {
          ctx.fillStyle='rgba(66,165,245,0.6)';
          ctx.beginPath(); ctx.arc(mx, SY+2, 3, 0, Math.PI*2); ctx.fill();
          if (mi%3===0 && mi>0) {
            ctx.font='600 8px "Courier New",monospace'; ctx.fillStyle='rgba(66,165,245,0.6)';
            ctx.textAlign='center'; ctx.textBaseline='top';
            ctx.fillText(law2_markers[mi].t.toFixed(1)+'s', mx, SY+7);
          }
        }
      }
    }

    /* Trail */
    if (showTrail && trail.length > 1) {
      ctx.strokeStyle='rgba(66,165,245,0.45)'; ctx.lineWidth=2;
      ctx.beginPath();
      for (var ti=0; ti<trail.length; ti++) {
        if (ti===0) ctx.moveTo(trail[ti].x, trail[ti].y); else ctx.lineTo(trail[ti].x, trail[ti].y);
      }
      ctx.stroke();
    }

    var bx = law2_running ? law2_blockX : 70, by = SY - BH;
    var cx = bx + BW/2, cy = by + BH/2;
    contactShadow(cx, SY, BW*0.72);
    drawBlock(bx, by, BW, BH, law2_mass.toFixed(1)+' kg');

    if (showFBD) {
      if (law2_force > 0) {
        var fAppLen = forceToLen(law2_force);
        drawArrow(bx+BW, cy, bx+BW+fAppLen, cy, '#3ddc84', 7);
        drawForceLabel(bx+BW+fAppLen+5, cy, 'F='+law2_force+'N', '#3ddc84','left');
      }
      if (p.friction > 0.1) {
        var fFricLen = forceToLen(p.friction);
        drawArrow(bx, cy, bx-fFricLen, cy, '#ff5555', 6);
        drawForceLabel(bx-fFricLen-5, cy, 'f='+p.friction.toFixed(1)+'N', '#ff5555','right');
      }
      if (Math.abs(p.fnet) > 0.1) {
        var fnLen = forceToLen(p.fnet);
        drawArrow(cx, by-10, cx+fnLen, by-10, '#f9a825', 7);
        drawForceLabel(cx+fnLen+5, by-10, 'Fₙₑₜ='+p.fnet.toFixed(1)+'N', '#f9a825','left');
      }
      /* W & N */
      var wLen = Math.min(50, p.weight*0.4);
      drawArrow(cx-12, by, cx-12, by-wLen, '#3ddc84', 5);
      drawArrow(cx-12, by+BH, cx-12, by+BH+wLen, '#ff5555', 5);
    }
    /* Velocity & accel arrows during run */
    if (showVectors && law2_running && law2_blockV > 0.05) {
      var vLen = Math.min(110, law2_blockV*6);
      drawArrow(cx, by-30, cx+vLen, by-30, '#f5c842', 6);
      drawForceLabel(cx+vLen*0.5, by-44, 'v='+law2_blockV.toFixed(1)+' m/s', '#f5c842');
      var aLen = Math.min(80, p.accel*15);
      if (aLen > 4) {
        drawArrow(cx, by-50, cx+aLen, by-50, '#42a5f5', 6);
        drawForceLabel(cx+aLen*0.5, by-62, 'a='+p.accel.toFixed(2)+' m/s²', '#42a5f5');
      }
    }

    if (!law2_running && !p.isMoving && law2_force>0 && law2_mu>0) {
      ctx.font='600 11px "Segoe UI",sans-serif'; ctx.fillStyle='#ff5555';
      ctx.textAlign='center'; ctx.textBaseline='top';
      ctx.fillText('F ('+UNIT.force(law2_force)+' '+UNIT.forceU()+') < μN ('+UNIT.force(p.maxFriction)+' '+UNIT.forceU()+') → static friction holds', W/2, SY+22);
    }

    /* Live readout strip */
    var by2 = SY + 56;
    if (law2_running) {
      var bw = (W-60)/5;
      drawBadge(10, by2, bw, 36, 'TIME', law2_time.toFixed(1)+' s', '#f9a825');
      drawBadge(10+(bw+5), by2, bw, 36, 'VELOCITY', law2_blockV.toFixed(1)+' m/s', '#42a5f5');
      drawBadge(10+(bw+5)*2, by2, bw, 36, 'DISTANCE', law2_dist.toFixed(1)+' m', '#3ddc84');
      drawBadge(10+(bw+5)*3, by2, bw, 36, 'ACCEL.', p.accel.toFixed(2)+' m/s²', '#f9a825');
      drawBadge(10+(bw+5)*4, by2, bw, 36, law2_paused?'PAUSED':'NET F', law2_paused?'⏸':p.fnet.toFixed(1)+' N', law2_paused?'#f5c842':'#3ddc84');
    }
  }

  /* ================================================================
     2nd LAW — INCLINE (animated)
     ================================================================ */
  function draw2ndLawIncline() {
    var p = law2_physics_incline();
    var rad = law2_angle * Math.PI / 180;
    var baseY = 380;
    var incW = Math.min(640, W*0.7);
    var incH = incW * Math.tan(rad);
    if (incH > 280) { incH = 280; incW = incH / Math.tan(rad); }
    var startX = (W - incW) / 2;

    /* Ground line the ramp sits on */
    ctx.strokeStyle='rgba(150,168,208,0.55)'; ctx.lineWidth=2;
    ctx.beginPath(); ctx.moveTo(30, baseY); ctx.lineTo(W-30, baseY); ctx.stroke();
    /* Incline triangle — solid shaded ramp rising to the RIGHT (matches the
       block's motion, trail and roughness hatch). Apex at top-right. */
    ctx.beginPath();
    ctx.moveTo(startX, baseY); ctx.lineTo(startX+incW, baseY); ctx.lineTo(startX+incW, baseY-incH); ctx.closePath();
    var rg = ctx.createLinearGradient(startX, baseY, startX+incW, baseY-incH);
    rg.addColorStop(0,'rgba(30,36,58,0.62)'); rg.addColorStop(1,'rgba(74,85,120,0.42)');
    ctx.fillStyle = rg; ctx.fill();
    ctx.strokeStyle='#5a6690'; ctx.lineWidth=3; ctx.stroke();
    /* Slope face highlight (the hypotenuse the block rides) */
    ctx.strokeStyle='rgba(255,255,255,0.18)'; ctx.lineWidth=1.4;
    ctx.beginPath(); ctx.moveTo(startX, baseY); ctx.lineTo(startX+incW, baseY-incH); ctx.stroke();
    if (law2_mu > 0) {
      ctx.lineWidth=1; ctx.strokeStyle='rgba(141,110,99,0.75)';
      var slopeLen = Math.sqrt(incW*incW + incH*incH);
      var nHash = Math.floor(slopeLen / 22);
      for (var hi=1; hi<nHash; hi++) {
        var px = startX + (hi/nHash)*incW;
        var py = baseY - (hi/nHash)*incH;
        ctx.beginPath(); ctx.moveTo(px, py); ctx.lineTo(px - 6*Math.sin(rad), py - 6*Math.cos(rad)); ctx.stroke();
      }
    }
    /* Angle arc at the bottom-left corner (between base and the rising slope) */
    ctx.strokeStyle='#f5c842'; ctx.lineWidth=1.5;
    ctx.beginPath(); ctx.arc(startX, baseY, 34, -rad, 0); ctx.stroke();
    ctx.font='600 11px "Cambria Math",serif'; ctx.fillStyle='#f5c842';
    ctx.textAlign='left'; ctx.textBaseline='middle';
    ctx.fillText(law2_angle+'°', startX+42, baseY-11);

    /* Block position along slope */
    var BW = 50, BH = 36;
    var slopeLen2 = inclineSlopeLen();   /* shared with the tick's stop condition */
    var sDist = law2_running ? Math.max(0, Math.min(slopeLen2 - 30, law2_dist * PPM)) : 0;
    /* Block sits at base initially (start at lower-left), slides up if pushed */
    var slideUp = (law2_force > p.Wpar); /* tends up if positive */
    var bx, by;
    if (slideUp) {
      bx = startX + sDist*Math.cos(rad);
      by = baseY - sDist*Math.sin(rad) - BH;
    } else {
      /* slide down from top */
      bx = startX + (slopeLen2*0.85 - sDist)*Math.cos(rad);
      by = baseY - (slopeLen2*0.85 - sDist)*Math.sin(rad) - BH;
    }

    /* Trail along slope */
    if (showTrail && trail.length > 1) {
      ctx.strokeStyle='rgba(66,165,245,0.45)'; ctx.lineWidth=2;
      ctx.beginPath();
      for (var ti=0;ti<trail.length;ti++){
        if (ti===0) ctx.moveTo(trail[ti].x, trail[ti].y); else ctx.lineTo(trail[ti].x, trail[ti].y);
      }
      ctx.stroke();
    }

    /* Rotated block */
    ctx.save();
    ctx.translate(bx + BW/2*Math.cos(rad), by + BH/2 + BW/2*(-Math.sin(rad)));
    ctx.rotate(-rad);
    drawBlock(-BW/2, -BH/2, BW, BH, law2_mass.toFixed(1)+' kg');
    ctx.restore();

    /* Centre of block (after rotation) for FBD */
    var ccx = bx + BW/2*Math.cos(rad);
    var ccy = by + BH/2 - BW/2*Math.sin(rad);

    if (showFBD) {
      var ux = Math.cos(rad), uy = -Math.sin(rad);   /* up-slope unit (right-rising) */
      /* Weight — straight down (gravity) */
      var wLen = forceToLen(p.weight);
      drawArrow(ccx, ccy, ccx, ccy+wLen, '#ff5555', 6);
      drawForceLabel(ccx + 8, ccy+wLen, 'W='+p.weight.toFixed(0)+'N','#ff5555','left');
      /* Normal — perpendicular to slope, outward (up-left) */
      var nLen = forceToLen(p.normal);
      var nOx = -Math.sin(rad), nOy = -Math.cos(rad);
      drawArrow(ccx, ccy, ccx + nOx*nLen, ccy + nOy*nLen, '#3ddc84', 6);
      drawForceLabel(ccx + nOx*nLen - 6, ccy + nOy*nLen - 4, 'N='+p.normal.toFixed(0)+'N','#3ddc84','right');
      /* W‖ — weight component down the slope (down-left) */
      var wpL = forceToLen(p.Wpar);
      drawArrow(ccx, ccy, ccx - ux*wpL, ccy - uy*wpL, '#ff8a65', 5);
      drawForceLabel(ccx - ux*wpL - 6, ccy - uy*wpL + 4, 'W‖='+p.Wpar.toFixed(0)+'N','#ff8a65','right');
      /* Applied force — up the slope (up-right) */
      if (law2_force > 0) {
        var fL = forceToLen(law2_force);
        drawArrow(ccx, ccy, ccx + ux*fL, ccy + uy*fL, '#3ddc84', 6);
        drawForceLabel(ccx + ux*fL + 6, ccy + uy*fL - 4, 'F='+law2_force+'N','#3ddc84','left');
      }
      /* Friction — opposes motion along the slope */
      if (p.friction > 0.5) {
        var ffL = forceToLen(p.friction);
        var fricSign = (law2_force > p.Wpar) ? -1 : 1; /* moving up → friction down; else up */
        drawArrow(ccx, ccy, ccx + fricSign*ux*ffL, ccy + fricSign*uy*ffL, '#ffa726', 5);
        drawForceLabel(ccx + fricSign*ux*ffL, ccy + fricSign*uy*ffL - 12, 'f='+p.friction.toFixed(0)+'N','#ffa726');
      }
    }

    /* Live badges */
    if (law2_running) {
      var bw = (W-60)/4;
      drawBadge(10, H-46, bw, 36, 'TIME', law2_time.toFixed(1)+'s','#f9a825');
      drawBadge(10+bw+5, H-46, bw, 36, 'V (slope)', law2_blockV.toFixed(1)+' m/s','#42a5f5');
      drawBadge(10+(bw+5)*2, H-46, bw, 36, 'DIST (slope)', law2_dist.toFixed(1)+' m','#3ddc84');
      drawBadge(10+(bw+5)*3, H-46, bw, 36, 'ACCEL.', p.accel.toFixed(2)+' m/s²','#f9a825');
    }
  }

  /* ================================================================
     2nd LAW — ATWOOD PULLEY
     ================================================================ */
  function drawAtwood() {
    var p = law2_physics_atwood();
    var pulleyX = W/2, pulleyY = 60, pulleyR = 30;
    /* Ceiling bar */
    ctx.strokeStyle='#4a5578'; ctx.lineWidth=4;
    ctx.beginPath(); ctx.moveTo(pulleyX-90, 28); ctx.lineTo(pulleyX+90, 28); ctx.stroke();
    /* Mount */
    ctx.lineWidth=3;
    ctx.beginPath(); ctx.moveTo(pulleyX, 28); ctx.lineTo(pulleyX, pulleyY-pulleyR); ctx.stroke();
    /* Pulley wheel — radial-shaded disc with amber rim */
    var pg = ctx.createRadialGradient(pulleyX-pulleyR*0.35, pulleyY-pulleyR*0.35, 2, pulleyX, pulleyY, pulleyR);
    pg.addColorStop(0,'#3a4472'); pg.addColorStop(1,'#1c2238');
    ctx.fillStyle=pg; ctx.strokeStyle='#f9a825'; ctx.lineWidth=3;
    ctx.beginPath(); ctx.arc(pulleyX, pulleyY, pulleyR, 0, Math.PI*2); ctx.fill(); ctx.stroke();
    ctx.strokeStyle='rgba(255,255,255,0.14)'; ctx.lineWidth=1.5;
    ctx.beginPath(); ctx.arc(pulleyX, pulleyY, pulleyR-5, Math.PI*1.05, Math.PI*1.6); ctx.stroke();
    ctx.beginPath(); ctx.arc(pulleyX, pulleyY, 6, 0, Math.PI*2); ctx.fillStyle='#f9a825'; ctx.fill();

    /* Mass positions: atwood_y > 0 means A descended */
    var maxY = 320;
    var yA = 110 + Math.min(maxY, Math.max(-maxY*0.8, atwood_y * PPM));
    var yB = 110 - Math.min(maxY, Math.max(-maxY*0.8, atwood_y * PPM));
    var ropeXA = pulleyX - pulleyR;
    var ropeXB = pulleyX + pulleyR;

    /* Ropes */
    ctx.strokeStyle='#bdb286'; ctx.lineWidth=2;
    ctx.beginPath(); ctx.moveTo(ropeXA, pulleyY); ctx.lineTo(ropeXA, yA); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(ropeXB, pulleyY); ctx.lineTo(ropeXB, yB); ctx.stroke();

    /* Masses — sized by mass */
    var sA = 30 + Math.min(35, law2_mA * 1.2);
    var sB = 30 + Math.min(35, law2_mB * 1.2);
    drawBlock(ropeXA - sA/2, yA, sA, sA*0.7, law2_mA.toFixed(1)+'kg', 'rgba(255,138,101,0.35)', '#ff8a65');
    drawBlock(ropeXB - sB/2, yB, sB, sB*0.7, law2_mB.toFixed(1)+'kg', 'rgba(66,165,245,0.35)', '#42a5f5');

    /* FBD on each: W down, T up */
    if (showFBD) {
      var wAlen = Math.min(70, law2_mA*G*0.5);
      var wBlen = Math.min(70, law2_mB*G*0.5);
      var tLen  = Math.min(80, p.tension*0.5);
      drawArrow(ropeXA, yA + sA*0.7, ropeXA, yA + sA*0.7 + wAlen, '#ff5555', 5);
      drawArrow(ropeXA, yA, ropeXA, yA - tLen, '#3ddc84', 5);
      drawForceLabel(ropeXA, yA + sA*0.7 + wAlen + 10, 'Wₐ='+(law2_mA*G).toFixed(1)+'N', '#ff5555');
      drawForceLabel(ropeXA-30, yA - tLen - 8, 'T='+p.tension.toFixed(1)+'N', '#3ddc84', 'right');

      drawArrow(ropeXB, yB + sB*0.7, ropeXB, yB + sB*0.7 + wBlen, '#ff5555', 5);
      drawArrow(ropeXB, yB, ropeXB, yB - tLen, '#3ddc84', 5);
      drawForceLabel(ropeXB, yB + sB*0.7 + wBlen + 10, 'Wₘ='+(law2_mB*G).toFixed(1)+'N', '#ff5555');
      drawForceLabel(ropeXB+30, yB - tLen - 8, 'T='+p.tension.toFixed(1)+'N', '#3ddc84', 'left');
    }
    /* Velocity arrows */
    if (showVectors && law2_running && Math.abs(atwood_v) > 0.05) {
      var vL = Math.min(50, Math.abs(atwood_v)*6);
      var dir = p.accelSigned > 0 ? 1 : -1;
      drawArrow(ropeXA-40, yA+15, ropeXA-40, yA+15 + dir*vL, '#f5c842', 6);
      drawArrow(ropeXB+40, yB+15, ropeXB+40, yB+15 - dir*vL, '#f5c842', 6);
    }
    /* Badges */
    if (law2_running) {
      var bw = (W-80)/3;
      drawBadge(20, H-50, bw, 38, 'TIME', law2_time.toFixed(1)+' s','#f9a825');
      drawBadge(20+bw+10, H-50, bw, 38, 'V (rope)', Math.abs(atwood_v).toFixed(2)+' m/s','#42a5f5');
      drawBadge(20+(bw+10)*2, H-50, bw, 38, 'ACCEL.', p.accel.toFixed(2)+' m/s²','#3ddc84');
    } else {
      var bw2 = (W-80)/2;
      drawBadge(20, H-50, bw2, 38, 'TENSION', p.tension.toFixed(1)+' N','#3ddc84');
      drawBadge(20+bw2+10, H-50, bw2, 38, 'ACCEL.', p.accel.toFixed(2)+' m/s²','#f9a825');
    }
  }

  /* ================================================================
     2nd LAW — CONNECTED BLOCKS
     ================================================================ */
  function drawConnected() {
    var p = law2_physics_connected();
    var SY = 280;
    drawSurface(SY, 'μ = '+law2_mu.toFixed(2)+'  (both blocks)', law2_mu > 0);

    var BHa = 36 + law2_mA*0.6, BHb = 36 + law2_mB*0.6;
    var BWa = 50 + law2_mA*1.5, BWb = 50 + law2_mB*1.5;
    var gap = 90;

    var leadX = law2_running ? Math.min(W-100, law2_blockX) : 240;
    var aX = leadX, aY = SY - BHa;
    var bX = leadX - gap - BWb, bY = SY - BHb;

    /* Trail */
    if (showTrail && trail.length > 1) {
      ctx.strokeStyle='rgba(66,165,245,0.4)'; ctx.lineWidth=2;
      ctx.beginPath();
      for (var ti=0; ti<trail.length; ti++) {
        if (ti===0) ctx.moveTo(trail[ti].x, trail[ti].y); else ctx.lineTo(trail[ti].x, trail[ti].y);
      }
      ctx.stroke();
    }

    /* Rope between */
    ctx.strokeStyle='#bdb286'; ctx.lineWidth=2;
    ctx.beginPath(); ctx.moveTo(bX+BWb, bY+BHb/2); ctx.lineTo(aX, aY+BHa/2); ctx.stroke();

    contactShadow(bX + BWb/2, SY, BWb*0.62);
    contactShadow(aX + BWa/2, SY, BWa*0.62);
    drawBlock(bX, bY, BWb, BHb, 'B '+law2_mB.toFixed(1)+'kg', 'rgba(66,165,245,0.35)', '#42a5f5');
    drawBlock(aX, aY, BWa, BHa, 'A '+law2_mA.toFixed(1)+'kg', 'rgba(255,138,101,0.35)', '#ff8a65');

    if (showFBD) {
      /* F on A (right) */
      if (law2_force > 0) {
        var fL = forceToLen(law2_force);
        drawArrow(aX+BWa, aY+BHa/2, aX+BWa+fL, aY+BHa/2, '#3ddc84', 7);
        drawForceLabel(aX+BWa+fL+5, aY+BHa/2, 'F='+law2_force+'N','#3ddc84','left');
      }
      /* Tension labels on rope */
      ctx.font='700 11px "Segoe UI"'; ctx.fillStyle='#3ddc84';
      ctx.textAlign='center';
      ctx.fillText('T = '+UNIT.force(p.tension)+' '+UNIT.forceU(), (bX+BWb + aX)/2, (aY+bY)/2 - 12);
      /* Friction (single combined) */
      if (p.friction > 0.5) {
        var ffL = forceToLen(p.friction);
        drawArrow(bX, bY+BHb/2, bX-ffL, bY+BHb/2, '#ff5555', 6);
        drawForceLabel(bX-ffL-5, bY+BHb/2, 'f='+p.friction.toFixed(1)+'N','#ff5555','right');
      }
    }
    if (showVectors && law2_running && law2_blockV > 0.05) {
      var vL = Math.min(110, law2_blockV*6);
      drawArrow(aX+BWa/2, aY-22, aX+BWa/2+vL, aY-22, '#f5c842', 6);
      drawForceLabel(aX+BWa/2+vL*0.5, aY-36, 'v='+law2_blockV.toFixed(1)+' m/s','#f5c842');
    }
    /* Badges */
    if (law2_running) {
      var bw = (W-60)/4;
      drawBadge(10, H-46, bw, 36, 'TIME', law2_time.toFixed(1)+'s','#f9a825');
      drawBadge(10+bw+5, H-46, bw, 36, 'VELOCITY', law2_blockV.toFixed(1)+'m/s','#42a5f5');
      drawBadge(10+(bw+5)*2, H-46, bw, 36, 'ACCEL.', p.accel.toFixed(2)+'m/s²','#3ddc84');
      drawBadge(10+(bw+5)*3, H-46, bw, 36, 'TENSION', p.tension.toFixed(1)+'N','#f9a825');
    }
  }

  /* ================================================================
     3rd LAW — CANNON
     ================================================================ */
  function drawCannon(cx, gy) {
    var pivotY = gy - LAW3_BODY_H - LAW3_WHEEL_R + 5;
    /* Wheels */
    ctx.fillStyle='#3a3020'; ctx.strokeStyle='#8d6e63'; ctx.lineWidth=2;
    ctx.beginPath(); ctx.arc(cx-LAW3_BODY_W/2+5, gy-LAW3_WHEEL_R, LAW3_WHEEL_R, 0, Math.PI*2); ctx.fill(); ctx.stroke();
    ctx.beginPath(); ctx.arc(cx+LAW3_BODY_W/2-5, gy-LAW3_WHEEL_R, LAW3_WHEEL_R, 0, Math.PI*2); ctx.fill(); ctx.stroke();
    /* Body */
    ctx.fillStyle='#5d4037'; ctx.strokeStyle='#8d6e63'; ctx.lineWidth=2;
    ctx.beginPath(); ctx.roundRect(cx-LAW3_BODY_W/2, gy-LAW3_BODY_H-LAW3_WHEEL_R*0.5, LAW3_BODY_W, LAW3_BODY_H, 4);
    ctx.fill(); ctx.stroke();
    /* Barrel */
    ctx.save();
    ctx.translate(cx-5, pivotY);
    ctx.rotate(LAW3_BARREL_ANGLE);
    ctx.fillStyle='#2e2e2e'; ctx.strokeStyle='#616161';
    ctx.beginPath(); ctx.roundRect(0, -LAW3_BARREL_W/2, LAW3_BARREL_LEN, LAW3_BARREL_W, 4);
    ctx.fill(); ctx.stroke();
    ctx.restore();
    /* Label */
    ctx.font='700 11px "Segoe UI"'; ctx.fillStyle='#ffb74d';
    ctx.textAlign='center'; ctx.textBaseline='middle';
    ctx.fillText(UNIT.mass(law3_massA)+' '+UNIT.massU(), cx, gy-LAW3_BODY_H/2-LAW3_WHEEL_R*0.5);
  }
  function drawCannonball(x,y) {
    ctx.fillStyle='#212121'; ctx.strokeStyle='#616161'; ctx.lineWidth=1.5;
    ctx.beginPath(); ctx.arc(x,y, LAW3_BALL_R, 0, Math.PI*2); ctx.fill(); ctx.stroke();
  }
  function drawGround(gy) {
    /* grounded band */
    var g = ctx.createLinearGradient(0,gy,0,gy+70);
    g.addColorStop(0,'rgba(44,52,80,0.6)'); g.addColorStop(1,'rgba(16,20,33,0)');
    ctx.fillStyle=g; ctx.fillRect(0,gy,W,70);
    /* bright front edge */
    ctx.strokeStyle='rgba(150,168,208,0.7)'; ctx.lineWidth=2.5;
    ctx.beginPath(); ctx.moveTo(0,gy); ctx.lineTo(W,gy); ctx.stroke();
    /* receding hatch */
    ctx.lineWidth=1.2; ctx.strokeStyle='rgba(141,110,99,0.7)';
    for (var x=10;x<W;x+=22){ ctx.beginPath(); ctx.moveTo(x,gy); ctx.lineTo(x-7, gy+12); ctx.stroke(); }
  }
  function law3_muzzlePos() {
    var gy = law3_groundY();
    var pivotY = gy - LAW3_BODY_H - LAW3_WHEEL_R + 5;
    return { x: law3_cannonX - 5 + LAW3_BARREL_LEN*Math.cos(LAW3_BARREL_ANGLE),
             y: pivotY + LAW3_BARREL_LEN*Math.sin(LAW3_BARREL_ANGLE) };
  }
  function spawnSmoke(x,y){
    for (var i=0;i<24;i++){
      var ang = Math.random()*Math.PI/2 - Math.PI/4 + LAW3_BARREL_ANGLE;
      var sp = 1+Math.random()*4;
      law3_smokeParticles.push({ x:x,y:y, vx:Math.cos(ang)*sp, vy:Math.sin(ang)*sp - Math.random()*0.6, r:3+Math.random()*4, life:1 });
    }
  }
  function updateSmoke(dt){
    for (var i=law3_smokeParticles.length-1;i>=0;i--){
      var s = law3_smokeParticles[i];
      s.x += s.vx; s.y += s.vy; s.vy -= 0.04; s.r += 0.5; s.life -= 0.018;
      if (s.life <= 0) law3_smokeParticles.splice(i,1);
    }
  }
  function drawSmoke(){
    for (var i=0;i<law3_smokeParticles.length;i++){
      var s = law3_smokeParticles[i];
      ctx.fillStyle='rgba(160,160,160,'+(s.life*0.5)+')';
      ctx.beginPath(); ctx.arc(s.x,s.y,s.r,0,Math.PI*2); ctx.fill();
    }
  }
  /* Rocket exhaust — spawn (while firing) + integrate; keeps drawRocketScene pure */
  function updateRocketExhaust(spawning){
    var gy = law3_groundY();
    var rx = W*0.5;
    var ry = gy - 50 - Math.min(gy*0.85, rocket_y*4);
    if (spawning){
      for (var n=0;n<3;n++){
        rocket_exhaustParts.push({ x:rx+(Math.random()-0.5)*10, y:ry+30, vx:(Math.random()-0.5)*1.2, vy:2+Math.random()*3, r:3+Math.random()*4, life:1 });
      }
    }
    for (var j=rocket_exhaustParts.length-1; j>=0; j--){
      var e = rocket_exhaustParts[j];
      e.x += e.vx; e.y += e.vy; e.r += 0.4; e.life -= 0.04;
      if (e.life <= 0 || e.y > gy) rocket_exhaustParts.splice(j,1);
    }
  }
  function drawCannonScene() {
    var gy = law3_groundY();
    drawGround(gy);
    contactShadow(law3_cannonX, gy, LAW3_BODY_W*0.62);
    drawCannon(law3_cannonX, gy);
    /* Trail */
    if (showTrail && trail.length > 1) {
      ctx.strokeStyle='rgba(245,200,66,0.5)'; ctx.lineWidth=2;
      ctx.beginPath();
      for (var ti=0;ti<trail.length;ti++){
        if (ti===0) ctx.moveTo(trail[ti].x, trail[ti].y); else ctx.lineTo(trail[ti].x, trail[ti].y);
      }
      ctx.stroke();
    }
    drawSmoke();
    drawCannonball(law3_ballX, law3_ballY);
    if (showVectors && law3_running) {
      var vBmag = Math.sqrt(law3_ballVx*law3_ballVx + law3_ballVy*law3_ballVy);
      if (vBmag > 0.5) {
        drawArrow(law3_ballX, law3_ballY, law3_ballX + law3_ballVx*5, law3_ballY + law3_ballVy*5, '#f5c842', 6);
      }
      if (Math.abs(law3_cannonV) > 0.1) {
        drawArrow(law3_cannonX, gy-LAW3_BODY_H/2-LAW3_WHEEL_R*0.5, law3_cannonX + law3_cannonV*30, gy-LAW3_BODY_H/2-LAW3_WHEEL_R*0.5, '#42a5f5', 6);
      }
    }
    var bw = (W-60)/4;
    drawBadge(10, H-46, bw, 36, 'F (each)', law3_force.toFixed(0)+' N','#f9a825');
    drawBadge(10+(bw+5), H-46, bw, 36, 'a (Ball)', law3_accelB().toFixed(2)+' m/s²','#3ddc84');
    drawBadge(10+(bw+5)*2, H-46, bw, 36, 'a (Cannon)', law3_accelA().toFixed(2)+' m/s²','#42a5f5');
    drawBadge(10+(bw+5)*3, H-46, bw, 36, 'RATIO', (law3_accelB()/law3_accelA()).toFixed(1)+'×','#f5c842');
  }

  /* ────── ROCKET ────── */
  function drawRocketScene() {
    var gy = law3_groundY();
    /* Sky gradient */
    var grad = ctx.createLinearGradient(0,0,0,gy);
    grad.addColorStop(0, '#0a0e1a'); grad.addColorStop(1, '#1a2340');
    ctx.fillStyle = grad; ctx.fillRect(0,0,W,gy);
    /* Stars */
    ctx.fillStyle='#fff';
    for (var i=0; i<28; i++) {
      var sx = (i*173)%W, sy = (i*97)%(gy-30);
      ctx.globalAlpha = 0.3 + 0.5*Math.sin(animOffset*0.05+i);
      ctx.fillRect(sx, sy, 1.5, 1.5);
    }
    ctx.globalAlpha=1;
    drawGround(gy);
    var rx = W*0.5;
    var ry = gy - 50 - Math.min(gy*0.85, rocket_y*4);
    /* Rocket body */
    ctx.fillStyle='#e0e0e0'; ctx.strokeStyle='#90a4ae'; ctx.lineWidth=2;
    ctx.beginPath();
    ctx.moveTo(rx, ry-30);
    ctx.lineTo(rx-12, ry-10);
    ctx.lineTo(rx-12, ry+30);
    ctx.lineTo(rx+12, ry+30);
    ctx.lineTo(rx+12, ry-10);
    ctx.closePath(); ctx.fill(); ctx.stroke();
    /* Fins */
    ctx.fillStyle='#ef5350';
    ctx.beginPath(); ctx.moveTo(rx-12, ry+15); ctx.lineTo(rx-22, ry+30); ctx.lineTo(rx-12, ry+30); ctx.closePath(); ctx.fill();
    ctx.beginPath(); ctx.moveTo(rx+12, ry+15); ctx.lineTo(rx+22, ry+30); ctx.lineTo(rx+12, ry+30); ctx.closePath(); ctx.fill();
    /* Window */
    ctx.fillStyle='#42a5f5'; ctx.beginPath(); ctx.arc(rx, ry, 5, 0, Math.PI*2); ctx.fill();

    /* Exhaust particles — spawned + integrated in the animation tick
       (updateRocketExhaust); draw-only here so render() stays pure. */
    for (var j=0; j<rocket_exhaustParts.length; j++) {
      var e = rocket_exhaustParts[j];
      var col = e.life > 0.6 ? 'rgba(255,200,0,' : (e.life > 0.3 ? 'rgba(255,100,40,' : 'rgba(140,140,140,');
      ctx.fillStyle = col + (e.life*0.7)+')';
      ctx.beginPath(); ctx.arc(e.x, e.y, e.r, 0, Math.PI*2); ctx.fill();
    }
    /* Labels */
    ctx.font='700 12px "Segoe UI"'; ctx.fillStyle='#e0e0e0';
    ctx.textAlign='left'; ctx.textBaseline='middle';
    ctx.fillText(UNIT.mass(law3_massA)+' '+UNIT.massU()+' rocket', rx+30, ry);
    /* Action / reaction arrows */
    if (showFBD) {
      drawArrow(rx, ry+10, rx, ry-40, '#3ddc84', 7);
      drawForceLabel(rx-30, ry-15, 'Fₕ = '+law3_force+' N','#3ddc84','right');
      drawArrow(rx, ry+45, rx, ry+95, '#ff5555', 7);
      drawForceLabel(rx+30, ry+70, 'Fₘ = '+law3_force+' N','#ff5555','left');
    }
    /* Badges */
    var bw = (W-60)/4;
    drawBadge(10, H-46, bw, 36, 'F (thrust)', law3_force.toFixed(0)+' N','#f9a825');
    drawBadge(10+(bw+5), H-46, bw, 36, 'Weight', (law3_massA*G).toFixed(1)+' N','#ff5555');
    drawBadge(10+(bw+5)*2, H-46, bw, 36, 'F_net', Math.max(0,law3_force-law3_massA*G).toFixed(1)+' N','#3ddc84');
    drawBadge(10+(bw+5)*3, H-46, bw, 36, 'ACCEL.', Math.max(0,(law3_force-law3_massA*G)/law3_massA).toFixed(2)+' m/s²','#42a5f5');
  }

  /* ────── SKATERS ────── */
  function drawSkatersScene() {
    var gy = H - 80;
    /* Ice */
    var grad = ctx.createLinearGradient(0, gy-40, 0, H);
    grad.addColorStop(0, '#cfe8ff'); grad.addColorStop(1, '#7faecf');
    ctx.fillStyle = grad; ctx.fillRect(0, gy, W, H-gy);
    ctx.strokeStyle='#4a5578'; ctx.lineWidth=1;
    ctx.beginPath(); ctx.moveTo(0,gy); ctx.lineTo(W,gy); ctx.stroke();

    contactShadow(sk_xA, gy, 24);
    contactShadow(sk_xB, gy, 24);
    drawSkater(sk_xA, gy, '#ff8a65', law3_massA+' kg', 'A');
    drawSkater(sk_xB, gy, '#42a5f5', law3_massB+' kg', 'B');

    if (showFBD && law3_running) {
      /* Equal-opposite force arrows */
      drawArrow(sk_xA+15, gy-50, sk_xA+45, gy-50, '#3ddc84', 6);
      drawArrow(sk_xB-15, gy-50, sk_xB-45, gy-50, '#ff5555', 6);
      drawForceLabel((sk_xA+sk_xB)/2, gy-75, 'Internal F = '+law3_force+' N (equal & opposite)', '#f5c842');
    }
    if (showVectors && law3_running) {
      if (Math.abs(sk_vA) > 0.05) drawArrow(sk_xA, gy-95, sk_xA + sk_vA*15, gy-95, '#ff8a65', 6);
      if (Math.abs(sk_vB) > 0.05) drawArrow(sk_xB, gy-95, sk_xB + sk_vB*15, gy-95, '#42a5f5', 6);
    }
    var bw = (W-60)/4;
    drawBadge(10, H-46, bw, 36, 'F (each)', law3_force.toFixed(0)+' N','#f9a825');
    drawBadge(10+(bw+5), H-46, bw, 36, 'aₐ', law3_accelA().toFixed(2)+' m/s²','#ff8a65');
    drawBadge(10+(bw+5)*2, H-46, bw, 36, 'aₘ', law3_accelB().toFixed(2)+' m/s²','#42a5f5');
    drawBadge(10+(bw+5)*3, H-46, bw, 36, 'RATIO', (law3_accelB()/law3_accelA()).toFixed(1)+'×','#f5c842');
  }
  function drawSkater(x, gy, color, label, name) {
    /* Skate */
    ctx.fillStyle='#bdbdbd';
    ctx.fillRect(x-12, gy-2, 24, 4);
    /* Body */
    ctx.fillStyle=color; ctx.beginPath(); ctx.arc(x, gy-50, 14, 0, Math.PI*2); ctx.fill(); /* head */
    ctx.beginPath(); ctx.roundRect(x-9, gy-36, 18, 30, 4); ctx.fill();
    /* Legs */
    ctx.strokeStyle=color; ctx.lineWidth=4;
    ctx.beginPath(); ctx.moveTo(x-5, gy-8); ctx.lineTo(x-9, gy-2); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(x+5, gy-8); ctx.lineTo(x+9, gy-2); ctx.stroke();
    /* Label */
    ctx.font='700 11px "Segoe UI"'; ctx.fillStyle=color;
    ctx.textAlign='center'; ctx.textBaseline='middle';
    ctx.fillText(name, x, gy-50);
    ctx.fillStyle='#dde3f0'; ctx.font='600 10px "Segoe UI"';
    ctx.fillText(label, x, gy+15);
  }

  function draw3rdLaw() {
    if (law3_scenario === 'rocket') drawRocketScene();
    else if (law3_scenario === 'skaters') drawSkatersScene();
    else drawCannonScene();
  }

  /* ================================================================
     EXPLORE concept diagrams (kept from v2, condensed)
     ================================================================ */
  function drawConceptDiagram(c) {
