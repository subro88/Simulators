    }
  }
  function buildCoachTips() {
    var tips = [];
    if (selectedLaw === '1st') {
      if (law1_mu === 0) tips.push('<strong>Frictionless surface:</strong> the block keeps its velocity forever — textbook inertia.');
      else tips.push('<strong>Deceleration = μg</strong> = '+(law1_mu*G).toFixed(2)+' m/s² — <em>does not depend on mass</em>. A 10 kg and a 1000 kg block decelerate at the same rate.');
      var stopT = law1_mu > 0 ? (law1_initV/(law1_mu*G)).toFixed(1) : '∞';
      tips.push('Time to stop from '+law1_initV.toFixed(1)+' m/s: <strong>'+stopT+' s</strong>.');
    } else if (selectedLaw === '2nd') {
      if (law2_scenario === 'flat') {
        var p = law2_physics_flat();
        if (!p.isMoving) tips.push('<strong>Static friction holds:</strong> applied force ('+law2_force+' N) is below μN ('+p.maxFriction.toFixed(1)+' N). Increase F or reduce μ.');
        else {
          tips.push('Doubling mass would change acceleration to <strong>'+((p.fnet)/(2*law2_mass)).toFixed(2)+' m/s²</strong> (about half if friction stays kinetic).');
          tips.push('Doubling F would give acceleration of <strong>'+((2*law2_force - p.friction)/law2_mass).toFixed(2)+' m/s²</strong>.');
        }
      } else if (law2_scenario === 'incline') {
        var pi = law2_physics_incline();
        if (pi.accel === 0) tips.push('<strong>Equilibrium on slope</strong> — friction balances the net driving force.');
        else tips.push('At '+law2_angle+'°, gravity component along slope is <strong>'+pi.Wpar.toFixed(1)+' N</strong> — the driving (or resisting) force depending on F.');
      } else if (law2_scenario === 'atwood') {
        var pa = law2_physics_atwood();
        tips.push('Heavier mass falls; lighter rises. With m_a='+law2_mA.toFixed(1)+' and m_b='+law2_mB.toFixed(1)+' kg, the acceleration is <strong>'+pa.accel.toFixed(2)+' m/s²</strong> — always less than g because both masses share the system inertia.');
        tips.push('Try making the masses equal — acceleration would drop to <strong>0</strong> regardless of how heavy each is.');
      } else {
        var pc = law2_physics_connected();
        tips.push('Both blocks share the same acceleration <strong>'+pc.accel.toFixed(2)+' m/s²</strong>. The rope only transmits the force needed to accelerate block B.');
      }
    } else {
      tips.push('Same internal force ('+law3_force+' N) on both objects — but acceleration differs by the inverse mass ratio.');
      tips.push('Heavy object accelerates at <strong>'+law3_accelA().toFixed(2)+' m/s²</strong>; light object at <strong>'+law3_accelB().toFixed(2)+' m/s²</strong> — <strong>'+(law3_massA/law3_massB).toFixed(1)+'×</strong> more.');
      if (law3_scenario === 'rocket') {
        var fn = law3_force - law3_massA*G;
        if (fn <= 0) tips.push('<strong>Thrust too low!</strong> '+law3_force+' N cannot lift a '+law3_massA+' kg rocket (weight = '+(law3_massA*G).toFixed(1)+' N). Increase thrust.');
      }
    }
    return tips;
  }

  /* ================================================================
     CALC MODAL — KaTeX step-by-step
     ================================================================ */
  function calcStep(num, title, formula, calc, result) {
    var h = '<div class="cs-step"><div class="cs-step-hd"><span class="cs-num">Step '+num+'</span><span class="cs-title">'+title+'</span></div>';
    if (formula) h += '<div class="cs-formula">'+formula+'</div>';
    if (calc) h += '<div class="cs-calc">'+calc+'</div>';
    if (result != null) h += '<div class="cs-result">→ <strong>'+result+'</strong></div>';
    h += '</div>';
    return h;
  }
  function buildCalcSteps() {
    var html = '<div class="cs-inputs"><span class="cs-badge">Given — Current State</span><div class="cs-given">';
    if (selectedLaw === '1st') {
      html += '<span>v₀ = '+law1_initV.toFixed(2)+' m/s</span><span>m = '+law1_mass.toFixed(2)+' kg</span><span>μ = '+law1_mu.toFixed(2)+'</span>';
    } else if (selectedLaw === '2nd') {
      if (law2_scenario === 'atwood') html += '<span>m_a = '+law2_mA.toFixed(2)+' kg</span><span>m_b = '+law2_mB.toFixed(2)+' kg</span>';
      else if (law2_scenario === 'connected') html += '<span>F = '+law2_force+' N</span><span>m_a = '+law2_mA+' kg</span><span>m_b = '+law2_mB+' kg</span><span>μ = '+law2_mu.toFixed(2)+'</span>';
      else if (law2_scenario === 'incline') html += '<span>F = '+law2_force+' N</span><span>m = '+law2_mass+' kg</span><span>μ = '+law2_mu.toFixed(2)+'</span><span>θ = '+law2_angle+'°</span>';
      else html += '<span>F = '+law2_force+' N</span><span>m = '+law2_mass+' kg</span><span>μ = '+law2_mu.toFixed(2)+'</span>';
    } else {
      html += '<span>F = '+law3_force+' N</span><span>m_heavy = '+law3_massA+' kg</span><span>m_light = '+law3_massB+' kg</span>';
    }
    html += '</div><p class="cs-si-note">ⓘ All calculations in SI. g = 9.81 m/s².</p></div>';

    if (selectedLaw === '1st') {
      var wt = law1_mass*G, decel = law1_mu*G;
      html += calcStep(1, 'Weight', '\\[ W = m g \\]',
        '\\(W = '+law1_mass.toFixed(2)+' \\cdot 9.81 \\)', wt.toFixed(2)+' N');
      html += calcStep(2, 'Friction force', '\\[ f = \\mu N = \\mu m g \\]',
        '\\(f = '+law1_mu.toFixed(2)+' \\cdot '+law1_mass.toFixed(2)+' \\cdot 9.81 \\)', (law1_mu*wt).toFixed(2)+' N');
      html += calcStep(3, 'Deceleration', '\\[ a = \\dfrac{f}{m} = \\mu g \\]',
        '\\(a = '+law1_mu.toFixed(2)+' \\cdot 9.81 \\)', decel.toFixed(2)+' m/s²');
      html += calcStep(4, 'Stopping time', '\\[ t_{\\text{stop}} = \\dfrac{v_0}{a} \\]',
        law1_mu > 0 ? '\\(t = \\dfrac{'+law1_initV.toFixed(2)+'}{'+decel.toFixed(2)+'}\\)' : 'No friction → never stops',
        law1_mu > 0 ? (law1_initV/decel).toFixed(2)+' s' : '∞');
      html += calcStep(5, 'Stopping distance', '\\[ d = \\dfrac{v_0^2}{2a} \\]',
        law1_mu > 0 ? '\\(d = \\dfrac{'+(law1_initV*law1_initV).toFixed(2)+'}{2 \\cdot '+decel.toFixed(2)+'}\\)' : '—',
        law1_mu > 0 ? ((law1_initV*law1_initV)/(2*decel)).toFixed(2)+' m' : '∞');
    } else if (selectedLaw === '2nd') {
      if (law2_scenario === 'atwood') {
        var pa = law2_physics_atwood();
        html += calcStep(1, 'Net driving force', '\\[ F_{\\text{net}} = (m_a - m_b)\\,g \\]',
          '\\(F_{\\text{net}} = ('+law2_mA.toFixed(2)+' - '+law2_mB.toFixed(2)+') \\cdot 9.81 \\)', ((law2_mA-law2_mB)*G).toFixed(2)+' N');
        html += calcStep(2, 'System mass', '\\[ M = m_a + m_b \\]', '\\(M = '+law2_mA+' + '+law2_mB+'\\)', (law2_mA+law2_mB).toFixed(2)+' kg');
        html += calcStep(3, 'Acceleration', '\\[ a = \\dfrac{F_{\\text{net}}}{M} \\]',
          '\\(a = \\dfrac{'+((law2_mA-law2_mB)*G).toFixed(2)+'}{'+(law2_mA+law2_mB).toFixed(2)+'} \\)', pa.accel.toFixed(3)+' m/s²');
        html += calcStep(4, 'Rope tension', '\\[ T = \\dfrac{2\\,m_a\\,m_b\\,g}{m_a + m_b} \\]',
          '\\(T = \\dfrac{2 \\cdot '+law2_mA+' \\cdot '+law2_mB+' \\cdot 9.81}{'+(law2_mA+law2_mB).toFixed(2)+'}\\)', pa.tension.toFixed(2)+' N');
      } else if (law2_scenario === 'incline') {
        var pi = law2_physics_incline();
        html += calcStep(1, 'Weight', '\\[ W = m g \\]',
          '\\(W = '+law2_mass.toFixed(2)+' \\cdot 9.81 \\)', pi.weight.toFixed(2)+' N');
        html += calcStep(2, 'Normal (perp to slope)', '\\[ N = m g \\cos\\theta \\]',
          '\\(N = '+law2_mass.toFixed(2)+' \\cdot 9.81 \\cdot \\cos('+law2_angle+'^{\\circ})\\)', pi.normal.toFixed(2)+' N');
        html += calcStep(3, 'Weight component along slope', '\\[ W_{\\parallel} = m g \\sin\\theta \\]',
          '\\(W_{\\parallel} = '+law2_mass.toFixed(2)+' \\cdot 9.81 \\cdot \\sin('+law2_angle+'^{\\circ})\\)', pi.Wpar.toFixed(2)+' N');
        html += calcStep(4, 'Max static friction', '\\[ f_{\\max} = \\mu N \\]',
          '\\(f_{\\max} = '+law2_mu.toFixed(2)+' \\cdot '+pi.normal.toFixed(2)+'\\)', pi.maxFriction.toFixed(2)+' N');
        html += calcStep(5, 'Net force along slope', '\\[ F_{\\text{net}} = F - W_{\\parallel} \\mp f \\]',
          '\\(F_{\\text{net}} = '+law2_force+' - '+pi.Wpar.toFixed(2)+' - '+pi.friction.toFixed(2)+'\\) (friction opposes motion)', pi.fnet.toFixed(2)+' N');
        html += calcStep(6, 'Acceleration', '\\[ a = \\dfrac{F_{\\text{net}}}{m} \\]',
          '\\(a = \\dfrac{'+pi.fnet.toFixed(2)+'}{'+law2_mass.toFixed(2)+'}\\)', pi.accel.toFixed(3)+' m/s²');
      } else if (law2_scenario === 'connected') {
        var pc = law2_physics_connected();
        var M = law2_mA + law2_mB;
        html += calcStep(1, 'Total mass', '\\[ M = m_a + m_b \\]', '\\(M = '+law2_mA+' + '+law2_mB+'\\)', M.toFixed(2)+' kg');
        html += calcStep(2, 'Combined weight', '\\[ W = M g \\]', '\\(W = '+M.toFixed(2)+' \\cdot 9.81\\)', (M*G).toFixed(2)+' N');
        html += calcStep(3, 'Total friction', '\\[ f = \\mu M g \\]',
          '\\(f = '+law2_mu.toFixed(2)+' \\cdot '+M.toFixed(2)+' \\cdot 9.81\\)', pc.friction.toFixed(2)+' N');
        html += calcStep(4, 'Acceleration', '\\[ a = \\dfrac{F - f}{M} \\]',
          '\\(a = \\dfrac{'+law2_force+' - '+pc.friction.toFixed(2)+'}{'+M.toFixed(2)+'}\\)', pc.accel.toFixed(3)+' m/s²');
        html += calcStep(5, 'Rope tension', '\\[ T = m_b a + \\mu m_b g \\]',
          '\\(T = '+law2_mB+' \\cdot '+pc.accel.toFixed(3)+' + '+law2_mu.toFixed(2)+' \\cdot '+law2_mB+' \\cdot 9.81\\)', pc.tension.toFixed(2)+' N');
      } else {
        var pf = law2_physics_flat();
        html += calcStep(1, 'Weight', '\\[ W = m g \\]',
          '\\(W = '+law2_mass.toFixed(2)+' \\cdot 9.81\\)', pf.weight.toFixed(2)+' N');
        html += calcStep(2, 'Normal force', '\\[ N = W = m g \\]', '(flat surface, no vertical motion)', pf.normal.toFixed(2)+' N');
        html += calcStep(3, 'Max friction', '\\[ f_{\\max} = \\mu N \\]',
          '\\(f_{\\max} = '+law2_mu.toFixed(2)+' \\cdot '+pf.normal.toFixed(2)+'\\)', pf.maxFriction.toFixed(2)+' N');
        html += calcStep(4, pf.isMoving ? 'Kinetic friction acts' : 'Static friction balances F',
          pf.isMoving ? '\\[ f = \\mu N \\]' : '\\[ f = F \\text{ (static, } F \\le f_{\\max}) \\]',
          pf.isMoving ? '\\(f = '+pf.friction.toFixed(2)+'\\;\\mathrm{N}\\)' : 'Block does not slide.', pf.friction.toFixed(2)+' N');
        html += calcStep(5, 'Net force', '\\[ F_{\\text{net}} = F - f \\]',
          '\\(F_{\\text{net}} = '+law2_force+' - '+pf.friction.toFixed(2)+'\\)', pf.fnet.toFixed(2)+' N');
        html += calcStep(6, 'Acceleration', '\\[ a = \\dfrac{F_{\\text{net}}}{m} \\]',
          '\\(a = \\dfrac{'+pf.fnet.toFixed(2)+'}{'+law2_mass.toFixed(2)+'}\\)', pf.accel.toFixed(3)+' m/s²');
      }
    } else {
      html += calcStep(1, 'Equal & opposite force', '\\[ F_{12} = -F_{21} = F = '+law3_force+' \\;\\mathrm{N}\\]',
        'Both bodies experience the same magnitude force.', law3_force+' N each');
      html += calcStep(2, 'Heavy body acceleration', '\\[ a_{\\text{heavy}} = \\dfrac{F}{m_{\\text{heavy}}} \\]',
        '\\(a_{\\text{heavy}} = \\dfrac{'+law3_force+'}{'+law3_massA+'}\\)', law3_accelA().toFixed(3)+' m/s²');
      html += calcStep(3, 'Light body acceleration', '\\[ a_{\\text{light}} = \\dfrac{F}{m_{\\text{light}}} \\]',
        '\\(a_{\\text{light}} = \\dfrac{'+law3_force+'}{'+law3_massB+'}\\)', law3_accelB().toFixed(3)+' m/s²');
      html += calcStep(4, 'Acceleration ratio', '\\[ \\dfrac{a_{\\text{light}}}{a_{\\text{heavy}}} = \\dfrac{m_{\\text{heavy}}}{m_{\\text{light}}} \\]',
        '\\(\\text{ratio} = \\dfrac{'+law3_massA+'}{'+law3_massB+'}\\)', (law3_massA/law3_massB).toFixed(2)+'×');
      if (law3_scenario === 'rocket') {
        var fnet = law3_force - law3_massA*G;
        html += calcStep(5, 'Rocket: net upward force', '\\[ F_{\\text{net}} = F_{\\text{thrust}} - m g \\]',
          '\\(F_{\\text{net}} = '+law3_force+' - '+law3_massA+' \\cdot 9.81\\)', fnet.toFixed(2)+' N');
        html += calcStep(6, 'Launch acceleration', '\\[ a = \\dfrac{F_{\\text{net}}}{m} \\]',
          '\\(a = \\dfrac{'+fnet.toFixed(2)+'}{'+law3_massA+'}\\)', Math.max(0, fnet/law3_massA).toFixed(3)+' m/s²');
      }
    }
    return html;
  }
