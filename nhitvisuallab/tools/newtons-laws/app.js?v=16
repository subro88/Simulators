        var pc = law2_physics_connected();
        var totalM = law2_mA + law2_mB;
        html += '<div class="eq-line">\\[ a = \\dfrac{F - \\mu(m_a + m_b)g}{m_a + m_b} \\]</div>';
        html += '<div class="eq-line">\\(a = \\dfrac{'+law2_force+' - '+law2_mu.toFixed(2)+' \\cdot '+totalM.toFixed(1)+' \\cdot 9.81}{'+totalM.toFixed(1)+'} = \\mathbf{'+pc.accel.toFixed(2)+'\\;\\mathrm{m/s^2}}\\)</div>';
        html += '<div class="eq-line">\\[ T = m_b\\,a + \\mu\\,m_b\\,g \\]</div>';
        html += '<div class="eq-line">\\(T = '+law2_mB.toFixed(1)+' \\cdot '+pc.accel.toFixed(2)+' + '+law2_mu.toFixed(2)+' \\cdot '+law2_mB.toFixed(1)+' \\cdot 9.81 = \\mathbf{'+pc.tension.toFixed(1)+'\\;\\mathrm{N}}\\)</div>';
      } else if (law2_scenario === 'incline') {
        var pi = law2_physics_incline();
        var rad = law2_angle*Math.PI/180;
        html += '<div class="eq-line">\\[ N = mg\\cos\\theta \\quad W_{\\parallel} = mg\\sin\\theta \\]</div>';
        html += '<div class="eq-line">\\(N = '+law2_mass.toFixed(1)+' \\cdot 9.81 \\cdot \\cos('+law2_angle+'^{\\circ}) = \\mathbf{'+pi.normal.toFixed(1)+'\\;\\mathrm{N}}\\)</div>';
        html += '<div class="eq-line">\\(W_{\\parallel} = '+law2_mass.toFixed(1)+' \\cdot 9.81 \\cdot \\sin('+law2_angle+'^{\\circ}) = \\mathbf{'+pi.Wpar.toFixed(1)+'\\;\\mathrm{N}}\\)</div>';
        html += '<div class="eq-line">\\[ a = \\dfrac{F - W_{\\parallel} - \\mu N}{m} = \\mathbf{'+pi.accel.toFixed(2)+'\\;\\mathrm{m/s^2}}\\]</div>';
      } else {
        var pf = law2_physics_flat();
        html += '<div class="eq-line">\\[ F_{\\text{net}} = F - \\mu m g \\]</div>';
        html += '<div class="eq-line">\\(F_{\\text{net}} = '+law2_force+' - '+law2_mu.toFixed(2)+' \\cdot '+law2_mass.toFixed(1)+' \\cdot 9.81 = \\mathbf{'+pf.fnet.toFixed(1)+'\\;\\mathrm{N}}\\)</div>';
        html += '<div class="eq-line">\\[ a = \\dfrac{F_{\\text{net}}}{m} \\]</div>';
        html += '<div class="eq-line">\\(a = \\dfrac{'+pf.fnet.toFixed(1)+'}{'+law2_mass.toFixed(1)+'} = \\mathbf{'+pf.accel.toFixed(2)+'\\;\\mathrm{m/s^2}}\\)</div>';
