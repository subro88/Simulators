  /* ================================================================
     RENDER
     ================================================================ */
  function render() {
    ctx.clearRect(0,0,W,H);
    drawSceneBackground(W*0.42, H*0.44);
    drawBgGrid();
    if (mode === 'simulate') {
      if (selectedLaw === '1st') { draw1stLaw(); drawEquationOverlay('1st'); }
      else if (selectedLaw === '2nd') {
        if (law2_scenario === 'incline') draw2ndLawIncline();
        else if (law2_scenario === 'atwood') drawAtwood();
        else if (law2_scenario === 'connected') drawConnected();
        else draw2ndLawFlat();
        drawEquationOverlay('2nd');
      }
      else { draw3rdLaw(); drawEquationOverlay('3rd'); }
    } else if (mode === 'explore') {
      var c = CONCEPTS.filter(function(cc){return cc.cat===selCat;});
      if (c[selConcept]) drawConceptDiagram(c[selConcept]);
    } else if (mode === 'quiz') drawQuizCanvas();
  }

  function drawQuizCanvas() {
    ctx.font='700 18px "Segoe UI"'; ctx.fillStyle='#dde3f0';
    ctx.textAlign='center'; ctx.textBaseline='middle';
    ctx.fillText('Quiz Mode', W/2, 40);
    ctx.font='600 12px "Segoe UI"'; ctx.fillStyle='#f9a825';
    ctx.fillText('Answer the question below', W/2, 65);
    drawBlock(380, 180, 100, 70, 'F = ma');
    drawArrow(480, 215, 560, 215, '#3ddc84', 8);
    drawArrow(380, 215, 300, 215, '#ff5555', 7);
  }

  /* ================================================================
     ANIMATION
     ================================================================ */
  function animate() {
    animOffset += 0.8;
    if (animOffset > 10000) animOffset = 0;
    var dt = (1/60) * animSpeed;

    if (mode === 'simulate') {
      if (selectedLaw === '1st' && law1_running) {
        if (law1_mu > 0 && Math.abs(law1_blockV) > 0.01) {
          var decel = law1_mu * G;
          if (law1_blockV > 0) law1_blockV = Math.max(0, law1_blockV - decel*dt);
          else law1_blockV = Math.min(0, law1_blockV + decel*dt);
        }
        var dxL1 = law1_blockV * PPM * dt;
        law1_blockX += dxL1; law1_dist += Math.abs(dxL1)/PPM; law1_time += dt;
        if (showTrail) { trail.push({x:law1_blockX+40, y:320-20}); if (trail.length>200) trail.shift(); }
        if (law1_blockX > W+50) law1_blockX = -80;
        if (law1_blockX < -80) law1_blockX = W+50;
        if (rollFactor < 1) rollFactor = Math.min(1, rollFactor + dt*2);
        if (Math.abs(law1_blockV) < 0.01 && law1_mu > 0) { law1_running = false; playStop(); }
      }
      if (selectedLaw === '2nd' && law2_running && !law2_paused) {
        if (law2_scenario === 'atwood') {
          var pa = law2_physics_atwood();
          atwood_v += pa.accelSigned * dt;
          atwood_y += atwood_v * dt;
          law2_time += dt;
          law2_vHistory.push({t:law2_time, v:Math.abs(atwood_v), x:Math.abs(atwood_y), a:pa.accel});
          if (law2_vHistory.length > 500) law2_vHistory.shift();
          if (rollFactor < 1) rollFactor = Math.min(1, rollFactor + dt*2);
          if (Math.abs(atwood_y) > 12) law2_paused = true;
        } else {
          var p2 = law2_physics();
          /* blockV is the along-track SPEED (magnitude). On an incline the
             signed accel can be negative (block sliding DOWN); the draw code
             places the block via the slideUp flag, so use the magnitude here —
             otherwise a released/down-slope block would stay frozen. */
          law2_blockV += Math.abs(p2.accel) * dt;
          if (law2_blockV < 0) law2_blockV = 0;
          var dx = law2_blockV * PPM * dt;
          law2_blockX += dx;
          law2_dist += law2_blockV * dt; law2_time += dt;
          /* Trail */
          if (showTrail) {
            var tx, ty;
            if (law2_scenario === 'incline') {
              var rad = law2_angle*Math.PI/180;
              var baseY = 380, incW = Math.min(640,W*0.7), incH = incW*Math.tan(rad);
              if (incH > 280) { incH = 280; incW = incH/Math.tan(rad); }
              var startX = (W-incW)/2;
              var slope = inclineSlopeLen();   /* shared with the tick's stop condition */
              var s = Math.min(slope-30, law2_dist * PPM);
              var slideUp = (law2_force > p2.Wpar);
              if (slideUp) { tx = startX + s*Math.cos(rad); ty = baseY - s*Math.sin(rad) - 18; }
              else { tx = startX + (slope*0.85 - s)*Math.cos(rad); ty = baseY - (slope*0.85 - s)*Math.sin(rad) - 18; }
            } else {
              tx = law2_blockX + 30;
              ty = law2_scenario==='connected' ? 280-18 : 230-21;
            }
            trail.push({x:tx, y:ty}); if (trail.length > 200) trail.shift();
          }
          if (law2_time >= law2_nextMarker) {
            law2_markers.push({x:law2_blockX, t:law2_time});
            law2_nextMarker += LAW2_MARKER_INT;
          }
          law2_vHistory.push({t:law2_time, v:law2_blockV, x:law2_dist, a:p2.accel});
          if (law2_vHistory.length > 500) law2_vHistory.shift();
          if (law2_blockV > 50) law2_blockV = 50;
          if (rollFactor < 1) rollFactor = Math.min(1, rollFactor + dt*2);
          /* Stop when the block reaches the end of the track it is drawn on.
             The incline renders the block from law2_dist along the SLOPE and
             clamps it at slopeLen-30, but the run used to keep going until the
             flat-scenario law2_blockX passed W-100 — so on a ramp the block sat
             frozen at the top for the last ~28% of the run while the DISTANCE
             badge carried on counting. Both now end at the same place. */
          if (law2_scenario === 'incline') {
            if (law2_dist * PPM >= inclineSlopeLen() - 30) law2_paused = true;
          } else if (law2_blockX > W-100) {
            law2_paused = true;
          }
        }
        updateReadouts();
        updateLearnPanels();
        if (law2_time > 0.1 && Math.abs(law2_time - Math.round(law2_time*5)/5) < 0.05) drawHistory();
      }
      if (selectedLaw === '3rd' && law3_running) {
        if (law3_scenario === 'cannon') {
          if (law3_phase === 'impulse') {
            law3_impulseTimer += dt;
            var aA = law3_force/law3_massA, aB = law3_force/law3_massB;
            law3_cannonV -= aA * dt;
            law3_ballVx += aB * Math.cos(LAW3_BARREL_ANGLE) * dt;
            law3_ballVy += aB * Math.sin(LAW3_BARREL_ANGLE) * dt;
            if (law3_impulseTimer >= LAW3_IMPULSE_DT) law3_phase = 'coast';
          }
          law3_cannonX += law3_cannonV * PPM * dt;
          law3_ballX += law3_ballVx * PPM * dt;
          law3_ballY += law3_ballVy * PPM * dt;
          law3_ballVy += G * dt;
          if (Math.abs(law3_cannonV) > 0.01) law3_cannonV *= 0.992; else law3_cannonV = 0;
          if (showTrail) { trail.push({x:law3_ballX, y:law3_ballY}); if (trail.length>300) trail.shift(); }
          var gy3 = law3_groundY();
          if (law3_ballY > gy3 - LAW3_BALL_R) {
            law3_ballY = gy3 - LAW3_BALL_R;
            law3_ballVy = -law3_ballVy*0.3;
            if (Math.abs(law3_ballVy) < 0.5) law3_ballVy = 0;
          }
          if (law3_ballX > W+50) law3_running = false;
          updateSmoke(dt);
        } else if (law3_scenario === 'rocket') {
          var fnetR = law3_force - law3_massA*G;
          var aR = fnetR / law3_massA;
          rocket_vy += aR * dt;
          if (rocket_vy < 0) rocket_vy = 0;
          rocket_y += rocket_vy * dt;
          updateRocketExhaust(true);
          if (rocket_y > 50) law3_running = false;
        } else if (law3_scenario === 'skaters') {
          if (law3_phase === 'impulse') {
            law3_impulseTimer += dt;
            sk_vA -= (law3_force/law3_massA) * dt;
            sk_vB += (law3_force/law3_massB) * dt;
            if (law3_impulseTimer >= LAW3_IMPULSE_DT) law3_phase = 'coast';
          }
          sk_xA += sk_vA * PPM * dt;
          sk_xB += sk_vB * PPM * dt;
          if (sk_xA < -50 || sk_xB > W+50) law3_running = false;
        }
        if (rollFactor < 1) rollFactor = Math.min(1, rollFactor + dt*2);
      }
    }
    render();
    if (mode === 'simulate') animFrame = requestAnimationFrame(animate);
  }

  function startAnimation() {
    if (animFrame) cancelAnimationFrame(animFrame);
    animate();
  }
  function stopAnimation() {
    if (animFrame) { cancelAnimationFrame(animFrame); animFrame = null; }
  }

  /* ================================================================
     HISTORY GRAPH
     ================================================================ */
  function drawHistory() {
    if (!hctx) return;
    hctx.clearRect(0,0,HW,HH);
    hctx.fillStyle = '#0d1117'; hctx.fillRect(0,0,HW,HH);
    var L = 50, R = HW-20, T = 16, B = HH-26;
    /* Axes */
    hctx.strokeStyle='#3a4060'; hctx.lineWidth=1;
    hctx.beginPath(); hctx.moveTo(L,T); hctx.lineTo(L,B); hctx.lineTo(R,B); hctx.stroke();
    hctx.font='600 9px "Segoe UI"'; hctx.fillStyle='#6b7a99';
    hctx.textAlign='center'; hctx.textBaseline='top';
    hctx.fillText('t (s)', (L+R)/2, B+12);

    var data = law2_vHistory || [];
    if (data.length < 2) {
      hctx.fillStyle='#3a4060'; hctx.textAlign='center'; hctx.textBaseline='middle';
      hctx.font='600 11px "Segoe UI"';
      hctx.fillText('Press Push — graph plots time history of x, v, a', HW/2, HH/2);
      return;
    }
    var maxT = data[data.length-1].t || 1;
    function plotSeries(key, color, label, yLabel) {
      var maxY = 0.1;
      for (var i=0;i<data.length;i++) if (data[i][key] > maxY) maxY = data[i][key];
      maxY = Math.ceil(maxY * 1.1);
      /* Y axis labels */
      hctx.fillStyle = color;
      hctx.textAlign = 'right'; hctx.textBaseline = 'middle'; hctx.font='600 9px "Courier New"';
      hctx.fillText(maxY.toFixed(1), L-3, T+5);
      hctx.fillText('0', L-3, B);
      /* Plot */
      hctx.strokeStyle = color; hctx.lineWidth = 2;
      hctx.beginPath();
      for (var k=0;k<data.length;k++){
        var x = L + (data[k].t/maxT)*(R-L);
        var y = B - (data[k][key]/maxY)*(B-T);
        if (k===0) hctx.moveTo(x,y); else hctx.lineTo(x,y);
      }
      hctx.stroke();
      /* Legend */
      hctx.fillStyle=color; hctx.font='700 10px "Segoe UI"';
      hctx.textAlign='left'; hctx.textBaseline='top';
      hctx.fillText(label, R-90+yLabel*65, T-2);
    }
    /* T grid */
    hctx.strokeStyle='rgba(58,64,96,0.4)'; hctx.lineWidth=0.5;
    hctx.font='600 8px "Courier New"'; hctx.fillStyle='#3a4060';
    hctx.textAlign='center'; hctx.textBaseline='top';
    var tStep = maxT<=4?1:maxT<=10?2:5;
    for (var tt=0; tt<=maxT; tt+=tStep) {
      var tx = L + (tt/maxT)*(R-L);
      hctx.beginPath(); hctx.moveTo(tx,T); hctx.lineTo(tx,B); hctx.stroke();
      hctx.fillText(tt, tx, B+2);
    }
    if (histAxis==='v') plotSeries('v', '#42a5f5', 'v(t) m/s', 0);
    else if (histAxis==='x') plotSeries('x', '#3ddc84', 'x(t) m', 0);
    else if (histAxis==='a') plotSeries('a', '#f9a825', 'a(t) m/s²', 0);
    else { plotSeries('x','#3ddc84','x',0); plotSeries('v','#42a5f5','v',1); plotSeries('a','#f9a825','a',-1); }
  }

