  function pushAction() {
    if (typeof dismissHint === 'function') dismissHint();
    if (selectedLaw === '1st') {
      saveUndo();
      law1_running = true; law1_blockV = law1_initV; law1_blockX = 100;
      law1_time = 0; law1_dist = 0; trail = []; rollFactor = 0;
      playPush();
    } else if (selectedLaw === '2nd') {
      if (law2_scenario === 'atwood') {
        saveUndo();
        resetAllPositions();
        law2_running = true; law2_paused = false;
        playPush();
      } else {
        var p = law2_physics();
        if (!p.isMoving) { playStop(); return; }
        saveUndo();
        resetAllPositions();
        /* Connected blocks need room on the left for block B — start further in. */
        if (law2_scenario === 'connected') law2_blockX = 240;
        law2_running = true; law2_paused = false;
        law2_markers.push({x:law2_blockX, t:0});
        law2_vHistory.push({t:0, v:0, x:0, a:p.accel});
        playPush();
      }
    } else {
      if (law3_running) return;
      saveUndo();
      law3_resetPositions(); law3_running = true; law3_phase = 'impulse'; law3_impulseTimer = 0;
      trail = []; rollFactor = 0;
      if (law3_scenario === 'cannon') { var mp = law3_muzzlePos(); spawnSmoke(mp.x, mp.y); playCannonBoom(); }
      else if (law3_scenario === 'rocket') playCannonBoom();
      else playPush();
    }
    updatePauseBtn();
  }
