      options: ['The larger (driver) pulley', 'The smaller (driven) pulley', 'Both have equal wrap', 'It depends on belt speed'], correct: 1,
      explain: 'In an open belt, the smaller pulley always has a smaller wrap angle θ = π − 2α, which limits the drive capacity.' },
    { type: 'mcq', prompt: 'Belt speed v in m/s is calculated using:',
      options: ['v = πD₁N₁/60', 'v = D₁N₁/60', 'v = πD₁N₁/60000', 'v = 2πD₁N₁/60'], correct: 2,
      explain: 'v = π × D₁ × N₁ / 60000 m/s, where D₁ is in mm and N₁ in rpm. The 60000 converts mm·rpm to m/s.' },
    { type: 'mcq', prompt: 'In a crossed belt drive, the wrap angle on both pulleys is:',
      options: ['Less than 180°', 'Exactly 180°', 'Greater than 180°', 'Different for each pulley'], correct: 2,
      explain: 'Crossed belt: θ = π + 2sin⁻¹((R₁+R₂)/C), which is always > π (180°). Both pulleys have the same wrap angle.' },
    { type: 'mcq', prompt: 'Power transmitted by a belt drive equals:',
      options: ['P = T₁ × v', 'P = (T₁ − T₂) × v', 'P = T₂ × v', 'P = (T₁ + T₂) × v'], correct: 1,
      explain: 'Net power = effective tension × belt speed = (T₁ − T₂) × v. Only the difference in tensions does useful work.' }
  ];
  function quizNumN2() {
    var D1 = randInt(2, 6) * 50, D2 = randInt(1, 5) * 50, N1 = randInt(4, 16) * 50;
    var N2 = N1 * D1 / D2;
    return { type: 'numeric',
      prompt: 'A belt drive has D₁ = ' + D1 + ' mm, D₂ = ' + D2 + ' mm, N₁ = ' + N1 + ' rpm. Calculate N₂ (rpm).',
      answer: roundN(N2, 0), dp: 0, tol: 2, unit: 'rpm',
      explain: 'N₂ = N₁ × D₁/D₂ = ' + N1 + ' × ' + D1 + '/' + D2 + ' = ' + roundN(N2, 0) + ' rpm' };
  }
  function quizNumTR() {
    var mu = randInt(25, 40) / 100;
    var thetaDeg = randInt(150, 190);
    var thetaRad = thetaDeg * Math.PI / 180;
    var tr = Math.exp(mu * thetaRad);
    return { type: 'numeric',
      prompt: 'An open belt drive has μ = ' + mu.toFixed(2) + ' and wrap angle θ = ' + thetaDeg + '°. Calculate T₁/T₂ (2 dp).',
      answer: roundN(tr, 2), dp: 2, tol: 0.05, unit: ':1',
      explain: 'T₁/T₂ = e^(μθ) = e^(' + mu.toFixed(2) + '×' + roundN(thetaRad, 3) + ') = ' + roundN(tr, 2) };
  }
  function quizNumBeltSpeed() {
    var D1 = randInt(2, 6) * 50, N1 = randInt(4, 16) * 50;
    var v = Math.PI * (D1 / 1000) * N1 / 60;
    return { type: 'numeric',
      prompt: 'Find the belt speed (m/s) for D₁ = ' + D1 + ' mm, N₁ = ' + N1 + ' rpm (2 dp).',
      answer: roundN(v, 2), dp: 2, tol: 0.05, unit: 'm/s',
      explain: 'v = π×' + D1 + '×' + N1 + '/60000 = ' + roundN(v, 2) + ' m/s' };
  }
  function shuffleArr(arr) {
    var a = arr.slice();
    for (var i = a.length - 1; i > 0; i--) {
      var j = randInt(0, i); var tmp = a[i]; a[i] = a[j]; a[j] = tmp;
    }
    return a;
  }
  var quizState = { questions: [], current: 0, score: 0, answers: [], started: false };
  function resetQuiz() {
    quizState.started = false; quizState.current = 0; quizState.score = 0;
    quizState.answers = []; quizState.questions = [];
    $('#quiz-qnum').textContent = '1';
    $('#quiz-prompt').textContent = 'Press "Start Quiz" to begin a 5-question belt & chain drive quiz.';
    $('#quiz-feedback').textContent = ''; $('#quiz-feedback').className = 'quiz-feedback';
    hide($('#quiz-answers')); hide($('#quiz-num-row')); hide($('#quiz-next-btn'));
    show($('#quiz-start-btn')); hide($('#quiz-result')); show($('#quiz-panel'));
  }
  function buildQuizQuestions() {
    var mcqs = shuffleArr(MCQ_BANK).slice(0, 3);
    var numGens = [quizNumN2, quizNumTR, quizNumBeltSpeed];
    var nums = shuffleArr(numGens).slice(0, 2).map(function (fn) { return fn(); });
    return shuffleArr(mcqs.concat(nums));
  }
  function showQuizQuestion() {
    var q = quizState.questions[quizState.current];
    var fb = $('#quiz-feedback'); fb.textContent = ''; fb.className = 'quiz-feedback';
    hide($('#quiz-next-btn'));
    $('#quiz-qnum').textContent = quizState.current + 1;
    $('#quiz-prompt').textContent = q.prompt;
    if (q.type === 'mcq') {
      hide($('#quiz-num-row'));
      var grid = $('#quiz-answers'); grid.innerHTML = ''; show(grid);
      q.options.forEach(function (opt, idx) {
        var btn = document.createElement('button');
        btn.className = 'answer-btn'; btn.textContent = opt;
        btn.addEventListener('click', function () {
          if (btn.classList.contains('locked')) return;
          grid.querySelectorAll('.answer-btn').forEach(function (b) { b.classList.add('locked'); });
          var isCorrect = (idx === q.correct);
          if (isCorrect) {
            btn.classList.add('correct'); quizState.score++;
            fb.textContent = '✓ Correct! ' + (q.explain || ''); fb.className = 'quiz-feedback ok';
          } else {
            btn.classList.add('wrong');
            grid.querySelectorAll('.answer-btn')[q.correct].classList.add('correct');
            fb.textContent = '× Incorrect. ' + (q.explain || ''); fb.className = 'quiz-feedback err';
          }
          quizState.answers.push({ correct: isCorrect, prompt: q.prompt });
          show($('#quiz-next-btn'));
        });
        grid.appendChild(btn);
      });
    } else {
      hide($('#quiz-answers'));
      show($('#quiz-num-row'));
      $('#quiz-unit').textContent = q.unit || '';
      $('#quiz-input').value = ''; $('#quiz-input').focus();
    }
  }
  function submitNumericQuiz() {
    var q = quizState.questions[quizState.current];
    var raw = parseFloat($('#quiz-input').value);
    var fb  = $('#quiz-feedback');
    if (isNaN(raw)) { fb.textContent = 'Please enter a number.'; fb.className = 'quiz-feedback err'; return; }
    hide($('#quiz-num-row'));
    var isCorrect = Math.abs(raw - q.answer) <= q.tol + Math.abs(q.answer) * 0.02;
    if (isCorrect) {
      quizState.score++;
      fb.textContent = '✓ Correct! Answer: ' + q.answer + ' ' + (q.unit || ''); fb.className = 'quiz-feedback ok';
    } else {
      fb.textContent = '× Incorrect. Correct answer: ' + q.answer + ' ' + (q.unit || ''); fb.className = 'quiz-feedback err';
    }
    quizState.answers.push({ correct: isCorrect, prompt: q.prompt });
    show($('#quiz-next-btn'));
  }
  function advanceQuiz() {
    quizState.current++;
    if (quizState.current >= quizState.questions.length) showQuizResult();
    else showQuizQuestion();
  }
  function showQuizResult() {
    hide($('#quiz-panel')); hide($('#quiz-next-btn')); hide($('#quiz-start-btn'));
    var score = quizState.score, total = quizState.questions.length;
    var stars = score === 5 ? '★★★★★' : score === 4 ? '★★★★☆' : score === 3 ? '★★★☆☆' : score === 2 ? '★★☆☆☆' : '★☆☆☆☆';
    var cls = score === 5 ? 'perfect' : score >= 3 ? 'good' : 'poor';
    var verdict = score === 5 ? 'Excellent mastery of belt & chain drives!'
                : score >= 3 ? 'Good understanding — review the missed topics.'
                : 'Keep practising — revisit Explore mode for help.';
    var rowsHtml = quizState.answers.map(function (a, i) {
      var cls2 = a.correct ? 'ok' : 'err';
      var mark = a.correct ? '✓' : '×';
      var shortQ = a.prompt.length > 80 ? a.prompt.slice(0, 80) + '…' : a.prompt;
      return '<div class="qr-row ' + cls2 + '"><span class="qr-qnum">Q' + (i + 1) + '</span><span class="qr-detail">' + shortQ + '</span><span class="qr-mark">' + mark + '</span></div>';
    }).join('');
    var res = $('#quiz-result');
    res.innerHTML =
      '<div class="qr-header"><div class="qr-title-wrap"><span class="qr-title">Quiz Complete</span><span class="qr-stars">' + stars + '</span></div>' +
      '<div class="qr-score-wrap"><div class="qr-score ' + cls + '">' + score + '/' + total + '</div><div class="qr-verdict">' + verdict + '</div></div></div>' +
      '<div class="qr-rows">' + rowsHtml + '</div>' +
      '<button class="btn btn-primary" id="quiz-retry-btn">Try Again</button>';
    show(res);
    $('#quiz-retry-btn').addEventListener('click', function () { resetQuiz(); });
  }
  $('#quiz-start-btn').addEventListener('click', function () {
    hide($('#quiz-start-btn'));
    quizState.questions = buildQuizQuestions();
    quizState.current = 0; quizState.score = 0; quizState.answers = []; quizState.started = true;
    hide($('#quiz-result')); show($('#quiz-panel'));
    showQuizQuestion();
  });
  $('#quiz-next-btn').addEventListener('click', advanceQuiz);
  $('#quiz-submit-btn').addEventListener('click', submitNumericQuiz);
  $('#quiz-input').addEventListener('keydown', function (e) { if (e.key === 'Enter') submitNumericQuiz(); });

  /* ================================================================
     MODE SWITCHING
     ================================================================ */
  var SECTIONS = {
    simulate: $('#sim-mode'),
    explore:  $('#explore-mode'),
    practice: $('#practice-mode'),
    quiz:     $('#quiz-mode')
  };
  function setMode(m) {
    state.mode = m;
    Object.keys(SECTIONS).forEach(function (k) {
      SECTIONS[k].classList.toggle('hidden', k !== m);
    });
    $$('#mode-tabs .pill').forEach(function (p) {
      p.classList.toggle('active', p.dataset.value === m);
    });
    if (m === 'simulate') { startAnim(); }
    else { stopAnim(); }
    if (m === 'explore') renderExplore();
    if (m === 'quiz')    resetQuiz();
  }
  $$('#mode-tabs .pill').forEach(function (p) {
    p.addEventListener('click', function () { setMode(p.dataset.value); });
  });

  /* ================================================================
     INIT
     ================================================================ */
  wireSim();
  applyDriveTypeUI();
  resizeCanvas();
  window.addEventListener('resize', resizeCanvas);
  if (typeof ResizeObserver !== 'undefined') new ResizeObserver(resizeCanvas).observe(canvas);
  compute();
  setMode('simulate');

})();
