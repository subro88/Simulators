      prompt = 'A belt drive has driver pulley D₁ = ' + D1 + ' mm, driven pulley D₂ = ' + D2 + ' mm, and driver speed N₁ = ' + N1 + ' rpm. Calculate the driven shaft speed N₂ (rpm).';
      unit = 'rpm'; dp = 0; tol = 1; answer = N2;
      steps = ['VR = D₁/D₂ = ' + D1 + '/' + D2 + ' = ' + roundN(VR, 3),
               'N₂ = N₁ × VR = ' + N1 + ' × ' + roundN(VR, 3) + ' = ' + roundN(N2, 0) + ' rpm'];
    } else if (type === 2) {
      var D1b = randInt(1, 6) * 50, N1b = randInt(2, 20) * 50;
      var v = Math.PI * (D1b / 1000) * N1b / 60;
      prompt = 'Calculate the belt speed (m/s) for a drive with driver pulley diameter D₁ = ' + D1b + ' mm running at N₁ = ' + N1b + ' rpm.';
      unit = 'm/s'; dp = 2; tol = 0.05; answer = roundN(v, 2);
      steps = ['v = π × D₁ × N₁ / 60000',
               'v = π × ' + D1b + ' × ' + N1b + ' / 60000',
               'v = ' + roundN(v, 3) + ' m/s'];
    } else if (type === 3) {
      var muVal = randInt(20, 45) / 100;
      var thetaDeg = randFloat(140, 200, 1);
      var thetaRad = thetaDeg * Math.PI / 180;
      var tr = Math.exp(muVal * thetaRad);
      prompt = 'A flat belt drive has a coefficient of friction μ = ' + muVal.toFixed(2) + ' and an angle of wrap θ = ' + thetaDeg.toFixed(1) + '°. Calculate the tension ratio T₁/T₂ using the capstan equation.';
      unit = ':1'; dp = 2; tol = 0.05; answer = roundN(tr, 2);
      steps = ['θ = ' + thetaDeg.toFixed(1) + '° = ' + roundN(thetaRad, 4) + ' rad',
               'T₁/T₂ = e^(μθ) = e^(' + muVal.toFixed(2) + ' × ' + roundN(thetaRad, 4) + ')',
               'T₁/T₂ = e^' + roundN(muVal * thetaRad, 4) + ' = ' + roundN(tr, 2)];
    } else {
      var T1v = randInt(5, 50) * 100;
      var D1c = randInt(1, 6) * 50;
      var N1c = randInt(2, 20) * 50;
      var muVal2 = randInt(20, 40) / 100;
      var thetaRad2 = Math.PI - 2 * Math.asin(clamp(25 / 600, -0.999, 0.999));
      var tr2 = Math.exp(muVal2 * thetaRad2);
      var T2v = T1v / tr2;
      var v2 = Math.PI * (D1c / 1000) * N1c / 60;
      var P = (T1v - T2v) * v2 / 1000;
      prompt = 'A belt drive transmits power with tight side tension T₁ = ' + T1v + ' N, driver pulley D₁ = ' + D1c + ' mm, N₁ = ' + N1c + ' rpm, and μ = ' + muVal2.toFixed(2) + ' with θ = ' + roundN(thetaRad2 * 180 / Math.PI, 1) + '°. Find the power transmitted (kW).';
