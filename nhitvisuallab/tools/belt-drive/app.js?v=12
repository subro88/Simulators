(function () {
  'use strict';

  /* ================================================================
     HELPERS
     ================================================================ */
  function $(s) { return document.querySelector(s); }
  function $$(s) { return document.querySelectorAll(s); }
  function show(el) { if (el) el.style.display = ''; }
  function hide(el) { if (el) el.style.display = 'none'; }
  function randInt(a, b) { return a + Math.floor(Math.random() * (b - a + 1)); }
  function randFloat(a, b, dp) {
    var v = a + Math.random() * (b - a);
    return parseFloat(v.toFixed(dp || 0));
  }
  function roundN(v, n) { var f = Math.pow(10, n); return Math.round(v * f) / f; }
  function clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); }
  function fmt(v, dp) { if (!isFinite(v)) return '—'; return Number(v).toFixed(dp == null ? 2 : dp); }

  /* ================================================================
     UNITS — internal SI throughout; display-only conversion
     ================================================================ */
  var units = 'si';                          /* 'si' | 'imp' */
  function isImp() { return units === 'imp'; }
  var MM_TO_IN = 0.0393700787;
  var M_TO_FT  = 3.28083990;
  var N_TO_LBF = 0.22480894;
  var KW_TO_HP = 1.34102209;
  function U() {
    var imp = isImp();
    return {
      len:    { fromMM:  function (mm)  { return imp ? mm * MM_TO_IN : mm; },           label: imp ? 'in'  : 'mm',  dp: imp ? 2 : 0 },
      spd:    { fromMS:  function (ms)  { return imp ? ms * M_TO_FT  : ms; },           label: imp ? 'ft/s': 'm/s', dp: 2 },
      force:  { fromN:   function (n)   { return imp ? n * N_TO_LBF : n; },             label: imp ? 'lbf' : 'N',   dp: imp ? 1 : 0 },
      power:  { fromKW:  function (kw)  { return imp ? kw * KW_TO_HP : kw; },           label: imp ? 'hp'  : 'kW',  dp: 2 }
    };
  }

  /* ================================================================
     DOM REFS
     ================================================================ */
  var canvas   = $('#sim-canvas');
  var ctx      = canvas.getContext('2d');

  var slD1     = $('#sl-d1');  var inD1   = $('#in-d1');  var valD1  = $('#val-d1');
  var slD2     = $('#sl-d2');  var inD2   = $('#in-d2');  var valD2  = $('#val-d2');
  var slN1     = $('#sl-n1');  var inN1   = $('#in-n1');  var valN1  = $('#val-n1');
  var slC      = $('#sl-c');   var inC    = $('#in-c');   var valC   = $('#val-c');
  var slMu     = $('#sl-mu');  var inMu   = $('#in-mu');  var valMu  = $('#val-mu');
  var slT1     = $('#sl-t1');  var inT1   = $('#in-t1');  var valT1  = $('#val-t1');
  var slSlip   = $('#sl-slip');var inSlip = $('#in-slip');var valSlip= $('#val-slip');

  var rbVR     = $('#rb-vr');
  var rbN2     = $('#rb-n2');
  var rbV      = $('#rb-v');
  var rbTheta  = $('#rb-theta');
  var rbTR     = $('#rb-tr');
  var rbPow    = $('#rb-pow');
  var rbL      = $('#rb-l');

  var simMode      = $('#sim-mode');
  var exploreMode  = $('#explore-mode');
  var practiceMode = $('#practice-mode');
  var quizMode     = $('#quiz-mode');

  /* ================================================================
     STATE
     ================================================================ */
  var state = {
    mode:      'simulate',
    driveType: 'open',
    D1: 300, D2: 150, C: 600, N1: 600, mu: 0.30, T1: 2000, slip: 0,
    offset:    0,
    angle1:    0,
    angle2:    0,
    rafId:     null,
    showEquation:   true,
    showDimensions: true,
    showGrid:       false,
    showIdler:      false,
    computed:  {}
  };

  /* ================================================================
     COMPUTE
     ================================================================ */
  function compute() {
    var D1 = state.D1, D2 = state.D2, N1 = state.N1, mu = state.mu, T1 = state.T1, C = state.C, slip = state.slip;
    var PI = Math.PI;

    var VR  = D1 / D2;
    var N2id = N1 * D1 / D2;
    /* Chain = positive engagement: slip cannot apply even if a stale
       slider value remains in state from a previous belt configuration. */
    var slipEff = (state.driveType === 'chain') ? 0 : slip;
    var N2  = N2id * (1 - slipEff / 100);
    var v   = PI * (D1 / 1000) * N1 / 60;                       // m/s (driver pitch line)

    /* Per-pulley wrap angles. Signed α = asin((R1−R2)/C) gives
       θ_driver = π + 2α and θ_driven = π − 2α for BOTH size orderings;
       the capstan equation is governed by the smaller wrap of the two. */
    var R1 = D1 / 2, R2 = D2 / 2;
    var theta, theta1, theta2;
    if (state.driveType === 'crossed') {
      var sinB = clamp((R1 + R2) / C, -0.999, 0.999);
      theta1 = theta2 = theta = PI + 2 * Math.asin(sinB);
    } else {
      var sinA = clamp((R1 - R2) / C, -0.999, 0.999);
      var alphaS = Math.asin(sinA);
      theta1 = PI + 2 * alphaS;
      theta2 = PI - 2 * alphaS;
      theta  = Math.min(theta1, theta2);              // governing (smaller pulley)
    }

    /* Tension ratio & power */
    var tensionRatio, T2, P;
    if (state.driveType === 'chain') {
      // Chain — positive engagement. Slack ≈ 0; useful tension ≈ T1.
      // Avoid using the capstan equation entirely.
      tensionRatio = null;       // not applicable
      T2 = 0;
      P  = T1 * v / 1000;        // kW
    } else {
      tensionRatio = Math.exp(mu * theta);
      T2  = T1 / tensionRatio;
      P   = (T1 - T2) * v / 1000;
    }

    /* Belt length */
    var L;
    if (state.driveType === 'crossed') {
      L = 2 * C + PI * (D1 + D2) / 2 + Math.pow(D1 + D2, 2) / (4 * C);
    } else {
      L = 2 * C + PI * (D1 + D2) / 2 + Math.pow(D1 - D2, 2) / (4 * C);
    }

    /* Geometric validity — pulleys must not overlap: C > R1 + R2
       (the old |R1−R2| < C check wrongly accepted overlapping pulleys
       for open/chain drives). */
    var valid = (R1 + R2) < C;

    state.computed = {
      VR: VR, N2id: N2id, N2: N2, v: v,
      theta: theta, theta1: theta1, theta2: theta2,
      tensionRatio: tensionRatio, T1: T1, T2: T2, P: P,
      L: L, valid: valid, R1: R1, R2: R2, C: C
    };
    return state.computed;
  }

  /* ================================================================
     UPDATE READOUT BADGES
     ================================================================ */
  function updateReadouts() {
    var c = state.computed;
    var u = U();
    rbVR.textContent    = c.VR.toFixed(2);
    rbN2.textContent    = roundN(c.N2, 0) + ' rpm';
    rbV.textContent     = fmt(u.spd.fromMS(c.v), 2) + ' ' + u.spd.label;
    rbTheta.textContent = (c.theta * 180 / Math.PI).toFixed(1) + '°';
    if (state.driveType === 'chain') {
      rbTR.textContent = 'positive';
    } else {
      rbTR.textContent = c.tensionRatio.toFixed(2) + ':1';
    }
    rbPow.textContent   = fmt(u.power.fromKW(c.P), 2) + ' ' + u.power.label;
    if (rbL) rbL.textContent = fmt(u.len.fromMM(c.L), u.len.dp) + ' ' + u.len.label;

    updateLearnPanels(c);
  }

  /* ================================================================
     RESPONSIVE CANVAS (DPR-aware)
     ================================================================ */
  var W = 800, H = 400;                /* logical coords */
  function resizeCanvas() {
    var dpr = window.devicePixelRatio || 1;
    var rect = canvas.getBoundingClientRect();
    var cssW = rect.width  || W;
    var targetH = cssW * (H / W);
    canvas.style.height = targetH + 'px';
    canvas.width  = Math.round(cssW * dpr);
    canvas.height = Math.round(targetH * dpr);
    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.scale(canvas.width / W, canvas.height / H);
    if ('textRendering' in ctx) ctx.textRendering = 'geometricPrecision';
    ctx.imageSmoothingQuality = 'high';
    if (state.computed && state.computed.VR != null) draw();
  }

  /* ================================================================
     DRAW — true-geometry layout (canvas matches real C/D1/D2)
     ================================================================ */
  function computeLayout() {
    /* Fit (R1 + C + R2) horizontally and (max(D1,D2)) vertically. */
    var margin = 60;
    var availW = W - 2 * margin;
    var availH = H - 110;            /* leave room for labels + header */
    var totalMM_W = state.C + state.R1Or() + state.R2Or();
    var maxD = Math.max(state.D1, state.D2);
    var scale = Math.min(availW / totalMM_W, availH / maxD);
    var totalPx = totalMM_W * scale;
    var leftPx = (W - totalPx) / 2;
    var R1px = (state.D1 / 2) * scale;
    var R2px = (state.D2 / 2) * scale;
    var Cpx  = state.C * scale;
    var cx1 = leftPx + R1px;
    var cx2 = cx1 + Cpx;
    var cy  = H / 2 - 10;
    return { scale: scale, R1px: R1px, R2px: R2px, Cpx: Cpx, cx1: cx1, cx2: cx2, cy: cy };
  }
  state.R1Or = function () { return state.D1 / 2; };
  state.R2Or = function () { return state.D2 / 2; };

  function drawSpokes(ctx, cx, cy, r, nSpokes, angle, color) {
    if (r < 12) return;
    ctx.strokeStyle = color;
    ctx.lineWidth   = 2;
    for (var i = 0; i < nSpokes; i++) {
      var a = angle + (i / nSpokes) * Math.PI * 2;
      ctx.beginPath();
      ctx.moveTo(cx + Math.cos(a) * 4, cy + Math.sin(a) * 4);
      ctx.lineTo(cx + Math.cos(a) * (r - 4), cy + Math.sin(a) * (r - 4));
      ctx.stroke();
    }
  }

  function drawArrowHead(ctx, x, y, angle, color) {
    ctx.save();
    ctx.translate(x, y);
    ctx.rotate(angle);
    ctx.fillStyle = color;
    ctx.beginPath();
    ctx.moveTo(8, 0);
    ctx.lineTo(-5, 5);
    ctx.lineTo(-5, -5);
    ctx.closePath();
    ctx.fill();
    ctx.restore();
  }

  function drawChain(ctx, x1, y1, x2, y2, offset) {
    var dx   = x2 - x1, dy = y2 - y1;
    var len  = Math.sqrt(dx * dx + dy * dy);
    if (len < 1) return;
    var ux   = dx / len, uy = dy / len;
    var linkLen = 18, gap = 5;
    var period  = linkLen + gap;
    /* Links advance from (x1,y1) toward (x2,y2) as offset grows, so a
       span drawn in the belt-travel direction animates the right way. */
    var start   = ((offset % period) + period) % period;
    ctx.save();
    ctx.strokeStyle = '#795548';
    ctx.lineWidth   = 6;
    ctx.lineCap     = 'butt';
    var pos = start - period;
    while (pos < len) {
      var s = Math.max(0, pos);
      var e = Math.min(len, pos + linkLen);
      if (e > s) {
        ctx.beginPath();
        ctx.moveTo(x1 + ux * s, y1 + uy * s);
        ctx.lineTo(x1 + ux * e, y1 + uy * e);
        ctx.stroke();
      }
      pos += period;
    }
    ctx.restore();
  }

  function drawGrid() {
    ctx.save();
    ctx.strokeStyle = 'rgba(139,157,195,0.08)';
    ctx.lineWidth = 1;
    var step = 40;
    for (var x = 0; x <= W; x += step) {
      ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, H); ctx.stroke();
    }
    for (var y = 0; y <= H; y += step) {
      ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(W, y); ctx.stroke();
    }
    ctx.restore();
  }

  function drawDimensionLine(x1, x2, y, label, color) {
    ctx.save();
    ctx.strokeStyle = color || '#8b9dc3';
    ctx.fillStyle   = color || '#8b9dc3';
    ctx.lineWidth = 1;
    ctx.setLineDash([3, 3]);
    ctx.beginPath(); ctx.moveTo(x1, y); ctx.lineTo(x2, y); ctx.stroke();
    ctx.setLineDash([]);
    // ticks
    ctx.beginPath();
    ctx.moveTo(x1, y - 4); ctx.lineTo(x1, y + 4);
    ctx.moveTo(x2, y - 4); ctx.lineTo(x2, y + 4);
    ctx.stroke();
    ctx.font = '10px Segoe UI, sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'bottom';
    var mid = (x1 + x2) / 2;
    var pad = 3;
    var tw = ctx.measureText(label).width + 8;
    ctx.fillStyle = '#0d1117';
    ctx.fillRect(mid - tw / 2, y - 14, tw, 12);
    ctx.fillStyle = color || '#8b9dc3';
    ctx.fillText(label, mid, y - pad);
    ctx.restore();
  }

  function drawHaloText(text, x, y, font, fillColor, align) {
    ctx.font = font;
    ctx.textAlign = align || 'center';
    ctx.textBaseline = 'middle';
    ctx.lineWidth = 3;
    ctx.strokeStyle = 'rgba(13,17,30,0.85)';
    ctx.strokeText(text, x, y);
    ctx.fillStyle = fillColor;
    ctx.fillText(text, x, y);
  }

  function draw() {
    var L    = computeLayout();
    var PI   = Math.PI;
    var c    = state.computed;
    var dt   = state.driveType;
    var R1px = L.R1px, R2px = L.R2px, cx1 = L.cx1, cx2 = L.cx2, cy = L.cy, Cpx = L.Cpx;

    /* Clear */
    ctx.fillStyle = '#0d1117';
    ctx.fillRect(0, 0, W, H);

    if (state.showGrid) drawGrid();

    /* Invalid configuration warning */
    if (!c.valid) {
      ctx.fillStyle = '#ff5555';
      ctx.font = 'bold 14px Segoe UI, sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('Invalid geometry: pulleys overlap. Increase centre distance C.', W / 2, H / 2);
      return;
    }

    /* ── Belt / Chain ──────────────────────────────────────── */
    var beltColor  = '#795548';
    var beltWidth  = (dt === 'chain') ? 9 : 7;

    ctx.save();
    ctx.strokeStyle = beltColor;
    ctx.lineWidth   = beltWidth;
    ctx.lineCap     = 'round';

    if (dt === 'open' || dt === 'chain') {
      /* Geometry: external tangent. Contact normal n̂ satisfies
         C·nx = R1 − R2, so nx = +sin α on BOTH spans (upper span
         previously used −sin α, which drew a secant, not a tangent). */
      var dR = R1px - R2px;
      var alpha = Math.asin(clamp(dR / Cpx, -0.999, 0.999));
      var sinA = Math.sin(alpha), cosA = Math.cos(alpha);

      var ux1 = cx1 + R1px * sinA, uy1 = cy - R1px * cosA;
      var ux2 = cx2 + R2px * sinA, uy2 = cy - R2px * cosA;
      var lx1 = cx1 + R1px * sinA, ly1 = cy + R1px * cosA;
      var lx2 = cx2 + R2px * sinA, ly2 = cy + R2px * cosA;

      /* Optional idler pulley on slack (lower) side — open belt only.
         The idler is mounted OUTSIDE the belt loop (below the slack belt)
         and its TOP intrudes upward into the belt path, pushing the slack
         belt INWARD (toward the tight belt). The slack belt deflects
         UP and wraps the TOP of the idler. Visual only: no effect on
         calculations. */
      var idler = null;
      if (state.showIdler && dt === 'open') {
        var IDLER_R_MM = 40;                            /* idler radius (~80 mm dia) */
        var IDLER_DEFLECT_MM = 35;                      /* how far belt is pushed UP */
        var Ri = Math.max(12, IDLER_R_MM * L.scale);
        var midLx = (lx1 + lx2) / 2;
        var midLy = (ly1 + ly2) / 2;
        /* Place idler so its upper-left contact (angle 240°) sits IDLER_DEFLECT_MM
           above the natural slack line, while the centre stays BELOW the
           slack line — so the body of the idler is outside the belt loop. */
        var deflPx = IDLER_DEFLECT_MM * L.scale;
        var xi = midLx;
        var yi = midLy - deflPx + 0.866 * Ri;
        idler = { x: xi, y: yi, r: Ri };
      }

      /* Belt travel convention: driver rotates clockwise (canvas),
         top span moves driver→driven, bottom span driven→driver.
         Every span is drawn in the travel direction with
         lineDashOffset = −offset so dashes march WITH the belt. */
      if (dt === 'chain') {
        drawChain(ctx, ux1, uy1, ux2, uy2, state.offset);
        drawChain(ctx, lx2, ly2, lx1, ly1, state.offset);
      } else {
        /* Upper belt — straight tangent (always) */
        ctx.setLineDash([10, 6]);
        ctx.lineDashOffset = -state.offset;
        ctx.beginPath(); ctx.moveTo(ux1, uy1); ctx.lineTo(ux2, uy2); ctx.stroke();

        if (idler) {
          /* Slack belt deflected UP and wraps the TOP of the idler.
             Idler body is BELOW the slack belt line (outside the loop);
             only its top intrudes upward to push the belt inward.
             Travel order (driven→driver): P2 → idler upper-right →
             top arc → idler upper-left → P1. Purely visual. */
          var leftAng  = 4 * Math.PI / 3;  /* 240° from idler centre = upper-left  */
          var rightAng = 5 * Math.PI / 3;  /* 300° from idler centre = upper-right */
          var ipL = { x: idler.x + idler.r * Math.cos(leftAng),  y: idler.y + idler.r * Math.sin(leftAng)  };
          var ipR = { x: idler.x + idler.r * Math.cos(rightAng), y: idler.y + idler.r * Math.sin(rightAng) };

          /* P2 -> idler upper-right (belt rises, travelling left) */
          ctx.beginPath(); ctx.moveTo(lx2, ly2); ctx.lineTo(ipR.x, ipR.y); ctx.stroke();
          /* idler upper-left -> P1 (belt drops back) */
          ctx.beginPath(); ctx.moveTo(ipL.x, ipL.y); ctx.lineTo(lx1, ly1); ctx.stroke();
          /* Short top arc on idler (through 270° = canvas-up) */
          ctx.setLineDash([]);
          ctx.beginPath();
          ctx.arc(idler.x, idler.y, idler.r, leftAng, rightAng, false);
          ctx.stroke();
          ctx.setLineDash([10, 6]);
        } else {
          ctx.beginPath(); ctx.moveTo(lx2, ly2); ctx.lineTo(lx1, ly1); ctx.stroke();
        }
        ctx.setLineDash([]);
      }

      /* Contact angles (canvas frame): upper tangent touches both pulleys
         at α − π/2, lower at π/2 − α. Driver wraps its OUTER (left) arc,
         measure π + 2α; driven wraps its outer (right) arc, π − 2α. */
      ctx.beginPath();
      ctx.arc(cx1, cy, R1px, PI / 2 - alpha, alpha - PI / 2, false);
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(cx2, cy, R2px, alpha - PI / 2, PI / 2 - alpha, false);
      ctx.stroke();

      // Direction arrows
      drawArrowHead(ctx, (ux1 + ux2) / 2, (uy1 + uy2) / 2,
        Math.atan2(uy2 - uy1, ux2 - ux1), '#f5c842');
      if (idler) {
        drawArrowHead(ctx, (lx2 + idler.x) / 2, (ly2 + idler.y - idler.r) / 2,
          Math.atan2(ly1 - ly2, lx1 - lx2), '#f5c842');
      } else {
        drawArrowHead(ctx, (lx1 + lx2) / 2, (ly1 + ly2) / 2,
          Math.atan2(ly1 - ly2, lx1 - lx2), '#f5c842');
      }

      // Governing wrap-angle highlight — drawn on the SMALLER pulley over
      // its true contact arc (was: fixed 180° arc on the driven pulley's
      // non-contact side, regardless of geometry).
      if (state.showDimensions) {
        ctx.save();
        ctx.strokeStyle = 'rgba(41,182,246,0.55)';
        ctx.lineWidth = 4;
        ctx.beginPath();
        if (R1px <= R2px) {
          ctx.arc(cx1, cy, R1px + 7, PI / 2 - alpha, alpha - PI / 2, false);
        } else {
          ctx.arc(cx2, cy, R2px + 7, alpha - PI / 2, PI / 2 - alpha, false);
        }
        ctx.stroke();
        ctx.restore();
      }

      /* Draw the idler pulley on top of the belt path */
      if (idler) {
        ctx.beginPath(); ctx.arc(idler.x, idler.y, idler.r, 0, Math.PI * 2);
        ctx.fillStyle = '#1f2535'; ctx.fill();
        ctx.strokeStyle = '#8d6e63'; ctx.lineWidth = 2.5; ctx.stroke();
        /* Idler rolls on the return belt (moving left over its top),
           so it spins CCW at exactly beltSpeed / r — offset IS belt
           arc-length in px, giving true rolling contact. */
        drawSpokes(ctx, idler.x, idler.y, idler.r, 3, -state.offset / idler.r, '#8d6e63');
        ctx.beginPath(); ctx.arc(idler.x, idler.y, 3, 0, Math.PI * 2);
        ctx.fillStyle = '#8d6e63'; ctx.fill();
        ctx.font = 'bold 10px Segoe UI, sans-serif';
        ctx.fillStyle = '#8d6e63';
        ctx.textAlign = 'center';
        ctx.fillText('Idler pulley', idler.x, idler.y + idler.r + 14);
      }

    } else {
      /* Crossed */
      var beta = Math.asin(clamp((R1px + R2px) / Cpx, -0.999, 0.999));
      var sinB = Math.sin(beta), cosB = Math.cos(beta);

      var ux1c = cx1 + R1px * sinB, uy1c = cy - R1px * cosB;
      var ux2c = cx2 - R2px * sinB, uy2c = cy + R2px * cosB;
      var lx1c = cx1 + R1px * sinB, ly1c = cy + R1px * cosB;
      var lx2c = cx2 - R2px * sinB, ly2c = cy - R2px * cosB;

      /* Both spans drawn in belt-travel direction; −offset marches the
         dashes with the belt (the return span previously animated
         backwards, toward the driven pulley). */
      ctx.setLineDash([10, 6]);
      ctx.lineDashOffset = -state.offset;
      ctx.beginPath(); ctx.moveTo(ux1c, uy1c); ctx.lineTo(ux2c, uy2c); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(lx2c, ly2c); ctx.lineTo(lx1c, ly1c); ctx.stroke();
      ctx.setLineDash([]);

      // Driver arc (left side, CCW)
      ctx.beginPath();
      ctx.arc(cx1, cy, R1px, beta - PI / 2, PI / 2 - beta, true);
      ctx.stroke();
      // Driven arc (right side, CW)
      ctx.beginPath();
      ctx.arc(cx2, cy, R2px, -(PI / 2 + beta), PI / 2 + beta, false);
      ctx.stroke();

      // Cross marker
      var crossX = (ux1c + ux2c) / 2;
      var crossY = (uy1c + uy2c) / 2;
      drawHaloText('×', crossX, crossY, 'bold 14px Segoe UI', '#bcaaa4');

      drawArrowHead(ctx, crossX, crossY,
        Math.atan2(uy2c - uy1c, ux2c - ux1c), '#f5c842');
      drawArrowHead(ctx, (lx1c + lx2c) / 2, (ly1c + ly2c) / 2,
        Math.atan2(ly1c - ly2c, lx1c - lx2c), '#f5c842');
    }
    ctx.restore();

    /* ── Driver pulley ───────────────────────────────────── */
    ctx.beginPath(); ctx.arc(cx1, cy, R1px, 0, Math.PI * 2);
    ctx.fillStyle = '#1f2535'; ctx.fill();
    ctx.strokeStyle = '#795548'; ctx.lineWidth = 3; ctx.stroke();
    drawSpokes(ctx, cx1, cy, R1px, 4, state.angle1, '#795548');
    ctx.beginPath(); ctx.arc(cx1, cy, 4, 0, Math.PI * 2);
    ctx.fillStyle = '#795548'; ctx.fill();

    /* ── Driven pulley ───────────────────────────────────── */
    ctx.beginPath(); ctx.arc(cx2, cy, R2px, 0, Math.PI * 2);
    ctx.fillStyle = '#1f2535'; ctx.fill();
    ctx.strokeStyle = '#4fc3f7'; ctx.lineWidth = 3; ctx.stroke();
    drawSpokes(ctx, cx2, cy, R2px, 4, state.angle2, '#4fc3f7');
    ctx.beginPath(); ctx.arc(cx2, cy, 4, 0, Math.PI * 2);
    ctx.fillStyle = '#4fc3f7'; ctx.fill();

    /* ── Labels ──────────────────────────────────────────── */
    var u = U();
    ctx.font = 'bold 12px Segoe UI, system-ui, sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'alphabetic';

    ctx.fillStyle = '#795548';
    ctx.fillText('DRIVER', cx1, cy + R1px + 18);
    ctx.fillStyle = '#dde3f0';
    ctx.font = '10.5px Courier New, monospace';
    ctx.fillText(roundN(state.N1, 0) + ' rpm', cx1, cy + R1px + 32);

    ctx.font = 'bold 12px Segoe UI, system-ui, sans-serif';
    ctx.fillStyle = '#4fc3f7';
    ctx.fillText('DRIVEN', cx2, cy + R2px + 18);
    ctx.fillStyle = '#dde3f0';
    ctx.font = '10.5px Courier New, monospace';
    ctx.fillText(roundN(c.N2, 0) + ' rpm', cx2, cy + R2px + 32);

    // Header label
    ctx.font = 'bold 12px Segoe UI, sans-serif';
    ctx.fillStyle = '#bcaaa4';
    var driveLabel = (dt === 'open') ? 'Open Belt' : (dt === 'crossed') ? 'Crossed Belt' : 'Chain Drive';
    ctx.fillText(driveLabel + '   |   VR = ' + c.VR.toFixed(2), W / 2, 18);

    // Diameter labels inside pulleys
    if (R1px > 22) {
      ctx.font = 'bold 10px Courier New, monospace';
      ctx.fillStyle = '#6b7a99';
      ctx.fillText(fmt(u.len.fromMM(state.D1), u.len.dp) + u.len.label, cx1, cy + 3);
    }
    if (R2px > 18) {
      ctx.font = 'bold 10px Courier New, monospace';
      ctx.fillStyle = '#6b7a99';
      ctx.fillText(fmt(u.len.fromMM(state.D2), u.len.dp) + u.len.label, cx2, cy + 3);
    }

    /* ── Dimension lines ─────────────────────────────────── */
    if (state.showDimensions) {
      var dy = H - 20;
      drawDimensionLine(cx1, cx2, dy,
        'C = ' + fmt(u.len.fromMM(state.C), u.len.dp) + ' ' + u.len.label, '#8b9dc3');
    }

    /* ── On-canvas equation overlay ──────────────────────── */
    if (state.showEquation) drawEquationOverlay();
  }

  function drawEquationOverlay() {
    var c = state.computed;
    var u = U();
    var y = 38;
    var x = W / 2;
    /* Choose equation by drive type */
    if (state.driveType === 'chain') {
      drawHaloText('VR = T₁/T₂ = ' + c.VR.toFixed(2) + '   (positive engagement, no slip)',
        x, y, 'italic 13px "Cambria Math", "Times New Roman", serif', '#3ddc84');
    } else {
      var trTxt = c.tensionRatio.toFixed(2);
      drawHaloText('T₁/T₂ = e^(μθ) = e^(' + state.mu.toFixed(2) + ' × ' + (c.theta).toFixed(3) + ') = ' + trTxt,
        x, y, 'italic 13px "Cambria Math", "Times New Roman", serif', '#ff8a65');
    }
    /* Power */
    drawHaloText('P = (T₁ − T₂) · v = ' + fmt(u.power.fromKW(c.P), 2) + ' ' + u.power.label,
      x, y + 18, 'italic 12px "Cambria Math", "Times New Roman", serif', '#f5c842');
  }

  /* ================================================================
     ANIMATION LOOP
     ================================================================ */
  /* Slow-motion factor: display speed = TIME_SCALE × real speed, so
     600 rpm spins at a followable ~15 rpm on screen. All display speeds
     (driver, driven, belt offset) share it, so their RATIOS stay exact:
     the belt matches the driver rim speed (v = πD₁N₁/60 at the pitch
     line) and the driven pulley visibly lags by the slip percentage. */
  var TIME_SCALE = 0.025;
  var lastTs = null;
  function loop(ts) {
    compute();
    var c = state.computed;

    var dt = 0.016;                                   /* seconds */
    if (ts != null && lastTs != null) dt = clamp((ts - lastTs) / 1000, 0.001, 0.05);
    if (ts != null) lastTs = ts;

    var omega1 = state.N1 * Math.PI / 30 * TIME_SCALE;   /* display rad/s */
    var omega2 = c.N2   * Math.PI / 30 * TIME_SCALE;
    var drivenDir = (state.driveType === 'crossed') ? -1 : 1;
    var lay = computeLayout();

    state.angle1 += omega1 * dt;
    state.angle2 += drivenDir * omega2 * dt;
    state.offset += omega1 * lay.R1px * dt;           /* belt arc-length, px */
    if (state.offset > 1e6) state.offset -= 1e6;

    draw();
    updateReadouts();
    state.rafId = requestAnimationFrame(loop);
  }

  function startAnim() {
    if (state.rafId) cancelAnimationFrame(state.rafId);
    lastTs = null;
    state.rafId = requestAnimationFrame(loop);
  }
  function stopAnim() {
    if (state.rafId) { cancelAnimationFrame(state.rafId); state.rafId = null; }
  }

  /* ================================================================
     STEPPER + SLIDER PAIRS
     ================================================================ */
  /* Unit-aware bind. State is ALWAYS stored in SI internally.
       opts: {
         min, max, step             — SI range (slider attributes)
         toDisp(si)  → display num  — convert SI→display (optional)
         fromDisp(d) → si num       — convert display→SI (optional)
         dispDp()   → digits        — decimals for display (optional, defaults dp)
         dispStep() → step          — input step in display (optional)
         unitLabel() → string       — unit suffix for val label (e.g. "mm"|"in"|"")
         dp                         — fallback decimals (SI)
         onChange(si)               — store SI value
       }
  */
  function bindPair(slider, input, valEl, opts) {
    function apply(si) {
      si = clamp(si, opts.min, opts.max);
      slider.value = si;
      var dv = opts.toDisp ? opts.toDisp(si) : si;
      var dp = opts.dispDp ? opts.dispDp() : (opts.dp != null ? opts.dp : 0);
      if (input) {
        input.value = (+dv).toFixed(dp);
        if (opts.toDisp) {
          input.min  = (+opts.toDisp(opts.min)).toFixed(dp);
          input.max  = (+opts.toDisp(opts.max)).toFixed(dp);
          input.step = opts.dispStep ? opts.dispStep() : opts.step;
        }
      }
      if (valEl) {
        var lbl = opts.unitLabel ? opts.unitLabel() : '';
        valEl.textContent = (+dv).toFixed(dp) + (lbl ? ' ' + lbl : '');
      }
      opts.onChange(si);
    }
    slider.addEventListener('input', function () { apply(+slider.value); });
    if (input) {
      input.addEventListener('change', function () {
        var dv = parseFloat(input.value);
        if (isFinite(dv)) {
          var si = opts.fromDisp ? opts.fromDisp(dv) : dv;
          apply(si);
        }
      });
      input.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') { input.blur(); }
      });
    }
    return apply;
  }

  var setD1, setD2, setN1, setC, setMu, setT1, setSlip;

  function wireSim() {
    /* Length sliders — convert mm ↔ in */
    var lenOpts = function (storeKey) { return {
      toDisp:  function (si) { return isImp() ? si * MM_TO_IN : si; },
      fromDisp:function (d)  { return isImp() ? d  / MM_TO_IN : d;  },
      dispDp:  function () { return isImp() ? 2 : 0; },
      dispStep:function () { return isImp() ? 0.1 : 5; },
      unitLabel:function () { return isImp() ? 'in' : 'mm'; },
      onChange: function (si) { state[storeKey] = +si; }
    }; };
    setD1 = bindPair(slD1, inD1, valD1, Object.assign({ min:  80, max:  400, step: 5  }, lenOpts('D1')));
    setD2 = bindPair(slD2, inD2, valD2, Object.assign({ min:  80, max:  400, step: 5  }, lenOpts('D2')));
    setC  = bindPair(slC,  inC,  valC,  Object.assign({ min: 200, max: 1500, step: 10 }, lenOpts('C')));

    setN1 = bindPair(slN1, inN1, valN1, {
      min: 50, max: 3000, step: 10, dp: 0,
      unitLabel: function () { return 'rpm'; },
      onChange: function (v) { state.N1 = +v; }
    });
    setMu = bindPair(slMu, inMu, valMu, {
      min: 0.10, max: 0.60, step: 0.01, dp: 2,
      unitLabel: function () { return ''; },
      onChange: function (v) { state.mu = +v; }
    });
    setT1 = bindPair(slT1, inT1, valT1, {
      min: 200, max: 8000, step: 50,
      toDisp:   function (si) { return isImp() ? si * N_TO_LBF : si; },
      fromDisp: function (d)  { return isImp() ? d  / N_TO_LBF : d;  },
      dispDp:   function () { return isImp() ? 1 : 0; },
      dispStep: function () { return isImp() ? 10 : 50; },
      unitLabel:function () { return isImp() ? 'lbf' : 'N'; },
      onChange: function (v) { state.T1 = +v; }
    });
    setSlip = bindPair(slSlip, inSlip, valSlip, {
      min: 0, max: 10, step: 0.1, dp: 1,
      unitLabel: function () { return '%'; },
      onChange: function (v) { state.slip = +v; }
    });

    /* Drive type buttons */
    $$('#drive-type-btns .preset-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        $$('#drive-type-btns .preset-btn').forEach(function (b) { b.classList.remove('active'); });
        btn.classList.add('active');
        state.driveType = btn.dataset.drive;
        applyDriveTypeUI();
      });
    });

    /* Toggle checkboxes */
    var ce = $('#chk-equation');
    if (ce) ce.addEventListener('change', function () { state.showEquation = ce.checked; });
    var cd = $('#chk-dim');
    if (cd) cd.addEventListener('change', function () { state.showDimensions = cd.checked; });
    var cg = $('#chk-grid');
    if (cg) cg.addEventListener('change', function () { state.showGrid = cg.checked; });
    var ci = $('#chk-idler');
    if (ci) ci.addEventListener('change', function () { state.showIdler = ci.checked; });

    /* Unit toggle */
    $$('.unit-toggle .unit-pill').forEach(function (btn) {
      btn.addEventListener('click', function () {
        units = btn.dataset.unit;
        $$('.unit-toggle .unit-pill').forEach(function (b) {
          b.classList.toggle('active', b.dataset.unit === units);
        });
        updateUnitLabels();
      });
    });

    /* Presets */
    $$('#preset-btns .preset-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        applyPreset(btn.dataset.preset);
      });
    });

    /* Action bar */
    var btnReset = $('#btn-reset');
    if (btnReset) btnReset.addEventListener('click', resetAll);
    var btnCsv = $('#btn-csv');
    if (btnCsv) btnCsv.addEventListener('click', exportCSV);
    var btnPng = $('#btn-png');
    if (btnPng) btnPng.addEventListener('click', exportPNG);

    /* Calc modal */
    var calcBtn = $('#btn-calc');
    if (calcBtn) calcBtn.addEventListener('click', openCalcModal);
    var calcClose = $('#calc-modal-close');
    if (calcClose) calcClose.addEventListener('click', closeCalcModal);
    var calcModalEl = $('#calc-modal');
    if (calcModalEl) calcModalEl.addEventListener('click', function (e) {
      if (e.target === calcModalEl) closeCalcModal();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && calcModalEl && calcModalEl.classList.contains('active')) closeCalcModal();
    });

    /* Learning panels */
    var expAll = $('#learn-expand-all');
    var colAll = $('#learn-collapse-all');
    var cards = Array.prototype.slice.call($$('.learn-card'));
    if (expAll) expAll.addEventListener('click', function () { cards.forEach(function (c) { c.open = true; }); });
    if (colAll) colAll.addEventListener('click', function () { cards.forEach(function (c) { c.open = false; }); });

    /* Context menu on canvas */
    canvas.addEventListener('contextmenu', function (e) {
      e.preventDefault();
      showContextMenu(e.clientX, e.clientY);
    });
    document.addEventListener('click', hideContextMenu);
  }

  function applyDriveTypeUI() {
    var isChain = state.driveType === 'chain';
    var isOpen  = state.driveType === 'open';
    [slMu, inMu].forEach(function (el) { if (el) el.disabled = isChain; });
    var muGroup = slMu.closest('.sim-row-item');
    if (muGroup) muGroup.style.opacity = isChain ? '0.4' : '';
    var trBadge = rbTR.closest('.readout-badge');
    if (trBadge) trBadge.style.opacity = isChain ? '0.65' : '';
    var slipGroup = slSlip ? slSlip.closest('.sim-row-item') : null;
    if (slipGroup) slipGroup.style.opacity = isChain ? '0.4' : '';
    [slSlip, inSlip].forEach(function (el) { if (el) el.disabled = isChain; });
    /* Idler — only meaningful for open belt; hide for crossed/chain */
    var idlerLbl = document.getElementById('chk-idler-lbl');
    if (idlerLbl) idlerLbl.style.display = isOpen ? '' : 'none';
  }

  function updateUnitLabels() {
    /* Re-render all unit-aware controls with current SI values. */
    if (setD1) setD1(state.D1);
    if (setD2) setD2(state.D2);
    if (setC)  setC(state.C);
    if (setN1) setN1(state.N1);
    if (setMu) setMu(state.mu);
    if (setT1) setT1(state.T1);
    if (setSlip) setSlip(state.slip);
    /* Invalidate cached learning-panel HTML so KaTeX re-renders with new units. */
    _learnCache.eq = '';
    if (state.computed && state.computed.VR != null) {
      updateReadouts();
      draw();
    }
  }

  /* ================================================================
     PRESETS
     ================================================================ */
  var PRESETS = {
    'reduction-2to1': { driveType: 'open',    D1: 300, D2: 150, C: 600, N1: 1440, mu: 0.30, T1: 2000, slip: 1 },
    'speed-up':       { driveType: 'open',    D1: 100, D2: 300, C: 500, N1: 1500, mu: 0.30, T1: 1500, slip: 1 },
    'crossed-equal':  { driveType: 'crossed', D1: 250, D2: 250, C: 700, N1: 900,  mu: 0.30, T1: 2000, slip: 0 },
    'chain-bike':     { driveType: 'chain',   D1: 200, D2: 100, C: 500, N1: 60,   mu: 0.30, T1: 800,  slip: 0 },
    'industrial':     { driveType: 'open',    D1: 400, D2: 200, C: 1000, N1: 1450, mu: 0.35, T1: 3500, slip: 1.5 }
  };
  function applyPreset(name) {
    var p = PRESETS[name]; if (!p) return;
    state.driveType = p.driveType;
    setD1(p.D1); setD2(p.D2); setC(p.C); setN1(p.N1); setMu(p.mu); setT1(p.T1); setSlip(p.slip);
    $$('#drive-type-btns .preset-btn').forEach(function (b) {
      b.classList.toggle('active', b.dataset.drive === p.driveType);
    });
