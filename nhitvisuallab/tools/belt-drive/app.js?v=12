  /* ================================================================
     CONTEXT MENU
     ================================================================ */
  function ensureContextMenu() {
    var menu = $('#canvas-ctx-menu');
    if (menu) return menu;
    menu = document.createElement('div');
    menu.id = 'canvas-ctx-menu';
    menu.className = 'ctx-menu';
    menu.innerHTML =
      '<button data-act="csv">Export Data (CSV)</button>' +
      '<button data-act="png">Export Image (PNG)</button>' +
      '<button data-act="grid">Toggle Grid</button>' +
      '<button data-act="dim">Toggle Dimensions</button>' +
      '<button data-act="reset">Reset Simulation</button>';
    document.body.appendChild(menu);
    menu.addEventListener('click', function (e) {
      var b = e.target.closest('button');
      if (!b) return;
      var act = b.dataset.act;
      if (act === 'csv')   exportCSV();
      if (act === 'png')   exportPNG();
      if (act === 'grid')  { state.showGrid = !state.showGrid; var cg = $('#chk-grid'); if (cg) cg.checked = state.showGrid; }
      if (act === 'dim')   { state.showDimensions = !state.showDimensions; var cd = $('#chk-dim'); if (cd) cd.checked = state.showDimensions; }
      if (act === 'reset') resetAll();
      hideContextMenu();
    });
    return menu;
  }
  function showContextMenu(x, y) {
    var menu = ensureContextMenu();
    menu.style.display = 'block';
    var w = menu.offsetWidth, h = menu.offsetHeight;
    var vw = window.innerWidth, vh = window.innerHeight;
    if (x + w + 8 > vw) x = vw - w - 8;
    if (y + h + 8 > vh) y = vh - h - 8;
    menu.style.left = x + 'px';
    menu.style.top  = y + 'px';
  }
  function hideContextMenu() {
    var menu = $('#canvas-ctx-menu');
    if (menu) menu.style.display = 'none';
  }

  /* ================================================================
     EXPORT — CSV + PNG
     ================================================================ */
  function exportCSV() {
    var c = state.computed;
    var rows = [
      ['Parameter', 'Symbol', 'Value (SI)', 'Unit'],
      ['Drive Type', '', state.driveType, ''],
      ['Driver Diameter', 'D1', state.D1, 'mm'],
      ['Driven Diameter', 'D2', state.D2, 'mm'],
      ['Centre Distance', 'C', state.C, 'mm'],
      ['Driver Speed', 'N1', state.N1, 'rpm'],
      ['Coefficient of Friction', 'mu', state.mu, ''],
      ['Tight-side Tension', 'T1', state.T1, 'N'],
      ['Slip', 's', state.slip, '%'],
      ['Velocity Ratio', 'VR', roundN(c.VR, 4), ''],
      ['Driven Speed', 'N2', roundN(c.N2, 1), 'rpm'],
      ['Belt Speed', 'v', roundN(c.v, 3), 'm/s'],
      ['Wrap Angle (smaller pulley, governing)', 'theta', roundN(c.theta * 180 / Math.PI, 2), 'deg'],
      ['Tension Ratio', 'T1/T2', state.driveType === 'chain' ? 'N/A (positive engagement)' : roundN(c.tensionRatio, 3), ''],
      ['Slack Tension', 'T2', state.driveType === 'chain' ? 0 : roundN(c.T2, 1), 'N'],
      ['Power Transmitted', 'P', roundN(c.P, 3), 'kW'],
      ['Belt Length', 'L', roundN(c.L, 1), 'mm']
    ];
    var csv = rows.map(function (r) { return r.join(','); }).join('\n');
    var blob = new Blob([csv], { type: 'text/csv;charset=utf-8' });
    var a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'belt-drive-' + state.driveType + '-' + Date.now() + '.csv';
    document.body.appendChild(a); a.click();
    setTimeout(function () { document.body.removeChild(a); URL.revokeObjectURL(a.href); }, 100);
  }
  function exportPNG() {
    /* Compose canvas + watermark to a temporary canvas */
    var off = document.createElement('canvas');
    off.width = canvas.width; off.height = canvas.height;
    var octx = off.getContext('2d');
    octx.drawImage(canvas, 0, 0);
    octx.fillStyle = 'rgba(255,255,255,0.6)';
    octx.font = (12 * (canvas.width / W)) + 'px Segoe UI, sans-serif';
    octx.textAlign = 'right';
    octx.fillText('mechsimulator.com — Belt & Chain Drive', off.width - 10, off.height - 10);
    var a = document.createElement('a');
    a.href = off.toDataURL('image/png');
    a.download = 'belt-drive-' + state.driveType + '-' + Date.now() + '.png';
    document.body.appendChild(a); a.click();
    setTimeout(function () { document.body.removeChild(a); }, 100);
  }

  /* ================================================================
     LEARNING PANELS — Live Equations (KaTeX)
     ================================================================ */
  var _learnCache = { eq: '' };
  /* Display-unit helpers — return number formatted with current unit */
  function dispD(mmVal, withUnit) {
    var u = U();
    var n = u.len.fromMM(mmVal);
    return (+n).toFixed(u.len.dp) + (withUnit ? '\\;\\mathrm{' + u.len.label + '}' : '');
  }
  function dispF(nVal, withUnit) {
    var u = U();
    var n = u.force.fromN(nVal);
    return (+n).toFixed(u.force.dp) + (withUnit ? '\\;\\mathrm{' + u.force.label + '}' : '');
  }
  function dispS(msVal, withUnit) {
    var u = U();
    var n = u.spd.fromMS(msVal);
    return (+n).toFixed(u.spd.dp) + (withUnit ? '\\;\\mathrm{' + u.spd.label + '}' : '');
  }
  function dispP(kwVal, withUnit) {
    var u = U();
    var n = u.power.fromKW(kwVal);
    return (+n).toFixed(u.power.dp) + (withUnit ? '\\;\\mathrm{' + u.power.label + '}' : '');
  }
  function updateLearnPanels(c) {
    var eq = document.getElementById('lp-eq-body');
    if (!eq) return;
    var u = U();
    var html = '';
    /* VR */
    html += '<div class="eq-line">\\[ VR = \\dfrac{D_1}{D_2} = \\dfrac{N_2}{N_1} \\]</div>';
    html += '<div class="eq-line">\\(VR = \\dfrac{' + dispD(state.D1, true) + '}{' + dispD(state.D2, true) + '} = \\mathbf{' + c.VR.toFixed(3) + '}\\)</div>';
    /* Belt speed — formula stays in SI; final result shown in display unit */
    html += '<div class="eq-line">\\[ v = \\dfrac{\\pi \\, D_1 \\, N_1}{60\\,000}\\;\\text{(SI)} \\]</div>';
    html += '<div class="eq-line">\\(v = \\dfrac{\\pi \\times ' + state.D1 + ' \\times ' + state.N1
         + '}{60\\,000} = \\mathbf{' + dispS(c.v, true) + '}\\)</div>';
    /* Wrap angle */
    if (state.driveType === 'crossed') {
      html += '<div class="eq-line">\\[ \\theta = \\pi + 2\\sin^{-1}\\!\\left(\\dfrac{R_1+R_2}{C}\\right) \\]</div>';
    } else {
      html += '<div class="eq-line">\\[ \\theta_{\\text{small}} = \\pi - 2\\sin^{-1}\\!\\left(\\dfrac{|R_1-R_2|}{C}\\right) \\]</div>';
    }
    html += '<div class="eq-line">\\(\\theta = \\mathbf{' + (c.theta * 180 / Math.PI).toFixed(2) + '^\\circ} = '
         + c.theta.toFixed(3) + '\\;\\mathrm{rad}\\)</div>';
    /* Tension & power */
    if (state.driveType === 'chain') {
      html += '<div class="eq-line">\\[ P = T_{\\text{chain}} \\cdot v \\]</div>';
      html += '<div class="eq-line">\\(P = ' + dispF(state.T1, true) + ' \\times ' + dispS(c.v, true)
           + ' = \\mathbf{' + dispP(c.P, true) + '}\\)</div>';
      html += '<div class="eq-line"><em>Chain drives use positive engagement — no slip; capstan equation does not apply.</em></div>';
    } else {
      html += '<div class="eq-line">\\[ \\dfrac{T_1}{T_2} = e^{\\mu\\theta} \\]</div>';
      html += '<div class="eq-line">\\(\\dfrac{T_1}{T_2} = e^{' + state.mu.toFixed(2) + ' \\times ' + c.theta.toFixed(3)
           + '} = \\mathbf{' + c.tensionRatio.toFixed(3) + '}\\)</div>';
      html += '<div class="eq-line">\\[ P = (T_1 - T_2) \\cdot v \\]</div>';
      html += '<div class="eq-line">\\(P = (' + dispF(state.T1, false) + ' - ' + dispF(c.T2, false) + ')\\;\\mathrm{' + u.force.label + '} \\times '
           + dispS(c.v, true) + ' = \\mathbf{' + dispP(c.P, true) + '}\\)</div>';
    }
    /* Belt length */
    html += '<div class="eq-line">\\(L \\approx \\mathbf{' + dispD(c.L, true) + '}\\)</div>';

    if (html !== _learnCache.eq) {
      eq.innerHTML = html;
      _learnCache.eq = html;
    }

    /* Coach panel — heuristic insights */
    var coach = document.getElementById('lp-coach-body');
    if (coach) {
      var tips = [];
      if (state.driveType !== 'chain' && c.tensionRatio < 1.5) {
        tips.push('Tension ratio is low (' + c.tensionRatio.toFixed(2) + '). Increase wrap angle θ (use shorter C) or friction μ to raise capacity.');
      }
      if (c.theta * 180 / Math.PI < 150 && state.driveType === 'open') {
        tips.push('Wrap on the smaller pulley is below 150° — consider a crossed belt or idler to increase contact.');
      }
      if (state.driveType === 'crossed') {
        tips.push('Crossed belt always has θ > 180° → higher power capacity, but the belt rubs at the crossing causing wear.');
      }
      if (state.driveType === 'chain') {
        tips.push('Chain drive: no slip, exact ratio. Useful for camshafts, bicycles, conveyors. Avoid high speeds (>20 m/s) due to chordal action.');
      }
      if (c.v > 25) {
        tips.push('Belt speed is high (' + c.v.toFixed(1) + ' m/s). Centrifugal tension reduces effective driving tension — check optimum belt-speed condition.');
      }
      if (state.driveType !== 'chain' && state.slip > 3) {
        tips.push('Slip > 3 % — driven speed is reduced noticeably (N₂ = ' + roundN(c.N2, 0) + ' rpm vs ideal ' + roundN(c.N2id, 0) + ' rpm).');
      }
      if (!c.valid) tips.push('⚠ Pulleys overlap at this centre distance C — increase C.');
      if (tips.length === 0) tips.push('All parameters look reasonable for a typical industrial drive.');
      coach.innerHTML = tips.map(function (t) { return '<li>' + t + '</li>'; }).join('');
    }
  }

  /* ================================================================
     CALC MODAL — Pattern 2
     ================================================================ */
  function calcStep(num, title, formula, calculation, result) {
    var html = '<div class="cs-step">';
    html += '<div class="cs-step-hd">';
    html += '<span class="cs-num">Step ' + num + '</span>';
    html += '<span class="cs-title">' + title + '</span>';
    html += '</div>';
    if (formula)     html += '<div class="cs-formula">' + formula + '</div>';
    if (calculation) html += '<div class="cs-calc">' + calculation + '</div>';
    if (result != null) html += '<div class="cs-result">→ <strong>' + result + '</strong></div>';
    html += '</div>';
    return html;
  }
  function buildCalcSteps() {
    var c = state.computed;
    var u = U();
    var isCh = state.driveType === 'chain';
    var html = '';

    /* Given block — values shown in user-selected display unit */
    var dlbl = u.len.label, flbl = u.force.label;
    html += '<div class="cs-inputs"><span class="cs-badge">Given — Current Simulation State</span>';
    html += '<div class="cs-given">';
    html += '<span>Drive type = ' + state.driveType + '</span>';
    html += '<span>D₁ = ' + (+u.len.fromMM(state.D1)).toFixed(u.len.dp) + ' ' + dlbl + '</span>';
    html += '<span>D₂ = ' + (+u.len.fromMM(state.D2)).toFixed(u.len.dp) + ' ' + dlbl + '</span>';
    html += '<span>C = '  + (+u.len.fromMM(state.C)).toFixed(u.len.dp)  + ' ' + dlbl + '</span>';
    html += '<span>N₁ = ' + state.N1 + ' rpm</span>';
    if (!isCh) html += '<span>μ = ' + state.mu.toFixed(2) + '</span>';
    html += '<span>T₁ = ' + (+u.force.fromN(state.T1)).toFixed(u.force.dp) + ' ' + flbl + '</span>';
    if (!isCh) html += '<span>s = ' + state.slip.toFixed(1) + ' %</span>';
    html += '</div>';
    html += '<p class="cs-si-note">ⓘ Formulas are written in SI (D₁ in mm); substituted values shown in SI for consistency. Final results are converted to your selected display unit.</p></div>';

    /* Step 1 — VR */
    html += calcStep(1, 'Velocity Ratio',
      '\\[ VR = \\dfrac{D_1}{D_2} = \\dfrac{N_2}{N_1} \\]',
      '\\(VR = \\dfrac{' + state.D1 + '}{' + state.D2 + '} = ' + c.VR.toFixed(3) + '\\)',
      'VR = ' + c.VR.toFixed(3));

    /* Step 2 — Driven Speed (chain has positive engagement: s = 0) */
    if (isCh) {
      html += calcStep(2, 'Driven Speed N₂ (no slip — positive engagement)',
        '\\[ N_2 = N_1 \\cdot \\dfrac{D_1}{D_2} \\]',
        '\\(N_2 = ' + state.N1 + ' \\times ' + c.VR.toFixed(3) + ' = ' + roundN(c.N2, 1) + '\\;\\mathrm{rpm}\\)',
        roundN(c.N2, 0) + ' rpm');
    } else {
      html += calcStep(2, 'Driven Speed N₂',
        '\\[ N_2 = N_1 \\cdot \\dfrac{D_1}{D_2} \\cdot \\left(1 - \\dfrac{s}{100}\\right) \\]',
        '\\(N_2 = ' + state.N1 + ' \\times ' + c.VR.toFixed(3) + ' \\times (1 - ' + state.slip.toFixed(2) + '/100) = ' + roundN(c.N2, 1) + '\\;\\mathrm{rpm}\\)',
        roundN(c.N2, 0) + ' rpm');
    }

    /* Step 3 — Belt Speed */
    html += calcStep(3, 'Belt Speed v',
      '\\[ v = \\dfrac{\\pi \\, D_1 \\, N_1}{60\\,000} \\]',
      '\\(v = \\dfrac{\\pi \\times ' + state.D1 + ' \\times ' + state.N1 + '}{60\\,000} = ' + fmt(c.v, 3) + '\\;\\mathrm{m/s}\\)',
      fmt(u.spd.fromMS(c.v), 2) + ' ' + u.spd.label);

    /* Step 4 — Wrap Angle */
    var wrapFormula = state.driveType === 'crossed'
      ? '\\[ \\theta = \\pi + 2\\sin^{-1}\\!\\left(\\dfrac{R_1+R_2}{C}\\right) \\]'
      : '\\[ \\theta = \\pi - 2\\sin^{-1}\\!\\left(\\dfrac{|R_1-R_2|}{C}\\right) \\quad\\text{(smaller pulley — governs slip)} \\]';
    var wrapCalc = state.driveType === 'crossed'
      ? '\\(\\theta = \\pi + 2\\sin^{-1}\\!\\left(\\dfrac{' + (state.D1/2) + ' + ' + (state.D2/2) + '}{' + state.C + '}\\right) = ' + c.theta.toFixed(3) + '\\;\\mathrm{rad}\\)'
      : '\\(\\theta = \\pi - 2\\sin^{-1}\\!\\left(\\dfrac{' + Math.abs(state.D1/2 - state.D2/2) + '}{' + state.C + '}\\right) = ' + c.theta.toFixed(3) + '\\;\\mathrm{rad}\\)';
    html += calcStep(4, 'Angle of Wrap θ',
      wrapFormula, wrapCalc,
      (c.theta * 180 / Math.PI).toFixed(1) + '°  (' + c.theta.toFixed(3) + ' rad)');

    if (isCh) {
      /* Chain power directly from T1 */
      html += calcStep(5, 'Chain Drive Power',
        '\\[ P = T_{\\text{chain}} \\cdot v \\]',
        '\\(P = ' + state.T1 + ' \\times ' + fmt(c.v, 3) + ' = ' + (state.T1 * c.v).toFixed(0) + '\\;\\mathrm{W}\\)',
        fmt(u.power.fromKW(c.P), 3) + ' ' + u.power.label);
    } else {
      /* Step 5 — Capstan */
      html += calcStep(5, 'Capstan Equation — Tension Ratio',
        '\\[ \\dfrac{T_1}{T_2} = e^{\\mu \\theta} \\]',
        '\\(\\dfrac{T_1}{T_2} = e^{' + state.mu.toFixed(2) + ' \\times ' + c.theta.toFixed(3) + '} = e^{' + (state.mu * c.theta).toFixed(3) + '} = ' + c.tensionRatio.toFixed(3) + '\\)',
        c.tensionRatio.toFixed(3) + ' : 1');

      /* Step 6 — T2 */
      html += calcStep(6, 'Slack-side Tension T₂',
        '\\[ T_2 = \\dfrac{T_1}{T_1/T_2} \\]',
        '\\(T_2 = \\dfrac{' + state.T1 + '}{' + c.tensionRatio.toFixed(3) + '} = ' + fmt(c.T2, 1) + '\\;\\mathrm{N}\\)',
        fmt(u.force.fromN(c.T2), u.force.dp) + ' ' + u.force.label);

      /* Step 7 — Power */
      html += calcStep(7, 'Power Transmitted',
        '\\[ P = (T_1 - T_2) \\cdot v \\]',
        '\\(P = (' + state.T1 + ' - ' + fmt(c.T2, 1) + ') \\times ' + fmt(c.v, 3) + ' = ' + (c.P * 1000).toFixed(0) + '\\;\\mathrm{W}\\)',
        fmt(u.power.fromKW(c.P), 3) + ' ' + u.power.label);
    }

    /* Step — Belt length */
    var lenFormula = state.driveType === 'crossed'
      ? '\\[ L = 2C + \\dfrac{\\pi(D_1+D_2)}{2} + \\dfrac{(D_1+D_2)^2}{4C} \\]'
      : '\\[ L = 2C + \\dfrac{\\pi(D_1+D_2)}{2} + \\dfrac{(D_1-D_2)^2}{4C} \\]';
    html += calcStep(isCh ? 6 : 8, 'Belt / Chain Length',
      lenFormula,
      '\\(L = ' + fmt(c.L, 1) + '\\;\\mathrm{mm}\\)',
      fmt(u.len.fromMM(c.L), u.len.dp) + ' ' + u.len.label);

    /* Context note */
    html += '<div class="cs-step"><div class="cs-step-hd"><span class="cs-num">Note</span><span class="cs-title">Real-World Context</span></div>';
    html += '<div class="cs-result">Typical V-belt drive: μ ≈ 0.30–0.45, allowable T₁ ≈ 1.5–2.5 kN per cross-section. Chain drives: avoid v > 15–20 m/s due to chordal action and noise. For an industrial motor pulley running at ' + state.N1 + ' rpm, the calculated belt speed of ' + fmt(c.v, 2) + ' m/s is ' + (c.v < 25 ? 'within' : 'above') + ' the typical operating range.</div></div>';

    return html;
  }
