      steps = ['v = π × ' + D1c + ' × ' + N1c + ' / 60000 = ' + roundN(v2, 3) + ' m/s',
               'T₁/T₂ = e^(' + muVal2.toFixed(2) + ' × ' + roundN(thetaRad2, 3) + ') = ' + roundN(tr2, 3),
               'T₂ = ' + T1v + ' / ' + roundN(tr2, 3) + ' = ' + roundN(T2v, 1) + ' N',
               'P = (T₁ − T₂) × v = (' + T1v + ' − ' + roundN(T2v, 1) + ') × ' + roundN(v2, 3) + ' = ' + roundN(P * 1000, 1) + ' W = ' + roundN(P, 2) + ' kW'];
    }
