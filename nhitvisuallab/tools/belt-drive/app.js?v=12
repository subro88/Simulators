  function resetAll() {
    state.driveType = 'open';
    setD1(300); setD2(150); setC(600); setN1(600); setMu(0.30); setT1(2000); setSlip(0);
    state.showEquation = true; state.showDimensions = true; state.showGrid = false;
    var ce = $('#chk-equation'); if (ce) ce.checked = true;
    var cd = $('#chk-dim');      if (cd) cd.checked = true;
    var cg = $('#chk-grid');     if (cg) cg.checked = false;
