    if (isNaN(v)) { flash('Enter a numeric answer'); return; }
    prac.total++;
    var fb = $('prac-feedback');
    if (Math.abs(v - prac.qn.answer) <= prac.qn.tol) {
      prac.score++;
      fb.className = 'feedback show correct';
      fb.textContent = '✓ Correct! Answer = ' + prac.qn.answer.toFixed(3) + ' ' + prac.qn.unit;
      playSuccess();
    } else {
      fb.className = 'feedback show wrong';
      fb.textContent = '✗ Not quite. Expected ' + prac.qn.answer.toFixed(3) + ' ' + prac.qn.unit + ' (yours: ' + v.toFixed(3) + ')';
      playError();
    }
    $('p-score').textContent = prac.score;
    $('p-total').textContent = prac.total;
  });
