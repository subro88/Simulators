  /* ── Light-theme report chart renderers ─────────────────────── */
  function newReportCanvas(w, h) {
    var c = document.createElement('canvas'); c.width = w; c.height = h;
    var x = c.getContext('2d');
    x.fillStyle = '#ffffff'; x.fillRect(0, 0, w, h);
    return { c: c, x: x };
  }
  function reportWatermark(x, w, h) {
    x.font = '600 ' + Math.max(11, Math.round(w * 0.016)) + 'px Segoe UI, sans-serif';
    x.textAlign = 'right'; x.textBaseline = 'bottom';
    x.fillStyle = 'rgba(0,105,92,0.35)';
    x.fillText('mechsimulator.com', w - 10, h - 8);
  }

  function buildReportChartMorse(res) {
    var W = 1000, H = 460, o = newReportCanvas(W, H), x = o.x;
    var eng = curEngine(), n = eng.cyl;
    var pad = { l: 70, r: 30, t: 30, b: 50 };
    var pw = W - pad.l - pad.r, ph = H - pad.t - pad.b;
    var ips = res && res.cylIPs ? res.cylIPs.map(function (v) { return v != null ? v / 1000 : 0; }) : [];
    var maxV = Math.max.apply(null, ips.concat([1])) * 1.2;
    var avg = 0, cnt = 0; ips.forEach(function (v) { if (v) { avg += v; cnt++; } }); if (cnt) avg /= cnt;
    /* axes */
    x.strokeStyle = '#90a4ae'; x.lineWidth = 1;
    x.beginPath(); x.moveTo(pad.l, pad.t); x.lineTo(pad.l, pad.t + ph); x.lineTo(pad.l + pw, pad.t + ph); x.stroke();
    x.fillStyle = '#37474f'; x.font = '13px Segoe UI'; x.textAlign = 'right';
    for (var k = 0; k <= 4; k++) {
      var yv = maxV / 4 * k, py = pad.t + ph - yv / maxV * ph;
      x.fillText(toD(yv, 'power').toFixed(1), pad.l - 6, py + 4);
      x.strokeStyle = '#eceff1'; x.beginPath(); x.moveTo(pad.l, py); x.lineTo(pad.l + pw, py); x.stroke();
    }
    x.save(); x.translate(20, pad.t + ph / 2); x.rotate(-Math.PI / 2); x.textAlign = 'center';
    x.fillStyle = '#00695c'; x.font = 'bold 13px Segoe UI'; x.fillText('IP per cylinder (' + uLabel('power') + ')', 0, 0); x.restore();
    /* bars */
    var step = pw / n, bw = step * 0.55;
    for (var i = 0; i < n; i++) {
      var bx = pad.l + step * i + (step - bw) / 2;
      var bh = ips[i] / maxV * ph, by = pad.t + ph - bh;
      x.fillStyle = '#26a69a'; x.fillRect(bx, by, bw, bh);
      x.strokeStyle = '#00695c'; x.strokeRect(bx, by, bw, bh);
      x.fillStyle = '#111'; x.font = 'bold 13px Courier New'; x.textAlign = 'center';
      x.fillText(toD(ips[i], 'power').toFixed(2), bx + bw / 2, by - 6);
      x.fillStyle = '#546e7a'; x.font = '12px Segoe UI';
      x.fillText('Cyl ' + (i + 1), pad.l + step * i + step / 2, pad.t + ph + 18);
    }
    /* average line */
    if (avg > 0) {
      var ya = pad.t + ph - avg / maxV * ph;
      x.strokeStyle = '#e65100'; x.lineWidth = 2; x.setLineDash([6, 4]);
      x.beginPath(); x.moveTo(pad.l, ya); x.lineTo(pad.l + pw, ya); x.stroke(); x.setLineDash([]);
      x.fillStyle = '#e65100'; x.font = 'bold 12px Courier New'; x.textAlign = 'left';
      x.fillText('avg ' + toD(avg, 'power').toFixed(2), pad.l + 6, ya - 6);
    }
    reportWatermark(x, W, H);
    return o.c.toDataURL('image/png');
  }

  function buildReportChartCurves(data, isLoad) {
    var W = 1000, H = 460, o = newReportCanvas(W, H), x = o.x;
    if (!data || !data.length) { reportWatermark(x, W, H); return o.c.toDataURL('image/png'); }
    var pad = { l: 70, r: 70, t: 30, b: 55 };
    var pw = W - pad.l - pad.r, ph = H - pad.t - pad.b;
    var xKey = isLoad ? 'pct' : 'N';
    var xs = data.map(function (d) { return d[xKey]; });
    var xMin = Math.min.apply(null, xs), xMax = Math.max.apply(null, xs);
    var BPmax = Math.max.apply(null, data.map(function (d) { return d.BP_kW; })) * 1.15 || 10;
    var BSFCvals = data.map(function (d) { return d.bsfc || 0; }).filter(function (v) { return v > 0; });
    var BSFCmax = BSFCvals.length ? Math.max.apply(null, BSFCvals) * 1.15 : 500;
    function mx(v) { return pad.l + (v - xMin) / (xMax - xMin || 1) * pw; }
    /* axes */
    x.strokeStyle = '#90a4ae'; x.lineWidth = 1;
    x.beginPath(); x.moveTo(pad.l, pad.t); x.lineTo(pad.l, pad.t + ph); x.lineTo(pad.l + pw, pad.t + ph); x.stroke();
    x.fillStyle = '#546e7a'; x.font = '12px Segoe UI'; x.textAlign = 'center';
    for (var t = 0; t <= 5; t++) {
      var xv = xMin + (xMax - xMin) * t / 5;
      x.fillText(isLoad ? Math.round(xv) + '%' : Math.round(xv), mx(xv), pad.t + ph + 18);
    }
    x.fillStyle = '#00695c'; x.font = 'bold 13px Segoe UI';
    x.fillText(isLoad ? 'Load (%)' : 'Speed N (rpm)', pad.l + pw / 2, pad.t + ph + 40);
    /* left axis BP */
    x.fillStyle = '#2e7d32'; x.textAlign = 'right'; x.font = '12px Courier New';
    for (var k = 0; k <= 4; k++) { var yv = BPmax / 4 * k; x.fillText(toD(yv, 'power').toFixed(1), pad.l - 6, pad.t + ph - yv / BPmax * ph + 4); }
    /* right axis BSFC */
    x.fillStyle = '#ef6c00'; x.textAlign = 'left';
    for (var k2 = 0; k2 <= 4; k2++) { var yv2 = BSFCmax / 4 * k2; x.fillText(fmt(toD(yv2, 'bsfc'), isImp() ? 2 : 0), pad.l + pw + 6, pad.t + ph - yv2 / BSFCmax * ph + 4); }
    /* curves */
    function plot(mapY, color) {
      var s = data.slice().sort(function (a, b) { return a[xKey] - b[xKey]; });
      x.strokeStyle = color; x.lineWidth = 2.5; x.beginPath(); var st = false;
      s.forEach(function (d) { var py = mapY(d); if (py == null || isNaN(py)) return; var px = mx(d[xKey]); if (!st) { x.moveTo(px, py); st = true; } else x.lineTo(px, py); });
      x.stroke();
      s.forEach(function (d) { var py = mapY(d); if (py == null || isNaN(py)) return; x.fillStyle = color; x.beginPath(); x.arc(mx(d[xKey]), py, 4, 0, TAU); x.fill(); });
    }
    plot(function (d) { return pad.t + ph - d.BP_kW / BPmax * ph; }, '#2e7d32');
    plot(function (d) { return d.bsfc ? pad.t + ph - d.bsfc / BSFCmax * ph : null; }, '#ef6c00');
    /* legend */
    x.font = '12px Segoe UI'; x.textAlign = 'left';
    x.fillStyle = '#2e7d32'; x.fillRect(pad.l + 6, pad.t + 4, 10, 10); x.fillText('BP (' + uLabel('power') + ')', pad.l + 20, pad.t + 13);
    x.fillStyle = '#ef6c00'; x.fillRect(pad.l + 120, pad.t + 4, 10, 10); x.fillText('BSFC (' + uLabel('bsfc') + ')', pad.l + 134, pad.t + 13);
    reportWatermark(x, W, H);
    return o.c.toDataURL('image/png');
  }

  function buildReportChartWillans() {
    var W = 1000, H = 460, o = newReportCanvas(W, H), x = o.x;
    var pts = state.curveData.willans, fit = state.curveData.willansFit;
    if (!pts || !pts.length) { reportWatermark(x, W, H); return o.c.toDataURL('image/png'); }
    var pad = { l: 75, r: 30, t: 30, b: 55 };
    var pw = W - pad.l - pad.r, ph = H - pad.t - pad.b;
    var FPx = fit && isFinite(fit.FP_kW) ? Math.max(0, fit.FP_kW) : 0;
    var xMin = -FPx * 1.18;
    var xMax = Math.max.apply(null, pts.map(function (p) { return p.BP_kW; })) * 1.1;
    var yMax = Math.max.apply(null, pts.map(function (p) { return p.mf_kg_h; })) * 1.15;
    if (fit && fit.a > yMax * 0.6) yMax = Math.max(yMax, fit.a * 1.15);
    function mx(v) { return pad.l + (v - xMin) / (xMax - xMin) * pw; }
    function my(v) { return pad.t + ph - v / yMax * ph; }
    /* axes: BP axis along bottom (m_f = 0), m_f axis at BP = 0 */
    x.strokeStyle = '#90a4ae'; x.lineWidth = 1;
    x.beginPath();
    x.moveTo(mx(0), pad.t); x.lineTo(mx(0), pad.t + ph);
    x.moveTo(pad.l, pad.t + ph); x.lineTo(pad.l + pw, pad.t + ph);
    x.stroke();
    x.fillStyle = '#546e7a'; x.font = '12px Courier New'; x.textAlign = 'center';
    for (var t = 0; t <= 5; t++) { var xv = xMin + (xMax - xMin) * t / 5; x.fillText(toD(xv, 'power').toFixed(1), mx(xv), pad.t + ph + 18); }
    x.textAlign = 'right';
    for (var k = 0; k <= 4; k++) { var yv = yMax / 4 * k; x.fillText(fmt(toD(yv * 1000, 'fuelrate'), 1), pad.l - 6, my(yv) + 4); }
    x.fillStyle = '#00695c'; x.font = 'bold 13px Segoe UI'; x.textAlign = 'center';
    x.fillText('Brake Power (' + uLabel('power') + ')', pad.l + pw / 2, pad.t + ph + 42);
    x.save(); x.translate(22, pad.t + ph / 2); x.rotate(-Math.PI / 2); x.fillText('Fuel rate m_f (' + uLabel('fuelrate') + ')', 0, 0); x.restore();
    if (fit) {
      x.strokeStyle = '#ef6c00'; x.lineWidth = 2.5; x.setLineDash([7, 5]);
      x.beginPath(); x.moveTo(mx(xMin), my(fit.a + fit.b * xMin)); x.lineTo(mx(xMax), my(fit.a + fit.b * xMax)); x.stroke(); x.setLineDash([]);
      /* y-intercept (idle fuel) */
      x.fillStyle = '#ef6c00'; x.beginPath(); x.arc(mx(0), my(fit.a), 5, 0, TAU); x.fill();
      /* x-intercept = friction power */
      var xi = -FPx;
      x.strokeStyle = 'rgba(198,40,40,0.5)'; x.lineWidth = 1.5; x.setLineDash([5, 4]);
      x.beginPath(); x.moveTo(mx(xi), my(0)); x.lineTo(mx(xi), pad.t + 6); x.stroke(); x.setLineDash([]);
      x.fillStyle = '#c62828'; x.beginPath(); x.arc(mx(xi), my(0), 6, 0, TAU); x.fill();
      x.font = 'bold 13px Segoe UI'; x.textAlign = 'left';
      x.fillText('FP = ' + toD(fit.FP_kW, 'power').toFixed(2) + ' ' + uLabel('power'), mx(xi) + 10, my(0) - 10);
    }
    pts.forEach(function (p) { x.fillStyle = '#1565c0'; x.beginPath(); x.arc(mx(p.BP_kW), my(p.mf_kg_h), 5, 0, TAU); x.fill(); });
    reportWatermark(x, W, H);
    return o.c.toDataURL('image/png');
  }

