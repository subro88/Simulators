    var c = $('btn-calc');
    if (c) c.disabled = !on;
  }

  function refreshCylStrip() {
    var btns = $('cyl-strip').querySelectorAll('.cyl-btn');
    var recordedCyls = {};
    state.readings.forEach(function (r) {
      if (r.cylCut >= 0) recordedCyls[r.cylCut] = true;
    });
    for (var i = 0; i < btns.length; i++) {
      var idx = +btns[i].dataset.idx;
      var stateSpan = btns[i].querySelector('.cyl-state');
      if (state.cutMask[idx]) {
        btns[i].classList.add('cut');
        stateSpan.textContent = 'CUT OUT';
      } else {
        btns[i].classList.remove('cut');
        stateSpan.textContent = 'FIRING';
      }
      if (recordedCyls[idx]) btns[i].classList.add('recorded');
      else btns[i].classList.remove('recorded');
    }
  }

  function buildLabSteps() {
    /* Procedure-agnostic workflow guide (the rig now runs six tests). */
    var steps = [
      'Pick engine preset',
      'Set geometry / speed',
      'Start engine',
      'Run Test → pick procedure',
      'View results & export report'
    ];
    var host = $('lab-steps');
    host.innerHTML = '';
    var hasResults = state.readings.length > 0 ||
      state.curveData.load.length || state.curveData.speed.length ||
      state.curveData.willans.length || state.curveData.heatBalance || state.curveData.retardation.length;
    var stepIdx = 0;
    if (state.running) stepIdx = 3;
    else if (hasResults) stepIdx = 4;
    else stepIdx = 2;                 /* engine ready to start */
    if (state.autoTest) stepIdx = 3;
    for (var s = 0; s < steps.length; s++) {
      var div = document.createElement('div');
      div.className = 'lab-step' + (s === stepIdx ? ' active' : (s < stepIdx ? ' done' : ''));
      div.innerHTML = '<span class="lab-step-num">' + (s + 1) + '</span><span class="lab-step-text">' + steps[s] + '</span>';
      host.appendChild(div);
    }
  }

  /* ═══════════════════════════════════════════════════════════════
     EVENTS — Controls
     ═══════════════════════════════════════════════════════════════ */
  function onCylClick(e) {
    if (state.autoTest) { return; }   /* switches are driven by the auto-test */
    if (!state.running) {
      flash('Start the engine first');
      return;
    }
    var idx = +e.currentTarget.dataset.idx;
    var wasCut = state.cutMask[idx];
    /* Constraint: at least one cylinder must keep firing.
       If trying to cut and that would leave 0 firing, block it. */
    if (!wasCut) {
      var firingAfter = 0;
      for (var i = 0; i < state.cutMask.length; i++) {
        if (i === idx) continue;        /* this one would become cut */
        if (!state.cutMask[i]) firingAfter++;
      }
      if (firingAfter < 1) {
        flash('At least one cylinder must keep firing');
        playError();
        return;
      }
    }
    state.cutMask[idx] = !wasCut;
    /* Build phase label reflecting all currently-cut cylinders */
    var cutList = [];
    for (var k = 0; k < state.cutMask.length; k++) if (state.cutMask[k]) cutList.push('Cyl ' + (k + 1));
    state.phase = cutList.length === 0 ? 'All firing'
                : cutList.length === 1 ? cutList[0] + ' cut'
                : cutList.join('+') + ' cut';
    playClick();
    if (state.cutMask[idx]) playMisfire();
    refreshCylStrip();
    /* immediate visual refresh — BP/Load drop instantly */
    updateBadges();
    drawEngine();
    drawResults();
  }

