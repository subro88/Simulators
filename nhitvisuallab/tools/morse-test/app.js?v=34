  function updateResultsCards() {
    var res = calcResults();
    /* E4: the Morse result cards only apply to the Morse test. Hide the whole
       row for sweep / heat / retardation tests (their data is in the chart). */
    var row = $('results-row');
    if (row) row.style.display = res ? '' : 'none';
    var put = function (id, v, kind, d) {
      $(id).textContent = v == null ? '—' : fmt(toD(v, kind), d == null ? 2 : d);
    };
    var allIds = ['res-bp','res-ip','res-fp','res-eta','res-t','res-n','res-mf','res-bsfc','res-eta-bth','res-eta-ith'];
    if (!res) {
      allIds.forEach(function(id){ $(id).textContent = '—'; });
    } else {
      put('res-bp', res.BP_W / 1000, 'power');
      put('res-ip', res.IP_W != null ? res.IP_W / 1000 : null, 'power');
      put('res-fp', res.FP_W != null ? res.FP_W / 1000 : null, 'power');
      $('res-eta').textContent = res.eta == null ? '—' : fmt(res.eta, 1);
      put('res-t', res.T_Nm, 'torque', 1);
      $('res-n').textContent = state.N;
      /* Fuel + thermal */
      $('res-mf').textContent      = res.mf_kg_per_h == null ? '—' : fmt(toD(res.mf_kg_per_h * 1000, 'fuelrate'), 2);
      $('res-bsfc').textContent    = res.bsfc       == null ? '—' : fmt(toD(res.bsfc, 'bsfc'), isImp() ? 3 : 0);
      $('res-eta-bth').textContent = res.eta_bth    == null ? '—' : fmt(res.eta_bth, 1);
      $('res-eta-ith').textContent = res.eta_ith    == null ? '—' : fmt(res.eta_ith, 1);
