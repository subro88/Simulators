  /* ── Show Calculations modal ─────────────────────────────────── */
  function calcStep(num, title, formula, result) {
    var h = '<div class="cs-step"><div class="cs-step-hd">' +
      '<span class="cs-num">Step ' + num + '</span><span class="cs-title">' + title + '</span></div>';
    if (formula) h += '<div class="cs-formula">' + formula + '</div>';
    if (result != null) h += '<div class="cs-result">→ <strong>' + result + '</strong></div>';
    return h + '</div>';
  }

  function openCalcModal() {
    if (!state.lastTest) { toast('Run a test first', 'error'); return; }
    var body = $('calc-modal-body');
    body.innerHTML = buildCalcContent();
    $('calc-modal').classList.add('active');
    /* latex-auto.js observes #calc-modal-body and auto-renders the LaTeX */
    renderMath(body);
  }
  function closeCalcModal() { $('calc-modal').classList.remove('active'); }

  function buildCalcContent() {
    var lt = state.lastTest, eng = curEngine();
    var uPow = uLabel('power');
    var intro = '<div class="cs-intro"><strong>' + escapeHtmlM(lt.procName) + '</strong> — ' +
      escapeHtmlM(lt.std) + '. Engine: ' + escapeHtmlM(eng.name) + ', ' +
      fmt(toD(curBore(), 'length'), isImp() ? 2 : 0) + '×' + fmt(toD(curStroke(), 'length'), isImp() ? 2 : 0) + ' ' + uLabel('length') +
      ', CR ' + curCR().toFixed(1) +
      '. Values in the active unit system (' + (isImp() ? 'Imperial' : 'SI') + ').</div>';
    var html = intro;

    if (lt.procId === 'morse') {
      var res = calcResults();
      if (!res) return intro + '<p>No data.</p>';
      var n = eng.cyl;
      html += calcStep(1, 'Brake torque', '\\( T = W \\cdot g \\cdot L \\)',
        'T = ' + fmt(toD(res.T_Nm, 'torque'), 1) + ' ' + uLabel('torque'));
      html += calcStep(2, 'Total brake power (all firing)', '\\( BP = \\dfrac{2\\pi N T}{60} \\)',
        'BP = ' + fmt(toD(res.BP_W / 1000, 'power'), 2) + ' ' + uPow);
      var ipParts = res.cylIPs.map(function (v, i) { return 'IP_' + (i + 1) + ' = ' + (v != null ? fmt(toD(v / 1000, 'power'), 2) : '—'); }).join(',  ');
      html += calcStep(3, 'Indicated power per cylinder', '\\( IP_i = BP - BP_i \\)', ipParts);
      html += calcStep(4, 'Total indicated power', '\\( IP = \\sum IP_i \\)',
        (res.IP_W != null ? fmt(toD(res.IP_W / 1000, 'power'), 2) + ' ' + uPow : '—'));
      html += calcStep(5, 'Friction power', '\\( FP = IP - BP \\)',
        (res.FP_W != null ? fmt(toD(res.FP_W / 1000, 'power'), 2) + ' ' + uPow : '—'));
      html += calcStep(6, 'Mechanical efficiency', '\\( \\eta_{mech} = \\dfrac{BP}{IP} \\times 100\\% \\)',
        (res.eta != null ? fmt(res.eta, 1) + ' %' : '—'));
      if (res.eta_bth != null) html += calcStep(7, 'Brake thermal efficiency',
        '\\( \\eta_{bth} = \\dfrac{BP \\times 3600}{\\dot m_f \\cdot CV} \\times 100\\% \\)', fmt(res.eta_bth, 1) + ' %');
    } else if (lt.procId === 'heatBalance') {
      var hb = state.curveData.heatBalance;
      if (!hb) return intro + '<p>No data.</p>';
      html += calcStep(1, 'Heat input from fuel', '\\( Q_{fuel} = \\dot m_f \\cdot CV \\)',
        fmt(toD(hb.Qfuel, 'power'), 2) + ' ' + uPow);
      html += calcStep(2, 'Brake power (useful work)', '\\( BP \\) (from dynamometer)',
        fmt(toD(hb.BP, 'power'), 2) + ' ' + uPow + ' (' + (hb.bthFrac * 100).toFixed(1) + '%)');
      html += calcStep(3, 'Heat to cooling water', '\\( Q_w = \\dot m_w \\cdot c_{pw} \\cdot \\Delta T_w \\)',
        fmt(toD(hb.Qcool, 'power'), 2) + ' ' + uPow + ' (ΔT = ' + fmt(toD(hb.dTw, 'dtemp'), 1) + ' ' + uLabel('dtemp') + ')');
      html += calcStep(4, 'Heat to exhaust gas', '\\( Q_g = \\dot m_g \\cdot c_{pg} \\cdot (T_{exh}-T_{amb}) \\)',
        fmt(toD(hb.Qexh, 'power'), 2) + ' ' + uPow + ' (T_exh = ' + fmt(toD(hb.Texh, 'temp'), 0) + ' ' + uLabel('temp') + ')');
      html += calcStep(5, 'Unaccounted (by difference)', '\\( Q_{unacc} = Q_{fuel} - BP - Q_w - Q_g \\)',
        fmt(toD(hb.Qunacc, 'power'), 2) + ' ' + uPow + ' (' + (hb.unaccFrac * 100).toFixed(1) + '%)');
    } else if (lt.procId === 'retardation') {
      var fit = state.curveData.retardationFit;
      if (!fit) return intro + '<p>No data.</p>';
      html += calcStep(1, 'Angular speed at test point', '\\( \\omega = \\dfrac{2\\pi N}{60} \\)',
        fit.omega0.toFixed(1) + ' rad/s (N = ' + Math.round(fit.N0) + ' rpm)');
      html += calcStep(2, 'Rotating-mass inertia', '\\( I \\) (flywheel + reciprocating)',
        fmt(toD(fit.I, 'inertia'), 2) + ' ' + uLabel('inertia'));
      html += calcStep(3, 'Decay law after fuel cut', '\\( I\\,\\omega\\,d\\omega = -FP\\,dt \\Rightarrow \\omega^2 = \\omega_0^2 - \\dfrac{2FP}{I}t \\)', 'linear in ω² vs t');
      html += calcStep(4, 'Friction power from slope', '\\( FP = \\dfrac{I}{2}\\left| \\dfrac{d(\\omega^2)}{dt} \\right| \\)',
        fmt(toD(fit.FP_kW, 'power'), 2) + ' ' + uPow);
    } else if (lt.procId === 'loadSweep' || lt.procId === 'speedSweep') {
      var data = lt.procId === 'loadSweep' ? state.curveData.load : state.curveData.speed;
      var pk = data.reduce(function (a, d) { return (!a || d.BP_kW > a.BP_kW) ? d : a; }, null);
      var best = data.reduce(function (a, d) { return (d.bsfc && (!a || d.bsfc < a.bsfc)) ? d : a; }, null);
      html += calcStep(1, 'At each operating point', '\\( BP = \\dfrac{2\\pi N T}{60}, \\quad BSFC = \\dfrac{\\dot m_f}{BP} \\)', data.length + ' points recorded');
      if (pk) html += calcStep(2, 'Peak brake power', 'maximum of the BP curve',
        fmt(toD(pk.BP_kW, 'power'), 2) + ' ' + uPow + (lt.procId === 'speedSweep' ? ' at ' + Math.round(pk.N) + ' rpm' : ' at ' + Math.round(pk.pct) + '% load'));
      if (best) html += calcStep(3, 'Best fuel economy', 'minimum of the BSFC curve',
        fmt(toD(best.bsfc, 'bsfc'), isImp() ? 3 : 0) + ' ' + uLabel('bsfc') + (lt.procId === 'speedSweep' ? ' at ' + Math.round(best.N) + ' rpm' : ' at ' + Math.round(best.pct) + '% load'));
    } else if (lt.procId === 'willans') {
      var wf = state.curveData.willansFit;
      html += calcStep(1, 'Linear fit of fuel rate vs BP', '\\( \\dot m_f = a + b\\,BP \\)',
        wf ? 'a = ' + fmt(toD(wf.a * 1000, 'fuelrate'), 2) + ' ' + uLabel('fuelrate') + ',  b = ' + fmt(toD(wf.b * 1000, 'fuelrate'), 2) + ' ' + uLabel('fuelrate') + '/' + uPow : '—');
      if (wf) html += calcStep(2, 'Extrapolate to zero fuel rate', '\\( \\dot m_f = 0 \\Rightarrow BP = -\\dfrac{a}{b} \\)',
        'BP-axis intercept at &minus;' + fmt(toD(wf.FP_kW, 'power'), 2) + ' ' + uPow);
      if (wf) html += calcStep(3, 'Friction power from intercept', '\\( FP = \\dfrac{a}{b} \\)',
        fmt(toD(wf.FP_kW, 'power'), 2) + ' ' + uPow);
    }
    return html;
  }

