  /* Click-to-type slider values */
  function makeEditable(spanId, sliderId, kind, intOnly) {
    var span = $(spanId), slider = $(sliderId);
    span.title = 'Click to type a value';
    span.addEventListener('click', function () {
      var curDisplay = toD(+slider.value, kind);
      var inp = document.createElement('input');
      inp.type = 'number';
      inp.value = (intOnly ? Math.round(curDisplay) : (+curDisplay).toFixed(1));
      inp.style.width = '70px';
      inp.style.fontFamily = 'Courier New, monospace';
      inp.style.background = 'var(--surface2)';
      inp.style.border = '1px solid var(--accent)';
      inp.style.borderRadius = '4px';
      inp.style.color = 'var(--accent)';
      inp.style.padding = '2px 6px';
      span.replaceWith(inp);
      inp.focus(); inp.select();
      var commit = function () {
        var v = parseFloat(inp.value);
        if (!isNaN(v)) {
          /* convert display→SI if imperial */
          var si = v;
          if (isImp()) {
            if (kind === 'length') si = v * 25.4;
          }
          si = Math.max(+slider.min, Math.min(+slider.max, si));
          slider.value = si;
          if (kind === 'length') state.L_mm = +slider.value;
          if (sliderId === 'slider-n') state.N = +slider.value;
          if (sliderId === 'slider-load') state.loadFactor = (+slider.value) / 100;
        }
        inp.replaceWith(span);
        updateLabels();
        updateBadges(); drawEngine(); drawResults();
      };
      var cancel = function () { inp.replaceWith(span); };
      inp.addEventListener('blur', commit);
      inp.addEventListener('keydown', function (ev) {
        if (ev.key === 'Enter') commit();
        else if (ev.key === 'Escape') cancel();
      });
    });
