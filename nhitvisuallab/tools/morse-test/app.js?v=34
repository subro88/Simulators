  /* ═══════════════════════════════════════════════════════════════
     ENGINE SETUP MODAL — bore / stroke / compression ratio
     ═══════════════════════════════════════════════════════════════ */
  var setupDraft = { bore: 75, stroke: 79, cr: 10, arm: 500 };

  function crLimits() {
    return curEngine().kind === 'petrol' ? GEO_LIMITS.crPetrol : GEO_LIMITS.crDiesel;
  }

  function openSetupModal() {
    if (state.autoTest) { toast('Cancel the running auto-test first', 'error'); return; }
    var eng = curEngine();
    setupDraft.bore = curBore();
    setupDraft.stroke = curStroke();
    setupDraft.cr = curCR();
    setupDraft.arm = state.L_mm;
    /* set CR slider range per fuel type */
    var crl = crLimits();
    $('setup-cr').min = crl.min; $('setup-cr').max = crl.max;
    $('setup-cr-num').min = crl.min; $('setup-cr-num').max = crl.max;
    $('hint-cr').textContent = '(' + crl.min + '–' + crl.max + ')';
    /* populate controls */
    $('setup-bore').value = setupDraft.bore;   $('setup-bore-num').value = setupDraft.bore;
    $('setup-stroke').value = setupDraft.stroke; $('setup-stroke-num').value = setupDraft.stroke;
    $('setup-cr').value = setupDraft.cr;       $('setup-cr-num').value = setupDraft.cr;
    $('setup-arm').value = setupDraft.arm;     $('setup-arm-num').value = setupDraft.arm;
    updateSetupPreview();
    $('setup-modal').style.display = 'flex';
  }
  function closeSetupModal() { $('setup-modal').style.display = 'none'; }

  function updateSetupPreview() {
    var eng = curEngine();
    var D = setupDraft.bore, L = setupDraft.stroke, r = setupDraft.cr;
    var VsL = sweptVol_L(D, L);
    var VtL = VsL * eng.cyl;
    var etaas = etaAirStd(r, eng.kind) * 100;
    /* estimated rated power using the same scaling as ipPerCylNow */
    var VsRef = sweptVol_L(eng.bore0, eng.stroke0);
    var etaRef = etaAirStd(eng.cr0, eng.kind);
    var ipc = eng.ipPerCyl * (VsL / VsRef) * (etaAirStd(r, eng.kind) / etaRef);
    var totalIP = ipc * eng.cyl;
    var FP = 0.08 * totalIP;
    var ratedBP = totalIP - FP;
    /* IMEP estimate at rated speed */
    var nRev = eng.strokes === 2 ? 1 : 2;
    var imep = (ipc * 1000 * nRev) / (VsL * 1e-3 * (1500 / 60)) / 1e5;
    var bsClass = D / L > 1.05 ? 'Oversquare' : (D / L < 0.95 ? 'Undersquare' : 'Square');

    $('prev-vs').textContent = isImp() ? fmt(toD(VsL, 'volume'), 2) + ' in³' : (VsL * 1000).toFixed(0) + ' cc';
    $('prev-vt').textContent = fmt(toD(VtL, 'volume'), 2) + ' ' + uLabel('volume');
    $('prev-bs').textContent = (D / L).toFixed(2) + ' · ' + bsClass;
    $('prev-etaas').textContent = etaas.toFixed(1) + ' %';
    $('prev-power').textContent = fmt(toD(ratedBP, 'power'), isImp() ? 2 : 1) + ' ' + uLabel('power');
    $('prev-imep').textContent = fmt(toD(imep, 'pressure'), isImp() ? 1 : 1) + ' ' + uLabel('pressure');
  }

  function bindSetupPair(slider, num, key, isFloat) {
    function commit(v) {
      var lo = +slider.min, hi = +slider.max;
      v = Math.max(lo, Math.min(hi, isFloat ? parseFloat(v) : Math.round(v)));
      if (isNaN(v)) return;
      setupDraft[key] = v;
      slider.value = v; num.value = v;
      updateSetupPreview();
    }
    slider.addEventListener('input', function () { commit(+slider.value); });
    num.addEventListener('input', function () { if (num.value !== '') commit(+num.value); });
    num.addEventListener('blur', function () { commit(+num.value); });
  }
  bindSetupPair($('setup-bore'), $('setup-bore-num'), 'bore', false);
  bindSetupPair($('setup-stroke'), $('setup-stroke-num'), 'stroke', false);
  bindSetupPair($('setup-cr'), $('setup-cr-num'), 'cr', true);
  bindSetupPair($('setup-arm'), $('setup-arm-num'), 'arm', false);

  $('btn-setup').addEventListener('click', function () { openSetupModal(); playClick(); });
  $('setup-modal-close').addEventListener('click', function () { closeSetupModal(); playClick(); });
  $('setup-modal-backdrop').addEventListener('click', closeSetupModal);
  $('setup-reset').addEventListener('click', function () {
    var eng = curEngine();
    setupDraft.bore = eng.bore0; setupDraft.stroke = eng.stroke0; setupDraft.cr = eng.cr0; setupDraft.arm = 500;
    $('setup-bore').value = eng.bore0; $('setup-bore-num').value = eng.bore0;
    $('setup-stroke').value = eng.stroke0; $('setup-stroke-num').value = eng.stroke0;
    $('setup-cr').value = eng.cr0; $('setup-cr-num').value = eng.cr0;
    $('setup-arm').value = 500; $('setup-arm-num').value = 500;
    updateSetupPreview();
    playClick();
  });
  $('setup-apply').addEventListener('click', function () {
    state.bore = setupDraft.bore;
    state.stroke = setupDraft.stroke;
    state.compRatio = setupDraft.cr;
    state.L_mm = setupDraft.arm;
    /* changing geometry invalidates prior readings */
    state.readings = [];
    state.curveData = { load: [], speed: [], willans: [], heatBalance: null, retardation: [], retardationFit: null };
    initCutMask();
    refreshCylStrip();
    setReportEnabled(false);
    updateResultsCards();
    drawEngine();
    drawResults();
    updateBadges();
    closeSetupModal();
    playSuccess();
    toast('Engine updated — ' + curBore().toFixed(0) + '×' + curStroke().toFixed(0) + ' mm · ' +
          displacement_L().toFixed(2) + ' L · CR ' + curCR().toFixed(1) + ' (readings cleared)');
  });

  /* ═══════════════════════════════════════════════════════════════
     AUTO-TEST MODAL — populate, open, close, run
     ═══════════════════════════════════════════════════════════════ */
  function openAutoModal() {
    var modal = $('auto-modal');
    var grid = $('auto-modal-grid');
    grid.innerHTML = '';
    Object.keys(TEST_PROCEDURES).forEach(function (key) {
      var p = TEST_PROCEDURES[key];
      var card = document.createElement('div');
      card.className = 'proc-card';
      card.style.setProperty('--proc-accent', p.accent);
      /* estimate total duration */
      var steps = p.build(curEngine());
      var totalSec = Math.round(steps.reduce(function (a, s) { return a + (s.dur || 1); }, 0));
      card.innerHTML =
        '<div class="proc-card-header">' +
          '<span class="proc-card-icon">' + p.icon + '</span>' +
          '<span class="proc-card-name">' + p.name + '</span>' +
        '</div>' +
        '<div class="proc-card-standard">' + p.standard + ' · ~' + totalSec + ' s</div>' +
        '<div class="proc-card-desc">' + p.description + '</div>' +
        '<div class="proc-card-outputs">' + p.outputs + '</div>' +
        '<button class="proc-card-run" data-proc="' + key + '">▶ Run Test</button>';
      grid.appendChild(card);
    });
    /* Wire run buttons */
    grid.querySelectorAll('.proc-card-run').forEach(function (b) {
      b.addEventListener('click', function () {
        var procId = b.dataset.proc;
        closeAutoModal();
        startAutoTest(procId);
      });
    });
    modal.style.display = 'flex';
  }
