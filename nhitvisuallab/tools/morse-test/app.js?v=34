    var W = 1000, H = 460, o = newReportCanvas(W, H), x = o.x;
    var pts = state.curveData.retardation, fit = state.curveData.retardationFit;
    if (!pts || !pts.length) { reportWatermark(x, W, H); return o.c.toDataURL('image/png'); }
    var pad = { l: 80, r: 30, t: 30, b: 55 }, pw = W - pad.l - pad.r, ph = H - pad.t - pad.b;
    var tMax = pts[pts.length - 1].t || 1, nMax = pts[0].N * 1.05 || 1;
    function mx(t) { return pad.l + t / tMax * pw; }
    function my(n) { return pad.t + ph - n / nMax * ph; }
    x.strokeStyle = '#90a4ae'; x.lineWidth = 1;
    x.beginPath(); x.moveTo(pad.l, pad.t); x.lineTo(pad.l, pad.t + ph); x.lineTo(pad.l + pw, pad.t + ph); x.stroke();
    x.fillStyle = '#546e7a'; x.font = '13px Courier New'; x.textAlign = 'right';
    for (var k = 0; k <= 4; k++) { var nv = nMax / 4 * k; x.fillText(Math.round(nv), pad.l - 6, my(nv) + 4); }
    x.textAlign = 'center';
    for (var t = 0; t <= 4; t++) { var tv = tMax / 4 * t; x.fillText(tv.toFixed(1), mx(tv), pad.t + ph + 18); }
    x.fillStyle = '#6a1b9a'; x.font = 'bold 14px Segoe UI';
    x.fillText('Time after fuel cut-off (s)', pad.l + pw / 2, pad.t + ph + 42);
    x.save(); x.translate(24, pad.t + ph / 2); x.rotate(-Math.PI / 2); x.textAlign = 'center';
    x.fillText('Engine speed (rpm)', 0, 0); x.restore();
    x.strokeStyle = '#8e24aa'; x.lineWidth = 3; x.beginPath();
    pts.forEach(function (p, i) { var X = mx(p.t), Y = my(p.N); if (i === 0) x.moveTo(X, Y); else x.lineTo(X, Y); });
    x.stroke();
    pts.forEach(function (p) { x.fillStyle = '#8e24aa'; x.beginPath(); x.arc(mx(p.t), my(p.N), 5, 0, TAU); x.fill(); });
    if (fit) {
      x.fillStyle = '#6a1b9a'; x.font = 'bold 16px Segoe UI'; x.textAlign = 'right';
      x.fillText('FP = ' + toD(fit.FP_kW, 'power').toFixed(2) + ' ' + uLabel('power') + '   (I = ' + fmt(toD(fit.I, 'inertia'), 2) + ' ' + uLabel('inertia') + ')', pad.l + pw - 6, pad.t + 18);
    }
    reportWatermark(x, W, H);
    return o.c.toDataURL('image/png');
  }

  /* ═══════════════════════════════════════════════════════════════
     CONTEXT MENU
     ═══════════════════════════════════════════════════════════════ */
  function setupCtxMenu(canvas, menu) {
    canvas.addEventListener('contextmenu', function (e) {
      e.preventDefault();
      var rect = canvas.parentElement.getBoundingClientRect();
      menu.style.left = (e.clientX - rect.left) + 'px';
      menu.style.top = (e.clientY - rect.top) + 'px';
      menu.style.display = 'block';
    });
  }
  setupCtxMenu(engCv, $('ctx-menu-engine'));

  /* Click-to-cancel handler for auto-test overlay */
  engCv.addEventListener('click', function (e) {
    if (!state.autoTest || !engCv._cancelBox) return;
    var rect = engCv.getBoundingClientRect();
    /* map client coords → logical canvas coords (the _cancelBox space) */
    var scaleX = engCv._lw / rect.width;
    var scaleY = engCv._lh / rect.height;
    var cx = (e.clientX - rect.left) * scaleX;
    var cy = (e.clientY - rect.top) * scaleY;
    var b = engCv._cancelBox;
    if (cx >= b.x && cx <= b.x + b.w && cy >= b.y && cy <= b.y + b.h) {
      cancelAutoTest();
    }
  });
  document.addEventListener('click', function () { $('ctx-menu-engine').style.display = 'none'; });
  $('ctx-menu-engine').addEventListener('click', function (e) {
    var act = e.target.dataset.action;
    if (act === 'save-img') exportPNG(engCv, 'morse_test_engine.png');
    else if (act === 'copy-data') {
      var res = calcResults();
      var txt = 'Morse Test — ' + curEngine().name + '\nN = ' + state.N + ' rpm\n';
      if (res) {
        txt += 'BP = ' + fmt(toD(res.BP_W / 1000, 'power'), 3) + ' ' + uLabel('power') + '\n';
        if (res.IP_W != null) txt += 'IP = ' + fmt(toD(res.IP_W / 1000, 'power'), 3) + ' ' + uLabel('power') + '\n';
        if (res.FP_W != null) txt += 'FP = ' + fmt(toD(res.FP_W / 1000, 'power'), 3) + ' ' + uLabel('power') + '\n';
        if (res.eta != null) txt += 'η_mech = ' + fmt(res.eta, 2) + ' %\n';
      }
      if (navigator.clipboard) navigator.clipboard.writeText(txt);
    } else if (act === 'reset') resetTest();
  });

  /* ═══════════════════════════════════════════════════════════════
     SOUND
     ═══════════════════════════════════════════════════════════════ */
  function getAudioCtx() {
    if (!state.audioCtx) {
      try { state.audioCtx = new (window.AudioContext || window.webkitAudioContext)(); }
      catch (e) { state.soundOn = false; }
    }
    return state.audioCtx;
  }
  function playTone(freq, dur, type, vol) {
    if (!state.soundOn) return;
    var ctx = getAudioCtx();
    if (!ctx) return;
    var osc = ctx.createOscillator();
    var g = ctx.createGain();
    osc.type = type || 'sine';
    osc.frequency.value = freq;
    g.gain.setValueAtTime(vol || 0.08, ctx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + dur);
    osc.connect(g); g.connect(ctx.destination);
    osc.start();
    osc.stop(ctx.currentTime + dur);
  }
  function playClick()    { playTone(800, 0.05, 'square', 0.04); }
  function playSuccess()  { playTone(880, 0.12, 'sine', 0.1); setTimeout(function () { playTone(1100, 0.15, 'sine', 0.1); }, 120); }
  function playError()    { playTone(300, 0.2, 'sawtooth', 0.06); }
  function playStart()    { playTone(220, 0.15, 'sawtooth', 0.08); setTimeout(function () { playTone(330, 0.2, 'triangle', 0.08); }, 100); }
  function playMisfire()  { playTone(180, 0.08, 'sawtooth', 0.1); setTimeout(function () { playTone(140, 0.1, 'square', 0.06); }, 60); }

  /* ═══════════════════════════════════════════════════════════════
     AUTO TEST — Industrial standard procedures
     ═══════════════════════════════════════════════════════════════ */
  /* All durations in seconds (simulated lab time, compressed). */
  var STEP = 2.0;          /* default step duration */
  var QUICK = 1.2;

  function morseSteps(eng) {
    var s = [{ type: 'reset',       dur: 1.0, label: 'Resetting rig and warming up engine'},
             { type: 'set-speed',   dur: STEP, label: 'Setting rated speed N = 1500 rpm', N: 1500 },
             { type: 'stabilize',   dur: 2.5,  label: 'Stabilising at rated speed — oil temp climbing' },
             { type: 'record',      dur: 1.5,  label: 'Recording BP with ALL cylinders firing (reference)', cylCut: -1 }];
    for (var i = 0; i < eng.cyl; i++) {
      s.push({ type: 'cut-cyl',   dur: 1.2, label: 'Cutting Cyl ' + (i+1) + ' — short-circuit spark/cut fuel', idx: i });
      s.push({ type: 'stabilize', dur: 2.2, label: 'Re-stabilising at 1500 rpm with Cyl ' + (i+1) + ' inactive' });
      s.push({ type: 'record',    dur: 1.5, label: 'Recording BP with Cyl ' + (i+1) + ' cut out', cylCut: i });
      s.push({ type: 'restore-cyl', dur: 1.0, label: 'Restoring Cyl ' + (i+1), idx: i });
    }
    s.push({ type: 'compute', dur: 1.0, label: 'Computing IP per cyl, ΣIP, FP, η_mech, η_bth' });
    return s;
  }

  function loadSweepSteps(eng) {
    var loads = [0, 10, 25, 50, 75, 100, 110];  /* IS 10000-8 standard load points */
    var s = [{ type: 'reset',     dur: 1.0, label: 'Resetting rig — clearing previous data' },
             { type: 'set-speed', dur: STEP, label: 'Setting rated speed N = 1500 rpm', N: 1500 },
             { type: 'stabilize', dur: 2.0, label: 'Warm-up at rated speed' }];
    loads.forEach(function (pct) {
      s.push({ type: 'set-load', dur: 1.5, label: 'Adjusting throttle/load to ' + pct + '% rated', pct: pct });
      s.push({ type: 'stabilize', dur: 2.0, label: 'Stabilising engine at ' + pct + '% load' });
      s.push({ type: 'record-curve', dur: 1.3, label: 'Reading BP, T, m_f, BSFC, η at ' + pct + '% load',
               kind: 'load', pct: pct });
    });
    s.push({ type: 'compute', dur: 1.0, label: 'Plotting performance curves vs load' });
    return s;
  }

  function speedSweepSteps() {
    var rpms = [800, 1200, 1500, 1800, 2200, 2600, 3000, 3500];  /* SAE J1349 */
    var s = [{ type: 'reset',     dur: 1.0, label: 'Resetting rig' },
             { type: 'set-load',  dur: 1.2, label: 'Applying full throttle (100% load)', pct: 100 },
             { type: 'stabilize', dur: 1.5, label: 'Warm-up at full load' }];
    rpms.forEach(function (N) {
      s.push({ type: 'set-speed', dur: 1.5, label: 'Sweeping engine speed to ' + N + ' rpm', N: N });
      s.push({ type: 'stabilize', dur: 1.8, label: 'Stabilising at ' + N + ' rpm under full load' });
      s.push({ type: 'record-curve', dur: 1.2, label: 'Reading T, BP, m_f at ' + N + ' rpm',
               kind: 'speed', N: N });
    });
    s.push({ type: 'compute', dur: 1.0, label: 'Plotting torque, power & BSFC curves vs N' });
    return s;
  }

  function willansSteps() {
    var loads = [25, 40, 55, 70, 85, 100];
    var s = [{ type: 'reset',     dur: 1.0, label: 'Resetting rig' },
             { type: 'set-speed', dur: STEP, label: 'Setting rated speed N = 1500 rpm', N: 1500 },
             { type: 'stabilize', dur: 1.5, label: 'Warm-up' }];
    loads.forEach(function (pct) {
      s.push({ type: 'set-load',     dur: 1.4, label: 'Setting load = ' + pct + '% of rated', pct: pct });
      s.push({ type: 'stabilize',    dur: 1.8, label: 'Stabilising at ' + pct + '% load' });
      s.push({ type: 'record-curve', dur: 1.2, label: 'Reading m_f vs BP at ' + pct + '% load',
               kind: 'willans', pct: pct });
    });
    s.push({ type: 'compute-willans', dur: 1.5, label: 'Linear fit of m_f vs BP — extrapolating to BP = 0' });
    return s;
  }

  function heatBalanceSteps() {
    return [
      { type: 'reset',     dur: 1.0, label: 'Resetting rig' },
      { type: 'set-speed', dur: STEP, label: 'Setting rated speed N = 1500 rpm', N: 1500 },
      { type: 'set-load',  dur: 1.2, label: 'Applying full rated load (100%)', pct: 100 },
      { type: 'stabilize', dur: 2.5, label: 'Stabilising — coolant & exhaust temperatures settling' },
      { type: 'measure-heat', dur: 1.6, label: 'Reading fuel rate, coolant ΔT and exhaust temperature' },
      { type: 'compute', dur: 1.0, label: 'Drawing the heat balance sheet (energy distribution)' }
    ];
  }

  function retardationSteps() {
    return [
      { type: 'reset',      dur: 1.0, label: 'Resetting rig' },
      { type: 'set-speed',  dur: STEP, label: 'Setting test speed N = 1500 rpm', N: 1500 },
      { type: 'set-load',   dur: 1.0, label: 'Removing load (no-load idle)', pct: 8 },
      { type: 'stabilize',  dur: 1.8, label: 'Stabilising at no-load' },
      { type: 'retard-run', dur: 4.5, label: 'Fuel cut — recording speed decay vs time', N0: 1500 },
      { type: 'compute-retard', dur: 1.2, label: 'Fitting ω² vs t — friction power from the slope' }
    ];
  }

  var TEST_PROCEDURES = {
    morse: {
      id: 'morse', name: 'Morse Cylinder Cut-Out Test', standard: 'IS 10000 Part 4',
      icon: '⊞', accent: '#00897b',
      description: 'Sequentially cuts each cylinder and measures the brake-power drop. Isolates per-cylinder IP, total IP, friction power and mechanical efficiency without an indicator diagram.',
      outputs: 'IP per cyl · ΣIP · FP · η_mech · η_bth · BSFC',
      build: morseSteps
    },
    loadSweep: {
      id: 'loadSweep', name: 'Variable Load Test', standard: 'IS 10000-8 / ISO 15550',
      icon: '⊿', accent: '#1e88e5',
      description: 'Holds rated speed and sweeps load from 0 to 110 % in 7 standard increments. Produces the iconic engine performance curves: BP, torque, BSFC and η_bth versus load.',
      outputs: 'BP vs load · BSFC vs load · η_bth vs load · Torque vs load',
      build: loadSweepSteps
    },
    speedSweep: {
      id: 'speedSweep', name: 'Variable Speed Test', standard: 'SAE J1349 / ISO 1585',
      icon: '↻', accent: '#ef5350',
      description: 'Holds full load and sweeps engine speed from 800 to 3500 rpm in 8 points. Produces speed-characteristic curves: torque curve, power curve and BSFC vs rpm.',
      outputs: 'Torque vs N · Power vs N · BSFC vs N',
      build: speedSweepSteps
    },
    willans: {
      id: 'willans', name: 'Willan\'s Line Test', standard: 'FP determination (Indicator method)',
      icon: '⊕', accent: '#f5c842',
      description: 'At constant rated speed, varies load and plots fuel consumption vs BP. Linear extrapolation to BP = 0 gives friction power — an independent cross-check of the Morse FP value.',
      outputs: 'Willan\'s line plot · FP from intercept · cross-check vs Morse',
      build: willansSteps
    },
    heatBalance: {
      id: 'heatBalance', name: 'Heat Balance Test', standard: 'IS 10001 — Heat Balance Sheet',
      icon: '♨', accent: '#ff7043',
      description: 'At rated speed and full load, accounts for where all the fuel energy goes: brake power, heat to cooling water, heat to exhaust gases, and unaccounted losses. Drawn as a heat balance sheet and pie chart.',
      outputs: 'Heat balance sheet · BP / coolant / exhaust / unaccounted %',
      build: heatBalanceSteps
    },
    retardation: {
      id: 'retardation', name: 'Retardation Test', standard: 'Friction power (deceleration method)',
      icon: '⊘', accent: '#8e24aa',
      description: 'Runs the engine at speed, cuts the fuel, and records the speed-vs-time decay. Friction power is found from the deceleration rate and the rotating-mass inertia — an independent FP cross-check.',
      outputs: 'Speed decay curve · FP from ω² vs t slope',
      build: retardationSteps
    }
  };

  /* ── Start / Cancel / Run-Step ───────────────────────────────── */
  function startAutoTest(procId) {
    var proc = TEST_PROCEDURES[procId];
    if (!proc) return;
    resetTest();
    state.curveData = { load: [], speed: [], willans: [], heatBalance: null, retardation: [], retardationFit: null };
    var steps = proc.build(curEngine());
    var totalSec = steps.reduce(function (a, s) { return a + (s.dur || 1); }, 0);
    state.autoTest = {
      procId: procId, procName: proc.name, std: proc.standard,
      steps: steps, stepIdx: -1, stepStart: 0,
      totalSec: totalSec, elapsedSec: 0,
      cancelled: false, lastFrame: Date.now()
    };
    /* auto-start engine if off */
    if (!state.running) {
      state.running = true;
      state.phase = 'AUTO TEST';
      $('btn-start').innerHTML = '<span class="cp-icon">&#9632;</span> Stop Engine';
    }
    /* default chart based on procedure */
    if (procId === 'loadSweep' || procId === 'speedSweep') state.chartMode = 'curves';
    else if (procId === 'willans') state.chartMode = 'willans';
    else if (procId === 'heatBalance') state.chartMode = 'heat';
    else if (procId === 'retardation') state.chartMode = 'retard';
    else state.chartMode = 'balance';
    /* sync chart tab UI */
    document.querySelectorAll('#chart-tabs .chart-tab').forEach(function (b) {
      b.classList.toggle('active', b.dataset.value === state.chartMode);
    });
    advanceAutoStep();
    startAutoTicker();
    toast('AUTO TEST started — ' + proc.name + ' (' + proc.standard + ')');
  }

  function cancelAutoTest() {
    if (!state.autoTest) return;
    state.autoTest.cancelled = true;
    state.autoTest = null;
    state.loadFactor = 1.0;
    stopAutoTicker();
    toast('Auto test cancelled', 'error');
  }

  function advanceAutoStep() {
    if (!state.autoTest || state.autoTest.cancelled) { state.autoTest = null; return; }
    state.autoTest.stepIdx++;
    if (state.autoTest.stepIdx >= state.autoTest.steps.length) {
      finishAutoTest();
      return;
    }
    var step = state.autoTest.steps[state.autoTest.stepIdx];
    state.autoTest.stepStart = Date.now();
    executeStepAction(step);
  }

  function executeStepAction(step) {
    switch (step.type) {
      case 'reset':
        state.readings = [];
        initCutMask();
        refreshCylStrip();
        updateResultsCards();
        break;
      case 'set-speed':
        if (step.N != null) {
          state.N = step.N;
          $('slider-n').value = step.N;
          updateLabels();
        }
        break;
      case 'set-load':
        if (step.pct != null) {
          state.loadFactor = step.pct / 100;
        }
        break;
      case 'cut-cyl':
        if (step.idx != null) {
          for (var i = 0; i < state.cutMask.length; i++) state.cutMask[i] = false;
          state.cutMask[step.idx] = true;
          state.phase = 'Cyl ' + (step.idx + 1) + ' cut';
          refreshCylStrip();
          playMisfire();
        }
        break;
      case 'restore-cyl':
        for (var k = 0; k < state.cutMask.length; k++) state.cutMask[k] = false;
        state.phase = 'All firing';
        refreshCylStrip();
        break;
      case 'stabilize':
        /* purely visual delay */
        break;
      case 'record':
        recordAutoMorse(step.cylCut);
        playSuccess();
        break;
      case 'record-curve':
        recordAutoCurve(step.kind, step.pct, step.N);
        playClick();
        break;
      case 'compute':
        updateResultsCards();
        drawResults();
        break;
      case 'compute-willans':
        computeWillansFit();
        updateResultsCards();
        drawResults();
        break;
      case 'measure-heat':
        state.curveData.heatBalance = heatBalanceData();
        break;
      case 'retard-run':
        /* set up the speed-decay animation; tickAutoTest ramps state.N down */
        state.retardAnim = retardationCurve(step.N0 != null ? step.N0 : state.N);
        state.retardAnim.startMs = Date.now();
        state.curveData.retardation = state.retardAnim.pts.slice();
        break;
      case 'compute-retard':
        computeRetardationFit();
        state.retardAnim = null;
        updateResultsCards();
        drawResults();
        break;
    }
    updateBadges();
    drawEngine();
    drawResults();
  }

  /* Recover FP from the slope of ω² vs t (linear regression). */
  function computeRetardationFit() {
    var pts = state.curveData.retardation;
    if (!pts || pts.length < 2) return;
    var I = engineInertia();
    var n = pts.length, sx = 0, sy = 0, sxy = 0, sxx = 0;
    pts.forEach(function (p) {
      var w2 = Math.pow(TAU * p.N / 60, 2);
      sx += p.t; sy += w2; sxy += p.t * w2; sxx += p.t * p.t;
    });
    var slope = (n * sxy - sx * sy) / (n * sxx - sx * sx);   /* d(ω²)/dt < 0 */
    var FP_W = -(I / 2) * slope;
    state.curveData.retardationFit = {
      I: I, FP_kW: FP_W / 1000, slope: slope,
      N0: pts[0].N, omega0: TAU * pts[0].N / 60
    };
    /* restore engine speed to the test value (decay left it low) */
    state.N = Math.round(pts[0].N);
    if ($('slider-n')) $('slider-n').value = state.N;
    updateLabels();
  }

  function recordAutoMorse(cylCut) {
    var W_kg = currentBrakeLoad_kg();
    var BP_W = simulatedBP_W();
    var mf_kgps = fuelFlow_kgps();
    var key = 'k:' + cylCut;
    state.readings = state.readings.filter(function (r) { return (r._key || ('k:' + r.cylCut)) !== key; });
    state.readings.push({ cylCut: cylCut, W_kg: W_kg, BP_W: BP_W, mf_kgps: mf_kgps, _key: key, cutIdxs: cylCut >= 0 ? [cylCut] : [] });
    state.readings.sort(function (a, b) { return a.cylCut - b.cylCut; });
    refreshCylStrip();
    updateResultsCards();
  }

  function recordAutoCurve(kind, pct, N) {
    var BP_W = simulatedBP_W();
    var W_kg = currentBrakeLoad_kg();
    var T_Nm = brakeTorque(W_kg, state.L_mm / 1000);
    var mf_kgps = fuelFlow_kgps();
    var mf_kg_h = mf_kgps * 3600;
    var BP_kW = BP_W / 1000;
    var eng = curEngine();
    var fuelEnergy_kW = mf_kg_h * eng.cv_kJ_per_kg / 3600;
    var eta_bth = fuelEnergy_kW > 0 ? (BP_kW / fuelEnergy_kW) * 100 : 0;
    var bsfc = BP_kW > 0.1 ? (mf_kg_h * 1000) / BP_kW : null;
    var pt = { BP_kW: BP_kW, T_Nm: T_Nm, mf_kg_h: mf_kg_h, eta_bth: eta_bth, bsfc: bsfc, N: state.N, pct: pct };
    if (kind === 'load')    state.curveData.load.push(pt);
    if (kind === 'speed')   state.curveData.speed.push(pt);
    if (kind === 'willans') state.curveData.willans.push(pt);
  }

  function computeWillansFit() {
    var pts = state.curveData.willans;
    if (pts.length < 2) return;
    /* linear regression: mf = a + b × BP. Intercept a × CV/3600 = FP_kW (when BP=0). */
    var n = pts.length, sx = 0, sy = 0, sxy = 0, sxx = 0;
    pts.forEach(function (p) { sx += p.BP_kW; sy += p.mf_kg_h; sxy += p.BP_kW * p.mf_kg_h; sxx += p.BP_kW * p.BP_kW; });
    var b = (n * sxy - sx * sy) / (n * sxx - sx * sx);   /* slope dm_f/dBP = ISFC */
    var a = (sy - b * sx) / n;                           /* intercept = fuel rate at BP = 0 (idle/friction fuel) */
    /* Willan's line: m_f = a + b·BP. Extrapolating to m_f = 0 cuts the BP axis
       at BP = −a/b; the magnitude of that intercept is the friction power. */
    var FP_kW_willans = b !== 0 ? a / b : 0;
    state.curveData.willansFit = { a: a, b: b, FP_kW: FP_kW_willans };
  }

  function finishAutoTest() {
    var procName = state.autoTest.procName;
    state.lastTest = { procId: state.autoTest.procId, procName: procName, std: state.autoTest.std,
                       finishedAt: new Date() };
    state.autoTest = null;
    state.loadFactor = 1.0;
    state.phase = 'All firing';
    stopAutoTicker();
    updateResultsCards();
    updateBadges();
    drawResults();
    drawEngine();
    buildLabSteps();
    setReportEnabled(true);
    playSuccess();
    toast('Test complete — ' + procName + '. Report (PDF) ready.');
  }

  /* ── Auto-test progression — driven by setInterval so it keeps
       ticking even when requestAnimationFrame is throttled. ──── */
  var _autoTickHandle = null;
  function tickAutoTest() {
    if (!state.autoTest) { stopAutoTicker(); return; }
    var step = state.autoTest.steps[state.autoTest.stepIdx];
    if (!step) return;
    var elapsed = (Date.now() - state.autoTest.stepStart) / 1000;
    state.autoTest.elapsedSec = state.autoTest.steps.slice(0, state.autoTest.stepIdx)
                                                  .reduce(function (a, s) { return a + s.dur; }, 0) + elapsed;
    /* Retardation: ramp the live engine speed down along the decay curve. */
    if (step.type === 'retard-run' && state.retardAnim) {
      var ra = state.retardAnim;
      var t = Math.min(ra.tEnd, (Date.now() - ra.startMs) / 1000 * (ra.tEnd / step.dur));
      var w2 = Math.max(0, ra.w0 * ra.w0 - ra.k * t);
      state.N = Math.round(Math.sqrt(w2) * 60 / TAU);
    }
    /* Force a re-render every tick so the overlay countdown is smooth even
       when the main RAF loop is throttled (e.g., background tab). */
    if (state.mode === 'simulate') {
      drawEngine();
      drawResults();
      updateBadges();
