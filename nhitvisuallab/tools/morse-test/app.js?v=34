  var quiz = { qs: [], idx: 0, score: 0, answered: false };
  function startQuiz() {
    var pool = QUIZ_BANK.slice();
    for (var i = pool.length - 1; i > 0; i--) {
      var j = Math.floor(Math.random() * (i + 1));
      var t = pool[i]; pool[i] = pool[j]; pool[j] = t;
    }
    quiz.qs = pool.slice(0, 5);
    quiz.idx = 0; quiz.score = 0; quiz.answered = false;
    $('quiz-result').style.display = 'none';
    document.querySelector('.question-panel').style.display = '';
    showQuizQ();
  }
  function showQuizQ() {
    var q = quiz.qs[quiz.idx];
    $('q-num').textContent = quiz.idx + 1;
    $('q-total').textContent = quiz.qs.length;
    $('qp-prompt').textContent = q.q;
    var grid = $('quiz-answers');
    grid.innerHTML = '';
    quiz.answered = false;
    q.opts.forEach(function (opt, i) {
      var b = document.createElement('button');
      b.className = 'answer-opt';
      b.textContent = opt;
      b.addEventListener('click', function () {
        if (quiz.answered) return;
        quiz.answered = true;
        if (i === q.ans) { b.classList.add('correct'); quiz.score++; playSuccess(); }
        else { b.classList.add('wrong'); grid.children[q.ans].classList.add('correct'); playError(); }
        $('btn-quiz-next').style.display = '';
      });
      grid.appendChild(b);
    });
    $('btn-quiz-next').style.display = 'none';
    $('quiz-feedback').className = 'feedback';
    $('quiz-feedback').textContent = '';
  }
  $('btn-quiz-next').addEventListener('click', function () {
