      q.solution = 'Unaccounted = Q − BP − Q_cooling − Q_exhaust\n= ' + Qf + ' − ' + bpH + ' − ' + QwH + ' − ' + QeH + '\n= ' + unacc.toFixed(2) + ' kW (' + (unacc / Qf * 100).toFixed(1) + '% of input)';
    }
    prac.qn = q;
    $('pp-prompt').textContent = q.prompt;
    $('pp-unit').textContent = q.unit;
    $('pp-input').value = '';
    $('prac-feedback').className = 'feedback';
    $('prac-feedback').textContent = '';
    $('solution-panel').style.display = 'none';
  }

  $('btn-check').addEventListener('click', function () {
