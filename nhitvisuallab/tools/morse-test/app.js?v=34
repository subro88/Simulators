    $('qr-score').textContent = quiz.score + ' / ' + quiz.qs.length;
    var pct = quiz.score / quiz.qs.length;
    var stars = pct >= 1 ? '★★★★★' : pct >= 0.8 ? '★★★★☆' : pct >= 0.6 ? '★★★☆☆' : pct >= 0.4 ? '★★☆☆☆' : pct >= 0.2 ? '★☆☆☆☆' : '☆☆☆☆☆';
