(function () {
  'use strict';

  /* ═══════════════════════════════════════════════════════════════════
     Morse Test Rig — IC Engine Virtual Lab
     ═══════════════════════════════════════════════════════════════════ */

  var $ = function (id) { return document.getElementById(id); };
  var TAU = Math.PI * 2;
  var G = 9.81;

  /* ── Engine presets ─────────────────────────────────────────── */
  /* Physics-grounded model. ipPerCyl is the CALIBRATION ANCHOR: the
     per-cylinder indicated power at the preset's reference geometry
     (bore0, stroke0, cr0). When the user changes bore/stroke/CR, the
     live IP scales as  IP = ipPerCyl × (Vs/Vs_ref) × (η_as/η_as_ref),
     and BSFC scales inversely with air-standard efficiency.
       bore0/stroke0  = reference bore & stroke (mm)
       cr0            = reference compression ratio
       cv_kJ_per_kg   = fuel calorific value (44 000 petrol, 42 500 diesel)
       bsfc_g_per_kWh = baseline BSFC at reference CR & full load */
  var ENGINES = {
    p2: { name: '2-cyl Petrol', cyl: 2, kind: 'petrol', firingOrder: [1, 2],             ipPerCyl: 5.5,  strokes: 4, cv_kJ_per_kg: 44000, bsfc_g_per_kWh: 300, fuel: 'Petrol (gasoline)', bore0: 72, stroke0: 74, cr0: 9.5 },
    p3: { name: '3-cyl Petrol', cyl: 3, kind: 'petrol', firingOrder: [1, 2, 3],          ipPerCyl: 5.5,  strokes: 4, cv_kJ_per_kg: 44000, bsfc_g_per_kWh: 290, fuel: 'Petrol (gasoline)', bore0: 73, stroke0: 79, cr0: 10.5 },
    p4: { name: '4-cyl Petrol', cyl: 4, kind: 'petrol', firingOrder: [1, 3, 4, 2],       ipPerCyl: 6.0,  strokes: 4, cv_kJ_per_kg: 44000, bsfc_g_per_kWh: 285, fuel: 'Petrol (gasoline)', bore0: 75, stroke0: 79, cr0: 10.0 },
    p6: { name: '6-cyl Petrol', cyl: 6, kind: 'petrol', firingOrder: [1, 5, 3, 6, 2, 4], ipPerCyl: 7.5,  strokes: 4, cv_kJ_per_kg: 44000, bsfc_g_per_kWh: 275, fuel: 'Petrol (gasoline)', bore0: 84, stroke0: 75, cr0: 10.5 },
    d3: { name: '3-cyl Diesel', cyl: 3, kind: 'diesel', firingOrder: [1, 3, 2],          ipPerCyl: 8.0,  strokes: 4, cv_kJ_per_kg: 42500, bsfc_g_per_kWh: 235, fuel: 'Diesel', bore0: 82, stroke0: 95, cr0: 17.0 },
    d4: { name: '4-cyl Diesel', cyl: 4, kind: 'diesel', firingOrder: [1, 3, 4, 2],       ipPerCyl: 10.0, strokes: 4, cv_kJ_per_kg: 42500, bsfc_g_per_kWh: 220, fuel: 'Diesel', bore0: 85, stroke0: 96, cr0: 17.5 },
    d6: { name: '6-cyl Diesel', cyl: 6, kind: 'diesel', firingOrder: [1, 5, 3, 6, 2, 4], ipPerCyl: 11.0, strokes: 4, cv_kJ_per_kg: 42500, bsfc_g_per_kWh: 210, fuel: 'Diesel', bore0: 95, stroke0: 104, cr0: 17.5 }
  };

  /* Realistic limits for user-editable geometry */
  var GEO_LIMITS = {
    bore:   { min: 50, max: 150 },     /* mm */
    stroke: { min: 50, max: 150 },     /* mm */
    crPetrol: { min: 6,  max: 14 },    /* SI knock limit ~14 */
    crDiesel: { min: 12, max: 24 }     /* CI range */
  };

  /* ── Engine geometry physics ────────────────────────────────── */
  function gammaFor(kind) { return kind === 'petrol' ? 1.4 : 1.35; }
  /* Air-standard (Otto/Diesel-ideal) efficiency = 1 − 1/r^(γ−1) */
  function etaAirStd(r, kind) { return 1 - Math.pow(r, 1 - gammaFor(kind)); }
  /* Swept volume per cylinder (litres) from bore & stroke in mm */
  function sweptVol_L(D_mm, L_mm) { return (Math.PI / 4) * D_mm * D_mm * L_mm / 1e6; }
  /* Current (possibly user-edited) geometry — falls back to preset defaults */
  function curBore()   { return state.bore   != null ? state.bore   : curEngine().bore0; }
  function curStroke() { return state.stroke != null ? state.stroke : curEngine().stroke0; }
  function curCR()     { return state.compRatio != null ? state.compRatio : curEngine().cr0; }
  function displacement_L() { return sweptVol_L(curBore(), curStroke()) * curEngine().cyl; }
  function boreStrokeClass() {
    var ratio = curBore() / curStroke();
    if (ratio > 1.05) return 'Oversquare';
    if (ratio < 0.95) return 'Undersquare';
    return 'Square';
  }
  /* Live per-cylinder IP, scaled from the calibration anchor by geometry & CR */
  function ipPerCylNow() {
    var eng = curEngine();
    var VsNow = sweptVol_L(curBore(), curStroke());
    var VsRef = sweptVol_L(eng.bore0, eng.stroke0);
    var etaNow = etaAirStd(curCR(), eng.kind);
    var etaRef = etaAirStd(eng.cr0, eng.kind);
    return eng.ipPerCyl * (VsNow / VsRef) * (etaNow / etaRef);
  }
  /* Live BSFC — improves (drops) as compression ratio rises */
  function bsfcNow() {
    var eng = curEngine();
    var etaNow = etaAirStd(curCR(), eng.kind);
    var etaRef = etaAirStd(eng.cr0, eng.kind);
    return eng.bsfc_g_per_kWh * (etaRef / etaNow);
  }
  /* Indicated MEP (bar) implied by current per-cyl IP at rated speed (for display) */
  function imepBar() {
    var eng = curEngine();
    var Vs_m3 = sweptVol_L(curBore(), curStroke()) * 1e-3;
    var nRev = eng.strokes === 2 ? 1 : 2;
    var N_rps = 1500 / 60;                       /* reference at rated speed */
    var IP_W = ipPerCylNow() * 1000;
    return (IP_W * nRev) / (Vs_m3 * N_rps) / 1e5;
  }

  /* ── State ──────────────────────────────────────────────────── */
  var state = {
    mode: 'simulate',
    units: 'si',
    engineKey: 'p4',
    N: 1500,
    L_mm: 500,
    bore: 75, stroke: 79, compRatio: 10.0,   /* editable geometry (init = p4 defaults) */
    running: false,
    phase: 'Idle',
    cutMask: [],            /* boolean per cylinder, true = cut out */
    readings: [],           /* [{ cylCut: -1|0..n-1, W_kg, BP_W }] */
    fpEstimate: 0,
    crankAngle: 0,
    audioCtx: null,
    soundOn: true,
    showResults: false,
    chartMode: 'balance',   /* 'balance' | 'sequence' | 'mep' | 'curves' | 'willans' */

    /* Auto-test machinery */
    loadFactor: 1.0,        /* 0..1.1 — throttle/load fraction of rated IP */
    autoTest: null,         /* {procId, procName, std, steps, stepIdx, stepStart, durMs, cancelled} */
    lastTest: null,         /* {procId, procName, std, finishedAt} — for PDF report */
    curveData: { load: [], speed: [], willans: [], heatBalance: null, retardation: [], retardationFit: null }
  };

  function curEngine() { return ENGINES[state.engineKey]; }

  function initCutMask() {
    var n = curEngine().cyl;
    state.cutMask = [];
    for (var i = 0; i < n; i++) state.cutMask.push(false);
  }
  initCutMask();

  /* ── Unit helpers ───────────────────────────────────────────── */
  function isImp() { return state.units === 'imperial'; }
  function kw2hp(kw) { return kw * 1.34102; }
  function Nm2ftlbf(nm) { return nm * 0.737562; }
  function mm2in(mm) { return mm / 25.4; }
  function kg2lb(kg) { return kg * 2.20462; }

  function uLabel(kind) {
    if (kind === 'power')    return isImp() ? 'hp'      : 'kW';
    if (kind === 'torque')   return isImp() ? 'ft·lbf'  : 'N·m';
    if (kind === 'length')   return isImp() ? 'in'      : 'mm';
    if (kind === 'load')     return isImp() ? 'lb'      : 'kg';
    if (kind === 'fuelrate') return isImp() ? 'lb/h'    : 'kg/h';
    if (kind === 'bsfc')     return isImp() ? 'lb/hp·h' : 'g/kWh';
    if (kind === 'temp')     return isImp() ? '°F'      : '°C';
    if (kind === 'dtemp')    return isImp() ? '°F'      : '°C';
    if (kind === 'pressure') return isImp() ? 'psi'     : 'bar';
    if (kind === 'volume')   return isImp() ? 'in³'     : 'L';
    if (kind === 'flow')     return isImp() ? 'gal/min' : 'L/min';
    if (kind === 'inertia')  return isImp() ? 'lb·ft²'  : 'kg·m²';
    return '';
  }
  function toD(val, kind) {
    if (val == null || isNaN(val)) return val;
    /* fuel rate is stored internally in g/h; display as kg/h (SI) or lb/h (Imperial) */
    if (kind === 'fuelrate') return isImp() ? val * 0.00220462 : val / 1000;
    if (!isImp()) return val;
    if (kind === 'power')    return kw2hp(val);
    if (kind === 'torque')   return Nm2ftlbf(val);
    if (kind === 'length')   return mm2in(val);
    if (kind === 'load')     return kg2lb(val);
    if (kind === 'bsfc')     return val * 0.00163994;    /* g/kWh → lb/(hp·h) */
    if (kind === 'temp')     return val * 9 / 5 + 32;    /* °C → °F */
    if (kind === 'dtemp')    return val * 1.8;           /* Δ°C → Δ°F */
    if (kind === 'pressure') return val * 14.50377;      /* bar → psi */
    if (kind === 'volume')   return val * 61.0237;       /* L → in³ */
    if (kind === 'flow')     return val * 0.264172;      /* L/min → gal/min */
    if (kind === 'inertia')  return val * 23.73036;      /* kg·m² → lb·ft² */
    return val;
  }
  function fmt(v, d) { if (v == null || isNaN(v)) return '—'; return (+v).toFixed(d == null ? 2 : d); }

  /* ═══════════════════════════════════════════════════════════════
     ENGINEERING — Morse test calculations
     ═══════════════════════════════════════════════════════════════ */

  /* Brake torque T = W * g * L  (N·m), W in kg, L in m */
  function brakeTorque(W_kg, L_m) { return W_kg * G * L_m; }

  /* Brake power BP = 2π N T / 60 (watts) */
  function brakePower(W_kg, L_m, N_rpm) {
    var T = brakeTorque(W_kg, L_m);
    return TAU * N_rpm * T / 60;
  }

  /* Torque-curve factor — real engines develop peak torque near mid-rpm and
     drop off at low and high rpm. Rated rpm = 1500. */
  function torqueFactor(N, N_rated) {
    var r = N / N_rated;
    if (r < 0.6) return 0.82 + 0.18 * (r / 0.6);          /* climbs from idle */
    if (r < 1.2) return 1.0;                              /* flat torque band */
    if (r < 1.6) return 1.0 - 0.15 * ((r - 1.2) / 0.4);   /* gentle drop */
    return Math.max(0.55, 0.85 - 0.45 * (r - 1.6));       /* sharper fall-off above */
  }

  /* Steady-state BP (W). Modelled as:
       IP_active = firing_cyl × ipPerCyl × loadFactor × torqueFactor(N)
       FP        = 0.08 × full_IP                         (approx constant)
       BP        = max(0, IP_active − FP)
     loadFactor = 1.0 by default; varied 0..1.1 during auto load-sweep tests.
     torqueFactor models real engine torque-vs-speed bell curve. */
  function simulatedBP_W() {
    var eng = curEngine();
    var ipc = ipPerCylNow();                            /* geometry+CR driven */
    var fullIP_kW = eng.cyl * ipc;
    var firing = 0;
    for (var i = 0; i < eng.cyl; i++) if (!state.cutMask[i]) firing++;
    var lf = state.loadFactor != null ? state.loadFactor : 1.0;
    var tf = torqueFactor(state.N, 1500);                /* normalised TORQUE shape */
    /* Indicated power = indicated torque × speed. The per-cylinder anchor ipc is
       defined at rated speed (1500 rpm), so IP scales as τ(N)·(N/1500): this makes
       the brake-torque curve peak in the mid-speed band and the power curve peak
       above it, as on a real engine — instead of torque blowing up at low rpm. */
    var IP_kW = firing * ipc * lf * tf * (state.N / 1500);
    var FP_kW = 0.08 * fullIP_kW * Math.pow(state.N / 1500, 1.3);  /* FP rises with N */
    state.fpEstimate = FP_kW;
    var BP_kW = Math.max(0, IP_kW - FP_kW);
    var scatter = 1 + ((Math.sin(state.crankAngle * 0.13) * 0.005));
    return BP_kW * 1000 * scatter;
  }

  /* From BP_W (watts) and N (rpm), L (m), return W_kg required */
  function requiredW(BP_W, L_m, N_rpm) {
    if (N_rpm <= 0) return 0;
    var T = BP_W * 60 / (TAU * N_rpm);
    return T / (G * L_m);
  }

  /* Fuel mass-flow rate (kg/s) — realistic part-load BSFC curve.
     At full load BSFC = baseline; at low load BSFC rises (engines run less
     efficient at part-load because friction/pumping losses are a bigger
     fraction of total fuel energy). Idle still burns fuel (FP must be fed). */
  function fuelFlow_kgps() {
    if (!state.running) return 0;
    /* Fuel is consumed in proportion to INDICATED power (IP = BP + FP), not
       brake power. This is the physically correct model: the engine still
       burns fuel at zero brake load to overcome friction, so the fuel-rate vs
       brake-power line has a POSITIVE intercept. That intercept is exactly what
       the Willan's line method extrapolates to recover the friction power
       (FP = x-axis intercept = a/b). It also reproduces the real part-load BSFC
       rise automatically, because BSFC = m_f/BP climbs as BP → 0 while m_f → ISFC·FP.

       Calibration: at rated speed and full load, BP = (1 − f)·IP_full with the
       friction fraction f = 0.08, so η_mech,rated = 0.92. Choosing ISFC = BSFC·η_mech
       makes m_f/BP equal the preset BSFC at the full-load anchor. */
    var bsfc = bsfcNow();                               /* brake SFC at rated full load (g/kWh), CR-corrected */
    var isfc = bsfc * (1 - 0.08);                       /* indicated SFC (g/kWh): ISFC = BSFC × η_mech,rated */
    var BP_kW = Math.max(0, simulatedBP_W() / 1000);
    var FP_kW = frictionPower_W(state.N) / 1000;        /* same FP model as simulatedBP_W */
    var IP_eff_kW = BP_kW + FP_kW;                       /* indicated power: ≥ FP, never zero while running */
    /* Small bump off rated speed reflecting reduced volumetric efficiency */
    var rpmCorrection = 1 + 0.04 * Math.abs(state.N / 1500 - 1);
    var mf_g_per_h = isfc * IP_eff_kW * rpmCorrection;
    return mf_g_per_h / 3600 / 1000;                    /* kg/s */
  }

  /* Friction power (W) at a given speed — same model used in simulatedBP_W. */
  function frictionPower_W(N) {
    var eng = curEngine();
    var fullIP_kW = eng.cyl * ipPerCylNow();
    return 0.08 * fullIP_kW * Math.pow(N / 1500, 1.3) * 1000;
  }

  /* Rotating-mass (flywheel) moment of inertia, kg·m² — scales with size. */
  function engineInertia() { return 0.25 + 0.5 * displacement_L(); }

  /* ── Heat balance ─────────────────────────────────────────────
     Energy split at the current (full-load) operating point. BP fraction
     equals the brake thermal efficiency; coolant and exhaust take fixed
     realistic shares per fuel type; the remainder is "unaccounted". The
     displayed coolant ΔT and exhaust temperature are back-computed from a
     fixed cooling-water flow and the air-fuel ratio so the sheet is
     physically self-consistent. */
  function heatBalanceData() {
    var eng = curEngine();
    var mf = fuelFlow_kgps();                       /* kg/s at current point */
    var Qfuel = mf * eng.cv_kJ_per_kg;              /* kW (kJ/s) */
    var BP = simulatedBP_W() / 1000;                /* kW */
    if (Qfuel <= 0) return null;
    var bthFrac = BP / Qfuel;
    var coolFrac = eng.kind === 'petrol' ? 0.27 : 0.24;
    var exhFrac  = eng.kind === 'petrol' ? 0.32 : 0.28;
    var unaccFrac = 1 - bthFrac - coolFrac - exhFrac;
    if (unaccFrac < 0.04) {                          /* keep physically sane */
      var deficit = 0.04 - unaccFrac;
      exhFrac -= deficit * 0.6; coolFrac -= deficit * 0.4; unaccFrac = 0.04;
    }
    var Qcool = coolFrac * Qfuel, Qexh = exhFrac * Qfuel, Qunacc = unaccFrac * Qfuel;
    /* coolant: fixed lab flow → ΔT */
    var cpw = 4.187, mw = 0.30;                      /* kg/s ≈ 18 L/min */
    var dTw = Qcool / (mw * cpw);
    /* exhaust: m_g = (AF+1)·mf → exhaust gas temperature */
    var AF = eng.kind === 'petrol' ? 15 : 22;
    var mg = (AF + 1) * mf;
    var cpg = 1.10, Tamb = 30;
    var Texh = Tamb + Qexh / (mg * cpg);
    return {
      Qfuel: Qfuel, BP: BP, Qcool: Qcool, Qexh: Qexh, Qunacc: Qunacc,
      bthFrac: BP / Qfuel, coolFrac: coolFrac, exhFrac: exhFrac, unaccFrac: unaccFrac,
      mf_kg_h: mf * 3600, mw: mw, dTw: dTw, AF: AF, mg: mg, Texh: Texh, Tamb: Tamb
    };
  }

  /* ── Retardation test ─────────────────────────────────────────
     Engine at speed N, fuel cut; it decelerates under friction torque
     T_f = FP/ω. With I·ω·dω = −FP·dt the curve is ω² = ω0² − (2FP/I)·t,
     so FP is recovered from the slope of ω² vs t. */
  function retardationCurve(N) {
    var I = engineInertia();
    var w0 = TAU * N / 60;
    var FP = frictionPower_W(N);                     /* W */
    var k = 2 * FP / I;                              /* (rad/s)² per s */
    var pts = [];
    var tEnd = (w0 * w0 * 0.5) / k;                  /* time to fall to ~0.707·ω0 */
    if (!isFinite(tEnd) || tEnd <= 0) tEnd = 4;
    tEnd = Math.min(tEnd, 6);
    var steps = 10;
    for (var i = 0; i <= steps; i++) {
      var t = tEnd * i / steps;
      var w2 = Math.max(0, w0 * w0 - k * t);
      var w = Math.sqrt(w2);
      pts.push({ t: t, N: w * 60 / TAU });
    }
    return { I: I, w0: w0, FP_kW: FP / 1000, k: k, tEnd: tEnd, pts: pts };
  }

  /* Calculate Morse test results from readings array */
  function calcResults() {
    if (!state.readings.length) return null;
    var ref = null;
    var perCyl = {};       /* cylIdx -> IP_W */
    for (var i = 0; i < state.readings.length; i++) {
      var r = state.readings[i];
      if (r.cylCut === -1) ref = r;          /* all-firing reference */
      else if (r.cylCut >= 0) perCyl[r.cylCut] = r;
      /* r.cylCut === -2 (multi-cut) is logged but ignored for Morse calc */
    }
    if (!ref) return null;
    var eng = curEngine();
    var IP_sum = 0;
    var cylIPs = [];
    var complete = true;
    for (var c = 0; c < eng.cyl; c++) {
      if (perCyl[c]) {
        var ipc = ref.BP_W - perCyl[c].BP_W;
        cylIPs.push(ipc);
        IP_sum += ipc;
      } else {
        cylIPs.push(null);
        complete = false;
      }
    }
    var BP = ref.BP_W;
    var FP = complete ? Math.max(0, IP_sum - BP) : null;
    var eta = complete && IP_sum > 0 ? (BP / IP_sum) * 100 : null;
    var T_ref = brakeTorque(ref.W_kg, state.L_mm / 1000);
    /* Thermal efficiencies — require fuel mass flow at the reference condition.
       η_bth = BP × 3600 / (mf_kg/h × CV_kJ/kg) × 100% */
    var eng = curEngine();
    var mf_kg_per_s = ref.mf_kgps != null ? ref.mf_kgps : null;
    var mf_kg_per_h = mf_kg_per_s != null ? mf_kg_per_s * 3600 : null;
    var fuelEnergyPower_kW = mf_kg_per_h != null ? (mf_kg_per_h * eng.cv_kJ_per_kg) / 3600 : null;
    var eta_bth = fuelEnergyPower_kW ? (BP / 1000) / fuelEnergyPower_kW * 100 : null;
    var eta_ith = fuelEnergyPower_kW && IP_sum != null ? (IP_sum / 1000) / fuelEnergyPower_kW * 100 : null;
    var bsfc_g_per_kWh = mf_kg_per_h != null && BP > 0 ? (mf_kg_per_h * 1000) / (BP / 1000) : null;
    var isfc_g_per_kWh = mf_kg_per_h != null && IP_sum != null && IP_sum > 0 ? (mf_kg_per_h * 1000) / (IP_sum / 1000) : null;
    return {
      BP_W: BP, IP_W: complete ? IP_sum : null, FP_W: FP,
      eta: eta, T_Nm: T_ref, cylIPs: cylIPs, complete: complete, ref: ref,
      mf_kgps: mf_kg_per_s, mf_kg_per_h: mf_kg_per_h,
      eta_bth: eta_bth, eta_ith: eta_ith,
      bsfc: bsfc_g_per_kWh, isfc: isfc_g_per_kWh,
      fuel_kW: fuelEnergyPower_kW
    };
  }

  /* ═══════════════════════════════════════════════════════════════
     CANVAS — Engine drawing (industrial test rig look)
     ═══════════════════════════════════════════════════════════════ */
  var engCv = $('engine-canvas');
  var engCtx = engCv.getContext('2d');
  var resCv = $('results-canvas');
  var resCtx = resCv.getContext('2d');

  /* ── Hi-DPI / Retina crisp rendering ──────────────────────────
     The draw code works in a fixed logical coordinate space (the
     original width/height attributes). We bump the canvas backing
     store to logical × devicePixelRatio and pre-scale the context so
     text and thin lines render at full device resolution instead of
     being upscaled (blurred) by the browser. */
  var DPR = Math.max(1, Math.min(3, window.devicePixelRatio || 1));
  function setupHiDPI(canvas) {
    canvas._lw = canvas.width;          /* logical width  (coordinate space) */
    canvas._lh = canvas.height;         /* logical height */
    canvas.width  = Math.round(canvas._lw * DPR);
    canvas.height = Math.round(canvas._lh * DPR);
    /* CSS keeps the displayed size responsive (width:100%); the intrinsic
       aspect ratio is unchanged so height:auto still works. */
  }
  setupHiDPI(engCv);
  setupHiDPI(resCv);
  /* Begin a frame: reset transform to the DPR scale and clear. Returns
     the logical width/height so draw code is unchanged. */
  function beginFrame(ctx, canvas) {
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    ctx.clearRect(0, 0, canvas._lw, canvas._lh);
    ctx.textBaseline = 'alphabetic';
    return { W: canvas._lw, H: canvas._lh };
  }

  function currentBrakeLoad_kg() {
    if (!state.running) return 0;
    var BP_W = simulatedBP_W();
    return requiredW(BP_W, state.L_mm / 1000, state.N);
  }

  /* Industrial workshop palette */
  var COL = {
    floor:   '#0e131c',
    floor2:  '#161c28',
    bedTop:  '#3a3f4d',
    bedSide: '#252a36',
    block:   '#384154',
    block2:  '#2a3142',
    head:    '#4a5468',
    sump:    '#1f2433',
    accent:  '#00897b',
    bolt:    '#0a0d14',
    spark:   '#c2c8d4',
    plug:    '#1a1f2e',
    flame:   '#ff8c42',
    flameC:  '#ffe07a',
    fly:     '#222733',
    flyRim:  '#5a6478',
    coolBlue:'#42a5f5',
    coolHot: '#ef5350',
    pipe:    '#5a6478'
  };

  function drawEngine() {
    var ctx = engCtx;
    var fr = beginFrame(ctx, engCv);
    var W = fr.W, H = fr.H;
    /* workshop floor gradient */
    var bg = ctx.createLinearGradient(0, 0, 0, H);
    bg.addColorStop(0, COL.floor);
    bg.addColorStop(1, COL.floor2);
    ctx.fillStyle = bg;
    ctx.fillRect(0, 0, W, H);

    /* faint floor tiles */
    ctx.strokeStyle = 'rgba(255,255,255,0.025)';
    ctx.lineWidth = 1;
    for (var gy = 60; gy < H; gy += 60) {
      ctx.beginPath(); ctx.moveTo(0, gy); ctx.lineTo(W, gy); ctx.stroke();
    }

    /* Title bar at top */
    var eng = curEngine();
    drawTitleBar(ctx, W, eng);

    /* Bedplate / foundation at bottom (spans full width) */
    drawBedplate(ctx, W, H);

    /* Engine sits on left 55% */
    var engX = 90;            /* left edge of engine block */
    var engBottomY = H - 70;  /* sits on bedplate */

    drawEngineAssembly(ctx, engX, engBottomY, eng);

    /* Flywheel */
    var flyCx = engX + 260 + 35;
    var flyCy = engBottomY - 60;
    drawFlywheel(ctx, flyCx, flyCy);

    /* Coupling shaft + dynamometer */
    var dynoCx = flyCx + 145;
    drawDynamometer(ctx, dynoCx, flyCy, flyCx);

    /* Status LED panel (top-right) */
    drawStatusPanel(ctx, W - 168, 56);

    /* Operator hint overlay (hide during auto-test — the banner has its own narrative) */
    if (!state.autoTest) drawOperatorHint(ctx, 80, 56);

    /* Fuel burette on far-left (lab-style graduated glass tube) */
    drawFuelBurette(ctx, 18, 110, H - 240);

    /* Auto-test slim banner along the bottom edge */
    if (state.autoTest) drawAutoTestOverlay(ctx, W, H);
  }

  /* ── Auto-test progress banner — slim strip across the BOTTOM of the
     engine canvas, leaving the engine animation fully visible above. ── */
  function drawAutoTestOverlay(ctx, W, H) {
    var at = state.autoTest;
    var step = at.steps[at.stepIdx];
    if (!step) return;

    /* Slim banner pinned to bottom — 56 px tall total */
    var bh = 56;
    var by = H - bh;

    /* Dim background strip */
    var grd = ctx.createLinearGradient(0, by, 0, H);
    grd.addColorStop(0, 'rgba(13,17,23,0.85)');
    grd.addColorStop(1, 'rgba(13,17,23,0.95)');
    ctx.fillStyle = grd;
    ctx.fillRect(0, by, W, bh);
    /* Top accent line */
    ctx.fillStyle = COL.accent;
    ctx.fillRect(0, by, W, 2);

    /* === Row 1: label + step counter + countdown =================== */
    /* AUTO TEST badge (left) */
    ctx.fillStyle = COL.accent;
    ctx.fillRect(8, by + 8, 84, 16);
    ctx.fillStyle = '#0d1117';
    ctx.font = 'bold 10px Segoe UI, sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText('▶ AUTO TEST', 50, by + 20);

    /* Procedure name + standard */
    ctx.fillStyle = '#dde3f0';
    ctx.font = 'bold 11px Segoe UI, sans-serif';
    ctx.textAlign = 'left';
    ctx.fillText(at.procName, 100, by + 19);
    ctx.fillStyle = '#9ba6c4';
    ctx.font = '9px Courier New, monospace';
    var nameW = ctx.measureText(at.procName).width;
    ctx.fillText(at.std, 100, by + 32);

    /* Step counter (right) */
    var elapsed = (Date.now() - at.stepStart) / 1000;
    var remaining = Math.max(0, step.dur - elapsed);
    var totRemain = Math.max(0, at.totalSec - at.elapsedSec);
    ctx.fillStyle = '#9ba6c4';
    ctx.font = '9px Segoe UI, sans-serif';
    ctx.textAlign = 'right';
    ctx.fillText('Step ' + (at.stepIdx + 1) + ' / ' + at.steps.length, W - 110, by + 17);
    ctx.fillStyle = '#f5c842';
    ctx.font = 'bold 11px Courier New, monospace';
    ctx.fillText(totRemain.toFixed(0) + ' s remaining', W - 110, by + 31);

    /* === Cancel button (top-right corner of banner) ================== */
    var cbW = 92, cbH = 20;
    var cbX = W - cbW - 8, cbY = by + 6;
    ctx.fillStyle = '#3a1a1a';
    ctx.fillRect(cbX, cbY, cbW, cbH);
    ctx.strokeStyle = '#ef5350';
    ctx.lineWidth = 1;
    ctx.strokeRect(cbX + 0.5, cbY + 0.5, cbW - 1, cbH - 1);
    ctx.fillStyle = '#ef5350';
    ctx.font = 'bold 9px Segoe UI, sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText('✕ CANCEL', cbX + cbW / 2, cbY + 13);
    engCv._cancelBox = { x: cbX, y: cbY, w: cbW, h: cbH };

    /* === Row 2: step label across full width =================== */
    ctx.fillStyle = COL.accent;
    ctx.font = '600 10.5px Segoe UI, sans-serif';
    ctx.textAlign = 'left';
    /* truncate label if too long */
    var label = step.label;
    var labelMaxW = W - 16;
    if (ctx.measureText(label).width > labelMaxW) {
      while (label.length > 4 && ctx.measureText(label + '…').width > labelMaxW) label = label.slice(0, -1);
      label = label + '…';
    }
    ctx.fillText('▸ ' + label, 8, by + 47);

    /* === Progress bar — bottom of banner =================== */
    var pbY = by + bh - 4, pbH = 3;
    var pct = at.elapsedSec / at.totalSec;
    ctx.fillStyle = '#050709';
    ctx.fillRect(0, pbY, W, pbH);
    var fillG = ctx.createLinearGradient(0, 0, W * pct, 0);
    fillG.addColorStop(0, COL.accent);
    fillG.addColorStop(1, '#4dd0c1');
    ctx.fillStyle = fillG;
    ctx.fillRect(0, pbY, W * pct, pbH);
  }

  function wrapText(ctx, text, maxW) {
    var words = text.split(' ');
    var lines = [];
    var cur = '';
    for (var i = 0; i < words.length; i++) {
      var test = cur ? cur + ' ' + words[i] : words[i];
      if (ctx.measureText(test).width > maxW) {
        if (cur) lines.push(cur);
        cur = words[i];
      } else cur = test;
    }
    if (cur) lines.push(cur);
    return lines.slice(0, 2);
  }

  /* ── Fuel burette ─────────────────────────────────────────── */
  function drawFuelBurette(ctx, x, y, h) {
    var eng = curEngine();
    var w = 24;
    /* Mounting bracket */
    ctx.fillStyle = '#5a6478';
    ctx.fillRect(x - 4, y - 8, w + 8, 6);
    ctx.fillRect(x - 4, y + h - 6, w + 8, 6);
    /* Glass tube */
    ctx.fillStyle = 'rgba(180,220,255,0.06)';
    ctx.fillRect(x, y, w, h);
    ctx.strokeStyle = '#5a6478';
    ctx.lineWidth = 1;
    ctx.strokeRect(x + 0.5, y + 0.5, w - 1, h - 1);
    /* Fuel level — animates downward when running */
    var fuelLevel = 0.85;     /* fraction of tube full */
    if (state.running) {
      /* slow drain animation tied to crankAngle so it visibly drops */
      var drained = (state.crankAngle * 0.0005) % 0.6;
      fuelLevel = 0.85 - drained;
    }
    if (state._burette == null) state._burette = fuelLevel;
    /* smooth track */
    state._burette += (fuelLevel - state._burette) * 0.05;
    var levelY = y + (1 - state._burette) * (h - 4) + 2;
    /* Fuel column (amber for petrol, blue-grey for diesel) */
    var fc = eng.kind === 'petrol' ? '#ff9800' : '#42a5f5';
    var fc2 = eng.kind === 'petrol' ? '#e65100' : '#1565c0';
    var grd = ctx.createLinearGradient(x, levelY, x + w, levelY);
    grd.addColorStop(0, fc2);
    grd.addColorStop(0.5, fc);
    grd.addColorStop(1, fc2);
    ctx.fillStyle = grd;
    ctx.fillRect(x + 1, levelY, w - 2, h - (levelY - y) - 2);
    /* Surface meniscus highlight */
    ctx.fillStyle = 'rgba(255,255,255,0.4)';
    ctx.fillRect(x + 1, levelY, w - 2, 2);

    /* Graduation ticks (every 10%) */
    ctx.strokeStyle = '#9ba6c4';
    ctx.lineWidth = 1;
    ctx.fillStyle = '#9ba6c4';
    ctx.font = '7px Courier New, monospace';
    ctx.textAlign = 'left';
    for (var t = 0; t <= 10; t++) {
      var ty = y + 2 + (t / 10) * (h - 4);
      var tickW = t % 5 === 0 ? 6 : 3;
      ctx.beginPath();
      ctx.moveTo(x + w, ty); ctx.lineTo(x + w + tickW, ty);
      ctx.stroke();
      if (t % 5 === 0) {
        ctx.fillText(String(100 - t * 10), x + w + 8, ty + 2);
      }
    }
    /* Outlet pipe (curving toward engine intake / fuel pump) */
    ctx.strokeStyle = '#3a3540';
    ctx.lineWidth = 4;
    ctx.lineCap = 'round';
    ctx.beginPath();
    ctx.moveTo(x + w / 2, y + h);
    ctx.quadraticCurveTo(x + 20, y + h + 18, x + 50, y + h + 20);
    ctx.stroke();
    /* Inlet at top with cap */
    ctx.fillStyle = '#5a6478';
    ctx.beginPath();
    ctx.arc(x + w / 2, y, 4, 0, TAU);
    ctx.fill();

    /* Label + live flow rate */
    var mf = state.running ? fuelFlow_kgps() * 3600 * 1000 : 0;
    ctx.fillStyle = '#6b7a99';
    ctx.font = 'bold 8px Segoe UI, sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText('FUEL', x + w / 2, y - 26);
    ctx.fillText('BURETTE', x + w / 2, y - 16);
    /* Digital flow display */
    ctx.fillStyle = '#0a0d14';
    ctx.fillRect(x - 6, y + h + 32, w + 12, 24);
    ctx.strokeStyle = '#ffc857';
    ctx.lineWidth = 1;
    ctx.strokeRect(x - 6, y + h + 32, w + 12, 24);
    ctx.fillStyle = '#ffc857';
    ctx.font = 'bold 10px Courier New, monospace';
    ctx.textAlign = 'center';
    ctx.fillText(fmt(toD(mf, 'fuelrate'), 2), x + w / 2, y + h + 46);
    ctx.fillStyle = '#6b7a99';
    ctx.font = '7px Segoe UI, sans-serif';
    ctx.fillText(uLabel('fuelrate'), x + w / 2, y + h + 54);
  }

  /* ── Title bar ─────────────────────────────────────────────── */
  function drawTitleBar(ctx, W, eng) {
    var grd = ctx.createLinearGradient(0, 0, 0, 44);
    grd.addColorStop(0, '#1a1f2e'); grd.addColorStop(1, '#0d1117');
    ctx.fillStyle = grd;
    ctx.fillRect(0, 0, W, 44);
    ctx.strokeStyle = COL.accent;
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(0, 44); ctx.lineTo(W, 44); ctx.stroke();

    ctx.fillStyle = COL.accent;
    ctx.font = 'bold 15px Segoe UI, sans-serif';
    ctx.textAlign = 'left';
    ctx.fillText('▣ MORSE TEST RIG', 14, 26);

    ctx.fillStyle = '#dde3f0';
    ctx.font = '11px Segoe UI, sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText(eng.name.toUpperCase() + '   •   ' +
      (eng.kind === 'petrol' ? 'SPARK IGNITION (SI)' : 'COMPRESSION IGNITION (CI)') +
      '   •   FIRING ORDER ' + eng.firingOrder.join('-'), W / 2, 20);

    /* Geometry nameplate line */
    ctx.fillStyle = '#80cbc4';
    ctx.font = '9.5px Courier New, monospace';
    ctx.textAlign = 'center';
    ctx.fillText(
      fmt(toD(curBore(), 'length'), isImp() ? 2 : 0) + '×' + fmt(toD(curStroke(), 'length'), isImp() ? 2 : 0) + ' ' + uLabel('length') + '  ·  ' +
      fmt(toD(displacement_L(), 'volume'), 2) + ' ' + uLabel('volume') + '  ·  CR ' + curCR().toFixed(1) + '  ·  ' +
      boreStrokeClass(),
      W / 2, 35);

    ctx.fillStyle = '#6b7a99';
    ctx.font = '11px Courier New, monospace';
    ctx.textAlign = 'right';
    ctx.fillText('N = ' + state.N + ' rpm', W - 14, 20);
  }

  /* ── Bedplate / foundation ─────────────────────────────────── */
  function drawBedplate(ctx, W, H) {
    /* Foundation block */
    var bY = H - 70;
    var grd = ctx.createLinearGradient(0, bY, 0, H);
    grd.addColorStop(0, COL.bedTop);
    grd.addColorStop(1, COL.bedSide);
    ctx.fillStyle = grd;
    ctx.fillRect(20, bY, W - 40, 50);
    /* Top edge highlight */
    ctx.strokeStyle = '#5a6478';
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(20, bY); ctx.lineTo(W - 20, bY); ctx.stroke();
    /* Foundation bolts (hex heads) */
    ctx.fillStyle = COL.bolt;
    for (var bx = 50; bx < W - 40; bx += 80) {
      drawBolt(ctx, bx, bY + 12, 5);
    }
    /* Floor shadow under bed */
    var shGrd = ctx.createLinearGradient(0, H - 14, 0, H);
    shGrd.addColorStop(0, 'rgba(0,0,0,0.3)');
    shGrd.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.fillStyle = shGrd;
    ctx.fillRect(20, H - 20, W - 40, 14);
    /* Bed nameplate */
    ctx.fillStyle = '#0d1117';
    ctx.fillRect(W / 2 - 60, bY + 22, 120, 18);
    ctx.strokeStyle = '#5a6478';
    ctx.strokeRect(W / 2 - 60, bY + 22, 120, 18);
    ctx.fillStyle = COL.accent;
    ctx.font = 'bold 9px Courier New, monospace';
    ctx.textAlign = 'center';
    ctx.fillText('MECHSIMULATOR LAB', W / 2, bY + 34);
  }

  function drawBolt(ctx, x, y, r) {
    ctx.save();
    ctx.translate(x, y);
    ctx.fillStyle = '#1a1f2e';
    ctx.strokeStyle = '#5a6478';
    ctx.lineWidth = 1;
    ctx.beginPath();
    for (var i = 0; i < 6; i++) {
      var a = i * Math.PI / 3;
      var px = Math.cos(a) * r, py = Math.sin(a) * r;
      if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
    }
    ctx.closePath();
    ctx.fill(); ctx.stroke();
    /* center dot */
    ctx.fillStyle = '#5a6478';
    ctx.beginPath(); ctx.arc(0, 0, 1.2, 0, TAU); ctx.fill();
    ctx.restore();
  }

  /* ── Engine assembly: sump + block + head + valve cover + plumbing ─── */
  function drawEngineAssembly(ctx, x, bottomY, eng) {
    var n = eng.cyl;
    /* Layout — fixed visual size; pistons inside */
    var bw = 240;                   /* block width */
    var bh = 130;                   /* block height */
    var headH = 28;
    var coverH = 18;
    var sumpH = 38;
    var blockY = bottomY - sumpH - bh;
    var headY = blockY - headH;
    var coverY = headY - coverH;

    /* Sump (trapezoid) */
    ctx.fillStyle = COL.sump;
    ctx.strokeStyle = '#0a0d14';
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(x + 8, blockY + bh);
    ctx.lineTo(x + 28, bottomY);
    ctx.lineTo(x + bw - 28, bottomY);
    ctx.lineTo(x + bw - 8, blockY + bh);
    ctx.closePath();
    ctx.fill(); ctx.stroke();
    /* sump bolts row */
    for (var sb = x + 16; sb < x + bw - 12; sb += 14) {
      drawBolt(ctx, sb, blockY + bh + 4, 2);
    }
    /* oil drain */
    ctx.fillStyle = '#0d1117';
    ctx.fillRect(x + bw / 2 - 5, bottomY - 4, 10, 6);

    /* Engine block (main rectangle) */
    var bgrd = ctx.createLinearGradient(x, blockY, x + bw, blockY);
    bgrd.addColorStop(0, COL.block2);
    bgrd.addColorStop(0.5, COL.block);
    bgrd.addColorStop(1, COL.block2);
    ctx.fillStyle = bgrd;
    ctx.fillRect(x, blockY, bw, bh);
    /* edge highlights */
    ctx.strokeStyle = '#5a6478';
    ctx.lineWidth = 1;
    ctx.strokeRect(x + 0.5, blockY + 0.5, bw - 1, bh - 1);
    /* Block manufacturer marking */
    ctx.fillStyle = 'rgba(255,255,255,0.06)';
    ctx.font = 'bold 24px Segoe UI, sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText('M·S', x + bw / 2, blockY + 32);

    /* Cooling jacket vents (small horizontal lines on side) */
    ctx.strokeStyle = 'rgba(0,0,0,0.4)';
    ctx.lineWidth = 1;
    for (var vy = blockY + 50; vy < blockY + bh - 20; vy += 8) {
      ctx.beginPath();
      ctx.moveTo(x + 6, vy); ctx.lineTo(x + 24, vy);
      ctx.moveTo(x + bw - 24, vy); ctx.lineTo(x + bw - 6, vy);
      ctx.stroke();
    }

    /* Crankcase window — shows pistons + crankshaft */
    var winX = x + 18, winY = blockY + 14, winW = bw - 36, winH = bh - 28;
    ctx.fillStyle = '#0a0e16';
    ctx.fillRect(winX, winY, winW, winH);
    ctx.strokeStyle = '#000';
    ctx.strokeRect(winX, winY, winW, winH);
    /* draw pistons inside the window */
    var cylSpacing = winW / n;
    for (var i = 0; i < n; i++) {
      var cx = winX + i * cylSpacing + cylSpacing / 2;
      drawCylinderInWindow(ctx, cx, winY, winH, cylSpacing - 4, i, eng);
    }
    /* horizontal crankshaft trough */
    ctx.fillStyle = '#000';
    ctx.fillRect(winX, winY + winH - 14, winW, 14);
    /* rotating crankshaft visible */
    var crCx = winX + winW / 2;
    var crCy = winY + winH - 7;
    ctx.save();
    ctx.translate(crCx, crCy);
    ctx.rotate(state.crankAngle);
    ctx.strokeStyle = COL.accent;
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(-4, 0); ctx.lineTo(4, 0); ctx.stroke();
    ctx.restore();

    /* Head (above block) */
    ctx.fillStyle = COL.head;
    ctx.fillRect(x - 4, headY, bw + 8, headH);
    ctx.strokeStyle = '#5a6478';
    ctx.lineWidth = 1;
    ctx.strokeRect(x - 4 + 0.5, headY + 0.5, bw + 8 - 1, headH - 1);
    /* head gasket line */
    ctx.fillStyle = '#0a0d14';
    ctx.fillRect(x - 4, blockY - 2, bw + 8, 2);
    /* head bolts */
    for (var hb = x; hb < x + bw; hb += 28) {
      drawBolt(ctx, hb + 6, headY + 6, 2);
    }

    /* Valve cover (top) */
    var cvGrd = ctx.createLinearGradient(0, coverY, 0, coverY + coverH);
    cvGrd.addColorStop(0, '#5a6478');
    cvGrd.addColorStop(1, '#3a4258');
    ctx.fillStyle = cvGrd;
    ctx.fillRect(x + 4, coverY, bw - 8, coverH);
    ctx.strokeStyle = '#0a0d14';
    ctx.lineWidth = 1;
    ctx.strokeRect(x + 4 + 0.5, coverY + 0.5, bw - 8 - 1, coverH - 1);
    /* ribbed pattern */
    ctx.strokeStyle = 'rgba(255,255,255,0.1)';
    for (var rb = coverY + 4; rb < coverY + coverH - 2; rb += 4) {
      ctx.beginPath(); ctx.moveTo(x + 10, rb); ctx.lineTo(x + bw - 10, rb); ctx.stroke();
    }
    /* Manufacturer logo on cover */
    ctx.fillStyle = COL.accent;
    ctx.font = 'bold 9px Segoe UI, sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText('MORSE-' + n, x + bw / 2, coverY + 12);

    /* Spark plugs sticking out of head, one per cylinder */
    var plugSpacing = bw / n;
    for (var p = 0; p < n; p++) {
      var px = x + p * plugSpacing + plugSpacing / 2;
      drawSparkPlug(ctx, px, coverY, p, eng);
    }

    /* Distributor cap (right of head) for petrol */
    if (eng.kind === 'petrol') {
      drawDistributor(ctx, x + bw + 12, headY + headH / 2, n);
    } else {
      drawFuelPump(ctx, x + bw + 12, headY + headH / 2);
    }

    /* Intake manifold (left side, blue-grey) */
    drawIntakeManifold(ctx, x - 24, headY, headH, n);

    /* Exhaust manifold (right side of head extending right then down to exhaust pipe) */
    drawExhaustManifold(ctx, x + bw + 4, headY, headH, bottomY);

    /* Cylinder number labels under the engine */
    ctx.fillStyle = '#9ba6c4';
    ctx.font = 'bold 10px Segoe UI, sans-serif';
    ctx.textAlign = 'center';
    for (var k = 0; k < n; k++) {
      var lx = winX + k * cylSpacing + cylSpacing / 2;
      ctx.fillText('Cyl ' + (k + 1), lx, blockY + bh + 26);
    }

    /* Save anchor points */
    return { x: x, bw: bw, blockY: blockY, headY: headY, coverY: coverY };
  }

  function drawCylinderInWindow(ctx, cx, winY, winH, w, idx, eng) {
    var cut = state.cutMask[idx];
    /* Bore width scales visually with actual bore (50–150 mm → 0.7–1.0 of slot) */
    var boreScale = 0.55 + 0.45 * ((curBore() - 50) / 100);   /* 0.55..1.0 */
    var bw = Math.min(w, 34) * Math.max(0.5, Math.min(1, boreScale));
    var bx = cx - bw / 2;
    var by = winY + 2;
    var bh = winH - 14;
    ctx.fillStyle = '#050709';
    ctx.fillRect(bx, by, bw, bh);
    ctx.strokeStyle = cut ? '#5a3030' : '#3a4060';
    ctx.lineWidth = 1;
    ctx.strokeRect(bx + 0.5, by + 0.5, bw - 1, bh - 1);

    /* Piston (rectangle that moves up/down inside bore) */
    var phase = (idx * 2 * Math.PI) / eng.cyl;
    var p = state.running ? (Math.sin(state.crankAngle + phase) + 1) / 2 : 0.5;
    var pistonH = 20;
    /* Stroke length scales the travel range (50–150 mm → 0.65–1.0 of available) */
    var strokeScale = 0.65 + 0.35 * ((curStroke() - 50) / 100);
    var fullTravel = bh - pistonH - 14;
    var travel = fullTravel * Math.max(0.5, Math.min(1, strokeScale));
    var pistonY = by + 4 + (fullTravel - travel) + (1 - p) * travel;   /* p=1 means TDC */

    /* combustion chamber glow if firing */
    var firingNow = state.running && !cut && p > 0.85;
    if (firingNow) {
      var glow = ctx.createRadialGradient(cx, by + 6, 0, cx, by + 6, 14);
      glow.addColorStop(0, 'rgba(255,224,122,0.95)');
      glow.addColorStop(0.4, 'rgba(255,140,66,0.7)');
      glow.addColorStop(1, 'rgba(255,140,66,0)');
      ctx.fillStyle = glow;
      ctx.fillRect(bx, by, bw, 18);
    }

    /* piston body (metallic) */
    var pgrd = ctx.createLinearGradient(bx, pistonY, bx + bw, pistonY);
    pgrd.addColorStop(0, cut ? '#2a2530' : '#5a6478');
    pgrd.addColorStop(0.5, cut ? '#3a3540' : '#8a92a8');
    pgrd.addColorStop(1, cut ? '#2a2530' : '#5a6478');
    ctx.fillStyle = pgrd;
    ctx.fillRect(bx + 1, pistonY, bw - 2, pistonH);
    /* piston rings */
    ctx.fillStyle = cut ? '#1a1520' : '#2a3050';
    ctx.fillRect(bx + 1, pistonY + 2, bw - 2, 1);
    ctx.fillRect(bx + 1, pistonY + 5, bw - 2, 1);
    ctx.fillRect(bx + 1, pistonY + 8, bw - 2, 1);

    /* connecting rod */
    ctx.strokeStyle = cut ? '#444' : '#9ba6c4';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(cx, pistonY + pistonH);
    ctx.lineTo(cx, by + bh - 4);
    ctx.stroke();

    /* OFF indicator */
    if (cut) {
      ctx.fillStyle = 'rgba(255,85,85,0.15)';
      ctx.fillRect(bx, by, bw, bh);
      ctx.fillStyle = '#ff5555';
      ctx.font = 'bold 8px Segoe UI, sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('OFF', cx, by + bh / 2 + 3);
    }
  }

  function drawSparkPlug(ctx, x, coverY, idx, eng) {
    var cut = state.cutMask[idx];
    /* Plug body (ceramic insulator) */
    ctx.fillStyle = cut ? '#3a3540' : '#dde3f0';
    ctx.fillRect(x - 3, coverY - 14, 6, 14);
    ctx.strokeStyle = '#0a0d14';
    ctx.lineWidth = 1;
    ctx.strokeRect(x - 3, coverY - 14, 6, 14);
    /* Plug terminal cap (top) */
    ctx.fillStyle = cut ? '#222' : '#1a1f2e';
    ctx.fillRect(x - 4, coverY - 18, 8, 4);
    /* HT lead — coloured wire going up */
    ctx.strokeStyle = cut ? '#444' : (eng.kind === 'petrol' ? '#ef5350' : '#42a5f5');
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(x, coverY - 18);
    ctx.bezierCurveTo(x, coverY - 28, x + 14, coverY - 32, x + 20, coverY - 38);
    ctx.stroke();

    /* Indicator LED above plug */
    var ledOn = state.running && !cut;
    ctx.fillStyle = cut ? '#3a0a0a' : (ledOn ? '#3ddc84' : '#1a3a1a');
    ctx.beginPath();
    ctx.arc(x, coverY - 24, 3, 0, TAU);
    ctx.fill();
    if (ledOn) {
      ctx.fillStyle = 'rgba(61,220,132,0.4)';
      ctx.beginPath();
      ctx.arc(x, coverY - 24, 6, 0, TAU);
      ctx.fill();
    }
    if (cut) {
      /* red X over LED */
      ctx.strokeStyle = '#ff5555';
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(x - 4, coverY - 28); ctx.lineTo(x + 4, coverY - 20);
      ctx.moveTo(x + 4, coverY - 28); ctx.lineTo(x - 4, coverY - 20);
      ctx.stroke();
    }
  }

  function drawDistributor(ctx, x, cy, n) {
    /* round black distributor cap with n+1 towers */
    ctx.fillStyle = '#1a1f2e';
    ctx.strokeStyle = '#5a6478';
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.arc(x, cy, 14, 0, TAU);
    ctx.fill(); ctx.stroke();
    /* central HT terminal */
    ctx.fillStyle = '#ef5350';
    ctx.beginPath(); ctx.arc(x, cy, 3, 0, TAU); ctx.fill();
    /* small terminals around */
    for (var i = 0; i < n; i++) {
      var a = (i / n) * TAU - Math.PI / 2;
      var tx = x + Math.cos(a) * 9;
      var ty = cy + Math.sin(a) * 9;
      ctx.fillStyle = '#444';
      ctx.beginPath(); ctx.arc(tx, ty, 1.5, 0, TAU); ctx.fill();
    }
    ctx.fillStyle = '#6b7a99';
    ctx.font = '8px Segoe UI, sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText('DIST', x, cy - 22);
  }

  function drawFuelPump(ctx, x, cy) {
    ctx.fillStyle = '#1a1f2e';
    ctx.strokeStyle = '#5a6478';
    ctx.lineWidth = 1.5;
    ctx.fillRect(x - 12, cy - 12, 24, 24);
    ctx.strokeRect(x - 12, cy - 12, 24, 24);
    /* pump cap */
    ctx.fillStyle = '#42a5f5';
    ctx.beginPath();
    ctx.arc(x, cy, 4, 0, TAU);
    ctx.fill();
    ctx.fillStyle = '#6b7a99';
    ctx.font = '8px Segoe UI, sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText('FUEL', x, cy + 22);
  }

  function drawIntakeManifold(ctx, x, headY, headH, n) {
    /* horizontal trunk pipe */
    ctx.fillStyle = '#42a5f5';
    ctx.fillRect(x - 8, headY + 4, 12, headH - 8);
    /* tag */
    ctx.fillStyle = '#6b7a99';
    ctx.font = '8px Segoe UI, sans-serif';
    ctx.textAlign = 'right';
    ctx.save();
    ctx.translate(x - 14, headY + headH / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.fillText('INTAKE AIR →', 0, 0);
    ctx.restore();
  }

  function drawExhaustManifold(ctx, x, headY, headH, bottomY) {
    /* manifold runners merge into one downward pipe */
    ctx.fillStyle = '#3a3540';
    ctx.fillRect(x, headY + 4, 10, headH - 8);
    /* curved pipe down */
    ctx.strokeStyle = '#5a4030';
    ctx.lineWidth = 8;
    ctx.lineCap = 'round';
    ctx.beginPath();
    ctx.moveTo(x + 5, headY + headH);
    ctx.bezierCurveTo(x + 14, headY + headH + 30, x + 22, bottomY - 60, x + 40, bottomY - 70);
    ctx.stroke();
    /* outlet flange */
    ctx.fillStyle = '#3a3540';
    ctx.fillRect(x + 36, bottomY - 78, 20, 14);
    /* exhaust smoke puffs (if engine running) */
    if (state.running) {
      var puff = (state.crankAngle * 6) % TAU;
      var px = x + 56 + (puff / TAU) * 30;
      var py = bottomY - 72 - (puff / TAU) * 12;
      var alpha = 0.4 * (1 - puff / TAU);
      ctx.fillStyle = 'rgba(180,180,180,' + alpha + ')';
      ctx.beginPath(); ctx.arc(px, py, 8 + puff, 0, TAU); ctx.fill();
    }
    ctx.fillStyle = '#6b7a99';
    ctx.font = '8px Segoe UI, sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText('EXHAUST', x + 28, bottomY - 100);
  }

  /* ── Flywheel ─────────────────────────────────────────────── */
  function drawFlywheel(ctx, cx, cy) {
    /* shaft from engine to flywheel */
    ctx.fillStyle = '#5a6478';
    ctx.fillRect(cx - 70, cy - 3, 40, 6);
    /* Flywheel disc */
    var r = 32;
    var grd = ctx.createRadialGradient(cx, cy, 4, cx, cy, r);
    grd.addColorStop(0, '#384154');
    grd.addColorStop(0.5, COL.fly);
    grd.addColorStop(1, '#0d1117');
    ctx.fillStyle = grd;
    ctx.beginPath(); ctx.arc(cx, cy, r, 0, TAU); ctx.fill();
    /* rim */
    ctx.strokeStyle = COL.flyRim;
    ctx.lineWidth = 2;
    ctx.beginPath(); ctx.arc(cx, cy, r - 1, 0, TAU); ctx.stroke();
    /* mounting holes */
    ctx.save();
    ctx.translate(cx, cy);
    ctx.rotate(state.crankAngle * 0.5);
    for (var i = 0; i < 6; i++) {
      var a = (i / 6) * TAU;
      var hx = Math.cos(a) * 20, hy = Math.sin(a) * 20;
      ctx.fillStyle = '#0a0d14';
      ctx.beginPath(); ctx.arc(hx, hy, 3, 0, TAU); ctx.fill();
    }
    ctx.restore();
    /* spinning marker (red paint stripe) */
    ctx.save();
    ctx.translate(cx, cy);
    ctx.rotate(state.crankAngle);
    ctx.fillStyle = '#ef5350';
    ctx.fillRect(0, -2, r - 3, 3);
    ctx.restore();
    /* center hub */
    ctx.fillStyle = COL.accent;
    ctx.beginPath(); ctx.arc(cx, cy, 6, 0, TAU); ctx.fill();
    /* label */
    ctx.fillStyle = '#6b7a99';
    ctx.font = '9px Segoe UI, sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText('FLYWHEEL', cx, cy + r + 12);
  }

  /* ── Hydraulic dynamometer ─────────────────────────────────── */
  function drawDynamometer(ctx, cx, cy, flyCx) {
    /* coupling shaft from flywheel */
    ctx.fillStyle = '#5a6478';
    ctx.fillRect(flyCx + 32, cy - 3, cx - flyCx - 60, 6);

    /* Dynamometer casing — cylindrical with water jacket */
    var dynoR = 44;
    var caseG = ctx.createLinearGradient(cx - dynoR, cy - dynoR, cx + dynoR, cy + dynoR);
    caseG.addColorStop(0, '#42a5f5');
    caseG.addColorStop(0.5, '#1565c0');
    caseG.addColorStop(1, '#0d47a1');
    ctx.fillStyle = caseG;
    ctx.beginPath(); ctx.arc(cx, cy, dynoR, 0, TAU); ctx.fill();
    /* outer rim */
    ctx.strokeStyle = '#0a0d14';
    ctx.lineWidth = 2;
    ctx.beginPath(); ctx.arc(cx, cy, dynoR, 0, TAU); ctx.stroke();
    /* casing bolts (8 around perimeter) */
    for (var i = 0; i < 8; i++) {
      var a = (i / 8) * TAU;
      drawBolt(ctx, cx + Math.cos(a) * (dynoR - 6), cy + Math.sin(a) * (dynoR - 6), 2);
    }
    /* Inner rotor disc */
    var rotG = ctx.createRadialGradient(cx, cy, 4, cx, cy, 26);
    rotG.addColorStop(0, '#5a6478');
    rotG.addColorStop(1, '#1a1f2e');
    ctx.fillStyle = rotG;
    ctx.beginPath(); ctx.arc(cx, cy, 26, 0, TAU); ctx.fill();
    /* rotor markers (paddles) */
    ctx.save();
    ctx.translate(cx, cy);
    ctx.rotate(state.crankAngle);
    ctx.strokeStyle = '#dde3f0';
    ctx.lineWidth = 2;
    for (var j = 0; j < 8; j++) {
      var ra = (j / 8) * TAU;
      ctx.beginPath();
      ctx.moveTo(Math.cos(ra) * 10, Math.sin(ra) * 10);
      ctx.lineTo(Math.cos(ra) * 24, Math.sin(ra) * 24);
      ctx.stroke();
    }
    ctx.restore();
    /* center cap */
    ctx.fillStyle = COL.accent;
    ctx.beginPath(); ctx.arc(cx, cy, 6, 0, TAU); ctx.fill();
    /* nameplate — on the casing top, clear of the vertical water pipes below */
    ctx.fillStyle = 'rgba(13,17,23,0.82)';
    ctx.fillRect(cx - 29, cy - 39, 58, 13);
    ctx.fillStyle = '#cfe8ff';
    ctx.font = 'bold 8px Courier New, monospace';
    ctx.textAlign = 'center';
    ctx.fillText('HYDRAULIC', cx, cy - 29);

    /* Water inlet pipe (bottom) */
    ctx.fillStyle = COL.coolBlue;
    ctx.fillRect(cx - 4, cy + dynoR, 8, 30);
    /* Water outlet pipe (top, hot) */
    ctx.fillStyle = COL.coolHot;
    ctx.fillRect(cx - 4, cy - dynoR - 30, 8, 30);
    /* Arrows */
    ctx.fillStyle = '#fff';
    ctx.font = 'bold 9px Segoe UI, sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText('↓', cx, cy + dynoR + 22);
    ctx.fillText('↑', cx, cy - dynoR - 16);
    ctx.fillStyle = '#6b7a99';
    ctx.font = '8px Segoe UI, sans-serif';
    ctx.fillText('IN', cx + 18, cy + dynoR + 16);
    ctx.fillText('OUT', cx + 20, cy - dynoR - 14);

    /* Load arm — extends RIGHT from dyno casing */
    var L_px = Math.min(160, state.L_mm * 0.28);
    var armY = cy;
    /* arm body */
    var armG = ctx.createLinearGradient(0, armY - 5, 0, armY + 5);
    armG.addColorStop(0, '#9ba6c4');
    armG.addColorStop(0.5, '#5a6478');
    armG.addColorStop(1, '#3a4258');
    ctx.fillStyle = armG;
    ctx.fillRect(cx, armY - 5, L_px, 10);
    ctx.strokeStyle = '#0a0d14';
    ctx.strokeRect(cx, armY - 5, L_px, 10);

    /* Calibrated scale markings on arm */
    for (var s = 0; s <= 10; s++) {
      var sx = cx + (L_px / 10) * s;
      var sh = (s % 5 === 0) ? 6 : 3;
      ctx.strokeStyle = '#0d1117';
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(sx, armY - 5); ctx.lineTo(sx, armY - 5 - sh);
      ctx.stroke();
    }
    /* arm length label */
    ctx.fillStyle = COL.accent;
    ctx.font = 'bold 10px Courier New, monospace';
    ctx.textAlign = 'center';
    ctx.fillText('L = ' + fmt(toD(state.L_mm, 'length'), 0) + ' ' + uLabel('length'),
      cx + L_px / 2, armY - 20);

    /* Spring balance — hanging at end of arm */
    var balX = cx + L_px;
    var W_kg = currentBrakeLoad_kg();
    drawSpringBalance(ctx, balX, armY, W_kg);

    /* Pivot point at dyno end of arm */
    ctx.fillStyle = '#0d1117';
    ctx.strokeStyle = COL.accent;
    ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.arc(cx, armY, 5, 0, TAU);
    ctx.fill(); ctx.stroke();
  }

  function drawSpringBalance(ctx, x, y, W_kg) {
    /* hook attaching to arm */
    ctx.strokeStyle = '#9ba6c4';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(x, y + 5); ctx.lineTo(x, y + 14);
    ctx.stroke();
    /* body (clear glass cylinder) */
    var bodyY = y + 14;
    var bodyH = 60;
    var bodyW = 26;
    ctx.fillStyle = 'rgba(20,30,50,0.6)';
    ctx.fillRect(x - bodyW / 2, bodyY, bodyW, bodyH);
    ctx.strokeStyle = '#5a6478';
    ctx.lineWidth = 1.5;
    ctx.strokeRect(x - bodyW / 2, bodyY, bodyW, bodyH);
    /* scale markings */
    ctx.strokeStyle = '#9ba6c4';
    ctx.lineWidth = 1;
    for (var m = 0; m <= 10; m++) {
      var my = bodyY + 4 + (m / 10) * (bodyH - 8);
      var mw = (m % 5 === 0) ? 8 : 4;
      ctx.beginPath();
      ctx.moveTo(x - bodyW / 2 + 2, my);
      ctx.lineTo(x - bodyW / 2 + 2 + mw, my);
      ctx.stroke();
      if (m % 5 === 0) {
        ctx.fillStyle = '#9ba6c4';
        ctx.font = '7px Courier New, monospace';
        ctx.textAlign = 'left';
        ctx.fillText(String(50 - m * 5), x - bodyW / 2 + 12, my + 2);
      }
    }
    /* internal spring (zigzag) */
    ctx.strokeStyle = '#3ddc84';
    ctx.lineWidth = 1;
    ctx.beginPath();
    var maxLoad = 50;
    var loadFrac = Math.min(1, W_kg / maxLoad);
    var springStartY = bodyY + 4;
    var pointerY = springStartY + 4 + loadFrac * (bodyH - 12);
    var zigCount = 8;
    var zigStep = (pointerY - springStartY) / zigCount;
    for (var z = 0; z < zigCount; z++) {
      var zy = springStartY + z * zigStep;
      ctx.moveTo(x - 4, zy); ctx.lineTo(x + 4, zy + zigStep / 2);
      ctx.moveTo(x + 4, zy + zigStep / 2); ctx.lineTo(x - 4, zy + zigStep);
    }
    ctx.stroke();
    /* pointer arrow */
    ctx.fillStyle = '#ef5350';
    ctx.beginPath();
    ctx.moveTo(x + bodyW / 2, pointerY);
    ctx.lineTo(x + bodyW / 2 + 8, pointerY - 4);
    ctx.lineTo(x + bodyW / 2 + 8, pointerY + 4);
    ctx.closePath();
    ctx.fill();
    /* Digital readout box below balance */
    var dgY = bodyY + bodyH + 6;
    ctx.fillStyle = '#0a0d14';
    ctx.fillRect(x - 22, dgY, 44, 22);
    ctx.strokeStyle = COL.accent;
    ctx.lineWidth = 1;
    ctx.strokeRect(x - 22, dgY, 44, 22);
    ctx.fillStyle = '#f5c842';
    ctx.font = 'bold 11px Courier New, monospace';
    ctx.textAlign = 'center';
    ctx.fillText(fmt(toD(W_kg, 'load'), 1), x, dgY + 13);
    ctx.fillStyle = '#6b7a99';
    ctx.font = '7px Segoe UI, sans-serif';
    ctx.fillText(uLabel('load'), x, dgY + 20);
    /* label */
    ctx.fillStyle = '#6b7a99';
    ctx.font = '8px Segoe UI, sans-serif';
    ctx.fillText('SPRING', x, bodyY - 4);
    ctx.fillText('BALANCE', x, bodyY - 13);
  }

  /* ── Status panel (top-right) ──────────────────────────────── */
  function drawStatusPanel(ctx, x, y) {
    var w = 152, h = 92;
    ctx.fillStyle = '#0a0d14';
    ctx.strokeStyle = '#2a3050';
    ctx.lineWidth = 1;
    ctx.fillRect(x, y, w, h);
    ctx.strokeRect(x, y, w, h);
    /* LED + RUNNING/STOPPED */
    var on = state.running;
    var blink = on && (Math.floor(Date.now() / 500) % 2 === 0);
    ctx.fillStyle = on ? (blink ? '#3ddc84' : '#26a69a') : '#3a1414';
    ctx.beginPath(); ctx.arc(x + 14, y + 14, 6, 0, TAU); ctx.fill();
    if (on) {
      ctx.fillStyle = 'rgba(61,220,132,0.3)';
      ctx.beginPath(); ctx.arc(x + 14, y + 14, 10, 0, TAU); ctx.fill();
    }
    ctx.fillStyle = '#dde3f0';
    ctx.font = 'bold 11px Segoe UI, sans-serif';
    ctx.textAlign = 'left';
    ctx.fillText(on ? 'RUNNING' : 'STOPPED', x + 26, y + 18);

    /* Phase */
    ctx.fillStyle = '#6b7a99';
    ctx.font = '9px Segoe UI, sans-serif';
    ctx.fillText('PHASE', x + 8, y + 34);
    ctx.fillStyle = COL.accent;
    ctx.font = 'bold 10px Courier New, monospace';
    ctx.fillText(state.phase, x + 8, y + 47);

    /* Throttle / Load indicator ── important for auto load sweep */
    var lf = state.loadFactor != null ? state.loadFactor : 1.0;
    var loadPct = lf * 100;
    ctx.fillStyle = '#6b7a99';
    ctx.font = '9px Segoe UI, sans-serif';
    ctx.fillText('THROTTLE', x + 8, y + 62);
    ctx.fillStyle = '#f5c842';
    ctx.font = 'bold 10px Courier New, monospace';
    ctx.textAlign = 'right';
    ctx.fillText(Math.round(loadPct) + '%', x + w - 8, y + 62);
    /* horizontal bar */
    var lbX = x + 8, lbY = y + 66, lbW = w - 16, lbH = 6;
    ctx.fillStyle = '#1a1f2e';
    ctx.fillRect(lbX, lbY, lbW, lbH);
    ctx.strokeStyle = '#2a3050';
    ctx.lineWidth = 1;
    ctx.strokeRect(lbX + 0.5, lbY + 0.5, lbW - 1, lbH - 1);
    /* fill — green to red at high load */
    var fillW = Math.min(1.1, lf) / 1.1 * lbW;
    var lG = ctx.createLinearGradient(lbX, 0, lbX + lbW, 0);
    lG.addColorStop(0, '#3ddc84');
    lG.addColorStop(0.7, '#f5c842');
    lG.addColorStop(1, '#ef5350');
    ctx.fillStyle = lG;
    ctx.fillRect(lbX + 1, lbY + 1, Math.max(0, fillW - 2), lbH - 2);
    /* 100% tick */
    var tk = lbX + (1 / 1.1) * lbW;
    ctx.strokeStyle = '#9ba6c4';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(tk, lbY - 1); ctx.lineTo(tk, lbY + lbH + 1);
    ctx.stroke();

    /* Readings counter */
    var nCyl = curEngine().cyl;
    var got = state.readings.length;
    var need = nCyl + 1;
    ctx.fillStyle = '#6b7a99';
    ctx.font = '9px Segoe UI, sans-serif';
    ctx.textAlign = 'right';
    ctx.fillText(got + '/' + need + ' rec', x + w - 8, y + 86);
  }

  /* ── Operator hint (top-left small card) ───────────────────── */
  function drawOperatorHint(ctx, x, y) {
    var hasResults = state.readings.length > 0 ||
                     state.curveData.load.length || state.curveData.speed.length || state.curveData.willans.length;
    var hint;
    if (!state.running && !hasResults) hint = 'Press RUN TEST';
    else if (!state.running) hint = 'Test data ready';
    else hint = 'Press RUN TEST';

    var w = 152, h = 36;
    ctx.fillStyle = '#0a0d14';
    ctx.strokeStyle = COL.accent;
    ctx.lineWidth = 1;
    ctx.fillRect(x, y, w, h);
    ctx.strokeRect(x, y, w, h);
    ctx.fillStyle = '#6b7a99';
    ctx.font = '8px Segoe UI, sans-serif';
    ctx.textAlign = 'left';
    ctx.fillText('NEXT STEP', x + 8, y + 12);
    ctx.fillStyle = COL.accent;
    ctx.font = 'bold 11px Segoe UI, sans-serif';
    ctx.fillText('→ ' + hint, x + 8, y + 27);
  }

  /* ═══════════════════════════════════════════════════════════════
     CANVAS — Instrument Cluster + Bar Chart
     ═══════════════════════════════════════════════════════════════ */
  function drawResults() {
    var ctx = resCtx;
    var fr = beginFrame(ctx, resCv);
    var W = fr.W, H = fr.H;
    /* Dark panel background */
    var bg = ctx.createLinearGradient(0, 0, 0, H);
    bg.addColorStop(0, '#0c1018'); bg.addColorStop(1, '#1a1f2e');
    ctx.fillStyle = bg; ctx.fillRect(0, 0, W, H);

    /* Panel title strip */
    var tGrd = ctx.createLinearGradient(0, 0, 0, 28);
    tGrd.addColorStop(0, '#1a1f2e'); tGrd.addColorStop(1, '#0d1117');
    ctx.fillStyle = tGrd;
    ctx.fillRect(0, 0, W, 28);
    ctx.strokeStyle = COL.accent;
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(0, 28); ctx.lineTo(W, 28); ctx.stroke();
    ctx.fillStyle = COL.accent;
    ctx.font = 'bold 12px Segoe UI, sans-serif';
    ctx.textAlign = 'left';
    ctx.fillText('▣ INSTRUMENT CLUSTER', 10, 19);
    ctx.fillStyle = '#dde3f0';
    ctx.textAlign = 'right';
    ctx.font = '10px Courier New, monospace';
    ctx.fillText('MORSE TEST CONSOLE', W - 10, 19);

    /* Instrument cluster: tachometer (left) + LED readouts (right) */
    drawTachometer(ctx, 78, 110);
    drawLEDPanel(ctx, 170, 40);

    /* Divider line */
    ctx.strokeStyle = '#2a3050';
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(10, 195); ctx.lineTo(W - 10, 195); ctx.stroke();

    /* Bar chart in bottom half */
    drawTestChart(ctx, W, H);
  }

  /* ── Analog tachometer dial ─────────────────────────────────── */
  function drawTachometer(ctx, cx, cy) {
    var r = 60;
    /* outer bezel */
    var bg = ctx.createRadialGradient(cx - 12, cy - 12, 6, cx, cy, r + 6);
    bg.addColorStop(0, '#5a6478');
    bg.addColorStop(1, '#0a0d14');
    ctx.fillStyle = bg;
    ctx.beginPath(); ctx.arc(cx, cy, r + 5, 0, TAU); ctx.fill();
    /* dial face */
    var face = ctx.createRadialGradient(cx, cy, 4, cx, cy, r);
    face.addColorStop(0, '#1a1f2e');
    face.addColorStop(1, '#050709');
    ctx.fillStyle = face;
    ctx.beginPath(); ctx.arc(cx, cy, r, 0, TAU); ctx.fill();
    ctx.strokeStyle = '#2a3050';
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.arc(cx, cy, r, 0, TAU); ctx.stroke();

    /* Scale: 0 to 4000 rpm, angle 225° to -45° (sweeping 270°) */
    var rpmMax = 4000;
    var startA = Math.PI * 0.75;   /* lower-left */
    var endA = Math.PI * 2.25;     /* lower-right (sweeping clockwise through top) */
    /* major ticks every 500 rpm, minor every 100 */
    for (var v = 0; v <= rpmMax; v += 100) {
      var a = startA + (v / rpmMax) * (endA - startA);
      var inner = (v % 500 === 0) ? r - 12 : r - 6;
      var outer = r - 2;
      ctx.strokeStyle = v >= 3000 ? '#ef5350' : '#9ba6c4';
      ctx.lineWidth = (v % 500 === 0) ? 2 : 1;
      ctx.beginPath();
      ctx.moveTo(cx + Math.cos(a) * inner, cy + Math.sin(a) * inner);
      ctx.lineTo(cx + Math.cos(a) * outer, cy + Math.sin(a) * outer);
      ctx.stroke();
      if (v % 1000 === 0) {
        var lx = cx + Math.cos(a) * (r - 22);
        var ly = cy + Math.sin(a) * (r - 22);
        ctx.fillStyle = '#dde3f0';
        ctx.font = 'bold 9px Courier New, monospace';
        ctx.textAlign = 'center';
        ctx.fillText(String(v / 1000), lx, ly + 3);
      }
    }
    /* "RPM x 1000" label */
    ctx.fillStyle = '#6b7a99';
    ctx.font = '8px Segoe UI, sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText('RPM x 1000', cx, cy + 18);
    /* Redline arc */
    ctx.strokeStyle = '#ef5350';
    ctx.lineWidth = 3;
    var ra1 = startA + (3000 / rpmMax) * (endA - startA);
    var ra2 = endA;
    ctx.beginPath(); ctx.arc(cx, cy, r - 4, ra1, ra2); ctx.stroke();

    /* Needle */
    var rpm = state.running ? state.N : 0;
    /* smooth animated needle */
    if (state.displayedRpm == null) state.displayedRpm = 0;
    state.displayedRpm += (rpm - state.displayedRpm) * 0.12;
    var na = startA + (Math.min(state.displayedRpm, rpmMax) / rpmMax) * (endA - startA);
    ctx.save();
    ctx.translate(cx, cy);
    ctx.rotate(na);
    /* needle shadow */
    ctx.fillStyle = 'rgba(0,0,0,0.6)';
    ctx.beginPath();
    ctx.moveTo(-3, 1); ctx.lineTo(r - 10, 0); ctx.lineTo(-3, -1);
    ctx.closePath(); ctx.fill();
    /* needle */
    ctx.fillStyle = '#ff8c42';
    ctx.beginPath();
    ctx.moveTo(-6, 2); ctx.lineTo(r - 12, 0); ctx.lineTo(-6, -2);
    ctx.closePath(); ctx.fill();
    /* counterweight */
    ctx.fillStyle = '#5a6478';
    ctx.beginPath(); ctx.arc(-12, 0, 4, 0, TAU); ctx.fill();
    ctx.restore();
    /* center hub */
    ctx.fillStyle = '#1a1f2e';
    ctx.strokeStyle = COL.accent;
    ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.arc(cx, cy, 8, 0, TAU);
    ctx.fill(); ctx.stroke();
    ctx.fillStyle = COL.accent;
    ctx.beginPath(); ctx.arc(cx, cy, 3, 0, TAU); ctx.fill();

    /* Digital RPM under dial */
    ctx.fillStyle = '#050709';
    ctx.fillRect(cx - 32, cy + r + 12, 64, 18);
    ctx.strokeStyle = COL.accent;
    ctx.lineWidth = 1;
    ctx.strokeRect(cx - 32, cy + r + 12, 64, 18);
    ctx.fillStyle = '#3ddc84';
    ctx.font = 'bold 12px Courier New, monospace';
    ctx.textAlign = 'center';
    ctx.fillText(String(Math.round(state.displayedRpm)) + ' rpm', cx, cy + r + 25);

    /* Label */
    ctx.fillStyle = '#6b7a99';
    ctx.font = 'bold 8px Segoe UI, sans-serif';
    ctx.fillText('TACHOMETER', cx, cy - r - 6);
  }

  /* ── Digital LED panel (right of tach) ─────────────────────── */
  function drawLEDPanel(ctx, x, y) {
    var w = 380, h = 150;
    /* Outer panel */
    ctx.fillStyle = '#0a0d14';
    ctx.strokeStyle = '#2a3050';
    ctx.lineWidth = 1;
    ctx.fillRect(x, y, w, h);
    ctx.strokeRect(x, y, w, h);
    ctx.fillStyle = '#6b7a99';
    ctx.font = 'bold 8px Segoe UI, sans-serif';
    ctx.textAlign = 'left';
    ctx.fillText('DIGITAL READOUTS', x + 8, y + 12);

    /* 8 LED-style readouts in 2x4 grid */
    var bp = state.running ? simulatedBP_W() / 1000 : 0;
    var W_kg = currentBrakeLoad_kg();
    var T = brakeTorque(W_kg, state.L_mm / 1000);
    var res = calcResults();
    var mf_g_per_h = state.running ? fuelFlow_kgps() * 3600 * 1000 : 0;

    var items = [
      { lbl: 'BRAKE POWER', val: fmt(toD(bp, 'power'), 2), u: uLabel('power'), c: '#3ddc84' },
      { lbl: 'TORQUE',      val: fmt(toD(T, 'torque'), 1),  u: uLabel('torque'), c: '#00bcd4' },
      { lbl: 'FUEL RATE',   val: fmt(toD(mf_g_per_h, 'fuelrate'), 2), u: uLabel('fuelrate'), c: '#ffc857' },
      { lbl: 'η MECH',      val: res && res.eta != null  ? fmt(res.eta, 1) : '— —', u: '%', c: '#42a5f5' },
      { lbl: 'IND. POWER',  val: res && res.IP_W != null ? fmt(toD(res.IP_W / 1000, 'power'), 2) : '— —',  u: uLabel('power'), c: '#ff8a4c' },
      { lbl: 'FRIC. POWER', val: res && res.FP_W != null ? fmt(toD(res.FP_W / 1000, 'power'), 2) : '— —',  u: uLabel('power'), c: '#ef5350' },
      { lbl: 'BSFC',        val: res && res.bsfc != null ? fmt(toD(res.bsfc, 'bsfc'), isImp() ? 3 : 0) : '— —', u: uLabel('bsfc'), c: '#b39ddb' },
      { lbl: 'η BRAKE TH.', val: res && res.eta_bth != null ? fmt(res.eta_bth, 1) : '— —', u: '%', c: '#80cbc4' }
    ];
    var cols = 4, rows = 2;
    var cellW = (w - 16) / cols, cellH = (h - 24) / rows;
    for (var i = 0; i < items.length; i++) {
      var col = i % cols, row = Math.floor(i / cols);
      var cx = x + 8 + col * cellW;
      var cy = y + 18 + row * cellH;
      drawLEDCell(ctx, cx, cy, cellW - 4, cellH - 4, items[i]);
    }
  }

  function drawLEDCell(ctx, x, y, w, h, item) {
    /* Bezel */
    ctx.fillStyle = '#050709';
    ctx.fillRect(x, y, w, h);
    ctx.strokeStyle = '#2a3050';
    ctx.lineWidth = 1;
    ctx.strokeRect(x, y, w, h);
    /* label */
    ctx.fillStyle = '#6b7a99';
    ctx.font = '7.5px Segoe UI, sans-serif';
    ctx.textAlign = 'left';
    ctx.fillText(item.lbl, x + 5, y + 11);
    /* unit — measure with its OWN font (8px), not the value font */
    ctx.font = '8px Segoe UI, sans-serif';
    var unitW = ctx.measureText(item.u).width;
    /* value (LED-glow) — auto-shrink so value + unit always fit the cell */
    var avail = w - 10 - unitW - 4;           /* px available for the value */
    var fs = 14;
    ctx.font = 'bold ' + fs + 'px Courier New, monospace';
    while (fs > 9 && ctx.measureText(item.val).width > avail) {
      fs -= 1;
      ctx.font = 'bold ' + fs + 'px Courier New, monospace';
    }
    ctx.fillStyle = item.c;
    ctx.shadowColor = item.c;
    ctx.shadowBlur = 3;
    ctx.textAlign = 'right';
    ctx.fillText(item.val, x + w - 6 - unitW - 4, y + h - 7);
    ctx.shadowBlur = 0;
    /* unit */
    ctx.fillStyle = '#9ba6c4';
    ctx.font = '8px Segoe UI, sans-serif';
    ctx.textAlign = 'right';
    ctx.fillText(item.u, x + w - 5, y + h - 7);
  }

  /* ── Test chart dispatcher ─────────────────────────────────── */
  function drawTestChart(ctx, W, H) {
    /* chart area: y = 200..H */
    var ay = 200, ah = H - ay;
    /* Title and view-mode subtitle */
    ctx.fillStyle = '#dde3f0';
    ctx.font = 'bold 10px Segoe UI, sans-serif';
    ctx.textAlign = 'left';
    var titleMap = {
      balance:  'CYLINDER POWER BALANCE — IP per cylinder vs average',
      sequence: 'TEST SEQUENCE — BP drop as each cylinder is cut',
      mep:      'MEAN EFFECTIVE PRESSURE — IMEP vs BMEP per cylinder',
      curves:   'PERFORMANCE CURVES — auto-test sweep results',
      willans:  'WILLAN\'S LINE — m_f vs BP, extrapolated to m_f = 0 → FP',
      heat:     'HEAT BALANCE SHEET — where the fuel energy goes',
      retard:   'RETARDATION TEST — speed decay → friction power'
    };
    ctx.fillText(titleMap[state.chartMode] || titleMap.balance, 10, ay + 12);

    /* Progress + next-step hint (always visible, top-right of chart area) */
    if (state.chartMode === 'balance' || state.chartMode === 'sequence' || state.chartMode === 'mep') {
      drawChartProgress(ctx, W, ay);
    }

    if (state.chartMode === 'curves') {
      drawPerformanceCurves(ctx, W, ay + 18, ah - 22);
      return;
    }
    if (state.chartMode === 'willans') {
      drawWillansChart(ctx, W, ay + 18, ah - 22);
      return;
    }
    if (state.chartMode === 'heat') {
      drawHeatChart(ctx, W, ay + 18, ah - 22);
      return;
    }
    if (state.chartMode === 'retard') {
      drawRetardChart(ctx, W, ay + 18, ah - 22);
      return;
    }
    if (!state.readings.length) {
      ctx.fillStyle = '#6b7a99';
      ctx.font = '11px Segoe UI, sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('No data yet — press RUN TEST to run a procedure', W / 2, ay + ah / 2);
      return;
    }
    if (state.chartMode === 'sequence')      drawSequenceChart(ctx, W, ay + 32, ah - 36);
    else if (state.chartMode === 'mep')      drawMEPChart(ctx, W, ay + 32, ah - 36);
    else                                     drawBalanceChart(ctx, W, ay + 32, ah - 36);
  }

  /* ── PERFORMANCE CURVES (load- or speed-sweep) ─────────────── */
  function drawPerformanceCurves(ctx, W, y0, h) {
    var loadData = state.curveData.load;
    var speedData = state.curveData.speed;
    var data, xKey, xLabel;
    if (loadData.length >= speedData.length && loadData.length > 0) {
      data = loadData; xKey = 'pct'; xLabel = 'Load (%)';
    } else if (speedData.length > 0) {
      data = speedData; xKey = 'N'; xLabel = 'Speed N (rpm)';
    } else {
      ctx.fillStyle = '#6b7a99';
      ctx.font = '11px Segoe UI, sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('No sweep data — run Variable Load or Variable Speed auto-test', W / 2, y0 + h / 2);
      return;
    }
    var pad = { l: 44, r: 50, t: 10, b: 30 };
    var plotW = W - pad.l - pad.r;
    var plotH = h - pad.t - pad.b;
    var x0 = pad.l, py0 = y0 + pad.t;

    /* Compute axis ranges */
    var xs = data.map(function (d) { return d[xKey]; });
    var xMin = Math.min.apply(null, xs);
    var xMax = Math.max.apply(null, xs);
    var bps = data.map(function (d) { return d.BP_kW; });
    var bsfcs = data.map(function (d) { return d.bsfc || 0; }).filter(function (v) { return v > 0; });
    var etas = data.map(function (d) { return d.eta_bth || 0; });
    var BPmax = Math.max.apply(null, bps) * 1.15 || 10;
    var BSFCmax = bsfcs.length ? Math.max.apply(null, bsfcs) * 1.15 : 500;
    var ETAmax = Math.max(50, Math.max.apply(null, etas) * 1.2);

    /* axes */
    ctx.strokeStyle = '#3a4060';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(x0, py0); ctx.lineTo(x0, py0 + plotH);
    ctx.lineTo(x0 + plotW, py0 + plotH); ctx.stroke();

    /* x-axis */
    ctx.fillStyle = '#9ba6c4';
    ctx.font = '9px Courier New, monospace';
    ctx.textAlign = 'center';
    for (var t = 0; t <= 5; t++) {
      var xv = xMin + (xMax - xMin) * (t / 5);
      var px = x0 + (plotW) * (t / 5);
      ctx.fillText(xKey === 'pct' ? Math.round(xv) + '%' : Math.round(xv), px, py0 + plotH + 12);
      ctx.strokeStyle = 'rgba(255,255,255,0.03)';
      ctx.beginPath(); ctx.moveTo(px, py0); ctx.lineTo(px, py0 + plotH); ctx.stroke();
    }
    ctx.fillStyle = '#dde3f0';
    ctx.font = 'bold 9px Segoe UI, sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText(xLabel, x0 + plotW / 2, py0 + plotH + 26);

    /* helper to map x */
    function mapX(xv) { return x0 + ((xv - xMin) / (xMax - xMin || 1)) * plotW; }

    /* Plot 3 curves with 3 y-axes (left = BP, right = BSFC, far-right inset = η) */
    drawCurve(ctx, data, mapX, function (d) { return py0 + plotH - (d.BP_kW / BPmax) * plotH; },
              '#3ddc84', 'BP (' + uLabel('power') + ')', xKey);
    drawCurve(ctx, data, mapX, function (d) { return d.bsfc ? py0 + plotH - (d.bsfc / BSFCmax) * plotH : null; },
              '#f5c842', 'BSFC (' + uLabel('bsfc') + ')', xKey);
    drawCurve(ctx, data, mapX, function (d) { return py0 + plotH - (d.eta_bth / ETAmax) * plotH; },
              '#42a5f5', 'η_bth (%)', xKey);

    /* Left axis labels (BP) */
    ctx.fillStyle = '#3ddc84';
    ctx.font = '9px Courier New, monospace';
    ctx.textAlign = 'right';
    for (var k = 0; k <= 4; k++) {
      var yv = (BPmax / 4) * k;
      var py = py0 + plotH - (yv / BPmax) * plotH;
      ctx.fillText(fmt(toD(yv, 'power'), 1), x0 - 3, py + 3);
    }

    /* Right axis labels (BSFC) */
    ctx.fillStyle = '#f5c842';
    ctx.textAlign = 'left';
    ctx.font = '9px Courier New, monospace';
    for (var k2 = 0; k2 <= 4; k2++) {
      var yv2 = (BSFCmax / 4) * k2;
      var py2 = py0 + plotH - (yv2 / BSFCmax) * plotH;
      ctx.fillText(fmt(toD(yv2, 'bsfc'), isImp() ? 2 : 0), x0 + plotW + 3, py2 + 3);
    }

    /* Legend at top */
    var lx = x0 + 4, ly = py0 + 6;
    [
      { c: '#3ddc84', t: 'BP' },
      { c: '#f5c842', t: 'BSFC' },
      { c: '#42a5f5', t: 'η_bth' }
    ].forEach(function (it, i) {
      ctx.fillStyle = it.c;
      ctx.fillRect(lx + i * 60, ly, 8, 8);
      ctx.font = '9px Segoe UI, sans-serif';
      ctx.textAlign = 'left';
      ctx.fillText(it.t, lx + i * 60 + 12, ly + 7);
    });
  }

  function drawCurve(ctx, data, mapX, mapY, color, label, xKey) {
    /* Sort data by x */
    var sorted = data.slice().sort(function (a, b) { return a[xKey] - b[xKey]; });
    ctx.strokeStyle = color;
    ctx.lineWidth = 2;
    ctx.beginPath();
    var started = false;
    sorted.forEach(function (d) {
      var px = mapX(d[xKey]);
      var py = mapY(d);
      if (py == null || isNaN(py)) return;
      if (!started) { ctx.moveTo(px, py); started = true; }
      else ctx.lineTo(px, py);
    });
    ctx.stroke();
    /* points */
    sorted.forEach(function (d) {
      var px = mapX(d[xKey]);
      var py = mapY(d);
      if (py == null || isNaN(py)) return;
      ctx.fillStyle = color;
      ctx.beginPath();
      ctx.arc(px, py, 3, 0, TAU);
      ctx.fill();
    });
  }

  /* ── WILLAN'S LINE chart ───────────────────────────────────── */
  function drawWillansChart(ctx, W, y0, h) {
    var pts = state.curveData.willans;
    if (!pts.length) {
      ctx.fillStyle = '#6b7a99';
      ctx.font = '11px Segoe UI, sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('No Willan\'s data — run Willan\'s Line auto-test', W / 2, y0 + h / 2);
      return;
    }
    var pad = { l: 48, r: 24, t: 10, b: 36 };
    var plotW = W - pad.l - pad.r;
    var plotH = h - pad.t - pad.b;
    var x0 = pad.l, py0 = y0 + pad.t;

    /* Determine ranges. Extend the BP axis to negative values so the
       Willan's extrapolation can be carried back to m_f = 0, where it cuts
       the BP axis at BP = −FP (the friction-power determination). */
    var BPs = pts.map(function (p) { return p.BP_kW; });
    var mfs = pts.map(function (p) { return p.mf_kg_h; });
    var fit = state.curveData.willansFit;
    var FPx = fit && isFinite(fit.FP_kW) ? Math.max(0, fit.FP_kW) : 0;
    var xMin = -FPx * 1.18;
    var xMax = Math.max.apply(null, BPs) * 1.1;
    var yMax = Math.max.apply(null, mfs) * 1.15;
    if (fit && fit.a > yMax * 0.6) yMax = Math.max(yMax, fit.a * 1.15);

    function mapX(v) { return x0 + (v - xMin) / (xMax - xMin) * plotW; }
    function mapY(v) { return py0 + plotH - (v / yMax) * plotH; }

    /* axes: BP axis along the bottom (m_f = 0); m_f axis at BP = 0 */
    ctx.strokeStyle = '#3a4060';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(mapX(0), py0); ctx.lineTo(mapX(0), py0 + plotH);
    ctx.moveTo(x0, py0 + plotH); ctx.lineTo(x0 + plotW, py0 + plotH);
    ctx.stroke();

    /* x ticks */
    ctx.fillStyle = '#9ba6c4';
    ctx.font = '9px Courier New, monospace';
    ctx.textAlign = 'center';
    for (var t = 0; t <= 5; t++) {
      var v = xMin + (xMax - xMin) * (t / 5);
      var px = mapX(v);
      ctx.fillText(fmt(toD(v, 'power'), 1), px, py0 + plotH + 12);
    }
    /* y ticks */
    ctx.textAlign = 'right';
    for (var k = 0; k <= 4; k++) {
      var yv = (yMax / 4) * k;
      var py = mapY(yv);
      ctx.fillText(fmt(toD(yv * 1000, 'fuelrate'), 1), x0 - 4, py + 3);
    }
    /* axis labels */
    ctx.fillStyle = '#dde3f0';
    ctx.font = 'bold 9px Segoe UI, sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText('Brake Power (' + uLabel('power') + ')', x0 + plotW / 2, py0 + plotH + 28);
    ctx.save();
    ctx.translate(14, py0 + plotH / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.fillText('Fuel rate m_f (' + uLabel('fuelrate') + ')', 0, 0);
    ctx.restore();

    /* fit line — extended back to the BP axis */
    if (fit) {
      ctx.strokeStyle = 'rgba(245,200,66,0.75)';
      ctx.lineWidth = 2;
      ctx.setLineDash([5, 4]);
      ctx.beginPath();
      ctx.moveTo(mapX(xMin), mapY(fit.a + fit.b * xMin));
      ctx.lineTo(mapX(xMax), mapY(fit.a + fit.b * xMax));
      ctx.stroke();
      ctx.setLineDash([]);
      /* y-intercept marker: idle/friction fuel rate at BP = 0 */
      ctx.fillStyle = '#ffc857';
      ctx.beginPath(); ctx.arc(mapX(0), mapY(fit.a), 4, 0, TAU); ctx.fill();
      /* x-intercept marker: friction power at BP = −FP, m_f = 0 */
      var xi = -FPx;
      ctx.strokeStyle = 'rgba(239,83,80,0.5)'; ctx.lineWidth = 1; ctx.setLineDash([3, 3]);
      ctx.beginPath(); ctx.moveTo(mapX(xi), mapY(0)); ctx.lineTo(mapX(xi), py0 + 4); ctx.stroke();
      ctx.setLineDash([]);
      ctx.fillStyle = '#ef5350';
      ctx.beginPath(); ctx.arc(mapX(xi), mapY(0), 5, 0, TAU); ctx.fill();
      ctx.font = 'bold 9.5px Segoe UI, sans-serif';
      ctx.textAlign = 'left';
      ctx.fillText('FP = ' + toD(fit.FP_kW, 'power').toFixed(2) + ' ' + uLabel('power'), mapX(xi) + 7, mapY(0) - 16);
      /* compare with Morse FP if available */
      var res = calcResults();
      if (res && res.FP_W != null) {
        var morseFP = res.FP_W / 1000;
        ctx.fillStyle = '#9ba6c4';
        ctx.font = '9px Segoe UI, sans-serif';
        ctx.fillText('Morse FP = ' + toD(morseFP, 'power').toFixed(2) + ' (Δ ' + (toD(fit.FP_kW, 'power') - toD(morseFP, 'power')).toFixed(2) + ')',
                     mapX(xi) + 7, mapY(0) - 4);
      }
    }
    /* data points */
    pts.forEach(function (p) {
      ctx.fillStyle = '#42a5f5';
      ctx.beginPath();
      ctx.arc(mapX(p.BP_kW), mapY(p.mf_kg_h), 4, 0, TAU);
      ctx.fill();
    });
  }

  /* ── HEAT BALANCE chart — pie + sheet ─────────────────────────── */
  function drawHeatChart(ctx, W, y0, h) {
    var hb = state.curveData.heatBalance;
    if (!hb) {
      ctx.fillStyle = '#6b7a99'; ctx.font = '11px Segoe UI, sans-serif'; ctx.textAlign = 'center';
      ctx.fillText('No heat balance yet — run the Heat Balance auto-test', W / 2, y0 + h / 2);
      return;
    }
    var segs = [
      { lbl: 'Brake power',  v: hb.bthFrac,  kW: hb.BP,     c: '#3ddc84' },
      { lbl: 'Cooling water', v: hb.coolFrac, kW: hb.Qcool, c: '#42a5f5' },
      { lbl: 'Exhaust gas',  v: hb.exhFrac,  kW: hb.Qexh,   c: '#ef5350' },
      { lbl: 'Unaccounted',  v: hb.unaccFrac, kW: hb.Qunacc, c: '#9ba6c4' }
    ];
    /* Pie on the left */
    var cx = y0 > 0 ? 90 : 90, cy = y0 + h / 2 - 6, r = Math.min(h / 2 - 14, 72);
    var a0 = -Math.PI / 2;
    segs.forEach(function (s) {
      var a1 = a0 + s.v * TAU;
      ctx.beginPath(); ctx.moveTo(cx, cy); ctx.arc(cx, cy, r, a0, a1); ctx.closePath();
      ctx.fillStyle = s.c; ctx.fill();
      ctx.strokeStyle = '#0d1117'; ctx.lineWidth = 1.5; ctx.stroke();
      /* % label on slice */
      var am = (a0 + a1) / 2;
      ctx.fillStyle = '#0d1117'; ctx.font = 'bold 10px Segoe UI, sans-serif'; ctx.textAlign = 'center';
      if (s.v > 0.06) ctx.fillText(Math.round(s.v * 100) + '%', cx + Math.cos(am) * r * 0.62, cy + Math.sin(am) * r * 0.62 + 3);
      a0 = a1;
    });
    /* centre hub showing fuel input */
    ctx.fillStyle = '#0a0d14'; ctx.beginPath(); ctx.arc(cx, cy, r * 0.34, 0, TAU); ctx.fill();
    ctx.fillStyle = '#ffc857'; ctx.font = 'bold 10px Courier New, monospace'; ctx.textAlign = 'center';
    ctx.fillText(fmt(toD(hb.Qfuel, 'power'), 1), cx, cy - 1);
    ctx.fillStyle = '#6b7a99'; ctx.font = '7px Segoe UI, sans-serif';
    ctx.fillText('FUEL ' + uLabel('power'), cx, cy + 9);

    /* Sheet table on the right */
    var tx = 185, ty = y0 + 6, tw = W - tx - 12, rh = (h - 30) / 5;
    ctx.font = 'bold 9px Segoe UI, sans-serif'; ctx.textAlign = 'left';
    ctx.fillStyle = '#9ba6c4';
    ctx.fillText('HEAT BALANCE SHEET', tx, ty + 8);
    ctx.fillText('Energy stream', tx, ty + 8 + rh);
    ctx.textAlign = 'right';
    ctx.fillText(uLabel('power'), tx + tw - 60, ty + 8 + rh);
    ctx.fillText('%', tx + tw - 8, ty + 8 + rh);
    var ry = ty + 8 + rh;
    segs.forEach(function (s) {
      ry += rh;
      ctx.fillStyle = s.c; ctx.fillRect(tx, ry - 7, 8, 8);
      ctx.fillStyle = '#dde3f0'; ctx.font = '9.5px Segoe UI, sans-serif'; ctx.textAlign = 'left';
      ctx.fillText(s.lbl, tx + 13, ry);
      ctx.font = 'bold 9.5px Courier New, monospace'; ctx.textAlign = 'right';
      ctx.fillText(fmt(toD(s.kW, 'power'), 2), tx + tw - 60, ry);
      ctx.fillText((s.v * 100).toFixed(1), tx + tw - 8, ry);
    });
    /* measured-parameter footnote */
    ctx.fillStyle = '#6b7a99'; ctx.font = '8px Segoe UI, sans-serif'; ctx.textAlign = 'left';
    ctx.fillText('Coolant ΔT ' + fmt(toD(hb.dTw, 'dtemp'), 1) + ' ' + uLabel('dtemp') +
      ' @ ' + fmt(toD(hb.mw * 60, 'flow'), isImp() ? 1 : 0) + ' ' + uLabel('flow') +
      '   ·   Exhaust ' + fmt(toD(hb.Texh, 'temp'), 0) + ' ' + uLabel('temp') +
      '   ·   A/F ' + hb.AF + ':1',
      tx, y0 + h - 4);
  }

  /* ── RETARDATION chart — speed decay vs time ──────────────────── */
  function drawRetardChart(ctx, W, y0, h) {
    var pts = state.curveData.retardation;
    if (!pts || !pts.length) {
      ctx.fillStyle = '#6b7a99'; ctx.font = '11px Segoe UI, sans-serif'; ctx.textAlign = 'center';
      ctx.fillText('No decay data — run the Retardation auto-test', W / 2, y0 + h / 2);
      return;
    }
    var pad = { l: 52, r: 20, t: 10, b: 34 };
    var pw = W - pad.l - pad.r, ph = h - pad.t - pad.b;
    var x0 = pad.l, py0 = y0 + pad.t;
    var tMax = pts[pts.length - 1].t || 1;
    var nMax = pts[0].N * 1.05 || 1;
    function mx(t) { return x0 + t / tMax * pw; }
    function my(n) { return py0 + ph - n / nMax * ph; }
    /* axes */
    ctx.strokeStyle = '#3a4060'; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(x0, py0); ctx.lineTo(x0, py0 + ph); ctx.lineTo(x0 + pw, py0 + ph); ctx.stroke();
    ctx.fillStyle = '#6b7a99'; ctx.font = '9px Courier New, monospace'; ctx.textAlign = 'right';
    for (var k = 0; k <= 4; k++) { var nv = nMax / 4 * k; ctx.fillText(Math.round(nv), x0 - 4, my(nv) + 3); }
    ctx.textAlign = 'center';
    for (var t = 0; t <= 4; t++) { var tv = tMax / 4 * t; ctx.fillText(tv.toFixed(1), mx(tv), py0 + ph + 14); }
    ctx.fillStyle = '#dde3f0'; ctx.font = 'bold 9px Segoe UI, sans-serif';
    ctx.fillText('Time (s)', x0 + pw / 2, py0 + ph + 28);
    ctx.save(); ctx.translate(14, py0 + ph / 2); ctx.rotate(-Math.PI / 2); ctx.textAlign = 'center';
    ctx.fillText('Speed N (rpm)', 0, 0); ctx.restore();
    /* decay curve */
    ctx.strokeStyle = '#8e24aa'; ctx.lineWidth = 2.5; ctx.beginPath();
    pts.forEach(function (p, i) { var X = mx(p.t), Y = my(p.N); if (i === 0) ctx.moveTo(X, Y); else ctx.lineTo(X, Y); });
    ctx.stroke();
    pts.forEach(function (p) { ctx.fillStyle = '#ce93d8'; ctx.beginPath(); ctx.arc(mx(p.t), my(p.N), 3, 0, TAU); ctx.fill(); });
    /* FP result */
    var fit = state.curveData.retardationFit;
    if (fit) {
      ctx.fillStyle = '#8e24aa'; ctx.font = 'bold 11px Segoe UI, sans-serif'; ctx.textAlign = 'right';
      ctx.fillText('FP = ' + fmt(toD(fit.FP_kW, 'power'), 2) + ' ' + uLabel('power'), x0 + pw - 6, py0 + 14);
      ctx.fillStyle = '#9ba6c4'; ctx.font = '8.5px Segoe UI, sans-serif';
      ctx.fillText('I = ' + fmt(toD(fit.I, 'inertia'), 2) + ' ' + uLabel('inertia') + '   FP = I·ω·(dω/dt)', x0 + pw - 6, py0 + 28);
      var res = calcResults();
      if (res && res.FP_W != null) {
        ctx.fillText('Morse FP = ' + fmt(toD(res.FP_W / 1000, 'power'), 2) + ' ' + uLabel('power'), x0 + pw - 6, py0 + 42);
      }
    }
  }

  /* ── Progress strip showing N/M readings + next-step prompt ─ */
  function drawChartProgress(ctx, W, y) {
    var eng = curEngine();
    var n = eng.cyl;
    var got = state.readings.length;
    var need = n + 1;
    var ref = null, recordedCyls = {};
    state.readings.forEach(function (r) {
      if (r.cylCut === -1) ref = r;
      else recordedCyls[r.cylCut] = true;
    });

    /* Progress dots: one per required reading */
    var dotsX = 10, dotsY = y + 24;
    ctx.fillStyle = '#6b7a99';
    ctx.font = '8px Segoe UI, sans-serif';
    ctx.textAlign = 'left';
    ctx.fillText('PROGRESS', dotsX, dotsY - 2);
    var dotSize = 8;
    var labels = ['All'].concat(Array.from({length:n}, function(_,i){return 'C'+(i+1);}));
    for (var i = 0; i < need; i++) {
      var dx = dotsX + 56 + i * 26;
      var done = (i === 0 && ref) || (i > 0 && recordedCyls[i - 1]);
      ctx.fillStyle = done ? '#3ddc84' : '#2a3050';
      ctx.beginPath(); ctx.arc(dx, dotsY + 1, dotSize/2, 0, TAU); ctx.fill();
      if (done) {
        ctx.fillStyle = '#0d1117';
        ctx.font = 'bold 7px Segoe UI, sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('✓', dx, dotsY + 4);
      }
      ctx.fillStyle = done ? '#dde3f0' : '#6b7a99';
      ctx.font = '7.5px Courier New, monospace';
      ctx.textAlign = 'center';
      ctx.fillText(labels[i], dx, dotsY + 14);
    }

    /* Status hint on the right */
    var allDone = ref && (function () { for (var k = 0; k < n; k++) if (!recordedCyls[k]) return false; return true; })();
    var hint;
    if (state.autoTest) hint = '⏳ Auto test running…';
    else if (allDone) hint = '✓ Morse test complete';
    else if (state.readings.length) hint = '⏳ Acquiring readings…';
    else hint = '▶ Press RUN TEST to begin';
    ctx.fillStyle = '#f5c842';
    ctx.font = 'bold 9.5px Segoe UI, sans-serif';
    ctx.textAlign = 'right';
    ctx.fillText(hint, W - 10, dotsY + 4);
  }

  /* ── VIEW 1: Cylinder balance + power flow ────────────────── */
  function drawBalanceChart(ctx, W, y0, h) {
    var res = calcResults();
    var eng = curEngine();
    var n = eng.cyl;

    /* Split: left 65% = IP balance bars, right 35% = power flow stacked bar */
    var splitX = Math.round(W * 0.62);
    drawIPBalance(ctx, 8, y0, splitX - 16, h, n, res);
    drawPowerFlow(ctx, splitX + 4, y0, W - splitX - 12, h, res);
  }

  function drawIPBalance(ctx, x, y, w, h, n, res) {
    var pad = { l: 36, r: 8, t: 6, b: 26 };
    var plotW = w - pad.l - pad.r;
    var plotH = h - pad.t - pad.b;
    var x0 = x + pad.l, y0 = y + pad.t;

    /* compute IPs (kW); null where not yet measured */
    var ips = [];
    var sum = 0, count = 0;
    for (var i = 0; i < n; i++) {
      var v = (res && res.cylIPs && res.cylIPs[i] != null) ? res.cylIPs[i] / 1000 : null;
      ips.push(v);
      if (v != null) { sum += v; count++; }
    }
    var avg = count > 0 ? sum / count : 0;
    var maxV = 0;
    for (var i = 0; i < n; i++) if (ips[i] != null && ips[i] > maxV) maxV = ips[i];
    if (maxV <= 0) maxV = 10;
    maxV *= 1.25;

    /* y-axis */
    ctx.strokeStyle = '#3a4060';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(x0, y0); ctx.lineTo(x0, y0 + plotH);
    ctx.lineTo(x0 + plotW, y0 + plotH); ctx.stroke();

    /* y ticks */
    ctx.fillStyle = '#6b7a99';
    ctx.font = '9px Courier New, monospace';
    ctx.textAlign = 'right';
    for (var k = 0; k <= 4; k++) {
      var yv = (maxV / 4) * k;
      var py = y0 + plotH - (yv / maxV) * plotH;
      ctx.fillText(fmt(toD(yv, 'power'), 1), x0 - 4, py + 3);
      ctx.strokeStyle = 'rgba(255,255,255,0.04)';
      ctx.beginPath();
      ctx.moveTo(x0, py); ctx.lineTo(x0 + plotW, py); ctx.stroke();
    }
    /* y label */
    ctx.save();
    ctx.translate(x + 6, y0 + plotH / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.textAlign = 'center';
    ctx.fillStyle = '#dde3f0';
    ctx.font = 'bold 9px Segoe UI, sans-serif';
    ctx.fillText('IP (' + uLabel('power') + ')', 0, 0);
    ctx.restore();

    /* ± tolerance band around average (5%) */
    if (avg > 0) {
      var lo = avg * 0.95, hi = avg * 1.05;
      var yLo = y0 + plotH - (lo / maxV) * plotH;
      var yHi = y0 + plotH - (hi / maxV) * plotH;
      ctx.fillStyle = 'rgba(0,137,123,0.10)';
      ctx.fillRect(x0, yHi, plotW, yLo - yHi);
    }

    /* bars */
    var barW = plotW / n * 0.55;
    var step = plotW / n;
    for (var i = 0; i < n; i++) {
      var bx = x0 + step * i + (step - barW) / 2;
      if (ips[i] == null) {
        /* pending — dashed outline */
        ctx.strokeStyle = '#3a4060';
        ctx.setLineDash([3, 3]);
        ctx.lineWidth = 1;
        var ph = plotH * 0.15;
        ctx.strokeRect(bx, y0 + plotH - ph, barW, ph);
        ctx.setLineDash([]);
        ctx.fillStyle = '#6b7a99';
        ctx.font = '9px Segoe UI, sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('—', bx + barW / 2, y0 + plotH - ph / 2 + 3);
      } else {
        var bh = (ips[i] / maxV) * plotH;
        var by = y0 + plotH - bh;
        /* color: gold default, red if outside ±5% band */
        var inBand = avg > 0 && Math.abs(ips[i] - avg) <= avg * 0.05;
        var grd = ctx.createLinearGradient(0, by, 0, by + bh);
        if (inBand) {
          grd.addColorStop(0, '#4dd0c1');
          grd.addColorStop(1, '#00897b');
        } else {
          grd.addColorStop(0, '#ff8a4c');
          grd.addColorStop(1, '#d84315');
        }
        ctx.fillStyle = grd;
        ctx.fillRect(bx, by, barW, bh);
        /* outline */
        ctx.strokeStyle = inBand ? '#26a69a' : '#bf360c';
        ctx.lineWidth = 1;
        ctx.strokeRect(bx + 0.5, by + 0.5, barW - 1, bh - 1);
        /* value label */
        ctx.fillStyle = '#dde3f0';
        ctx.font = 'bold 9px Courier New, monospace';
        ctx.textAlign = 'center';
        ctx.fillText(fmt(toD(ips[i], 'power'), 1), bx + barW / 2, by - 3);
        /* outlier flag */
        if (!inBand && avg > 0) {
          ctx.fillStyle = '#ff5555';
          ctx.font = '11px Segoe UI, sans-serif';
          ctx.fillText('⚠', bx + barW / 2, by - 14);
        }
      }
      /* x label */
      ctx.fillStyle = '#9ba6c4';
      ctx.font = '9px Segoe UI, sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('Cyl ' + (i + 1), x0 + step * i + step / 2, y0 + plotH + 12);
    }

    /* average line */
    if (avg > 0) {
      var yAvg = y0 + plotH - (avg / maxV) * plotH;
      ctx.strokeStyle = '#f5c842';
      ctx.lineWidth = 1.5;
      ctx.setLineDash([5, 3]);
      ctx.beginPath();
      ctx.moveTo(x0, yAvg); ctx.lineTo(x0 + plotW, yAvg);
      ctx.stroke();
      ctx.setLineDash([]);
      /* avg label */
      ctx.fillStyle = '#f5c842';
      ctx.font = 'bold 9px Courier New, monospace';
      ctx.textAlign = 'left';
      ctx.fillText('avg ' + fmt(toD(avg, 'power'), 2), x0 + 4, yAvg - 3);
    }
    /* footer caption */
    ctx.fillStyle = '#6b7a99';
    ctx.font = '8px Segoe UI, sans-serif';
    ctx.textAlign = 'left';
    ctx.fillText('Green = within ±5% (healthy)   Orange = outlier (worn/lean)', x0, y + h - 4);
  }

  function drawPowerFlow(ctx, x, y, w, h, res) {
    /* Stacked vertical bar: BP (green) bottom + FP (red) top = IP total */
    var pad = { l: 6, r: 6, t: 6, b: 26 };
    var plotW = w - pad.l - pad.r;
    var plotH = h - pad.t - pad.b;
    var x0 = x + pad.l, y0 = y + pad.t;

    /* Panel background */
    ctx.fillStyle = 'rgba(255,255,255,0.02)';
    ctx.fillRect(x, y, w, h);
    ctx.strokeStyle = '#2a3050';
    ctx.strokeRect(x + 0.5, y + 0.5, w - 1, h - 1);
    /* sub-title */
    ctx.fillStyle = '#dde3f0';
    ctx.font = 'bold 9px Segoe UI, sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText('POWER FLOW (IP = BP + FP)', x + w / 2, y + 14);

    var barX = x0 + plotW / 2 - 26;
    var barW = 52;
    var byTop = y0 + 18;
    var bh = plotH - 22;

    if (!res || res.IP_W == null) {
      /* show pending */
      ctx.strokeStyle = '#3a4060';
      ctx.setLineDash([4, 3]);
      ctx.strokeRect(barX, byTop, barW, bh);
      ctx.setLineDash([]);
      ctx.fillStyle = '#6b7a99';
      ctx.font = '10px Segoe UI, sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('awaiting', x + w / 2, byTop + bh / 2);
      ctx.fillText('all cyl IPs', x + w / 2, byTop + bh / 2 + 14);
      return;
    }

    var ip = res.IP_W / 1000;
    var bp = res.BP_W / 1000;
    var fp = res.FP_W / 1000;
    var bpFrac = bp / ip;
    var fpFrac = fp / ip;

    /* BP segment (bottom, green) */
    var bpH = bh * bpFrac;
    var fpH = bh * fpFrac;
    var bpG = ctx.createLinearGradient(0, byTop + fpH, 0, byTop + bh);
    bpG.addColorStop(0, '#4dd0c1');
    bpG.addColorStop(1, '#00897b');
    ctx.fillStyle = bpG;
    ctx.fillRect(barX, byTop + fpH, barW, bpH);

    /* FP segment (top, red) */
    var fpG = ctx.createLinearGradient(0, byTop, 0, byTop + fpH);
    fpG.addColorStop(0, '#ef5350');
    fpG.addColorStop(1, '#b71c1c');
    ctx.fillStyle = fpG;
    ctx.fillRect(barX, byTop, barW, fpH);

    /* outline + segment divider */
    ctx.strokeStyle = '#0a0d14';
    ctx.lineWidth = 1;
    ctx.strokeRect(barX + 0.5, byTop + 0.5, barW - 1, bh - 1);
    ctx.beginPath();
    ctx.moveTo(barX, byTop + fpH); ctx.lineTo(barX + barW, byTop + fpH);
    ctx.stroke();

    /* Labels */
    ctx.font = 'bold 9px Courier New, monospace';
    ctx.textAlign = 'left';
    /* FP label (top) */
    ctx.fillStyle = '#fff';
    var fpLbl = 'FP ' + fmt(toD(fp, 'power'), 2);
    if (fpH > 16) ctx.fillText(fpLbl, barX + 4, byTop + fpH / 2 + 3);
    else { ctx.fillStyle = '#ef5350'; ctx.fillText(fpLbl, barX + barW + 6, byTop + fpH / 2 + 3); }
    /* BP label (bottom) */
    ctx.fillStyle = '#fff';
    ctx.fillText('BP ' + fmt(toD(bp, 'power'), 2), barX + 4, byTop + fpH + bpH / 2 + 3);

    /* IP total at top bracket */
    ctx.strokeStyle = '#f5c842';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(barX + barW + 4, byTop);
    ctx.lineTo(barX + barW + 8, byTop);
    ctx.lineTo(barX + barW + 8, byTop + bh);
    ctx.lineTo(barX + barW + 4, byTop + bh);
    ctx.stroke();
    ctx.fillStyle = '#f5c842';
    ctx.font = 'bold 9px Courier New, monospace';
    ctx.textAlign = 'left';
    ctx.save();
    ctx.translate(barX + barW + 22, byTop + bh / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.textAlign = 'center';
    ctx.fillText('IP ' + fmt(toD(ip, 'power'), 2) + ' ' + uLabel('power'), 0, 0);
    ctx.restore();

    /* η_mech big readout below bar */
    var etaY = byTop + bh + 16;
    ctx.fillStyle = '#42a5f5';
    ctx.font = 'bold 16px Courier New, monospace';
    ctx.textAlign = 'center';
    ctx.fillText('η = ' + fmt(res.eta, 1) + '%', x + w / 2, etaY);
  }

  /* ── VIEW 2: Test sequence ─────────────────────────────────── */
  function drawSequenceChart(ctx, W, y0, h) {
    var pad = { l: 50, r: 20, t: 8, b: 36 };
    var plotW = W - pad.l - pad.r;
    var plotH = h - pad.t - pad.b;
    var x0 = pad.l, py0 = y0 + pad.t;
    var n = curEngine().cyl;

    /* Sort readings by cylCut (-1 first, then 0,1,2,..). Skip multi-cut (-2)
       since the sequence chart is per-cylinder. */
    var rdg = state.readings.filter(function (r) { return r.cylCut !== -2; })
                            .slice().sort(function (a, b) { return a.cylCut - b.cylCut; });

    /* find max BP for scaling */
    var maxV = 0;
    rdg.forEach(function (r) { if (r.BP_W / 1000 > maxV) maxV = r.BP_W / 1000; });
    if (maxV <= 0) maxV = 10;
    maxV *= 1.2;

    /* axes */
    ctx.strokeStyle = '#3a4060';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(x0, py0); ctx.lineTo(x0, py0 + plotH);
    ctx.lineTo(x0 + plotW, py0 + plotH); ctx.stroke();
    /* y ticks */
    ctx.fillStyle = '#6b7a99';
    ctx.font = '9px Courier New, monospace';
    ctx.textAlign = 'right';
    for (var k = 0; k <= 4; k++) {
      var yv = (maxV / 4) * k;
      var pyk = py0 + plotH - (yv / maxV) * plotH;
      ctx.fillText(fmt(toD(yv, 'power'), 1), x0 - 4, pyk + 3);
      ctx.strokeStyle = 'rgba(255,255,255,0.04)';
      ctx.beginPath();
      ctx.moveTo(x0, pyk); ctx.lineTo(x0 + plotW, pyk); ctx.stroke();
    }
    ctx.save();
    ctx.translate(14, py0 + plotH / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.textAlign = 'center';
    ctx.fillStyle = '#dde3f0';
    ctx.font = 'bold 9px Segoe UI, sans-serif';
    ctx.fillText('BP (' + uLabel('power') + ')', 0, 0);
    ctx.restore();

    /* bars + connecting line */
    var slots = n + 1;          /* All firing + n cylinders */
    var step = plotW / slots;
    var barW = step * 0.55;
    /* find ref BP for drop arrows */
    var ref = rdg.find(function (r) { return r.cylCut === -1; });
    var refBP = ref ? ref.BP_W / 1000 : null;

    /* connecting line (drop trajectory) */
    if (rdg.length > 1) {
      ctx.strokeStyle = 'rgba(245,200,66,0.5)';
      ctx.lineWidth = 1.5;
      ctx.setLineDash([4, 3]);
      ctx.beginPath();
      var first = true;
      rdg.forEach(function (r) {
        var slot = r.cylCut === -1 ? 0 : (r.cylCut + 1);
        var bx = x0 + step * slot + step / 2;
        var bh = (r.BP_W / 1000 / maxV) * plotH;
        var by = py0 + plotH - bh;
        if (first) { ctx.moveTo(bx, by); first = false; }
        else ctx.lineTo(bx, by);
      });
      ctx.stroke();
      ctx.setLineDash([]);
    }

    /* draw bars */
    for (var s = 0; s < slots; s++) {
      var bx = x0 + step * s + (step - barW) / 2;
      var found = rdg.find(function (r) { return (r.cylCut === -1 ? 0 : r.cylCut + 1) === s; });
      var lbl = s === 0 ? 'All' : '−C' + s;
      if (found) {
        var bv = found.BP_W / 1000;
        var bh = (bv / maxV) * plotH;
        var by = py0 + plotH - bh;
        var grd = ctx.createLinearGradient(0, by, 0, by + bh);
        grd.addColorStop(0, '#42a5f5');
        grd.addColorStop(1, '#1565c0');
        ctx.fillStyle = grd;
        ctx.fillRect(bx, by, barW, bh);
        ctx.strokeStyle = '#0d47a1';
        ctx.lineWidth = 1;
        ctx.strokeRect(bx + 0.5, by + 0.5, barW - 1, bh - 1);
        /* value label */
        ctx.fillStyle = '#dde3f0';
        ctx.font = 'bold 9px Courier New, monospace';
        ctx.textAlign = 'center';
        ctx.fillText(fmt(toD(bv, 'power'), 2), bx + barW / 2, by - 4);
        /* IP drop annotation */
        if (s > 0 && refBP != null) {
          var drop = refBP - bv;
          ctx.fillStyle = '#3ddc84';
          ctx.font = '8px Courier New, monospace';
          ctx.fillText('↓' + fmt(toD(drop, 'power'), 2), bx + barW / 2, by + bh / 2 + 3);
        }
      } else {
        /* pending */
        ctx.strokeStyle = '#3a4060';
        ctx.setLineDash([3, 3]);
        ctx.strokeRect(bx, py0 + plotH - plotH * 0.1, barW, plotH * 0.1);
        ctx.setLineDash([]);
      }
      /* x label */
      ctx.fillStyle = '#9ba6c4';
      ctx.font = '9px Segoe UI, sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText(lbl, x0 + step * s + step / 2, py0 + plotH + 12);
    }
    /* caption */
    ctx.fillStyle = '#6b7a99';
    ctx.font = '8px Segoe UI, sans-serif';
    ctx.textAlign = 'left';
    ctx.fillText('Each green arrow = IPᵢ = BP_total − BP(cyl i cut)', x0, y0 + h - 4);
  }

  /* ── VIEW 3: Mean Effective Pressure (BMEP vs IMEP) ────────── */
  function drawMEPChart(ctx, W, y0, h) {
    var eng = curEngine();
    var n = eng.cyl;
    var Vt_m3 = displacement_L() * 1e-3;             /* total displacement m³ (live geometry) */
    var Vcyl = Vt_m3 / n;                             /* per cylinder */
    var nRev = eng.strokes === 2 ? 1 : 2;             /* rev per power stroke */
    var N_rps = state.N / 60;
    var res = calcResults();

    /* MEP per cylinder: IMEP_i = IP_i × nRev / (Vcyl × N_rps)
       BMEP per cylinder = average BP / n × nRev / (Vcyl × N_rps) */
    var imep = [];   /* Pa per cyl, null if no measurement */
    for (var i = 0; i < n; i++) {
      if (res && res.cylIPs && res.cylIPs[i] != null) {
        imep.push(res.cylIPs[i] * nRev / (Vcyl * N_rps));
      } else imep.push(null);
    }
    var bmepCyl = null;
    if (res && res.BP_W != null) {
      bmepCyl = (res.BP_W / n) * nRev / (Vcyl * N_rps);
    }

    var pad = { l: 50, r: 20, t: 8, b: 36 };
    var plotW = W - pad.l - pad.r;
    var plotH = h - pad.t - pad.b;
    var x0 = pad.l, py0 = y0 + pad.t;

    /* max for y-axis (in bar) */
    var maxV = bmepCyl || 0;
    imep.forEach(function (v) { if (v != null && v > maxV) maxV = v; });
    if (maxV <= 0) maxV = 5e5;
    maxV *= 1.2;
    /* convert Pa → display pressure unit (bar in SI, psi in Imperial) */
    function toBar(pa) { return toD(pa / 1e5, 'pressure'); }
    var pUnit = uLabel('pressure');

    /* axes */
    ctx.strokeStyle = '#3a4060';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(x0, py0); ctx.lineTo(x0, py0 + plotH);
    ctx.lineTo(x0 + plotW, py0 + plotH); ctx.stroke();
    /* y ticks */
    ctx.fillStyle = '#6b7a99';
    ctx.font = '9px Courier New, monospace';
    ctx.textAlign = 'right';
    for (var k = 0; k <= 4; k++) {
      var yv = (maxV / 4) * k;
      var py = py0 + plotH - (yv / maxV) * plotH;
      ctx.fillText(toBar(yv).toFixed(1), x0 - 4, py + 3);
      ctx.strokeStyle = 'rgba(255,255,255,0.04)';
      ctx.beginPath();
      ctx.moveTo(x0, py); ctx.lineTo(x0 + plotW, py); ctx.stroke();
    }
    ctx.save();
    ctx.translate(14, py0 + plotH / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.textAlign = 'center';
    ctx.fillStyle = '#dde3f0';
    ctx.font = 'bold 9px Segoe UI, sans-serif';
    ctx.fillText('MEP (' + pUnit + ')', 0, 0);
    ctx.restore();

    /* IMEP bars per cyl */
    var step = plotW / n;
    var barW = step * 0.5;
    for (var i = 0; i < n; i++) {
      var bx = x0 + step * i + (step - barW) / 2;
      if (imep[i] == null) {
        ctx.strokeStyle = '#3a4060';
        ctx.setLineDash([3, 3]);
        ctx.strokeRect(bx, py0 + plotH - plotH * 0.1, barW, plotH * 0.1);
        ctx.setLineDash([]);
      } else {
        var bh = (imep[i] / maxV) * plotH;
        var by = py0 + plotH - bh;
        var grd = ctx.createLinearGradient(0, by, 0, by + bh);
        grd.addColorStop(0, '#ff8a4c');
        grd.addColorStop(1, '#bf360c');
        ctx.fillStyle = grd;
        ctx.fillRect(bx, by, barW, bh);
        ctx.strokeStyle = '#bf360c';
        ctx.lineWidth = 1;
        ctx.strokeRect(bx + 0.5, by + 0.5, barW - 1, bh - 1);
        ctx.fillStyle = '#dde3f0';
        ctx.font = 'bold 9px Courier New, monospace';
        ctx.textAlign = 'center';
        ctx.fillText(toBar(imep[i]).toFixed(1), bx + barW / 2, by - 3);  /* display pressure unit */
      }
      ctx.fillStyle = '#9ba6c4';
      ctx.font = '9px Segoe UI, sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('IMEP' + (i + 1), x0 + step * i + step / 2, py0 + plotH + 12);
    }

    /* BMEP horizontal line (engine-wide) */
    if (bmepCyl != null) {
      var yB = py0 + plotH - (bmepCyl / maxV) * plotH;
      ctx.strokeStyle = '#3ddc84';
      ctx.lineWidth = 2;
      ctx.setLineDash([6, 3]);
      ctx.beginPath();
      ctx.moveTo(x0, yB); ctx.lineTo(x0 + plotW, yB);
      ctx.stroke();
      ctx.setLineDash([]);
      /* BMEP legend chip in the clear space at the top of the plot
         (above the bars) so it never overlaps a bar or its value. */
      var bLbl = 'BMEP = ' + toBar(bmepCyl).toFixed(2) + ' ' + pUnit;
      ctx.font = 'bold 9px Courier New, monospace';
      var bw = ctx.measureText(bLbl).width;
      var chipX = x0 + plotW - bw - 22, chipY = py0 + 2;
      ctx.strokeStyle = '#3ddc84'; ctx.lineWidth = 2; ctx.setLineDash([5, 3]);
      ctx.beginPath(); ctx.moveTo(chipX, chipY + 6); ctx.lineTo(chipX + 16, chipY + 6); ctx.stroke();
      ctx.setLineDash([]);
      ctx.fillStyle = '#3ddc84'; ctx.textAlign = 'left';
      ctx.fillText(bLbl, chipX + 20, chipY + 9);
    }

    /* footer caption */
    ctx.fillStyle = '#6b7a99';
    ctx.font = '8px Segoe UI, sans-serif';
    ctx.textAlign = 'left';
    ctx.fillText(
      'MEP = (P × nRev) / (Vd × N)   |   V_total = ' + fmt(toD(displacement_L(), 'volume'), 2) + ' ' + uLabel('volume') + '   nRev = ' + nRev,
      x0, y0 + h - 4
    );
  }

