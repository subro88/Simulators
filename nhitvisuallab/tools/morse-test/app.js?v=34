  function escapeHtmlM(s) {
    if (s == null) return '';
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;')
      .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
  function kpiCardM(label, val, unit) {
    return '<div class="kpi"><div class="lbl">' + label + '</div>' +
      '<div class="val">' + val + '<span class="unit"> ' + (unit || '') + '</span></div></div>';
  }

