    html += '<div class="eq-line">\\( f = \\dfrac{1}{T} = ' + f.toFixed(3) + '\\,\\mathrm{Hz}, \\quad \\omega = \\sqrt{g/L} = ' + w.toFixed(3) + '\\,\\mathrm{rad/s} \\)</div>';
