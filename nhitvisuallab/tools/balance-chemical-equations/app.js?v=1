    var rows = Math.ceil(m / perRow);
    var bottomY = py - 20;
    ctx.textBaseline = 'middle';
    for (var idx = 0; idx < m; idx++) {
      var row = Math.floor(idx / perRow), col = idx % perRow;
      var inRow = Math.min(perRow, m - row * perRow);
      var tx = px - (inRow - 1) * tokenW / 2 + col * tokenW;
