    var topLimit = (ceilY || 0) + 30;      // keep 30px clear of the beam
    var availH = Math.max(rGap, bottomY - topLimit);
    var rowsFit = Math.max(1, Math.floor(availH / rGap) + 1);
    var perRow = Math.min(9, Math.max(1, Math.ceil(n / rowsFit)));
