  // ─── EXPORT CSV / PNG ──────────────────────────────────────
  function exportCSV() {
    var rows = ['Label,Tdb_C,Twb_C,Tdp_C,RH_%,W_g_per_kg,h_kJ_per_kg,v_m3_per_kg,p_kPa,alt_m'];
    state.points.forEach(function (p) {
      var rh = Psy.rhFromTWP(p.t, p.w, state.pPa) * 100;
      var tdp = Psy.tdpFromPw(Psy.pwFromW(p.w, state.pPa));
      var twb = Psy.twb(p.t, p.w, state.pPa);
      var h = Psy.enthalpy(p.t, p.w);
      var v = Psy.specificVolume(p.t, p.w, state.pPa);
      rows.push([p.label, p.t.toFixed(2), twb.toFixed(2), tdp.toFixed(2), rh.toFixed(1),
        (p.w * 1000).toFixed(3), h.toFixed(2), v.toFixed(4),
        (state.pPa / 1000).toFixed(2), Math.round(state.altM)].join(','));
    });
    var csv = rows.join('\n');
    var blob = new Blob([csv], { type: 'text/csv' });
    var a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'psychrometric-state-points.csv';
    a.click();
    URL.revokeObjectURL(a.href);
    playClick();
  }

