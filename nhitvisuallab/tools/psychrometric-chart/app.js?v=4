    var W = Psy.wFromTRhP(t, rh, pP);
    var asks = ['twb', 'tdp', 'h', 'w'];
    var ask = asks[Math.floor(Math.random() * asks.length)];
    var answer = 0, label = '', unit = '', tol = 0.3;
    if (ask === 'twb') {
      answer = Psy.twb(t, W, pP);
      label = 'Find the wet-bulb temperature';
      unit = '°C';
    } else if (ask === 'tdp') {
      answer = Psy.tdpFromPw(Psy.pwFromW(W, pP));
      label = 'Find the dew-point temperature';
      unit = '°C';
    } else if (ask === 'h') {
      answer = Psy.enthalpy(t, W);
      label = 'Find the specific enthalpy';
      unit = 'kJ/kg';
      tol = 1.0;
    } else {
      answer = W * 1000;
      label = 'Find the humidity ratio W';
      unit = 'g/kg';
      tol = 0.3;
    }
    state.prac.q = {
      t: t, rh: rh, ask: ask, answer: answer, unit: unit, tol: tol,
      text: label + ' for moist air at T<sub>db</sub> = ' + t.toFixed(1) + ' °C, φ = ' + (rh*100).toFixed(0) + '%, p = ' + (pP/1000).toFixed(1) + ' kPa.'
    };
