(function () {
  'use strict';

  // ============================================================
  // PSYCHROMETRIC MATH ENGINE
  // Implementation per ASHRAE Handbook of Fundamentals Ch. 1
  // Saturation pressure: Hyland-Wexler (split at 0 °C)
  // Validated against CoolProp / RP-1485 reference values.
  // ============================================================

  var Psy = (function () {
    var T0 = 273.15;        // K, 0 °C
    var M_RATIO = 0.621945; // M_water / M_dry_air
    var R_DA = 287.042;     // J/(kg·K), dry air gas constant
    var P_STD = 101325;     // Pa, sea-level standard pressure

    // ASHRAE Ch.1 Eq. (5): saturation pressure over ICE, -100..0 °C
    // ln(pws) = C1/T + C2 + C3*T + C4*T^2 + C5*T^3 + C6*T^4 + C7*ln(T), pws in Pa
    var C1 = -5.6745359e3, C2 = 6.3925247,  C3 = -9.677843e-3;
    var C4 =  6.2215701e-7, C5 = 2.0747825e-9, C6 = -9.484024e-13;
    var C7 = 4.1635019;

    // ASHRAE Ch.1 Eq. (6): saturation pressure over LIQUID WATER, 0..200 °C
    // ln(pws) = C8/T + C9 + C10*T + C11*T^2 + C12*T^3 + C13*ln(T)
    var C8 = -5.8002206e3, C9 = 1.3914993, C10 = -4.8640239e-2;
    var C11 = 4.1764768e-5, C12 = -1.4452093e-8, C13 = 6.5459673;

    /** Saturation pressure of water vapor in Pa, given t in °C. */
    function pws(t) {
      var T = t + T0;
      var ln;
      if (t < 0) {
        ln = C1/T + C2 + C3*T + C4*T*T + C5*T*T*T + C6*T*T*T*T + C7*Math.log(T);
      } else {
        ln = C8/T + C9 + C10*T + C11*T*T + C12*T*T*T + C13*Math.log(T);
      }
      return Math.exp(ln);
    }

    /** Inverse: dew-point in °C, given vapor partial pressure pw (Pa). */
    function tdpFromPw(pw) {
      // Bisection on pws(t) = pw, t in [-80, 70] °C
      if (pw <= 0) return -80;
      var lo = -80, hi = 70, mid;
      for (var i = 0; i < 60; i++) {
        mid = (lo + hi) / 2;
        if (pws(mid) < pw) lo = mid; else hi = mid;
        if (hi - lo < 1e-6) break;
      }
      return (lo + hi) / 2;
    }

    /** Humidity ratio W (kg/kg dry air) given vapor pressure pw and total p (Pa). */
    function wFromPw(pw, p) {
      if (pw >= p) pw = p - 1; // clip
      return M_RATIO * pw / (p - pw);
    }

    /** Vapor pressure pw (Pa) given humidity ratio W and total p (Pa). */
    function pwFromW(W, p) {
      return p * W / (M_RATIO + W);
    }

    /** Humidity ratio at saturation given t (°C) and p (Pa). */
    function wsFromTP(t, p) {
      return wFromPw(pws(t), p);
    }

    /** Humidity ratio from dry-bulb t (°C), RH (0..1), pressure p (Pa). */
    function wFromTRhP(t, rh, p) {
      var pw = rh * pws(t);
      return wFromPw(pw, p);
    }

    /** Relative humidity (0..1) from t (°C), W, p (Pa). */
    function rhFromTWP(t, W, p) {
      var pw = pwFromW(W, p);
      var rh = pw / pws(t);
      if (rh < 0) rh = 0;
      if (rh > 1) rh = 1;
      return rh;
    }

    /** Specific enthalpy h, kJ/kg dry air, given t (°C) and W (kg/kg).
     *  ASHRAE Ch.1 Eq.32: h = 1.006·t + W·(2501 + 1.86·t)  (SI, kJ/kg da). */
    function enthalpy(t, W) {
      return 1.006 * t + W * (2501 + 1.86 * t);
    }

    /** Solve for t (°C) given enthalpy h (kJ/kg da) and W. */
    function tFromHW(h, W) {
      // h = 1.006 t + W(2501 + 1.86 t)
      // h - 2501 W = t (1.006 + 1.86 W)
      return (h - 2501 * W) / (1.006 + 1.86 * W);
    }

    /** Specific volume v, m³/kg dry air, ASHRAE Ch.1 Eq.26.
     *  v = R_da · T · (1 + 1.6078·W) / p   (R_da in J/kg·K, T in K, p in Pa). */
    function specificVolume(t, W, p) {
      return R_DA * (t + T0) * (1 + 1.6078 * W) / p;
    }

    /** Air density (kg/m³), 1/v of moist air per total moist mass.
     *  rho_moist = (1 + W) / v  where v is m³/kg dry air. */
    function density(t, W, p) {
      var v = specificVolume(t, W, p);
      return (1 + W) / v;
    }

    /** Thermodynamic wet-bulb t* (°C) given t (°C), W (kg/kg), p (Pa).
     *  ASHRAE Ch.1 Eqs.35,37 — split at 0 °C.
     *  Above 0 °C:  W = [ Ws*(t*)·(2501 - 2.326·t*) - (t - t*) ] / [2501 + 1.86·t - 4.186·t*]
     *  Below 0 °C:  W = [ Ws*(t*)·(2830 - 0.24·t*)  - (t - t*) ] / [2830 + 1.86·t - 2.1·t*]
     *  Solved iteratively for t*. */
    function twb(t, W, p) {
      function f(ts) {
        var Ws = wsFromTP(ts, p);
        if (ts >= 0) {
          return (Ws * (2501 - 2.326 * ts) - (t - ts)) / (2501 + 1.86 * t - 4.186 * ts) - W;
        } else {
          return (Ws * (2830 - 0.24 * ts) - (t - ts)) / (2830 + 1.86 * t - 2.1 * ts) - W;
        }
      }
      // Bisection: t_wb between tdp and t.
      var pw = pwFromW(W, p);
      var tdp = tdpFromPw(pw);
      var lo = tdp - 0.1; // wet-bulb can be very slightly below dew point only at saturation
      var hi = t + 0.1;
      // ensure sign change; fallback widen
      var fl = f(lo), fh = f(hi);
      if (fl * fh > 0) {
        lo = -80; hi = 100;
        fl = f(lo); fh = f(hi);
        if (fl * fh > 0) return tdp; // degenerate; return dew point
      }
      var mid = (lo + hi) / 2;
      for (var i = 0; i < 80; i++) {
        mid = (lo + hi) / 2;
        var fm = f(mid);
        if (fl * fm < 0) { hi = mid; fh = fm; } else { lo = mid; fl = fm; }
        if (hi - lo < 1e-5) break;
      }
      return mid;
    }

    /** Inverse: humidity ratio W from dry-bulb t, wet-bulb t*, p. */
    function wFromTTwbP(t, ts, p) {
      var Ws = wsFromTP(ts, p);
      if (ts >= 0) {
        return (Ws * (2501 - 2.326 * ts) - 1.006 * (t - ts)) / (2501 + 1.86 * t - 4.186 * ts);
      } else {
        return (Ws * (2830 - 0.24 * ts) - 1.006 * (t - ts)) / (2830 + 1.86 * t - 2.1 * ts);
      }
    }

    /** ASHRAE Ch.1 Eq.3: standard atmosphere pressure from altitude (m). */
    function pFromAltitude(altM) {
      return 101325 * Math.pow(1 - 2.25577e-5 * altM, 5.2559);
    }

    /** Inverse altitude approx (for slider sync). */
    function altitudeFromP(pPa) {
      // invert p = 101325·(1 - 2.25577e-5·z)^5.2559
      var ratio = pPa / 101325;
      var z = (1 - Math.pow(ratio, 1 / 5.2559)) / 2.25577e-5;
      if (z < 0) z = 0;
      return z;
    }

    return {
      T0: T0, M_RATIO: M_RATIO, R_DA: R_DA, P_STD: P_STD,
      pws: pws, tdpFromPw: tdpFromPw,
      wFromPw: wFromPw, pwFromW: pwFromW, wsFromTP: wsFromTP,
      wFromTRhP: wFromTRhP, rhFromTWP: rhFromTWP,
      enthalpy: enthalpy, tFromHW: tFromHW,
      specificVolume: specificVolume, density: density,
      twb: twb, wFromTTwbP: wFromTTwbP,
      pFromAltitude: pFromAltitude, altitudeFromP: altitudeFromP
    };
  })();

  // ============================================================
  // STATE
  // ============================================================
  // Internal canonical state is ALWAYS SI: °C, kg/kg, Pa.
  // Display layer converts on the fly.

  var state = {
    mode: 'simulate',
    unit: 'si',
    pPa: 101325,
    altM: 0,
    points: [],           // [{id, label, t, w, color, locked:false}]
    activeId: 1,
    nextId: 2,
    overlays: { comfort: false, datacenter: false, wb: true, enth: true, vol: false },
    process: 'none',
    procParams: { dt: 10, dW: 0.003, target: 18, ratio: 0.5 },
    mflow: 1.0,           // kg dry air / s
    audioCtx: null,
    prac: { score: 0, total: 0, q: null },
    quiz: { idx: 0, score: 0, q: [], answered: false }
  };

  // 5 distinct point colors (A..E)
  var POINT_COLORS = ['#14b8a6', '#f5c842', '#9c8cff', '#ff8b6b', '#3ddc84'];
  var POINT_LABELS = ['A','B','C','D','E'];

  function makePoint(t, rh) {
    var W = Psy.wFromTRhP(t, rh, state.pPa);
    var idx = state.points.length;
    return {
      id: state.nextId++,
      label: POINT_LABELS[idx] || ('P' + (idx+1)),
      t: t,
      w: W,
      color: POINT_COLORS[idx] || '#14b8a6'
    };
  }

  // Initial point
  state.points.push(makePoint(25, 0.50));
  state.activeId = state.points[0].id;

  // ============================================================
  // UNIT CONVERSION HELPERS
  // ============================================================

  function isIP() { return state.unit === 'ip'; }

  // °C ↔ °F
  function tDisp(tC)   { return isIP() ? (tC * 9/5 + 32) : tC; }
  function tToSI(tD)   { return isIP() ? ((tD - 32) * 5/9) : tD; }
  function uT()        { return isIP() ? '°F' : '°C'; }

  // kg/kg ↔ gr/lb (grains per lb dry air). 1 kg/kg = 7000 gr/lb.
  // Display W in g/kg (SI) or gr/lb (IP) for readability.
  function wDisp(wKg)  { return isIP() ? (wKg * 7000) : (wKg * 1000); }
  function wToSI(wD)   { return isIP() ? (wD / 7000) : (wD / 1000); }
  function uW()        { return isIP() ? 'gr/lb' : 'g/kg'; }

  // kJ/kg ↔ Btu/lb. ASHRAE Ch.1 IP: h = 0.240·t(°F) + W·(1061 + 0.444·t(°F))
  // We store SI enthalpy and use ASHRAE IP relation; conversion factor 1 kJ/kg = 0.4299 Btu/lb (close)
  // but for accuracy we recompute from t,W in IP form.
  function hDispFromTW(tC, W) {
    if (!isIP()) return Psy.enthalpy(tC, W);
    var tF = tC * 9/5 + 32;
    return 0.240 * tF + W * (1061 + 0.444 * tF); // Btu / lb dry air
  }
  function uH()        { return isIP() ? 'Btu/lb' : 'kJ/kg'; }

  // kPa ↔ inHg
  function pDisp(pPa)  { return isIP() ? (pPa / 3386.39) : (pPa / 1000); }
  function pToSI(pD)   { return isIP() ? (pD * 3386.39)  : (pD * 1000); }
  function uP()        { return isIP() ? 'inHg' : 'kPa'; }

  // m ↔ ft
  function altDisp(m)  { return isIP() ? (m * 3.28084) : m; }
  function altToSI(d)  { return isIP() ? (d / 3.28084) : d; }
  function uAlt()      { return isIP() ? 'ft' : 'm'; }

  // m³/kg ↔ ft³/lb (1 m³/kg = 16.0185 ft³/lb)
  function vDisp(vSI)  { return isIP() ? (vSI * 16.0185) : vSI; }
  function uV()        { return isIP() ? 'ft³/lb' : 'm³/kg'; }

  // kg/m³ ↔ lb/ft³ (1 kg/m³ = 0.0624 lb/ft³)
  function rhoDisp(r)  { return isIP() ? (r * 0.062428) : r; }
  function uRho()      { return isIP() ? 'lb/ft³' : 'kg/m³'; }

  // ============================================================
  // DOM HELPERS
  // ============================================================

  function $(id) { return document.getElementById(id); }
  function $$(sel, root) { return Array.prototype.slice.call((root || document).querySelectorAll(sel)); }

  // ============================================================
  // CHART RENDERER
  // ============================================================
  // Chart axes (SI internal, regardless of display unit):
  // X: dry-bulb t  [TX_MIN .. TX_MAX] °C
  // Y: humidity ratio W [0 .. WY_MAX] kg/kg

  var TX_MIN = -10, TX_MAX = 50;
  var WY_MAX = 0.030;

  var canvas, ctx;
  var chartRect = { x0: 0, y0: 0, x1: 0, y1: 0 };
  var gridCache = null; // offscreen canvas for the static grid

  function setupCanvas() {
    canvas = $('chart-canvas');
    ctx = canvas.getContext('2d');
    sizeCanvas();
    window.addEventListener('resize', function () {
      sizeCanvas();
      invalidateGrid();
      render();
    });
  }

  function sizeCanvas() {
    var dpr = window.devicePixelRatio || 1;
    var rect = canvas.getBoundingClientRect();
    var cssW = rect.width;
    var cssH = Math.round(cssW * 2/3);
    canvas.width = Math.round(cssW * dpr);
    canvas.height = Math.round(cssH * dpr);
    canvas.style.height = cssH + 'px';
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    layoutChart(cssW, cssH);
  }

  function layoutChart(W, H) {
    chartRect.x0 = 60;
    chartRect.y0 = 24;
    chartRect.x1 = W - 60;
    chartRect.y1 = H - 50;
  }

  function tx(tC) {
    return chartRect.x0 + (tC - TX_MIN) / (TX_MAX - TX_MIN) * (chartRect.x1 - chartRect.x0);
  }
  function wy(W) {
    return chartRect.y1 - (W / WY_MAX) * (chartRect.y1 - chartRect.y0);
  }
  function xT(px) {
    return TX_MIN + (px - chartRect.x0) / (chartRect.x1 - chartRect.x0) * (TX_MAX - TX_MIN);
  }
  function yW(py) {
    return Math.max(0, (chartRect.y1 - py) / (chartRect.y1 - chartRect.y0) * WY_MAX);
  }

  function invalidateGrid() { gridCache = null; }

  function drawGrid() {
    var W = chartRect.x1 - chartRect.x0;
    var H = chartRect.y1 - chartRect.y0;
    if (gridCache && gridCache.w === W && gridCache.h === H && gridCache.p === state.pPa) {
      ctx.drawImage(gridCache.canvas, chartRect.x0 - 60, chartRect.y0 - 24);
      return;
    }

    var off = document.createElement('canvas');
    var dpr = window.devicePixelRatio || 1;
    var totalW = W + 120;
    var totalH = H + 74;
    off.width = totalW * dpr;
    off.height = totalH * dpr;
    var octx = off.getContext('2d');
    octx.setTransform(dpr, 0, 0, dpr, 0, 0);

    // We draw in coordinates offset so the chart origin aligns
    var ox = 60, oy = 24;

    // Background — gradient for depth
    var bgGrad = octx.createLinearGradient(0, 0, 0, totalH);
    bgGrad.addColorStop(0, '#0f1521');
    bgGrad.addColorStop(1, '#080c14');
    octx.fillStyle = bgGrad;
    octx.fillRect(0, 0, totalW, totalH);

    // --- Major background grid (every 5°C × 5 g/kg) — soft, helps reading
    octx.strokeStyle = 'rgba(255,255,255,0.05)';
    octx.lineWidth = 1;
    octx.beginPath();
    for (var tg = -5; tg <= 50; tg += 5) {
      var xg = ox + (tg - TX_MIN) / (TX_MAX - TX_MIN) * W;
      octx.moveTo(xg, oy); octx.lineTo(xg, oy + H);
    }
    for (var wg = 0.005; wg <= 0.030; wg += 0.005) {
      var yg = oy + H - (wg / WY_MAX) * H;
      octx.moveTo(ox, yg); octx.lineTo(ox + W, yg);
    }
    octx.stroke();

    function drawCurveLabel(text, lx, ly, color, bg) {
      octx.save();
      octx.font = 'bold 10px "Segoe UI", system-ui, sans-serif';
      var tw = octx.measureText(text).width;
      octx.fillStyle = bg || 'rgba(15,21,33,0.85)';
      octx.fillRect(lx - 2, ly - 9, tw + 4, 12);
      octx.fillStyle = color;
      octx.fillText(text, lx, ly);
      octx.restore();
    }

    // --- Saturation curve (RH=100%) — bright cyan, the most important line
    octx.strokeStyle = '#22d3ee';
    octx.lineWidth = 2.6;
    octx.shadowColor = 'rgba(34,211,238,0.6)';
    octx.shadowBlur = 4;
    octx.beginPath();
    var first = true;
    for (var t = TX_MIN; t <= TX_MAX; t += 0.5) {
      var Ws = Psy.wsFromTP(t, state.pPa);
      if (Ws > WY_MAX) continue;
      var px = ox + (t - TX_MIN) / (TX_MAX - TX_MIN) * W;
      var py = oy + H - (Ws / WY_MAX) * H;
      if (first) { octx.moveTo(px, py); first = false; }
      else octx.lineTo(px, py);
    }
    octx.stroke();
    octx.shadowBlur = 0;
    // Saturation curve label "100% RH"
    var satLabT = 12;
    var satLabW = Psy.wsFromTP(satLabT, state.pPa);
    if (satLabW < WY_MAX) {
      drawCurveLabel('100% RH', ox + (satLabT - TX_MIN)/(TX_MAX-TX_MIN)*W - 30, oy + H - (satLabW/WY_MAX)*H - 4, '#67e8f9');
    }

    // --- RH curves (10..90) — brighter cyan family, varying alpha
    octx.font = 'bold 10px "Segoe UI", system-ui, sans-serif';
    for (var rh = 10; rh <= 90; rh += 10) {
      var isMajor = (rh % 20 === 0) || rh === 50;
      octx.strokeStyle = isMajor ? 'rgba(34,211,238,0.55)' : 'rgba(34,211,238,0.30)';
      octx.lineWidth = isMajor ? 1.1 : 0.8;
      octx.beginPath();
      var f = true;
      for (var tt = TX_MIN; tt <= TX_MAX; tt += 0.5) {
        var Ww = Psy.wFromTRhP(tt, rh/100, state.pPa);
        if (Ww > WY_MAX) continue;
        var pxx = ox + (tt - TX_MIN) / (TX_MAX - TX_MIN) * W;
        var pyy = oy + H - (Ww / WY_MAX) * H;
        if (f) { octx.moveTo(pxx, pyy); f = false; }
        else octx.lineTo(pxx, pyy);
      }
      octx.stroke();
      // Label on the curve at t ≈ 38 (right side, away from points)
      var tlab = 38;
      var Wl = Psy.wFromTRhP(tlab, rh/100, state.pPa);
      if (Wl < WY_MAX * 0.95) {
        var lx = ox + (tlab - TX_MIN) / (TX_MAX - TX_MIN) * W;
        var ly = oy + H - (Wl / WY_MAX) * H;
        drawCurveLabel(rh + '%', lx + 3, ly - 2, isMajor ? '#a5f3fc' : '#67e8f9');
      }
    }

    // --- Constant wet-bulb lines (every 5 °C) — lime green, distinct family
    if (state.overlays.wb) {
      octx.strokeStyle = 'rgba(163,230,53,0.42)';
      octx.lineWidth = 0.9;
      for (var twbV = -10; twbV <= 35; twbV += 5) {
        var Ws_at_twb = Psy.wsFromTP(twbV, state.pPa);
        if (Ws_at_twb < 0) continue;
        octx.beginPath();
        var fa = true;
        for (var tw = twbV; tw <= TX_MAX; tw += 1) {
          var Ww2 = Psy.wFromTTwbP(tw, twbV, state.pPa);
          if (Ww2 < 0 || Ww2 > WY_MAX) continue;
          var pxw = ox + (tw - TX_MIN) / (TX_MAX - TX_MIN) * W;
          var pyw = oy + H - (Ww2 / WY_MAX) * H;
          if (fa) { octx.moveTo(pxw, pyw); fa = false; }
          else octx.lineTo(pxw, pyw);
        }
        octx.stroke();
        // label at saturation curve attachment point — on the curve itself
        var pxl = ox + (twbV - TX_MIN) / (TX_MAX - TX_MIN) * W;
        var pyl = oy + H - (Ws_at_twb / WY_MAX) * H;
        if (pyl > oy && pyl < oy + H && twbV % 5 === 0 && twbV >= 0) {
          drawCurveLabel(twbV + '°wb', pxl - 24, pyl - 4, '#bef264');
        }
      }
    }

    // --- Constant enthalpy lines (every 10 kJ/kg) — amber, dashed
    if (state.overlays.enth) {
      octx.strokeStyle = 'rgba(251,191,36,0.42)';
      octx.lineWidth = 0.9;
      octx.setLineDash([6, 4]);
      for (var hh = 0; hh <= 120; hh += 10) {
        octx.beginPath();
        var fb = true;
        var lastX = 0, lastY = 0;
        for (var th = TX_MIN; th <= TX_MAX; th += 1) {
          var Wh = (hh - 1.006 * th) / (2501 + 1.86 * th);
          if (Wh < 0 || Wh > WY_MAX) continue;
          var pxh = ox + (th - TX_MIN) / (TX_MAX - TX_MIN) * W;
          var pyh = oy + H - (Wh / WY_MAX) * H;
          if (fb) { octx.moveTo(pxh, pyh); fb = false; }
          else octx.lineTo(pxh, pyh);
          lastX = pxh; lastY = pyh;
        }
        octx.stroke();
        // Label at right edge — every 20 kJ/kg
        if (hh % 20 === 0 && lastX > ox && lastX < ox + W) {
          octx.setLineDash([]);
          drawCurveLabel(hh + ' kJ/kg', lastX - 50, lastY - 3, '#fcd34d');
          octx.setLineDash([6, 4]);
        }
      }
      octx.setLineDash([]);
    }

    // --- Constant specific-volume lines (every 0.02 m³/kg) — purple, dotted
    if (state.overlays.vol) {
      octx.strokeStyle = 'rgba(167,139,250,0.42)';
      octx.lineWidth = 0.9;
      octx.setLineDash([2, 4]);
      for (var vv = 0.78; vv <= 0.96; vv += 0.02) {
        octx.beginPath();
        var fc = true;
        var firstVX = 0, firstVY = 0;
        for (var tv = TX_MIN; tv <= TX_MAX; tv += 1) {
          var Wv = (vv * state.pPa / (Psy.R_DA * (tv + Psy.T0)) - 1) / 1.6078;
          if (Wv < 0 || Wv > WY_MAX) continue;
          var pxv = ox + (tv - TX_MIN) / (TX_MAX - TX_MIN) * W;
          var pyv = oy + H - (Wv / WY_MAX) * H;
          if (fc) { octx.moveTo(pxv, pyv); firstVX = pxv; firstVY = pyv; fc = false; }
          else octx.lineTo(pxv, pyv);
        }
        octx.stroke();
        if (Math.abs(vv * 100 - Math.round(vv * 100)) < 0.01 && (Math.round(vv*100)) % 4 === 0 && firstVX > 0) {
          octx.setLineDash([]);
          drawCurveLabel(vv.toFixed(2), firstVX + 4, firstVY + 12, '#c4b5fd');
          octx.setLineDash([2, 4]);
        }
      }
      octx.setLineDash([]);
    }

    // --- Axes — bright
    octx.strokeStyle = '#6b7a99';
    octx.lineWidth = 1.5;
    octx.beginPath();
    octx.moveTo(ox, oy); octx.lineTo(ox, oy + H);
    octx.lineTo(ox + W, oy + H);
    octx.stroke();

    // X-axis ticks/labels (dry-bulb) — high contrast white-ish
    octx.fillStyle = '#e5e7eb';
    octx.font = 'bold 12px "Segoe UI", system-ui, sans-serif';
    octx.textAlign = 'center';
    var tStep = isIP() ? 10 : 5; // °F vs °C
    var tdisp_min = isIP() ? Math.ceil(tDisp(TX_MIN)/10)*10 : TX_MIN;
    var tdisp_max = isIP() ? Math.floor(tDisp(TX_MAX)/10)*10 : TX_MAX;
    for (var tk = tdisp_min; tk <= tdisp_max; tk += tStep) {
      var tkSI = tToSI(tk);
      if (tkSI < TX_MIN || tkSI > TX_MAX) continue;
      var xx = ox + (tkSI - TX_MIN) / (TX_MAX - TX_MIN) * W;
      octx.beginPath();
      octx.moveTo(xx, oy + H); octx.lineTo(xx, oy + H + 5);
      octx.strokeStyle = '#9ca3af';
      octx.lineWidth = 1.2;
      octx.stroke();
      octx.fillText(String(tk), xx, oy + H + 18);
    }
    octx.fillStyle = '#f3f4f6';
    octx.font = 'bold 13px "Segoe UI", system-ui, sans-serif';
    octx.fillText('Dry-bulb temperature (' + uT() + ')', ox + W/2, oy + H + 38);

    // Y-axis ticks/labels (W)
    octx.fillStyle = '#e5e7eb';
    octx.font = 'bold 12px "Segoe UI", system-ui, sans-serif';
    octx.textAlign = 'right';
    var wStep = isIP() ? 20 : 0.005;
    var wMaxDisp = isIP() ? wDisp(WY_MAX) : WY_MAX;
    for (var wk = 0; wk <= wMaxDisp + 1e-6; wk += wStep) {
      var wkSI = isIP() ? wToSI(wk) : wk;
      if (wkSI > WY_MAX + 1e-9) break;
      var yy = oy + H - (wkSI / WY_MAX) * H;
      octx.beginPath();
      octx.moveTo(ox - 5, yy); octx.lineTo(ox, yy);
      octx.strokeStyle = '#9ca3af';
      octx.lineWidth = 1.2;
      octx.stroke();
      var lab = isIP() ? Math.round(wk) : (wk * 1000).toFixed(0);
      octx.fillText(lab, ox - 7, yy + 4);
    }
    // Right-side W axis label
    octx.save();
    octx.translate(ox + W + 28, oy + H/2);
    octx.rotate(-Math.PI/2);
    octx.textAlign = 'center';
    octx.fillStyle = '#f3f4f6';
    octx.font = 'bold 13px "Segoe UI", system-ui, sans-serif';
    octx.fillText('Humidity ratio W (' + uW() + ')', 0, 0);
    octx.restore();

    // Title — readable
    octx.fillStyle = '#cbd5e1';
    octx.font = 'bold 11px "Segoe UI", system-ui, sans-serif';
    octx.textAlign = 'left';
    octx.font = '10px Courier New, monospace';
    octx.fillText('p = ' + pDisp(state.pPa).toFixed(1) + ' ' + uP() + '  alt = ' + Math.round(altDisp(state.altM)) + ' ' + uAlt(), ox, oy - 8);

    gridCache = { canvas: off, w: W, h: H, p: state.pPa };
    ctx.drawImage(off, chartRect.x0 - 60, chartRect.y0 - 24);
  }

  function drawComfortZone() {
    // ASHRAE 55 simplified: summer (T=23-26°C, RH 20-65%); winter (T=20-23.5°C, RH 20-65%)
    function fillZone(tLo, tHi, rhLo, rhHi, color) {
      ctx.fillStyle = color;
      ctx.strokeStyle = color.replace(/[\d.]+\)$/, '0.5)');
      ctx.lineWidth = 1;
      ctx.beginPath();
      // top edge (rhHi)
      for (var t = tLo; t <= tHi; t += 0.5) {
        var W = Psy.wFromTRhP(t, rhHi/100, state.pPa);
        var px = tx(t), py = wy(W);
        if (t === tLo) ctx.moveTo(px, py);
        else ctx.lineTo(px, py);
      }
      // right edge (tHi, rhHi->rhLo)
      for (var r = rhHi; r >= rhLo; r -= 5) {
        var Wr = Psy.wFromTRhP(tHi, r/100, state.pPa);
        ctx.lineTo(tx(tHi), wy(Wr));
      }
      // bottom edge
      for (var tb = tHi; tb >= tLo; tb -= 0.5) {
        var Wb = Psy.wFromTRhP(tb, rhLo/100, state.pPa);
        ctx.lineTo(tx(tb), wy(Wb));
      }
      // left edge
      for (var rl = rhLo; rl <= rhHi; rl += 5) {
        var Wl = Psy.wFromTRhP(tLo, rl/100, state.pPa);
        ctx.lineTo(tx(tLo), wy(Wl));
      }
      ctx.closePath();
      ctx.fill();
      ctx.stroke();
    }
    fillZone(23, 26, 20, 65, 'rgba(245,200,66,0.10)'); // summer
    fillZone(20, 23.5, 20, 65, 'rgba(61,220,132,0.10)'); // winter
    // Label
    ctx.fillStyle = 'rgba(245,200,66,0.7)';
    ctx.font = '10px Courier New, monospace';
    ctx.textAlign = 'center';
    ctx.fillText('ASHRAE 55 Summer', tx(24.5), wy(Psy.wFromTRhP(24.5, 0.45, state.pPa)));
    ctx.fillStyle = 'rgba(61,220,132,0.7)';
    ctx.fillText('Winter', tx(21.5), wy(Psy.wFromTRhP(21.5, 0.30, state.pPa)));
  }

  function drawDataCenterZones() {
    // ASHRAE TC 9.9 (2021), simplified rectangles in (Tdb, Tdp)
    // Recommended: 18-27°C, Tdp -9°C..15°C
    // A1: 15-32°C, RH 8-80%, Tdp ≤17°C
    // A2: 10-35°C
    // A3: 5-40°C
    // A4: 5-45°C
    function rectZone(tLo, tHi, tdpLo, tdpHi, color, label) {
      ctx.fillStyle = color;
      ctx.strokeStyle = color.replace(/[\d.]+\)$/, '0.6)');
      ctx.lineWidth = 1;
      ctx.beginPath();
      var WLo = Psy.wFromPw(Psy.pws(tdpLo), state.pPa);
      var WHi = Psy.wFromPw(Psy.pws(tdpHi), state.pPa);
      ctx.moveTo(tx(tLo), wy(WLo));
      ctx.lineTo(tx(tHi), wy(WLo));
      ctx.lineTo(tx(tHi), wy(WHi));
      ctx.lineTo(tx(tLo), wy(WHi));
      ctx.closePath();
      ctx.fill();
      ctx.stroke();
      ctx.fillStyle = color.replace(/[\d.]+\)$/, '0.9)');
      ctx.font = 'bold 10px Courier New, monospace';
      ctx.textAlign = 'left';
      ctx.fillText(label, tx(tLo) + 4, wy(WHi) + 12);
    }
    rectZone(5, 45, -12, 24, 'rgba(255,100,100,0.05)', 'A4');
    rectZone(5, 40, -12, 24, 'rgba(255,140,100,0.06)', 'A3');
    rectZone(10, 35, -12, 21, 'rgba(255,180,100,0.07)', 'A2');
    rectZone(15, 32, -12, 17, 'rgba(245,200,66,0.10)', 'A1');
    rectZone(18, 27, -9, 15, 'rgba(20,184,166,0.14)', 'Recommended');
  }

  function drawProcessLine() {
    if (state.process === 'none' || state.points.length === 0) return;
    var a = state.points[0];
    if (!a) return;
    ctx.strokeStyle = '#9c8cff';
    ctx.lineWidth = 2;
    ctx.setLineDash([6, 3]);

    var endT = a.t, endW = a.w;
    var p = state.procParams;

    if (state.process === 'sens-heat') {
      endT = a.t + Math.abs(p.dt);
      endW = a.w;
    } else if (state.process === 'sens-cool') {
      endT = a.t - Math.abs(p.dt);
      endW = a.w;
    } else if (state.process === 'humid-steam') {
      endT = a.t;
      endW = Math.min(a.w + Math.abs(p.dW), Psy.wsFromTP(a.t, state.pPa));
    } else if (state.process === 'humid-evap') {
      // constant wet-bulb (adiabatic saturation)
      var twb_a = Psy.twb(a.t, a.w, state.pPa);
      endT = a.t - Math.abs(p.dt);
      if (endT < twb_a) endT = twb_a;
      endW = Psy.wFromTTwbP(endT, twb_a, state.pPa);
    } else if (state.process === 'dehum') {
      // cooling + dehumidification — straight line toward apparatus dew point
      endT = p.target;
      var rhEnd = 0.95;
      endW = Math.min(a.w, Psy.wFromTRhP(endT, rhEnd, state.pPa));
    } else if (state.process === 'mix' && state.points.length >= 2) {
      var b = state.points[1];
      endT = a.t * (1 - p.ratio) + b.t * p.ratio;
      endW = a.w * (1 - p.ratio) + b.w * p.ratio;
      // draw line from A to B and mark mix point
      ctx.beginPath();
      ctx.moveTo(tx(a.t), wy(a.w));
      ctx.lineTo(tx(b.t), wy(b.w));
      ctx.stroke();
      ctx.setLineDash([]);
      ctx.fillStyle = '#9c8cff';
      ctx.beginPath();
      ctx.arc(tx(endT), wy(endW), 7, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = '#fff';
      ctx.font = 'bold 11px Courier New, monospace';
      ctx.textAlign = 'center';
      ctx.fillText('M', tx(endT), wy(endW) + 4);
      ctx.setLineDash([]);
      return;
    }

    ctx.beginPath();
    ctx.moveTo(tx(a.t), wy(a.w));
    ctx.lineTo(tx(endT), wy(endW));
    ctx.stroke();
    ctx.setLineDash([]);

    // End marker
    ctx.fillStyle = '#9c8cff';
    ctx.beginPath();
    ctx.arc(tx(endT), wy(endW), 6, 0, Math.PI * 2);
    ctx.fill();
    ctx.fillStyle = '#fff';
    ctx.font = 'bold 10px Courier New, monospace';
    ctx.textAlign = 'center';
    ctx.fillText('→', tx(endT), wy(endW) + 4);
  }

  function drawPoints() {
    for (var i = 0; i < state.points.length; i++) {
      var p = state.points[i];
      var px = tx(p.t), py = wy(p.w);
      var isActive = p.id === state.activeId;
      // Outer glow ring (active)
      if (isActive) {
        ctx.beginPath();
        ctx.arc(px, py, 16, 0, Math.PI * 2);
        ctx.fillStyle = p.color;
        ctx.globalAlpha = 0.18;
        ctx.fill();
        ctx.globalAlpha = 1;
      }
      // Solid circle with white border
      ctx.beginPath();
      ctx.arc(px, py, isActive ? 10 : 7, 0, Math.PI * 2);
      ctx.fillStyle = p.color;
      ctx.fill();
      ctx.strokeStyle = '#ffffff';
      ctx.lineWidth = isActive ? 2.8 : 1.6;
      ctx.shadowColor = 'rgba(0,0,0,0.6)';
      ctx.shadowBlur = 4;
      ctx.stroke();
      ctx.shadowBlur = 0;
      // Label pill above the point
      ctx.font = 'bold 11px "Segoe UI", system-ui, sans-serif';
      var labW = ctx.measureText(p.label).width + 12;
      var labY = py - (isActive ? 18 : 14);
      ctx.fillStyle = p.color;
      ctx.beginPath();
      if (ctx.roundRect) {
        ctx.roundRect(px - labW/2, labY - 8, labW, 14, 7);
      } else {
        ctx.rect(px - labW/2, labY - 8, labW, 14);
      }
      ctx.fill();
      ctx.fillStyle = '#0f1521';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(p.label, px, labY - 1);
      ctx.textBaseline = 'alphabetic';
      // Crosshair guide lines (active point only — high contrast)
      if (isActive) {
        ctx.strokeStyle = 'rgba(255,255,255,0.25)';
        ctx.lineWidth = 0.8;
        ctx.setLineDash([3, 3]);
        ctx.beginPath();
        ctx.moveTo(chartRect.x0, py); ctx.lineTo(px, py);
        ctx.moveTo(px, py); ctx.lineTo(px, chartRect.y1);
        ctx.stroke();
        ctx.setLineDash([]);
        // axis pip
        ctx.fillStyle = p.color;
        ctx.fillRect(px - 1, chartRect.y1, 2, 6);
        ctx.fillRect(chartRect.x0 - 6, py - 1, 6, 2);
      }
    }
  }

  function render() {
    if (!ctx) return;
    var rect = canvas.getBoundingClientRect();
    ctx.clearRect(0, 0, rect.width, rect.height);
    drawGrid();
    if (state.overlays.datacenter) drawDataCenterZones();
    if (state.overlays.comfort) drawComfortZone();
    drawProcessLine();
    drawPoints();
  }

  // ============================================================
  // PROPERTY PANEL
  // ============================================================

  function activePoint() {
    return state.points.find(function (p) { return p.id === state.activeId; }) || state.points[0];
  }

  function updatePointSelect() {
    var sel = $('active-point');
    if (!sel) return;
    sel.innerHTML = '';
    state.points.forEach(function (p) {
      var opt = document.createElement('option');
      opt.value = p.id;
      opt.textContent = 'Point ' + p.label;
      if (p.id === state.activeId) opt.selected = true;
      sel.appendChild(opt);
    });
  }

  function fmt(v, d) { return (isFinite(v) ? Number(v).toFixed(d == null ? 2 : d) : '—'); }

  function updateProperties() {
    var p = activePoint();
    if (!p) return;
    var t = p.t, W = p.w, pPa = state.pPa;
    var rh = Psy.rhFromTWP(t, W, pPa);
    var tdp = Psy.tdpFromPw(Psy.pwFromW(W, pPa));
    var twb = Psy.twb(t, W, pPa);
    var hSI = Psy.enthalpy(t, W);
    var hDisp = hDispFromTW(t, W);
    var v = Psy.specificVolume(t, W, pPa);
    var rho = Psy.density(t, W, pPa);

    // Inputs (skip if user is currently typing — focused field)
    function setIfNotFocused(id, val, d) {
      var el = $(id);
      if (!el || document.activeElement === el) return;
      el.value = fmt(val, d == null ? 2 : d);
    }
    setIfNotFocused('in-tdb', tDisp(t), 2);
    setIfNotFocused('in-twb', tDisp(twb), 2);
    setIfNotFocused('in-tdp', tDisp(tdp), 2);
    setIfNotFocused('in-rh',  rh * 100, 1);
    setIfNotFocused('in-w',   wDisp(W), isIP() ? 1 : 3);
    setIfNotFocused('in-h',   hDisp, 2);
    setIfNotFocused('in-v',   vDisp(v), 3);
    setIfNotFocused('in-rho', rhoDisp(rho), 3);

    // Unit labels
    $('u-tdb').textContent = uT();
    $('u-twb').textContent = uT();
    $('u-tdp').textContent = uT();
    $('u-w').textContent   = uW();
    $('u-h').textContent   = uH();
    $('u-v').textContent   = uV();
    $('u-rho').textContent = uRho();

    // Readout badges
    $('rb-tdb').textContent = fmt(tDisp(t), 1);
    $('rb-rh').textContent  = fmt(rh * 100, 1);
    $('rb-w').textContent   = fmt(wDisp(W), isIP() ? 1 : 2);
    $('rb-h').textContent   = fmt(hDisp, 1);
    $('rb-twb').textContent = fmt(tDisp(twb), 1);
    $('rb-u-t').textContent  = uT();
    $('rb-u-t2').textContent = uT();
    $('rb-u-w').textContent  = uW();
    $('rb-u-h').textContent  = uH();
  }

  function updateAltitudeUI() {
    // Sync altitude and pressure sliders display
    $('val-alt').textContent = Math.round(altDisp(state.altM));
    $('val-p').textContent   = pDisp(state.pPa).toFixed(isIP() ? 2 : 1);
    $('u-alt').textContent = uAlt();
    $('u-p').textContent = uP();
    // Sync slider positions to internal SI
    var altSl = $('sl-alt'), pSl = $('sl-p');
    if (altSl) altSl.value = state.altM;
    if (pSl) pSl.value = state.pPa / 1000;
    // Warning
    $('alt-warn').style.display = state.altM > 750 ? 'block' : 'none';
  }

  function updateMflowUI() {
    var disp = isIP() ? state.mflow * 7936.64 : state.mflow; // kg/s ↔ lb/h (1 kg/s = 7936.64 lb/h)
    $('val-mflow').textContent = isIP() ? Math.round(disp) : disp.toFixed(2);
    $('u-mflow').textContent = isIP() ? 'lb/h' : 'kg/s';
    var sl = $('sl-mflow');
    if (sl && document.activeElement !== sl) sl.value = state.mflow;
  }

  // ============================================================
  // PROPERTY EDITING — solve any-2-of-6
  // ============================================================
  // The user can edit Tdb, Twb, Tdp, RH, W, h. We always treat dry-bulb as
  // the primary state coord and reconstruct W from the secondary edit.

  var lastEdit = { primary: 'tdb', secondary: 'rh' }; // remembers which two

  function handlePropertyEdit(field) {
    var p = activePoint();
    if (!p) return;
    var pPa = state.pPa;

    var inTdb = parseFloat($('in-tdb').value);
    var inTwb = parseFloat($('in-twb').value);
    var inTdp = parseFloat($('in-tdp').value);
    var inRh  = parseFloat($('in-rh').value);
    var inW   = parseFloat($('in-w').value);
    var inH   = parseFloat($('in-h').value);

    // Track the two most recently edited fields
    if (field !== lastEdit.primary && field !== lastEdit.secondary) {
      lastEdit.primary = lastEdit.secondary;
      lastEdit.secondary = field;
    } else if (field === lastEdit.primary) {
      // primary re-edited; keep
    } else {
      // secondary re-edited; keep
    }

    var t = p.t, W = p.w;
    var pair = [lastEdit.primary, lastEdit.secondary].sort().join('+');

    // Warn for ill-conditioned pair (twb + tdp)
    var warn = '';
    if (pair === 'tdp+twb') warn = '(T_wb, T_dp) pair is ill-conditioned near saturation — prefer including T_db.';

    // Solve based on pair. We need t (°C) and W (kg/kg).
    try {
      if (pair === 'rh+tdb') {
        t = tToSI(inTdb);
        W = Psy.wFromTRhP(t, Math.max(0, Math.min(100, inRh))/100, pPa);
      } else if (pair === 'tdb+w') {
        t = tToSI(inTdb);
        W = wToSI(inW);
      } else if (pair === 'tdb+tdp') {
        t = tToSI(inTdb);
        var tdpC = tToSI(inTdp);
        W = Psy.wFromPw(Psy.pws(tdpC), pPa);
      } else if (pair === 'tdb+twb') {
        t = tToSI(inTdb);
        var twbC = tToSI(inTwb);
        W = Psy.wFromTTwbP(t, twbC, pPa);
      } else if (pair === 'h+tdb') {
        t = tToSI(inTdb);
        // we stored h in display units; convert back via inverse of hDispFromTW
        if (isIP()) {
          var tF = inTdb;
          W = (inH - 0.240 * tF) / (1061 + 0.444 * tF);
        } else {
          W = (inH - 1.006 * t) / (2501 + 1.86 * t);
        }
      } else if (pair === 'rh+twb') {
        var rhV = Math.max(0,Math.min(100,inRh))/100;
        var twbC2 = tToSI(inTwb);
        // need t such that Psy.rhFromTWP(t, W(t,twbC2), pPa) = rhV
        t = solveBracket(function (tt) {
          var Ww = Psy.wFromTTwbP(tt, twbC2, pPa);
          return Psy.rhFromTWP(tt, Ww, pPa) - rhV;
        }, twbC2, 80);
        W = Psy.wFromTTwbP(t, twbC2, pPa);
      } else if (pair === 'rh+tdp') {
        var rhV2 = Math.max(0,Math.min(100,inRh))/100;
        var tdpC2 = tToSI(inTdp);
        W = Psy.wFromPw(Psy.pws(tdpC2), pPa);
        // pw = rh * pws(t)  =>  pws(t) = pw/rh
        var pwTarget = Psy.pws(tdpC2) / rhV2;
        t = Psy.tdpFromPw(pwTarget);
      } else if (pair === 'tdp+w') {
        var tdpC3 = tToSI(inTdp);
        W = Psy.wFromPw(Psy.pws(tdpC3), pPa);
        t = p.t; // keep existing dry bulb
      } else if (pair === 'tdp+twb') {
        var tdpC4 = tToSI(inTdp);
        var twbC4 = tToSI(inTwb);
        W = Psy.wFromPw(Psy.pws(tdpC4), pPa);
        // find t such that twb(t, W) = twbC4
        t = solveBracket(function (tt) { return Psy.twb(tt, W, pPa) - twbC4; }, twbC4, 80);
      } else {
        t = tToSI(inTdb);
        W = Psy.wFromTRhP(t, Math.max(0, Math.min(100, inRh))/100, pPa);
      }
    } catch (e) {
      // keep old
    }

    // Clamp
    if (!isFinite(t)) t = p.t;
    if (!isFinite(W) || W < 0) W = 0;
    var Wsat = Psy.wsFromTP(t, pPa);
    if (W > Wsat) W = Wsat;
    if (t < -40) t = -40;
    if (t > 100) t = 100;

    p.t = t; p.w = W;
    var hint = $('solver-hint');
    if (hint) {
      if (warn) { hint.textContent = '⚠ ' + warn; hint.classList.add('warn'); }
      else { hint.textContent = 'Edit any two of T_db, T_wb, T_dp, φ, W, h — the rest update automatically.'; hint.classList.remove('warn'); }
    }
    updateProperties();
    render();
    updateLearnPanel();
    updateLoads();
  }

  function solveBracket(f, mid, span) {
    var lo = mid - span, hi = mid + span;
    var fl = f(lo), fh = f(hi);
    if (fl * fh > 0) {
      // widen
      lo = -80; hi = 100;
      fl = f(lo); fh = f(hi);
      if (fl * fh > 0) return mid;
    }
    for (var i = 0; i < 80; i++) {
      var m = (lo + hi) / 2;
      var fm = f(m);
      if (fl * fm < 0) { hi = m; fh = fm; } else { lo = m; fl = fm; }
      if (hi - lo < 1e-5) return m;
    }
    return (lo + hi) / 2;
  }

  // ============================================================
  // POINTER INTERACTION ON CHART
  // ============================================================
  var dragging = false;
  var dragId = null;

  function setupPointerEvents() {
    canvas.addEventListener('pointerdown', function (e) {
      e.preventDefault();
      var rect = canvas.getBoundingClientRect();
      var px = e.clientX - rect.left, py = e.clientY - rect.top;
      // hit-test existing points
      for (var i = 0; i < state.points.length; i++) {
        var pt = state.points[i];
        var dx = tx(pt.t) - px, dy = wy(pt.w) - py;
        if (dx*dx + dy*dy < 144) {
          state.activeId = pt.id;
          dragging = true;
          dragId = pt.id;
          updatePointSelect();
          updateProperties();
          render();
          playClick();
          canvas.setPointerCapture(e.pointerId);
          return;
        }
      }
      // else: move active point to clicked location (if inside chart)
      if (px >= chartRect.x0 && px <= chartRect.x1 && py >= chartRect.y0 && py <= chartRect.y1) {
        var p = activePoint();
        if (p) {
          var t = xT(px); var W = yW(py);
          var Ws = Psy.wsFromTP(t, state.pPa);
          if (W > Ws) W = Ws;
          if (W < 0) W = 0;
          p.t = t; p.w = W;
          dragging = true; dragId = p.id;
          updateProperties();
          render();
          playClick();
          canvas.setPointerCapture(e.pointerId);
        }
      }
    });

    canvas.addEventListener('pointermove', function (e) {
      if (!dragging || dragId == null) return;
      var rect = canvas.getBoundingClientRect();
      var px = e.clientX - rect.left, py = e.clientY - rect.top;
      px = Math.max(chartRect.x0, Math.min(chartRect.x1, px));
      py = Math.max(chartRect.y0, Math.min(chartRect.y1, py));
      var p = state.points.find(function (q) { return q.id === dragId; });
      if (!p) return;
      var t = xT(px); var W = yW(py);
      var Ws = Psy.wsFromTP(t, state.pPa);
      if (W > Ws) W = Ws;
      if (W < 0) W = 0;
      p.t = t; p.w = W;
      updateProperties();
      updateLearnPanel();
      updateLoads();
      render();
    });

    canvas.addEventListener('pointerup', function () { dragging = false; dragId = null; });
    canvas.addEventListener('pointercancel', function () { dragging = false; dragId = null; });

    canvas.addEventListener('contextmenu', function (e) {
      e.preventDefault();
      var menu = $('ctx-menu');
      var rect = canvas.parentElement.getBoundingClientRect();
      menu.style.left = (e.clientX - rect.left) + 'px';
      menu.style.top = (e.clientY - rect.top) + 'px';
      menu.style.display = 'block';
    });
    document.addEventListener('click', function (e) {
      if (!e.target.closest('.ctx-menu')) $('ctx-menu').style.display = 'none';
    });
    $$('.ctx-item').forEach(function (b) {
      b.addEventListener('click', function () {
        var act = b.getAttribute('data-action');
        if (act === 'save-img') saveImage();
        else if (act === 'copy-data') copyData();
        else if (act === 'reset') resetPoints();
        $('ctx-menu').style.display = 'none';
      });
    });
  }

  function saveImage() {
    var tmp = document.createElement('canvas');
    tmp.width = canvas.width; tmp.height = canvas.height;
    var tc = tmp.getContext('2d');
    tc.drawImage(canvas, 0, 0);
    var fs = Math.round(tmp.width * 0.018);
    tc.font = '600 ' + fs + 'px "Segoe UI", system-ui, sans-serif';
    tc.textAlign = 'right'; tc.textBaseline = 'bottom';
    tc.fillStyle = 'rgba(255,255,255,0.25)';
    tc.fillText('mechsimulator.com', tmp.width - 14, tmp.height - 10);
    var a = document.createElement('a');
    a.href = tmp.toDataURL('image/png');
    a.download = 'psychrometric-chart.png';
    a.click();
  }

  function copyData() {
    var rows = ['Label,Tdb(°C),Twb(°C),Tdp(°C),RH(%),W(g/kg),h(kJ/kg),v(m³/kg)'];
    state.points.forEach(function (p) {
      var rh = Psy.rhFromTWP(p.t, p.w, state.pPa);
      var tdp = Psy.tdpFromPw(Psy.pwFromW(p.w, state.pPa));
      var twb = Psy.twb(p.t, p.w, state.pPa);
      var h = Psy.enthalpy(p.t, p.w);
      var v = Psy.specificVolume(p.t, p.w, state.pPa);
      rows.push([p.label, p.t.toFixed(2), twb.toFixed(2), tdp.toFixed(2), (rh*100).toFixed(1), (p.w*1000).toFixed(3), h.toFixed(2), v.toFixed(4)].join(','));
    });
    var text = rows.join('\n');
    if (navigator.clipboard) navigator.clipboard.writeText(text);
  }

  function resetPoints() {
    state.points = [];
    state.nextId = 1;
    state.points.push(makePoint(25, 0.50));
    state.activeId = state.points[0].id;
    updatePointSelect();
    updateProperties();
    render();
  }

  function addPoint() {
    if (state.points.length >= 5) return;
    var idx = state.points.length;
    var t = 25 + idx * 2;
    var pt = makePoint(t, 0.5);
    state.points.push(pt);
    state.activeId = pt.id;
    updatePointSelect();
    updateProperties();
    render();
    playClick();
  }

  // ============================================================
  // OVERLAYS & TOOLBAR
  // ============================================================

  function setupOverlayButtons() {
    $$('.chart-tool-btn[data-overlay]').forEach(function (b) {
      var key = b.getAttribute('data-overlay');
      if (state.overlays[key]) b.classList.add('active');
      b.addEventListener('click', function () {
        state.overlays[key] = !state.overlays[key];
        b.classList.toggle('active', state.overlays[key]);
        if (key === 'wb' || key === 'enth' || key === 'vol') invalidateGrid();
        syncLegend();
        render();
        playClick();
      });
    });
    $('btn-add-point').addEventListener('click', addPoint);
    $('btn-clear-points').addEventListener('click', resetPoints);
    syncLegend();
  }

  function syncLegend() {
    var lwb = $('lg-wb'), lh = $('lg-h'), lv = $('lg-v');
    if (lwb) lwb.classList.toggle('dim', !state.overlays.wb);
    if (lh)  lh.classList.toggle('dim',  !state.overlays.enth);
    if (lv)  lv.classList.toggle('dim',  !state.overlays.vol);
  }

  // ============================================================
  // PRESSURE / ALTITUDE
  // ============================================================
  function setupAltitudeControls() {
    var altSl = $('sl-alt'), pSl = $('sl-p');
    altSl.addEventListener('input', function () {
      state.altM = parseFloat(altSl.value);
      state.pPa = Psy.pFromAltitude(state.altM);
      invalidateGrid();
      updateAltitudeUI();
      // re-evaluate Wsat at points
      state.points.forEach(function (p) {
        var Ws = Psy.wsFromTP(p.t, state.pPa);
        if (p.w > Ws) p.w = Ws;
      });
      updateProperties();
      updateLearnPanel();
      render();
    });
    pSl.addEventListener('input', function () {
      state.pPa = parseFloat(pSl.value) * 1000;
      state.altM = Psy.altitudeFromP(state.pPa);
      invalidateGrid();
      updateAltitudeUI();
      state.points.forEach(function (p) {
        var Ws = Psy.wsFromTP(p.t, state.pPa);
        if (p.w > Ws) p.w = Ws;
      });
      updateProperties();
      updateLearnPanel();
      render();
    });

    // Steppers
    $$('.stepper-btn[data-target]').forEach(function (b) {
      b.addEventListener('click', function () {
        var target = $(b.getAttribute('data-target'));
        var step = parseFloat(b.getAttribute('data-step'));
        target.value = (parseFloat(target.value) || 0) + step;
        target.dispatchEvent(new Event('input', { bubbles: true }));
        playClick();
      });
    });

    $('sl-mflow').addEventListener('input', function () {
      state.mflow = parseFloat($('sl-mflow').value);
      updateMflowUI();
      updateLoads();
    });
  }

  // ============================================================
  // PROCESS PANEL
  // ============================================================

  function setupProcessTabs() {
    $$('.proc-tab').forEach(function (t) {
      t.addEventListener('click', function () {
        $$('.proc-tab').forEach(function (x) { x.classList.remove('active'); });
        t.classList.add('active');
        state.process = t.getAttribute('data-proc');
        renderProcPanel();
        render();
        updateLoads();
        playClick();
      });
    });
    renderProcPanel();
  }

  function renderProcPanel() {
    var pp = $('proc-panel');
    var html = '';
    var p = state.procParams;
    switch (state.process) {
      case 'none':
        html = '<p>Pick a process to see how the air state moves on the chart, and (with ṁ<sub>a</sub> set below) get the sensible / latent / total load.</p>';
        break;
      case 'sens-heat':
        html = '<p>Sensible heating &mdash; horizontal line, W constant.</p>'
             + procSlider('ΔT', 1, 40, 1, p.dt, function (v) { p.dt = v; }, '°C');
        break;
      case 'sens-cool':
        html = '<p>Sensible cooling above the dew point &mdash; horizontal line.</p>'
             + procSlider('ΔT', 1, 25, 1, p.dt, function (v) { p.dt = v; }, '°C');
        break;
      case 'humid-steam':
        html = '<p>Steam humidification &mdash; near-vertical (constant T<sub>db</sub>).</p>'
             + procSlider('ΔW', 0.001, 0.015, 0.0005, p.dW, function (v) { p.dW = v; }, 'kg/kg');
        break;
      case 'humid-evap':
        html = '<p>Adiabatic / evaporative humidification &mdash; along constant T<sub>wb</sub>.</p>'
             + procSlider('ΔT', 1, 20, 1, p.dt, function (v) { p.dt = v; }, '°C');
        break;
      case 'dehum':
        html = '<p>Cooling + dehumidification &mdash; line toward apparatus dew point at the coil.</p>'
             + procSlider('Target T', 5, 18, 1, p.target, function (v) { p.target = v; }, '°C');
        break;
      case 'mix':
        if (state.points.length < 2) {
          html = '<p>Add a second point (Point B) to mix two airstreams.</p>';
        } else {
          html = '<p>Mass-weighted mix of Point A and Point B. Set ṁ<sub>B</sub> fraction below; ṁ<sub>A</sub> = 1 &minus; this.</p>'
               + procSlider('Mix fraction ṁ<sub>B</sub>/(ṁ<sub>A</sub>+ṁ<sub>B</sub>)', 0, 1, 0.05, p.ratio, function (v) { p.ratio = v; }, '');
        }
        break;
    }
    pp.innerHTML = html;
    // Wire sliders
    $$('input.proc-slider', pp).forEach(function (sl) {
      sl.addEventListener('input', function () {
        var setter = sl._setter;
        setter(parseFloat(sl.value));
        sl.nextElementSibling.textContent = sl.value;
        render();
        updateLoads();
      });
    });
  }

  function procSlider(label, min, max, step, val, setter, unit) {
    var sliderId = 'ps-' + label.replace(/[^a-z0-9]/gi, '');
    var html = '<div class="slider-row" style="margin-top:10px"><span class="sim-slider-label">' + label + '</span>'
             + '<input class="sim-slider proc-slider" id="' + sliderId + '" type="range" min="' + min + '" max="' + max + '" step="' + step + '" value="' + val + '">'
             + '<span class="stepper-val" style="min-width:60px">' + val + '</span>'
             + '<span class="stepper-unit">' + unit + '</span></div>';
    setTimeout(function () { var el = document.getElementById(sliderId); if (el) el._setter = setter; }, 0);
    return html;
  }

  function updateLoads() {
    var lr = $('load-readout');
    if (!lr) return;
    if (state.process === 'none') {
      lr.innerHTML = '<span style="color:var(--text-dim)">Select a process to see loads.</span>';
      return;
    }
    var a = state.points[0];
    if (!a) { lr.innerHTML = ''; return; }
    var p = state.procParams;
    var endT = a.t, endW = a.w;
    if (state.process === 'sens-heat') { endT = a.t + Math.abs(p.dt); endW = a.w; }
    else if (state.process === 'sens-cool') { endT = a.t - Math.abs(p.dt); endW = a.w; }
    else if (state.process === 'humid-steam') { endT = a.t; endW = Math.min(a.w + Math.abs(p.dW), Psy.wsFromTP(a.t, state.pPa)); }
    else if (state.process === 'humid-evap') {
      var twb_a = Psy.twb(a.t, a.w, state.pPa);
      endT = a.t - Math.abs(p.dt); if (endT < twb_a) endT = twb_a;
      endW = Psy.wFromTTwbP(endT, twb_a, state.pPa);
    } else if (state.process === 'dehum') {
      endT = p.target;
      endW = Math.min(a.w, Psy.wFromTRhP(endT, 0.95, state.pPa));
    } else if (state.process === 'mix' && state.points.length >= 2) {
      var b = state.points[1];
      endT = a.t * (1 - p.ratio) + b.t * p.ratio;
      endW = a.w * (1 - p.ratio) + b.w * p.ratio;
    }
    var h1 = Psy.enthalpy(a.t, a.w);
    var h2 = Psy.enthalpy(endT, endW);
    var dh = h2 - h1;                              // kJ/kg da
    var dW = endW - a.w;                           // kg/kg
    var qTotal = state.mflow * dh;                 // kW
    var qLatent = state.mflow * dW * 2501;         // kW (approx, hfg ≈ 2501)
    var qSensible = qTotal - qLatent;
    var shr = qTotal !== 0 ? qSensible / qTotal : 0;
    var tonsTotal = qTotal * 0.2843;               // kW → tons of refrigeration
    var labelDir = (qTotal >= 0 ? 'Energy added' : 'Energy removed');

    lr.innerHTML = ''
      + '<div class="lr-row"><span>Δh</span><strong>' + dh.toFixed(2) + ' kJ/kg</strong></div>'
      + '<div class="lr-row"><span>ΔW</span><strong>' + (dW*1000).toFixed(3) + ' g/kg</strong></div>'
      + '<div class="lr-row"><span>q<sub>sensible</sub></span><strong>' + qSensible.toFixed(2) + ' kW</strong></div>'
      + '<div class="lr-row"><span>q<sub>latent</sub></span><strong>' + qLatent.toFixed(2) + ' kW</strong></div>'
      + '<div class="lr-row"><span>q<sub>total</sub></span><strong>' + qTotal.toFixed(2) + ' kW (' + Math.abs(tonsTotal).toFixed(2) + ' TR)</strong></div>'
      + '<div class="lr-row"><span>SHR</span><strong>' + shr.toFixed(3) + '</strong></div>'
      + '<div class="lr-row" style="color:var(--text-dim);font-size:0.7rem;margin-top:4px">' + labelDir + ' at ṁ<sub>a</sub> = ' + state.mflow.toFixed(2) + ' kg/s</div>';
  }

  // ============================================================
  // LEARN PANEL (KaTeX)
  // ============================================================
  var _learnCache = { eq: '' };

  function updateLearnPanel() {
    var p = activePoint();
    if (!p) return;
    var t = p.t, W = p.w, pPa = state.pPa;
    var pwsV = Psy.pws(t);
    var pwV = Psy.pwFromW(W, pPa);
    var rhV = Psy.rhFromTWP(t, W, pPa);
    var hV = Psy.enthalpy(t, W);
    var twbV = Psy.twb(t, W, pPa);
    var phaseNote = t < 0 ? '(over ice, ASHRAE Eq. 5)' : '(over water, ASHRAE Eq. 6)';

    var html = ''
      + '<p><strong>Active state:</strong> T<sub>db</sub> = ' + t.toFixed(2) + ' °C, W = ' + (W*1000).toFixed(3) + ' g/kg, p = ' + (pPa/1000).toFixed(2) + ' kPa.</p>'
      + '<div class="eq-block">'
      +   '<p>Saturation pressure (Hyland-Wexler, ' + phaseNote + '):</p>'
      +   '\\[ p_{ws}(' + t.toFixed(1) + '\\,°C) = ' + pwsV.toFixed(2) + '\\ \\text{Pa} \\]'
      + '</div>'
      + '<div class="eq-block">'
      +   '<p>Humidity ratio (ASHRAE Eq. 20):</p>'
      +   '\\[ W = 0.621945 \\cdot \\frac{p_w}{p - p_w} = ' + (W*1000).toFixed(3) + '\\ \\text{g/kg} \\]'
      +   '<p style="font-size:0.78rem;color:var(--text-dim)">p<sub>w</sub> = ' + pwV.toFixed(2) + ' Pa, p − p<sub>w</sub> = ' + (pPa - pwV).toFixed(2) + ' Pa</p>'
      + '</div>'
      + '<div class="eq-block">'
      +   '<p>Relative humidity:</p>'
      +   '\\[ \\varphi = \\frac{p_w}{p_{ws}} = ' + (rhV*100).toFixed(2) + '\\% \\]'
      + '</div>'
      + '<div class="eq-block">'
      +   '<p>Specific enthalpy (ASHRAE Eq. 32, SI):</p>'
      +   '\\[ h = 1.006\\,t + W(2501 + 1.86\\,t) = ' + hV.toFixed(2) + '\\ \\text{kJ/kg dry air} \\]'
      + '</div>'
      + '<div class="eq-block">'
      +   '<p>Thermodynamic wet-bulb (ASHRAE Eq. ' + (t<0?'37':'35') + ', ' + (t<0?'sublimation':'vaporization') + ' branch):</p>'
      +   '\\[ t^* = ' + twbV.toFixed(2) + '\\ °C \\quad (\\text{solved iteratively})\\]'
      + '</div>';

    if (html !== _learnCache.eq) {
      $('lp-eq-body').innerHTML = html;
      _learnCache.eq = html;
    }
  }

  function updateCalcModal() {
    var p = activePoint();
    if (!p) return;
    var t = p.t, W = p.w, pPa = state.pPa;
    var pwsV = Psy.pws(t);
    var pwV = Psy.pwFromW(W, pPa);
    var rhV = Psy.rhFromTWP(t, W, pPa);
    var hV = Psy.enthalpy(t, W);
    var twbV = Psy.twb(t, W, pPa);
    var tdpV = Psy.tdpFromPw(pwV);
    var vV = Psy.specificVolume(t, W, pPa);
    var rhoV = Psy.density(t, W, pPa);
    var phaseSign = t < 0 ? 'ice' : 'water';

    var html = ''
      + '<div class="calc-step">'
      +   '<div class="calc-step-title">1. Inputs</div>'
      +   '<p>T<sub>db</sub> = ' + t.toFixed(3) + ' °C, W = ' + (W*1000).toFixed(4) + ' g/kg, p = ' + (pPa/1000).toFixed(3) + ' kPa</p>'
      + '</div>'
      + '<div class="calc-step">'
      +   '<div class="calc-step-title">2. Saturation pressure (Hyland-Wexler over ' + phaseSign + ')</div>'
      +   '\\[ p_{ws} = \\exp\\!\\left(\\sum_i C_i \\cdot f_i(T)\\right) = ' + pwsV.toFixed(3) + '\\ \\text{Pa} \\]'
      + '</div>'
      + '<div class="calc-step">'
      +   '<div class="calc-step-title">3. Vapor partial pressure from W</div>'
      +   '\\[ p_w = \\frac{p\\,W}{0.621945 + W} = ' + pwV.toFixed(3) + '\\ \\text{Pa} \\]'
      + '</div>'
      + '<div class="calc-step">'
      +   '<div class="calc-step-title">4. Relative humidity</div>'
      +   '\\[ \\varphi = \\frac{p_w}{p_{ws}} = ' + (rhV*100).toFixed(3) + '\\% \\]'
      + '</div>'
      + '<div class="calc-step">'
      +   '<div class="calc-step-title">5. Dew point — invert pws(t) = pw</div>'
      +   '\\[ T_{dp} = ' + tdpV.toFixed(3) + '\\ °C \\]'
      + '</div>'
      + '<div class="calc-step">'
      +   '<div class="calc-step-title">6. Enthalpy</div>'
      +   '\\[ h = 1.006(' + t.toFixed(2) + ') + ' + W.toFixed(4) + '\\cdot(2501 + 1.86 \\cdot ' + t.toFixed(2) + ') = ' + hV.toFixed(3) + '\\ \\text{kJ/kg da} \\]'
      + '</div>'
      + '<div class="calc-step">'
      +   '<div class="calc-step-title">7. Specific volume</div>'
      +   '\\[ v = \\frac{R_{da}\\,T(1 + 1.6078\\,W)}{p} = ' + vV.toFixed(5) + '\\ \\text{m}^3/\\text{kg da} \\]'
      + '</div>'
      + '<div class="calc-step">'
      +   '<div class="calc-step-title">8. Moist-air density</div>'
      +   '\\[ \\rho = (1+W)/v = ' + rhoV.toFixed(4) + '\\ \\text{kg/m}^3 \\]'
      + '</div>'
      + '<div class="calc-step">'
      +   '<div class="calc-step-title">9. Wet-bulb (iterative)</div>'
      +   '<p>Solve W = [W<sub>s</sub>(t*)(' + (t<0?'2830':'2501') + ' − ' + (t<0?'0.24':'2.326') + '·t*) − (t − t*)] / [' + (t<0?'2830':'2501') + ' + 1.86·t − ' + (t<0?'2.1':'4.186') + '·t*]</p>'
      +   '\\[ t^* = ' + twbV.toFixed(3) + '\\ °C \\]'
      + '</div>';

    $('calc-modal-body').innerHTML = html;
  }

  // ============================================================
  // EXPLORE MODE
  // ============================================================
  var EXPLORE = {
    basics: [
      { title: 'The seven properties', body: 'Dry-bulb T<sub>db</sub>, wet-bulb T<sub>wb</sub>, dew point T<sub>dp</sub>, relative humidity φ, humidity ratio W, enthalpy h, and specific volume v. Any two intensive properties + barometric pressure fix the state completely (Gibbs phase rule).', note: 'Density is just (1+W)/v — same information as v.' },
      { title: 'Chart anatomy', body: 'X-axis: dry-bulb temperature. Y-axis: humidity ratio W (mass of vapor per mass of dry air). Curves of constant RH bow upward; constant wet-bulb and enthalpy lines slope down-and-right; constant specific volume lines slope down-and-right more steeply.', note: 'On the saturation curve (RH = 100%), T<sub>db</sub> = T<sub>wb</sub> = T<sub>dp</sub>.' },
      { title: 'Why W, not RH?', body: 'Humidity ratio W is an absolute mass quantity — it does not change with sensible heating or cooling of the same air. Relative humidity changes if you heat the room without adding water. That is why HVAC sizing uses W, not RH.', note: 'Heating: W constant, RH falls. Cooling above dew point: W constant, RH rises. Cooling below dew point: W drops too — condensation begins.' },
      { title: 'Wet-bulb vs dew point', body: 'Wet-bulb is what a wetted thermometer reads in moving air — a thermodynamic property that depends on both moisture and temperature. Dew point is purely the temperature where condensation starts — depends only on absolute moisture content. They are equal only at saturation.', note: 'A common student error is confusing the two — always check which curve you are following.' }
    ],
    formulas: [
      { title: 'Saturation pressure (ASHRAE Hyland-Wexler)', body: 'Two forms, split at 0 °C. Over liquid water (0..200 °C): ln(p<sub>ws</sub>) = C8/T + C9 + C10·T + C11·T² + C12·T³ + C13·ln(T). Over ice (−100..0 °C): a seven-constant form including 1/T². The split correctly captures the latent-heat difference between vaporization and sublimation.', formula: 'ln(pws) = C8/T + C9 + C10·T + C11·T² + C12·T³ + C13·ln(T)', note: 'T is absolute (Kelvin). pws in Pa.' },
      { title: 'Humidity ratio', body: 'W is the ratio of water-vapor mass to dry-air mass. The constant 0.621945 = M<sub>water</sub>/M<sub>dry air</sub>. Older texts round to 0.622 — same physics, less precision.', formula: 'W = 0.621945·pw / (p − pw)', note: 'p<sub>w</sub> = φ · p<sub>ws</sub>(T) — partial pressure of vapor.' },
      { title: 'Specific enthalpy (ASHRAE Ch.1)', body: 'Per unit mass of dry air. The 1.006 kJ/kg·K is dry-air c<sub>p</sub>; 2501 kJ/kg is hfg at 0 °C; 1.86 kJ/kg·K is vapor c<sub>p</sub>.', formula: 'h = 1.006·t + W·(2501 + 1.86·t)  [kJ/kg da, t in °C]', note: 'IP form: h = 0.240·t + W·(1061 + 0.444·t) Btu/lb, t in °F.' },
      { title: 'Thermodynamic wet-bulb (iterative)', body: 'Adiabatic saturation balance. Above 0 °C uses 2501 (vaporization) and c<sub>p,water</sub> = 4.186; below 0 °C uses 2830 (sublimation = 2501 + 334) and c<sub>p,ice</sub> = 2.1. Solve for t* by Newton or bisection.', formula: 'W = [Ws(t*)·(2501 − 2.326·t*) − (t − t*)] / (2501 + 1.86·t − 4.186·t*)', note: 'Equality W and t* are coupled — no closed form. This tool uses bisection to ~10⁻⁵ °C.' },
      { title: 'Specific volume', body: 'Per unit mass of dry air (the moist-air convention in HVAC). R<sub>da</sub> = 287.042 J/kg·K is the dry-air gas constant. The (1 + 1.6078·W) factor accounts for vapor in the mixture.', formula: 'v = R_da · T · (1 + 1.6078·W) / p   [m³/kg da]', note: 'Moist-air density: ρ = (1 + W)/v.' }
    ],
    applications: [
