  // ─── STEPPER TEXT INPUT (D7) ───────────────────────────────
  function setupStepperTextInput() {
    $$('.stepper-val').forEach(function (val) {
      val.title = 'Click to type exact value';
      val.addEventListener('click', function () {
        // find sibling input slider
        var stepper = val.parentElement;
        var btnMinus = stepper.querySelector('.stepper-btn');
        var targetSliderId = btnMinus && btnMinus.getAttribute('data-target');
        if (!targetSliderId) return;
        var slider = $(targetSliderId);
        if (!slider) return;
        var input = document.createElement('input');
        input.className = 'stepper-input';
        input.type = 'number';
        input.value = parseFloat(slider.value).toString();
        input.step = slider.step;
        input.min = slider.min; input.max = slider.max;
        val.style.display = 'none';
        val.insertAdjacentElement('afterend', input);
        input.focus();
        input.select();
        var commit = function () {
          var v = parseFloat(input.value);
          if (isFinite(v)) {
            v = Math.max(parseFloat(slider.min), Math.min(parseFloat(slider.max), v));
            slider.value = v;
            slider.dispatchEvent(new Event('input', { bubbles: true }));
          }
          input.remove();
          val.style.display = '';
        };
        input.addEventListener('blur', commit);
        input.addEventListener('keydown', function (e) {
          if (e.key === 'Enter') input.blur();
          else if (e.key === 'Escape') { input.value = parseFloat(slider.value); input.blur(); }
        });
      });
    });
  }

  // ─── CURSOR FEEDBACK (A11) ─────────────────────────────────
  function setupCursorFeedback() {
    canvas.addEventListener('pointermove', function (e) {
      if (dragging) {
        canvas.classList.add('dragging');
        canvas.classList.remove('over-point');
        return;
      }
      canvas.classList.remove('dragging');
      var rect = canvas.getBoundingClientRect();
      var px = e.clientX - rect.left, py = e.clientY - rect.top;
      var over = false;
      for (var i = 0; i < state.points.length; i++) {
        var pt = state.points[i];
        var dx = tx(pt.t) - px, dy = wy(pt.w) - py;
        if (dx*dx + dy*dy < 144) { over = true; break; }
      }
      canvas.classList.toggle('over-point', over);
    });
    canvas.addEventListener('pointerup', function () { canvas.classList.remove('dragging'); });
    canvas.addEventListener('pointercancel', function () { canvas.classList.remove('dragging'); });
  }

