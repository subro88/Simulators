  // ─── UNDO / REDO ───────────────────────────────────────────
  var history = { stack: [], idx: -1, max: 50 };

  function snapshot() {
    return JSON.stringify({
      points: state.points.map(function (p) { return { id: p.id, label: p.label, t: p.t, w: p.w, color: p.color }; }),
      activeId: state.activeId,
      pPa: state.pPa,
      altM: state.altM,
      process: state.process,
      procParams: Object.assign({}, state.procParams),
      mflow: state.mflow,
      overlays: Object.assign({}, state.overlays),
      nextId: state.nextId
    });
  }

  function pushHistory() {
    var snap = snapshot();
    // drop redo branch
    history.stack = history.stack.slice(0, history.idx + 1);
    if (history.stack.length && history.stack[history.stack.length - 1] === snap) return;
    history.stack.push(snap);
    if (history.stack.length > history.max) history.stack.shift();
    history.idx = history.stack.length - 1;
    updateUndoUI();
  }

  function restoreSnapshot(json) {
    try {
      var s = JSON.parse(json);
      state.points = s.points.map(function (p) { return { id: p.id, label: p.label, t: p.t, w: p.w, color: p.color }; });
      state.activeId = s.activeId;
      state.pPa = s.pPa;
      state.altM = s.altM;
      state.process = s.process;
      state.procParams = s.procParams;
      state.mflow = s.mflow;
      state.overlays = s.overlays;
      state.nextId = s.nextId;
      invalidateGrid();
      updateAltitudeUI();
      updateMflowUI();
      updatePointSelect();
      updateProperties();
      updateLearnPanel();
      updateLoads();
      renderProcPanel();
      // sync overlay buttons
      $$('.chart-tool-btn[data-overlay]').forEach(function (b) {
        var k = b.getAttribute('data-overlay');
        b.classList.toggle('active', !!state.overlays[k]);
      });
      // sync process tabs
      $$('.proc-tab').forEach(function (b) {
        b.classList.toggle('active', b.getAttribute('data-proc') === state.process);
      });
      render();
    } catch (e) { /* ignore */ }
  }

  function undo() {
    if (history.idx <= 0) return;
    history.idx--;
    restoreSnapshot(history.stack[history.idx]);
    updateUndoUI();
    playClick();
  }
  function redo() {
    if (history.idx >= history.stack.length - 1) return;
    history.idx++;
    restoreSnapshot(history.stack[history.idx]);
    updateUndoUI();
    playClick();
  }

  function updateUndoUI() {
    var u = $('btn-undo'), r = $('btn-redo');
    if (u) u.disabled = history.idx <= 0;
    if (r) r.disabled = history.idx >= history.stack.length - 1;
  }

  function setupUndoRedo() {
    $('btn-undo').addEventListener('click', undo);
    $('btn-redo').addEventListener('click', redo);
    document.addEventListener('keydown', function (e) {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'z') {
        e.preventDefault();
        if (e.shiftKey) redo(); else undo();
      }
    });
  }

  // ─── URL STATE SHARING ─────────────────────────────────────
  function saveStateToURL() {
    try {
      var payload = {
        v: 1,
        u: state.unit,
        a: Math.round(state.altM),
        pts: state.points.map(function (p) { return { l: p.label, t: +p.t.toFixed(3), w: +p.w.toFixed(6) }; }),
        pr: state.process
      };
      var b64 = btoa(JSON.stringify(payload));
      if (history.replaceState) {
        window.history.replaceState(null, '', '#s=' + b64);
      } else {
        window.location.hash = 's=' + b64;
      }
    } catch (e) { /* ignore */ }
  }

  function loadStateFromURL() {
    var hash = window.location.hash;
    if (!hash || hash.indexOf('s=') < 0) return false;
    try {
      var b64 = hash.split('s=')[1];
      var p = JSON.parse(atob(b64));
      if (!p || !p.pts || !p.pts.length) return false;
      state.unit = p.u || 'si';
      state.altM = p.a || 0;
      state.pPa = Psy.pFromAltitude(state.altM);
      state.points = p.pts.map(function (pt, i) {
        return { id: i + 1, label: pt.l || POINT_LABELS[i], t: pt.t, w: pt.w, color: POINT_COLORS[i] || '#14b8a6' };
      });
      state.nextId = state.points.length + 1;
      state.activeId = state.points[0].id;
      state.process = p.pr || 'none';
      $$('.unit-btn').forEach(function (b) {
        b.classList.toggle('active', b.getAttribute('data-unit') === state.unit);
      });
      return true;
    } catch (e) { return false; }
  }

