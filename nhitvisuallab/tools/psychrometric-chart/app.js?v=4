  function createCustomPoint() {
    if (state.points.length >= 5) {
      var err = $('cp-error'); err.textContent = 'Maximum 5 points. Remove a point first.'; err.style.display = 'block'; return;
    }
    var label = ($('cp-label').value || '').trim() || POINT_LABELS[state.points.length] || ('P' + (state.points.length + 1));
    if (label.length > 6) label = label.slice(0, 6);
    var pair = $('cp-pair').value;
    var v1 = parseFloat($('cp-v1').value);
    var v2 = parseFloat($('cp-v2').value);
    var t, W, pPa = state.pPa;
    try {
      var t1 = tToSI(v1);
      if (pair === 'tdb_rh')   { t = t1; W = Psy.wFromTRhP(t, Math.max(0,Math.min(100,v2))/100, pPa); }
      else if (pair === 'tdb_twb') { t = t1; var twb2 = tToSI(v2); W = Psy.wFromTTwbP(t, twb2, pPa); }
      else if (pair === 'tdb_tdp') { t = t1; var tdp2 = tToSI(v2); W = Psy.wFromPw(Psy.pws(tdp2), pPa); }
      else if (pair === 'tdb_w')   { t = t1; W = wToSI(v2); }
      else if (pair === 'tdb_h')   {
        t = t1;
        if (isIP()) { var tF = v1; W = (v2 - 0.240 * tF) / (1061 + 0.444 * tF); }
        else        { W = (v2 - 1.006 * t) / (2501 + 1.86 * t); }
      }
      if (!isFinite(t) || !isFinite(W) || W < 0) throw new Error('Invalid');
      var Ws = Psy.wsFromTP(t, pPa);
      if (W > Ws * 1.01) throw new Error('Above saturation — RH > 100%');
      if (W > Ws) W = Ws;
    } catch (e) {
      var err2 = $('cp-error'); err2.textContent = 'Could not solve: ' + (e.message || e); err2.style.display = 'block'; return;
    }
    var idx = state.points.length;
    state.points.push({
      id: state.nextId++,
      label: label,
      t: t, w: W,
      color: POINT_COLORS[idx] || '#14b8a6'
    });
    state.activeId = state.points[state.points.length - 1].id;
    updatePointSelect();
    updateProperties();
    updateLearnPanel();
    render();
    pushHistory();
    saveStateToURL();
    $('cp-modal').style.display = 'none';
    playSuccess();
  }

