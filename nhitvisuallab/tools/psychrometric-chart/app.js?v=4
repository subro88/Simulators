  function updateCustomPointUnits() {
    var pair = $('cp-pair').value;
    var u1 = $('cp-u1'), u2 = $('cp-u2');
    if (pair === 'tdb_rh')   { u1.textContent = uT(); u2.textContent = '%'; $('cp-v2').value = 50; }
    else if (pair === 'tdb_twb') { u1.textContent = uT(); u2.textContent = uT(); $('cp-v2').value = 18; }
    else if (pair === 'tdb_tdp') { u1.textContent = uT(); u2.textContent = uT(); $('cp-v2').value = 14; }
    else if (pair === 'tdb_w')   { u1.textContent = uT(); u2.textContent = uW(); $('cp-v2').value = isIP() ? 60 : 10; }
    else if (pair === 'tdb_h')   { u1.textContent = uT(); u2.textContent = uH(); $('cp-v2').value = isIP() ? 25 : 50; }
