  // ─── M1 — COOLING COIL SIZING WIZARD ───────────────────────
  function coilCalc() {
    var pPa = state.pPa;
    var oaT = parseFloat($('coil-oa-t').value), oaRh = parseFloat($('coil-oa-rh').value)/100, oaMf = parseFloat($('coil-oa-mf').value);
    var raT = parseFloat($('coil-ra-t').value), raRh = parseFloat($('coil-ra-rh').value)/100, raMf = parseFloat($('coil-ra-mf').value);
    var qs = parseFloat($('coil-qs').value), ql = parseFloat($('coil-ql').value);
    var bf = parseFloat($('coil-bf').value);
    var rmT = parseFloat($('coil-rm-t').value), rmRh = parseFloat($('coil-rm-rh').value)/100;

    var oaW = Psy.wFromTRhP(oaT, oaRh, pPa);
    var raW = Psy.wFromTRhP(raT, raRh, pPa);
    var rmW = Psy.wFromTRhP(rmT, rmRh, pPa);
    var mfTot = oaMf + raMf;
    // Mixed point M
    var mT = (oaMf * oaT + raMf * raT) / mfTot;
    var mW = (oaMf * oaW + raMf * raW) / mfTot;
    var mH = Psy.enthalpy(mT, mW);

    // RSHF = qs / (qs+ql)
    var qtot = qs + ql;
    var rshf = qs / qtot;

    // Required supply: ΔT_supply and ΔW_supply for given ṁ
    // q_s = ṁ · c_p · (T_rm - T_sup), with c_p ≈ 1.012 kJ/kg·K for moist air
    var cp = 1.012;
    var hfg = 2501;
    var dTsup = qs / (mfTot * cp);
    var dWsup = ql / (mfTot * hfg);
    var supT = rmT - dTsup;
    var supW = rmW - dWsup;
    if (supW < 0) supW = 0;
    var supH = Psy.enthalpy(supT, supW);

    // ADP: project line through mixed→supply down to saturation curve
    // Param line: state = M + s·(Supply − M), find s_adp where W = Ws(T) intersect
    var adpT = -50, adpW = 0;
    for (var s = 1; s <= 8; s += 0.02) {
      var Tt = mT + s * (supT - mT);
      var Ww = mW + s * (supW - mW);
      var Wsat = Psy.wsFromTP(Tt, pPa);
      if (Ww >= Wsat) { adpT = Tt; adpW = Wsat; break; }
    }

    // Bypass factor & coil load
    var coilQ = mfTot * (mH - supH);
    var coilQsens = mfTot * cp * (mT - supT);
    var coilQlat = coilQ - coilQsens;
    var tons = coilQ * 0.2843;

    var html = ''
      + '<div class="rs-section">▸ Mixed (M) state</div>'
      + row('T_M', mT.toFixed(2) + ' °C')
      + row('W_M', (mW * 1000).toFixed(3) + ' g/kg')
      + row('h_M', mH.toFixed(2) + ' kJ/kg')
      + '<div class="rs-section">▸ Supply state required</div>'
      + row('T_supply', supT.toFixed(2) + ' °C')
      + row('W_supply', (supW * 1000).toFixed(3) + ' g/kg')
      + '<div class="rs-section">▸ Heat ratios</div>'
      + row('RSHF', rshf.toFixed(3))
      + row('Coil BF', bf.toFixed(3) + '  (Contact F = ' + (1 - bf).toFixed(3) + ')')
      + '<div class="rs-section">▸ Apparatus Dew Point (ADP)</div>'
      + row('T_ADP', adpT.toFixed(2) + ' °C')
      + row('W_ADP', (adpW * 1000).toFixed(3) + ' g/kg')
      + '<div class="rs-section">▸ Coil duty</div>'
      + row('q_sensible', coilQsens.toFixed(2) + ' kW')
      + row('q_latent',   coilQlat.toFixed(2)  + ' kW')
      + row('q_total',    coilQ.toFixed(2) + ' kW  (' + tons.toFixed(2) + ' TR)')
      + row('Air flow ṁ_a', mfTot.toFixed(2) + ' kg/s');
    $('coil-results').innerHTML = html;

    // Plot M, Coil-Out (supply), ADP on the main chart by adding/replacing points
    state.points = [
      { id: 1, label: 'OA', t: oaT, w: oaW, color: '#f5c842' },
      { id: 2, label: 'RA', t: raT, w: raW, color: '#9c8cff' },
      { id: 3, label: 'M',  t: mT,  w: mW,  color: '#19c4d4' },
      { id: 4, label: 'S',  t: supT, w: supW, color: '#3ddc84' },
      { id: 5, label: 'ADP', t: adpT, w: adpW, color: '#ff8b6b' }
    ];
    state.nextId = 6;
    state.activeId = 4;
    updatePointSelect();
    updateProperties();
    updateLearnPanel();
    render();
    pushHistory();
    playSuccess();
  }
  function row(k, v) { return '<div class="rs-row"><span>' + k + '</span><strong>' + v + '</strong></div>'; }

  // ─── M2 — COOLING TOWER ────────────────────────────────────
  function towerCalc() {
    var tin = parseFloat($('tw-tin').value), tout = parseFloat($('tw-tout').value);
    var wb = parseFloat($('tw-wb').value);
    var mw = parseFloat($('tw-mw').value); // L/s ≈ kg/s for water
    var coc = parseFloat($('tw-coc').value);
    var range = tin - tout;
    var approach = tout - wb;
    var cpW = 4.186;
    var Q = mw * cpW * range;             // kW
    // Evap ≈ 0.85 % per 1°C range — rule of thumb (range*1.8 → 1% per °F)
    var evapPct = 0.00136 * range * 100;  // ≈ 1% per ~7.4°C
    var evapRate = mw * evapPct / 100;     // L/s
    var blowdown = evapRate / (coc - 1);
    var drift = mw * 0.0005;               // 0.05 % typical mech draft
    var makeup = evapRate + blowdown + drift;

    var html = ''
      + '<div class="rs-section">▸ Performance</div>'
      + row('Range (T_in − T_out)', range.toFixed(2) + ' °C')
      + row('Approach (T_out − T_wb)', approach.toFixed(2) + ' °C')
      + row('Heat rejected', Q.toFixed(1) + ' kW')
      + '<div class="rs-section">▸ Water balance</div>'
      + row('Evaporation', evapRate.toFixed(3) + ' L/s  (' + evapPct.toFixed(2) + '% of flow)')
      + row('Blowdown', blowdown.toFixed(3) + ' L/s (at COC = ' + coc.toFixed(1) + ')')
      + row('Drift', drift.toFixed(3) + ' L/s')
      + row('Make-up total', makeup.toFixed(3) + ' L/s');
    if (approach < 2) html += '<div class="rs-section" style="color:var(--gold)">⚠ Approach &lt; 2 °C — very expensive tower; check WB design value.</div>';
    if (approach < 0) html += '<div class="rs-section" style="color:var(--red)">⚠ Approach negative — impossible: T_out cannot be below WB.</div>';
    $('tower-results').innerHTML = html;
    playSuccess();
  }

  // ─── M3 — EVAP COOLING DESIGNER ────────────────────────────
  function evapCalc() {
    var type = $('ev-type').value;
    var t = parseFloat($('ev-t').value), rh = parseFloat($('ev-rh').value) / 100;
    var epsD = parseFloat($('ev-eps-d').value), epsI = parseFloat($('ev-eps-i').value);
    var mf = parseFloat($('ev-mf').value);
    var pPa = state.pPa;
    var W1 = Psy.wFromTRhP(t, rh, pPa);
    var twb1 = Psy.twb(t, W1, pPa);
    var t2, W2, twb2;

    if (type === 'direct') {
      t2 = t - epsD * (t - twb1);
      twb2 = twb1;
      W2 = Psy.wFromTTwbP(t2, twb2, pPa);
    } else if (type === 'indirect') {
      // Indirect: sensible cooling against secondary stream at wb1
      t2 = t - epsI * (t - twb1);
      W2 = W1;
      twb2 = Psy.twb(t2, W2, pPa);
    } else {
      // Two-stage: IEC first (sensible), then DEC (constant wb of new state)
      var tA = t - epsI * (t - twb1);
      var WA = W1;
      var twbA = Psy.twb(tA, WA, pPa);
      t2 = tA - epsD * (tA - twbA);
      W2 = Psy.wFromTTwbP(t2, twbA, pPa);
      twb2 = twbA;
    }
    var h1 = Psy.enthalpy(t, W1);
    var h2 = Psy.enthalpy(t2, W2);
    var q = mf * (h1 - h2);
    var dryCool = mf * 1.012 * (t - t2);

    var html = ''
      + '<div class="rs-section">▸ Outdoor (1)</div>'
      + row('T_db / T_wb', t.toFixed(1) + ' / ' + twb1.toFixed(1) + ' °C')
      + row('W', (W1*1000).toFixed(3) + ' g/kg')
      + '<div class="rs-section">▸ Supply (2)</div>'
      + row('T_db', t2.toFixed(2) + ' °C')
      + row('T_wb', twb2.toFixed(2) + ' °C')
      + row('W', (W2*1000).toFixed(3) + ' g/kg')
      + row('ΔT achieved', (t-t2).toFixed(2) + ' °C')
      + '<div class="rs-section">▸ Cooling</div>'
      + row('Total cooling', q.toFixed(2) + ' kW')
      + row('Sensible part',  dryCool.toFixed(2) + ' kW')
      + row('Latent gain (humidification)', (q - dryCool).toFixed(2) + ' kW');
    if ((t - twb1) < 5) html += '<div class="rs-section" style="color:var(--gold)">Wet-bulb depression only ' + (t-twb1).toFixed(1) + ' °C — humid climate; evap cooling has limited effect.</div>';
    $('evap-results').innerHTML = html;
    playSuccess();
  }

  // ─── M6 — 24-h TIMELINE ────────────────────────────────────
  var tlCanvas, tlCtx;
  function sizeTimelineCanvas() {
    tlCanvas = $('timeline-canvas');
    if (!tlCanvas) return;
    var dpr = window.devicePixelRatio || 1;
    var rect = tlCanvas.getBoundingClientRect();
    var w = rect.width, h = 240;
    tlCanvas.width = Math.round(w * dpr);
    tlCanvas.height = Math.round(h * dpr);
    tlCanvas.style.height = h + 'px';
    tlCtx = tlCanvas.getContext('2d');
    tlCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  function tlCalc() {
    sizeTimelineCanvas();
    if (!tlCtx) return;
    var tmin = parseFloat($('tl-tmin').value);
    var tmax = parseFloat($('tl-tmax').value);
    var rh = parseFloat($('tl-rh').value);
    var sw = parseFloat($('tl-rh-sw').value);
    var pPa = state.pPa;
    var rect = tlCanvas.getBoundingClientRect();
    var W = rect.width, H = 240;
    var x0 = 50, x1 = W - 30, y0 = 14, y1 = 200;
    tlCtx.clearRect(0, 0, W, H);
    // axes
    tlCtx.strokeStyle = '#3a4458'; tlCtx.lineWidth = 1;
    tlCtx.beginPath(); tlCtx.moveTo(x0,y0); tlCtx.lineTo(x0,y1); tlCtx.lineTo(x1,y1); tlCtx.stroke();
    tlCtx.fillStyle = '#aab3c5'; tlCtx.font = '10px Courier New, monospace';
    tlCtx.textAlign = 'center';
    for (var hr = 0; hr <= 24; hr += 3) {
      var px = x0 + (hr/24) * (x1-x0);
      tlCtx.fillText(hr + 'h', px, y1 + 14);
    }
    tlCtx.textAlign = 'right';
    var tmid = (tmin + tmax) / 2;
    var trange = (tmax - tmin) / 2 + 5;
    for (var ti = 0; ti <= 4; ti++) {
      var tl = tmin - 2 + ti * (tmax - tmin + 4) / 4;
      var py = y1 - ((tl - (tmin-2)) / (tmax - tmin + 4)) * (y1 - y0);
      tlCtx.fillText(tl.toFixed(0), x0 - 4, py + 4);
    }
    // simulate 24h: sinusoidal Tdb min at 5h, max at 15h
    var hoursInComfort = 0, hoursInTC99 = 0;
    var tdb = [], wArr = [];
    for (var h = 0; h < 24; h += 0.25) {
      var phase = Math.cos(2*Math.PI*(h - 15)/24);
      var T = tmid + (tmax-tmin)/2 * phase;
      var rhInst = (rh + sw * (-phase));
      rhInst = Math.max(5, Math.min(100, rhInst));
      var Ww = Psy.wFromTRhP(T, rhInst/100, pPa);
      tdb.push({ h: h, T: T, w: Ww, rh: rhInst });
      if (T >= 20 && T <= 26 && rhInst >= 20 && rhInst <= 65) hoursInComfort += 0.25;
      var tdp = Psy.tdpFromPw(Psy.pwFromW(Ww, pPa));
      if (T >= 18 && T <= 27 && tdp <= 15 && tdp >= -9) hoursInTC99 += 0.25;
    }
    // T curve
    tlCtx.strokeStyle = '#ff8b6b'; tlCtx.lineWidth = 2;
    tlCtx.beginPath();
    tdb.forEach(function (p, i) {
      var px = x0 + (p.h/24)*(x1-x0);
      var py = y1 - ((p.T - (tmin-2))/(tmax-tmin+4))*(y1-y0);
      if (i===0) tlCtx.moveTo(px,py); else tlCtx.lineTo(px,py);
    });
    tlCtx.stroke();
    // RH curve (secondary axis right, normalized into chart)
    tlCtx.strokeStyle = '#3ddc84'; tlCtx.lineWidth = 1.5;
    tlCtx.beginPath();
    tdb.forEach(function (p, i) {
      var px = x0 + (p.h/24)*(x1-x0);
      var py = y1 - (p.rh/100)*(y1-y0);
      if (i===0) tlCtx.moveTo(px,py); else tlCtx.lineTo(px,py);
    });
    tlCtx.stroke();
    // legend
    tlCtx.font = 'bold 11px Courier New, monospace';
    tlCtx.fillStyle = '#ff8b6b'; tlCtx.textAlign = 'left';
    tlCtx.fillText('— T_db (°C)', x0 + 6, y0 + 14);
    tlCtx.fillStyle = '#3ddc84';
    tlCtx.fillText('— RH (%)', x0 + 6, y0 + 28);

    $('tl-results').innerHTML = ''
      + row('Hours inside ASHRAE 55 comfort', hoursInComfort.toFixed(2) + ' h / 24')
      + row('Hours inside TC 9.9 recommended', hoursInTC99.toFixed(2) + ' h / 24')
      + row('Daily T_db min / max', tmin.toFixed(1) + ' / ' + tmax.toFixed(1) + ' °C')
      + row('Mean RH range', (rh-sw).toFixed(0) + ' – ' + (rh+sw).toFixed(0) + ' %');
    playSuccess();
  }

