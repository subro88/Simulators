  function shuffle(arr) {
    for (var i = arr.length - 1; i > 0; i--) {
      var j = Math.floor(Math.random() * (i + 1));
      var tmp = arr[i]; arr[i] = arr[j]; arr[j] = tmp;
    }
    return arr;
  }

  function showQuizQ() {
    var q = state.quiz.q[state.quiz.idx];
    if (!q) return finishQuiz();
    $('qz-num').textContent = state.quiz.idx + 1;
    $('qz-score').textContent = state.quiz.score;
    $('qz-question').innerHTML = q.q;
    var opts = $('qz-options');
    opts.innerHTML = '';
    state.quiz.answered = false;
    q.opts.forEach(function (text, i) {
      var b = document.createElement('button');
      b.className = 'quiz-option';
      b.textContent = text;
      b.addEventListener('click', function () { answerQuizQ(i, b); });
      opts.appendChild(b);
    });
    $('qz-next').style.display = 'none';
  }

  function answerQuizQ(idx, btn) {
    if (state.quiz.answered) return;
    state.quiz.answered = true;
    var q = state.quiz.q[state.quiz.idx];
    var buttons = $$('.quiz-option');
    buttons.forEach(function (b, i) {
      b.disabled = true;
      if (i === q.a) b.classList.add('correct');
      else if (i === idx) b.classList.add('wrong');
    });
    if (idx === q.a) { state.quiz.score++; playSuccess(); }
    else { playError(); }
    $('qz-score').textContent = state.quiz.score;
    $('qz-next').style.display = 'inline-block';
    $('qz-next').textContent = state.quiz.idx + 1 < state.quiz.q.length ? 'Next' : 'See Result';
  }

