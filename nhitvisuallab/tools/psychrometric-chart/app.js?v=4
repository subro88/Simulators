    $('prac-unit').textContent = unit;
    $('prac-answer').value = '';
    $('prac-feedback').textContent = '';
    $('prac-feedback').className = 'practice-feedback';
  }

  function checkPracticeA() {
    var v = parseFloat($('prac-answer').value);
    if (!isFinite(v) || !state.prac.q) return;
    state.prac.total++;
    var diff = Math.abs(v - state.prac.q.answer);
    var fb = $('prac-feedback');
    if (diff <= state.prac.q.tol) {
      state.prac.score++;
      fb.textContent = '✓ Correct! (actual: ' + state.prac.q.answer.toFixed(2) + ' ' + state.prac.q.unit + ')';
      fb.className = 'practice-feedback ok';
      playSuccess();
    } else {
      fb.textContent = '✗ Off by ' + diff.toFixed(2) + '. Actual: ' + state.prac.q.answer.toFixed(2) + ' ' + state.prac.q.unit + '.';
      fb.className = 'practice-feedback err';
