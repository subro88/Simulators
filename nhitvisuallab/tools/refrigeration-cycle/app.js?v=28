     ═══════════════════════════════════════════════════════════════ */
  function toF(c)   { return roundN(c * 9 / 5 + 32, 1); }
  function toPsi(kPa)  { return roundN(kPa * 0.14504, 1); }
  function toBtuHr(kW) { return roundN(kW * 3412.14, 0); }
  function toLbMin(kgs){ return roundN(kgs * 132.277, 4); }

