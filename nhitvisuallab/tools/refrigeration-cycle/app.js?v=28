        state.refIdx = i;
        elRefTabs.querySelectorAll('.mat-pill').forEach(function (p) { p.classList.remove('active'); });
        pill.classList.add('active');
        if (state.running) {
          recalcCycle();
          displayResults();
        } else if (state.cycle) {
          recalcCycle();
          displayResults();
          drawMachine();
          drawPHDiagram();
        }
      });
      elRefTabs.appendChild(pill);
    });
  }

