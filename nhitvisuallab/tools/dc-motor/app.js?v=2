  /* ================================================================
     CALC MODAL
     ================================================================ */

  function buildCalcSteps() {
    var html = '';
    html += '<div class="cs-inputs"><span class="cs-badge">Given &mdash; Current State</span>';
    html += '<div class="cs-given">';
    html += '<span>Type = ' + motorType + '</span>';
    html += '<span>V = ' + supplyV.toFixed(0) + ' V</span>';
    html += '<span>R_a = ' + Ra.toFixed(2) + ' Ω</span>';
    html += '<span>φ = ' + fieldFlux.toFixed(2) + ' Wb</span>';
    html += '<span>T_load = ' + loadTorque.toFixed(2) + ' Nm</span>';
    if (motorType === 'separate') html += '<span>V_f = ' + Vfield.toFixed(0) + ' V</span>';
    html += '</div>';
    html += '<p class="cs-si-note">&#9432; All calculations performed in SI; display unit follows the SI / Imperial toggle.</p></div>';

    var step = 1;
    /* Step 1: Effective Kphi */
    if (motorType === 'shunt') {
      html += calcStep(step++, 'Compute effective flux (shunt)',
        '\\[ \\varphi_{eff} = \\varphi_{0} \\cdot \\dfrac{V}{V_{rated}} \\]',
        '\\(\\varphi_{eff} = ' + fieldFlux.toFixed(2) + ' \\cdot \\dfrac{' + supplyV.toFixed(0) + '}{' + Vrated + '} = ' + phys.phiEff.toFixed(3) + '\\;\\mathrm{Wb}\\)',
        'Kφ = ' + phys.Kphi.toFixed(3));
    } else if (motorType === 'separate') {
      html += calcStep(step++, 'Compute effective flux (separately excited)',
        '\\[ \\varphi_{eff} = \\varphi_{0} \\cdot \\dfrac{V_{f}}{V_{rated}} \\]',
        '\\(\\varphi_{eff} = ' + fieldFlux.toFixed(2) + ' \\cdot \\dfrac{' + Vfield.toFixed(0) + '}{' + Vrated + '} = ' + phys.phiEff.toFixed(3) + '\\;\\mathrm{Wb}\\)',
        'Kφ = ' + phys.Kphi.toFixed(3));
    } else {
      html += calcStep(step++, 'Series flux ∝ armature current',
        '\\[ \\varphi = k_{f} \\cdot I_{a} \\]',
        '\\(K \\cdot k_{f} = ' + phys.Kphi.toFixed(3) + '\\)',
        'flux rises with load');
    }

    /* Step 2: Ia from Tload */
    if (motorType === 'series') {
      html += calcStep(step++, 'Solve armature current from T = K k_f I_a²',
        '\\[ I_a = \\sqrt{\\dfrac{T}{K \\cdot k_f}} \\]',
        '\\(I_a = \\sqrt{\\dfrac{' + loadTorque.toFixed(2) + '}{' + phys.Kphi.toFixed(3) + '}} = ' + phys.Ia.toFixed(2) + '\\;\\mathrm{A}\\)',
        'I_a = ' + phys.Ia.toFixed(2) + ' A');
    } else {
      html += calcStep(step++, 'Solve armature current from T = Kφ I_a',
        '\\[ I_a = \\dfrac{T_{load}}{K\\varphi} \\]',
        '\\(I_a = \\dfrac{' + loadTorque.toFixed(2) + '}{' + phys.Kphi.toFixed(3) + '} = ' + phys.Ia.toFixed(2) + '\\;\\mathrm{A}\\)',
        'I_a = ' + phys.Ia.toFixed(2) + ' A');
    }

    /* Step 3: Back EMF */
    html += calcStep(step++, 'Back EMF',
      '\\[ E_b = V - I_a \\cdot R_a \\]',
      '\\(E_b = ' + supplyV.toFixed(0) + ' - ' + phys.Ia.toFixed(2) + ' \\cdot ' + Ra.toFixed(2) + ' = ' + phys.Eb.toFixed(2) + '\\;\\mathrm{V}\\)',
      'E_b = ' + phys.Eb.toFixed(2) + ' V');

    /* Step 4: Speed */
    if (motorType === 'series') {
      html += calcStep(step++, 'Speed from E_b and (K k_f I_a)',
        '\\[ N = \\dfrac{E_b}{K \\cdot k_f \\cdot I_a} \\]',
        '\\(N = \\dfrac{' + phys.Eb.toFixed(2) + '}{' + phys.Kphi.toFixed(3) + ' \\cdot ' + phys.Ia.toFixed(2) + '} = ' + Math.round(phys.N) + '\\;\\mathrm{RPM}\\)',
        'N = ' + Math.round(phys.N) + ' RPM');
    } else {
      html += calcStep(step++, 'Speed',
        '\\[ N = \\dfrac{E_b}{K\\varphi} \\]',
        '\\(N = \\dfrac{' + phys.Eb.toFixed(2) + '}{' + phys.Kphi.toFixed(3) + '} = ' + Math.round(phys.N) + '\\;\\mathrm{RPM}\\)',
        'N = ' + Math.round(phys.N) + ' RPM');
    }

    /* Step 5: Power balance */
    html += calcStep(step++, 'Output power and copper loss',
      '\\[ P_{out} = T \\cdot \\omega,\\quad P_{cu} = I_a^{2} R_a \\]',
      '\\(\\omega = \\dfrac{2\\pi \\cdot ' + Math.round(phys.N) + '}{60} = ' + (phys.N * 2 * Math.PI / 60).toFixed(2) + '\\;\\mathrm{rad/s}\\)\\\\\n' +
      '\\(P_{out} = ' + phys.T.toFixed(2) + ' \\cdot ' + (phys.N * 2 * Math.PI / 60).toFixed(2) + ' = ' + phys.Pout.toFixed(1) + '\\;\\mathrm{W}\\)\\\\\n' +
      '\\(P_{cu} = ' + phys.Ia.toFixed(2) + '^{2} \\cdot ' + Ra.toFixed(2) + ' = ' + phys.Pcu.toFixed(1) + '\\;\\mathrm{W}\\)',
      'P_out = ' + phys.Pout.toFixed(1) + ' W, P_cu = ' + phys.Pcu.toFixed(1) + ' W');

    /* Step 6: Efficiency */
    html += calcStep(step++, 'Efficiency',
      '\\[ \\eta = \\dfrac{P_{out}}{P_{in}} \\cdot 100\\% \\]',
      '\\(\\eta = \\dfrac{' + phys.Pout.toFixed(1) + '}{' + phys.Pin.toFixed(1) + '} \\cdot 100 = ' + phys.eff.toFixed(1) + '\\%\\)',
      'η = ' + phys.eff.toFixed(1) + '%');

    return html;
  }
  function calcStep(num, title, formula, calc, result) {
    var h = '<div class="cs-step">';
    h += '<div class="cs-step-hd"><span class="cs-num">Step ' + num + '</span><span class="cs-title">' + title + '</span></div>';
    if (formula) h += '<div class="cs-formula">' + formula + '</div>';
    if (calc)    h += '<div class="cs-calc">' + calc + '</div>';
    if (result != null) h += '<div class="cs-result">→ <strong>' + result + '</strong></div>';
    h += '</div>';
    return h;
  }
  function openCalcModal() {
    calcModalBody.innerHTML = buildCalcSteps();
    calcModal.classList.add('active');
    if (window.renderMathInElement) {
      try { window.renderMathInElement(calcModalBody, { delimiters: [
        { left: '\\[', right: '\\]', display: true },
