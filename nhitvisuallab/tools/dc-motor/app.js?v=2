    var V2 = randInt(100, 240), Ra2 = round1(randInt(2, 10) / 10);
    pool.push({ type: 'numeric', prompt: 'V = ' + V2 + ' V, R_a = ' + Ra2 + ' Ω. Starting current (A)?', answer: round1(V2 / Ra2), unit: 'A', tol: 1 });
    var T3 = randInt(5, 30), N3 = randInt(500, 1500);
    var w3 = round2(N3 * 2 * Math.PI / 60);
    pool.push({ type: 'numeric', prompt: T3 + ' Nm at ' + N3 + ' RPM. Output power (W)?', answer: round1(T3 * w3), unit: 'W', tol: 5 });
    var V4 = randInt(100, 240), Rsh4 = randInt(60, 200);
    pool.push({ type: 'numeric', prompt: 'Shunt motor: V = ' + V4 + ' V, R_shunt = ' + Rsh4 + ' Ω. I_sh (A)?', answer: round2(V4 / Rsh4), unit: 'A', tol: 0.05 });
    var V5 = randInt(100, 240), Ia5 = randInt(10, 50), Ra5 = round1(randInt(3, 15) / 10);
    var Pin5 = V5 * Ia5, loss5 = round1(Ia5 * Ia5 * Ra5);
