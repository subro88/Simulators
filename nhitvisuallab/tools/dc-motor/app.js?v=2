  /* ================================================================
     PHYSICS
     ================================================================ */

  function calcPhysics() {
    var V = supplyV, phi = fieldFlux, Tload = loadTorque, Kphi;

    if (motorType === 'shunt') {
      /* Shunt: field sees the supply, so if V changes, phi scales somewhat.
         We treat the slider phi as the field-design constant (at rated V). */
      var effPhi = phi * (V / Math.max(Vrated, 1));   /* scales with supply for shunt */
      effPhi = Math.max(effPhi, 0.001);
      Kphi = Kmotor * effPhi;

      var Ia = Tload / Kphi;
      var IaMax = V / Math.max(Ra, 0.001);
      if (Ia > IaMax) Ia = IaMax;
      var Eb = V - Ia * Ra;
      if (Eb < 0) Eb = 0;
      var N = Kphi > 0.001 ? (Eb / Kphi) : 0;
      var T = Kphi * Ia;
      var omega = N * 2 * Math.PI / 60;
      var Pout = T * omega;
      var Pin  = V * Ia + (V * V / 200);   /* approximate shunt field loss */
      var eff  = Pin > 0 ? (Pout / Pin) * 100 : 0;
      var N0   = Kphi > 0.001 ? V / Kphi : 0;
      var Tstall = Kphi * IaMax;
      phys = { N: N, T: T, Eb: Eb, Ia: Ia, Pin: Pin, Pout: Pout, eff: eff, N0: N0, Tstall: Tstall, Kphi: Kphi, IaMax: IaMax, Pcu: Ia*Ia*Ra, phiEff: effPhi };

    } else if (motorType === 'separate') {
      /* Separately excited: V and Vf independent. Phi depends only on Vf. */
      var effPhiS = phi * (Vfield / Math.max(Vrated, 1));
      effPhiS = Math.max(effPhiS, 0.001);
      Kphi = Kmotor * effPhiS;

      var IaS = Tload / Kphi;
      var IaMaxS = V / Math.max(Ra, 0.001);
      if (IaS > IaMaxS) IaS = IaMaxS;
      var EbS = V - IaS * Ra;
      if (EbS < 0) EbS = 0;
      var Ns  = Kphi > 0.001 ? (EbS / Kphi) : 0;
      var Ts  = Kphi * IaS;
      var omS = Ns * 2 * Math.PI / 60;
      var PoS = Ts * omS;
      var PiS = V * IaS + (Vfield * Vfield / 200);    /* armature + field-supply */
      var efS = PiS > 0 ? (PoS / PiS) * 100 : 0;
      var N0s = Kphi > 0.001 ? V / Kphi : 0;
      var TstS= Kphi * IaMaxS;
      phys = { N: Ns, T: Ts, Eb: EbS, Ia: IaS, Pin: PiS, Pout: PoS, eff: efS, N0: N0s, Tstall: TstS, Kphi: Kphi, IaMax: IaMaxS, Pcu: IaS*IaS*Ra, phiEff: effPhiS };

    } else {
      /* Series motor: phi ~ Ia, T = Km*kf*Ia^2 */
      var Kf = phi;
      var KmKf = Kmotor * Kf;
      var IaR;
      if (KmKf < 0.0001) IaR = 0;
      else IaR = Math.sqrt(Math.max(0, Tload / KmKf));

      var IaMaxR = V / Math.max(Ra, 0.001);
      if (IaR > IaMaxR) IaR = IaMaxR;

      var EbR = (IaR < 0.01) ? V : V - IaR * Ra;
      if (EbR < 0) EbR = 0;
      var Nr;
      if (IaR < 0.01 || KmKf < 0.0001) Nr = 5000;
      else Nr = EbR / (KmKf * IaR);
      if (Nr > 5000) Nr = 5000;
      var Tr = KmKf * IaR * IaR;
      var omR= Nr * 2 * Math.PI / 60;
      var PoR= Tr * omR;
      var PiR= V * IaR;
      var efR= PiR > 0 ? (PoR / PiR) * 100 : 0;
      var TstR = KmKf * IaMaxR * IaMaxR;
      phys = { N: Nr, T: Tr, Eb: EbR, Ia: IaR, Pin: PiR, Pout: PoR, eff: efR, N0: 5000, Tstall: TstR, Kphi: KmKf, IaMax: IaMaxR, Pcu: IaR*IaR*Ra, phiEff: Kf * IaR };
    }

    phys.eff = clamp(phys.eff, 0, 100);
  }

