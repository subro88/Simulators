  /* ================================================================
     SLIDER + STEPPER FACTORY
     ================================================================ */

  function bindParam(slider, input, getter, setter, opts) {
    opts = opts || {};
    var lo = opts.lo, hi = opts.hi, step = opts.step || 1, fixedDigits = opts.digits;
    var displayFromSI = opts.displayFromSI || function (v) { return v; };
    var siFromDisplay = opts.siFromDisplay || function (v) { return v; };

    slider.addEventListener('input', function () {
      saveUndo();
      var v = parseFloat(this.value);
      v = clamp(v, lo, hi);
      setter(v);
      clearPresetActive();
      syncSteppersFromState();
      render();
    });
    var stp = input.closest('.stepper');
    if (stp) {
      stp.querySelectorAll('.stp-btn').forEach(function (b) {
        b.addEventListener('click', function () {
          saveUndo();
          var dir = parseFloat(b.dataset.step);
          var cur = displayFromSI(getter());
          var next = cur + dir * step;
          var siVal = clamp(siFromDisplay(next), lo, hi);
          setter(siVal);
          clearPresetActive();
          syncSlidersFromState(); syncSteppersFromState();
          render();
        });
      });
    }
    input.addEventListener('change', function () {
      saveUndo();
      var v = parseFloat(this.value);
      if (isNaN(v)) { this.value = displayFromSI(getter()).toFixed(fixedDigits || 2); return; }
      var siVal = clamp(siFromDisplay(v), lo, hi);
      setter(siVal);
      clearPresetActive();
      syncSlidersFromState();
      render();
    });
    input.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') this.blur();
    });
  }

