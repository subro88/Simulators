  function updateLearnPanels() {
    if (!lpEqBody) return;

    /* Live equations */
    var eq = '';
    eq += '<div class="eq-line">\\[ E_b = V - I_a \\cdot R_a \\]</div>';
    eq += '<div class="eq-line">\\(E_b = ' + supplyV.toFixed(0) + ' - ' + phys.Ia.toFixed(2) + ' \\cdot ' + Ra.toFixed(2) + ' = \\mathbf{' + phys.Eb.toFixed(2) + '\\;\\mathrm{V}}\\)</div>';
    eq += '<div class="eq-line">\\[ N = \\dfrac{E_b}{K \\varphi} \\]</div>';
    eq += '<div class="eq-line">\\(N = \\dfrac{' + phys.Eb.toFixed(2) + '}{' + phys.Kphi.toFixed(3) + '} = \\mathbf{' + Math.round(phys.N) + '\\;\\mathrm{RPM}}\\)</div>';
    eq += '<div class="eq-line">\\[ T = K \\varphi \\cdot I_a \\]</div>';
    var tDispEq = toTorqueD(phys.T);
    eq += '<div class="eq-line">\\(T = ' + phys.Kphi.toFixed(3) + ' \\cdot ' + phys.Ia.toFixed(2) + ' = \\mathbf{' + tDispEq.toFixed(2) + '\\;\\mathrm{' + (isImp() ? 'lbf{\\cdot}ft' : 'N{\\cdot}m') + '}}\\)</div>';
    if (eq !== _learnCache.eq) { lpEqBody.innerHTML = eq; _learnCache.eq = eq; }

    /* Power flow */
    var pwr = '';
    var Pin = phys.Pin, Pcu = phys.Pcu, Pout = phys.Pout;
    var uP = isImp() ? '\\mathrm{hp}' : '\\mathrm{W}';
    pwr += '<div class="eq-line">\\[ P_{in} = V \\cdot I_a + P_{field} \\]</div>';
    pwr += '<div class="eq-line">\\(P_{in} = ' + supplyV.toFixed(0) + ' \\cdot ' + phys.Ia.toFixed(2) + ' \\approx \\mathbf{' + toPowerD(Pin).toFixed(powerDigits(Pin)) + '\\;' + uP + '}\\)</div>';
    pwr += '<div class="eq-line">\\[ P_{cu} = I_a^{2} \\cdot R_a \\]</div>';
    pwr += '<div class="eq-line">\\(P_{cu} = ' + phys.Ia.toFixed(2) + '^{2} \\cdot ' + Ra.toFixed(2) + ' = \\mathbf{' + toPowerD(Pcu).toFixed(powerDigits(Pcu)) + '\\;' + uP + '}\\)</div>';
    pwr += '<div class="eq-line">\\[ P_{out} = T \\cdot \\omega = T \\cdot \\dfrac{2\\pi N}{60} \\]</div>';
    pwr += '<div class="eq-line">\\(P_{out} = \\mathbf{' + toPowerD(Pout).toFixed(powerDigits(Pout)) + '\\;' + uP + '}\\quad\\eta = \\mathbf{' + phys.eff.toFixed(1) + '\\%}\\)</div>';
    if (pwr !== _learnCache.pwr) {
      lpPwrBody.innerHTML = pwr; _learnCache.pwr = pwr;
      if (window.renderMathInElement) {
        try { window.renderMathInElement(lpPwrBody, { delimiters: [
          { left: '\\[', right: '\\]', display: true },
          { left: '\\(', right: '\\)', display: false }
        ], throwOnError: false }); } catch (e) {}
      }
    }

    /* Coach */
    var co = '';
    if (phys.Ia >= phys.IaMax * 0.98 && phys.Eb < supplyV * 0.05) {
      co += coachItem('bad', '&#9888;', '<strong>Near stall</strong> &mdash; load too large for current settings. Armature current is saturated at V/R_a (~' + phys.IaMax.toFixed(1) + ' A) and back EMF has collapsed. Reduce load torque or raise V.');
    } else if (motorType === 'series' && phys.N >= 4900) {
      co += coachItem('bad', '&#9888;', '<strong>Runaway risk</strong> &mdash; series motor at near-zero load is heading for unsafe speed. Apply some load torque or use a different motor type.');
    } else if (phys.eff > 80) {
      co += coachItem('good', '&#9989;', '<strong>Efficient operation</strong> &mdash; you are running near the sweet spot. η = ' + phys.eff.toFixed(1) + '% means most of the input power becomes mechanical work.');
    } else if (phys.eff < 40 && phys.Pin > 50) {
      co += coachItem('warn', '&#128268;', '<strong>Low efficiency (' + phys.eff.toFixed(1) + '%)</strong> &mdash; either very light load (no-load losses dominate) or very heavy load (copper loss dominates). Try a moderate Tload.');
    } else {
      co += coachItem('', '&#9881;', '<strong>Operating normally.</strong> ' + Math.round(phys.N) + ' RPM at ' + toTorqueD(phys.T).toFixed(2) + ' ' + torqueLabel() + ', efficiency ' + phys.eff.toFixed(1) + '%.');
    }
    if (phys.Pcu / Math.max(phys.Pin, 1) > 0.25) {
      co += coachItem('warn', '&#128293;', 'Copper loss (' + toPowerD(phys.Pcu).toFixed(0) + ' ' + powerLabel() + ') is consuming over 25% of input power. R_a or current is high.');
    }
    if (motorType === 'shunt' && fieldFlux < 0.2) {
      co += coachItem('warn', '&#11015;', '<strong>Field weakening regime</strong> &mdash; flux below 0.2 Wb. Speed is boosted but torque capability drops proportionally.');
    }
    if (co !== _learnCache.coach) { lpCoachBody.innerHTML = co; _learnCache.coach = co; }
  }
  function coachItem(cls, icon, text) {
    return '<div class="coach-item ' + cls + '"><span class="coach-icon">' + icon + '</span><span>' + text + '</span></div>';
