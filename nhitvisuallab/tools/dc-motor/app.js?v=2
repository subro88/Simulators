  function drawZigzag(x, y, orient) {
    var peaks = 5, amp = 12, segW = 8;
    var totalW = peaks * segW;
    ctx.save();
    ctx.translate(x, y);
    if (orient === 'v') ctx.rotate(Math.PI / 2);
    ctx.beginPath();
    ctx.moveTo(-totalW / 2 - 10, 0);
    ctx.lineTo(-totalW / 2, 0);
    for (var i = 0; i < peaks; i++) {
      var pxz = -totalW / 2 + i * segW + segW / 2;
      var pyz = (i % 2 === 0) ? -amp : amp;
      ctx.lineTo(pxz, pyz);
    }
    ctx.lineTo(totalW / 2, 0);
    ctx.lineTo(totalW / 2 + 10, 0);
    ctx.strokeStyle = '#ffa000'; ctx.lineWidth = 3; ctx.lineCap = 'round'; ctx.lineJoin = 'round';
    ctx.stroke();
    ctx.restore();
  }

