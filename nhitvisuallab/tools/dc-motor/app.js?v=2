    pool.push({ type: 'mcq', prompt: 'Efficiency of a DC motor equals:', options: ['P_out / P_in × 100', 'P_in / P_out × 100', 'V × I_a', 'T × N'], correct: 0 });
    pool.push({ type: 'mcq', prompt: 'The commutator\'s function is to:', options: ['Reverse current in armature coils', 'Generate magnetic field', 'Reduce friction', 'Increase voltage'], correct: 0 });
    pool.push({ type: 'mcq', prompt: 'A separately excited DC motor allows independent control of:', options: ['Armature and field supplies', 'Speed and direction only', 'Torque alone', 'Current alone'], correct: 0 });
    pool.push({ type: 'mcq', prompt: 'Copper loss in the armature scales as:', options: ['I_a²', 'I_a', '1 / I_a', 'V × I_a'], correct: 0 });
    pool.push({ type: 'mcq', prompt: 'In armature voltage control, speed:', options: ['Varies linearly with V', 'Varies inversely with V', 'Stays constant', 'Goes to zero'], correct: 0 });
