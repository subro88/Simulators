  function downloadFile(name, blob) {
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url; a.download = name;
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(function () { URL.revokeObjectURL(url); }, 200);
  }

  function exportCSV() {
    var lines = ['# DC Motor Simulator sweep export',
      '# motor_type=' + motorType + ' V=' + supplyV + ' Ra=' + Ra + ' phi=' + fieldFlux + ' Tload=' + loadTorque,
      'Torque_Nm,Speed_RPM,BackEMF_V,Ia_A,Pout_W,Eff_%'];
    var maxT_SI = Math.max(phys.Tstall * 1.05, 10);
    var N = 50;
    for (var i = 0; i <= N; i++) {
      var T = i / N * maxT_SI;
      var s = simulatedPointAt(T);
      lines.push(T.toFixed(3) + ',' + Math.round(s.N) + ',' + s.Eb.toFixed(2) + ',' + s.Ia.toFixed(3) + ',' + s.Pout.toFixed(2) + ',' + s.eff.toFixed(2));
    }
    var blob = new Blob([lines.join('\n')], { type: 'text/csv' });
    downloadFile('dc-motor-' + motorType + '-' + Date.now() + '.csv', blob);
  }

  function simulatedPointAt(Tload_SI) {
    var saveT = loadTorque;
    loadTorque = Tload_SI;
    calcPhysics();
    var p = { N: phys.N, Eb: phys.Eb, Ia: phys.Ia, Pout: phys.Pout, eff: phys.eff };
    loadTorque = saveT;
    calcPhysics();
    return p;
  }

