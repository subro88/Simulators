  function syncSteppersFromState() {
    if (document.activeElement !== vInput)    vInput.value    = supplyV;
    if (document.activeElement !== raInput)   raInput.value   = Ra.toFixed(2);
    if (document.activeElement !== fluxInput) fluxInput.value = fieldFlux.toFixed(2);
    if (document.activeElement !== tlInput)   tlInput.value   = toTorqueD(loadTorque).toFixed(isImp() ? 2 : 1);
    if (vfInput && document.activeElement !== vfInput) vfInput.value = Vfield;
  }
  function syncMotorTabs() {
    motorTabs.querySelectorAll('.pill').forEach(function (p) {
      p.classList.toggle('active', p.dataset.type === motorType);
    });
  }
  function syncToggleDOM() {
    chkSchematic.checked = showSchematic;
    chkCurve.checked     = showCurve;
    chkEquation.checked  = showEquation;
    chkGrid.checked      = showGrid;
  }
  function updateVfRow() {
    vfRow.style.display = motorType === 'separate' ? '' : 'none';
  }
  function clearPresetActive() {
    presetChips.querySelectorAll('.preset-chip').forEach(function (c) { c.classList.remove('active'); });
  }

  /* ================================================================
     CANVAS — DRAW
     ================================================================ */

  function clearCanvas() {
    ctx.fillStyle = '#161b27';
    ctx.fillRect(0, 0, W, H);
  }
  function drawGrid() {
    ctx.strokeStyle = 'rgba(66,165,245,0.07)';
    ctx.lineWidth = 1;
    for (var x = 0; x <= W; x += 30) {
      ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, H); ctx.stroke();
    }
    for (var y = 0; y <= H; y += 30) {
      ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(W, y); ctx.stroke();
    }
  }

  function draw() {
    clearCanvas();
    if (showGrid) drawGrid();
    if (showSchematic) drawMotorDiagram();
    if (showCurve)     drawSpeedTorqueCurve();
    if (showEquation)  drawCanvasEquation();
  }

  function render() {
    calcPhysics();
    draw();
    updateReadouts();
    updateLearnPanels();
  }

  /* --- Realistic motor schematic ------------------------------ */
  function drawMotorDiagram() {
    var cx = 200, cy = 230;
    var Rout = 100;    /* outer yoke */
    var Rin  = 78;     /* inside yoke */
    var Rcore= 56;     /* rotor outer */
    var Rshaft = 9;    /* shaft radius */

    /* ---- Mounting feet ---- */
    ctx.fillStyle = '#3a4258';
    ctx.strokeStyle = '#1a1f2e';
    ctx.lineWidth = 1.5;
    var footY = cy + Rout + 6;
    ctx.beginPath();
    ctx.moveTo(cx - Rout - 18, footY);
    ctx.lineTo(cx - Rout + 8,  footY);
    ctx.lineTo(cx - Rout + 18, footY + 14);
    ctx.lineTo(cx - Rout - 22, footY + 14);
    ctx.closePath(); ctx.fill(); ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(cx + Rout + 18, footY);
    ctx.lineTo(cx + Rout - 8,  footY);
    ctx.lineTo(cx + Rout - 18, footY + 14);
    ctx.lineTo(cx + Rout + 22, footY + 14);
    ctx.closePath(); ctx.fill(); ctx.stroke();
    /* Bolt holes */
    ctx.fillStyle = '#0d1117';
    ctx.beginPath(); ctx.arc(cx - Rout - 4, footY + 8, 2.5, 0, Math.PI * 2); ctx.fill();
    ctx.beginPath(); ctx.arc(cx + Rout + 4, footY + 8, 2.5, 0, Math.PI * 2); ctx.fill();

    /* ---- Terminal junction box on top ---- */
    var tbW = 50, tbH = 22;
    var tbX = cx - tbW / 2, tbY = cy - Rout - tbH - 2;
    var tbGrad = ctx.createLinearGradient(tbX, tbY, tbX, tbY + tbH);
    tbGrad.addColorStop(0, '#4a5266');
    tbGrad.addColorStop(1, '#2a3142');
    ctx.fillStyle = tbGrad;
    ctx.strokeStyle = '#1a1f2e'; ctx.lineWidth = 1.5;
    ctx.fillRect(tbX, tbY, tbW, tbH);
    ctx.strokeRect(tbX, tbY, tbW, tbH);
    /* Terminal screws */
    [0.3, 0.7].forEach(function (f) {
      var x = tbX + tbW * f;
      ctx.beginPath(); ctx.arc(x, tbY + tbH / 2, 3, 0, Math.PI * 2);
      ctx.fillStyle = '#c0c0c0'; ctx.fill();
      ctx.strokeStyle = '#5a5a5a'; ctx.lineWidth = 0.8; ctx.stroke();
      ctx.beginPath(); ctx.moveTo(x - 2, tbY + tbH / 2); ctx.lineTo(x + 2, tbY + tbH / 2);
      ctx.strokeStyle = '#2a2a2a'; ctx.lineWidth = 1; ctx.stroke();
    });

    /* ---- Outer yoke (housing) — radial gradient for 3D feel ---- */
    var yokeGrad = ctx.createRadialGradient(cx - 30, cy - 40, 20, cx, cy, Rout);
    yokeGrad.addColorStop(0, '#5a6478');
    yokeGrad.addColorStop(0.6, '#3a4258');
    yokeGrad.addColorStop(1, '#1a1f2e');
    ctx.beginPath(); ctx.arc(cx, cy, Rout, 0, Math.PI * 2);
    ctx.fillStyle = yokeGrad; ctx.fill();
    ctx.strokeStyle = '#0d1117'; ctx.lineWidth = 2; ctx.stroke();

    /* Inner yoke ring (air gap edge) */
    ctx.beginPath(); ctx.arc(cx, cy, Rin, 0, Math.PI * 2);
    ctx.fillStyle = '#0d1117'; ctx.fill();

    /* ---- Stator pole shoes (curved, pointing inward) ---- */
    var poleColor = motorType === 'series' ? '#ff8a65' : '#90caf9';
    var poleColorDark = motorType === 'series' ? '#bf6149' : '#4a6680';
    [Math.PI, 0].forEach(function (poleAngle, idx) {
      ctx.save();
      ctx.translate(cx, cy);
      ctx.rotate(poleAngle);
      /* Pole body (rectangle from inner ring) */
      var pw = 28, pdepth = Rin - Rcore - 4;
      var poleGrad = ctx.createLinearGradient(Rcore + 2, 0, Rin, 0);
      poleGrad.addColorStop(0, poleColor);
      poleGrad.addColorStop(1, poleColorDark);
      ctx.fillStyle = poleGrad;
      ctx.beginPath();
      ctx.moveTo(Rcore + 4, -pw * 0.55);
      ctx.lineTo(Rin,        -pw * 0.4);
      ctx.lineTo(Rin,         pw * 0.4);
      ctx.lineTo(Rcore + 4,   pw * 0.55);
      /* curved pole face on the rotor side */
      ctx.arc(0, 0, Rcore + 4, Math.atan2(pw * 0.55, Rcore + 4), -Math.atan2(pw * 0.55, Rcore + 4), true);
      ctx.closePath(); ctx.fill();
      ctx.strokeStyle = '#1a1f2e'; ctx.lineWidth = 1.2; ctx.stroke();

      /* Pole label N / S */
      ctx.font = 'bold 14px "Segoe UI", sans-serif';
      ctx.fillStyle = '#0d1117'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.fillText(idx === 0 ? 'N' : 'S', (Rcore + Rin) / 2 + 2, 0);

      /* Field coils wrapped around the pole — multiple turns rendered as stacked ellipses */
      var coilTurns = 6;
      var coilStartR = Rcore + 6;
      var coilEndR   = Rin - 2;
      var coilStepR  = (coilEndR - coilStartR) / coilTurns;
      for (var t = 0; t < coilTurns; t++) {
        var rR = coilStartR + (t + 0.5) * coilStepR;
        /* Top turn */
        ctx.beginPath();
        ctx.ellipse(rR, -pw * 0.5 - 2, 4, 5, 0, 0, Math.PI * 2);
        ctx.fillStyle = '#c87f3a';
        ctx.fill();
        ctx.strokeStyle = '#704720'; ctx.lineWidth = 0.6; ctx.stroke();
        /* Bottom turn */
        ctx.beginPath();
        ctx.ellipse(rR, pw * 0.5 + 2, 4, 5, 0, 0, Math.PI * 2);
        ctx.fillStyle = '#c87f3a'; ctx.fill();
        ctx.strokeStyle = '#704720'; ctx.lineWidth = 0.6; ctx.stroke();
      }

      ctx.restore();
    });

    /* ---- Curved field-flux lines from N to S inside the air gap ---- */
    if (Math.abs(phys.phiEff) > 0.05) {
      ctx.save();
      ctx.translate(cx, cy);
      var fluxLines = 5;
      for (var fi = 0; fi < fluxLines; fi++) {
        var off = (fi - (fluxLines - 1) / 2) * 7;
        ctx.beginPath();
        ctx.moveTo(-Rcore - 4, off);
        ctx.bezierCurveTo(-Rcore + 10, off - 16, Rcore - 10, off - 16, Rcore + 4, off);
        ctx.strokeStyle = 'rgba(144,202,249,' + (0.18 + 0.12 * Math.min(1, phys.phiEff / 0.6)).toFixed(2) + ')';
        ctx.lineWidth = 1.2;
        ctx.setLineDash([3, 3]);
        ctx.stroke();
      }
      ctx.setLineDash([]);
      ctx.restore();
    }

    /* ---- Armature (rotor) — laminated core look ---- */
    ctx.save();
    ctx.translate(cx, cy);
    ctx.rotate(rotorAngle);

    /* Core fill with subtle radial gradient */
    var coreGrad = ctx.createRadialGradient(0, 0, Rshaft, 0, 0, Rcore);
    coreGrad.addColorStop(0, '#2a3450');
    coreGrad.addColorStop(0.7, '#1a2238');
    coreGrad.addColorStop(1, '#0d1422');
    ctx.beginPath(); ctx.arc(0, 0, Rcore, 0, Math.PI * 2);
    ctx.fillStyle = coreGrad; ctx.fill();
    ctx.strokeStyle = '#3d4f70'; ctx.lineWidth = 1.5; ctx.stroke();

    /* 12 armature slots with current direction (• out / × in) */
    var nSlots = 12;
    var slotR  = Rcore - 8;
    var slotRad = 6;
    /* Direction follows torque sign — flip halves for two-pole machine. */
    var Idir = phys.Ia > 0.01 ? 1 : 0;
    for (var s = 0; s < nSlots; s++) {
      var sa = (s / nSlots) * Math.PI * 2;
      var sx = Math.cos(sa) * slotR;
      var sy = Math.sin(sa) * slotR;

      /* Slot well */
      ctx.beginPath(); ctx.arc(sx, sy, slotRad, 0, Math.PI * 2);
      ctx.fillStyle = '#3a2a45'; ctx.fill();
      ctx.strokeStyle = '#1a1422'; ctx.lineWidth = 0.8; ctx.stroke();

      /* Conductor disc */
      ctx.beginPath(); ctx.arc(sx, sy, slotRad - 1.5, 0, Math.PI * 2);
      ctx.fillStyle = '#e57373'; ctx.fill();
      ctx.strokeStyle = '#8a3a3a'; ctx.lineWidth = 0.5; ctx.stroke();

      if (Idir) {
        /* Top half (relative to rotor frame): current OUT (•) */
        /* Bottom half: current IN (×) */
        var topHalf = Math.sin(sa) < -0.05;
        var botHalf = Math.sin(sa) >  0.05;
        if (topHalf) {
          ctx.beginPath(); ctx.arc(sx, sy, 1.6, 0, Math.PI * 2);
          ctx.fillStyle = '#fff'; ctx.fill();
        } else if (botHalf) {
          ctx.beginPath();
          ctx.moveTo(sx - 2.2, sy - 2.2); ctx.lineTo(sx + 2.2, sy + 2.2);
          ctx.moveTo(sx - 2.2, sy + 2.2); ctx.lineTo(sx + 2.2, sy - 2.2);
          ctx.strokeStyle = '#fff'; ctx.lineWidth = 1.2; ctx.stroke();
        }
      }
    }

    /* Inner laminated ring */
    ctx.beginPath(); ctx.arc(0, 0, Rshaft + 8, 0, Math.PI * 2);
    ctx.strokeStyle = 'rgba(120,135,160,0.25)'; ctx.lineWidth = 1; ctx.stroke();
    ctx.beginPath(); ctx.arc(0, 0, Rshaft + 16, 0, Math.PI * 2);
    ctx.strokeStyle = 'rgba(120,135,160,0.15)'; ctx.lineWidth = 1; ctx.stroke();

    /* Shaft cross-section through rotor */
    ctx.beginPath(); ctx.arc(0, 0, Rshaft, 0, Math.PI * 2);
    var shaftGrad = ctx.createRadialGradient(-3, -3, 1, 0, 0, Rshaft);
    shaftGrad.addColorStop(0, '#d8dde6');
    shaftGrad.addColorStop(1, '#5a6172');
    ctx.fillStyle = shaftGrad; ctx.fill();
    ctx.strokeStyle = '#2a2f3a'; ctx.lineWidth = 1; ctx.stroke();

    /* Keyway slot */
    ctx.fillStyle = '#1a1f2e';
    ctx.fillRect(-1.5, -Rshaft, 3, 4);

    /* Rotation arrow indicator */
    if (phys.N > 10) {
      ctx.save();
      ctx.rotate(-rotorAngle * 0.0);  /* keep arrow in rotor frame */
      ctx.beginPath();
      var arrowR = Rcore - 22;
      ctx.arc(0, 0, arrowR, -Math.PI / 4, Math.PI / 4);
      ctx.strokeStyle = 'rgba(245,200,66,0.7)'; ctx.lineWidth = 2;
      ctx.stroke();
      /* Arrow head */
      var ax = Math.cos(Math.PI / 4) * arrowR;
      var ay = Math.sin(Math.PI / 4) * arrowR;
      ctx.beginPath();
      ctx.moveTo(ax, ay);
      ctx.lineTo(ax - 6, ay - 4);
      ctx.lineTo(ax - 2, ay + 4);
      ctx.closePath();
      ctx.fillStyle = 'rgba(245,200,66,0.7)'; ctx.fill();
      ctx.restore();
    }

    ctx.restore();

    /* ---- Shaft extending out to the right with bearing pillow ---- */
    var shaftStart = cx + Rcore + 8;
    var shaftEnd = cx + Rout + 110;

    /* Bearing pillow housing */
    var bpX = cx + Rout - 5;
    ctx.fillStyle = '#3a4258';
    ctx.strokeStyle = '#1a1f2e'; ctx.lineWidth = 1.2;
    ctx.fillRect(bpX, cy - 16, 24, 32);
    ctx.strokeRect(bpX, cy - 16, 24, 32);
    /* Bearing inner ring */
    ctx.beginPath(); ctx.arc(bpX + 12, cy, 11, 0, Math.PI * 2);
    ctx.fillStyle = '#1a1f2e'; ctx.fill();
    ctx.beginPath(); ctx.arc(bpX + 12, cy, 8, 0, Math.PI * 2);
    ctx.strokeStyle = '#9aa5bf'; ctx.lineWidth = 1.5; ctx.stroke();
    /* Bearing balls */
    for (var bi = 0; bi < 6; bi++) {
      var ba = bi / 6 * Math.PI * 2 + rotorAngle * 0.5;
      ctx.beginPath();
      ctx.arc(bpX + 12 + Math.cos(ba) * 9.5, cy + Math.sin(ba) * 9.5, 1.5, 0, Math.PI * 2);
      ctx.fillStyle = '#d8dde6'; ctx.fill();
    }

    /* Shaft */
    var shGrad = ctx.createLinearGradient(0, cy - 9, 0, cy + 9);
    shGrad.addColorStop(0, '#a0a8b8');
    shGrad.addColorStop(0.5, '#dfe4ee');
    shGrad.addColorStop(1, '#6a7282');
    ctx.fillStyle = shGrad;
    ctx.fillRect(shaftStart, cy - 7, shaftEnd - shaftStart, 14);
    ctx.strokeStyle = '#2a2f3a'; ctx.lineWidth = 1;
    ctx.strokeRect(shaftStart, cy - 7, shaftEnd - shaftStart, 14);

    /* ---- Flywheel / load disc on the shaft ---- */
    var flyX = shaftEnd + 28, flyR = 30;
    /* Rotor angle reuse for flywheel rotation */
    ctx.save();
    ctx.translate(flyX, cy);
    ctx.rotate(rotorAngle);
    var flyGrad = ctx.createRadialGradient(-8, -8, 4, 0, 0, flyR);
    flyGrad.addColorStop(0, '#7a8398');
    flyGrad.addColorStop(0.7, '#4a5266');
    flyGrad.addColorStop(1, '#2a3142');
    ctx.beginPath(); ctx.arc(0, 0, flyR, 0, Math.PI * 2);
    ctx.fillStyle = flyGrad; ctx.fill();
    ctx.strokeStyle = '#1a1f2e'; ctx.lineWidth = 1.5; ctx.stroke();
    /* Spokes */
    ctx.strokeStyle = '#2a3142'; ctx.lineWidth = 1.5;
    for (var sp = 0; sp < 6; sp++) {
      var spa = sp / 6 * Math.PI * 2;
      ctx.beginPath();
      ctx.moveTo(Math.cos(spa) * 9,  Math.sin(spa) * 9);
      ctx.lineTo(Math.cos(spa) * (flyR - 6), Math.sin(spa) * (flyR - 6));
      ctx.stroke();
    }
    /* Hub */
    ctx.beginPath(); ctx.arc(0, 0, 9, 0, Math.PI * 2);
    ctx.fillStyle = '#3a4258'; ctx.fill();
    ctx.strokeStyle = '#1a1f2e'; ctx.lineWidth = 1; ctx.stroke();
    ctx.beginPath(); ctx.arc(0, 0, 4, 0, Math.PI * 2);
    ctx.fillStyle = '#1a1f2e'; ctx.fill();
    /* Load marker */
    ctx.beginPath();
    ctx.moveTo(flyR - 14, 0); ctx.lineTo(flyR - 8, -3); ctx.lineTo(flyR - 8, 3); ctx.closePath();
    ctx.fillStyle = loadTorque > 0.1 ? '#e91e63' : '#5a6172'; ctx.fill();
    ctx.restore();

    /* Flywheel label */
    ctx.font = 'bold 9px "Segoe UI", sans-serif';
    ctx.fillStyle = '#8b9dc3';
    ctx.textAlign = 'center'; ctx.textBaseline = 'top';
    ctx.fillText('Load (' + toTorqueD(loadTorque).toFixed(1) + ' ' + torqueLabel() + ')', flyX, cy + flyR + 6);

    /* ---- Commutator (segmented cylinder seen from end) at bottom ---- */
    var commCx = cx, commCy = cy + Rout + 36;
    var commR = 22;
    /* Commutator body */
    var commGrad = ctx.createRadialGradient(commCx - 6, commCy - 6, 4, commCx, commCy, commR);
    commGrad.addColorStop(0, '#ffc46b');
    commGrad.addColorStop(0.7, '#d28a2a');
    commGrad.addColorStop(1, '#7a4c10');
    ctx.beginPath(); ctx.arc(commCx, commCy, commR, 0, Math.PI * 2);
    ctx.fillStyle = commGrad; ctx.fill();
    ctx.strokeStyle = '#4a2e08'; ctx.lineWidth = 1.5; ctx.stroke();

    /* 8 commutator segments separated by mica */
    var nSeg = 8;
    ctx.save();
    ctx.translate(commCx, commCy);
    ctx.rotate(rotorAngle);
    ctx.strokeStyle = '#1a1308'; ctx.lineWidth = 1.2;
    for (var sg = 0; sg < nSeg; sg++) {
      var sga = sg / nSeg * Math.PI * 2;
      ctx.beginPath();
      ctx.moveTo(0, 0);
      ctx.lineTo(Math.cos(sga) * commR, Math.sin(sga) * commR);
      ctx.stroke();
    }
    /* Center boss */
    ctx.beginPath(); ctx.arc(0, 0, 4, 0, Math.PI * 2);
    ctx.fillStyle = '#7a4c10'; ctx.fill();
    ctx.restore();

    /* ---- Brushes with brush holders + leaf springs ---- */
    /* Left brush */
    var bx1 = commCx - commR - 26;
    var bx2 = commCx + commR + 4;
    /* Brush holder rectangles */
    ctx.fillStyle = '#3a4258'; ctx.strokeStyle = '#1a1f2e'; ctx.lineWidth = 1;
    ctx.fillRect(bx1, commCy - 7, 26, 14);
    ctx.strokeRect(bx1, commCy - 7, 26, 14);
    ctx.fillRect(bx2, commCy - 7, 26, 14);
    ctx.strokeRect(bx2, commCy - 7, 26, 14);
    /* Carbon brushes (touching commutator) */
    ctx.fillStyle = '#1a1f2e';
    ctx.fillRect(bx1 + 18, commCy - 5, 8, 10);
    ctx.fillRect(bx2,      commCy - 5, 8, 10);
    /* Leaf spring (zigzag) pressing brush in */
    ctx.strokeStyle = '#c0c0c0'; ctx.lineWidth = 1;
    [[bx1 + 2, +1], [bx2 + 24, -1]].forEach(function (br) {
      var bxs = br[0], dir = br[1];
      ctx.beginPath();
      ctx.moveTo(bxs, commCy);
      for (var z = 0; z < 4; z++) {
        ctx.lineTo(bxs + dir * (z + 1) * 4, commCy + ((z % 2) ? -3 : 3));
      }
      ctx.stroke();
    });

    /* ---- Supply terminal wires from terminal box to brushes ---- */
    /* + wire (red) */
    ctx.beginPath();
    ctx.moveTo(cx - 12, tbY + tbH);
    ctx.lineTo(cx - 12, tbY + tbH + 14);
    ctx.bezierCurveTo(cx - 12, tbY + tbH + 30, bx1 + 5, commCy - 60, bx1 + 5, commCy);
    ctx.strokeStyle = '#ff5555'; ctx.lineWidth = 2.5; ctx.lineCap = 'round'; ctx.stroke();
    /* − wire (blue) */
    ctx.beginPath();
    ctx.moveTo(cx + 12, tbY + tbH);
    ctx.lineTo(cx + 12, tbY + tbH + 14);
    ctx.bezierCurveTo(cx + 12, tbY + tbH + 30, bx2 + 21, commCy - 60, bx2 + 21, commCy);
    ctx.strokeStyle = '#42a5f5'; ctx.lineWidth = 2.5; ctx.lineCap = 'round'; ctx.stroke();

    /* +/- labels at terminal box */
    ctx.font = 'bold 11px "Segoe UI", sans-serif';
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.fillStyle = '#ff5555'; ctx.fillText('+', tbX + tbW * 0.3, tbY - 8);
    ctx.fillStyle = '#42a5f5'; ctx.fillText('−', tbX + tbW * 0.7, tbY - 8);

    /* ---- Floating value badges around the motor ---- */
    /* Eb badge top-left */
    drawValueBadge(20, 15, 'Eₐ', phys.Eb.toFixed(1) + ' V', '#ffa000');
    /* Ia badge below Eb */
    drawValueBadge(20, 45, 'Iₐ', phys.Ia.toFixed(2) + ' A', '#3ddc84');
    /* RPM badge top right above curve area */
    drawValueBadge(310, 15, 'N',  Math.round(phys.N) + ' RPM', '#42a5f5');
    /* phi badge bottom-left */
    drawValueBadge(20, H - 65, 'φ', phys.phiEff.toFixed(2) + ' Wb', '#90caf9');

    /* V supply badge under the terminal box */
    ctx.font = 'bold 12px "JetBrains Mono", "Courier New", monospace';
    ctx.fillStyle = '#f5c842'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.fillText('V = ' + supplyV.toFixed(0) + ' V', cx, tbY - 22);

    /* Motor type title with subtle backdrop */
    ctx.font = 'bold 13px "Segoe UI", sans-serif';
    var typeLabels = { shunt: 'DC Shunt Motor', series: 'DC Series Motor', separate: 'Separately Excited Motor' };
    var tlText = typeLabels[motorType];
    ctx.textAlign = 'left'; ctx.textBaseline = 'top';
    var twPad = 8;
    var tw = ctx.measureText(tlText).width + twPad * 2;
    ctx.fillStyle = 'rgba(233,30,99,0.18)';
    roundedRect(140, 6, tw, 22, 6); ctx.fill();
    ctx.fillStyle = '#f48fb1';
    ctx.fillText(tlText, 140 + twPad, 11);
  }

  function drawValueBadge(x, y, sym, val, color) {
    var padX = 6, padY = 4, gap = 5;
    ctx.font = 'bold 11px "Cambria Math", "Times New Roman", serif';
    var ws = ctx.measureText(sym).width;
    ctx.font = 'bold 11px "JetBrains Mono", "Courier New", monospace';
    var wv = ctx.measureText(val).width;
    var w = ws + gap + wv + padX * 2;
    var h = 20;
    /* backdrop */
    ctx.fillStyle = 'rgba(13,17,30,0.78)';
    ctx.strokeStyle = 'rgba(139,157,195,0.25)'; ctx.lineWidth = 1;
    roundedRect(x, y, w, h, 5); ctx.fill(); ctx.stroke();
    /* sym */
    ctx.font = 'italic bold 11px "Cambria Math", "Times New Roman", serif';
    ctx.fillStyle = color; ctx.textAlign = 'left'; ctx.textBaseline = 'middle';
    ctx.fillText(sym, x + padX, y + h / 2);
    /* = */
    ctx.font = 'bold 11px "JetBrains Mono", "Courier New", monospace';
    ctx.fillStyle = '#dde3f0';
    ctx.fillText('= ' + val, x + padX + ws + gap, y + h / 2);
  }

  function roundedRect(x, y, w, h, r) {
    ctx.beginPath();
    ctx.moveTo(x + r, y);
    ctx.lineTo(x + w - r, y);
    ctx.quadraticCurveTo(x + w, y, x + w, y + r);
    ctx.lineTo(x + w, y + h - r);
    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
    ctx.lineTo(x + r, y + h);
    ctx.quadraticCurveTo(x, y + h, x, y + h - r);
    ctx.lineTo(x, y + r);
    ctx.quadraticCurveTo(x, y, x + r, y);
    ctx.closePath();
  }

  /* --- Speed-torque curve ------------------------------------- */
  function drawSpeedTorqueCurve() {
    var ox = 460, oy = 40, cw = 400, ch = 380;
    var px = ox + 40, py = oy + 10;
    var pw = cw - 60, ph = ch - 60;

    ctx.fillStyle = 'rgba(15,20,32,0.6)';
    ctx.fillRect(ox, oy, cw, ch);
    ctx.strokeStyle = '#2a3050'; ctx.lineWidth = 1;
    ctx.strokeRect(ox, oy, cw, ch);

    ctx.font = 'bold 13px "Segoe UI", sans-serif';
    ctx.fillStyle = 'rgba(233,30,99,0.85)';
    ctx.textAlign = 'right'; ctx.textBaseline = 'top';
    ctx.fillText('Speed-Torque Characteristic', ox + cw - 10, oy + 6);

    ctx.beginPath();
    ctx.moveTo(px, py); ctx.lineTo(px, py + ph); ctx.lineTo(px + pw, py + ph);
    ctx.strokeStyle = '#8b9dc3'; ctx.lineWidth = 2; ctx.stroke();

    var torqueAxisLabel = 'Torque (' + torqueLabel() + ')';
    ctx.font = 'bold 11px "Segoe UI", sans-serif';
    ctx.fillStyle = '#8b9dc3';
    ctx.textAlign = 'center'; ctx.textBaseline = 'top';
    ctx.fillText(torqueAxisLabel, px + pw / 2, py + ph + 25);

    ctx.save();
    ctx.translate(px - 32, py + ph / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.fillText('Speed (RPM)', 0, 0);
    ctx.restore();

    var maxT_SI = Math.max(phys.Tstall * 1.1, 10);
    var maxN    = Math.max(phys.N0 * 1.1, 100);
    if (maxT_SI > 500) maxT_SI = 500;
    if (maxN > 6000) maxN = 6000;
    var maxT_D  = toTorqueD(maxT_SI);

    ctx.strokeStyle = 'rgba(42,48,80,0.6)'; ctx.lineWidth = 1;
    ctx.setLineDash([4, 4]);
    var numYGrid = 5;
    for (var yi = 0; yi <= numYGrid; yi++) {
      var yy = py + ph - (yi / numYGrid) * ph;
      var speedLabel = Math.round((yi / numYGrid) * maxN);
      ctx.beginPath(); ctx.moveTo(px, yy); ctx.lineTo(px + pw, yy); ctx.stroke();
      ctx.font = '10px "JetBrains Mono", "Courier New", monospace';
      ctx.fillStyle = '#8b9dc3'; ctx.textAlign = 'right'; ctx.textBaseline = 'middle';
      ctx.fillText(speedLabel, px - 5, yy);
    }
    var numXGrid = 5;
    for (var xi = 0; xi <= numXGrid; xi++) {
      var xx = px + (xi / numXGrid) * pw;
      var torqueLab = round1((xi / numXGrid) * maxT_D);
      ctx.beginPath(); ctx.moveTo(xx, py); ctx.lineTo(xx, py + ph); ctx.stroke();
      ctx.font = '10px "JetBrains Mono", "Courier New", monospace';
      ctx.fillStyle = '#8b9dc3'; ctx.textAlign = 'center'; ctx.textBaseline = 'top';
      ctx.fillText(torqueLab, xx, py + ph + 5);
    }
    ctx.setLineDash([]);

    /* Curve in SI then mapped to displayed-T axis */
    ctx.beginPath();
    var numPoints = 200;
    var firstPoint = true;
    for (var i = 0; i <= numPoints; i++) {
      var torque_SI = (i / numPoints) * maxT_SI;
      var speed;
      if (motorType === 'shunt' || motorType === 'separate') {
        if (phys.Tstall > 0) speed = phys.N0 - (phys.N0 / phys.Tstall) * torque_SI;
        else speed = 0;
        if (speed < 0) speed = 0;
      } else {
        var KmKf = phys.Kphi;
        if (KmKf < 0.0001 || torque_SI < 0.01) speed = maxN;
        else {
          var IaC = Math.sqrt(torque_SI / KmKf);
          if (IaC > phys.IaMax) IaC = phys.IaMax;
          var EbC = supplyV - IaC * Ra;
          if (EbC < 0) EbC = 0;
          if (IaC < 0.01) speed = maxN;
          else speed = EbC / (KmKf * IaC);
        }
        if (speed > maxN) speed = maxN;
        if (speed < 0) speed = 0;
      }
      var plotX = px + (torque_SI / maxT_SI) * pw;
      var plotY = py + ph - (speed / maxN) * ph;
      if (firstPoint) { ctx.moveTo(plotX, plotY); firstPoint = false; }
      else            ctx.lineTo(plotX, plotY);
    }
    ctx.strokeStyle = '#e91e63'; ctx.lineWidth = 3; ctx.lineCap = 'round'; ctx.lineJoin = 'round';
    ctx.stroke();
    ctx.strokeStyle = 'rgba(233,30,99,0.2)'; ctx.lineWidth = 8; ctx.stroke();

    /* Op point */
    var opT = phys.T, opN = phys.N;
    var opX = px + (opT / maxT_SI) * pw;
    var opY = py + ph - (opN / maxN) * ph;
    opX = clamp(opX, px, px + pw);
    opY = clamp(opY, py, py + ph);

    ctx.setLineDash([4, 4]);
    ctx.beginPath(); ctx.moveTo(opX, opY); ctx.lineTo(opX, py + ph);
    ctx.strokeStyle = 'rgba(233,30,99,0.5)'; ctx.lineWidth = 1; ctx.stroke();
    ctx.beginPath(); ctx.moveTo(opX, opY); ctx.lineTo(px, opY); ctx.stroke();
    ctx.setLineDash([]);

    ctx.beginPath(); ctx.arc(opX, opY, 8, 0, Math.PI * 2);
    ctx.fillStyle = 'rgba(233,30,99,0.3)'; ctx.fill();
    ctx.beginPath(); ctx.arc(opX, opY, 5, 0, Math.PI * 2);
    ctx.fillStyle = '#e91e63'; ctx.fill();
    ctx.beginPath(); ctx.arc(opX, opY, 3, 0, Math.PI * 2);
    ctx.fillStyle = '#fff'; ctx.fill();

    ctx.font = 'bold 10px "JetBrains Mono", "Courier New", monospace';
    ctx.fillStyle = '#e91e63';
    ctx.textAlign = 'left'; ctx.textBaseline = 'bottom';
    var lx = opX + 12, ly = opY - 8;
    if (lx + 110 > px + pw) lx = opX - 110;
    if (ly < py + 20)       ly = opY + 18;
    var opLabel = '(' + toTorqueD(opT).toFixed(isImp() ? 2 : 1) + ' ' + torqueLabel() + ', ' + Math.round(opN) + ' RPM)';
    ctx.fillText(opLabel, lx, ly);

    /* N0 + Tstall ticks */
    var n0Y = py + ph - (Math.min(phys.N0, maxN) / maxN) * ph;
    ctx.beginPath(); ctx.moveTo(px - 6, n0Y); ctx.lineTo(px + 6, n0Y);
    ctx.strokeStyle = '#42a5f5'; ctx.lineWidth = 3; ctx.stroke();
    ctx.font = 'bold 9px "Segoe UI", sans-serif';
    ctx.fillStyle = '#42a5f5'; ctx.textAlign = 'right'; ctx.textBaseline = 'middle';
    if (phys.N0 <= maxN) ctx.fillText('N₀', px - 10, n0Y);

    var tsX = px + (Math.min(phys.Tstall, maxT_SI) / maxT_SI) * pw;
    ctx.beginPath(); ctx.moveTo(tsX, py + ph - 6); ctx.lineTo(tsX, py + ph + 6);
    ctx.strokeStyle = '#ff5555'; ctx.lineWidth = 3; ctx.stroke();
    ctx.font = 'bold 9px "Segoe UI", sans-serif';
    ctx.fillStyle = '#ff5555'; ctx.textAlign = 'center'; ctx.textBaseline = 'top';
    if (phys.Tstall <= maxT_SI) ctx.fillText('Tₛ', tsX, py + ph + 10);
  }

