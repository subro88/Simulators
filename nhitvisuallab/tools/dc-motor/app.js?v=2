  function snapState() {
    return {
      type: motorType, V: supplyV, Ra: Ra, phi: fieldFlux, Tload: loadTorque, Vf: Vfield,
      ss: showSchematic, sc: showCurve, se: showEquation, sg: showGrid
    };
  }
  function loadState(s) {
    if (!s) return;
    motorType = s.type || 'shunt';
    supplyV   = s.V; Ra = s.Ra; fieldFlux = s.phi; loadTorque = s.Tload;
    Vfield    = (s.Vf === undefined) ? supplyV : s.Vf;
    showSchematic = (s.ss === undefined) ? true  : !!s.ss;
    showCurve     = (s.sc === undefined) ? true  : !!s.sc;
    showEquation  = (s.se === undefined) ? true  : !!s.se;
    showGrid      = (s.sg === undefined) ? false : !!s.sg;
    syncMotorTabs(); syncToggleDOM(); syncSlidersFromState(); syncSteppersFromState();
    updateVfRow(); render();
  }
  function saveUndo() {
    undoStack.push(JSON.stringify(snapState()));
    if (undoStack.length > UNDO_MAX) undoStack.shift();
    redoStack = [];
    syncUndoBtns();
  }
  function doUndo() {
    if (undoStack.length === 0) return;
    redoStack.push(JSON.stringify(snapState()));
    var s = undoStack.pop();
    loadState(JSON.parse(s));
    syncUndoBtns();
  }
  function doRedo() {
    if (redoStack.length === 0) return;
    undoStack.push(JSON.stringify(snapState()));
    var s = redoStack.pop();
    loadState(JSON.parse(s));
    syncUndoBtns();
  }
  function syncUndoBtns() {
    btnUndo.disabled = undoStack.length === 0;
    btnRedo.disabled = redoStack.length === 0;
