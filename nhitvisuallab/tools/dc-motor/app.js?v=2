  function init() {
    /* Mode tabs */
    modeTabs.addEventListener('click', function (e) {
      if (!e.target.matches('.pill')) return;
      modeTabs.querySelectorAll('.pill').forEach(function (p) { p.classList.toggle('active', p === e.target); });
      switchMode(e.target.dataset.mode);
    });

    /* Unit tabs */
    unitTabs.addEventListener('click', function (e) {
      if (!e.target.matches('.pill')) return;
      unitTabs.querySelectorAll('.pill').forEach(function (p) { p.classList.toggle('active', p === e.target); });
      unitSys = e.target.dataset.unit;
      updateUnitLabels();
      syncSteppersFromState();
      _learnCache = { eq: '', pwr: '', coach: '' };
      render();
    });

    /* Motor type tabs */
    motorTabs.addEventListener('click', function (e) {
      if (!e.target.matches('.pill')) return;
      saveUndo();
      motorType = e.target.dataset.type;
      motorTabs.querySelectorAll('.pill').forEach(function (p) { p.classList.toggle('active', p === e.target); });
      clearPresetActive();
      updateVfRow();
      render();
    });

    /* Presets */
    buildPresets();

    /* Sliders + steppers */
    bindParam(vSlider, vInput, function () { return supplyV; }, function (v) { supplyV = v; }, { lo: 6, hi: 600, step: 1, digits: 0 });
    bindParam(raSlider, raInput, function () { return Ra; }, function (v) { Ra = v; }, { lo: 0.05, hi: 20, step: 0.1, digits: 2 });
    bindParam(fluxSlider, fluxInput, function () { return fieldFlux; }, function (v) { fieldFlux = v; }, { lo: 0.05, hi: 2, step: 0.05, digits: 2 });
    bindParam(tlSlider, tlInput, function () { return loadTorque; }, function (v) { loadTorque = v; }, {
      lo: 0, hi: 200, step: 1, digits: 1,
      displayFromSI: function (v) { return toTorqueD(v); },
      siFromDisplay: function (v) { return fromTorqueD(v); }
    });
    bindParam(vfSlider, vfInput, function () { return Vfield; }, function (v) { Vfield = v; }, { lo: 6, hi: 600, step: 1, digits: 0 });

    /* Toggle checkboxes */
    chkSchematic.addEventListener('change', function () { saveUndo(); showSchematic = this.checked; render(); });
    chkCurve.addEventListener('change',     function () { saveUndo(); showCurve     = this.checked; render(); });
    chkEquation.addEventListener('change',  function () { saveUndo(); showEquation  = this.checked; render(); });
    chkGrid.addEventListener('change',      function () { saveUndo(); showGrid      = this.checked; render(); });

    /* Explore category */
    catTabs.addEventListener('click', function (e) {
      if (!e.target.matches('.pill')) return;
      exploreCat = e.target.dataset.cat;
      catTabs.querySelectorAll('.pill').forEach(function (p) { p.classList.toggle('active', p === e.target); });
      buildConceptGrid();
      itemInfo.style.display = 'none';
      selectedConcept = null;
      clearCanvas();
      ctx.font = 'bold 18px "Segoe UI", sans-serif';
      ctx.fillStyle = 'rgba(233,30,99,0.6)';
      ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.fillText('Select a concept to explore', W / 2, H / 2);
    });

    /* Practice */
    ppCheck.addEventListener('click', function () {
      if (pAnswered) return;
      var val = parseFloat(ppInput.value);
      if (isNaN(val)) { ppInput.focus(); return; }
      pAnswered = true; pTotal++;
      var tol = curProblem.tol || 0.5;
      var correct = Math.abs(val - curProblem.answer) <= tol;
      if (correct) {
        pScore++;
        ppFeedback.textContent = 'Correct!';
        ppFeedback.className = 'feedback ok';
      } else {
        ppFeedback.textContent = 'Incorrect. Answer: ' + curProblem.answer + ' ' + curProblem.unit;
        ppFeedback.className = 'feedback err';
      }
      ppInput.disabled = true;
      ppCheck.style.display = 'none';
      ppNext.style.display = '';
      pbarScoreVal.textContent = pScore + ' / ' + pTotal;
      var solHtml = '<h4>Solution</h4>';
      curProblem.steps.forEach(function (s) { solHtml += '<p class="sol-step">' + s + '</p>'; });
      ppSolution.innerHTML = solHtml;
      ppSolution.style.display = '';
    });
    ppNext.addEventListener('click', newPracticeProblem);
    ppInput.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') { if (!pAnswered) ppCheck.click(); else ppNext.click(); }
    });

    /* Learn panel toggles */
    var allCards = document.querySelectorAll('.learn-card');
    learnExpand.addEventListener('click',   function () { allCards.forEach(function (c) { c.open = true; }); });
    learnCollapse.addEventListener('click', function () { allCards.forEach(function (c) { c.open = false; }); });

    /* Toolbar buttons */
    btnUndo.addEventListener('click', doUndo);
    btnRedo.addEventListener('click', doRedo);
    btnReset.addEventListener('click', resetAll);
    syncUndoBtns();

    /* Calc modal */
    btnCalc.addEventListener('click', openCalcModal);
    calcModalClose.addEventListener('click', closeCalcModal);
    calcModal.addEventListener('click', function (e) { if (e.target === calcModal) closeCalcModal(); });

    /* Exports */
    expCsv.addEventListener('click', exportCSV);
    expPng.addEventListener('click', exportPNG);

    /* Hint banner */
    if (localStorage.getItem('dc-motor-hint-dismissed') === '1') hintBar.style.display = 'none';
    hintClose.addEventListener('click', function () {
      hintBar.style.display = 'none';
      try { localStorage.setItem('dc-motor-hint-dismissed', '1'); } catch (e) {}
    });

    /* Context menu */
    cvs.addEventListener('contextmenu', function (e) {
      e.preventDefault();
      showCtxMenu(e.clientX, e.clientY);
    });
    document.addEventListener('click', function (e) {
      if (ctxMenu.style.display !== 'none' && !ctxMenu.contains(e.target)) hideCtxMenu();
    });
    ctxMenu.addEventListener('click', function (e) {
      var btn = e.target.closest('.ctx-item');
      if (!btn) return;
      var act = btn.dataset.action;
      hideCtxMenu();
      if (act === 'png') exportPNG();
      else if (act === 'csv') exportCSV();
      else if (act === 'copy') copyOperatingPoint();
      else if (act === 'grid') { saveUndo(); showGrid = !showGrid; chkGrid.checked = showGrid; render(); }
      else if (act === 'reset') resetAll();
    });

    /* Keyboard shortcuts */
    document.addEventListener('keydown', function (e) {
      if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
      if (e.key === 'Escape' && calcModal.classList.contains('active')) closeCalcModal();
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'z') {
        e.preventDefault();
        if (e.shiftKey) doRedo(); else doUndo();
      }
      if (e.key === 'r' || e.key === 'R') { e.preventDefault(); resetAll(); }
      if (e.key === 'u' || e.key === 'U') {
        e.preventDefault();
        var next = unitSys === 'si' ? 'imp' : 'si';
        unitTabs.querySelectorAll('.pill').forEach(function (p) { p.classList.toggle('active', p.dataset.unit === next); });
        unitSys = next;
        updateUnitLabels(); syncSteppersFromState();
        _learnCache = { eq: '', pwr: '', coach: '' };
        render();
      }
    });

    /* First-paint state — must run BEFORE resizeCanvas so phys is populated */
    updateUnitLabels();
    syncToggleDOM();
    syncSteppersFromState();
    updateVfRow();
    calcPhysics();
    updateReadouts();
    updateLearnPanels();

    /* Resize */
    resizeCanvas();
    window.addEventListener('resize', resizeCanvas);
    if (typeof ResizeObserver !== 'undefined') new ResizeObserver(resizeCanvas).observe(cvs);

    startAnim();
  }

  /* Defer init until DOMContentLoaded for KaTeX availability */
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();

})();
