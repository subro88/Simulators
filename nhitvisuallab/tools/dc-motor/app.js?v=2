  function animate() {
    var speedRad = (phys.N || 0) / 60 * 2 * Math.PI;
    rotorAngle += speedRad * 0.016;
    if (rotorAngle > Math.PI * 200) rotorAngle -= Math.PI * 200;
    render();
    animFrame = requestAnimationFrame(animate);
  }
  function startAnim() { if (!animFrame) animate(); }
  function stopAnim()  { if (animFrame) { cancelAnimationFrame(animFrame); animFrame = null; } }

