    ctx.strokeStyle = '#4a5578'; ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.rect(lx - r1 - 5, y - 20, (r1 + 5) * 2, fluidH + 45);
    ctx.stroke();
    ctx.beginPath();
    ctx.rect(rx - r2 - 5, y - 10, (r2 + 5) * 2, fluidH + 35);
    ctx.stroke();
