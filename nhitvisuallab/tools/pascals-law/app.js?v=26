  function resetSimulationPose() {
    if (anim.rafId) cancelAnimationFrame(anim.rafId);
    anim.rafId = 0;
    anim.running = false;
    anim.phase = 'idle';
    anim.stroke1Px = 0;
    anim.stroke2Px = 0;
