    /* Keep the number-input constraints in DISPLAY units, else Imperial
       values above the SI bounds (e.g. 200 ft/s) are flagged invalid. */
    velInput.min = u.isImp ? Math.floor(u.velFromSI(5)) : 5;
    velInput.max = u.isImp ? Math.ceil(u.velFromSI(100)) : 100;
    velInput.step = u.isImp ? 0.1 : 1;
    heightInput.max = u.isImp ? Math.ceil(u.lenFromSI(50)) : 50;
