    if (localStorage.getItem('pm_hint_dismissed') === '1') canvasHint.classList.add('hidden');
  } catch (e) { /* ignore */ }

  /* ================================================================
     KEYBOARD
     ================================================================ */
  document.addEventListener('keydown', function (e) {
    var inField = e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA');
    /* Undo/Redo work in any mode — but never steal Ctrl+Z from a text field */
    if ((e.ctrlKey || e.metaKey) && (e.key === 'z' || e.key === 'Z')) {
      if (inField) return;
      if (e.shiftKey) { redo(); } else { undo(); }
      e.preventDefault(); return;
    }
    if (e.key === 'Escape') {
      var modal = $('calc-modal');
      if (modal && modal.classList.contains('active')) { closeCalcModal(); return; }
      ctxMenu.classList.remove('active');
    }
    if (mode !== 'simulate') return;
    if (inField) return;
    switch (e.key) {
      case ' ':
      case 'Enter':
        e.preventDefault(); if (!animating) btnFire.click(); break;
      case 'r': case 'R': e.preventDefault(); btnReset.click(); break;
      case 'ArrowUp':    e.preventDefault(); stepValue('angle', 1); break;
      case 'ArrowDown':  e.preventDefault(); stepValue('angle', -1); break;
      case 'ArrowRight': e.preventDefault(); stepValue('vel', 1); break;
      case 'ArrowLeft':  e.preventDefault(); stepValue('vel', -1); break;
    }
  });

