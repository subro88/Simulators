     ================================================================ */
  function snapshot() {
    if (suppressSnapshot) return;
    undoStack.push({ a: simAngle, v: simVel, h: simH, g: simG, air: airRes });
    if (undoStack.length > MAX_UNDO) undoStack.shift();
    redoStack.length = 0;
    updateUndoButtons();
  }
  function applyState(s) {
    stopAnimation();   /* an in-flight tick would overwrite the restored readouts */
    suppressSnapshot = true;
    simAngle = s.a; simVel = s.v; simH = s.h; simG = s.g; airRes = !!s.air;
    syncInputsFromState();
    updateReadoutsStatic(); draw(); updateLearnPanels();
    suppressSnapshot = false;
    updateUndoButtons();
  }
  function undo() {
    if (!undoStack.length) return;
    redoStack.push({ a: simAngle, v: simVel, h: simH, g: simG, air: airRes });
    applyState(undoStack.pop());
  }
  function redo() {
    if (!redoStack.length) return;
    undoStack.push({ a: simAngle, v: simVel, h: simH, g: simG, air: airRes });
    applyState(redoStack.pop());
  }
  function updateUndoButtons() {
    btnUndo.disabled = undoStack.length === 0;
    btnRedo.disabled = redoStack.length === 0;
