    chkAir.checked = airRes;
    var at = $('air-toggle'); if (at) at.classList.toggle('checked', airRes);
    document.querySelectorAll('#gravity-tabs .pill').forEach(function (p) {
      p.classList.toggle('active', Math.abs(parseFloat(p.dataset.g) - simG) < 0.001);
    });
    document.querySelectorAll('#unit-tabs .pill').forEach(function (p) {
      p.classList.toggle('active', p.dataset.unit === unitSystem);
    });
