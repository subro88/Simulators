  /* ================================================================
     SYNC INPUTS (sliders ↔ steppers ↔ unit toggle)
     ================================================================ */
  function syncInputsFromState() {
    var u = U();
    angleSlider.value = simAngle; angleInput.value = simAngle;
    velSlider.value = simVel;
    velInput.value = +u.velFromSI(simVel).toFixed(u.isImp ? 1 : 0);
