  /* ================================================================
     CANVAS POINTER (drag to aim)
     ================================================================ */
  var dragging = false; var aimSnapshotted = false;
  cvs.addEventListener('pointerdown', function (e) {
    if (animating || e.button !== 0) return;
    dragging = true; aimSnapshotted = false;
    cvs.setPointerCapture(e.pointerId);
    handlePointerAim(e);
    dismissHint();
  });
  cvs.addEventListener('pointermove', function (e) {
    if (!dragging || animating) return;
    handlePointerAim(e);
  });
  cvs.addEventListener('pointerup', function () { dragging = false; aimSnapshotted = false; });
  cvs.addEventListener('pointercancel', function () { dragging = false; aimSnapshotted = false; });

  function handlePointerAim(e) {
    var rect = cvs.getBoundingClientRect();
    var scaleX = W / rect.width; var scaleY = H / rect.height;
    var mx = (e.clientX - rect.left) * scaleX;
    var my = (e.clientY - rect.top) * scaleY;
    var pts = trajectory.length ? trajectory : [{ x: 0, y: simH, vx: 0, vy: 0, t: 0 }];
    var scale = getScale(pts);
    var origin = toScreen(0, simH, scale);
    var dx = mx - origin.x; var dy = origin.y - my;
    if (dx < 5) dx = 5;
    var aimAngle = Math.round(rad2deg(Math.atan2(dy, dx)));
    aimAngle = clamp(aimAngle, 0, 90);
    var dist = Math.sqrt(dx * dx + dy * dy);
    var mappedVel = clamp(Math.round(dist / 3), 5, 100);
    if (!aimSnapshotted && (aimAngle !== simAngle || mappedVel !== simVel)) {
      snapshot(); aimSnapshotted = true;
    }
    simAngle = aimAngle; simVel = mappedVel;
    syncInputsFromState();
    if (!animating) { updateReadoutsStatic(); draw(); updateLearnPanels(); }
    drawAimLine(origin, mx, my);
  }
  function drawAimLine(origin, mx, my) {
    ctx.beginPath(); ctx.moveTo(origin.x, origin.y); ctx.lineTo(mx, my);
    ctx.strokeStyle = 'rgba(174,213,129,0.45)'; ctx.lineWidth = 2;
    ctx.setLineDash([8, 5]); ctx.stroke(); ctx.setLineDash([]);
    var angle = Math.atan2(my - origin.y, mx - origin.x);
    ctx.beginPath(); ctx.moveTo(mx, my);
    ctx.lineTo(mx - 10 * Math.cos(angle - 0.3), my - 10 * Math.sin(angle - 0.3));
    ctx.lineTo(mx - 10 * Math.cos(angle + 0.3), my - 10 * Math.sin(angle + 0.3));
    ctx.closePath(); ctx.fillStyle = 'rgba(174,213,129,0.55)'; ctx.fill();
  }

  /* ================================================================
     EXPORT — CSV & PNG
     ================================================================ */
  function exportCSV() {
    var pts = trajectory.length ? trajectory : computeTrajectory(simVel, simAngle, simH, simG, airRes).points;
    var u = U();
    var lines = ['# Projectile Motion Trajectory — MechSimulator',
                 '# v0=' + simVel + ' m/s, angle=' + simAngle + ' deg, h0=' + simH + ' m, g=' + simG + ' m/s^2, air=' + (airRes?'on':'off'),
                 '# Units: ' + (u.isImp ? 'Imperial (ft, ft/s)' : 'SI (m, m/s)'),
                 't_s,x_' + u.lenLabel + ',y_' + u.lenLabel + ',vx_' + u.velLabel + ',vy_' + u.velLabel];
    var stride = Math.max(1, Math.floor(pts.length / 500));
    for (var i = 0; i < pts.length; i += stride) {
      var p = pts[i];
      lines.push(p.t.toFixed(4) + ',' + u.lenFromSI(p.x).toFixed(4) + ',' + u.lenFromSI(p.y).toFixed(4) + ',' +
                 u.velFromSI(p.vx).toFixed(4) + ',' + u.velFromSI(p.vy).toFixed(4));
    }
    var blob = new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8' });
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a'); a.href = url;
    a.download = 'projectile-motion-' + simVel + 'mps-' + simAngle + 'deg.csv';
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }
  function exportPNG() {
    var a = document.createElement('a');
    a.href = cvs.toDataURL('image/png');
    a.download = 'projectile-motion-' + simVel + 'mps-' + simAngle + 'deg.png';
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
  }
