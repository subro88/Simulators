  /* ================================================================
     SHOW CALCULATIONS MODAL
     ================================================================ */
  function calcStep(num, title, formulaLatex, calculation, result) {
    var html = '<div class="cs-step">';
    html += '<div class="cs-step-hd"><span class="cs-num">Step ' + num + '</span><span class="cs-title">' + title + '</span></div>';
    if (formulaLatex) html += '<div class="cs-formula">' + formulaLatex + '</div>';
    if (calculation) html += '<div class="cs-calc">' + calculation.replace(/\n/g, '<br>') + '</div>';
    if (result != null) html += '<div class="cs-result">→ <strong>' + result + '</strong></div>';
    html += '</div>'; return html;
  }
  function buildCalcSteps() {
    var u = U();
    /* Work entirely in the displayed unit system. The kinematics are
       unit-agnostic once v, h and g are expressed consistently, so we
       convert the inputs up front and every result comes out in the
       chosen units. (g is an acceleration → scales like length.) */
    var v = u.velFromSI(simVel), theta = simAngle, h = u.lenFromSI(simH), g = u.accFromSI(simG);
    var L = u.lenLabel, V = u.velLabel, A = u.accLabel;
    var th = deg2rad(theta);
    var vx = v * Math.cos(th); var vy0 = v * Math.sin(th);
    var H_simple = (vy0 * vy0) / (2 * g);
    var H_total = h + H_simple;
    var disc = vy0 * vy0 + 2 * g * h;
    var T = (vy0 + Math.sqrt(disc)) / g;
    var R = vx * T;
    var vImpact = Math.sqrt(vx * vx + 2 * g * H_total);
    var nf = function (x) { return +x.toFixed(2); };   /* tidy number for the "given" line */

    var html = '<div class="cs-inputs"><span class="cs-badge">Given &mdash; Current Simulation State</span>';
    html += '<div class="cs-given">' +
      '<span>v = ' + nf(v) + ' ' + V + '</span>' +
      '<span>θ = ' + theta + '°</span>' +
      '<span>h = ' + nf(h) + ' ' + L + '</span>' +
      '<span>g = ' + nf(g) + ' ' + A + '</span>' +
      '<span>Air drag: ' + (airRes ? 'on' : 'off') + '</span>' +
      '</div><p class="cs-si-note">ℹ Computed in ' + (u.isImp ? 'Imperial (ft, ft/s)' : 'SI (m, m/s)') + ' units, matching the SI / Imperial toggle.</p></div>';

    html += calcStep(1, 'Decompose initial velocity',
      '\\(V_x = v\\cos\\theta, \\quad V_{y0} = v\\sin\\theta\\)',
      'V_x  = ' + nf(v) + ' × cos(' + theta + '°) = ' + vx.toFixed(3) + ' ' + V + '\n' +
      'V_y0 = ' + nf(v) + ' × sin(' + theta + '°) = ' + vy0.toFixed(3) + ' ' + V,
      'V_x = ' + vx.toFixed(2) + ' ' + V + ',  V_y0 = ' + vy0.toFixed(2) + ' ' + V);

    html += calcStep(2, 'Time to peak (V_y = 0)',
      '\\(t_p = V_{y0} / g\\)',
      't_p = ' + vy0.toFixed(3) + ' / ' + nf(g) + ' = ' + (vy0/g).toFixed(3) + ' s',
      't_p = ' + (vy0/g).toFixed(2) + ' s');

    html += calcStep(3, 'Maximum height above ground',
      '\\(H = h + \\dfrac{V_{y0}^{2}}{2g}\\)',
      'H = ' + nf(h) + ' + ' + (vy0*vy0).toFixed(2) + ' / ' + (2*g).toFixed(2) + '\n' +
      'H = ' + nf(h) + ' + ' + H_simple.toFixed(3) + ' ' + L,
      'H = ' + H_total.toFixed(2) + ' ' + L);

    html += calcStep(4, 'Time of flight (solve y = 0)',
      '\\(T = \\dfrac{V_{y0} + \\sqrt{V_{y0}^{2} + 2gh}}{g}\\)',
      'T = (' + vy0.toFixed(2) + ' + √(' + (vy0*vy0).toFixed(2) + ' + ' + (2*g*h).toFixed(2) + ')) / ' + nf(g) + '\n' +
      'T = (' + vy0.toFixed(2) + ' + ' + Math.sqrt(disc).toFixed(2) + ') / ' + nf(g),
      'T = ' + T.toFixed(2) + ' s');

    html += calcStep(5, 'Horizontal range',
      '\\(R = V_x \\cdot T\\)',
      'R = ' + vx.toFixed(3) + ' × ' + T.toFixed(3),
      'R = ' + R.toFixed(2) + ' ' + L);

    if (simH === 0) {
      html += calcStep(6, 'Range — closed form (ground launch)',
        '\\(R = \\dfrac{v^{2}\\,\\sin(2\\theta)}{g}\\)',
        'R = ' + nf(v*v) + ' × sin(' + (2*theta) + '°) / ' + nf(g) + '\n' +
        'R = ' + nf(v*v) + ' × ' + Math.sin(2*th).toFixed(4) + ' / ' + nf(g),
        'R = ' + R.toFixed(2) + ' ' + L);
    }

    html += calcStep(simH === 0 ? 7 : 6, 'Impact speed (energy conservation)',
      '\\(v_f = \\sqrt{v^{2} + 2gh}\\)',
      'v_f = √(' + nf(v*v) + ' + 2 × ' + nf(g) + ' × ' + nf(h) + ')\n' +
      'v_f = √' + (v*v + 2*g*h).toFixed(2),
      'v_f = ' + vImpact.toFixed(2) + ' ' + V);

    html += '<div class="cs-step"><div class="cs-step-hd"><span class="cs-num">Insight</span><span class="cs-title">Real-world context</span></div>' +
      '<div class="cs-result">' +
      (theta === 45 && h === 0 ? 'At 45° from ground level, the range is maximised: R_max = v² / g.' :
       theta < 45 ? 'A flatter (lower) launch is faster but loses range vs 45°.' :
       'A higher launch trades horizontal speed for time aloft.') +
      (airRes ? ' Air drag in the simulation shortens R and shifts optimum below 45°.' : ' Without drag, this is the textbook ideal.') +
      '</div></div>';

    return html;
  }

  function renderKaTeX(root) {
    if (typeof renderMathInElement === 'function') {
      try {
        renderMathInElement(root, {
          delimiters: [
            { left: '\\(', right: '\\)', display: false },
            { left: '\\[', right: '\\]', display: true }
          ],
          throwOnError: false
        });
      } catch (e) { /* ignore */ }
    }
  }
  function openCalcModal() {
    var modal = $('calc-modal'); var body = $('calc-modal-body');
    if (!modal || !body) return;
    body.innerHTML = buildCalcSteps();
    modal.classList.add('active');
    renderKaTeX(body);
    var cb = $('calc-modal-close'); if (cb) cb.focus();
    document.body.style.overflow = 'hidden';
  }
  function closeCalcModal() {
    var modal = $('calc-modal'); if (!modal) return;
    modal.classList.remove('active');
    document.body.style.overflow = '';
    var b = $('btn-calc'); if (b) b.focus();
  }
  $('btn-calc').addEventListener('click', openCalcModal);
  $('calc-modal-close').addEventListener('click', closeCalcModal);
  $('calc-modal').addEventListener('click', function (e) {
    if (e.target === $('calc-modal')) closeCalcModal();
  });

  /* ================================================================
     LEARNING PANELS
     ================================================================ */
  function updateLearnPanels() {
    var u = U();
    var L = u.lenLabel, V = u.velLabel;
    /* Display-unit values (kinematics are consistent once v, h, g share units) */
    var v = u.velFromSI(simVel), g = u.accFromSI(simG), h = u.lenFromSI(simH);
    var th = deg2rad(simAngle);
    var vx = v * Math.cos(th); var vy0 = v * Math.sin(th);
    var Hmax = h + (vy0*vy0)/(2*g);
    var T = (vy0 + Math.sqrt(vy0*vy0 + 2*g*h)) / g;
    var R = vx * T;   /* height-aware; equals v²sin(2θ)/g when h = 0 */
    var nf = function (x) { return +x.toFixed(2); };

    /* The classic closed form only holds for a ground-level launch; from
       a height, range must come from R = Vx·T with the elevated T. */
    var rangeLine = h > 0.001
      ? '<div class="eq-line"><div class="eq-label">Range (elevated launch)</div>\\(R = V_x\\,T = ' + vx.toFixed(2) + ' \\times ' + T.toFixed(2) + ' = ' + R.toFixed(2) + '\\;\\text{' + L + '}\\)</div>'
      : '<div class="eq-line"><div class="eq-label">Range</div>\\(R = \\dfrac{v^{2}\\sin(2\\theta)}{g} = \\dfrac{' + nf(v) + '^{2}\\,\\sin(' + (2*simAngle) + '^{\\circ})}{' + nf(g) + '} = ' + R.toFixed(2) + '\\;\\text{' + L + '}\\)</div>';

    var eqBody = $('lp-equations-body');
    if (eqBody) {
      eqBody.innerHTML =
        rangeLine +
        '<div class="eq-line"><div class="eq-label">Maximum height</div>\\(H = h + \\dfrac{v^{2}\\sin^{2}\\theta}{2g} = ' + nf(h) + ' + \\dfrac{' + nf(v) + '^{2}\\sin^{2}(' + simAngle + '^{\\circ})}{' + (2*g).toFixed(2) + '} = ' + Hmax.toFixed(2) + '\\;\\text{' + L + '}\\)</div>' +
        '<div class="eq-line"><div class="eq-label">Time of flight</div>\\(T = \\dfrac{v\\sin\\theta + \\sqrt{v^{2}\\sin^{2}\\theta + 2gh}}{g} = ' + T.toFixed(2) + '\\;\\text{s}\\)</div>';
      renderKaTeX(eqBody);
    }

    var compBody = $('lp-components-body');
    if (compBody) {
      compBody.innerHTML =
        '<div class="eq-line"><div class="eq-label">Horizontal component (constant in vacuum)</div>\\(V_x = v\\cos\\theta = ' + nf(v) + '\\cos(' + simAngle + '^{\\circ}) = ' + vx.toFixed(2) + '\\;\\text{' + V + '}\\)</div>' +
        '<div class="eq-line"><div class="eq-label">Initial vertical component</div>\\(V_{y0} = v\\sin\\theta = ' + nf(v) + '\\sin(' + simAngle + '^{\\circ}) = ' + vy0.toFixed(2) + '\\;\\text{' + V + '}\\)</div>' +
        '<div class="eq-line"><div class="eq-label">Vertical velocity over time</div>\\(V_y(t) = V_{y0} - gt\\)</div>';
      renderKaTeX(compBody);
    }

    var coachBody = $('lp-coach-body');
    if (coachBody) {
      var tips = [];
      if (simAngle === 45 && simH === 0) tips.push('<strong>Optimal:</strong> 45° from ground level maximises range &mdash; R = v²/g = ' + ((v*v)/g).toFixed(2) + ' ' + L + '.');
      else if (simAngle < 45) tips.push('<strong>Low angle:</strong> the trajectory is flat and fast. Try ' + (90 - simAngle) + '° &mdash; complementary angle gives the same range with a taller arc.');
      else if (simAngle > 45) tips.push('<strong>High angle:</strong> long flight time, lower range. Try ' + (90 - simAngle) + '° to compare.');
      if (simH > 0) tips.push('<strong>Elevated launch:</strong> from h = ' + nf(h) + ' ' + L + ' the projectile travels farther than a ground launch; optimum angle drops below 45°.');
      if (Math.abs(simG - 9.81) > 0.1) {
        var gE = u.accFromSI(9.81);
        var TE = (vy0 + Math.sqrt(vy0*vy0 + 2*gE*h)) / gE;
        var earthR = vx * TE;
        tips.push('<strong>Different gravity:</strong> on Earth (g = ' + nf(u.accFromSI(9.81)) + ' ' + u.accLabel + ') the same shot would travel ' + earthR.toFixed(1) + ' ' + L + ' vs ' + R.toFixed(1) + ' ' + L + ' here.');
      }
      if (airRes) tips.push('<strong>Air drag is on:</strong> measured range will be less than the closed-form R = v²sin(2θ)/g, and the descent is steeper than the ascent.');
      if (simVel >= 80) tips.push('<strong>High speed:</strong> at v = ' + nf(v) + ' ' + V + ' drag effects become significant; toggle Air Resistance to compare.');
      if (!tips.length) tips.push('Adjust angle, velocity or height to see contextual insights.');
      coachBody.innerHTML = tips.map(function (t) { return '<div class="coach-tip">' + t + '</div>'; }).join('');
    }
  }

  function wireLearnPanels() {
    var expAll = $('learn-expand-all'), colAll = $('learn-collapse-all');
