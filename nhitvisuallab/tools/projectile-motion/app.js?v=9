  function dismissHint() {
    if (!canvasHint) return;
    canvasHint.classList.add('hidden');
    try { localStorage.setItem('pm_hint_dismissed', '1'); } catch (e) { /* ignore */ }
  }
  $('hint-close').addEventListener('click', dismissHint);
