  /* Atmospheric density by planet (kg/m³). Moon ≈ vacuum, Mars is thin. */
  function airDensityFor(g) {
    if (Math.abs(g - 1.62) < 0.1) return 0;       // Moon — no atmosphere
    if (Math.abs(g - 3.72) < 0.1) return 0.020;   // Mars — ~1.6% of Earth's
    return 1.225;                                  // Earth (sea level)
  }

  function computeTrajectory(v0, angleDeg, h0, g, drag) {
    var th = deg2rad(angleDeg);
    var vx = v0 * Math.cos(th);
    var vy = v0 * Math.sin(th);
    var dt = 0.005;
    var x = 0, y = h0;
    var points = [{ x: x, y: y, vx: vx, vy: vy, t: 0 }];
    var t = 0;
    var maxY = y;
    var Cd = 0.47, rho = airDensityFor(g), radius = 0.05, A = Math.PI * radius * radius, mass = 0.5;

    for (var i = 0; i < 100000; i++) {
      t += dt;
      if (drag) {
        var speed = Math.sqrt(vx * vx + vy * vy);
        if (speed < 1e-6) speed = 1e-6;
        var Fd = 0.5 * Cd * rho * A * speed * speed;
        var ax = -(Fd / mass) * (vx / speed);
        var ay = -g - (Fd / mass) * (vy / speed);
        vx += ax * dt; vy += ay * dt;
      } else {
        vy -= g * dt;
      }
      x += vx * dt; y += vy * dt;
      if (y > maxY) maxY = y;
      points.push({ x: x, y: y, vx: vx, vy: vy, t: t });
      if (y <= 0 && t > 0.01) {
        var prev = points[points.length - 2];
        var frac = prev.y / (prev.y - y);
        var gx = prev.x + (x - prev.x) * frac;
        var gt = prev.t + (t - prev.t) * frac;
        var gvx = prev.vx + (vx - prev.vx) * frac;
        var gvy = prev.vy + (vy - prev.vy) * frac;
        points[points.length - 1] = { x: gx, y: 0, vx: gvx, vy: gvy, t: gt };
        break;
      }
    }
    var last = points[points.length - 1];
    return { points: points, range: last.x, maxH: maxY, time: last.t, vImpact: Math.sqrt(last.vx*last.vx + last.vy*last.vy) };
  }

  function analyticalCalc(v0, angleDeg, h0, g) {
    var th = deg2rad(angleDeg);
    var vx = v0 * Math.cos(th);
    var vy0 = v0 * Math.sin(th);
    var maxH = h0 + (vy0 * vy0) / (2 * g);
    var disc = vy0 * vy0 + 2 * g * h0;
    var T = (vy0 + Math.sqrt(Math.max(0, disc))) / g;
    var R = vx * T;
    var vyf = -Math.sqrt(Math.max(0, disc));
    var vImpact = Math.sqrt(vx * vx + vyf * vyf);
    return { range: R, maxH: maxH, time: T, vImpact: vImpact };
  }

  /* ================================================================
     DRAWING
     ================================================================ */
  var MARGIN = { left: 60, right: 30, top: 30, bottom: 60 };
  var plotW = W - MARGIN.left - MARGIN.right;
  var plotH = H - MARGIN.top - MARGIN.bottom;

  function getScale(traj) {
    var maxX = 10, maxY = 10;
    for (var i = 0; i < traj.length; i++) {
      if (traj[i].x > maxX) maxX = traj[i].x;
      if (traj[i].y > maxY) maxY = traj[i].y;
    }
    if (showGhosts) {
      for (var gi = 0; gi < ghostTrails.length; gi++) {
        var gt = ghostTrails[gi];
        for (var j = 0; j < gt.length; j++) {
          if (gt[j].x > maxX) maxX = gt[j].x;
          if (gt[j].y > maxY) maxY = gt[j].y;
        }
      }
    }
    maxX *= 1.15; maxY *= 1.15;
    /* Equal aspect ratio: same metres-per-pixel on both axes so launch
       angles render true (a 45° shot looks like 45°). The non-limiting
       axis simply shows extra empty space. */
    var s = Math.min(plotW / maxX, plotH / maxY);
    return { sx: s, sy: s, maxX: plotW / s, maxY: plotH / s };
  }

  function toScreen(px, py, scale) {
    return { x: MARGIN.left + px * scale.sx, y: H - MARGIN.bottom - py * scale.sy };
  }

  function niceStep(max, targetTicks) {
    var rough = max / targetTicks;
    var pow10 = Math.pow(10, Math.floor(Math.log10(rough)));
    var frac = rough / pow10;
    var nice;
    if (frac <= 1.5) nice = 1;
    else if (frac <= 3.5) nice = 2;
    else if (frac <= 7.5) nice = 5;
    else nice = 10;
    return nice * pow10 || 1;
  }

  function drawGrid(scale) {
    if (!showGrid) {
      /* still draw axis labels */
      ctx.fillStyle = '#6b7a99';
      ctx.font = '11px Segoe UI, sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('Horizontal Distance (' + U().lenLabel + ')', W / 2, H - 10);
      ctx.save(); ctx.translate(14, H / 2); ctx.rotate(-Math.PI / 2);
      ctx.fillText('Height (' + U().lenLabel + ')', 0, 0); ctx.restore();
      return;
    }
    var u = U();
    ctx.strokeStyle = 'rgba(42,48,80,0.5)';
    ctx.lineWidth = 0.5;
    ctx.font = '10px Courier New';
    ctx.fillStyle = '#6b7a99';
    ctx.textAlign = 'center';

    var stepX = niceStep(scale.maxX, 8);
    for (var gx = 0; gx <= scale.maxX; gx += stepX) {
      var sx = toScreen(gx, 0, scale);
      ctx.beginPath(); ctx.moveTo(sx.x, MARGIN.top); ctx.lineTo(sx.x, H - MARGIN.bottom); ctx.stroke();
      var dispX = u.lenFromSI(gx);
      ctx.fillText(dispX.toFixed(dispX >= 100 ? 0 : 1) + ' ' + u.lenLabel, sx.x, H - MARGIN.bottom + 16);
    }
    ctx.textAlign = 'right';
    var stepY = niceStep(scale.maxY, 6);
    for (var gy = 0; gy <= scale.maxY; gy += stepY) {
      var sy = toScreen(0, gy, scale);
      ctx.beginPath(); ctx.moveTo(MARGIN.left, sy.y); ctx.lineTo(W - MARGIN.right, sy.y); ctx.stroke();
      var dispY = u.lenFromSI(gy);
      ctx.fillText(dispY.toFixed(dispY >= 100 ? 0 : 1) + ' ' + u.lenLabel, MARGIN.left - 6, sy.y + 3);
    }
    ctx.fillStyle = '#6b7a99';
    ctx.font = '11px Segoe UI, sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText('Horizontal Distance (' + u.lenLabel + ')', W / 2, H - 10);
    ctx.save(); ctx.translate(14, H / 2); ctx.rotate(-Math.PI / 2);
    ctx.fillText('Height (' + u.lenLabel + ')', 0, 0); ctx.restore();
  }

  function drawTrail(pts, endIdx, scale, color, width) {
    if (endIdx < 2) return;
    ctx.beginPath();
    var s0 = toScreen(pts[0].x, pts[0].y, scale);
    ctx.moveTo(s0.x, s0.y);
    for (var i = 1; i < endIdx && i < pts.length; i++) {
      var sp = toScreen(pts[i].x, pts[i].y, scale);
      ctx.lineTo(sp.x, sp.y);
    }
    ctx.strokeStyle = color; ctx.lineWidth = width;
    ctx.setLineDash([6, 4]); ctx.stroke(); ctx.setLineDash([]);
  }

  function drawVelocityArrows(screenPos, point) {
    if (!showVectors) return;
    var u = U();
    var arrowScale = 1.8;
    if (Math.abs(point.vx) > 0.5) {
      var vxLen = point.vx * arrowScale;
      if (Math.abs(vxLen) > 80) vxLen = 80 * Math.sign(vxLen);
      ctx.beginPath(); ctx.moveTo(screenPos.x, screenPos.y); ctx.lineTo(screenPos.x + vxLen, screenPos.y);
      ctx.strokeStyle = '#aed581'; ctx.lineWidth = 2; ctx.stroke();
      var dir = Math.sign(vxLen);
      ctx.beginPath();
      ctx.moveTo(screenPos.x + vxLen, screenPos.y);
      ctx.lineTo(screenPos.x + vxLen - 6 * dir, screenPos.y - 4);
      ctx.lineTo(screenPos.x + vxLen - 6 * dir, screenPos.y + 4);
      ctx.closePath(); ctx.fillStyle = '#aed581'; ctx.fill();
      ctx.font = '10px Courier New'; ctx.fillStyle = '#aed581'; ctx.textAlign = 'center';
      ctx.fillText('Vx=' + u.velFromSI(Math.abs(point.vx)).toFixed(1), screenPos.x + vxLen / 2, screenPos.y + 16);
    }
    if (Math.abs(point.vy) > 0.5) {
      var vyLen = -point.vy * arrowScale;
      if (Math.abs(vyLen) > 80) vyLen = 80 * Math.sign(vyLen);
      ctx.beginPath(); ctx.moveTo(screenPos.x, screenPos.y); ctx.lineTo(screenPos.x, screenPos.y + vyLen);
      ctx.strokeStyle = '#4fc3f7'; ctx.lineWidth = 2; ctx.stroke();
      var diry = Math.sign(vyLen);
      ctx.beginPath();
      ctx.moveTo(screenPos.x, screenPos.y + vyLen);
      ctx.lineTo(screenPos.x - 4, screenPos.y + vyLen - 6 * diry);
      ctx.lineTo(screenPos.x + 4, screenPos.y + vyLen - 6 * diry);
      ctx.closePath(); ctx.fillStyle = '#4fc3f7'; ctx.fill();
      ctx.font = '10px Courier New'; ctx.fillStyle = '#4fc3f7'; ctx.textAlign = 'left';
      ctx.fillText('Vy=' + u.velFromSI(point.vy).toFixed(1), screenPos.x + 10, screenPos.y + vyLen / 2);
    }
  }

  function drawLaunchIndicator(scale) {
    var origin = toScreen(0, simH, scale);
    ctx.beginPath(); ctx.arc(origin.x, origin.y, 5, 0, Math.PI * 2);
    ctx.fillStyle = '#7cb342'; ctx.fill();

    var arcR = 30;
    ctx.beginPath(); ctx.arc(origin.x, origin.y, arcR, 0, -deg2rad(simAngle), true);
    ctx.strokeStyle = '#aed581'; ctx.lineWidth = 1.5; ctx.stroke();

    var labelAngle = deg2rad(simAngle / 2);
    var lx = origin.x + (arcR + 12) * Math.cos(-labelAngle);
    var ly = origin.y + (arcR + 12) * Math.sin(-labelAngle);
    ctx.font = '11px Segoe UI, sans-serif'; ctx.fillStyle = '#aed581'; ctx.textAlign = 'center';
    ctx.fillText(simAngle + '°', lx, ly);

    var lineLen = 40;
    var lx2 = origin.x + lineLen * Math.cos(-deg2rad(simAngle));
    var ly2 = origin.y + lineLen * Math.sin(-deg2rad(simAngle));
    ctx.beginPath(); ctx.moveTo(origin.x, origin.y); ctx.lineTo(lx2, ly2);
    ctx.strokeStyle = 'rgba(174,213,129,0.6)'; ctx.lineWidth = 1.5;
    ctx.setLineDash([4, 3]); ctx.stroke(); ctx.setLineDash([]);
  }

  function drawGround(scale) {
    var ground = toScreen(0, 0, scale);
    ctx.beginPath(); ctx.moveTo(MARGIN.left, ground.y); ctx.lineTo(W - MARGIN.right, ground.y);
    ctx.strokeStyle = '#6b7a99'; ctx.lineWidth = 2; ctx.stroke();
    ctx.strokeStyle = 'rgba(58,69,104,0.6)'; ctx.lineWidth = 1;
    for (var hx = MARGIN.left; hx < W - MARGIN.right; hx += 12) {
      ctx.beginPath(); ctx.moveTo(hx, ground.y); ctx.lineTo(hx - 5, ground.y + 7); ctx.stroke();
    }
  }

  function drawInfoOverlay(point) {
    var u = U();
    ctx.fillStyle = 'rgba(22,27,39,0.88)'; ctx.strokeStyle = '#2a3050'; ctx.lineWidth = 1;
    var bx = W - 200, by = 70, bw = 190, bh = 85;   /* below the rotating planet icon */
    ctx.beginPath();
    if (ctx.roundRect) ctx.roundRect(bx, by, bw, bh, 8); else ctx.rect(bx, by, bw, bh);
    ctx.fill(); ctx.stroke();

    ctx.font = '11px Courier New'; ctx.fillStyle = '#7cb342'; ctx.textAlign = 'left';
    ctx.fillText('t = ' + point.t.toFixed(2) + ' s', bx + 10, by + 20);
    ctx.fillStyle = '#dde3f0';
    ctx.fillText('x = ' + u.lenFromSI(point.x).toFixed(2) + ' ' + u.lenLabel, bx + 10, by + 36);
    ctx.fillText('y = ' + u.lenFromSI(point.y).toFixed(2) + ' ' + u.lenLabel, bx + 10, by + 50);
    var speed = Math.sqrt(point.vx * point.vx + point.vy * point.vy);
    ctx.fillText('v = ' + u.velFromSI(speed).toFixed(2) + ' ' + u.velLabel, bx + 10, by + 64);
    ctx.fillStyle = '#6b7a99';
    ctx.fillText('Vx=' + u.velFromSI(point.vx).toFixed(1) + '  Vy=' + u.velFromSI(point.vy).toFixed(1), bx + 10, by + 78);
  }

  function drawGravityLabel() {
    var label = 'Earth';
    if (Math.abs(simG - 1.62) < 0.1) label = 'Moon';
    else if (Math.abs(simG - 3.72) < 0.1) label = 'Mars';
    var u = U();
    var gDisp = +u.accFromSI(simG).toFixed(2);
    ctx.font = '11px Segoe UI, sans-serif';
    ctx.fillStyle = 'rgba(107,122,153,0.7)';
    ctx.textAlign = 'center';
    ctx.fillText('g = ' + gDisp + ' ' + u.accLabel + ' (' + label + ')', W / 2, MARGIN.top + 14);
  }

  function drawAirResLabel() {
    if (!airRes) return;
    ctx.font = '10px Segoe UI, sans-serif';
    ctx.fillStyle = 'rgba(255,85,85,0.65)';
    ctx.textAlign = 'center';
    ctx.fillText('Air Resistance: ON', W / 2, MARGIN.top + 28);
  }

  function drawHeightOffset(scale) {
    if (simH <= 0) return;
    var origin = toScreen(0, simH, scale);
    var ground = toScreen(0, 0, scale);
    ctx.beginPath(); ctx.moveTo(origin.x - 15, origin.y); ctx.lineTo(origin.x - 15, ground.y);
    ctx.strokeStyle = 'rgba(79,195,247,0.45)'; ctx.lineWidth = 1;
    ctx.setLineDash([3, 3]); ctx.stroke(); ctx.setLineDash([]);
    ctx.fillStyle = 'rgba(79,195,247,0.6)';
    ctx.beginPath(); ctx.moveTo(origin.x - 15, origin.y); ctx.lineTo(origin.x - 18, origin.y + 5); ctx.lineTo(origin.x - 12, origin.y + 5); ctx.closePath(); ctx.fill();
    ctx.beginPath(); ctx.moveTo(origin.x - 15, ground.y); ctx.lineTo(origin.x - 18, ground.y - 5); ctx.lineTo(origin.x - 12, ground.y - 5); ctx.closePath(); ctx.fill();
    var u = U();
    ctx.font = '10px Courier New'; ctx.fillStyle = '#4fc3f7'; ctx.textAlign = 'right';
    ctx.fillText('h=' + u.lenFromSI(simH).toFixed(1) + u.lenLabel, origin.x - 20, (origin.y + ground.y) / 2 + 4);
  }

  function drawLandingMarker(scale) {
    if (!showMarkers || !simResult || !trajectory.length) return;
    var u = U();
    var last = trajectory[trajectory.length - 1];
    var ls = toScreen(last.x, last.y, scale);
    ctx.strokeStyle = 'rgba(124,179,66,0.7)'; ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.moveTo(ls.x - 8, ls.y); ctx.lineTo(ls.x + 8, ls.y);
    ctx.moveTo(ls.x, ls.y - 8); ctx.lineTo(ls.x, ls.y + 8); ctx.stroke();
    ctx.beginPath(); ctx.arc(ls.x, ls.y, 6, 0, Math.PI * 2);
    ctx.strokeStyle = 'rgba(124,179,66,0.5)'; ctx.lineWidth = 1; ctx.stroke();
    ctx.font = '10px Courier New'; ctx.fillStyle = '#7cb342'; ctx.textAlign = 'center';
    ctx.fillText(u.lenFromSI(last.x).toFixed(1) + ' ' + u.lenLabel, ls.x, ls.y + 20);
  }

  function drawMaxHeightIndicator(scale) {
    if (!showMarkers || !simResult || !trajectory.length) return;
    var u = U();
    var maxPt = trajectory[0];
    for (var i = 1; i < trajectory.length; i++) { if (trajectory[i].y > maxPt.y) maxPt = trajectory[i]; }
    var ms = toScreen(maxPt.x, maxPt.y, scale);
    var gs = toScreen(maxPt.x, 0, scale);
    ctx.beginPath(); ctx.moveTo(ms.x, ms.y); ctx.lineTo(ms.x, gs.y);
    ctx.strokeStyle = 'rgba(107,122,153,0.4)'; ctx.lineWidth = 1;
    ctx.setLineDash([3, 3]); ctx.stroke(); ctx.setLineDash([]);
    ctx.font = '10px Courier New'; ctx.fillStyle = '#6b7a99'; ctx.textAlign = 'left';
    ctx.fillText('H=' + u.lenFromSI(maxPt.y).toFixed(1) + u.lenLabel, ms.x + 6, ms.y + (gs.y - ms.y) / 2);
    ctx.beginPath();
    ctx.moveTo(ms.x, ms.y - 4); ctx.lineTo(ms.x + 4, ms.y); ctx.lineTo(ms.x, ms.y + 4); ctx.lineTo(ms.x - 4, ms.y);
    ctx.closePath(); ctx.fillStyle = 'rgba(245,200,66,0.7)'; ctx.fill();
  }

  function drawRangeArrow(scale) {
    if (!showMarkers || !simResult || !trajectory.length) return;
    var u = U();
    var last = trajectory[trajectory.length - 1];
    if (last.x < 1) return;
    var startS = toScreen(0, 0, scale); var endS = toScreen(last.x, 0, scale);
    var arrowY = startS.y + 18;
    ctx.beginPath(); ctx.moveTo(startS.x, arrowY); ctx.lineTo(endS.x, arrowY);
    ctx.strokeStyle = 'rgba(124,179,66,0.5)'; ctx.lineWidth = 1.2; ctx.stroke();
    ctx.fillStyle = 'rgba(124,179,66,0.5)';
    ctx.beginPath(); ctx.moveTo(startS.x, arrowY); ctx.lineTo(startS.x + 5, arrowY - 3); ctx.lineTo(startS.x + 5, arrowY + 3); ctx.closePath(); ctx.fill();
    ctx.beginPath(); ctx.moveTo(endS.x, arrowY); ctx.lineTo(endS.x - 5, arrowY - 3); ctx.lineTo(endS.x - 5, arrowY + 3); ctx.closePath(); ctx.fill();
    ctx.font = '11px Courier New'; ctx.fillStyle = '#7cb342'; ctx.textAlign = 'center';
    ctx.fillText('R = ' + u.lenFromSI(last.x).toFixed(1) + ' ' + u.lenLabel, (startS.x + endS.x) / 2, arrowY + 14);
  }

  function drawGhostLabels(scale) {
    if (!showGhosts) return;
    var u = U();
    for (var i = 0; i < ghostTrails.length; i++) {
      var gt = ghostTrails[i];
      if (gt.length < 2) continue;
      var last = gt[gt.length - 1];
      var ls = toScreen(last.x, last.y, scale);
      ctx.font = '9px Courier New'; ctx.fillStyle = 'rgba(124,179,66,0.45)'; ctx.textAlign = 'center';
      ctx.fillText(u.lenFromSI(last.x).toFixed(1) + u.lenLabel, ls.x, ls.y - 8);
    }
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = '#0d1117'; ctx.fillRect(0, 0, W, H);

    var pts = trajectory.length ? trajectory : [{ x: 0, y: simH, vx: 0, vy: 0, t: 0 }];
    var scale = getScale(pts);

    drawGrid(scale);
    drawGravityLabel(); drawAirResLabel();
    drawHeightOffset(scale);

    if (showGhosts) {
      for (var gi = 0; gi < ghostTrails.length; gi++) {
        drawTrail(ghostTrails[gi], ghostTrails[gi].length, scale, 'rgba(124,179,66,0.18)', 1.5);
      }
      drawGhostLabels(scale);
    }

    if (trajectory.length > 1) {
      var endIdx = animating ? currentTrailIndex : trajectory.length;
      drawTrail(trajectory, endIdx, scale, 'rgba(124,179,66,0.55)', 2.5);

      if (endIdx > 2) {
        ctx.beginPath();
        var s0 = toScreen(trajectory[0].x, trajectory[0].y, scale);
        ctx.moveTo(s0.x, s0.y);
        for (var ti = 1; ti < endIdx && ti < trajectory.length; ti++) {
          var sp = toScreen(trajectory[ti].x, trajectory[ti].y, scale);
          ctx.lineTo(sp.x, sp.y);
        }
        ctx.strokeStyle = 'rgba(124,179,66,0.12)'; ctx.lineWidth = 8; ctx.stroke();
      }

      if (endIdx > 0 && endIdx <= trajectory.length) {
        var bp = trajectory[Math.min(endIdx - 1, trajectory.length - 1)];
        var bs = toScreen(bp.x, bp.y, scale);
        drawVelocityArrows(bs, bp);
        var groundY = toScreen(0, 0, scale).y;
        ctx.beginPath(); ctx.ellipse(bs.x, groundY, 5, 2, 0, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(0,0,0,0.25)'; ctx.fill();
        ctx.beginPath(); ctx.arc(bs.x, bs.y, 7, 0, Math.PI * 2);
        ctx.fillStyle = '#4caf50'; ctx.fill();
        ctx.strokeStyle = '#7cb342'; ctx.lineWidth = 2; ctx.stroke();
        ctx.beginPath(); ctx.arc(bs.x - 2, bs.y - 2, 2, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(255,255,255,0.35)'; ctx.fill();
      }
      if (!animating) {
        drawLandingMarker(scale); drawMaxHeightIndicator(scale); drawRangeArrow(scale);
      }
    }

    drawLaunchIndicator(scale);
    drawGround(scale);

    if (animating && currentTrailIndex > 0 && currentTrailIndex <= trajectory.length) {
      drawInfoOverlay(trajectory[Math.min(currentTrailIndex - 1, trajectory.length - 1)]);
    }

    ctx.font = '10px Segoe UI, sans-serif';
    ctx.fillStyle = 'rgba(107,122,153,0.3)';
    ctx.textAlign = 'right';
    ctx.fillText('MechSimulator', W - MARGIN.right - 5, H - 10);
  }

  /* ================================================================
     ANIMATION
     ================================================================ */
  function startAnimation() {
    if (animating) stopAnimation();
    var result = computeTrajectory(simVel, simAngle, simH, simG, airRes);
    trajectory = result.points; simResult = result;
    currentTrailIndex = 0; animating = true; animTime = 0; animDuration = result.time;
    btnFire.disabled = true;

    var startTs = null; var speedMult = Math.max(1, animDuration / 4);
    function tick(ts) {
      if (!animating) return;
      if (!startTs) startTs = ts;
      var elapsed = (ts - startTs) / 1000 * speedMult;
      animTime = Math.min(elapsed, animDuration);
      currentTrailIndex = 0;
      for (var i = 0; i < trajectory.length; i++) {
        if (trajectory[i].t <= animTime) currentTrailIndex = i + 1; else break;
      }
      if (currentTrailIndex > 0) updateReadoutsLive(trajectory[Math.min(currentTrailIndex - 1, trajectory.length - 1)]);
      draw();
      if (animTime >= animDuration) {
        animating = false; currentTrailIndex = trajectory.length;
        updateReadoutsFinal(simResult);
        btnFire.disabled = false; draw(); updateAriaLabel(); updateLearnPanels();
        return;
      }
      animFrame = requestAnimationFrame(tick);
    }
    animFrame = requestAnimationFrame(tick);
  }

  function stopAnimation() {
    animating = false;
    if (animFrame) cancelAnimationFrame(animFrame);
    animFrame = null; btnFire.disabled = false;
  }

  /* ================================================================
     READOUTS
     ================================================================ */
  function updateReadoutsLive(point) {
    var u = U();
    rRange.textContent  = u.lenFromSI(point.x).toFixed(2);
    rHeight.textContent = u.lenFromSI(point.y).toFixed(2);
    rTime.textContent   = point.t.toFixed(2);
    var spd = Math.sqrt(point.vx * point.vx + point.vy * point.vy);
    rImpact.textContent = u.velFromSI(spd).toFixed(2);
    rAngle.textContent  = simAngle;
    rVel.textContent    = u.velFromSI(simVel).toFixed(0);
    syncReadoutUnits();
  }

  function updateReadoutsFinal(result) {
    var u = U();
    rRange.textContent  = u.lenFromSI(result.range).toFixed(2);
    rHeight.textContent = u.lenFromSI(result.maxH).toFixed(2);
    rTime.textContent   = result.time.toFixed(2);
    rImpact.textContent = u.velFromSI(result.vImpact).toFixed(2);
    rAngle.textContent  = simAngle;
