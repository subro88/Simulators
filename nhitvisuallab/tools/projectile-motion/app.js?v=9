  /* Stepper buttons */
  function stepValue(target, dir) {
    var u = U();
    if (target === 'angle') {
      var newA = clamp(simAngle + dir, 0, 90);
      if (newA === simAngle) return;
      snapshot();
      simAngle = newA;
    } else if (target === 'vel') {
      /* step in display units: 1 m/s or 1 ft/s */
      var step = 1;
      var displayVel = u.velFromSI(simVel) + step * dir;
      var siVel = clamp(u.velToSI(displayVel), 5, 100);
      if (Math.abs(siVel - simVel) < 0.001) return;
      snapshot(); simVel = siVel;
    } else if (target === 'height') {
      var stepH = u.isImp ? 1 : 0.5;
      var displayH = u.lenFromSI(simH) + stepH * dir;
      var siH = clamp(u.lenToSI(displayH), 0, 50);
      if (Math.abs(siH - simH) < 0.001) return;
      snapshot(); simH = siH;
    }
    syncInputsFromState(); if (!animating) { updateReadoutsStatic(); draw(); updateLearnPanels(); }
  }
  document.querySelectorAll('.step-btn').forEach(function (b) {
    b.addEventListener('click', function () { stepValue(b.dataset.step, parseInt(b.dataset.dir, 10)); });
  });

  /* Stepper text inputs commit on change/blur */
  function commitStepperInput(target, raw) {
    var u = U();
    var val = parseFloat(raw);
    if (isNaN(val)) { syncInputsFromState(); return; }
    var changed = false;
    if (target === 'angle') {
      var newA = clamp(Math.round(val), 0, 90);
      if (newA !== simAngle) { snapshot(); simAngle = newA; changed = true; }
    } else if (target === 'vel') {
      var siV = clamp(u.velToSI(val), 5, 100);
      if (Math.abs(siV - simVel) > 0.001) { snapshot(); simVel = siV; changed = true; }
    } else if (target === 'height') {
      var siH = clamp(u.lenToSI(val), 0, 50);
      if (Math.abs(siH - simH) > 0.001) { snapshot(); simH = siH; changed = true; }
    }
    syncInputsFromState();
    if (changed && !animating) { updateReadoutsStatic(); draw(); updateLearnPanels(); }
  }
