  function updateAriaLabel() {
    var u = U();
    var label = 'Projectile motion simulator. ';
    if (simResult) {
      label += 'Range: ' + u.lenFromSI(simResult.range).toFixed(1) + ' ' + u.lenLabel + '. ';
      label += 'Max height: ' + u.lenFromSI(simResult.maxH).toFixed(1) + ' ' + u.lenLabel + '. ';
      label += 'Time of flight: ' + simResult.time.toFixed(2) + ' seconds. ';
    } else {
      label += 'Angle: ' + simAngle + ' degrees. ';
      label += 'Velocity: ' + u.velFromSI(simVel).toFixed(0) + ' ' + u.velLabel + '. ';
    }
    cvs.setAttribute('aria-label', label);
  }

