/* Stefan-Boltzmann Radiation Simulator — MechSimulator
   P = ε · σ · A · T⁴   (W)         σ = 5.67×10⁻⁸ W/(m²·K⁴)
   P_net = ε·σ·A·(T⁴ − T_amb⁴)
   Wien:   λ_peak (μm) = 2898 / T(K)
*/
(function () {
  'use strict';
  var $ = function (id) { return document.getElementById(id); };
  var SIGMA = 5.670374419e-8;

  var PRESETS = [
    { key: 'human',  name: 'Human Body',           T: 310,  eps: 0.98, A: 18000, tamb: 295 },   /* ~1.8 m² */
    { key: 'iron',   name: 'Hot Iron Rod',         T: 1000, eps: 0.85, A: 100,   tamb: 295 },
    { key: 'lava',   name: 'Lava',                 T: 1500, eps: 0.95, A: 200,   tamb: 295 },
    { key: 'bulb',   name: 'Bulb Filament',        T: 3000, eps: 0.40, A: 1,     tamb: 295 },
    { key: 'sun',    name: 'Sun Surface',          T: 5800, eps: 1.00, A: 100,   tamb: 0 },
    { key: 'red',    name: 'Red Giant Star',       T: 3500, eps: 1.00, A: 100,   tamb: 0 }
  ];

  var state = {
    mode: 'simulate',
    unit: 'si',
    T: 1500, eps: 0.90, A_cm2: 100, Tamb: 300,
    showGlow: true, showRays: true, showEquation: true, showSpectrum: true, showGrid: false,
    pp: { problem: null, score: 0, total: 0 },
    qz: { idx: 0, q: null, answers: [], started: false },
    history: [], redoStack: [],
    audioCtx: null, raf: 0,
    rayPhase: 0
  };

  var canvas = $('sim-canvas'); var ctx = canvas.getContext('2d');

  /* KaTeX renderer — render LaTeX delimiters \( \) and \[ \] inside an
     element. Safe to call before KaTeX loads (no-ops then) and re-callable
     (KaTeX won't double-render already-rendered nodes). */
  function renderMath(el) {
    if (!el || !window.renderMathInElement) return;
    try {
      window.renderMathInElement(el, {
        delimiters: [
          { left: '\\[', right: '\\]', display: true },
          { left: '\\(', right: '\\)', display: false }
        ],
        throwOnError: false,
        ignoredTags: ['script', 'noscript', 'style', 'textarea', 'pre']
      });
    } catch (e) { /* silent */ }
  }
  /* If KaTeX loads after first render, sweep panels once it arrives */
  function deferredKatexSweep() {
    if (window.renderMathInElement) {
      renderMath($('lp-eq-body'));
      renderMath($('calc-modal-body'));
      return;
    }
    setTimeout(deferredKatexSweep, 200);
  }

  function isImp() { return state.unit === 'imp'; }
  function uLabel(k) {
    var imp = isImp();
    switch (k) {
      case 'pow':  return imp ? 'BTU/hr' : 'W';
      case 'flux': return imp ? 'BTU/(hr·ft²)' : 'W/m²';
      case 'area': return imp ? 'in²' : 'cm²';
      case 'tempK': return 'K';
      case 'tempC': return imp ? '°F' : '°C';
    }
    return '';
  }
  function toD(v, k) {
    if (!isImp()) return v;
    switch (k) {
      case 'pow':  return v * 3.41214;
      case 'flux': return v * 0.317;
      case 'area': return v / 6.4516;
    }
    return v;
  }
  function fmt(v, dp) {
    if (!isFinite(v)) return '—';
    if (v === 0) return '0';
    var a = Math.abs(v);
    if (a >= 1e6) return (v / 1e6).toFixed(2) + 'M';
    if (a >= 1e4 || (a > 0 && a < 0.001)) return v.toExponential(2);
    if (dp == null) dp = a >= 1000 ? 0 : a >= 100 ? 1 : a >= 10 ? 2 : 3;
    return v.toFixed(dp);
  }
  function colorRegion(T) {
    if (T < 600) return 'Invisible (far-IR)';
    if (T < 800) return 'Invisible (near-IR)';
    if (T < 1100) return 'Dim red glow';
    if (T < 1500) return 'Cherry red';
    if (T < 2000) return 'Bright orange';
    if (T < 2700) return 'Yellow';
    if (T < 3500) return 'Yellow-white';
    if (T < 5000) return 'White';
    if (T < 7000) return 'White (sun-like)';
    if (T < 12000) return 'Blue-white';
    return 'Blue (very hot)';
  }

  function compute() {
    var A = state.A_cm2 / 1e4;       // cm² → m²
    var T4 = Math.pow(state.T, 4);
    var Ta4 = Math.pow(state.Tamb, 4);
    var P = state.eps * SIGMA * A * T4;
    var Pnet = state.eps * SIGMA * A * (T4 - Ta4);
    var flux = state.eps * SIGMA * T4;
    var lpeak = 2898 / state.T;       // μm
    var Tc = state.T - 273.15;
    var Tf = Tc * 1.8 + 32;
    var Pamb = state.eps * SIGMA * A * Ta4;
    var ratio = Pamb > 0 ? P / Pamb : Infinity;
    return { A_m2: A, P: P, Pnet: Pnet, flux: flux, lpeak: lpeak, Tc: Tc, Tf: Tf, ratio: ratio };
  }

  /* Audio */
  function getAudio() { if (!state.audioCtx) try { state.audioCtx = new (window.AudioContext || window.webkitAudioContext)(); } catch (e) { return null; } return state.audioCtx; }
  function playTone(f, d, t, v) { var ac = getAudio(); if (!ac) return; var o = ac.createOscillator(), g = ac.createGain(); o.type = t || 'sine'; o.frequency.value = f; g.gain.value = v || 0.05; o.connect(g); g.connect(ac.destination); o.start(); g.gain.exponentialRampToValueAtTime(0.0001, ac.currentTime + d); o.stop(ac.currentTime + d + 0.02); }
  function playClick() { playTone(700, 0.04, 'square', 0.04); }
  function playSuccess() { playTone(880, 0.12, 'sine', 0.08); setTimeout(function(){ playTone(1320, 0.16, 'sine', 0.08); }, 110); }
  function playError() { playTone(220, 0.22, 'sawtooth', 0.05); }

  /* ── Black-body color ───────────────────────────────────── */
  function bbColor(T) {
    /* Approximate sRGB color from temperature in Kelvin (Tanner Helland approximation) */
    var t = T / 100;
    var r, g, b;
    if (t <= 66) {
      r = 255;
      g = 99.4708 * Math.log(t) - 161.1196;
      if (t <= 19) b = 0;
      else b = 138.5177 * Math.log(t - 10) - 305.0448;
    } else {
      r = 329.6987 * Math.pow(t - 60, -0.1332);
      g = 288.1222 * Math.pow(t - 60, -0.0755);
      b = 255;
    }
    /* Below 600 K → very dim red barely visible; we tint towards dark */
    var dim = T < 800 ? Math.max(0.05, (T - 200) / 600) : 1;
    r = Math.max(0, Math.min(255, r)) * dim;
    g = Math.max(0, Math.min(255, g)) * dim;
    b = Math.max(0, Math.min(255, b)) * dim;
    return { r: Math.round(r), g: Math.round(g), b: Math.round(b) };
  }

  function rgbStr(c, a) { if (a == null) return 'rgb(' + c.r + ',' + c.g + ',' + c.b + ')'; return 'rgba(' + c.r + ',' + c.g + ',' + c.b + ',' + a + ')'; }

  /* Canvas drawing */
  function sizeCanvas() {
    var W = canvas.parentElement.clientWidth - 16;
    var H = Math.max(380, Math.min(W * 0.62, 480));
    var dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.style.width = W + 'px'; canvas.style.height = H + 'px';
    canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    return { W: W, H: H };
  }

  function draw() {
    var dim = sizeCanvas(); var W = dim.W, H = dim.H;
    var c = compute();
    /* Background: ambient color hint */
    ctx.fillStyle = '#0a0e18';
    ctx.fillRect(0, 0, W, H);
    if (state.showGrid) drawGrid(W, H);

    /* Body in centre */
    var cx = W / 2, cy = H / 2;
    var bodyR = 60;
    var col = bbColor(state.T);

    /* Glow halo */
    if (state.showGlow) {
      var glowR = bodyR + 80 + Math.min(60, state.T / 60);
      var grad = ctx.createRadialGradient(cx, cy, bodyR * 0.6, cx, cy, glowR);
      grad.addColorStop(0, rgbStr(col, 0.9));
      grad.addColorStop(0.4, rgbStr(col, 0.35));
      grad.addColorStop(1, rgbStr(col, 0));
      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, W, H);
    }

    /* Body */
    var bodyGrad = ctx.createRadialGradient(cx - bodyR * 0.3, cy - bodyR * 0.3, bodyR * 0.1, cx, cy, bodyR);
    var lighter = { r: Math.min(255, col.r + 40), g: Math.min(255, col.g + 40), b: Math.min(255, col.b + 40) };
    bodyGrad.addColorStop(0, rgbStr(lighter));
    bodyGrad.addColorStop(1, rgbStr(col));
    ctx.fillStyle = bodyGrad;
    ctx.beginPath();
    ctx.arc(cx, cy, bodyR, 0, Math.PI * 2);
    ctx.fill();
    /* Outline */
    ctx.strokeStyle = 'rgba(255,255,255,0.18)';
    ctx.lineWidth = 1.5;
    ctx.stroke();

    /* Rays */
    if (state.showRays) {
      state.rayPhase += 0.04;
      var nRays = Math.min(48, Math.max(8, Math.floor(Math.log10(c.P + 1) * 8)));
      var rayLen = bodyR + 30 + Math.min(80, Math.log10(c.P + 1) * 22);
      ctx.strokeStyle = rgbStr(col, 0.7);
      ctx.lineWidth = 1.6;
      for (var i = 0; i < nRays; i++) {
        var ang = (i / nRays) * Math.PI * 2 + state.rayPhase * 0.5;
        var phase = (state.rayPhase + i * 0.5) % 1;
        var inner = bodyR + 5 + phase * (rayLen - bodyR - 10);
        var outer = inner + 18;
        if (outer > rayLen + bodyR) continue;
        ctx.globalAlpha = 0.6 - phase * 0.5;
        ctx.beginPath();
        ctx.moveTo(cx + Math.cos(ang) * inner, cy + Math.sin(ang) * inner);
        ctx.lineTo(cx + Math.cos(ang) * outer, cy + Math.sin(ang) * outer);
        ctx.stroke();
      }
      ctx.globalAlpha = 1;
    }

    /* Body label */
    drawHaloText('T = ' + fmt(state.T, 0) + ' K', cx, cy - 4, '#fff', 14, 'center');
    drawHaloText('ε = ' + state.eps.toFixed(2), cx, cy + 14, '#dde3f0', 11, 'center');

    /* Spectrum strip at bottom */
    if (state.showSpectrum) drawSpectrum(W, H, c);

    /* Equation overlay */
    if (state.showEquation) drawEquation(W, H, c);

    /* Power readout big */
    drawHaloText('P = ' + fmt(toD(c.P, 'pow')) + ' ' + uLabel('pow'), cx, cy + bodyR + 50, rgbStr(col), 16, 'center');

    /* Ambient label */
    drawHaloText('T_amb = ' + state.Tamb + ' K', 12, H - 14, '#7fdbff', 10, 'left');

    /* Animate rays */
    state.raf = requestAnimationFrame(function () { state.raf = 0; if (state.showRays) draw(); });
  }

  function drawGrid(W, H) {
    ctx.strokeStyle = 'rgba(139,157,195,0.08)';
    ctx.lineWidth = 1;
    for (var x = 0; x < W; x += 30) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, H); ctx.stroke(); }
    for (var y = 0; y < H; y += 30) { ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(W, y); ctx.stroke(); }
  }

  function drawHaloText(txt, x, y, color, size, anchor) {
    ctx.save();
    ctx.font = '700 ' + size + 'px ' + (size <= 11 ? 'Courier New, monospace' : 'Segoe UI, sans-serif');
    ctx.textAlign = anchor || 'left';
    ctx.textBaseline = 'middle';
    ctx.lineWidth = 3;
    ctx.lineJoin = 'round';
    ctx.strokeStyle = 'rgba(8,12,22,0.92)';
    ctx.strokeText(txt, x, y);
    ctx.fillStyle = color;
    ctx.fillText(txt, x, y);
    ctx.restore();
  }

  function drawSpectrum(W, H, c) {
    /* Bottom strip showing visible-wavelength spectrum + λ_peak marker */
    var sx = 30, sw = W - 60, sy = H - 50, sh = 14;
    /* Visible band 380-780 nm — map to the strip; extend a bit on either side */
    var minNm = 200, maxNm = 1500;
    /* Draw colored bands */
    for (var px = 0; px < sw; px++) {
      var nm = minNm + (px / sw) * (maxNm - minNm);
      var col = wavelengthColor(nm);
      ctx.fillStyle = rgbStr(col);
      ctx.fillRect(sx + px, sy, 1, sh);
    }
    /* Outline */
    ctx.strokeStyle = 'rgba(255,255,255,0.3)';
    ctx.lineWidth = 1;
    ctx.strokeRect(sx, sy, sw, sh);
    /* λ_peak marker */
    var peakNm = c.lpeak * 1000;
    if (peakNm >= minNm && peakNm <= maxNm) {
      var lx = sx + (peakNm - minNm) / (maxNm - minNm) * sw;
      ctx.strokeStyle = '#fff';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(lx, sy - 4); ctx.lineTo(lx, sy + sh + 4);
      ctx.stroke();
      drawHaloText('λ_peak = ' + c.lpeak.toFixed(2) + ' μm', lx, sy - 12, '#fff', 10, 'center');
    } else if (peakNm < minNm) {
      drawHaloText('λ_peak = ' + c.lpeak.toFixed(2) + ' μm (UV)', sx + 4, sy - 12, '#bb88ff', 10, 'left');
    } else {
      drawHaloText('λ_peak = ' + c.lpeak.toFixed(2) + ' μm (IR)', sx + sw - 4, sy - 12, '#ff8866', 10, 'right');
    }
    /* Tick marks */
    drawHaloText('200 nm', sx, sy + sh + 14, '#8b9dc3', 9, 'left');
    drawHaloText('400', sx + ((400 - minNm) / (maxNm - minNm)) * sw, sy + sh + 14, '#8b9dc3', 9, 'center');
    drawHaloText('700', sx + ((700 - minNm) / (maxNm - minNm)) * sw, sy + sh + 14, '#8b9dc3', 9, 'center');
    drawHaloText('1500', sx + sw, sy + sh + 14, '#8b9dc3', 9, 'right');
  }

  function wavelengthColor(nm) {
    /* Approximate sRGB for 380-780 nm */
    var r = 0, g = 0, b = 0, alpha = 1;
    if (nm < 380) { r = 80; g = 0; b = 100; }
    else if (nm < 440) { r = (440 - nm) / (440 - 380) * 0.9 + 0.1; g = 0; b = 1; r *= 255; b *= 255; }
    else if (nm < 490) { r = 0; g = (nm - 440) / (490 - 440); b = 1; g *= 255; b *= 255; }
    else if (nm < 510) { r = 0; g = 1; b = (510 - nm) / (510 - 490); g *= 255; b *= 255; }
    else if (nm < 580) { r = (nm - 510) / (580 - 510); g = 1; b = 0; r *= 255; g *= 255; }
    else if (nm < 645) { r = 1; g = (645 - nm) / (645 - 580); b = 0; r *= 255; g *= 255; }
    else if (nm < 780) { r = 1; g = 0; b = 0; r *= 255; }
    else { r = 80; }
    return { r: Math.round(r), g: Math.round(g), b: Math.round(b) };
  }

  /* Equation overlay (bottom-left to avoid canvas toggles & spectrum strip) */
  function drawEquation(W, H, c) {
    var bw = 230, bh = 50;
    /* Spectrum strip lives at H-50 with 14 px height + ticks → reserve y < H-90 */
    var by = H - bh - (state.showSpectrum ? 80 : 8);
    var bx = 8;
    ctx.fillStyle = 'rgba(13,17,30,0.78)';
    ctx.fillRect(bx, by, bw, bh);
    ctx.strokeStyle = 'rgba(230,74,25,0.6)';
    ctx.lineWidth = 1;
    ctx.strokeRect(bx, by, bw, bh);
    drawHaloText('P = ε·σ·A·T⁴', bx + 10, by + 18, '#ff8a65', 12, 'left');
    drawHaloText('= ' + fmt(toD(c.P, 'pow')) + ' ' + uLabel('pow'), bx + 10, by + 38, '#fff', 11, 'left');
  }

  function requestDraw() {
    if (state.raf) return;
    state.raf = requestAnimationFrame(function () { state.raf = 0; draw(); updateReadouts(); });
  }

  /* Readouts */
  function updateReadouts() {
    var c = compute();
    $('r-p').textContent = fmt(toD(c.P, 'pow'));
    $('r-pnet').textContent = fmt(toD(c.Pnet, 'pow'));
    $('r-flux').textContent = fmt(toD(c.flux, 'flux'));
    $('r-lpeak').textContent = c.lpeak.toFixed(2);
    $('r-color').textContent = colorRegion(state.T);
    $('r-tc').textContent = (isImp() ? c.Tf : c.Tc).toFixed(0);
    $('r-tf').textContent = c.Tf.toFixed(0);
    $('r-ratio').textContent = (isFinite(c.ratio) ? c.ratio.toFixed(0) : '∞') + '×';

    $('r-unit-p').textContent = ' ' + uLabel('pow');
    $('r-unit-pnet').textContent = ' ' + uLabel('pow');
    $('r-unit-flux').textContent = ' ' + uLabel('flux');
    $('r-unit-tc').textContent = ' ' + (isImp() ? '°F' : '°C');
    $('badge-a').textContent = uLabel('area');

    var badges = $('readout-badges');
    if (badges) badges.style.display = state.mode === 'simulate' ? '' : 'none';
    var col = bbColor(state.T);
    $('rb-cdot').style.background = rgbStr(col);
    $('rb-p').textContent = fmt(toD(c.P, 'pow'));
    $('rb-p-u').textContent = uLabel('pow');
    $('rb-t').textContent = state.T;
    $('rb-lpeak').textContent = c.lpeak.toFixed(2);
    $('rb-eps').textContent = state.eps.toFixed(2);

    updateLearnPanels(c);
  }

  function updateLearnPanels(c) {
    var eq = $('lp-eq-body'); if (!eq) return;
    var sigStr = '5.67 \\times 10^{-8}';
    var Tstr = state.T;
    var html = '';
    html += '<div class="eq-line">\\(\\sigma = ' + sigStr + ' \\; \\mathrm{W/(m^2 \\cdot K^4)}\\) — Stefan–Boltzmann constant</div>';
    html += '<div class="eq-line">\\[ P = \\varepsilon \\cdot \\sigma \\cdot A \\cdot T^4 = ' + state.eps + ' \\cdot ' + sigStr + ' \\cdot ' + (c.A_m2).toExponential(2).replace('e', ' \\times 10^{') + '} \\cdot ' + Tstr + '^4 \\]</div>';
    html += '<div class="eq-line">\\(P = \\mathbf{' + fmt(toD(c.P, 'pow')) + '\\;' + (isImp() ? '\\mathrm{BTU/hr}' : '\\mathrm{W}') + '}\\)</div>';
    html += '<div class="eq-line">\\[ P_{\\text{net}} = \\varepsilon \\sigma A \\,(T^4 - T_{\\text{amb}}^4) = \\mathbf{' + fmt(toD(c.Pnet, 'pow')) + '\\;' + (isImp() ? '\\mathrm{BTU/hr}' : '\\mathrm{W}') + '} \\]</div>';
    html += '<div class="eq-line">\\(M = \\varepsilon \\sigma T^4 = ' + fmt(toD(c.flux, 'flux')) + '\\;' + (isImp() ? '\\mathrm{BTU/(hr\\,ft^2)}' : '\\mathrm{W/m^2}') + '\\) (radiant flux)</div>';
    html += '<div class="eq-line">Wien: \\(\\lambda_{\\text{peak}} = \\dfrac{2898}{T} = \\mathbf{' + c.lpeak.toFixed(2) + '\\;\\mu m}\\) — ' + colorRegion(state.T) + '</div>';
    eq.innerHTML = html;
    renderMath(eq);

    var cmp = $('lp-cmp-body');
    if (cmp) {
      var refT = [300, 500, 1000, 1500, 2000, 3000, 4000, 5800];
      var rows = '<table class="cmp-table"><thead><tr><th>T (K)</th><th>Flux (W/m²)</th><th>P at A=' + state.A_cm2 + ' cm²</th><th>Color</th></tr></thead><tbody>';
      for (var i = 0; i < refT.length; i++) {
        var T = refT[i];
        var flux = state.eps * SIGMA * Math.pow(T, 4);
        var P = flux * c.A_m2;
        rows += '<tr><td>' + T + '</td><td>' + fmt(flux) + '</td><td>' + fmt(toD(P, 'pow')) + ' ' + uLabel('pow') + '</td><td>' + colorRegion(T) + '</td></tr>';
      }
      rows += '</tbody></table>';
      cmp.innerHTML = rows;
    }

    var co = $('lp-coach-body');
    if (co) {
      var tips = [];
      tips.push('Power scales with T⁴. Doubling T multiplies P by 16×. Tripling T multiplies P by 81×.');
      tips.push('Current peak wavelength is ' + c.lpeak.toFixed(2) + ' μm — ' + (c.lpeak > 0.78 ? 'infrared (invisible)' : c.lpeak < 0.38 ? 'ultraviolet' : 'visible (' + colorRegion(state.T) + ')') + '.');
      if (state.T > state.Tamb) {
        tips.push('Net radiation = ' + fmt(toD(c.Pnet, 'pow')) + ' ' + uLabel('pow') + ' (positive — body cooling).');
      } else {
        tips.push('Net radiation is negative — body is colder than ambient and absorbing more than it emits.');
      }
      tips.push('Lower emissivity (e.g. 0.05 polished silver) drastically reduces P. Try setting ε = 0.05.');
      var html2 = '<ul class="coach-list">';
      for (var k = 0; k < tips.length; k++) html2 += '<li>' + tips[k] + '</li>';
      html2 += '</ul>';
      co.innerHTML = html2;
    }
  }

  function rebuildPresets() {
    var box = $('preset-chips'); box.innerHTML = '';
    PRESETS.forEach(function (p) {
      var b = document.createElement('button');
      b.className = 'preset-chip'; b.type = 'button'; b.textContent = p.name;
      b.addEventListener('click', function () { applyPreset(p); playClick(); });
      box.appendChild(b);
    });
  }
  function applyPreset(p) {
    pushHistory();
    state.T = p.T; state.eps = p.eps; state.A_cm2 = p.A; state.Tamb = p.tamb;
    syncControls(); updateReadouts(); requestDraw();
    document.querySelectorAll('.preset-chip').forEach(function (c) { c.classList.toggle('active', c.textContent === p.name); });
  }
  function syncControls() {
    $('sl-t').value = state.T; $('in-t').value = state.T;
    $('sl-eps').value = state.eps; $('in-eps').value = state.eps.toFixed(2);
    $('sl-a').value = state.A_cm2;
    $('in-a').value = isImp() ? (state.A_cm2 / 6.4516).toFixed(2) : state.A_cm2.toFixed(0);
    $('sl-tamb').value = state.Tamb; $('in-tamb').value = state.Tamb;
  }

  function snapshot() { return { T: state.T, eps: state.eps, A_cm2: state.A_cm2, Tamb: state.Tamb, unit: state.unit }; }
  function pushHistory() { state.history.push(snapshot()); if (state.history.length > 30) state.history.shift(); state.redoStack = []; }
  function applySnap(s) { state.T = s.T; state.eps = s.eps; state.A_cm2 = s.A_cm2; state.Tamb = s.Tamb; state.unit = s.unit; syncUnitTabs(); syncControls(); updateReadouts(); requestDraw(); }
  function doUndo() { if (state.history.length === 0) return; state.redoStack.push(snapshot()); applySnap(state.history.pop()); }
  function doRedo() { if (state.redoStack.length === 0) return; state.history.push(snapshot()); applySnap(state.redoStack.pop()); }
  function syncUnitTabs() { document.querySelectorAll('#unit-tabs .pill').forEach(function (p) { p.classList.toggle('active', p.dataset.unit === state.unit); }); }

  function setMode(m) {
    state.mode = m;
    document.querySelectorAll('#mode-tabs .pill').forEach(function (p) { p.classList.toggle('active', p.dataset.mode === m); });
    $('sim-panel').style.display = (m === 'simulate') ? '' : 'none';
    $('learn-panels').style.display = (m === 'simulate') ? '' : 'none';
    $('cat-row').style.display = (m === 'explore') ? '' : 'none';
