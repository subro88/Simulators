  /* Calc modal — LaTeX-rendered via KaTeX for clean classical math format */
  function openCalc() {
    var c = compute();
    var T4 = Math.pow(state.T, 4);
    var Ta4 = Math.pow(state.Tamb, 4);
    var unitP = isImp() ? '\\mathrm{BTU/hr}' : '\\mathrm{W}';
    var P_disp = fmt(toD(c.P, 'pow'));
    var Pnet_disp = fmt(toD(c.Pnet, 'pow'));

    var html = '';
    html += '<div class="cs-inputs"><span class="cs-badge">Inputs</span><div class="cs-given">';
    html += '<span>\\(T = ' + state.T + '\\;\\mathrm{K}\\;(' + c.Tc.toFixed(0) + '\\;°\\mathrm{C})\\)</span>';
    html += '<span>\\(\\varepsilon = ' + state.eps + '\\)</span>';
    html += '<span>\\(A = ' + state.A_cm2 + '\\;\\mathrm{cm^2} = ' + c.A_m2.toExponential(2).replace('e', ' \\times 10^{') + '}\\;\\mathrm{m^2}\\)</span>';
    html += '<span>\\(T_{\\text{amb}} = ' + state.Tamb + '\\;\\mathrm{K}\\)</span>';
    html += '</div><p class="cs-si-note">All values in SI base units. \\(\\sigma = 5.67 \\times 10^{-8}\\;\\mathrm{W/(m^2 \\cdot K^4)}\\)</p></div>';

    html += '<div class="cs-step"><div class="cs-step-hd"><span class="cs-num">Step 1</span><span class="cs-title">Compute \\(T^4\\)</span></div>';
    html += '<div class="cs-formula">\\[ T^4 = ' + state.T + '^4 \\]</div>';
    html += '<div class="cs-result">\\(= \\mathbf{' + T4.toExponential(3).replace('e', ' \\times 10^{') + '}\\;\\mathrm{K^4}}\\)</div></div>';

    html += '<div class="cs-step"><div class="cs-step-hd"><span class="cs-num">Step 2</span><span class="cs-title">Apply Stefan–Boltzmann</span></div>';
    html += '<div class="cs-formula">\\[ P = \\varepsilon \\cdot \\sigma \\cdot A \\cdot T^4 \\]</div>';
    html += '<div class="cs-calc">\\[ P = ' + state.eps + ' \\cdot ' + SIGMA.toExponential(2).replace('e', ' \\times 10^{') + '} \\cdot ' + c.A_m2.toExponential(2).replace('e', ' \\times 10^{') + '} \\cdot ' + T4.toExponential(2).replace('e', ' \\times 10^{') + '} \\]</div>';
    html += '<div class="cs-result">\\(= \\mathbf{' + P_disp + '\\;' + unitP + '}\\)</div></div>';

    html += '<div class="cs-step"><div class="cs-step-hd"><span class="cs-num">Step 3</span><span class="cs-title">Net radiation (vs ambient)</span></div>';
    html += '<div class="cs-formula">\\[ P_{\\text{net}} = \\varepsilon \\sigma A \\bigl(T^4 - T_{\\text{amb}}^4\\bigr) \\]</div>';
    html += '<div class="cs-calc">\\(T_{\\text{amb}}^4 = ' + Ta4.toExponential(2).replace('e', ' \\times 10^{') + '}\\;\\mathrm{K^4}\\)</div>';
    html += '<div class="cs-result">\\(P_{\\text{net}} = \\mathbf{' + Pnet_disp + '\\;' + unitP + '}\\)</div></div>';

    html += '<div class="cs-step"><div class="cs-step-hd"><span class="cs-num">Step 4</span><span class="cs-title">Wien\'s peak wavelength</span></div>';
    html += '<div class="cs-formula">\\[ \\lambda_{\\text{peak}} = \\dfrac{2898\\;\\mu m \\cdot K}{T} \\]</div>';
    html += '<div class="cs-calc">\\(= \\dfrac{2898}{' + state.T + '}\\)</div>';
    html += '<div class="cs-result">\\(= \\mathbf{' + c.lpeak.toFixed(3) + '\\;\\mu m}\\) — ' + colorRegion(state.T) + '</div></div>';

    $('calc-modal-body').innerHTML = html;
    $('calc-modal').classList.add('active');
