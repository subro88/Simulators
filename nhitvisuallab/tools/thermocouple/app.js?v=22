  /* ── Graph mode: the E–θ parabola ───────────────────────────────── */
  function drawGraph() {
    if (!gctx) return;
    var g = gctx, r = solveSchool(), k;
    g.save();
    g.setTransform(dpr, 0, 0, dpr, 0, 0);
    g.clearRect(0, 0, gw, gh);
    var bg = g.createLinearGradient(0, 0, 0, gh);
    bg.addColorStop(0, '#111726'); bg.addColorStop(1, '#0b0f19');
    g.fillStyle = bg; g.fillRect(0, 0, gw, gh);

    var mL = 60, mR = 20, mT = 30, mB = 44;
    var pw = gw - mL - mR, phh = gh - mT - mB;

    var xMin = Math.min(0, state.tc);
    var xMax = isFinite(r.Ti) ? Math.max(r.Ti * 1.2, state.th * 1.1, xMin + 100)
      : Math.max(state.th * 1.3, xMin + 200);
    var yMin = 0, yMax = 0;
    for (k = 0; k <= 200; k++) {
      var e0 = emfSchool(r.a, r.b, xMin + (xMax - xMin) * k / 200, state.tc);
      if (e0 > yMax) yMax = e0;
      if (e0 < yMin) yMin = e0;
    }
    if (yMax - yMin < 1) { yMax += 1; yMin -= 1; }
    var pad = (yMax - yMin) * 0.14; yMax += pad; yMin -= pad;

    function X(t) { return mL + (t - xMin) / (xMax - xMin) * pw; }
    function Y(e) { return mT + (yMax - e) / (yMax - yMin) * phh; }

    g.strokeStyle = 'rgba(139,157,195,0.13)'; g.lineWidth = 1;
    for (k = 0; k <= 5; k++) {
      var gy = mT + phh * k / 5;
      g.beginPath(); g.moveTo(mL, gy); g.lineTo(mL + pw, gy); g.stroke();
      var ev = yMax - (yMax - yMin) * k / 5;
      halo(g, Math.abs(ev) >= 1000 ? (ev / 1000).toFixed(1) + 'k' : ev.toFixed(0), mL - 7, gy,
        '500 9.5px "Courier New", monospace', '#7d879e', 'right');
    }
    for (k = 0; k <= 6; k++) {
      var gx = mL + pw * k / 6;
      g.beginPath(); g.moveTo(gx, mT); g.lineTo(gx, mT + phh); g.stroke();
      halo(g, fmt(dT(xMin + (xMax - xMin) * k / 6), 0), gx, mT + phh + 14,
        '500 9.5px "Courier New", monospace', '#7d879e', 'center');
    }
    g.strokeStyle = 'rgba(190,205,230,0.5)'; g.lineWidth = 1.4;
    g.beginPath(); g.moveTo(mL, mT); g.lineTo(mL, mT + phh); g.lineTo(mL + pw, mT + phh); g.stroke();
    if (yMin < 0 && yMax > 0) {
      g.strokeStyle = 'rgba(190,205,230,0.34)'; g.lineWidth = 1; g.setLineDash([4, 4]);
      g.beginPath(); g.moveTo(mL, Y(0)); g.lineTo(mL + pw, Y(0)); g.stroke();
      g.setLineDash([]);
    }

    g.beginPath();
    for (k = 0; k <= 300; k++) {
      var t2 = xMin + (xMax - xMin) * k / 300;
      var e2 = emfSchool(r.a, r.b, t2, state.tc);
      if (k === 0) g.moveTo(X(t2), Y(e2)); else g.lineTo(X(t2), Y(e2));
    }
    g.strokeStyle = '#ff5722'; g.lineWidth = 2.6; g.lineJoin = 'round'; g.stroke();

    if (isFinite(r.Tn) && r.Tn > xMin && r.Tn < xMax) {
      g.strokeStyle = 'rgba(61,220,132,0.6)'; g.lineWidth = 1.3; g.setLineDash([5, 4]);
      g.beginPath(); g.moveTo(X(r.Tn), Y(r.Emax)); g.lineTo(X(r.Tn), mT + phh); g.stroke();
      g.setLineDash([]);
      g.beginPath(); g.arc(X(r.Tn), Y(r.Emax), 5, 0, Math.PI * 2);
      g.fillStyle = '#3ddc84'; g.fill();
      var tnX = Math.max(mL + 44, Math.min(X(r.Tn), mL + pw - 44));
      halo(g, 'θn = ' + fmt(dT(r.Tn), 0) + uT(), tnX, Y(r.Emax) - 14,
        '700 10.5px "Courier New", monospace', '#3ddc84', 'center');
      if (pw > 300) {
        halo(g, 'neutral · E max · P = 0', tnX, Y(r.Emax) - 27,
          '600 9.5px "Segoe UI", system-ui, sans-serif', '#3ddc84', 'center');
      }
    }
    if (isFinite(r.Ti) && r.Ti > xMin && r.Ti < xMax) {
      g.beginPath(); g.arc(X(r.Ti), Y(0), 5, 0, Math.PI * 2);
      g.fillStyle = '#ff5555'; g.fill();
      /* Keep the caption inside the plot area at narrow widths. */
      var tiX = Math.max(mL + 52, Math.min(X(r.Ti), mL + pw - 62));
      halo(g, 'θi = ' + fmt(dT(r.Ti), 0) + uT(), tiX, Y(0) + 16,
        '700 10.5px "Courier New", monospace', '#ff5555', 'center');
      if (pw > 300) {
        halo(g, 'inversion · E back to zero', tiX, Y(0) + 29,
          '600 9.5px "Segoe UI", system-ui, sans-serif', '#ff5555', 'center');
      }
    }
    if (state.th > xMin && state.th < xMax) {
      var ey = Y(r.E);
      g.strokeStyle = 'rgba(245,200,66,0.7)'; g.lineWidth = 1.2; g.setLineDash([3, 3]);
      g.beginPath(); g.moveTo(X(state.th), ey); g.lineTo(X(state.th), mT + phh); g.stroke();
      g.setLineDash([]);
      g.beginPath(); g.arc(X(state.th), ey, 6, 0, Math.PI * 2);
      g.fillStyle = '#f5c842'; g.fill();
      g.strokeStyle = '#0d1117'; g.lineWidth = 1.4; g.stroke();
      halo(g, 'θh', X(state.th), mT + phh + 27, '700 10px "Courier New", monospace', '#f5c842', 'center');
    }

    halo(g, 'Hot junction temperature θh (' + uT() + ')', mL + pw / 2, gh - 10,
      '600 10.5px "Segoe UI", system-ui, sans-serif', '#9fb0cc', 'center');
    g.save();
    g.translate(14, mT + phh / 2); g.rotate(-Math.PI / 2);
    halo(g, 'Thermo-EMF (µV)', 0, 0, '600 10.5px "Segoe UI", system-ui, sans-serif', '#9fb0cc', 'center');
    g.restore();
    var hdr = r.A.sym + '–' + r.B.sym + '   a = ' + r.a.toFixed(1) + ' µV/°C,  b = ' + r.b.toFixed(4) + ' µV/°C²';
    g.save(); g.font = '600 10.5px "Courier New", monospace';
    if (g.measureText(hdr).width > pw) hdr = r.A.sym + '–' + r.B.sym + '  a=' + r.a.toFixed(1) + '  b=' + r.b.toFixed(4);
    g.restore();
    halo(g, hdr, mL + 2, mT - 14, '600 10.5px "Courier New", monospace', '#ffd9a8', 'left');
    g.restore();
  }

  /* ── Animation ───────────────────────────────────────────────────
     Loops per second scales with |E| so a bigger thermo-EMF visibly drives a
     faster drift, but is clamped so the extreme couples stay watchable.    */
  var rafId = null, lastTs = 0;
  function animSpeed() {
    var r = solveSchool();
    if (r.open) return 0;
    if (!isFinite(r.E) || Math.abs(r.E) < 0.5) return 0;
    return Math.max(0.06, Math.min(0.65, Math.abs(r.E) / 9000)) * state.speed;
  }
  function tick(ts) {
    if (!state.running) { rafId = null; return; }
    var dt = lastTs ? Math.min(0.05, (ts - lastTs) / 1000) : 0.016;
    lastTs = ts;
    state.phase = (state.phase + dt * animSpeed()) % 1;
    draw();
    rafId = window.requestAnimationFrame(tick);
  }
  function startAnim() {
    if (rafId !== null) return;
    lastTs = 0;
    rafId = window.requestAnimationFrame(tick);
  }
  function stopAnim() {
    if (rafId !== null) { window.cancelAnimationFrame(rafId); rafId = null; }
  }
  function setRunning(on) {
    state.running = on;
    var b = $('btn-sim');
    if (b) {
      b.innerHTML = on ? '\u23F8 Pause' : '\u25B6 Simulate';
      b.classList.toggle('running', on);
    }
    if (on && state.mode === 'simulate' && state.rig === 'school') startAnim();
    else stopAnim();
  }

  /* ── Readouts + panels ──────────────────────────────────────────── */
  var _cache = { eq: '', cmp: '', co: '', tbl: '' };
  function setTxt(id, v) { var e = $(id); if (e) e.textContent = v; }
  function show(id, on) { var e = $(id); if (e) e.style.display = on ? '' : 'none'; }

  function updateAll() {
    if (state.rig === 'school') {
      var r = solveSchool();
      setTxt('rb-1l', 'EMF'); setTxt('rb-1', fmtEmf(r.E)); setTxt('rb-1u', '');
      setTxt('rb-2l', 'Δθ'); setTxt('rb-2', fmt(dTd(r.dT), 0)); setTxt('rb-2u', uT());
      setTxt('rb-3l', 'θn'); setTxt('rb-3', isFinite(r.Tn) ? fmt(dT(r.Tn), 0) : '—'); setTxt('rb-3u', uT());
      setTxt('rb-4l', 'Power'); setTxt('rb-4', fmt(r.P, 2)); setTxt('rb-4u', 'µV/' + uT());

      setTxt('s-a', r.a.toFixed(1));
      setTxt('s-b', solveSchool().b.toFixed(4));
      setTxt('s-dt', fmt(dTd(r.dT), 1)); setTxt('s-dt-u', ' ' + uT());
      setTxt('s-emf', fmtEmf(r.E));
      setTxt('s-tn', isFinite(r.Tn) ? fmt(dT(r.Tn), 1) : '—'); setTxt('s-tn-u', isFinite(r.Tn) ? ' ' + uT() : '');
      setTxt('s-ti', isFinite(r.Ti) ? fmt(dT(r.Ti), 1) : '—'); setTxt('s-ti-u', isFinite(r.Ti) ? ' ' + uT() : '');
      setTxt('s-p', fmt(r.P, 2));
      setTxt('s-emax', isFinite(r.Emax) ? fmtEmf(r.Emax) : '—');
      setTxt('s-vpile', fmtEmf(r.Vpile));
      setTxt('s-carnot', isFinite(r.carnot) ? (r.carnot * 100).toFixed(1) : '—');
      /* These two are OPPOSITE by definition — the whole point of the card pair. */
      setTxt('s-dir', dirText(r, false));
      setTxt('s-edir', dirText(r, true));
      var sd = $('s-dir'), sed = $('s-edir');
      if (sd) sd.style.color = flowDirs(r).cur ? '#ffe08a' : 'var(--text-dim)';
      if (sed) sed.style.color = flowDirs(r).ele ? '#7fdbff' : 'var(--text-dim)';
      var se = $('s-emf');
      if (se) se.style.color = Math.abs(r.E) < 0.5 ? 'var(--text-dim)' : (r.E > 0 ? 'var(--green)' : 'var(--red)');
    } else {
      var q = solveAdv();
      setTxt('rb-1l', 'EMF'); setTxt('rb-1', fmt(q.Edisp, 3)); setTxt('rb-1u', 'mV');
      setTxt('rb-2l', 'Indicated'); setTxt('rb-2', fmt(dT(q.Tind), 1)); setTxt('rb-2u', uT());
      setTxt('rb-3l', 'Error'); setTxt('rb-3', isFinite(q.error) ? (q.error >= 0 ? '+' : '') + fmt(dTd(q.error), 2) : '—'); setTxt('rb-3u', uT());
      setTxt('rb-4l', 'Sensitivity'); setTxt('rb-4', fmt(q.S, 2)); setTxt('rb-4u', 'µV/°C');

      setTxt('a-emf', fmt(q.Edisp, 3));
      setTxt('a-eloop', fmt(q.Eloop, 4));
      setTxt('a-cjc', fmt(q.cjcAdd, 4));
      setTxt('a-etotal', fmt(q.Etotal, 4));
      setTxt('a-tind', fmt(dT(q.Tind), 2)); setTxt('a-tind-u', ' ' + uT());
      setTxt('a-err', isFinite(q.error) ? (q.error >= 0 ? '+' : '') + fmt(dTd(q.error), 2) : '—');
      setTxt('a-err-u', ' ' + uT());
      setTxt('a-s', fmt(q.S, 2));
      setTxt('a-tol', q.tol === null ? 'n/a' : '±' + fmt(dTd(q.tol), 2));
      setTxt('a-range', fmt(dT(INV_T[state.type][0]), 0) + ' … ' + fmt(dT(INV_T[state.type][1]), 0));
      var ae = $('a-err');
      if (ae) {
        var m = Math.abs(q.error);
        ae.style.color = !isFinite(m) ? 'var(--text-dim)' : m < 0.5 ? 'var(--green)' : m < 5 ? 'var(--gold)' : 'var(--red)';
      }
    }
    renderPanels();
  }

  function renderPanels() {
    var eq = $('lp-eq-body'), h, i;
    if (eq) {
      h = '';
      if (state.rig === 'school') {
        var r = solveSchool();
        h += '<p class="eq-note">The couple\'s linear coefficient is the difference of the two metals\' Seebeck coefficients: <strong>a = S(' + r.A.sym + ') − S(' + r.B.sym + ') = ' + r.A.S.toFixed(1) + ' − (' + r.B.S.toFixed(1) + ') = ' + r.a.toFixed(1) + ' µV/°C</strong>.</p>';
        h += '\\[ E = a(\\theta_h-\\theta_c) + b(\\theta_h^2-\\theta_c^2) \\]';
        h += '\\[ E = ' + r.a.toFixed(1) + '(' + state.th + ' - ' + state.tc + ') + (' + r.b.toFixed(4) + ')(' + state.th + '^2 - ' + state.tc + '^2) = ' + r.E.toFixed(1) + '\\ \\mu\\text{V} \\]';
        if (isFinite(r.Tn)) {
          h += '<p class="eq-note">The \\(\\theta^2\\) term bends the graph into a parabola, so the EMF stops rising at the neutral temperature:</p>';
          h += '\\[ \\theta_n = -\\frac{a}{2b} = -\\frac{' + r.a.toFixed(1) + '}{2(' + r.b.toFixed(4) + ')} = ' + r.Tn.toFixed(1) + '\\ ^\\circ\\text{C} \\]';
          h += '\\[ \\theta_i = 2\\theta_n - \\theta_c = 2(' + r.Tn.toFixed(1) + ') - ' + state.tc + ' = ' + r.Ti.toFixed(1) + '\\ ^\\circ\\text{C} \\]';
        } else {
          h += '<p class="eq-note">With \\(b = 0\\) the graph is a straight line — no neutral temperature and no inversion temperature.</p>';
        }
        h += '\\[ P = \\frac{dE}{d\\theta_h} = a + 2b\\theta_h = ' + r.P.toFixed(2) + '\\ \\mu\\text{V}/^\\circ\\text{C} \\]';
      } else {
        var q = solveAdv();
        h += '<p class="eq-note">Real instrument model — EMF summed segment by segment round the loop, then cold-junction compensated.</p>';
        h += '\\[ E_{loop} = \\left[E(T_h)-E(T_{head})\\right] + \\left[E_{ext}(T_{head})-E_{ext}(T_{cj})\\right] = ' + q.Eloop.toFixed(4) + '\\ \\text{mV} \\]';
        h += '\\[ E_{total} = ' + q.Edisp.toFixed(4) + ' + ' + q.cjcAdd.toFixed(4) + ' = ' + q.Etotal.toFixed(4) + '\\ \\text{mV} \\]';
        if (isFinite(q.Tind)) h += '\\[ T_{ind} = E^{-1}(' + q.Etotal.toFixed(4) + ') = ' + q.Tind.toFixed(2) + '\\ ^\\circ\\text{C} \\]';
      }
      if (h !== _cache.eq) { eq.innerHTML = h; _cache.eq = h; }
    }

    var cmp = $('lp-cmp-body');
    if (cmp) {
      var rows;
      if (state.rig === 'school') {
        var r2 = solveSchool();
        rows = '<p class="eq-note">Thermoelectric series — each metal\'s Seebeck coefficient measured against platinum. Two metals far apart in this list give a large thermo-EMF; two neighbours give almost nothing.</p>';
        rows += '<table class="mini-table"><thead><tr><th>Metal</th><th>S (µV/K)</th><th>a with ' + r2.A.sym + '</th></tr></thead><tbody>';
        for (i = 0; i < SERIES.length; i++) {
          var m2 = SERIES[i];
          var act = (m2.sym === state.mA || m2.sym === state.mB) ? ' class="mt-active"' : '';
          rows += '<tr' + act + '><td><strong>' + m2.name + '</strong> (' + m2.sym + ')</td><td>' + m2.S.toFixed(1) + '</td><td>' +
            (m2.sym === r2.A.sym ? '—' : (r2.A.S - m2.S).toFixed(1)) + '</td></tr>';
        }
        rows += '</tbody></table>';
      } else {
        rows = '<table class="mini-table"><thead><tr><th>Type</th><th>E at Tₕ (mV)</th><th>S (µV/°C)</th><th>Range (°C)</th></tr></thead><tbody>';
        for (i = 0; i < TYPE_ORDER.length; i++) {
          var t3 = TYPE_ORDER[i];
          var e3 = emf(t3, state.Th), s3 = seebeckNIST(t3, state.Th);
          rows += '<tr' + (t3 === state.type ? ' class="mt-active"' : '') + '><td><strong>' + t3 + '</strong></td><td>' +
            (isFinite(e3) ? e3.toFixed(3) : '—') + '</td><td>' + (isFinite(s3) ? s3.toFixed(1) : '—') + '</td><td>' +
            INV_T[t3][0] + ' … ' + INV_T[t3][1] + '</td></tr>';
        }
        rows += '</tbody></table>';
      }
      if (rows !== _cache.cmp) { cmp.innerHTML = rows; _cache.cmp = rows; }
    }

    var co = $('lp-coach-body');
    if (co) {
      var tips = [];
      if (state.rig === 'school') {
        var s2 = solveSchool();
        if (s2.open) tips.push('<li><strong>The loop is broken.</strong> The two junctions are still at different temperatures, so the thermo-EMF of ' + fmtEmf(s2.E) + ' is still there — but current needs a <em>complete</em> circuit, so the galvanometer reads zero and the electrons stop drifting. This is exactly the condition a potentiometer creates when it nulls the circuit to measure EMF without drawing any current.</li>');
        if (Math.abs(s2.a) < 0.05) tips.push('<li><strong>Both wires are the same metal.</strong> The two EMFs cancel exactly around the loop, so the reading is zero however hot you make it. A thermocouple needs two <em>different</em> metals.</li>');
        else if (s2.dT === 0) tips.push('<li><strong>No temperature difference, no EMF.</strong> The Seebeck effect needs the junctions at different temperatures — heat the hot one.</li>');
        if (Math.abs(s2.a) > 0.05 && Math.abs(s2.a) < 3 && s2.dT !== 0) tips.push('<li><strong>These metals are close together in the series</strong> (a = ' + s2.a.toFixed(1) + ' µV/°C), so the output is tiny. Try antimony with bismuth — the two extremes — for the biggest EMF.</li>');
        if (s2.atNeutral) tips.push('<li><strong>You are at the neutral temperature.</strong> EMF is at its maximum and thermoelectric power P = dE/dθ is zero. Heat further and the reading goes <em>down</em>.</li>');
        if (s2.past) tips.push('<li><strong>Past the inversion temperature.</strong> The EMF has changed sign, so the galvanometer needle has swung the other way and the current now flows the opposite way round the loop.</li>');
        if (s2.n > 1) {
          tips.push('<li><strong>' + s2.n + ' couples in series</strong> give ' + fmtEmf(s2.Vpile) + ' — that is a thermopile, the heart of every thermoelectric generator. The Carnot ceiling between these two temperatures is ' + (s2.carnot * 100).toFixed(1) + ' %, and a real module reaches only a fraction of it.</li>');
        } else if (isFinite(s2.nForLed) && s2.nForLed > 1) {
          tips.push('<li><strong>Turn it into a generator.</strong> One couple gives ' + fmtEmf(s2.E) + ', so you would need about <strong>' + s2.nForLed + ' couples in series</strong> to light a 1.8 V LED. Raise "Couples in series" and watch the output climb — that is NGSS HS-PS3-3 energy conversion in one control.</li>');
        }
        if (isFinite(s2.Tn)) tips.push('<li>θ<sub>n</sub> = ' + s2.Tn.toFixed(0) + ' °C depends only on the metals, <strong>not</strong> on the cold junction. θ<sub>i</sub> = ' + s2.Ti.toFixed(0) + ' °C <strong>does</strong> — raise θ<sub>c</sub> and the inversion temperature drops by the same amount.</li>');
        if (s2.b === 0 && !s2.same) tips.push('<li><strong>b = 0 gives a straight line.</strong> The curvature term is what creates the parabola, the neutral temperature and the inversion temperature. Move b away from zero and check the Graph tab.</li>');
        if (flowDirs(s2).cur !== 0) {
          tips.push('<li><strong>Direction rule.</strong> At the hot junction the conventional current runs from the metal with the <em>lower</em> Seebeck coefficient to the one with the <em>higher</em>: <strong>' + dirText(s2, false) + '</strong>. Electrons carry negative charge, so they go the opposite way, <strong>' + dirText(s2, true) + '</strong>. Both reverse together past the inversion temperature.</li>');
        }
        tips.push('<li>Thermoelectric power is the <em>slope</em> of the E–θ graph, P = a + 2bθ<sub>h</sub> = ' + s2.P.toFixed(2) + ' µV/°C. It is not E divided by θ — you must differentiate.</li>');
      } else {
        var q2 = solveAdv();
        if (state.cjc === 'none') tips.push('<li><strong>No cold-junction compensation.</strong> The reading is low by very nearly ' + fmt(state.Tcj, 1) + ' °C.</li>');
        if (state.ext === 'copper') tips.push('<li><strong>Copper leads move the reference junction</strong> to the connection head at ' + fmt(state.Thead, 1) + ' °C.</li>');
        if (state.ext === 'wrong') tips.push('<li><strong>Mismatched extension wire</strong> creates a parasitic thermocouple at the head.</li>');
        if (q2.tol !== null) tips.push('<li>IEC 60584-1 Class ' + state.cls + ' permits ±' + fmt(q2.tol, 2) + ' °C here — sensor tolerance alone.</li>');
        if (!tips.length) tips.push('<li>Loop correctly set up. The residual ' + fmt(q2.error, 3) + ' °C is the ITS-90 inverse-polynomial approximation.</li>');
      }
      var hh = '<ul class="coach-list">' + tips.join('') + '</ul>';
      if (hh !== _cache.co) { co.innerHTML = hh; _cache.co = hh; }
    }
  }

  /* ── Tables mode ────────────────────────────────────────────────── */
  function renderTable() {
    var host = $('tbl-body'); if (!host) return;
    var t = state.tblType, d = TC[t], step = state.tblStep;
    var start = Math.max(d.tmin, Math.min(state.tblStart, d.tmax));
    var cols = 11, c2;
    var h = '<div class="tbl-scroll"><table class="ref-table"><thead><tr><th>°C</th>';
    for (c2 = 0; c2 < cols; c2++) h += '<th>' + (c2 * step) + '</th>';
    h += '</tr></thead><tbody>';
    for (var i = 0; i < 12; i++) {
      var base = start + i * step * cols;
      if (base > d.tmax) break;
      h += '<tr><th>' + base + '</th>';
      for (c2 = 0; c2 < cols; c2++) {
        var T = base + c2 * step;
        var e = (T >= d.tmin && T <= d.tmax) ? emf(t, T) : NaN;
        h += '<td>' + (isFinite(e) ? e.toFixed(3) : '') + '</td>';
      }
      h += '</tr>';
    }
    h += '</tbody></table></div><p class="tbl-note">Thermo-EMF in millivolts, reference junction at 0&nbsp;°C, generated live from the NIST ITS-90 reference function for type ' + t +
      '. Defined range ' + d.tmin + ' to ' + d.tmax + '&nbsp;°C; values match NIST Monograph 175 to within 0.5&nbsp;µV.</p>';
    if (h !== _cache.tbl) { host.innerHTML = h; _cache.tbl = h; }
  }

  /* ── Explore ────────────────────────────────────────────────────── */
  var EXPLORE = {
    basics: [
      { title: 'What is the Seebeck effect?', body: 'Join two different metals at two points to make a closed loop. Keep the two junctions at different temperatures and a current flows on its own — with no battery anywhere in the circuit. This is the Seebeck effect, discovered by Thomas Seebeck in 1821 using copper and bismuth. The pair of metals is called a thermocouple and the voltage it produces is the thermo-EMF.', formula: 'E depends on the two metals and on (θh − θc)', note: 'Two conditions must BOTH hold — the metals must be different, and the junctions must be at different temperatures. Break either one and E = 0.' },
      { title: 'Why must the metals be different?', body: 'Heat makes electrons at the hot end of a wire move faster, so they drift toward the cold end and pile up there, leaving the hot end slightly positive. Every metal does this, but by a different amount. If both wires were the same metal the two effects would be equal and opposite around the loop and would cancel exactly. Two different metals means they do not cancel, and a net EMF survives.', note: 'A "thermocouple" made of copper and copper reads exactly zero no matter how hot you make it. Try it — set both metals the same.' },
      { title: 'Hot junction and cold junction', body: 'One junction goes where you want to measure — the hot junction. The other is held at a known steady temperature — the cold or reference junction. Because the EMF depends on the difference between them, you can only work out the hot temperature if you know the cold one. In the lab the cold junction sits in melting ice, which stays at exactly 0 °C the whole time it is melting.', formula: 'θh = temperature being measured,  θc = known reference', note: 'This is why the ice bath is in every textbook diagram — it fixes θc at a reliable 0 °C for free.' },
      { title: 'The thermoelectric series', body: 'Metals can be ranked by how strongly they show the effect. A common school ordering is Sb, Fe, Zn, Pb, Mn, Cu, Bi. The further apart two metals sit in the series, the larger the thermo-EMF for the same temperature difference. Antimony and bismuth are at the two extremes, which is why Sb-Bi is the standard demonstration pair.', note: 'State the direction by Seebeck coefficient, not by "earlier/later" — that phrasing flips depending on which way round the series is printed. At the HOT junction conventional current flows from the LOWER-S metal to the HIGHER-S metal: Cu → Fe for copper-iron, Bi → Sb for antimony-bismuth.' },
      { title: 'Which way do the electrons go?', body: 'Two directions get confused constantly. Conventional current I is defined as the flow of POSITIVE charge; electrons are negative, so electron flow is always the exact opposite. In a thermocouple the rule is fixed by the two metals: at the hot junction, conventional current runs from the metal with the lower Seebeck coefficient to the one with the higher, so electrons run from the higher to the lower. For a copper-iron couple that means current Cu → Fe and electrons Fe → Cu at the hot junction; for antimony-bismuth, current Bi → Sb and electrons Sb → Bi.', formula: 'I: low-S → high-S at hot junction   ·   e⁻: high-S → low-S', note: 'Press Simulate and watch the cyan e⁻ markers. Heat past the inversion temperature and BOTH reverse together — the galvanometer needle crosses zero at the same instant.' }
    ],
    graph: [
      { title: 'The E–θ graph is a parabola', body: 'Hold the cold junction fixed and slowly heat the hot junction while plotting the EMF. The graph is not a straight line. It curves over, reaches a peak, comes back down, crosses zero and then goes negative. It is a parabola, described by E = aθ + bθ², where a and b depend on the pair of metals and b is negative for most couples.', formula: 'E = aθ + bθ²   (cold junction at 0 °C)', note: 'A very common exam question just asks for the SHAPE of this graph. The answer is parabolic — not linear, not exponential.' },
      { title: 'Neutral temperature θn', body: 'The neutral temperature is the hot-junction temperature at which the thermo-EMF is a maximum. Beyond it, heating the hot junction further actually reduces the reading. At this point the graph is flat, so its slope — the thermoelectric power — is zero.', formula: 'θn = −a / (2b)', note: 'θn depends ONLY on the two metals. Changing the cold-junction temperature does not move it. This is a favourite trick question.' },
      { title: 'Inversion temperature θi', body: 'Keep heating past the neutral temperature and the EMF falls all the way back to zero. The temperature at which it does is the inversion temperature. Beyond it the EMF reverses sign, the current flows the other way round the loop, and the galvanometer needle swings to the opposite side of zero.', formula: 'θi = 2θn − θc', note: 'With the cold junction at 0 °C this becomes θi = 2θn, so the inversion temperature is double the neutral temperature. That shortcut only works when θc = 0.' },
      { title: 'Thermoelectric power', body: 'Thermoelectric power, also called the Seebeck coefficient of the couple, is the rate of change of EMF with temperature: P = dE/dθ = a + 2bθ. It is the slope of the E–θ graph. It falls steadily as the hot junction gets hotter, passes through zero at the neutral temperature and goes negative after that.', formula: 'P = dE/dθ = a + 2bθ', note: 'Students often compute E/θ and call it thermoelectric power. It is the gradient — you must differentiate, not divide.' }
    ],
    energy: [
      { title: 'Turning heat into electricity', body: 'A thermocouple is not only a thermometer — it is a tiny heat engine with no moving parts. Give it a temperature difference and it delivers electrical energy, converting thermal energy straight into electrical energy. That is exactly the "design a device that converts one form of energy into another" brief in NGSS HS-PS3-3, and it is why thermoelectric generators are a standard science-fair build.', formula: 'thermal energy → electrical energy, no moving parts', note: 'The energy does not come from nowhere. Heat flows from the hot junction to the cold one, and a small part of that flow is converted to electrical work. Let the two ends reach the same temperature and the output stops.' },
      { title: 'Thermopiles — couples in series', body: 'One couple gives only microvolts, so real generators wire many in series. N couples give N times the voltage, and that stack is called a thermopile. Use the "Couples in series" control to see it: a single iron-copper couple across 100 °C gives about 1 mV, so you would need 1757 of them in series to light a 1.8 V red LED. Swap to antimony-bismuth, about ten times stronger, and the count drops by the same factor.', formula: 'V = N × E', note: 'This is why commercial modules use semiconductor pellets rather than metal wire — a bismuth-telluride element produces roughly 200 µV/K, several times the best metal pair here.' },
      { title: 'How efficient can it be?', body: 'No heat engine can beat the Carnot limit, η = 1 − T_cold/T_hot, and the temperatures must be in KELVIN. Between 100 °C and 0 °C that ceiling is only about 27 %. A real thermoelectric module reaches nowhere near it — typically 5–8 % — because efficiency also depends on the material figure of merit ZT. Bismuth telluride manages ZT ≈ 1; ordinary metal wire is far below that, which is why a wire thermopile is a superb sensor and a poor generator.', formula: 'η_Carnot = 1 − T_cold / T_hot   (kelvin!)', note: 'Putting Celsius into the Carnot formula is the single most common mistake here. 100 °C and 0 °C are 373.15 K and 273.15 K, giving 26.8 % — not 100 %.' },
      { title: 'Where this is actually used', body: 'Radioisotope thermoelectric generators have powered Voyager 1 and 2 since 1977 using the Seebeck effect and a plutonium heat source — no moving parts to wear out over a 45-year mission. Camping stoves charge phones from the flame. Cars and factories are being fitted with modules that scavenge exhaust waste heat. And the same device run backwards, as a Peltier cooler, chills CPU plates and portable fridges.', note: 'For a science-fair build: a Peltier module plus a heat sink and a cup of iced water will spin a small motor or light an LED, and the maths on this page predicts the voltage you should measure.' }
    ],
    effects: [
      { title: 'Peltier effect', body: 'The Peltier effect is the reverse of the Seebeck effect. Drive a current through a thermocouple from an external battery and one junction heats up while the other cools down. Reverse the current and the two swap over. Unlike Joule heating, which is always heating and depends on I², the Peltier effect is reversible and depends on I.', note: 'This is how portable electric cool-boxes and CPU cooler plates work — no moving parts and no refrigerant.' },
      { title: 'Thomson effect', body: 'The Thomson effect happens in a single conductor rather than at a junction. If a current flows along a wire that also has a temperature gradient, heat is absorbed or released along its length. It is positive in copper and negative in iron. In lead it is very nearly zero, which is exactly why lead is chosen as the reference metal for the thermoelectric series.', note: 'Exam question: why is lead the reference metal in thermoelectricity? Because its Thomson effect is essentially zero.' },
      { title: 'Law of intermediate metals', body: 'Putting a third metal into the circuit changes nothing, provided both ends of that third metal are at the same temperature. This is what lets you cut the loop and insert a galvanometer with copper terminals without spoiling the reading.', note: 'Without this law you could never connect any measuring instrument to a thermocouple at all.' },
      { title: 'Law of intermediate temperatures', body: 'The EMF between temperatures θ1 and θ3 equals the EMF from θ1 to θ2 plus the EMF from θ2 to θ3. It lets you take a table measured with one cold-junction temperature and re-reference it to a different one by simple addition.', formula: 'E(θ1→θ3) = E(θ1→θ2) + E(θ2→θ3)', note: 'This is the law that makes cold-junction compensation valid arithmetic.' }
    ],
    practical: [
      { title: 'Why use a thermocouple?', body: 'A thermocouple beats a liquid-in-glass thermometer on four counts. It reaches far higher temperatures — over 1500 °C for platinum types, where mercury would have boiled away long ago. It responds very fast, because the junction is tiny and has little heat capacity. The junction can be made small enough to measure the temperature at a single point. And the output is an electrical signal, so it can be recorded or fed straight into a controller.', note: 'IGCSE and GCSE answers usually want two of: wide range, fast response, small size, electrical/remote reading.' },
      { title: 'What it is not good at', body: 'The output is only microvolts per degree, so it needs amplification and picks up electrical noise easily. It is less accurate than a platinum resistance thermometer. And it always needs a known reference temperature, which is one more thing to get right.', note: 'For high accuracy over a narrow range near room temperature, a resistance thermometer or thermistor is the better choice.' },
      { title: 'Real thermocouple types', body: 'Industry uses standardised alloy pairs with letter names. Type K (nickel-chromium with nickel-aluminium) is the general workhorse up to about 1100 °C. Type J uses iron with a copper-nickel alloy. Type T (copper with copper-nickel) works well below 0 °C. Types R, S and B are platinum-rhodium alloys for very high temperatures.', note: 'Switch the rig to Advanced to work with these real types using official NIST ITS-90 data, and open Tables for their millivolt tables.' },
      { title: 'Where you will meet one', body: 'Furnace and kiln control, gas boiler flame-failure devices, engine exhaust monitoring, food processing, and the radioisotope thermoelectric generators that have powered deep-space probes for decades using the Seebeck effect directly as a power source.', note: 'The gas flame-failure device is the everyday example examiners like: no flame means no EMF, so the gas valve closes automatically.' }
    ]
  };

