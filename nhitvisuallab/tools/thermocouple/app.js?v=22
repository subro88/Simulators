  /* ── Practice ───────────────────────────────────────────────────── */
  function randOf(a) { return a[Math.floor(Math.random() * a.length)]; }
  function rnd(lo, hi, step) { return lo + Math.floor(Math.random() * (Math.floor((hi - lo) / step) + 1)) * step; }

  /* Render the quadratic with a real minus sign rather than "32θ -0.02θ²". */
  function quad(a, b) {
    return a + 'θ ' + (b < 0 ? '− ' + Math.abs(b).toFixed(2) : '+ ' + b.toFixed(2)) + 'θ²';
  }

  function newPractice() {
    var kind = randOf(['neutral', 'inversion', 'emf', 'power', 'series', 'findTc', 'pile', 'carnot']);
    var q = { kind: kind }, a, b;

    if (kind === 'neutral') {
      a = rnd(10, 40, 1); b = -(rnd(2, 8, 1) / 100);
      q.ans = -a / (2 * b); q.unit = '°C'; q.tolAns = 1;
      q.prompt = 'The thermo-EMF of a thermocouple whose cold junction is at 0 °C is E = ' + quad(a, b) + ' µV. Find its neutral temperature, in °C.';
      q.sol = 'At the neutral temperature the EMF is maximum, so dE/dθ = 0. Differentiating, dE/dθ = ' + a + ' + 2(' + b.toFixed(2) + ')θ = 0, so θn = −a/(2b) = −' + a + ' / (2 × ' + b.toFixed(2) + ') = ' + q.ans.toFixed(1) + ' °C.';
    } else if (kind === 'inversion') {
      var tn = rnd(200, 400, 5), tcv = rnd(0, 40, 5);
      q.ans = 2 * tn - tcv; q.unit = '°C'; q.tolAns = 1;
      q.prompt = 'A thermocouple has a neutral temperature of ' + tn + ' °C and its cold junction is kept at ' + tcv + ' °C. Find its temperature of inversion, in °C.';
      q.sol = 'The neutral temperature is the mean of the cold-junction and inversion temperatures: θn = (θc + θi)/2. Rearranging, θi = 2θn − θc = 2(' + tn + ') − ' + tcv + ' = ' + q.ans + ' °C.';
    } else if (kind === 'emf') {
      a = rnd(10, 40, 2); b = -(rnd(2, 6, 1) / 100);
      var th = rnd(50, 200, 25);
      q.ans = a * th + b * th * th; q.unit = 'µV'; q.tolAns = Math.max(1, Math.abs(q.ans) * 0.01);
      q.prompt = 'For a thermocouple with its cold junction at 0 °C, E = ' + quad(a, b) + ' µV. Find the thermo-EMF when the hot junction is at ' + th + ' °C, in µV.';
      q.sol = 'Substitute θ = ' + th + ': E = ' + a + '(' + th + ') + (' + b.toFixed(2) + ')(' + th + ')² = ' + (a * th).toFixed(1) + ' + (' + (b * th * th).toFixed(1) + ') = ' + q.ans.toFixed(1) + ' µV.';
    } else if (kind === 'power') {
      a = rnd(10, 40, 2); b = -(rnd(2, 6, 1) / 100);
      var th2 = rnd(50, 250, 25);
      q.ans = a + 2 * b * th2; q.unit = 'µV/°C'; q.tolAns = 0.3;
      q.prompt = 'For E = ' + quad(a, b) + ' µV with the cold junction at 0 °C, find the thermoelectric power at θ = ' + th2 + ' °C, in µV/°C.';
      q.sol = 'Thermoelectric power is the SLOPE of the E–θ graph, so differentiate rather than divide: P = dE/dθ = a + 2bθ = ' + a + ' + 2(' + b.toFixed(2) + ')(' + th2 + ') = ' + q.ans.toFixed(2) + ' µV/°C.';
    } else if (kind === 'series') {
      var m1 = randOf(SERIES), m2 = randOf(SERIES);
      while (m2.sym === m1.sym) m2 = randOf(SERIES);
      var dth = rnd(50, 200, 25);
      q.ans = (m1.S - m2.S) * dth; q.unit = 'µV'; q.tolAns = Math.max(1, Math.abs(q.ans) * 0.01);
      q.prompt = 'Using only the linear term, estimate the thermo-EMF of a ' + m1.name + '–' + m2.name + ' couple for a temperature difference of ' + dth + ' °C. Seebeck coefficients against platinum: ' + m1.name + ' = ' + m1.S.toFixed(1) + ' µV/K, ' + m2.name + ' = ' + m2.S.toFixed(1) + ' µV/K. Answer in µV.';
      q.sol = 'The couple coefficient is the difference of the two: a = ' + m1.S.toFixed(1) + ' − (' + m2.S.toFixed(1) + ') = ' + (m1.S - m2.S).toFixed(1) + ' µV/°C. Then E ≈ a × Δθ = ' + (m1.S - m2.S).toFixed(1) + ' × ' + dth + ' = ' + q.ans.toFixed(1) + ' µV.';
    } else if (kind === 'pile') {
      var mp = randOf(SERIES.filter(function (m) { return m.sym !== 'Pt'; }));
      var mq = randOf(SERIES.filter(function (m) { return m.sym !== mp.sym; }));
      var dtp = rnd(50, 200, 25);
      var ap = Math.abs(mp.S - mq.S);
      var ep = ap * dtp;                                  /* µV per couple */
      var target = randOf([1.5, 1.8, 3.0, 5.0]);
      q.ans = Math.ceil(target * 1e6 / ep); q.unit = 'couples'; q.tolAns = 1;
      q.prompt = 'A thermopile is built from ' + mp.name + '–' + mq.name + ' couples (a = ' + ap.toFixed(1) +
        ' µV/°C) each working across a temperature difference of ' + dtp + ' °C. How many couples must be wired in series to reach ' + target + ' V?';
      q.sol = 'One couple gives E = a × Δθ = ' + ap.toFixed(1) + ' × ' + dtp + ' = ' + ep.toFixed(0) +
        ' µV. Couples in series add, so N = V / E = ' + (target * 1e6).toFixed(0) + ' µV / ' + ep.toFixed(0) +
        ' µV = ' + (target * 1e6 / ep).toFixed(1) + ', and you cannot have part of a couple, so N = ' + q.ans + '.';
    } else if (kind === 'carnot') {
      var thc = rnd(80, 400, 20), tcc = rnd(0, 40, 5);
      q.ans = (1 - (tcc + 273.15) / (thc + 273.15)) * 100; q.unit = '%'; q.tolAns = 0.4;
      q.prompt = 'A thermoelectric generator runs between a hot junction at ' + thc + ' °C and a cold junction at ' + tcc +
        ' °C. What is the Carnot limit on its efficiency, as a percentage?';
      q.sol = 'Convert to kelvin first — this is where most marks are lost. T_hot = ' + thc + ' + 273.15 = ' + (thc + 273.15).toFixed(2) +
        ' K and T_cold = ' + tcc + ' + 273.15 = ' + (tcc + 273.15).toFixed(2) + ' K. Then η = 1 − T_cold/T_hot = 1 − ' +
        (tcc + 273.15).toFixed(2) + '/' + (thc + 273.15).toFixed(2) + ' = ' + q.ans.toFixed(1) +
        '%. A real module would reach only a fraction of this because of its ZT.';
    } else {
      var tn2 = rnd(200, 350, 10), ti = rnd(420, 660, 10);
      q.ans = 2 * tn2 - ti; q.unit = '°C'; q.tolAns = 1;
      q.prompt = 'A thermocouple has a neutral temperature of ' + tn2 + ' °C and an inversion temperature of ' + ti + ' °C. At what temperature is its cold junction being held, in °C?';
      q.sol = 'From θi = 2θn − θc, rearranging gives θc = 2θn − θi = 2(' + tn2 + ') − ' + ti + ' = ' + q.ans + ' °C.';
    }

    state.pQ = q;
    setTxt('pp-prompt', q.prompt);
    setTxt('pp-unit', q.unit);
    var pi = $('pp-input'); if (pi) { pi.value = ''; pi.disabled = false; }
    var pf = $('pp-feedback'); if (pf) { pf.textContent = ''; pf.className = 'feedback'; }
    show('pp-solution', false); show('pp-next', false); show('pp-check', true);
  }

  function checkPractice() {
    var q = state.pQ; if (!q) return;
    var inp = $('pp-input'); if (!inp) return;
    var v = parseFloat(inp.value); if (isNaN(v)) return;
    state.pTotal++;
    var ok = Math.abs(v - q.ans) <= q.tolAns;
    if (ok) state.pScore++;
    var fb = $('pp-feedback');
    if (fb) {
      fb.textContent = ok ? '✓ Correct — ' + q.ans.toFixed(2) + ' ' + q.unit
        : '✗ Not quite. The answer is ' + q.ans.toFixed(2) + ' ' + q.unit;
      fb.className = 'feedback ' + (ok ? 'ok' : 'bad');
    }
    ok ? playSuccess() : playError();
    showSolution();
    inp.disabled = true;
    show('pp-check', false); show('pp-next', true);
    setTxt('pbar-score-val', state.pScore + ' / ' + state.pTotal);
  }
  function showSolution() {
    var ps = $('pp-solution');
    if (ps && state.pQ) { ps.innerHTML = '<strong>Solution.</strong> ' + state.pQ.sol; ps.style.display = ''; }
  }

