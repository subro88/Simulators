  /* ── Presets ────────────────────────────────────────────────────── */
  function renderPresets() {
    var host = $('preset-chips'); if (!host) return;
    var h = '';
    for (var i = 0; i < COUPLES.length; i++) {
      h += '<button class="preset-chip" data-couple="' + i + '" type="button" title="' + COUPLES[i].note + '">' +
        COUPLES[i].A + '–' + COUPLES[i].B + '</button>';
    }
    /* Short chip labels keep the preset strip to a single row; the full
       explanation lives in the title tooltip. */
    h += '<button class="preset-chip" data-scene="ice" type="button" title="Classic ice-bath experiment: Fe–Cu, cold junction at 0 °C, hot junction at 100 °C">Ice bath</button>';
    h += '<button class="preset-chip" data-scene="neutral" type="button" title="Jump the hot junction to the neutral temperature, where the EMF peaks and thermoelectric power is zero">At θn</button>';
    h += '<button class="preset-chip" data-scene="inverted" type="button" title="Heat past the inversion temperature so the EMF reverses and the current flows backwards">Past θi</button>';
    h += '<button class="preset-chip" data-scene="linear" type="button" title="Set the curvature b to zero — the graph becomes a straight line with no neutral or inversion temperature">b = 0</button>';
    h += '<button class="preset-chip" data-scene="same" type="button" title="Same metal on both sides — the EMFs cancel exactly and the reading is zero">Same metal</button>';
    host.innerHTML = h;
  }
  function applyCouple(i) {
    var c = COUPLES[i]; if (!c) return;
    pushUndo();
    state.mA = c.A; state.mB = c.B; state.b = c.b;
    syncControls(); refresh(); pushUndo(); playClick();
  }
  function applyScene(name) {
    pushUndo();
    var r;
    if (name === 'ice') { state.mA = 'Fe'; state.mB = 'Cu'; state.b = -0.0205; state.tc = 0; state.th = 100; }
    else if (name === 'neutral') { r = solveSchool(); if (isFinite(r.Tn)) state.th = Math.round(r.Tn); }
    else if (name === 'inverted') {
      r = solveSchool();
      if (isFinite(r.Ti)) state.th = Math.round(r.Ti + Math.max(40, Math.abs(r.Ti) * 0.15));
    } else if (name === 'linear') state.b = 0;
    else if (name === 'same') { state.mB = state.mA; }
    var bd = bound('th');
    state.th = Math.max(bd[0], Math.min(bd[1], state.th));
    syncControls(); refresh(); pushUndo(); playClick();
  }

  /* ── Init ───────────────────────────────────────────────────────── */
  function init() {
    canvas = $('sim-canvas'); if (canvas) ctx = canvas.getContext('2d');
    gcanvas = $('graph-canvas'); if (gcanvas) gctx = gcanvas.getContext('2d');

    var oh = '', i;
    for (i = 0; i < SERIES.length; i++) oh += '<option value="' + SERIES[i].sym + '">' + SERIES[i].name + ' (' + SERIES[i].sym + ')</option>';
    var sa = $('sel-ma'), sb = $('sel-mb');
    if (sa) sa.innerHTML = oh;
    if (sb) sb.innerHTML = oh;

    renderPresets();

    on2('mode-tabs', function (b) { setMode(b.getAttribute('data-mode')); playClick(); });
    on2('unit-tabs', function (b) {
      state.unit = b.getAttribute('data-unit');
      _cache.eq = _cache.cmp = _cache.co = '';
      syncControls(); refresh(); if (state.mode === 'tables') renderTable(); playClick();
    });
    bindPills('rig-tabs', 'data-rig', function (v) {
      state.rig = v; _cache.eq = _cache.cmp = _cache.co = '';
      show('btn-sim', state.mode === 'simulate' && v === 'school');
      if (v === 'school' && state.running && state.mode === 'simulate') startAnim(); else stopAnim();
    });
    bindPills('type-tabs', 'data-type', function (v) { state.type = v; clampAdvTh(); });
    bindPills('cjc-tabs', 'data-cjc', function (v) { state.cjc = v; });
    bindPills('ext-tabs', 'data-ext', function (v) { state.ext = v; });
    bindPills('std-tabs', 'data-std', function (v) { state.std = v; });
    bindPills('cls-tabs', 'data-cls', function (v) { state.cls = parseInt(v, 10); });

    if (sa) sa.addEventListener('change', function () { pushUndo(); state.mA = sa.value; _cache.cmp = ''; refresh(); pushUndo(); });
    if (sb) sb.addEventListener('change', function () { pushUndo(); state.mB = sb.value; _cache.cmp = ''; refresh(); pushUndo(); });
    var sw = $('sel-extwrong');
    if (sw) sw.addEventListener('change', function () { pushUndo(); state.extWrong = sw.value; refresh(); pushUndo(); });

    for (i = 0; i < SLIDERS.length; i++) bindSlider(SLIDERS[i]);

    var ob = $('btn-open');
    if (ob) ob.addEventListener('click', function () {
      pushUndo(); state.open = !state.open; syncControls(); refresh(); pushUndo(); playClick();
    });

    bindChk('chk-labels', 'showLabels');
    bindChk('chk-metals', 'showMetals');
    bindChk('chk-current', 'showCurrent');
    bindChk('chk-electrons', 'showElectrons');
    bindChk('chk-key', 'showKey');
    bindChk('chk-apparatus', 'showApparatus');
    bindChk('chk-eqn', 'showEqn');

    var seg = $('speed-seg');
    if (seg) seg.addEventListener('click', function (e) {
      var b = e.target.closest('button'); if (!b) return;
      state.speed = parseFloat(b.getAttribute('data-speed'));
      var all = seg.querySelectorAll('button');
      for (var i4 = 0; i4 < all.length; i4++) all[i4].classList.toggle('on', all[i4] === b);
      playClick();
    });

    var rs = $('sel-res');
    if (rs) rs.addEventListener('change', function () { state.res = parseInt(rs.value, 10); refresh(); });

    on('btn-reset', function () {
      pushUndo();
      for (var k in DEFAULTS) if (Object.prototype.hasOwnProperty.call(DEFAULTS, k)) state[k] = DEFAULTS[k];
      _cache.eq = _cache.cmp = _cache.co = '';
      syncControls(); refresh(); pushUndo(); playClick();
    });
    on('btn-sim', function () { setRunning(!state.running); playClick(); });
    on('btn-undo', doUndo);
    on('btn-redo', doRedo);
    on('btn-csv', exportCSV);
    on('btn-png', exportPNG);
    on('btn-calc', openCalc);
    on('calc-modal-close', function () { var m = $('calc-modal'); if (m) m.classList.remove('open'); });
    var cm = $('calc-modal');
    if (cm) cm.addEventListener('click', function (e) { if (e.target === cm) cm.classList.remove('open'); });

    on('learn-expand-all', function () { var c = document.querySelectorAll('.learn-card'); for (var i2 = 0; i2 < c.length; i2++) c[i2].open = true; });
    on('learn-collapse-all', function () { var c = document.querySelectorAll('.learn-card'); for (var i3 = 0; i3 < c.length; i3++) c[i3].open = false; });

    var pc = $('preset-chips');
    if (pc) pc.addEventListener('click', function (e) {
      var b = e.target.closest('.preset-chip'); if (!b) return;
      if (b.hasAttribute('data-couple')) applyCouple(parseInt(b.getAttribute('data-couple'), 10));
      else applyScene(b.getAttribute('data-scene'));
    });

    on2('cat-tabs', function (b) {
      state.exploreCat = b.getAttribute('data-cat'); state.exploreIdx = 0;
      setPills('cat-tabs', 'data-cat', state.exploreCat); renderExplore(); playClick();
    });
    var cg = $('concept-grid');
    if (cg) cg.addEventListener('click', function (e) {
      var b = e.target.closest('.is-item'); if (!b) return;
      state.exploreIdx = parseInt(b.getAttribute('data-eidx'), 10);
      renderExplore(); playClick();
    });

    on('pp-check', checkPractice);
    on('pp-show', showSolution);
    on('pp-next', newPractice);
    var pi = $('pp-input');
    if (pi) pi.addEventListener('keydown', function (e) { if (e.key === 'Enter') checkPractice(); });

    var qp = $('quiz-panel');
    if (qp) qp.addEventListener('click', function (e) {
      var o = e.target.closest('.qz-opt');
      if (o) { answerQuiz(parseInt(o.getAttribute('data-qopt'), 10)); return; }
      if (e.target.id === 'qz-next') nextQuiz();
    });
    var qr = $('quiz-result');
    if (qr) qr.addEventListener('click', function (e) { if (e.target.id === 'qz-again') startQuiz(); });

    var tt = $('tbl-type');
    if (tt) tt.addEventListener('change', function () { state.tblType = tt.value; _cache.tbl = ''; renderTable(); });
    var ts = $('tbl-step');
    if (ts) ts.addEventListener('change', function () { state.tblStep = parseInt(ts.value, 10); _cache.tbl = ''; renderTable(); });
    var tb = $('tbl-start');
    if (tb) tb.addEventListener('input', function () {
      var v = parseFloat(tb.value); if (!isNaN(v)) { state.tblStart = v; _cache.tbl = ''; renderTable(); }
    });
    on('tbl-csv', exportCSV);

    [canvas, gcanvas].forEach(function (cv) {
      if (!cv) return;
      cv.addEventListener('contextmenu', function (e) {
        e.preventDefault();
        var menu = $('ctx-menu'); if (!menu) return;
        cv.parentElement.appendChild(menu);
        var host = cv.parentElement.getBoundingClientRect();
        menu.style.display = 'block';
        var mw = menu.offsetWidth, mh = menu.offsetHeight;
        menu.style.left = Math.max(4, Math.min(e.clientX - host.left, host.width - mw - 4)) + 'px';
        menu.style.top = Math.max(4, Math.min(e.clientY - host.top, host.height - mh - 4)) + 'px';
      });
    });
    document.addEventListener('click', function () { var m = $('ctx-menu'); if (m) m.style.display = 'none'; });
    var cmn = $('ctx-menu');
    if (cmn) cmn.addEventListener('click', function (e) {
      var b = e.target.closest('.ctx-item'); if (!b) return;
      var a = b.getAttribute('data-ctx');
      if (a === 'copy-result') copyResult();
      else if (a === 'csv') exportCSV();
      else if (a === 'png') exportPNG();
      else if (a === 'reset') { var rb = $('btn-reset'); if (rb) rb.click(); }
    });

    document.addEventListener('keydown', function (e) {
      if (e.target && /INPUT|TEXTAREA|SELECT/.test(e.target.tagName)) return;
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'z') { e.preventDefault(); e.shiftKey ? doRedo() : doUndo(); }
    });

    window.addEventListener('resize', function () {
      if (state.mode === 'simulate' || state.mode === 'graph') { sizeCanvas(); refresh(); }
    });

    document.addEventListener('visibilitychange', function () {
      if (document.hidden) stopAnim();
      else if (state.running && state.mode === 'simulate' && state.rig === 'school') startAnim();
    });

    syncControls(); sizeCanvas();
    _last = snapshot();
    setMode('simulate');
    setRunning(true);
  }

  function on(id, fn) { var e = $(id); if (e) e.addEventListener('click', fn); }
  function on2(groupId, fn) {
    var g = $(groupId); if (!g) return;
    g.addEventListener('click', function (e) { var b = e.target.closest('.pill'); if (b) fn(b); });
  }
  function bindChk(id, key) {
    var e = $(id); if (!e) return;
    e.checked = !!state[key];
    e.addEventListener('change', function () { state[key] = e.checked; refresh(); });
  }
  function bindPills(groupId, attr, setter) {
    var g = $(groupId); if (!g) return;
    g.addEventListener('click', function (e) {
      var b = e.target.closest('.pill'); if (!b) return;
      pushUndo(); setter(b.getAttribute(attr));
      syncControls(); refresh(); pushUndo(); playClick();
    });
  }
  function bindSlider(s) {
    var sl = $(s.sl), inp = $(s.inp);
    if (sl) {
      sl.addEventListener('input', function () {
        state[s.key] = parseFloat(sl.value);
        if (inp) inp.value = s.temp ? Number(dT(state[s.key]).toFixed(1)) : state[s.key];
        refresh();
      });
      sl.addEventListener('change', pushUndo);
    }
    if (inp) {
      inp.addEventListener('change', function () {
        var v = parseFloat(inp.value);
        if (isNaN(v)) { syncControls(); return; }
        var si = s.temp && state.unit === 'imp' ? f2c(v) : v;
        var bd = bound(s.key);
        state[s.key] = Math.max(bd[0], Math.min(bd[1], si));
        pushUndo(); syncControls(); refresh();
      });
    }
    var wrap = inp && inp.parentElement;
    if (wrap) wrap.addEventListener('click', function (e) {
      var b = e.target.closest('.step-btn'); if (!b) return;
      var dir = parseInt(b.getAttribute('data-dir'), 10);
      var stp = parseFloat(inp.step || '1');
      var siStep = s.temp && state.unit === 'imp' ? stp * 5 / 9 : stp;
      var bd = bound(s.key);
      /* round to kill binary-float dust on the small b steps */
      var nv = Math.round((state[s.key] + dir * siStep) * 1e6) / 1e6;
      state[s.key] = Math.max(bd[0], Math.min(bd[1], nv));
      pushUndo(); syncControls(); refresh(); playClick();
    });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();

})();
