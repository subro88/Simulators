  /* Couples needed to reach a target open-circuit voltage. */
  function couplesFor(E, targetVolts) {
    if (!isFinite(E) || Math.abs(E) < 1e-9) return NaN;
    return Math.ceil(targetVolts * 1e6 / Math.abs(E));
