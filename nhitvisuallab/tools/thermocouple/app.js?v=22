    }
  }
  function advCond(g, x0, x1, y, colour, broken) {
    g.save(); g.lineCap = 'round';
    var gc = (x0 + x1) / 2;
    function path() {
      g.beginPath();
      if (broken) { g.moveTo(x0, y); g.lineTo(gc - 9, y); g.moveTo(gc + 9, y); g.lineTo(x1, y); }
      else { g.moveTo(x0, y); g.lineTo(x1, y); }
    }
    path(); g.strokeStyle = 'rgba(0,0,0,0.55)'; g.lineWidth = 6.5; g.stroke();
    path(); g.strokeStyle = colour; g.lineWidth = 4.2; g.stroke();
    if (broken) {
      g.strokeStyle = '#ff5252'; g.lineWidth = 2;
      g.beginPath(); g.moveTo(gc - 7, y - 6); g.lineTo(gc + 7, y + 6);
      g.moveTo(gc + 7, y - 6); g.lineTo(gc - 7, y + 6); g.stroke();
    }
    g.restore();
  }
  function advHead(g, x, ymid, w) {
