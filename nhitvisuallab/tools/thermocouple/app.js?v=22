    dpr = Math.min(window.devicePixelRatio || 1, 2.5);
    if (canvas) {
      var rect = canvas.getBoundingClientRect();
      if (rect.width > 0) {
        cw = Math.max(300, Math.round(rect.width));
        ch = Math.max(300, Math.round(cw * (cw < 620 ? 1.10 : 0.50)));
