        g.quadraticCurveTo(fx - 6.5, fy - 9, fx, fy - 19);
        g.quadraticCurveTo(fx + 6.5, fy - 9, fx, fy);
        var fl = g.createLinearGradient(0, fy - 19, 0, fy);
        fl.addColorStop(0, 'rgba(255,244,205,0.96)');
        fl.addColorStop(0.55, 'rgba(255,170,60,0.75)');
