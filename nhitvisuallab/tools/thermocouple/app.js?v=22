    g.strokeStyle = colour; g.lineWidth = wdt; g.stroke();
    g.strokeStyle = 'rgba(255,255,255,0.30)'; g.lineWidth = 1.1;
    g.beginPath(); g.moveTo(pts[0][0], pts[0][1] - 1.2);
    for (i = 1; i < pts.length; i++) g.lineTo(pts[i][0], pts[i][1] - 1.2);
