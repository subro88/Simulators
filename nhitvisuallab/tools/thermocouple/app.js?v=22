        '700 12px "Courier New", monospace', tempColor(state.th), 'center');
      halo(g, 'θc = ' + fmt(dT(state.tc), 0) + uT(), jx2, coldLabelY,
        '700 12px "Courier New", monospace', tempColor(state.tc), 'center');
