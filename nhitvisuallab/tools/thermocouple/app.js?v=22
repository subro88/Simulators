    drawBath(g, jx2, jy, bw, state.tc, false);

    /* Upper arm = metal A, through the galvanometer. Lower arm = metal B. */
    drawArm(g, [[jx1, jy], [jx1, topY], [gx - gR, topY]], A.col, 5);
    drawArm(g, [[gx + gR, topY], [jx2, topY], [jx2, jy]], A.col, 5);
    if (r.open) {
      /* Snap the lower arm mid-run so the loop is visibly incomplete. */
      var bx = (jx1 + jx2) / 2, gap = Math.max(12, cw * 0.022);
      drawArm(g, [[jx1, jy], [jx1, botY], [bx - gap, botY]], B.col, 5);
      drawArm(g, [[bx + gap, botY], [jx2, botY], [jx2, jy]], B.col, 5);
      drawBreak(g, bx, botY, gap);
    } else {
      drawArm(g, [[jx1, jy], [jx1, botY], [jx2, botY], [jx2, jy]], B.col, 5);
    }

    drawJunction(g, jx1, jy, state.th);
    drawJunction(g, jx2, jy, state.tc);

    var dirs = flowDirs(r);
    if (state.showCurrent && dirs.cur !== 0) {
      drawFlow(g, [[jx1, jy], [jx1, topY], [gx - gR, topY]], dirs.cur);
      drawFlow(g, [[gx + gR, topY], [jx2, topY], [jx2, jy]], dirs.cur);
      drawFlow(g, [[jx2, jy], [jx2, botY], [jx1, botY], [jx1, jy]], dirs.cur);
    }
