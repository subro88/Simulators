      while (g.measureText(eq).width > budget && fs > 7.5) { fs -= 0.5; g.font = '700 ' + fs + 'px "Courier New", monospace'; }
      g.restore();
      halo(g, eq, (cw - (cw < 620 ? 80 : 0)) / 2, Math.min(ch * 0.055, 18),
        '700 ' + fs + 'px "Courier New", monospace', '#ffd9a8', 'center');
