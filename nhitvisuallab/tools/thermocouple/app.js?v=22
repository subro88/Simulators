  function drawGalvo(g, cx, cy, R, r) {
    g.save();
    g.beginPath(); g.arc(cx, cy, R, 0, Math.PI * 2);
    var bg = g.createRadialGradient(cx - R * 0.3, cy - R * 0.4, 2, cx, cy, R);
    bg.addColorStop(0, '#2c3446'); bg.addColorStop(1, '#151b28');
    g.fillStyle = bg; g.fill();
    g.strokeStyle = '#4b5570'; g.lineWidth = 2; g.stroke();

    var pivotY = cy + R * 0.20;
    g.beginPath(); g.arc(cx, pivotY, R * 0.66, Math.PI * 1.18, Math.PI * 1.82);
    g.strokeStyle = 'rgba(190,205,230,0.5)'; g.lineWidth = 1.2; g.stroke();
    for (var i = -2; i <= 2; i++) {
      var ang = i * 0.30;
      var r1 = R * 0.58, r2 = R * 0.71;
      g.beginPath();
      g.moveTo(cx + Math.sin(ang) * r1, pivotY - Math.cos(ang) * r1);
      g.lineTo(cx + Math.sin(ang) * r2, pivotY - Math.cos(ang) * r2);
      g.strokeStyle = i === 0 ? 'rgba(255,255,255,0.75)' : 'rgba(190,205,230,0.45)';
      g.lineWidth = i === 0 ? 1.6 : 1;
      g.stroke();
    }

    /* Needle deflection saturates so a huge EMF still reads on-scale. */
    var full = 6000;
    /* The galvanometer responds to CURRENT, which is zero on an open loop
       even though the EMF is still there. */
    var reading = r.open ? 0 : (r.E || 0);
    var frac = Math.max(-1, Math.min(1, reading / full));
    var na = frac * 0.62;
    g.beginPath();
    g.moveTo(cx, pivotY);
    g.lineTo(cx + Math.sin(na) * R * 0.66, pivotY - Math.cos(na) * R * 0.66);
    g.strokeStyle = Math.abs(reading) < 0.5 ? '#8b95b3' : (reading > 0 ? '#3ddc84' : '#ff6b6b');
    g.lineWidth = 2.2; g.lineCap = 'round'; g.stroke();
    g.beginPath(); g.arc(cx, pivotY, 2.6, 0, Math.PI * 2);
    g.fillStyle = '#cbd6ea'; g.fill();

    halo(g, 'G', cx, cy - R * 0.55, '700 12px "Segoe UI", system-ui, sans-serif', '#9fb0cc', 'center');
    if (r.n > 1) {
      halo(g, '\u00D7 ' + r.n + ' couples = ' + fmtEmf(r.Vpile), cx, cy + R + (r.open ? 42 : 28),
        '700 11px "Courier New", monospace', '#9fe8a0', 'center');
    }
    halo(g, r.open ? 'I = 0' : fmtEmf(r.E), cx, cy + R + 14, '700 12.5px "Courier New", monospace',
      r.open ? '#ff9a9a' : (Math.abs(r.E) < 0.5 ? '#8b95b3' : (r.E > 0 ? '#5cffb1' : '#ff9a9a')), 'center');
    if (r.open) {
      halo(g, 'EMF still ' + fmtEmf(r.E), cx, cy + R + 28,
        '600 10px "Segoe UI", system-ui, sans-serif', '#ffd9a8', 'center');
    }
    g.restore();
  }

  /* ── Advanced (industrial NIST) rig ─────────────────────────────── */
  function drawAdvancedRig(g) {
    var r = solveAdv();
    var M = META[state.type];
    var codes = state.std === 'ansi' ? M.ansi : M.iec;
    var furW = Math.max(92, cw * 0.21);
    var furX = 12, furY = ch * 0.13, furH = ch * 0.62;
    var barY = Math.min(ch - 40, furY + furH + 24);
    var meterW = Math.max(104, cw * 0.22);
    var meterX = cw - meterW - 12;
    var headW = Math.max(40, Math.min(56, cw * 0.09));
    var runStart = furX + furW * 0.72;
    var headX = runStart + Math.max(24, (meterX - runStart - headW) / 2);
    var wireY1 = furY + furH * 0.34, wireY2 = furY + furH * 0.60;

    advFurnace(g, furX, furY, furW, furH);
    advWires(g, runStart, headX, wireY1, wireY2, codes, 'tc');
    advHead(g, headX, (wireY1 + wireY2) / 2, headW);
    advWires(g, headX + headW, meterX, wireY1, wireY2, advExtCodes(), 'ext');
    advMeter(g, meterX, furY, meterW, furH, r);

    var lo = Math.min(state.Tcj, state.Thead, state.Th);
    var hi = Math.max(state.Tcj, state.Thead, state.Th);
    if (hi - lo < 1) hi = lo + 1;
    var lg = g.createLinearGradient(furX, 0, cw - 14, 0);
    for (var i = 0; i <= 12; i++) lg.addColorStop(i / 12, tempColor(lo + (hi - lo) * i / 12));
    rr(g, furX, barY, cw - 26, 9, 4); g.fillStyle = lg; g.fill();
    g.strokeStyle = 'rgba(255,255,255,0.14)'; g.lineWidth = 1; g.stroke();
    halo(g, fmt(dT(lo), 0) + uT(), furX + 2, barY - 8, '600 9.5px "Segoe UI", system-ui, sans-serif', '#8b95b3', 'left');
    halo(g, fmt(dT(hi), 0) + uT(), cw - 16, barY - 8, '600 9.5px "Segoe UI", system-ui, sans-serif', '#8b95b3', 'right');

    if (state.showEqn) {
      halo(g, 'E = E(Tₕ) − E(T_cj) = ' + fmt(r.Eloop, 3) + ' mV', cw / 2, ch * 0.055,
        '700 12px "Courier New", monospace', '#ffd9a8', 'center');
    }
    var msg = null, col = '#ff8a80';
    if (state.open) msg = '⚠ Open circuit — indicator drives upscale (burnout protection)';
    else if (r.overRange) msg = '⚠ Compensated EMF outside the invertible ITS-90 range for type ' + state.type;
    else if (state.ext === 'wrong') msg = '⚠ Wrong extension wire — a parasitic junction is generating error EMF';
    else if (state.ext === 'copper' && Math.abs(state.Thead - state.Tcj) > 0.5) msg = '⚠ Copper leads move the reference junction to the connection head';
    else if (state.cjc === 'none') { msg = '⚠ No cold-junction compensation — reading low by roughly T_cj'; col = '#ffb347'; }
    if (msg) banner(g, cw, ch, msg, col);
  }

  function advExtCodes() {
    var M = META[state.type];
    if (state.ext === 'copper') return { p: '#c0703a', n: '#c0703a' };
    if (state.ext === 'wrong') { var W = META[state.extWrong]; return state.std === 'ansi' ? W.ansi : W.iec; }
    return state.std === 'ansi' ? M.ansi : M.iec;
  }
  function advFurnace(g, x, y, w, h) {
    var shell = g.createLinearGradient(x, y, x, y + h);
    shell.addColorStop(0, '#2c3446'); shell.addColorStop(1, '#1a2030');
    rr(g, x, y, w, h, 10); g.fillStyle = shell; g.fill();
    g.strokeStyle = '#39415a'; g.lineWidth = 1.5; g.stroke();
    var inset = 9, hot = tempColor(state.Th);
    var gs = Math.max(0, Math.min(1, (state.Th - 20) / 1200));
    var cav = g.createRadialGradient(x + w / 2, y + h / 2, 2, x + w / 2, y + h / 2, w * 0.72);
    cav.addColorStop(0, hot); cav.addColorStop(1, 'rgba(14,18,30,0.95)');
    rr(g, x + inset, y + inset, w - inset * 2, h - inset * 2, 7);
    g.fillStyle = cav; g.fill();
    if (gs > 0.02) {
      g.save(); g.globalAlpha = 0.3 * gs; g.shadowColor = hot; g.shadowBlur = 34;
      rr(g, x + inset, y + inset, w - inset * 2, h - inset * 2, 7);
      g.fillStyle = hot; g.fill(); g.restore();
    }
    var py = y + h * 0.47, tipX = x + w * 0.30, endX = x + w * 0.72;
    var sh = g.createLinearGradient(0, py - 8, 0, py + 8);
    sh.addColorStop(0, '#a8b0c0'); sh.addColorStop(0.45, '#e2e7f0');
    sh.addColorStop(0.55, '#8d94a6'); sh.addColorStop(1, '#5c6274');
    rr(g, tipX, py - 7, endX - tipX + 14, 14, 7); g.fillStyle = sh; g.fill();
    g.save(); g.shadowColor = hot; g.shadowBlur = 16;
    g.beginPath(); g.arc(tipX + 2, py, 7.5, 0, Math.PI * 2);
    g.fillStyle = hot; g.fill(); g.restore();
    if (state.showLabels) {
      halo(g, 'Tₕ ' + fmt(dT(state.Th), 0) + uT(), x + w / 2, y + h - 13,
        '700 11px "Courier New", monospace', '#ffcf8a', 'center');
    }
    halo(g, 'PROCESS', x + w / 2, y - 9, '700 10px "Segoe UI", system-ui, sans-serif', '#7d879e', 'center');
  }
  function advWires(g, x0, x1, y1, y2, codes, which) {
    var brk = state.open && which === 'tc';
    advCond(g, x0, x1, y1, codes.p, brk);
    advCond(g, x0, x1, y2, codes.n, false);
    if (state.showLabels && (x1 - x0) > 78) {
      var lbl = which === 'tc' ? 'Type ' + state.type + ' wire'
