  /* Static arrowheads — a still frame must read correctly, and this
     keeps draw() a pure function of state. */
  function drawFlow(g, pts, dir) {
    g.save();
    for (var i = 0; i < pts.length - 1; i++) {
      var x1 = pts[i][0], y1 = pts[i][1], x2 = pts[i + 1][0], y2 = pts[i + 1][1];
      var len = Math.sqrt((x2 - x1) * (x2 - x1) + (y2 - y1) * (y2 - y1));
      if (len < 28) continue;
      var mx = (x1 + x2) / 2, my = (y1 + y2) / 2;
      var ux = (x2 - x1) / len * dir, uy = (y2 - y1) / len * dir;
      /* Offset perpendicular to the wire so the gold current arrow and the
         cyan electron on the same wire do not sit on top of each other. */
      var ox = -uy * 11, oy = ux * 11;
      g.beginPath();
      g.moveTo(mx + ox + ux * 6, my + oy + uy * 6);
      g.lineTo(mx + ox - ux * 4 - uy * 4, my + oy - uy * 4 + ux * 4);
      g.lineTo(mx + ox - ux * 4 + uy * 4, my + oy - uy * 4 - ux * 4);
      g.closePath();
      g.fillStyle = '#ffe08a'; g.fill();
      g.strokeStyle = 'rgba(0,0,0,0.5)'; g.lineWidth = 0.8; g.stroke();
    }
    g.restore();
  }

  /* Closed loop, traversed J1(hot) -> arm A (upper) -> J2(cold) -> arm B. */
  function loopPath(jx1, jx2, jy, topY, botY) {
    return [[jx1, jy], [jx1, topY], [jx2, topY], [jx2, jy],
            [jx2, botY], [jx1, botY], [jx1, jy]];
  }

  function drawElectrons(g, path, dir, moving) {
    var segs = [], total = 0, i;
    for (i = 0; i < path.length - 1; i++) {
      var dx = path[i + 1][0] - path[i][0], dy = path[i + 1][1] - path[i][1];
      var L = Math.sqrt(dx * dx + dy * dy);
      if (L < 0.5) continue;
      segs.push({ x: path[i][0], y: path[i][1], ux: dx / L, uy: dy / L, L: L, s0: total });
      total += L;
    }
    if (!total) return;
    var n = Math.max(10, Math.round(total / 78));
    for (var k = 0; k < n; k++) {
      var f = k / n + (moving ? dir * state.phase : 0);
      f -= Math.floor(f);
      var d = f * total, seg = segs[segs.length - 1];
      for (i = 0; i < segs.length; i++) {
        if (d >= segs[i].s0 && d < segs[i].s0 + segs[i].L) { seg = segs[i]; break; }
      }
      var t = d - seg.s0;
      drawElectron(g, seg.x + seg.ux * t, seg.y + seg.uy * t, moving);
    }
  }

  function drawElectron(g, x, y, active) {
    g.save();
    if (active) { g.shadowColor = '#7fdbff'; g.shadowBlur = 9; }
    g.beginPath(); g.arc(x, y, 4.8, 0, Math.PI * 2);
    var gr = g.createRadialGradient(x - 1.5, y - 1.7, 0.4, x, y, 5.2);
    gr.addColorStop(0, '#eafaff');
    gr.addColorStop(0.5, active ? '#7fdbff' : '#7a8499');
    gr.addColorStop(1, active ? '#2585bd' : '#3d4761');
    g.fillStyle = gr; g.fill();
    g.shadowBlur = 0;
    g.strokeStyle = 'rgba(8,14,26,0.8)'; g.lineWidth = 1; g.stroke();
    g.beginPath(); g.moveTo(x - 2.3, y); g.lineTo(x + 2.3, y);
    g.strokeStyle = '#0b1524'; g.lineWidth = 1.6; g.stroke();
    g.restore();
  }

