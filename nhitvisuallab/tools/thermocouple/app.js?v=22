  }

  /* ── Units (display only) ───────────────────────────────────────── */
  function c2f(c) { return c * 9 / 5 + 32; }
  function f2c(f) { return (f - 32) * 5 / 9; }
  function dT(c) { return state.unit === 'imp' ? c2f(c) : c; }
  function dTd(c) { return state.unit === 'imp' ? c * 9 / 5 : c; }
  function uT() { return state.unit === 'imp' ? '°F' : '°C'; }
  function fmt(v, n) {
    if (v === null || v === undefined || !isFinite(v)) return '—';
    return v.toFixed(n === undefined ? 1 : n);
  }
  function fmtEmf(uv) {
    if (!isFinite(uv)) return '—';
    if (Math.abs(uv) >= 1000) return (uv / 1000).toFixed(3) + ' mV';
    return uv.toFixed(1) + ' µV';
