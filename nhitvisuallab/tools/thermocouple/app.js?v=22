  function tempColor(T) {
    var stops = [
      { t: -200, c: [70, 130, 210] }, { t: 0, c: [120, 170, 220] },
      { t: 100, c: [200, 160, 90] }, { t: 400, c: [235, 130, 45] },
      { t: 800, c: [245, 90, 35] }, { t: 1200, c: [255, 175, 80] }, { t: 1600, c: [255, 235, 190] }
