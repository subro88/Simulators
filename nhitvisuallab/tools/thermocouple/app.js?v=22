  /* "X → Y at the hot junction" for whichever carrier is asked for. */
  function dirText(r, electrons) {
    if (r.open) return 'open circuit';
    var d = flowDirs(r);
    if (d.cur === 0) return 'no current';
    /* path +1 leaves the hot junction through A, so current arrives via B. */
    var from = d.cur === 1 ? r.B.sym : r.A.sym;
    var to = d.cur === 1 ? r.A.sym : r.B.sym;
    if (electrons) { var t = from; from = to; to = t; }
    return from + ' → ' + to;
  }

  /* ── Solvers ────────────────────────────────────────────────────── */
  function solveSchool() {
    var A = metal(state.mA), B = metal(state.mB);
    var same = A.sym === B.sym;
    /* Both a and b are DIFFERENCES between the two metals' properties, so
       identical metals must cancel exactly — EMF, curvature and all. Without
       this guard the curvature term alone produced an EMF for a Cu-Cu loop. */
    var a = same ? 0 : A.S - B.S;
    var bEff = same ? 0 : state.b;
    var r = { a: a, b: bEff, A: A, B: B, th: state.th, tc: state.tc, same: same };
