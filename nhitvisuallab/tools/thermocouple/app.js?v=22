  function cloneQ(q) { return { q: q.q, a: q.a.slice(), c: q.c, e: q.e }; }
  function startQuiz() {
    var pool = QUIZ_BANK.slice(), i, j, t;
    for (i = pool.length - 1; i > 0; i--) { j = Math.floor(Math.random() * (i + 1)); t = pool[i]; pool[i] = pool[j]; pool[j] = t; }
    state.qList = [];
    for (i = 0; i < 5; i++) state.qList.push(cloneQ(pool[i]));
    state.qIdx = 0; state.qScore = 0; state.qAnswered = false;
    show('quiz-result', false); show('quiz-panel', true);
    renderQuiz();
  }
  function renderQuiz() {
    var p = $('quiz-panel'); if (!p) return;
    var q = state.qList[state.qIdx]; if (!q) return;
    setTxt('qbar-num', String(state.qIdx + 1));
    if (!q._order) {
      q._order = [0, 1, 2, 3];
      for (var i = 3; i > 0; i--) { var j = Math.floor(Math.random() * (i + 1)); var t = q._order[i]; q._order[i] = q._order[j]; q._order[j] = t; }
    }
    var h = '<p class="qz-q">' + q.q + '</p><div class="qz-opts">';
    for (var k = 0; k < q._order.length; k++) h += '<button class="qz-opt" data-qopt="' + q._order[k] + '" type="button">' + q.a[q._order[k]] + '</button>';
    h += '</div><div class="qz-exp" id="qz-exp" style="display:none"></div>';
    h += '<div class="qz-actions"><button class="btn btn-primary" id="qz-next" type="button" style="display:none">' +
      (state.qIdx === state.qList.length - 1 ? 'See Result' : 'Next Question →') + '</button></div>';
    p.innerHTML = h;
    state.qAnswered = false;
  }
  function answerQuiz(idx) {
    if (state.qAnswered) return;
    state.qAnswered = true;
    var q = state.qList[state.qIdx];
    var ok = idx === q.c;
    if (ok) state.qScore++;
    ok ? playSuccess() : playError();
    var btns = document.querySelectorAll('#quiz-panel .qz-opt');
    for (var i = 0; i < btns.length; i++) {
      var v = parseInt(btns[i].getAttribute('data-qopt'), 10);
      if (v === q.c) btns[i].classList.add('correct');
      else if (v === idx) btns[i].classList.add('wrong');
      btns[i].disabled = true;
    }
    var ex = $('qz-exp');
    if (ex) { ex.innerHTML = '<strong>' + (ok ? 'Correct.' : 'Not quite.') + '</strong> ' + q.e; ex.style.display = ''; }
    show('qz-next', true);
  }
  function nextQuiz() {
    if (state.qIdx < state.qList.length - 1) { state.qIdx++; renderQuiz(); }
    else showQuizResult();
  }
  function showQuizResult() {
    show('quiz-panel', false);
    var r = $('quiz-result'); if (!r) return;
    var n = state.qScore, total = state.qList.length;
    var stars = n >= 5 ? 5 : n >= 4 ? 4 : n >= 3 ? 3 : n >= 2 ? 2 : 1;
    var s = '', i;
    for (i = 0; i < 5; i++) s += i < stars ? '★' : '☆';
    var msg = n === 5 ? 'Excellent — neutral and inversion temperatures properly sorted.'
      : n >= 4 ? 'Strong. Review the one you missed and you are exam-ready.'
        : n >= 3 ? 'Good start. Work through Explore → The E–θ Graph.'
          : 'Read the Explore cards first, especially Basics and The E–θ Graph, then try again.';
    r.innerHTML = '<div class="qr-stars">' + s + '</div><div class="qr-score">' + n + ' / ' + total + '</div>' +
      '<p class="qr-msg">' + msg + '</p><button class="btn btn-primary" id="qz-again" type="button">Try Again</button>';
    r.style.display = '';
    if (n >= 4) playSuccess();
  }

  /* ── Export ─────────────────────────────────────────────────────── */
  function exportCSV() {
    var lines, name, T;
    if (state.mode === 'tables' || state.rig === 'advanced') {
      var t = state.mode === 'tables' ? state.tblType : state.type, d = TC[t];
      lines = ['# MechSimulator.com — Thermocouple type ' + t + ' reference table',
        '# NIST ITS-90 reference function, reference junction 0 C',
        'Temperature_C,EMF_mV,Sensitivity_uV_per_C'];
      for (T = d.tmin; T <= d.tmax; T += 10) {
        var e = emf(t, T), s = seebeckNIST(t, T);
        lines.push(T + ',' + (isFinite(e) ? e.toFixed(4) : '') + ',' + (isFinite(s) ? s.toFixed(3) : ''));
      }
      name = 'thermocouple_type_' + t + '_its90.csv';
    } else {
      var r = solveSchool();
      lines = ['# MechSimulator.com — ' + r.A.name + '-' + r.B.name + ' thermocouple',
        '# E = a(th - tc) + b(th^2 - tc^2),  a = ' + r.a.toFixed(2) + ' uV/C, b = ' + r.b.toFixed(4) + ' uV/C^2',
        '# Cold junction held at ' + state.tc + ' C',
        'HotJunction_C,ThermoEMF_uV,ThermoelectricPower_uV_per_C'];
      var top = isFinite(r.Ti) ? Math.ceil(r.Ti * 1.2 / 10) * 10 : 600;
      for (T = state.tc; T <= top; T += 5) {
        lines.push(T + ',' + emfSchool(r.a, r.b, T, state.tc).toFixed(2) + ',' + thermoPower(r.a, r.b, T).toFixed(3));
      }
      name = 'thermocouple_' + r.A.sym + '_' + r.B.sym + '.csv';
    }
    var blob = new Blob([lines.join('\n')], { type: 'text/csv' });
    var a2 = document.createElement('a');
    a2.href = URL.createObjectURL(blob); a2.download = name; a2.click();
    setTimeout(function () { URL.revokeObjectURL(a2.href); }, 1000);
  }

  function exportPNG() {
    var src = (state.mode === 'graph' && gcanvas) ? gcanvas : canvas;
    if (!src) return;
    var tmp = document.createElement('canvas');
    tmp.width = src.width; tmp.height = src.height;
    var tc2 = tmp.getContext('2d');
    tc2.drawImage(src, 0, 0);
    var fs = Math.round(tmp.width * 0.022); if (fs < 10) fs = 10;
    tc2.font = '600 ' + fs + 'px "Segoe UI", system-ui, sans-serif';
    tc2.textAlign = 'right'; tc2.textBaseline = 'bottom';
    tc2.fillStyle = 'rgba(255,255,255,0.25)';
    tc2.fillText('mechsimulator.com', tmp.width - 12, tmp.height - 8);
    var a3 = document.createElement('a');
    a3.href = tmp.toDataURL('image/png');
    a3.download = 'thermocouple.png';
    a3.click();
  }

