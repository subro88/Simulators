       still at different temperatures, so E is still generated. What it stops
       is the CURRENT. Keep r.E and zero the flow separately. */
    r.open = !!state.open;
    r.dT = state.th - state.tc;
    r.E = emfSchool(a, bEff, state.th, state.tc);
    r.Tn = neutralT(a, bEff);
    r.Ti = inversionT(a, bEff, state.tc);
    r.P = thermoPower(a, bEff, state.th);
    r.Emax = isFinite(r.Tn) ? emfSchool(a, bEff, r.Tn, state.tc) : NaN;
    r.n = state.nCouples;
    r.Vpile = pileVoltage(r.E, r.n);
    r.carnot = carnotLimit(state.th, state.tc);
    r.nForLed = couplesFor(r.E, 1.8);          /* a red LED needs ~1.8 V */
    /* "past inversion" means the EMF has actually changed sign */
    r.past = isFinite(r.Ti) && r.dT !== 0 && (r.E * (a * r.dT) < 0);
    r.atNeutral = isFinite(r.Tn) && Math.abs(state.th - r.Tn) < 2;
    return r;
  }

  function solveAdv() {
    var t = state.type, r = { type: t };
    var extType = state.ext === 'matched' ? t : (state.ext === 'wrong' ? state.extWrong : null);
    var Etc_h = emf(t, state.Th), Etc_head = emf(t, state.Thead);
    r.seg1 = Etc_h - Etc_head;
    r.seg2 = extType === null ? 0 : (emf(extType, state.Thead) - emf(extType, state.Tcj));
    r.Eloop = r.seg1 + r.seg2;
    r.Edrift = state.drift / 1000;
    r.Emeas = r.Eloop + r.Edrift;
    var q = Math.pow(10, state.res);
    r.Edisp = state.open ? NaN : Math.round(r.Emeas * q) / q;
    var Tsense;
    if (state.cjc === 'ice') { Tsense = 0; r.cjcAdd = emf(t, 0); }
    else if (state.cjc === 'none') { Tsense = null; r.cjcAdd = 0; }
    else { Tsense = state.Tcj + state.cjcErr; r.cjcAdd = emf(t, Tsense); }
    r.Tsense = Tsense;
    r.Etotal = r.Edisp + r.cjcAdd;
    var lim = emfLimits(t);
    r.emfOverRange = !(r.Etotal >= lim.lo - 1e-9 && r.Etotal <= lim.hi + 1e-9);
    if (state.open) { r.Tind = NaN; r.burnout = true; }
    else if (r.emfOverRange) { r.Tind = NaN; r.overRange = true; }
    else r.Tind = tempOf(t, r.Etotal);
    r.error = isFinite(r.Tind) ? r.Tind - state.Th : NaN;
    r.S = seebeckNIST(t, state.Th);
    r.tol = tolerance(t, state.cls, state.Th);
