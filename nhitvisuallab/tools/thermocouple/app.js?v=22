  function classesFor(type) { return (TOL[type] || []).map(function (r) { return r.cls; }); }

  /* ── Thermoelectric generator ────────────────────────────────────
     A thermoelectric generator (TEG) is simply N thermocouples wired in
     series, so the open-circuit output is N times a single couple's EMF.
     That is the arithmetic behind every NGSS HS-PS3-3 "convert one form of
     energy into another" build and every science-fair Peltier project.    */
  function pileVoltage(E, n) { return E * n; }

  /* Carnot limit on ANY heat engine working between these two junctions.
     Must be evaluated in kelvin — using °C is the classic student error. */
  function carnotLimit(th, tc) {
    var Th = Math.max(th, tc) + 273.15;
    var Tc = Math.min(th, tc) + 273.15;
    if (!(Th > 0) || !(Tc >= 0)) return NaN;
    return 1 - Tc / Th;
