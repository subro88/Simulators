    if (state.showElectrons) {
      drawElectrons(g, loopPath(jx1, jx2, jy, topY, botY), dirs.ele, dirs.ele !== 0);
    }

    drawGalvo(g, gx, gy, gR, r);
    if (state.showKey) drawFlowLegend(g, r);

    if (state.showMetals) {
      /* Metal A sits on the left half of the upper arm so it never collides
         with the centred equation strip above the galvanometer. */
      halo(g, A.name + ' (' + A.sym + ')', (jx1 + gx - gR) / 2, topY - 13,
        '600 11.5px "Segoe UI", system-ui, sans-serif', A.col, 'center');
      halo(g, B.name + ' (' + B.sym + ')', gx, botY + 15,
        '600 11.5px "Segoe UI", system-ui, sans-serif', B.col, 'center');
    }
    if (state.showLabels) {
      halo(g, 'HOT junction', jx1, jy - bw * 0.56 - 13,
        '700 10.5px "Segoe UI", system-ui, sans-serif', '#ffb066', 'center');
      halo(g, 'COLD junction', jx2, jy - bw * 0.56 - 13,
        '700 10.5px "Segoe UI", system-ui, sans-serif', '#7fc8ff', 'center');
      /* The hot beaker has a tripod and flames beneath it, so its label
         needs to clear them; the cold beaker sits straight on the bench. */
      /* The hot beaker has a tripod and flames beneath it, so its label needs
         to clear them — but never at the cost of colliding with the lower arm. */
      var hotLabelY = Math.min(jy + bw * 0.51 + 38, botY - 17);
      var coldLabelY = Math.min(jy + bw * 0.51 + 17, botY - 17);
