    else { liq.addColorStop(0, 'rgba(154,208,255,0.44)'); liq.addColorStop(1, 'rgba(64,134,212,0.56)'); }
    g.fillStyle = liq; g.fill();
    /* meniscus */
    g.beginPath(); g.moveTo(x + 3, ly); g.lineTo(x + w - 3, ly);
    g.strokeStyle = hot ? 'rgba(255,214,168,0.75)' : 'rgba(196,232,255,0.8)';
    g.lineWidth = 1.4; g.stroke();

    /* Burner flames, bubbles and ice cubes are decoration — the glassware and
