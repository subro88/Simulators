  /* ── Show calculations ──────────────────────────────────────────── */
  function openCalc() {
    var bEl = $('calc-modal-body'); if (!bEl) return;
    var h = '';
    if (state.rig === 'school') {
      var r = solveSchool();
      h += '<p>Couple: <strong>' + r.A.name + ' – ' + r.B.name + '</strong>.</p>';
      h += '<h4>Step 1 — the couple coefficient a</h4>';
      h += '<p>Each metal has a Seebeck coefficient measured against platinum. The couple uses the difference between them.</p>';
      h += '\\[ a = S_{' + r.A.sym + '} - S_{' + r.B.sym + '} = ' + r.A.S.toFixed(1) + ' - (' + r.B.S.toFixed(1) + ') = ' + r.a.toFixed(1) + '\\ \\mu\\text{V}/^\\circ\\text{C} \\]';
      h += '<h4>Step 2 — thermo-EMF</h4>';
      h += '\\[ E = a(\\theta_h-\\theta_c)+b(\\theta_h^2-\\theta_c^2) \\]';
      h += '\\[ E = ' + r.a.toFixed(1) + '(' + state.th + '-' + state.tc + ') + (' + r.b.toFixed(4) + ')(' + state.th + '^2-' + state.tc + '^2) = ' + r.E.toFixed(1) + '\\ \\mu\\text{V} \\]';
      h += '<h4>Step 3 — neutral temperature</h4>';
      if (isFinite(r.Tn)) {
        h += '<p>Set the slope to zero: dE/dθ = a + 2bθ = 0.</p>';
        h += '\\[ \\theta_n = -\\frac{a}{2b} = ' + r.Tn.toFixed(1) + '\\ ^\\circ\\text{C} \\]';
        h += '<h4>Step 4 — inversion temperature</h4>';
        h += '\\[ \\theta_i = 2\\theta_n - \\theta_c = ' + r.Ti.toFixed(1) + '\\ ^\\circ\\text{C} \\]';
      } else {
        h += '<p>With b = 0 the graph is a straight line, so there is no maximum and no neutral or inversion temperature.</p>';
      }
      h += '<h4>Step 5 — thermoelectric power</h4>';
      h += '\\[ P = \\frac{dE}{d\\theta_h} = a + 2b\\theta_h = ' + r.P.toFixed(2) + '\\ \\mu\\text{V}/^\\circ\\text{C} \\]';
      h += '<p class="eq-note">a is computed from measured Seebeck coefficients (Cardarelli, <em>Materials Handbook</em>). b is the curvature term — real values are small and material-specific, so the presets use representative textbook values.</p>';
    } else {
      var q = solveAdv();
      h += '<p>Type <strong>' + state.type + '</strong> (' + META[state.type].alloys + '), NIST ITS-90.</p>';
      h += '<h4>Step 1 — segment EMFs</h4>';
      h += '\\[ E(T_h)=' + emf(state.type, state.Th).toFixed(4) + ',\\quad E(T_{head})=' + emf(state.type, state.Thead).toFixed(4) + '\\ \\text{mV} \\]';
      h += '<h4>Step 2 — sum round the loop</h4>';
      h += '\\[ E_{loop} = ' + q.seg1.toFixed(4) + ' + (' + q.seg2.toFixed(4) + ') = ' + q.Eloop.toFixed(4) + '\\ \\text{mV} \\]';
      h += '<h4>Step 3 — cold-junction compensation</h4>';
      h += '\\[ E_{total} = ' + q.Edisp.toFixed(4) + ' + ' + q.cjcAdd.toFixed(4) + ' = ' + q.Etotal.toFixed(4) + '\\ \\text{mV} \\]';
      h += '<h4>Step 4 — invert</h4>';
      if (isFinite(q.Tind)) h += '\\[ T_{ind}=E^{-1}(' + q.Etotal.toFixed(4) + ')=' + q.Tind.toFixed(2) + '\\ ^\\circ\\text{C} \\]';
      else h += '<p>The loop is faulted, so no temperature can be computed.</p>';
    }
    bEl.innerHTML = h;
    var m = $('calc-modal'); if (m) m.classList.add('open');
  }

  /* ── Undo / redo ────────────────────────────────────────────────── */
  var SNAP_KEYS = ['rig', 'mA', 'mB', 'b', 'th', 'tc', 'nCouples', 'type', 'Th', 'Thead', 'Tcj',
    'ext', 'extWrong', 'cjc', 'cjcErr', 'drift', 'open', 'cls', 'res'];
  function snapshot() {
    var o = {};
    for (var i = 0; i < SNAP_KEYS.length; i++) o[SNAP_KEYS[i]] = state[SNAP_KEYS[i]];
    return JSON.stringify(o);
  }
  var _last = null;
  function pushUndo() {
    var s = snapshot();
    if (s === _last) return;
    if (_last !== null) { state.undo.push(_last); if (state.undo.length > 60) state.undo.shift(); }
    _last = s; state.redo.length = 0;
  }
  function applySnap(s) {
    var o = JSON.parse(s);
    for (var k in o) if (Object.prototype.hasOwnProperty.call(o, k)) state[k] = o[k];
    _last = s; _cache.eq = _cache.cmp = _cache.co = '';
    syncControls(); refresh();
  }
  function doUndo() { if (!state.undo.length) return; state.redo.push(_last); applySnap(state.undo.pop()); playClick(); }
  function doRedo() { if (!state.redo.length) return; state.undo.push(_last); applySnap(state.redo.pop()); playClick(); }

  /* ── Controls ───────────────────────────────────────────────────── */
  var SLIDERS = [
    { key: 'th', sl: 'sl-th', inp: 'in-th', min: -200, max: 900, temp: true },
    { key: 'tc', sl: 'sl-tc', inp: 'in-tc', min: -50, max: 200, temp: true },
    { key: 'b', sl: 'sl-b', inp: 'in-b', min: -0.12, max: 0.12, temp: false },
    { key: 'nCouples', sl: 'sl-n', inp: 'in-n', min: 1, max: 500, temp: false },
    { key: 'Th', sl: 'sl-ath', inp: 'in-ath', min: -200, max: 1372, temp: true },
    { key: 'Thead', sl: 'sl-thead', inp: 'in-thead', min: -50, max: 250, temp: true },
    { key: 'Tcj', sl: 'sl-tcj', inp: 'in-tcj', min: -20, max: 80, temp: true },
    { key: 'cjcErr', sl: 'sl-cjcerr', inp: 'in-cjcerr', min: -5, max: 5, temp: false },
    { key: 'drift', sl: 'sl-drift', inp: 'in-drift', min: -200, max: 200, temp: false }
  ];
  function bound(key) {
    if (key === 'Th') return INV_T[state.type];
    for (var i = 0; i < SLIDERS.length; i++) if (SLIDERS[i].key === key) return [SLIDERS[i].min, SLIDERS[i].max];
    return [-1e9, 1e9];
  }
  function clampAdvTh() {
    var t = INV_T[state.type];
    state.Th = Math.max(t[0], Math.min(t[1], state.Th));
    var sl = $('sl-ath');
    if (sl) { sl.min = t[0]; sl.max = t[1]; sl.value = state.Th; }
  }

  function syncControls() {
    clampAdvTh();
    for (var i = 0; i < SLIDERS.length; i++) {
      var s = SLIDERS[i], sl = $(s.sl), inp = $(s.inp);
      if (sl) sl.value = state[s.key];
      if (inp) inp.value = s.temp ? Number(dT(state[s.key]).toFixed(1)) : state[s.key];
    }
    setPills('rig-tabs', 'data-rig', state.rig);
    setPills('unit-tabs', 'data-unit', state.unit);
    setPills('type-tabs', 'data-type', state.type);
    setPills('cjc-tabs', 'data-cjc', state.cjc);
    setPills('ext-tabs', 'data-ext', state.ext);
    setPills('std-tabs', 'data-std', state.std);
    setPills('cls-tabs', 'data-cls', String(state.cls));
    var sa = $('sel-ma'); if (sa) sa.value = state.mA;
    var sb = $('sel-mb'); if (sb) sb.value = state.mB;
    var sw = $('sel-extwrong'); if (sw) sw.value = state.extWrong;
    show('school-controls', state.rig === 'school');
    show('adv-controls', state.rig === 'advanced');
    show('school-readouts', state.rig === 'school');
    show('adv-readouts', state.rig === 'advanced');
    show('ext-wrong-row', state.ext === 'wrong');
    show('cjcerr-row', state.cjc === 'internal');
    var ob = $('btn-open'); if (ob) ob.classList.toggle('on', state.open);
    var ct = $('cls-tabs');
    if (ct) {
      var avail = classesFor(state.type);
      var btns = ct.querySelectorAll('.pill');
      for (var b2 = 0; b2 < btns.length; b2++) {
        var c = parseInt(btns[b2].getAttribute('data-cls'), 10);
        btns[b2].style.display = avail.indexOf(c) >= 0 ? '' : 'none';
      }
      if (avail.indexOf(state.cls) < 0) { state.cls = avail[0]; setPills('cls-tabs', 'data-cls', String(state.cls)); }
    }
    var us = document.querySelectorAll('[data-ulabel="temp"]');
    for (var u = 0; u < us.length; u++) us[u].textContent = uT();
  }
  function setPills(groupId, attr, val) {
    var g = $(groupId); if (!g) return;
    var b = g.querySelectorAll('.pill');
    for (var i = 0; i < b.length; i++) b[i].classList.toggle('active', b[i].getAttribute(attr) === val);
  }

  function refresh() {
    if (state.mode === 'simulate') draw();
    if (state.mode === 'graph') drawGraph();
    updateAll();
    if (state.mode === 'tables') renderTable();
  }

  function setMode(m) {
    state.mode = m;
    setPills('mode-tabs', 'data-mode', m);
    /* Both canvases share one card so the action bar at its foot serves both. */
    show('canvas-card', m === 'simulate' || m === 'graph');
    show('sim-stage', m === 'simulate');
    show('graph-stage', m === 'graph');
    show('graph-hint', m === 'graph');
    show('canvas-action-bar', m === 'simulate' || m === 'graph');
    show('sim-wrap', m === 'simulate' || m === 'graph');
    show('learn-panels', m === 'simulate' || m === 'graph');
    show('tables-wrap', m === 'tables');
    show('cat-row', m === 'explore');
    show('item-selector', m === 'explore');
    show('item-info', m === 'explore');
    show('practice-panel', m === 'practice');
    show('practice-bar', m === 'practice');
    show('quiz-panel', m === 'quiz');
    show('quiz-bar', m === 'quiz');
    show('readout-badges', m === 'simulate' || m === 'graph');
    if (m !== 'quiz') show('quiz-result', false);
