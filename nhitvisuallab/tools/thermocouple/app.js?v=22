  /* ── Direction of flow ───────────────────────────────────────────
     From grad(V) = -S grad(T), walking A_cold -> A_hot -> B_hot -> B_cold
     gives V_Acold - V_Bcold = (S_A - S_B)*dT = a*dT. So when a*dT > 0 the
     A-side cold end is the + terminal, and conventional current must enter A
     at the HOT junction coming from B:

       conventional current, hot junction : LOWER-S metal -> HIGHER-S metal
       electron flow,        hot junction : HIGHER-S metal -> LOWER-S metal

     Checks out against both standard mnemonics: Cu -> Fe at the hot junction
     for a copper-iron couple, and Bi -> Sb at the hot junction (equivalently
     Sb -> Bi at the cold junction) for antimony-bismuth.

     The drawing loop is traversed J1(hot) -> arm A -> J2(cold) -> arm B -> J1,
     which leaves J1 through A — so path direction +1 IS the conventional
     current whenever E > 0, and electrons run at -1.                      */
  function flowDirs(r) {
    if (r.open) return { cur: 0, ele: 0 };
    if (!isFinite(r.E) || Math.abs(r.E) < 0.5) return { cur: 0, ele: 0 };
    var cur = r.E > 0 ? 1 : -1;
    return { cur: cur, ele: -cur };
