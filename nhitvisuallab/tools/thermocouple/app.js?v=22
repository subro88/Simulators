    var msg = null, col = '#ffb347';
    if (r.open) { msg = 'Open circuit — the EMF is still generated, but with no complete loop no current can flow.'; col = '#ff8a80'; }
    else if (r.dT === 0) msg = 'Both junctions at the same temperature — no thermo-EMF, no current.';
    else if (Math.abs(r.a) < 0.05) msg = 'Same metal on both sides — the two EMFs cancel exactly. Pick two different metals.';
    else if (r.past) { msg = 'Past the inversion temperature — the EMF has reversed and the current flows backwards.'; col = '#ff8a80'; }
    else if (r.atNeutral) { msg = 'At the neutral temperature — EMF is maximum and thermoelectric power is zero.'; col = '#3ddc84'; }
    if (msg) banner(g, cw, ch, msg, col);
