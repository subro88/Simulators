      for (i = 0; i < cubes.length; i++) {
        var ix = x + w * cubes[i][0], iy = ly + lh * cubes[i][1];
        rr(g, ix - 6.5, iy - 5, 13, 10, 2.5);
        g.fillStyle = 'rgba(238,249,255,0.86)'; g.fill();
        g.strokeStyle = 'rgba(255,255,255,0.65)'; g.lineWidth = 0.8; g.stroke();
        g.beginPath();
        g.moveTo(ix - 3.5, iy - 2.4); g.lineTo(ix + 1, iy - 2.4);
        g.strokeStyle = 'rgba(255,255,255,0.75)'; g.lineWidth = 0.9; g.stroke();
      }
    }
  }

  function drawArm(g, pts, colour, wdt) {
    g.save();
    g.lineCap = 'round'; g.lineJoin = 'round';
