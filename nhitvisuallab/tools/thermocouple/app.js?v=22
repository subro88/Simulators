    if (!state.showApparatus) return;
    if (hot) {
      /* bubbles */
      g.fillStyle = 'rgba(255,232,198,0.7)';
      var bub = [[0.24, 0.34], [0.50, 0.60], [0.72, 0.26], [0.38, 0.76], [0.62, 0.44]];
      for (i = 0; i < bub.length; i++) {
        g.beginPath();
        g.arc(x + w * bub[i][0], ly + lh * bub[i][1], 1.6 + (i % 3) * 0.7, 0, Math.PI * 2);
