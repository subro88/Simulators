/* ── Hardness conversion chart: live filter ──────────────────────────────
   Independent of the simulator above; the chart is static HTML so it stays
   crawlable, and this only hides rows client-side.                        */
(function () {
  'use strict';

  var input = document.getElementById('hc-filter');
  var table = document.getElementById('hc-table');
  var count = document.getElementById('hc-count');
  if (!input || !table) return;

  var rows = Array.prototype.slice.call(table.tBodies[0].rows);
  var total = rows.length;

  function report(shown) {
    if (!count) return;
    count.textContent = shown === total
      ? total + ' rows'
      : shown + ' of ' + total + ' rows';
  }

  function apply() {
    var q = input.value.trim();
    if (!q) {
      rows.forEach(function (r) { r.hidden = false; });
      report(total);
      return;
    }
    // Only the four hardness-scale columns are searchable. The tensile columns
    // are excluded on purpose: searching "58" (HRC) would otherwise also match
    // 585 MPa and 58 ksi rows and bury the answer.
    var SCALE_COLS = 4;
    var shown = 0;
    rows.forEach(function (r) {
      var hit = false;
      for (var k = 0; k < SCALE_COLS && k < r.cells.length; k++) {
        if (r.cells[k].textContent.trim().indexOf(q) === 0) { hit = true; break; }
      }
      r.hidden = !hit;
      if (hit) shown++;
    });
    if (shown === 0) {
      // No exact match (the table steps in increments) - fall back to the
      // numerically nearest row on any scale so the user still gets an answer.
      var target = parseFloat(q);
      if (!isNaN(target)) {
        var best = null, bestDiff = Infinity;
        rows.forEach(function (r) {
          for (var k = 0; k < SCALE_COLS && k < r.cells.length; k++) {
            var v = parseFloat(r.cells[k].textContent);
            if (isNaN(v)) continue;
            var d = Math.abs(v - target);
            if (d < bestDiff) { bestDiff = d; best = r; }
          }
        });
        if (best) { best.hidden = false; shown = 1; }
      }
    }
    report(shown);
  }

  input.addEventListener('input', apply);
  report(total);
})();

/* ── Hardness converter ──────────────────────────────────────────────────
   Reads its data straight out of the conversion table in the DOM, so the
   converter and the published chart can never disagree. Columns are
   0=HBW 1=HV 2=HRC 3=HRB 4=UTS MPa 5=UTS ksi.                            */
(function () {
  'use strict';

  var input = document.getElementById('hc-in');
  var scale = document.getElementById('hc-scale');
  var out = document.getElementById('hc-conv-out');
  var clr = document.getElementById('hc-conv-clear');
  var table = document.getElementById('hc-table');
  if (!input || !scale || !out || !table) return;

  var NAMES = ['HBW', 'HV', 'HRC', 'HRB', 'MPa', 'ksi'];
  var LABEL = ['Brinell HBW', 'Vickers HV', 'Rockwell C', 'Rockwell B',
               'Tensile (MPa)', 'Tensile (ksi)'];

  // Parse the table once. "—" becomes null so gaps are never treated as 0.
  var ROWS = Array.prototype.map.call(table.tBodies[0].rows, function (r) {
    return Array.prototype.map.call(r.cells, function (c) {
      var t = c.textContent.trim();
      if (!t || t === '—') return null;
      var n = parseFloat(t);
      return isFinite(n) ? n : null;
    });
  });

  function interp(col, val) {
    // Rows are sorted hardest-first, so col values descend.
    var have = ROWS.filter(function (r) { return r[col] !== null; });
    if (!have.length) return null;
    var hi = have[0][col], lo = have[have.length - 1][col];
    if (val > hi || val < lo) return { out: null, range: [lo, hi] };

    for (var i = 0; i < have.length - 1; i++) {
      var a = have[i], b = have[i + 1];
      if (val <= a[col] && val >= b[col]) {
        var span = a[col] - b[col];
        var f = span === 0 ? 0 : (a[col] - val) / span;   // 0 at a, 1 at b
        var res = [];
        for (var k = 0; k < 6; k++) {
          if (a[k] === null || b[k] === null) { res.push(null); continue; }
          res.push(a[k] + (b[k] - a[k]) * f);
        }
        return { out: res, exact: (f === 0 || f === 1) };
      }
    }
    return { out: null, range: [lo, hi] };
  }

  function convert() {
    var v = parseFloat(input.value);
    var col = parseInt(scale.value, 10);
    if (input.value.trim() === '') { out.textContent = ''; return; }
    if (!isFinite(v)) { out.innerHTML = '<span class="hc-err">Enter a number.</span>'; return; }

    var r = interp(col, v);
    if (!r) { out.innerHTML = '<span class="hc-err">No data for that scale.</span>'; return; }
    if (!r.out) {
      out.innerHTML = '<span class="hc-err">' + v + ' ' + NAMES[col] +
        ' is outside the convertible range (' + r.range[0] + '–' + r.range[1] +
        ' ' + NAMES[col] + ').</span>';
      return;
    }

    var parts = [];
    for (var k = 0; k < 6; k++) {
      if (k === col || r.out[k] === null) continue;
      var dp = (k === 4 || k === 5) ? 0 : (k === 2 || k === 3 ? 1 : 0);
      parts.push(LABEL[k] + ' <strong>' + r.out[k].toFixed(dp) + '</strong>');
    }
    out.innerHTML = '<span class="hc-hit">' + v + ' ' + NAMES[col] + '  →  ' +
      parts.join(' &nbsp;·&nbsp; ') + '</span>' +
      '<span class="hc-note">Carbon and alloy steel, per ASTM E140. Interpolated between table rows; conversions are approximate and are not valid for austenitic stainless, cast iron or non-ferrous alloys.</span>';
  }

  input.addEventListener('input', convert);
  scale.addEventListener('change', convert);
  if (clr) clr.addEventListener('click', function () { input.value = ''; out.textContent = ''; input.focus(); });
})();
