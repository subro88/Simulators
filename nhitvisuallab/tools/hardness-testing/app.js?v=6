  function draw() {
    ctx.clearRect(0, 0, W, H);

    /* Background */
    ctx.fillStyle = '#0d1117';
    ctx.fillRect(0, 0, W, H);

    /* Subtle grid */
    ctx.strokeStyle = 'rgba(42,48,80,0.3)';
    ctx.lineWidth = 0.5;
    for (var gx = 0; gx < W; gx += 30) {
      ctx.beginPath(); ctx.moveTo(gx, 0); ctx.lineTo(gx, H); ctx.stroke();
    }
    for (var gy = 0; gy < H; gy += 30) {
      ctx.beginPath(); ctx.moveTo(0, gy); ctx.lineTo(W, gy); ctx.stroke();
    }

    /* Split canvas: left = machine view, right = measurement view */
    var midX = 430;

    drawMachineView(20, 20, midX - 40, H - 40);
    drawMeasurementView(midX + 20, 20, W - midX - 40, H - 40);

    /* Divider line */
    ctx.strokeStyle = 'rgba(42,48,80,0.6)';
    ctx.lineWidth = 1;
    ctx.setLineDash([6, 4]);
    ctx.beginPath();
    ctx.moveTo(midX, 20);
    ctx.lineTo(midX, H - 20);
    ctx.stroke();
    ctx.setLineDash([]);

    /* Section labels */
    ctx.fillStyle = '#6b7a99';
    ctx.font = '600 11px "Segoe UI", system-ui, sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText('TESTING MACHINE', (20 + midX - 40) / 2 + 20, H - 8);
    ctx.fillText('MEASUREMENT VIEW', midX + 20 + (W - midX - 40) / 2, H - 8);
  }

  /* ── Machine Side View ─────────────────────────────────────────── */
  function drawMachineView(x, y, w, h) {
    var mat = MATERIALS[state.materialIdx];
    var params = getTestParams();
    var method = state.testMethod;

    /* Machine frame */
    var frameX = x + 40;
    var frameW = w - 80;
    var frameY = y + 30;
    var frameH = h - 70;

    /* Outer housing */
    ctx.fillStyle = '#1a2030';
    ctx.strokeStyle = '#2a3050';
    ctx.lineWidth = 2;
    roundRect(ctx, frameX, frameY, frameW, frameH, 8);
    ctx.fill();
    ctx.stroke();

    /* Inner panel */
    ctx.fillStyle = '#141a26';
    ctx.strokeStyle = '#222840';
    ctx.lineWidth = 1;
    roundRect(ctx, frameX + 10, frameY + 10, frameW - 20, frameH - 20, 5);
    ctx.fill();
    ctx.stroke();

    /* Base/anvil */
    var baseY = frameY + frameH - 50;
    var baseH = 30;
    ctx.fillStyle = '#37474f';
    roundRect(ctx, frameX + 20, baseY, frameW - 40, baseH, 4);
    ctx.fill();
    ctx.strokeStyle = '#455a64';
    ctx.lineWidth = 1;
    roundRect(ctx, frameX + 20, baseY, frameW - 40, baseH, 4);
    ctx.stroke();

    /* Specimen on base */
    var specW = frameW * 0.5;
    var specH = 40;
    var specX = frameX + (frameW - specW) / 2;
    var specY = baseY - specH;
    ctx.fillStyle = mat.color;
    roundRect(ctx, specX, specY, specW, specH, 3);
    ctx.fill();
    ctx.strokeStyle = adjustAlpha(mat.color, 0.7);
    ctx.lineWidth = 1;
    roundRect(ctx, specX, specY, specW, specH, 3);
    ctx.stroke();

    /* Material label */
    ctx.fillStyle = '#dde3f0';
    ctx.font = '600 11px "Segoe UI", system-ui, sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText(mat.name, specX + specW / 2, specY + specH / 2 + 4);

    /* Handwheel / load mechanism at top */
    var hwCx = frameX + frameW / 2;
    var hwCy = frameY + 30;
    ctx.fillStyle = '#455a64';
    ctx.beginPath();
    ctx.arc(hwCx, hwCy, 14, 0, Math.PI * 2);
    ctx.fill();
    ctx.fillStyle = '#37474f';
    ctx.beginPath();
    ctx.arc(hwCx, hwCy, 8, 0, Math.PI * 2);
    ctx.fill();
    ctx.fillStyle = '#546e7a';
    ctx.beginPath();
    ctx.arc(hwCx, hwCy, 3, 0, Math.PI * 2);
    ctx.fill();

    /* Spindle/shaft from handwheel to indenter */
    var shaftTop = hwCy + 14;
    var indenterBaseY = specY - 2; /* Where the indenter rests when fully retracted */
    var indenterTopY = frameY + 60;

    /* Calculate indenter position based on animation */
    var indenterY = indenterTopY;
    var indenterPenetration = 0; /* How deep the indenter is in the specimen */
    var maxPen = method === 'rockwell' ? 12 : (method === 'brinell' ? 14 : 10);
    /* Scale penetration based on hardness — softer = deeper */
    var hardnessNorm = params.hardness / 700; /* Normalize */
    maxPen = maxPen * (1 - hardnessNorm * 0.5);

    if (state.animPhase === 'descending') {
      var t = easeInOut(state.animProgress);
      indenterY = lerp(indenterTopY, indenterBaseY - maxPen, t);
    } else if (state.animPhase === 'indenting') {
      indenterY = indenterBaseY - maxPen;
      indenterPenetration = lerp(0, maxPen, easeOut(state.animProgress));
    } else if (state.animPhase === 'holding') {
      indenterY = indenterBaseY - maxPen;
      indenterPenetration = maxPen;
    } else if (state.animPhase === 'retracting') {
      var t2 = easeInOut(state.animProgress);
      indenterY = lerp(indenterBaseY - maxPen, indenterTopY, t2);
      indenterPenetration = lerp(maxPen, 0, t2);
    } else if (state.animPhase === 'measuring' || state.testComplete) {
      indenterY = indenterTopY;
      indenterPenetration = 0;
    }

    /* Draw shaft */
    ctx.fillStyle = '#546e7a';
    ctx.fillRect(hwCx - 4, shaftTop, 8, indenterY - shaftTop);

    /* Draw indenter holder */
    ctx.fillStyle = '#607d8b';
    roundRect(ctx, hwCx - 16, indenterY, 32, 20, 3);
    ctx.fill();
    ctx.strokeStyle = '#78909c';
    ctx.lineWidth = 1;
    roundRect(ctx, hwCx - 16, indenterY, 32, 20, 3);
    ctx.stroke();

    /* Draw indenter tip based on method */
    var tipY = indenterY + 20;
    drawIndenter(hwCx, tipY, method, state.rockwellScale, 1.0);

    /* Draw indentation on specimen if penetrating or complete */
    if (indenterPenetration > 0 || state.testComplete || state.animPhase === 'measuring') {
      drawIndentationOnSpecimen(specX, specY, specW, specH, method, mat, maxPen,
        state.testComplete || state.animPhase === 'measuring' ? maxPen : indenterPenetration);
    }

    /* Load arrow */
    if (state.animPhase === 'indenting' || state.animPhase === 'holding' || state.animPhase === 'descending') {
      var arrowX = frameX + frameW - 30;
      var arrowY1 = frameY + 50;
      var arrowY2 = frameY + 100;
      ctx.strokeStyle = '#e53935';
      ctx.lineWidth = 3;
      ctx.beginPath();
      ctx.moveTo(arrowX, arrowY1);
      ctx.lineTo(arrowX, arrowY2);
      ctx.stroke();
      /* Arrowhead */
      ctx.fillStyle = '#e53935';
      ctx.beginPath();
      ctx.moveTo(arrowX, arrowY2 + 8);
      ctx.lineTo(arrowX - 6, arrowY2);
      ctx.lineTo(arrowX + 6, arrowY2);
      ctx.closePath();
      ctx.fill();
      /* Load label */
      ctx.fillStyle = '#ef9a9a';
      ctx.font = 'bold 12px "Courier New", monospace';
      ctx.textAlign = 'center';
      ctx.fillText('F=' + roundN(toD(params.F, 'force'), 1) + ' ' + uLabel('force'), arrowX, arrowY1 - 6);
    }

    /* Method label */
    ctx.fillStyle = '#e53935';
    ctx.font = 'bold 14px "Segoe UI", system-ui, sans-serif';
    ctx.textAlign = 'center';
    var methodLabel = method === 'brinell' ? 'BRINELL TEST' :
                      method === 'rockwell' ? 'ROCKWELL ' + state.rockwellScale + ' TEST' :
                      'VICKERS TEST';
    ctx.fillText(methodLabel, frameX + frameW / 2, frameY + frameH + 16);

    /* Phase indicator */
    if (state.animPhase !== 'idle') {
      var phaseLabels = {
        descending: 'Approaching specimen...',
        indenting: 'Applying load...',
        holding: 'Holding under load...',
        retracting: 'Removing load...',
        measuring: 'Measuring impression...'
      };
      ctx.fillStyle = '#f5c842';
      ctx.font = '600 11px "Segoe UI", system-ui, sans-serif';
      ctx.textAlign = 'left';
      ctx.fillText(phaseLabels[state.animPhase] || '', frameX + 15, frameY + frameH - 10);
    }
  }

  /* ── Draw Indenter Based on Method ─────────────────────────────── */
  function drawIndenter(cx, tipY, method, scale, alpha) {
    ctx.globalAlpha = alpha;

    if (method === 'brinell') {
      /* Ball indenter */
      var ballR = 12 + state.ballDiamIdx * 3;
      ctx.fillStyle = '#90a4ae';
      ctx.beginPath();
      ctx.arc(cx, tipY + ballR, ballR, 0, Math.PI * 2);
      ctx.fill();
      /* Highlight */
      ctx.fillStyle = 'rgba(255,255,255,0.15)';
      ctx.beginPath();
      ctx.arc(cx - 3, tipY + ballR - 3, ballR * 0.4, 0, Math.PI * 2);
      ctx.fill();
      /* Label */
      ctx.fillStyle = '#dde3f0';
      ctx.font = '600 9px "Segoe UI", system-ui, sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText(roundN(toD(BALL_DIAMETERS[state.ballDiamIdx], 'length'), 2) + ' ' + uLabel('length'), cx, tipY + ballR + ballR + 12);
    } else if (method === 'rockwell') {
      if (scale === 'B') {
        /* Small ball indenter (1/16") */
        var rBall = 8;
        ctx.fillStyle = '#90a4ae';
        ctx.beginPath();
        ctx.arc(cx, tipY + rBall, rBall, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = 'rgba(255,255,255,0.15)';
        ctx.beginPath();
        ctx.arc(cx - 2, tipY + rBall - 2, rBall * 0.35, 0, Math.PI * 2);
        ctx.fill();
      } else {
        /* Diamond cone (120 degrees) */
        var coneH = 28;
        var coneW = 16;
        ctx.fillStyle = '#e0e0e0';
        ctx.beginPath();
        ctx.moveTo(cx, tipY + coneH);
        ctx.lineTo(cx - coneW / 2, tipY);
        ctx.lineTo(cx + coneW / 2, tipY);
        ctx.closePath();
        ctx.fill();
        /* Shine line */
        ctx.strokeStyle = 'rgba(255,255,255,0.3)';
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.moveTo(cx, tipY + coneH - 2);
        ctx.lineTo(cx - coneW / 4, tipY + 3);
        ctx.stroke();
        /* Diamond sparkle */
        ctx.fillStyle = '#42a5f5';
        ctx.beginPath();
        ctx.arc(cx, tipY + coneH, 2, 0, Math.PI * 2);
        ctx.fill();
      }
    } else { /* vickers */
      /* Diamond pyramid — show as inverted square/diamond shape */
      var pyrH = 26;
      var pyrW = 14;
      ctx.fillStyle = '#e0e0e0';
      ctx.beginPath();
      ctx.moveTo(cx, tipY + pyrH); /* tip */
      ctx.lineTo(cx - pyrW / 2, tipY + 4);
      ctx.lineTo(cx - pyrW / 2 + 3, tipY);
      ctx.lineTo(cx + pyrW / 2 - 3, tipY);
      ctx.lineTo(cx + pyrW / 2, tipY + 4);
      ctx.closePath();
      ctx.fill();
      /* Facet lines */
      ctx.strokeStyle = 'rgba(100,100,100,0.5)';
      ctx.lineWidth = 0.8;
      ctx.beginPath();
      ctx.moveTo(cx, tipY + pyrH);
      ctx.lineTo(cx, tipY);
      ctx.stroke();
      /* Diamond sparkle */
      ctx.fillStyle = '#42a5f5';
      ctx.beginPath();
      ctx.arc(cx, tipY + pyrH, 2, 0, Math.PI * 2);
      ctx.fill();
      /* 136 degree label */
      ctx.fillStyle = '#dde3f0';
      ctx.font = '600 9px "Segoe UI", system-ui, sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('136\u00B0', cx, tipY + pyrH + 14);
    }

    ctx.globalAlpha = 1;
  }

  /* ── Draw indentation mark on specimen ──────────────────────────── */
  function drawIndentationOnSpecimen(specX, specY, specW, specH, method, mat, maxPen, currentPen) {
    var cx = specX + specW / 2;
    var cy = specY;
    var penRatio = currentPen / maxPen;
    penRatio = clamp(penRatio, 0, 1);
    var r = 4 + penRatio * 6;

    ctx.save();
    if (method === 'brinell') {
      /* Circular indentation */
      ctx.fillStyle = 'rgba(0,0,0,0.4)';
      ctx.beginPath();
      ctx.ellipse(cx, cy, r, r * 0.4, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = 'rgba(0,0,0,0.25)';
      ctx.beginPath();
      ctx.ellipse(cx, cy, r * 0.6, r * 0.25, 0, 0, Math.PI * 2);
      ctx.fill();
    } else if (method === 'rockwell') {
      /* Small deep point */
      ctx.fillStyle = 'rgba(0,0,0,0.5)';
      ctx.beginPath();
      ctx.arc(cx, cy, 2 + penRatio * 2, 0, Math.PI * 2);
      ctx.fill();
    } else { /* vickers */
      /* Diamond/square shaped impression */
      var s = 3 + penRatio * 5;
      ctx.fillStyle = 'rgba(0,0,0,0.4)';
      ctx.beginPath();
      ctx.moveTo(cx, cy - s * 0.35);
      ctx.lineTo(cx + s, cy);
      ctx.lineTo(cx, cy + s * 0.35);
      ctx.lineTo(cx - s, cy);
      ctx.closePath();
      ctx.fill();
    }
    ctx.restore();
  }

  /* ── Measurement View (Right Side) ──────────────────────────────── */
  function drawMeasurementView(x, y, w, h) {
    var method = state.testMethod;
    var params = getTestParams();
    var showMeasurement = state.testComplete || state.animPhase === 'measuring';

    /* Title */
    ctx.fillStyle = '#6b7a99';
    ctx.font = '600 11px "Segoe UI", system-ui, sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText(showMeasurement ? 'IMPRESSION DETAIL' : 'AWAITING TEST', x + w / 2, y + 12);

    if (!showMeasurement && state.animPhase === 'idle' && !state.testComplete) {
      /* Show instruction */
      ctx.fillStyle = '#3a4560';
      ctx.font = '600 14px "Segoe UI", system-ui, sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('Select test parameters', x + w / 2, y + h / 2 - 20);
      ctx.fillText('and click "Run Test"', x + w / 2, y + h / 2 + 5);

      /* Draw faint outlines of what will appear */
      ctx.strokeStyle = 'rgba(42,48,80,0.3)';
      ctx.lineWidth = 1;
      ctx.setLineDash([4, 4]);
      if (method === 'brinell') {
        ctx.beginPath();
        ctx.arc(x + w / 2, y + h / 2 + 60, 60, 0, Math.PI * 2);
        ctx.stroke();
      } else if (method === 'rockwell') {
        /* Faint dial */
        ctx.beginPath();
        ctx.arc(x + w / 2, y + h / 2 + 60, 70, 0, Math.PI * 2);
        ctx.stroke();
      } else {
        /* Faint diamond */
        ctx.beginPath();
        ctx.moveTo(x + w / 2, y + h / 2);
        ctx.lineTo(x + w / 2 + 60, y + h / 2 + 60);
        ctx.lineTo(x + w / 2, y + h / 2 + 120);
        ctx.lineTo(x + w / 2 - 60, y + h / 2 + 60);
        ctx.closePath();
        ctx.stroke();
      }
      ctx.setLineDash([]);
      return;
    }

    if (!showMeasurement) return;

    var viewCx = x + w / 2;
    var viewCy = y + h / 2 + 20;
    var measAlpha = state.animPhase === 'measuring' ? easeOut(state.animProgress) : 1;

    ctx.globalAlpha = measAlpha;

    if (method === 'brinell') {
      drawBrinellMeasurement(viewCx, viewCy, w, params);
    } else if (method === 'rockwell') {
      drawRockwellMeasurement(viewCx, viewCy, w, params);
    } else {
      drawVickersMeasurement(viewCx, viewCy, w, params);
    }

    ctx.globalAlpha = 1;

    /* Display hardness result */
    if (state.testComplete) {
      ctx.fillStyle = '#e53935';
      ctx.font = 'bold 22px "Courier New", monospace';
      ctx.textAlign = 'center';
      ctx.fillText(params.hardness + ' ' + params.hardnessUnit, viewCx, y + h - 20);

      /* Formula used */
      ctx.fillStyle = '#6b7a99';
      ctx.font = '500 10px "Courier New", monospace';
      if (method === 'brinell') {
        ctx.fillText('BHN = 2F/[\u03C0D(D\u2212\u221A(D\u00B2\u2212d\u00B2))]', viewCx, y + h - 4);
      } else if (method === 'rockwell') {
        if (state.rockwellScale === 'B') {
          ctx.fillText('HRB = 130 \u2212 (depth/0.002)', viewCx, y + h - 4);
        } else {
          ctx.fillText('HRC = 100 \u2212 (depth/0.002)', viewCx, y + h - 4);
        }
      } else {
        ctx.fillText('HV = 1.854\u00D7F/d\u00B2', viewCx, y + h - 4);
      }
    }
  }

  /* ── Brinell Measurement: Circular impression with diameter lines ── */
  function drawBrinellMeasurement(cx, cy, w, params) {
    var impR = Math.min(w * 0.25, 75);

    /* Surface background (top-down view) */
    ctx.fillStyle = MATERIALS[state.materialIdx].color;
    ctx.globalAlpha = 0.3;
    roundRect(ctx, cx - w / 2 + 10, cy - impR - 30, w - 20, impR * 2 + 60, 8);
    ctx.fill();
    ctx.globalAlpha = 1;

    /* Circular impression */
    var grad = ctx.createRadialGradient(cx, cy, 0, cx, cy, impR);
    grad.addColorStop(0, 'rgba(0,0,0,0.5)');
    grad.addColorStop(0.7, 'rgba(0,0,0,0.3)');
    grad.addColorStop(1, 'rgba(0,0,0,0.05)');
    ctx.fillStyle = grad;
    ctx.beginPath();
    ctx.arc(cx, cy, impR, 0, Math.PI * 2);
    ctx.fill();

    /* Impression rim */
    ctx.strokeStyle = 'rgba(200,200,200,0.3)';
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.arc(cx, cy, impR, 0, Math.PI * 2);
    ctx.stroke();

    /* Diameter measurement lines (horizontal) */
    ctx.strokeStyle = '#f5c842';
    ctx.lineWidth = 1.5;
    /* Horizontal line */
    ctx.beginPath();
    ctx.moveTo(cx - impR - 15, cy);
    ctx.lineTo(cx + impR + 15, cy);
    ctx.stroke();
    /* End ticks */
    ctx.beginPath();
    ctx.moveTo(cx - impR, cy - 8);
    ctx.lineTo(cx - impR, cy + 8);
    ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(cx + impR, cy - 8);
    ctx.lineTo(cx + impR, cy + 8);
    ctx.stroke();

    /* Dimension label */
    ctx.fillStyle = '#f5c842';
    ctx.font = 'bold 13px "Courier New", monospace';
    ctx.textAlign = 'center';
    ctx.fillText('d = ' + roundN(toD(params.d, 'length'), 3) + ' ' + uLabel('length'), cx, cy - impR - 14);

    /* Ball diameter reference */
    ctx.fillStyle = '#6b7a99';
    ctx.font = '500 10px "Courier New", monospace';
    ctx.fillText('D = ' + roundN(toD(params.D, 'length'), 2) + ' ' + uLabel('length') + ' (ball)', cx, cy + impR + 22);
    ctx.fillText('F = ' + roundN(toD(params.F, 'force'), 1) + ' ' + uLabel('force'), cx, cy + impR + 36);

    /* Crosshair at center */
    ctx.strokeStyle = 'rgba(245,200,66,0.4)';
    ctx.lineWidth = 0.5;
    ctx.setLineDash([3, 3]);
    ctx.beginPath();
    ctx.moveTo(cx, cy - impR - 5);
    ctx.lineTo(cx, cy + impR + 5);
    ctx.stroke();
    ctx.setLineDash([]);

    /* Microscope reticle circles */
    ctx.strokeStyle = 'rgba(100,120,160,0.2)';
    ctx.lineWidth = 0.5;
    for (var i = 1; i <= 3; i++) {
      ctx.beginPath();
      ctx.arc(cx, cy, impR * 0.3 * i, 0, Math.PI * 2);
      ctx.stroke();
    }
  }

  /* ── Rockwell Measurement: Depth gauge dial ─────────────────────── */
  function drawRockwellMeasurement(cx, cy, w, params) {
    var dialR = Math.min(w * 0.3, 90);

    /* Dial background */
    ctx.fillStyle = '#1a2030';
    ctx.strokeStyle = '#3a4560';
    ctx.lineWidth = 3;
    ctx.beginPath();
    ctx.arc(cx, cy, dialR, 0, Math.PI * 2);
    ctx.fill();
    ctx.stroke();

    /* Inner ring */
    ctx.strokeStyle = '#2a3050';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.arc(cx, cy, dialR - 10, 0, Math.PI * 2);
    ctx.stroke();

    /* Scale markings */
    ctx.fillStyle = '#6b7a99';
    ctx.font = '500 9px "Courier New", monospace';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    var scaleMax = state.rockwellScale === 'B' ? 130 : 100;
    for (var i = 0; i <= 10; i++) {
      var angle = -Math.PI / 2 + (i / 10) * Math.PI * 1.5;
      var tickOuter = dialR - 12;
      var tickInner = i % 5 === 0 ? dialR - 24 : dialR - 18;
      ctx.strokeStyle = i % 5 === 0 ? '#6b7a99' : '#3a4560';
      ctx.lineWidth = i % 5 === 0 ? 1.5 : 0.8;
      ctx.beginPath();
      ctx.moveTo(cx + Math.cos(angle) * tickInner, cy + Math.sin(angle) * tickInner);
      ctx.lineTo(cx + Math.cos(angle) * tickOuter, cy + Math.sin(angle) * tickOuter);
      ctx.stroke();
      if (i % 5 === 0) {
        var labelR = dialR - 32;
        var val = Math.round(scaleMax - (i / 10) * scaleMax);
        ctx.fillStyle = '#6b7a99';
        ctx.fillText(val, cx + Math.cos(angle) * labelR, cy + Math.sin(angle) * labelR);
      }
    }

    /* Sub-ticks */
    for (var j = 0; j < 50; j++) {
      var aJ = -Math.PI / 2 + (j / 50) * Math.PI * 1.5;
      ctx.strokeStyle = 'rgba(60,70,100,0.4)';
      ctx.lineWidth = 0.5;
      ctx.beginPath();
      ctx.moveTo(cx + Math.cos(aJ) * (dialR - 12), cy + Math.sin(aJ) * (dialR - 12));
      ctx.lineTo(cx + Math.cos(aJ) * (dialR - 15), cy + Math.sin(aJ) * (dialR - 15));
      ctx.stroke();
    }

    /* Needle */
    var needleVal = params.hardness;
    var needleAngle = -Math.PI / 2 + ((scaleMax - needleVal) / scaleMax) * Math.PI * 1.5;
    needleAngle = clamp(needleAngle, -Math.PI / 2, -Math.PI / 2 + Math.PI * 1.5);
    ctx.strokeStyle = '#e53935';
    ctx.lineWidth = 2.5;
    ctx.beginPath();
    ctx.moveTo(cx, cy);
    ctx.lineTo(cx + Math.cos(needleAngle) * (dialR - 18), cy + Math.sin(needleAngle) * (dialR - 18));
    ctx.stroke();

    /* Center dot */
    ctx.fillStyle = '#e53935';
    ctx.beginPath();
    ctx.arc(cx, cy, 5, 0, Math.PI * 2);
    ctx.fill();
    ctx.fillStyle = '#0d1117';
    ctx.beginPath();
    ctx.arc(cx, cy, 2, 0, Math.PI * 2);
    ctx.fill();

    /* Scale label */
    ctx.fillStyle = '#e53935';
    ctx.font = 'bold 14px "Courier New", monospace';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'alphabetic';
    ctx.fillText(ROCKWELL[state.rockwellScale].unit, cx, cy + dialR * 0.45);

    /* Depth readout */
    ctx.fillStyle = '#f5c842';
    ctx.font = 'bold 11px "Courier New", monospace';
    ctx.fillText('depth = ' + roundN(toD(params.depth, 'length'), 4) + ' ' + uLabel('length'), cx, cy + dialR + 22);

    /* Load info */
    ctx.fillStyle = '#6b7a99';
    ctx.font = '500 10px "Courier New", monospace';
    ctx.fillText('Minor: ' + roundN(toD(ROCKWELL[state.rockwellScale].minorLoad, 'force'), 1) + ' ' + uLabel('force') + ' | Major: ' + roundN(toD(ROCKWELL[state.rockwellScale].majorLoad, 'force'), 1) + ' ' + uLabel('force'), cx, cy + dialR + 38);
  }

  /* ── Vickers Measurement: Square impression with diagonals ──────── */
  function drawVickersMeasurement(cx, cy, w, params) {
    var impSize = Math.min(w * 0.28, 80);

    /* Surface background */
    ctx.fillStyle = MATERIALS[state.materialIdx].color;
    ctx.globalAlpha = 0.3;
    roundRect(ctx, cx - w / 2 + 10, cy - impSize - 40, w - 20, impSize * 2 + 80, 8);
    ctx.fill();
    ctx.globalAlpha = 1;

    /* Diamond/square impression (rotated 45 degrees) */
    ctx.save();
    ctx.translate(cx, cy);

    /* Impression fill */
    var grad2 = ctx.createRadialGradient(0, 0, 0, 0, 0, impSize);
    grad2.addColorStop(0, 'rgba(0,0,0,0.5)');
    grad2.addColorStop(0.8, 'rgba(0,0,0,0.25)');
    grad2.addColorStop(1, 'rgba(0,0,0,0.05)');
    ctx.fillStyle = grad2;
    ctx.beginPath();
    ctx.moveTo(0, -impSize);
    ctx.lineTo(impSize, 0);
    ctx.lineTo(0, impSize);
    ctx.lineTo(-impSize, 0);
    ctx.closePath();
    ctx.fill();

    /* Impression outline */
    ctx.strokeStyle = 'rgba(200,200,200,0.4)';
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(0, -impSize);
    ctx.lineTo(impSize, 0);
    ctx.lineTo(0, impSize);
    ctx.lineTo(-impSize, 0);
    ctx.closePath();
    ctx.stroke();

    /* Diagonal measurement lines */
    /* d1 - vertical diagonal */
    ctx.strokeStyle = '#f5c842';
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(0, -impSize - 12);
    ctx.lineTo(0, impSize + 12);
    ctx.stroke();
    /* Ticks */
    ctx.beginPath();
    ctx.moveTo(-6, -impSize); ctx.lineTo(6, -impSize);
    ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(-6, impSize); ctx.lineTo(6, impSize);
    ctx.stroke();

    /* d2 - horizontal diagonal */
    ctx.strokeStyle = '#42a5f5';
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(-impSize - 12, 0);
    ctx.lineTo(impSize + 12, 0);
    ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(-impSize, -6); ctx.lineTo(-impSize, 6);
    ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(impSize, -6); ctx.lineTo(impSize, 6);
    ctx.stroke();

    ctx.restore();

    /* d1 label */
    ctx.fillStyle = '#f5c842';
    ctx.font = 'bold 12px "Courier New", monospace';
    ctx.textAlign = 'left';
    ctx.fillText('d\u2081', cx + 8, cy - impSize - 8);

    /* d2 label */
    ctx.fillStyle = '#42a5f5';
    ctx.textAlign = 'right';
    ctx.fillText('d\u2082', cx + impSize + 10, cy - 8);

    /* Mean diagonal value */
    ctx.fillStyle = '#f5c842';
    ctx.font = 'bold 13px "Courier New", monospace';
    ctx.textAlign = 'center';
    ctx.fillText('d = ' + roundN(toD(params.d, 'length'), 3) + ' ' + uLabel('length'), cx, cy + impSize + 30);

    /* Load info */
    ctx.fillStyle = '#6b7a99';
    ctx.font = '500 10px "Courier New", monospace';
    ctx.fillText('F = ' + roundN(toD(params.F, 'force'), 1) + ' ' + uLabel('force'), cx, cy + impSize + 46);

    /* Microscope reticle */
    ctx.strokeStyle = 'rgba(100,120,160,0.15)';
    ctx.lineWidth = 0.5;
    ctx.beginPath();
    ctx.arc(cx, cy, impSize * 1.2, 0, Math.PI * 2);
    ctx.stroke();
    ctx.beginPath();
    ctx.arc(cx, cy, impSize * 0.6, 0, Math.PI * 2);
    ctx.stroke();
  }

  /* ── Helper: rounded rect ──────────────────────────────────────── */
  function roundRect(ctx2, x2, y2, w2, h2, r2) {
    ctx2.beginPath();
    ctx2.moveTo(x2 + r2, y2);
    ctx2.lineTo(x2 + w2 - r2, y2);
    ctx2.quadraticCurveTo(x2 + w2, y2, x2 + w2, y2 + r2);
    ctx2.lineTo(x2 + w2, y2 + h2 - r2);
    ctx2.quadraticCurveTo(x2 + w2, y2 + h2, x2 + w2 - r2, y2 + h2);
    ctx2.lineTo(x2 + r2, y2 + h2);
    ctx2.quadraticCurveTo(x2, y2 + h2, x2, y2 + h2 - r2);
    ctx2.lineTo(x2, y2 + r2);
    ctx2.quadraticCurveTo(x2, y2, x2 + r2, y2);
    ctx2.closePath();
  }

  function adjustAlpha(hex, alpha) {
    var r = parseInt(hex.slice(1, 3), 16);
    var g = parseInt(hex.slice(3, 5), 16);
    var b = parseInt(hex.slice(5, 7), 16);
    return 'rgba(' + r + ',' + g + ',' + b + ',' + alpha + ')';
  }

  /* ================================================================
     ANIMATION LOOP
     ================================================================ */
  var animRAF = null;

  function startAnimation() {
    state.animPhase = 'descending';
    state.animProgress = 0;
    state.animStartTime = performance.now();
    state.testComplete = false;
    state.resultHardness = null;
    state.resultMeasurement = null;

    if (animRAF) cancelAnimationFrame(animRAF);
    animRAF = requestAnimationFrame(animTick);
  }

  function animTick(timestamp) {
    var elapsed = timestamp - state.animStartTime;
    var duration = ANIM_DURATIONS[state.animPhase] || 500;
    state.animProgress = clamp(elapsed / duration, 0, 1);

    draw();
    updateBadges();

    if (state.animProgress >= 1) {
      /* Transition to next phase */
      var phases = ['descending', 'indenting', 'holding', 'retracting', 'measuring'];
      var idx = phases.indexOf(state.animPhase);
      if (idx < phases.length - 1) {
        state.animPhase = phases[idx + 1];
        state.animProgress = 0;
        state.animStartTime = performance.now();
        /* Play indentation sound when load is applied */
        if (state.animPhase === 'indenting' && typeof playIndentSound === 'function') playIndentSound();
        animRAF = requestAnimationFrame(animTick);
      } else {
        /* Animation complete */
        state.animPhase = 'idle';
        state.testComplete = true;
        var params = getTestParams();
        state.resultHardness = params.hardness;
        state.resultMeasurement = params.measureVal;
        updateReadouts(params);
        updateBadges();
        draw();
      }
    } else {
      animRAF = requestAnimationFrame(animTick);
    }
  }

  /* ================================================================
     UI UPDATES
     ================================================================ */
  function updateReadouts(params) {
    if (!params) params = getTestParams();
    var mat = MATERIALS[state.materialIdx];

    $('#r-hardness').textContent = state.testComplete ? params.hardness : '---';
    $('#r-hardness-unit').textContent = state.testComplete ? ' ' + params.hardnessUnit : '';
    $('#r-method').textContent = state.testMethod === 'brinell' ? 'Brinell' :
                                 state.testMethod === 'rockwell' ? 'Rockwell ' + state.rockwellScale : 'Vickers';
    $('#r-load').textContent = roundN(toD(params.F, 'force'), 1);
    var loadUnit = $('#r-load').parentElement.querySelector('.readout-unit');
    if (loadUnit) loadUnit.textContent = ' ' + uLabel('force');
    $('#r-indenter').textContent = params.indenterLabel;
    var measVal = state.testComplete ? roundN(toD(params.measureVal, 'length'), 3) : '---';
    $('#r-measurement').textContent = measVal;
    var measUnit = $('#r-meas-unit');
    if (measUnit) measUnit.textContent = ' ' + uLabel('length');
    $('#r-material').textContent = mat.name;
  }

  function updateBadges() {
    var params = getTestParams();
    $('#rb-hardness').textContent = state.testComplete ? params.hardness + ' ' + params.hardnessUnit : '---';
    $('#rb-method').textContent = state.testMethod === 'brinell' ? 'Brinell' :
                                  state.testMethod === 'rockwell' ? 'Rockwell ' + state.rockwellScale : 'Vickers';
    $('#rb-load').textContent = roundN(toD(params.F, 'force'), 1) + ' ' + uLabel('force');
    var measText = state.testComplete ? roundN(toD(params.measureVal, 'length'), 3) + ' ' + uLabel('length') : '---';
    if (state.testMethod === 'rockwell' && state.testComplete) {
      measText = roundN(toD(params.depth, 'length'), 4) + ' ' + uLabel('length');
    }
    $('#rb-indent').textContent = measText;
  }

  function updateSimUI() {
    var method = state.testMethod;
    /* Show/hide method-specific controls */
    if (method === 'brinell') {
      show($('#brinell-controls'));
      hide($('#rockwell-controls'));
      hide($('#vickers-controls'));
    } else if (method === 'rockwell') {
      hide($('#brinell-controls'));
      show($('#rockwell-controls'));
      hide($('#vickers-controls'));
      updateRockwellLabels();
    } else {
      hide($('#brinell-controls'));
      hide($('#rockwell-controls'));
      show($('#vickers-controls'));
    }
    /* Update slider labels with current unit system */
    /* Update slider labels + stepper displays with current unit system */
    var bdl = $('#ball-d-label');       if (bdl) bdl.textContent = 'Ball D (' + uLabel('length') + ')';
    var bdv = $('#ball-d-val');          if (bdv) bdv.textContent = roundN(toD(BALL_DIAMETERS[state.ballDiamIdx], 'length'), 2) + ' ' + uLabel('length');
    var bll = $('#brinell-load-label');  if (bll) bll.textContent = 'Load F (' + uLabel('force') + ')';
    var bli = $('#brinell-load-input');  if (bli && document.activeElement !== bli) bli.value = state.brinellLoad;
    var blu = $('#brinell-load-unit');   if (blu) blu.textContent = uLabel('force');
    var vll = $('#vickers-load-label');  if (vll) vll.textContent = 'Load F (' + uLabel('force') + ')';
    var vli = $('#vickers-load-input');  if (vli && document.activeElement !== vli) vli.value = state.vickersLoad;
    var vlu = $('#vickers-load-unit');   if (vlu) vlu.textContent = uLabel('force');

    updateReadouts();
    updateBadges();
    draw();
  }

  function updateRockwellLabels() {
    var s = ROCKWELL[state.rockwellScale];
    $('#rockwell-indenter-lbl').innerHTML = s.indenter;
    $('#rockwell-load-lbl').textContent = roundN(toD(s.majorLoad, 'force'), 1) + ' ' + uLabel('force') + ' (major) + ' + roundN(toD(s.minorLoad, 'force'), 1) + ' ' + uLabel('force') + ' (minor)';
  }

  /* ================================================================
     MODE SWITCHING
     ================================================================ */
  function setMode(mode) {
    state.mode = mode;
    /* Update mode tabs */
    $$('#mode-tabs .pill').forEach(function (p) {
      p.classList.toggle('active', p.getAttribute('data-mode') === mode);
    });

    /* Show/hide panels */
    var simEls = ['#sim-panel'];
    var exploreEls = ['#cat-row', '#item-selector', '#item-info'];
    var practiceEls = ['#practice-panel', '#practice-bar'];
    var quizEls = ['#quiz-panel', '#quiz-bar', '#quiz-result'];

    simEls.forEach(function (s) { mode === 'simulate' ? show($(s)) : hide($(s)); });
    exploreEls.forEach(function (s) { mode === 'explore' ? show($(s)) : hide($(s)); });
    practiceEls.forEach(function (s) { mode === 'practice' ? show($(s)) : hide($(s)); });
    quizEls.forEach(function (s) { mode === 'quiz' ? show($(s)) : hide($(s)); });

    if (mode === 'explore') {
      buildExploreGrid();
      showConceptInfo(state.exploreIdx);
    }
    if (mode === 'practice') {
      if (!state.pracProblem) nextPractice();
    }
    if (mode === 'quiz') {
      if (state.quizQuestions.length === 0) startQuiz();
    }

    draw();
  }

  /* ================================================================
     EXPLORE MODE
     ================================================================ */
  function buildExploreGrid() {
    var grid = $('#concept-grid');
    grid.innerHTML = '';
    var filtered = CONCEPTS.filter(function (c) { return c.cat === state.exploreCat; });
    filtered.forEach(function (c, i) {
      var absIdx = CONCEPTS.indexOf(c);
      var btn = document.createElement('button');
      btn.className = 'is-btn' + (absIdx === state.exploreIdx ? ' active' : '');
