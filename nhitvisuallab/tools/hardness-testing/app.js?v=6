  function genProblems() {
    var pool = [];

    /* 1. Calculate BHN from D, d, F */
    pool.push(function () {
      var D = [2.5, 5, 10][randInt(0, 2)];
      var F_options;
      if (D === 10) F_options = [1000, 1500, 2000, 3000];
      else if (D === 5) F_options = [250, 750, 1000];
      else F_options = [62.5, 187.5];
      var F = F_options[randInt(0, F_options.length - 1)];
      var dMin = D * 0.25, dMax = D * 0.6;
      var d = roundN(randFloat(dMin, dMax), 2);
      var sqrtTerm = Math.sqrt(D * D - d * d);
      var bhn = roundN(2 * F / (Math.PI * D * (D - sqrtTerm)), 1);
      return {
        prompt: 'A Brinell test uses a ' + D + ' mm ball with F = ' + F + ' kgf. The impression diameter d = ' + d + ' mm. Calculate BHN.',
        answer: bhn,
        unit: 'BHN',
        solution: [
          'BHN = 2F / [\u03C0 \u00D7 D \u00D7 (D \u2212 \u221A(D\u00B2 \u2212 d\u00B2))]',
          'D\u00B2 \u2212 d\u00B2 = ' + roundN(D * D, 2) + ' \u2212 ' + roundN(d * d, 4) + ' = ' + roundN(D * D - d * d, 4),
          '\u221A' + roundN(D * D - d * d, 4) + ' = ' + roundN(sqrtTerm, 4),
          'D \u2212 \u221A(D\u00B2 \u2212 d\u00B2) = ' + D + ' \u2212 ' + roundN(sqrtTerm, 4) + ' = ' + roundN(D - sqrtTerm, 4),
          'BHN = 2 \u00D7 ' + F + ' / (\u03C0 \u00D7 ' + D + ' \u00D7 ' + roundN(D - sqrtTerm, 4) + ')',
          '<strong>BHN = ' + bhn + '</strong>'
        ],
        tol: 3
      };
    });

    /* 2. Calculate HV from d and F */
    pool.push(function () {
      var F = [1, 5, 10, 20, 30, 50][randInt(0, 5)];
      var d = roundN(randFloat(0.08, 0.6), 3);
      var hv = roundN(1.854 * F / (d * d), 1);
      return {
        prompt: 'A Vickers test with F = ' + F + ' kgf produces a mean diagonal d = ' + d + ' mm. Calculate HV.',
        answer: hv,
        unit: 'HV',
        solution: [
          'HV = 1.854 \u00D7 F / d\u00B2',
          'HV = 1.854 \u00D7 ' + F + ' / (' + d + ')\u00B2',
          'HV = ' + roundN(1.854 * F, 4) + ' / ' + roundN(d * d, 6),
          '<strong>HV = ' + hv + '</strong>'
