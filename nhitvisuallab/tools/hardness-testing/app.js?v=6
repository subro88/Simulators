        prompt: 'A Rockwell C test shows a permanent depth increase of ' + depth + ' mm. Calculate HRC.',
        answer: hrc,
        unit: 'HRC',
        solution: [
          'HRC = 100 \u2212 (depth / 0.002)',
          'HRC = 100 \u2212 (' + depth + ' / 0.002)',
          'HRC = 100 \u2212 ' + roundN(depth / 0.002, 1),
          '<strong>HRC = ' + hrc + '</strong>'
