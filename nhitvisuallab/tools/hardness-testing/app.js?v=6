  var canvas = $('#sim-canvas');
  var ctx = canvas.getContext('2d');
  var W = canvas.width;
  var H = canvas.height;
  var dpr = window.devicePixelRatio || 1;
  function resizeCanvas() {
    var rect = canvas.getBoundingClientRect();
    canvas.width = rect.width * dpr;
    canvas.height = (rect.width * H / W) * dpr;
    ctx.setTransform(dpr * rect.width / W, 0, 0, dpr * rect.width / W, 0, 0);
  }
  window.addEventListener('resize', resizeCanvas);
  resizeCanvas();

  /* ================================================================
     STATE
     ================================================================ */
  var state = {
    mode: 'simulate',
    testMethod: 'brinell',
    rockwellScale: 'C',
    materialIdx: 0,
    ballDiamIdx: 2,          // index into BALL_DIAMETERS (default 10mm)
    brinellLoad: 3000,
    vickersLoad: 30,
    animPhase: 'idle',       // idle | descending | indenting | holding | retracting | measuring
    animProgress: 0,         // 0..1 within current phase
    animStartTime: 0,
    testComplete: false,
    resultHardness: null,
    resultMeasurement: null,
    /* Explore */
    exploreCat: 'methods',
    exploreIdx: 0,
    /* Practice */
    pracScore: 0,
    pracTotal: 0,
    pracProblem: null,
    pracAnswered: false,
    /* Quiz */
    quizQuestions: [],
    quizIdx: 0,
    quizScore: 0,
    quizAnswered: false,
    quizResults: []
  };

  /* Computed test parameters */
  function getTestParams() {
    var mat = MATERIALS[state.materialIdx];
    var method = state.testMethod;
    var params = {};

    if (method === 'brinell') {
      params.D = BALL_DIAMETERS[state.ballDiamIdx];
      params.F = state.brinellLoad;
      params.indenterLabel = roundN(toD(params.D, 'length'), 2) + ' ' + uLabel('length') + ' Ball';
      /* Back-calculate impression diameter from known BHN */
      var bhn = mat.bhn;
      var bracketTerm = params.D - 2 * params.F / (Math.PI * params.D * bhn);
      /* Ensure valid sqrt */
      var dSq = params.D * params.D - bracketTerm * bracketTerm;
      if (dSq < 0) dSq = 0;
      params.d = Math.sqrt(dSq);
      params.hardness = bhn;
      params.hardnessUnit = 'BHN';
      params.measureLabel = '\u00D8 ' + roundN(toD(params.d, 'length'), 3) + ' ' + uLabel('length');
      params.measureVal = roundN(params.d, 2);
    } else if (method === 'rockwell') {
      var scale = ROCKWELL[state.rockwellScale];
      params.F = scale.majorLoad;
      params.minorLoad = scale.minorLoad;
      params.indenterLabel = scale.indenter;
      params.scale = state.rockwellScale;
      /* Calculate depth from known hardness */
      var hrVal = mat.hrc;
      if (hrVal === null) {
        /* Use approximate conversion for soft materials */
        if (state.rockwellScale === 'B') {
          /* Approximate HRB from BHN */
          hrVal = clamp(mat.bhn * 0.7 + 10, 20, 100);
          params.depth = (130 - hrVal) * 0.002;
        } else {
          hrVal = 0;
          params.depth = 0.2;
        }
      } else {
        if (state.rockwellScale === 'C') {
          params.depth = (100 - hrVal) * 0.002;
        } else if (state.rockwellScale === 'A') {
          /* HRA from HRC: empirical HRA ≈ 0.36 × HRC + 61 (ASTM E140) */
          hrVal = clamp(roundN(0.36 * hrVal + 61, 1), 20, 88);
          params.depth = (100 - hrVal) * 0.002;
        } else {
          /* Scale B */
          hrVal = clamp(mat.bhn * 0.7 + 10, 20, 100);
          params.depth = (130 - hrVal) * 0.002;
        }
      }
      params.hardness = roundN(hrVal, 1);
      params.hardnessUnit = scale.unit;
      params.measureLabel = 'Depth ' + roundN(toD(params.depth, 'length'), 4) + ' ' + uLabel('length');
      params.measureVal = roundN(params.depth, 3);
    } else { /* vickers */
      params.F = state.vickersLoad;
      params.indenterLabel = 'Diamond Pyramid (136\u00B0)';
      var hv = Math.max(mat.hv, 1); /* guard: prevent div-by-zero */
      /* Back-calculate diagonal: d = sqrt(1.854 * F / HV) */
      params.d = Math.sqrt(1.854 * params.F / hv);
      params.hardness = hv;
      params.hardnessUnit = 'HV';
      params.measureLabel = 'd = ' + roundN(toD(params.d, 'length'), 3) + ' ' + uLabel('length');
      params.measureVal = roundN(params.d, 3);
    }

    return params;
  }

  /* ================================================================
     DRAWING — MAIN
     ================================================================ */
  var ANIM_DURATIONS = {
    descending: 600,
    indenting: 500,
    holding: 400,
    retracting: 400,
    measuring: 800
