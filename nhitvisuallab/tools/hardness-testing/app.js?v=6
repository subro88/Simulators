  /* Render a clean, light-theme top-down view of the indentation
     (so the report prints crisp on paper). Returns a PNG dataURL. */
  function buildIndentationSnapshot(mat, params, method) {
    var W = 520, H = 380;
    var c = document.createElement('canvas');
    c.width = W; c.height = H;
    var x = c.getContext('2d');

    /* Background */
    x.fillStyle = '#ffffff'; x.fillRect(0, 0, W, H);
    /* Title */
    x.fillStyle = '#0d47a1';
    x.font = 'bold 14px "Segoe UI", system-ui, sans-serif';
    x.textAlign = 'center';
    x.fillText('Indentation View (top-down)', W / 2, 22);

    /* Specimen plate */
    var plateY = 50, plateH = H - 90;
    var plateGrad = x.createLinearGradient(0, plateY, 0, plateY + plateH);
    plateGrad.addColorStop(0, '#eceff1');
    plateGrad.addColorStop(1, '#cfd8dc');
    x.fillStyle = plateGrad;
    x.fillRect(20, plateY, W - 40, plateH);
    x.strokeStyle = '#90a4ae';
    x.lineWidth = 1.5;
    x.strokeRect(20, plateY, W - 40, plateH);

    /* Subtle material tint overlay */
    x.fillStyle = mat.color || '#90a4ae';
    x.globalAlpha = 0.18;
    x.fillRect(20, plateY, W - 40, plateH);
    x.globalAlpha = 1;

    /* Indentation centered on plate */
    var cx = W / 2, cy = plateY + plateH / 2;

    if (method === 'brinell') {
      /* Circle of impression diameter (scaled into view) */
      var dPx = Math.min(180, Math.max(28, params.d * 18));
      /* Outer ring */
      var rg = x.createRadialGradient(cx - dPx * 0.18, cy - dPx * 0.18,
                                       dPx * 0.05, cx, cy, dPx);
      rg.addColorStop(0, 'rgba(0,0,0,0.05)');
      rg.addColorStop(0.6, 'rgba(0,0,0,0.55)');
      rg.addColorStop(1, 'rgba(0,0,0,0.85)');
      x.fillStyle = rg;
      x.beginPath(); x.arc(cx, cy, dPx, 0, Math.PI * 2); x.fill();
      /* Dimension line */
      drawDimLine(x, cx - dPx, cy + dPx + 18, cx + dPx, cy + dPx + 18,
        'd = ' + roundN(toD(params.d, 'length'), 3) + ' ' + uLabel('length'));
    } else if (method === 'vickers') {
      /* Square (diamond-oriented) — params.measureVal is mean diagonal mm */
      var dV = Math.min(150, Math.max(20, params.measureVal * 30));
      x.fillStyle = 'rgba(0,0,0,0.78)';
      x.beginPath();
      x.moveTo(cx, cy - dV);
      x.lineTo(cx + dV, cy);
      x.lineTo(cx, cy + dV);
      x.lineTo(cx - dV, cy);
      x.closePath();
      x.fill();
      /* Diagonal dimension lines */
      x.strokeStyle = '#c62828'; x.lineWidth = 1;
      x.setLineDash([3, 3]);
      x.beginPath(); x.moveTo(cx - dV, cy); x.lineTo(cx + dV, cy); x.stroke();
      x.beginPath(); x.moveTo(cx, cy - dV); x.lineTo(cx, cy + dV); x.stroke();
      x.setLineDash([]);
      drawDimLine(x, cx - dV, cy + dV + 18, cx + dV, cy + dV + 18,
        'd = ' + roundN(toD(params.measureVal, 'length'), 3) + ' ' + uLabel('length'));
    } else {
      /* Rockwell — show small cone-tip impression circle (very small) */
      var dpDepth = params.depth || 0.05;
      var dR = Math.min(60, Math.max(12, dpDepth * 220));
      var rgR = x.createRadialGradient(cx, cy, 1, cx, cy, dR);
      rgR.addColorStop(0, 'rgba(0,0,0,0.85)');
      rgR.addColorStop(1, 'rgba(0,0,0,0.10)');
      x.fillStyle = rgR;
      x.beginPath(); x.arc(cx, cy, dR, 0, Math.PI * 2); x.fill();
      drawDimLine(x, cx - dR, cy + dR + 18, cx + dR, cy + dR + 18,
        'depth = ' + roundN(toD(dpDepth, 'length'), 4) + ' ' + uLabel('length'));
    }

    /* Footer line */
    x.fillStyle = '#37474f';
    x.font = '11px "Segoe UI", sans-serif';
    x.textAlign = 'center';
    x.fillText(mat.name + ' — ' + (method.charAt(0).toUpperCase() + method.slice(1)) +
      ' indenter, F = ' + roundN(toD(params.F, 'force'), 1) + ' ' + uLabel('force'),
      W / 2, H - 14);
    /* Watermark */
    x.fillStyle = 'rgba(0,0,0,0.30)';
    x.font = '10px "Segoe UI", sans-serif';
    x.textAlign = 'right';
    x.fillText('mechsimulator.com', W - 10, H - 4);

    return c.toDataURL('image/png');
  }

  function drawDimLine(ctx, x1, y1, x2, y2, label) {
    ctx.strokeStyle = '#1565c0';
    ctx.fillStyle = '#1565c0';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(x1, y1); ctx.lineTo(x2, y2); ctx.stroke();
    /* End caps */
    ctx.beginPath(); ctx.moveTo(x1, y1 - 4); ctx.lineTo(x1, y1 + 4); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(x2, y2 - 4); ctx.lineTo(x2, y2 + 4); ctx.stroke();
    /* Label */
    ctx.font = '600 11px "Courier New", monospace';
    ctx.textAlign = 'center';
    ctx.fillText(label, (x1 + x2) / 2, y2 + 18);
  }

