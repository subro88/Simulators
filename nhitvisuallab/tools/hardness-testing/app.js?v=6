  function handleMCQAnswer(chosenIdx) {
    if (state.quizAnswered) return;
    state.quizAnswered = true;
    var q = state.quizQuestions[state.quizIdx];
    var correct = chosenIdx === q.correct;
    if (correct) state.quizScore++;

    state.quizResults.push({
      q: q.q,
      correct: correct,
      userAnswer: q.choices[chosenIdx],
      rightAnswer: q.choices[q.correct]
    });

    $$('#quiz-panel .answer-btn').forEach(function (btn, bi) {
      btn.classList.add('locked');
      if (bi === q.correct) btn.classList.add('correct');
      if (bi === chosenIdx && !correct) btn.classList.add('wrong');
    });

    setTimeout(advanceQuiz, 1200);
  }

  function handleNumericAnswer() {
    if (state.quizAnswered) return;
    var input = parseFloat($('#qi-input').value);
    if (isNaN(input)) return;
    state.quizAnswered = true;
    var q = state.quizQuestions[state.quizIdx];
    var correct = Math.abs(input - q.answer) <= (q.tol || 2);
    if (correct) state.quizScore++;

    state.quizResults.push({
      q: q.q,
      correct: correct,
      userAnswer: input + ' ' + q.unit,
      rightAnswer: q.answer + ' ' + q.unit
