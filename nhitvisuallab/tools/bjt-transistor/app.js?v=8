        txt += 'V_CE = ' + roundN(state.vce, 1) + ' V\n';
        txt += 'I_B = ' + roundN(state.ib * 1e6, 1) + ' \u00b5A\n';
        txt += 'I_C = ' + roundN(state.ic * 1000, 2) + ' mA\n';
        txt += 'I_E = ' + roundN(state.ie * 1000, 2) + ' mA\n';
        txt += '\u03b2 = ' + state.beta;
        navigator.clipboard.writeText(txt);
