  /* ── presets ── */
  var PRESET_TARGETS = {
    // BJT
    cutoff:     { vbe: 0,    vce: 5 },
    active:     { vbe: 0.7,  vce: 5 },
    saturation: { vbe: 0.7,  vce: 0.15 },
