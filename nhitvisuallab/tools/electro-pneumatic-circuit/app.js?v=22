     ================================================================ */

  var CONCEPT_SYMBOL_MAP = {
    'frl-unit': 'frl',
    'v52-valve': 'v52-single',
    'v32-valve': 'v32-push',
    'quick-exhaust': 'quick-exhaust',
    'shuttle-valve': 'shuttle',
    'and-valve': 'dual-pressure',
    'meter-out': 'flow-control',
    'auto-return': 'cyl-da',
