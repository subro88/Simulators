    '11': 'NC contact common — IEC 60947-5-1 terminal 11',
    '12': 'NC contact output — IEC 60947-5-1 terminal 12',
    '13': 'NO contact common — IEC 60947-5-1 terminal 13',
    '14': 'NO contact output — IEC 60947-5-1 terminal 14'
