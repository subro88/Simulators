  function drawGaugeSymbol(w, h, comp) {
    var cx = w / 2;
    var dialCY = 16;
    var radius = 13;
    /* Dial face */
    ctx.beginPath();
    ctx.arc(cx, dialCY, radius, 0, Math.PI * 2);
    ctx.fillStyle = '#0d1625';
    ctx.fill();
    ctx.strokeStyle = '#5a8ab5';
    ctx.lineWidth = 1.5;
    ctx.stroke();
    /* Tick marks */
    ctx.strokeStyle = '#5a8ab5';
    ctx.lineWidth = 0.8;
    var tickAngles = [-Math.PI * 0.75, -Math.PI / 2, -Math.PI / 4, 0, Math.PI / 4, Math.PI / 2, Math.PI * 0.75];
    for (var ti = 0; ti < tickAngles.length; ti++) {
      var ax = cx + Math.cos(tickAngles[ti] - Math.PI / 2) * (radius - 2);
      var ay = dialCY + Math.sin(tickAngles[ti] - Math.PI / 2) * (radius - 2);
      var bx = cx + Math.cos(tickAngles[ti] - Math.PI / 2) * (radius - 5);
      var by = dialCY + Math.sin(tickAngles[ti] - Math.PI / 2) * (radius - 5);
      ctx.beginPath(); ctx.moveTo(ax, ay); ctx.lineTo(bx, by); ctx.stroke();
    }
    /* Needle — 0–10 bar full scale, 270° sweep */
    var reading = comp ? (comp.reading || 0) : 0;
    var clamped = Math.max(0, Math.min(10, reading));
    var needleAngle = -Math.PI * 0.75 + (clamped / 10) * Math.PI * 1.5;
    ctx.save();
    ctx.translate(cx, dialCY);
    ctx.rotate(needleAngle);
    ctx.strokeStyle = running ? '#ff6644' : '#5a6a80';
    ctx.lineWidth = 1.8;
    ctx.beginPath();
    ctx.moveTo(0, 2);
    ctx.lineTo(0, -(radius - 2));
    ctx.stroke();
    ctx.restore();
    /* Hub */
    ctx.beginPath();
    ctx.arc(cx, dialCY, 2, 0, Math.PI * 2);
    ctx.fillStyle = '#5a8ab5';
    ctx.fill();
    /* Numeric reading + unit beneath dial */
    ctx.fillStyle = running && reading > 0.1 ? '#aed581' : '#667799';
    ctx.font = 'bold 9px sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(reading.toFixed(1), cx, h - 13);
    ctx.font = '7px sans-serif';
    ctx.fillStyle = '#667799';
    ctx.fillText('bar', cx, h - 4);
    ctx.textBaseline = 'alphabetic';
  }

  function drawFlowMeterSymbol(w, h, comp) {
    var cx = w / 2;
    var dialCY = 18;
    var radius = 14;
    ctx.beginPath();
    ctx.arc(cx, dialCY, radius, 0, Math.PI * 2);
    ctx.fillStyle = '#0d1625';
    ctx.fill();
    ctx.strokeStyle = '#5a8ab5';
    ctx.lineWidth = 1.5;
    ctx.stroke();
    ctx.fillStyle = '#667799';
    ctx.font = 'bold 9px sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText('Q', cx, dialCY - 4);
    var reading = comp ? (comp.reading || 0) : 0;
    var active = running && reading > 0.5;
    ctx.fillStyle = active ? '#aed581' : '#5a8ab5';
    ctx.font = 'bold 8px sans-serif';
    ctx.fillText(reading.toFixed(0), cx, dialCY + 5);
    ctx.fillStyle = '#667799';
    ctx.font = '7px sans-serif';
    ctx.fillText('L/min', cx, h - 14);
    if (active) {
      ctx.strokeStyle = '#aed581';
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(cx, h - 4);
      ctx.lineTo(cx, h - 9);
      ctx.stroke();
      ctx.fillStyle = '#aed581';
      ctx.beginPath();
      ctx.moveTo(cx, h - 12);
      ctx.lineTo(cx - 3, h - 7);
      ctx.lineTo(cx + 3, h - 7);
      ctx.closePath();
      ctx.fill();
    } else {
      ctx.fillStyle = '#5a8ab5';
      ctx.font = '7px sans-serif';
      ctx.fillText('\u2014', cx, h - 5);
    }
    ctx.textBaseline = 'alphabetic';
  }

  function drawProximitySymbol(w, h, comp) {
    var pressure = comp ? (comp._localPressure || 0) : 0;
    var threshold = (comp && comp.values && comp.values.threshold) || 0.5;
    var isActive = !!(running && pressure >= threshold);
    if (comp) comp.reading = isActive ? 1 : 0;
    ctx.fillStyle = '#1a2535';
    ctx.strokeStyle = isActive ? '#66bb6a' : '#5a8ab5';
    ctx.lineWidth = isActive ? 2 : 1.5;
    ctx.fillRect(4, 4, w - 8, h - 8);
    ctx.strokeRect(4, 4, w - 8, h - 8);
    var ledX = w / 2, ledY = 14;
    ctx.beginPath();
    ctx.arc(ledX, ledY, 5, 0, Math.PI * 2);
    ctx.fillStyle = isActive ? '#66bb6a' : '#3a4a5a';
    ctx.fill();
    ctx.strokeStyle = isActive ? '#aed581' : '#5a8ab5';
    ctx.lineWidth = 1;
    ctx.stroke();
    if (isActive) {
      ctx.fillStyle = 'rgba(102,187,106,0.3)';
      ctx.beginPath();
      ctx.arc(ledX, ledY, 8, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.fillStyle = '#667799';
    ctx.font = 'bold 7px sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText('PRX', w / 2, h - 17);
    ctx.fillStyle = isActive ? '#aed581' : '#5a8ab5';
    ctx.font = 'bold 8px sans-serif';
    ctx.fillText(isActive ? 'ON' : 'OFF', w / 2, h - 7);
    ctx.textBaseline = 'alphabetic';
  }

  function drawSilencerSymbol(w, h) {
    ctx.fillStyle = '#3a4a5a';
    ctx.strokeStyle = '#5a8ab5';
    ctx.lineWidth = 1;
    /* Muffler shape */
    ctx.beginPath();
    ctx.moveTo(w / 2, 4);
    ctx.lineTo(w - 2, h * 0.4);
    ctx.lineTo(w - 2, h);
    ctx.lineTo(2, h);
    ctx.lineTo(2, h * 0.4);
    ctx.closePath();
    ctx.fill();
    ctx.stroke();
    /* Horizontal lines (indicating porous material) */
    ctx.strokeStyle = '#667799';
    ctx.lineWidth = 0.5;
    for (var sl = 0; sl < 3; sl++) {
      var sy = h * 0.5 + sl * 5;
      ctx.beginPath();
      ctx.moveTo(4, sy);
      ctx.lineTo(w - 4, sy);
      ctx.stroke();
    }
  }

  function drawTeeSymbol(w, h) {
    ctx.strokeStyle = '#5a8ab5';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(w / 2, 0);
    ctx.lineTo(w / 2, h / 2);
    ctx.lineTo(0, h / 2);
    ctx.moveTo(w / 2, h / 2);
    ctx.lineTo(w, h / 2);
    ctx.stroke();
    ctx.beginPath();
    ctx.arc(w / 2, h / 2, 3, 0, Math.PI * 2);
    ctx.fillStyle = '#42a5f5';
    ctx.fill();
  }

  function drawGenericSymbol(w, h, name) {
    ctx.fillStyle = '#1a2535';
    ctx.strokeStyle = '#5a8ab5';
    ctx.lineWidth = 1.5;
    ctx.strokeRect(4, 4, w - 8, h - 8);
    ctx.fillRect(4, 4, w - 8, h - 8);
    ctx.fillStyle = '#667799';
    ctx.font = '7px sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(name.substring(0, 6), w / 2, h / 2);
    ctx.textBaseline = 'alphabetic';
  }

  /* ── Electrical component symbols ── */

  function drawPowerSupplySymbol(w, h, comp) {
    var cx = w / 2, cy = h / 2;
    var isOn = running && comp._elecEnergized;
    ctx.beginPath(); ctx.arc(cx, cy, 18, 0, Math.PI * 2);
    ctx.fillStyle = '#1a2535'; ctx.fill();
    ctx.strokeStyle = isOn ? '#ff9800' : '#6a5040'; ctx.lineWidth = 2; ctx.stroke();
    ctx.fillStyle = isOn ? '#ff9800' : '#8a7060';
    ctx.font = 'bold 10px sans-serif'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.fillText((comp.values.voltage || 24) + 'V', cx, cy);
    ctx.font = '7px sans-serif';
    ctx.fillText('+', cx, 6); ctx.fillText('\u2212', cx, h - 6);
    ctx.textBaseline = 'alphabetic';
  }

  function drawPushButtonNOSymbol(w, h, comp) {
    var isPressed = comp.values.pressed === 'Pressed';
    var col = isPressed ? '#ff9800' : '#6a5040';
    ctx.fillStyle = '#1a2535'; ctx.strokeStyle = col; ctx.lineWidth = 1.5;
    ctx.fillRect(2, 4, w - 4, h - 8); ctx.strokeRect(2, 4, w - 4, h - 8);
    ctx.strokeStyle = col; ctx.lineWidth = 2;
    ctx.beginPath(); ctx.moveTo(6, h / 2); ctx.lineTo(w / 2 - 4, h / 2); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(w / 2 + 4, h / 2); ctx.lineTo(w - 6, h / 2); ctx.stroke();
    if (!isPressed) {
      ctx.beginPath(); ctx.moveTo(w / 2 - 4, h / 2); ctx.lineTo(w / 2 + 4, h / 2 - 8); ctx.stroke();
    } else {
      ctx.beginPath(); ctx.moveTo(w / 2 - 4, h / 2); ctx.lineTo(w / 2 + 4, h / 2); ctx.stroke();
    }
    ctx.fillStyle = col; ctx.font = '6px sans-serif'; ctx.textAlign = 'center';
    var pbPair = comp.values && comp.values.safetyPair;
    ctx.fillText('NO' + (pbPair && pbPair !== 'None' ? ' · ' + pbPair : ''), w / 2, h - 2);
    ctx.fillStyle = '#667799'; ctx.font = 'bold 6px sans-serif';
    ctx.fillText(designationOf(comp) || 'S1', w / 2, 10);
  }

  function drawPushButtonNCSymbol(w, h, comp) {
    var isPressed = comp.values.pressed === 'Pressed';
    var col = isPressed ? '#ff5555' : '#ff9800';
    ctx.fillStyle = '#1a2535'; ctx.strokeStyle = col; ctx.lineWidth = 1.5;
    ctx.fillRect(2, 4, w - 4, h - 8); ctx.strokeRect(2, 4, w - 4, h - 8);
    ctx.strokeStyle = col; ctx.lineWidth = 2;
    ctx.beginPath(); ctx.moveTo(6, h / 2); ctx.lineTo(w / 2 - 4, h / 2); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(w / 2 + 4, h / 2); ctx.lineTo(w - 6, h / 2); ctx.stroke();
    if (isPressed) {
      ctx.beginPath(); ctx.moveTo(w / 2 - 4, h / 2); ctx.lineTo(w / 2 + 4, h / 2 - 8); ctx.stroke();
    } else {
      ctx.beginPath(); ctx.moveTo(w / 2 - 4, h / 2); ctx.lineTo(w / 2 + 4, h / 2); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(w / 2, h / 2 - 2); ctx.lineTo(w / 2, h / 2 + 2); ctx.stroke();
    }
    ctx.fillStyle = col; ctx.font = '6px sans-serif'; ctx.textAlign = 'center';
    ctx.fillText('NC', w / 2, h - 2);
    ctx.fillStyle = '#667799'; ctx.font = 'bold 6px sans-serif';
    ctx.fillText(designationOf(comp) || 'S1', w / 2, 10);
  }

  function drawToggleSwitchSymbol(w, h, comp) {
    var isOn = comp.values.state === 'On';
    var col = isOn ? '#ff9800' : '#6a5040';
    ctx.fillStyle = '#1a2535'; ctx.strokeStyle = col; ctx.lineWidth = 1.5;
    ctx.fillRect(2, 4, w - 4, h - 8); ctx.strokeRect(2, 4, w - 4, h - 8);
    ctx.strokeStyle = col; ctx.lineWidth = 2;
    ctx.beginPath(); ctx.moveTo(6, h / 2); ctx.lineTo(w / 2 - 6, h / 2); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(w / 2 + 6, h / 2); ctx.lineTo(w - 6, h / 2); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(w / 2 - 6, h / 2);
    if (isOn) ctx.lineTo(w / 2 + 6, h / 2);
    else ctx.lineTo(w / 2 + 4, h / 2 - 10);
    ctx.stroke();
    ctx.fillStyle = col; ctx.font = '6px sans-serif'; ctx.textAlign = 'center';
    ctx.fillText(isOn ? 'ON' : 'OFF', w / 2, h - 2);
    ctx.fillStyle = '#667799'; ctx.font = 'bold 6px sans-serif';
    ctx.fillText(designationOf(comp) || 'S1', w / 2, 10);
  }

  function drawRelaySPDTSymbol(w, h, comp) {
    /* Colour from the SAME effective armature state the conduction model uses
       (coil OR self-hold), otherwise the symbol contradicts the circuit. */
    var isEnergized = (comp._effCoil !== undefined) ? !!comp._effCoil
                    : !!(comp._coilEnergized || comp._prevCoilEnergized);
    var col = isEnergized ? '#ff9800' : '#6a5040';
    ctx.fillStyle = '#1a2535'; ctx.strokeStyle = '#5a8ab5'; ctx.lineWidth = 1;
    ctx.fillRect(2, 2, w - 4, 26); ctx.strokeRect(2, 2, w - 4, 26);
    ctx.fillStyle = col; ctx.font = 'bold 8px sans-serif'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.fillText((comp.values && comp.values.label) || 'K1', w / 2, 15); ctx.textBaseline = 'alphabetic';
    ctx.strokeStyle = '#5a8ab5'; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(2, 30); ctx.lineTo(w - 2, 30); ctx.stroke();
    ctx.strokeStyle = col; ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.moveTo(6, 45); ctx.lineTo(20, 45); ctx.stroke();
    if (isEnergized) {
      ctx.beginPath(); ctx.moveTo(20, 45); ctx.lineTo(w - 6, 35); ctx.stroke();
    } else {
      ctx.beginPath(); ctx.moveTo(20, 45); ctx.lineTo(w - 6, 55); ctx.stroke();
    }
    ctx.fillStyle = '#556688'; ctx.font = '6px sans-serif';
    ctx.fillText('COM', 13, h - 1); ctx.fillText('NO', w - 10, 34);
    ctx.fillText('NC', w - 10, h - 1);
  }

  /* Auxiliary relay contact — a stand-alone NO/NC contact driven by a labelled coil */
  function drawRelayContactSymbol(w, h, comp) {
    /* One armature per coil label — the effective state is computed ONCE in
       computeElectrical() and shared by the coil's own contact and every aux
       contact (IEC 61810-1: all contacts move together). */
    var orphan = !!comp._orphanCoil;
    var on = !!comp._effCoil;
    var isNc = (comp.values && comp.values.mode === 'NC');
    var closed = orphan ? false : (isNc ? !on : on);
    var col = orphan ? '#5a5560' : (closed ? '#ff9800' : '#6a5040');
    var cy = h / 2;
    if (orphan) {
      /* Faulted: the referenced coil does not exist on this sheet. Draw the
         contact permanently open in grey so it cannot read as a live wire. */
      ctx.save();
      ctx.strokeStyle = col; ctx.lineWidth = 1.5;
      ctx.beginPath(); ctx.moveTo(2, cy); ctx.lineTo(14, cy); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(14, cy); ctx.lineTo(w - 16, cy - 9); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(w - 14, cy); ctx.lineTo(w - 2, cy); ctx.stroke();
      ctx.setLineDash([2, 2]);
      ctx.strokeStyle = '#ff5555'; ctx.lineWidth = 1;
      ctx.beginPath(); ctx.arc(w / 2, cy, 9, 0, Math.PI * 2); ctx.stroke();
      ctx.restore();
      ctx.fillStyle = '#ff7777'; ctx.font = 'bold 8px sans-serif'; ctx.textAlign = 'center';
      ctx.fillText('?' + ((comp.values && comp.values.coil) || 'K1'), w / 2, cy - 11);
      ctx.fillStyle = '#8a5a5a'; ctx.font = '6px sans-serif';
      ctx.fillText('no coil', w / 2, h + 1);
      return;
    }
    ctx.strokeStyle = col; ctx.lineWidth = 1.5;
    /* Left contact stub */
    ctx.beginPath(); ctx.moveTo(2, cy); ctx.lineTo(14, cy); ctx.stroke();
    /* Hinged blade — down-right when open, horizontal when closed */
    ctx.beginPath(); ctx.moveTo(14, cy);
    if (closed) ctx.lineTo(w - 14, cy);
    else ctx.lineTo(w - 16, cy - 9);
    ctx.stroke();
    /* Right contact stub + terminal dot */
    ctx.beginPath(); ctx.moveTo(w - 14, cy); ctx.lineTo(w - 2, cy); ctx.stroke();
    ctx.fillStyle = col; ctx.beginPath(); ctx.arc(w - 14, cy, 1.6, 0, Math.PI * 2); ctx.fill();
    /* NC diagonal slash marker */
    if (isNc) {
      ctx.strokeStyle = '#8899aa'; ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(w / 2 - 4, cy - 7); ctx.lineTo(w / 2 + 6, cy + 3); ctx.stroke();
    }
    /* Coil label + type */
    ctx.fillStyle = closed ? '#ffb84d' : '#8899aa';
    ctx.font = 'bold 8px sans-serif'; ctx.textAlign = 'center';
    ctx.fillText(((comp.values && comp.values.coil) || 'K1') + (isNc ? '' : ''), w / 2, cy - 11);
    ctx.fillStyle = '#556688'; ctx.font = '6px sans-serif';
    ctx.fillText(isNc ? 'NC' : 'NO', w / 2, h + 1);
  }

  /* Counter — box shows count/preset, output contact at the bottom */
  function drawCounterSymbol(w, h, comp) {
    var reached = comp._countReached || false;
    var col = reached ? '#ff9800' : '#6a5040';
    var cnt = comp._count || 0;
    var preset = (comp.values && comp.values.preset) || 3;
    ctx.fillStyle = '#1a2535'; ctx.strokeStyle = '#5a8ab5'; ctx.lineWidth = 1;
    ctx.fillRect(2, 2, w - 4, 44); ctx.strokeRect(2, 2, w - 4, 44);
    /* Title */
    ctx.fillStyle = '#8899aa'; ctx.font = 'bold 7px sans-serif'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.fillText(designationOf(comp) || 'P1', w / 2, 10);
    /* Count / preset */
    ctx.fillStyle = reached ? '#ffb84d' : '#c0d0e8'; ctx.font = 'bold 13px ui-monospace, monospace';
    ctx.fillText(cnt + '/' + preset, w / 2, 27);
    ctx.textBaseline = 'alphabetic';
    /* Port hints */
    ctx.fillStyle = '#556688'; ctx.font = '5.5px sans-serif';
    ctx.textAlign = 'left'; ctx.fillText('Cnt', 4, 16); ctx.fillText('Rst', 4, 36);
    ctx.textAlign = 'right'; ctx.fillText('Cnt', w - 4, 16); ctx.fillText('Rst', w - 4, 36);
    /* Output contact NO at bottom */
    ctx.strokeStyle = '#5a8ab5'; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(2, 46); ctx.lineTo(w - 2, 46); ctx.stroke();
    ctx.strokeStyle = col; ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.moveTo(6, 56); ctx.lineTo(20, 56); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(20, 56); ctx.lineTo(w - 6, reached ? 56 : 49); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(w - 6, 56); ctx.lineTo(w - 2, 56); ctx.stroke();
    ctx.fillStyle = '#556688'; ctx.font = '5.5px sans-serif'; ctx.textAlign = 'center';
    ctx.fillText('COM', 12, h); ctx.fillText('NO', w - 10, h);
  }

  function drawTimerRelayOnSymbol(w, h, comp) {
    var isEnergized = (comp._effCoil !== undefined) ? !!comp._effCoil : !!comp._coilEnergized;
    var col = isEnergized ? '#ff9800' : '#6a5040';
    ctx.fillStyle = '#1a2535'; ctx.strokeStyle = '#5a8ab5'; ctx.lineWidth = 1;
    ctx.fillRect(2, 2, w - 4, 26); ctx.strokeRect(2, 2, w - 4, 26);
    ctx.fillStyle = col; ctx.font = 'bold 8px sans-serif'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.fillText('T\u2191', w / 2, 15); ctx.textBaseline = 'alphabetic';
    if (isEnergized && comp._timerElapsed !== undefined) {
      var pct = Math.min(1, comp._timerElapsed / (comp.values.delay || 3));
      ctx.fillStyle = 'rgba(255,152,0,0.3)'; ctx.fillRect(4, 22, (w - 8) * pct, 4);
    }
    ctx.strokeStyle = '#5a8ab5'; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(2, 30); ctx.lineTo(w - 2, 30); ctx.stroke();
    var closed = comp._timerFired;
    ctx.strokeStyle = col; ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.moveTo(6, 45); ctx.lineTo(20, 45); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(20, 45); ctx.lineTo(w - 6, closed ? 45 : 38); ctx.stroke();
  }

  function drawTimerRelayOffSymbol(w, h, comp) {
    var isEnergized = (comp._effCoil !== undefined) ? !!comp._effCoil : !!comp._coilEnergized;
    var col = isEnergized ? '#ff9800' : '#6a5040';
    ctx.fillStyle = '#1a2535'; ctx.strokeStyle = '#5a8ab5'; ctx.lineWidth = 1;
    ctx.fillRect(2, 2, w - 4, 26); ctx.strokeRect(2, 2, w - 4, 26);
    ctx.fillStyle = col; ctx.font = 'bold 8px sans-serif'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.fillText('T\u2193', w / 2, 15); ctx.textBaseline = 'alphabetic';
    ctx.strokeStyle = '#5a8ab5'; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(2, 30); ctx.lineTo(w - 2, 30); ctx.stroke();
    var closed = comp._timerFired;
    ctx.strokeStyle = col; ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.moveTo(6, 45); ctx.lineTo(20, 45); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(20, 45); ctx.lineTo(w - 6, closed ? 45 : 38); ctx.stroke();
  }

  function drawSolenoidCoilSymbol(w, h, comp) {
    var isEnergized = comp._elecEnergized;
    var col = isEnergized ? '#ff9800' : '#6a5040';
    ctx.fillStyle = '#1a2535'; ctx.strokeStyle = col; ctx.lineWidth = 2;
    ctx.fillRect(4, 4, w - 8, h - 8); ctx.strokeRect(4, 4, w - 8, h - 8);
    ctx.strokeStyle = col; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(8, 10); ctx.lineTo(w - 8, h - 10); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(w - 8, 10); ctx.lineTo(8, h - 10); ctx.stroke();
    ctx.fillStyle = col; ctx.font = 'bold 9px sans-serif'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    /* EN 81346: solenoids are Y1, Y2, … — a bare 'Y' is not a designation */
    ctx.fillText(designationOf(comp) || 'Y1', w / 2, h / 2); ctx.textBaseline = 'alphabetic';
    if (isEnergized) {
      ctx.save(); ctx.shadowColor = '#ff9800'; ctx.shadowBlur = 10;
      ctx.strokeStyle = 'rgba(255,152,0,0.4)'; ctx.lineWidth = 3;
      ctx.strokeRect(2, 2, w - 4, h - 4); ctx.restore();
    }
    /* Which valve and which spool side this coil actually drives */
    var scSide = (comp.values && comp.values.side) || 'Y1';
    var scTarget = comp.values.linkedValve || comp._autoLinkedValve || 0;
    if (scTarget) {
      ctx.fillStyle = comp.values.linkedValve ? '#556688' : '#7a6a44';
      ctx.font = '6px sans-serif'; ctx.textAlign = 'center';
      ctx.fillText((comp.values.linkedValve ? 'V' : '~V') + scTarget + ' ' + scSide, w / 2, h + 2);
    }
  }

  function drawPressureSwitchEPSymbol(w, h, comp) {
    /* _elecClosed is the SENSED state (pressure reached). The contact that is
       actually drawn must apply the NO/NC inversion the solver applies,
       otherwise an NC switch draws open while it is conducting. */
    var psTripped = !!comp._elecClosed;
    var psIsNc = (comp.values && comp.values.mode === 'NC');
    var isClosed = psIsNc ? !psTripped : psTripped;
    var col = isClosed ? '#ff9800' : '#6a5040';
    ctx.fillStyle = '#1a2535'; ctx.strokeStyle = '#5a8ab5'; ctx.lineWidth = 1.5;
    ctx.fillRect(2, 2, w - 4, h - 8); ctx.strokeRect(2, 2, w - 4, h - 8);
    ctx.beginPath(); ctx.arc(w / 2, h - 10, 6, 0, Math.PI * 2);
    ctx.strokeStyle = '#42a5f5'; ctx.stroke();
    ctx.strokeStyle = col; ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.moveTo(6, 15); ctx.lineTo(15, 15); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(15, 15); ctx.lineTo(w - 6, isClosed ? 15 : 8); ctx.stroke();
    ctx.fillStyle = col; ctx.font = 'bold 7px sans-serif'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.fillText(designationOf(comp) || 'B1', w / 2, 26); ctx.textBaseline = 'alphabetic';
    ctx.fillStyle = '#556688'; ctx.font = '5.5px sans-serif';
    ctx.fillText(psIsNc ? 'NC' : 'NO', w / 2, 36);
  }

  function drawLimitSwitchEPSymbol(w, h, comp) {
    var lsTripped = !!comp._elecClosed;
    var lsIsNc = (comp.values && comp.values.mode === 'NC');
    var isClosed = lsIsNc ? !lsTripped : lsTripped;
    var col = isClosed ? '#ff9800' : '#6a5040';
    ctx.fillStyle = '#1a2535'; ctx.strokeStyle = col; ctx.lineWidth = 1.5;
    ctx.fillRect(2, 4, w - 4, h - 8); ctx.strokeRect(2, 4, w - 4, h - 8);
    ctx.strokeStyle = col; ctx.lineWidth = 2;
    ctx.beginPath(); ctx.moveTo(6, h / 2); ctx.lineTo(15, h / 2); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(15, h / 2); ctx.lineTo(w - 10, isClosed ? h / 2 : h / 2 - 8); ctx.stroke();
    ctx.beginPath(); ctx.arc(w - 8, isClosed ? h / 2 : h / 2 - 8, 3, 0, Math.PI * 2);
    ctx.fillStyle = col; ctx.fill();
    ctx.fillStyle = col; ctx.font = 'bold 7px sans-serif'; ctx.textAlign = 'center';
    /* EN 81346: a position switch is S<n>, not the ANSI abbreviation 'LS' */
    ctx.fillText((designationOf(comp) || 'S1') + (lsIsNc ? ' NC' : ''), w / 2, h - 2);
  }

  /* Reed switch — magnetic sensor: blade in a glass capsule, closes near target */
  function drawReedSwitchSymbol(w, h, comp) {
    var reSensed = !!comp._elecClosed;
    var reIsNc = (comp.values && comp.values.mode === 'NC');
    var isClosed = reIsNc ? !reSensed : reSensed;
    var col = isClosed ? '#ff9800' : '#6a5040';
    ctx.fillStyle = '#1a2535'; ctx.strokeStyle = '#5a8ab5'; ctx.lineWidth = 1;
    ctx.fillRect(2, 4, w - 4, h - 8); ctx.strokeRect(2, 4, w - 4, h - 8);
    /* Glass capsule (rounded) around the reed blades */
    ctx.strokeStyle = '#8899aa'; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.ellipse(w / 2, h / 2 - 2, 13, 6, 0, 0, Math.PI * 2); ctx.stroke();
    /* Reed blades */
    ctx.strokeStyle = col; ctx.lineWidth = 1.6;
    ctx.beginPath(); ctx.moveTo(6, h / 2 - 2); ctx.lineTo(w / 2 - 1, h / 2 - 2); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(w - 6, h / 2 - 2); ctx.lineTo(w / 2 + 1, isClosed ? h / 2 - 2 : h / 2 - 5); ctx.stroke();
    /* Label + sense position */
    ctx.fillStyle = col; ctx.font = 'bold 6px sans-serif'; ctx.textAlign = 'center';
    var pos = (comp.values && comp.values.position) || 'Extended';
    var tag = pos === 'Retracted' ? 'B0' : (pos === 'Mid-stroke' ? 'B½' : 'B1');
    ctx.fillText(tag + (reIsNc ? ' NC' : ''), w / 2, h - 2);
  }

  /* Buzzer — audible signal device (semicircle + sound arcs when active) */
  function drawBuzzerSymbol(w, h, comp) {
    var on = comp._elecEnergized;
    var col = on ? '#f5c842' : '#3a4a5a';
    ctx.fillStyle = on ? 'rgba(245,200,66,0.18)' : '#1a2535';
    ctx.strokeStyle = col; ctx.lineWidth = 1.5;
    /* Dome */
    ctx.beginPath(); ctx.arc(w / 2, h / 2 + 4, 11, Math.PI, 0); ctx.lineTo(w / 2 + 11, h / 2 + 4); ctx.lineTo(w / 2 - 11, h / 2 + 4); ctx.closePath();
    ctx.fill(); ctx.stroke();
    /* Sound arcs when active */
    if (on) {
      ctx.strokeStyle = 'rgba(245,200,66,0.8)'; ctx.lineWidth = 1.2;
      for (var a = 0; a < 2; a++) {
        ctx.beginPath(); ctx.arc(w / 2, h / 2 - 2, 13 + a * 4, -Math.PI * 0.75, -Math.PI * 0.25); ctx.stroke();
      }
    }
    ctx.fillStyle = col; ctx.font = 'bold 7px sans-serif'; ctx.textAlign = 'center';
    /* EN 81346: an audible signalling device is P<n> */
    ctx.fillText(designationOf(comp) || 'P1', w / 2, h / 2 + 2);
  }

  function drawIndicatorLampSymbol(w, h, comp) {
    var isLit = comp._elecEnergized;
    var lampCol = comp.values.color === 'Red' ? '#ff5555' : (comp.values.color === 'Yellow' ? '#f5c842' : '#3ddc84');
    var col = isLit ? lampCol : '#3a4a5a';
    ctx.beginPath(); ctx.arc(w / 2, h / 2, 12, 0, Math.PI * 2);
    ctx.fillStyle = isLit ? col : '#1a2535'; ctx.fill();
    ctx.strokeStyle = col; ctx.lineWidth = 1.5; ctx.stroke();
    if (isLit) {
      ctx.save(); ctx.shadowColor = col; ctx.shadowBlur = 12;
      ctx.beginPath(); ctx.arc(w / 2, h / 2, 8, 0, Math.PI * 2);
      ctx.fillStyle = col; ctx.fill(); ctx.restore();
    }
    ctx.strokeStyle = col; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(w / 2 - 6, h / 2 - 6); ctx.lineTo(w / 2 + 6, h / 2 + 6); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(w / 2 + 6, h / 2 - 6); ctx.lineTo(w / 2 - 6, h / 2 + 6); ctx.stroke();
    /* EN 81346: signalling lamps are H<n> */
    ctx.fillStyle = '#556688'; ctx.font = 'bold 6px sans-serif'; ctx.textAlign = 'center';
    ctx.fillText(designationOf(comp) || 'H1', w / 2, h + 2);
  }

  /* Emergency-stop device — IEC 60617 CIRCUIT symbol, not a pictogram:
     an NC contact (slash marker) with a mushroom-head actuator above it and
     the mechanical-latch marker (ISO 13850: latching, twist to release). */
  function drawEStopSymbol(w, h, comp) {
    var isTripped = comp.values.tripped === 'Tripped';
    var cy = h / 2 + 6;
    var col = isTripped ? '#ff5555' : '#ff9800';

    /* Contact: fixed stubs + hinged blade (closed at rest = NC) */
    ctx.strokeStyle = col; ctx.lineWidth = 1.8;
    ctx.beginPath(); ctx.moveTo(2, cy); ctx.lineTo(12, cy); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(12, cy);
    if (isTripped) ctx.lineTo(w - 14, cy - 8); else ctx.lineTo(w - 12, cy);
    ctx.stroke();
    ctx.beginPath(); ctx.moveTo(w - 12, cy); ctx.lineTo(w - 2, cy); ctx.stroke();
    ctx.fillStyle = col;
    ctx.beginPath(); ctx.arc(12, cy, 1.7, 0, Math.PI * 2); ctx.fill();
    ctx.beginPath(); ctx.arc(w - 12, cy, 1.7, 0, Math.PI * 2); ctx.fill();

    /* NC marker — the short diagonal across the blade */
    ctx.strokeStyle = '#8899aa'; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(w / 2 - 5, cy + 4); ctx.lineTo(w / 2 + 5, cy - 6); ctx.stroke();

    /* Actuator stem + mushroom head (IEC 60617 emergency-operation actuator) */
    ctx.strokeStyle = col; ctx.lineWidth = 1.2;
    ctx.beginPath(); ctx.moveTo(w / 2, cy - 2); ctx.lineTo(w / 2, 12); ctx.stroke();
    ctx.beginPath(); ctx.arc(w / 2, 12, 8, Math.PI, 0); ctx.closePath();
    ctx.fillStyle = isTripped ? '#ff2222' : '#cc0000'; ctx.fill();
    ctx.strokeStyle = '#ff8888'; ctx.lineWidth = 1.2; ctx.stroke();

    /* Mechanical-latch marker: the small hook on the stem */
    ctx.strokeStyle = isTripped ? '#ffcc66' : '#7a8899'; ctx.lineWidth = 1.2;
    ctx.beginPath();
    ctx.moveTo(w / 2 + 1, 18); ctx.lineTo(w / 2 + 6, 18); ctx.lineTo(w / 2 + 6, 23);
    ctx.stroke();

    ctx.fillStyle = isTripped ? '#ff8888' : '#8899aa';
    ctx.font = 'bold 6px sans-serif'; ctx.textAlign = 'center';
    ctx.fillText(designationOf(comp) || 'S1', 10, 8);
    if (isTripped) {
      ctx.fillStyle = '#ffcc66'; ctx.font = '5.5px sans-serif';
      ctx.fillText('LATCHED', w / 2, h + 1);
    }
  }

  /* ================================================================
     HIT TESTING
     ================================================================ */

  function hitTestComponent(mx, my) {
    for (var i = components.length - 1; i >= 0; i--) {
      var comp = components[i];
      var ed = getEffectiveDims(comp);
      if (mx >= comp.x && mx <= comp.x + ed.w && my >= comp.y && my <= comp.y + ed.h) return comp;
    }
    return null;
  }

  function hitTestPort(mx, my, threshold) {
    threshold = (threshold || 12) * _touchScale();
    for (var i = components.length - 1; i >= 0; i--) {
      var comp = components[i];
      var def = COMP_DEFS[comp.type];
      for (var p = 0; p < def.ports.length; p++) {
        var port = getRotatedPort(def, p, comp.orient);
        var px = comp.x + port.x, py = comp.y + port.y;
        var dx = mx - px, dy = my - py;
        if (dx * dx + dy * dy < threshold * threshold) return { compId: comp.id, portIdx: p };
      }
    }
    return null;
  }

  function hitTestConnection(mx, my, threshold) {
    threshold = (threshold || 6) * _touchScale();
    for (var i = connections.length - 1; i >= 0; i--) {
      var path = _pathCache[i] || getConnectionPath(connections[i]);
      if (!path) continue;
      for (var s = 1; s < path.length; s++) {
        if (pointToSegmentDist(mx, my, path[s - 1].x, path[s - 1].y, path[s].x, path[s].y) < threshold) return i;
      }
    }
    return -1;
  }

  function hitTestSegment(mx, my, threshold) {
    threshold = (threshold || 8) * _touchScale();
    for (var i = connections.length - 1; i >= 0; i--) {
      var path = _pathCache[i];
      if (!path || path.length < 4) continue;
      for (var s = 2; s < path.length - 1; s++) {
        var a = path[s - 1], b = path[s];
        var isH = Math.abs(a.y - b.y) < 1, isV = Math.abs(a.x - b.x) < 1;
        if (!isH && !isV) continue;
        if (Math.abs(isH ? (b.x - a.x) : (b.y - a.y)) < 5) continue;
        if (pointToSegmentDist(mx, my, a.x, a.y, b.x, b.y) < threshold) return { connIdx: i, segIdx: s, axis: isH ? 'y' : 'x' };
      }
    }
    return null;
  }

  /* Convert auto-routed connection to explicit waypoints for segment dragging */
  function convertToWaypoints(connIdx) {
    var conn = connections[connIdx];
    if (conn.waypoints && conn.waypoints.length > 0) return;
    var path = _pathCache[connIdx];
    if (!path || path.length < 4) return;
    /* Extract middle points: skip [0]=port, [1]=stub, [last-1]=stub, [last]=port */
    conn.waypoints = [];
    for (var i = 2; i < path.length - 2; i++) {
      conn.waypoints.push({ x: path[i].x, y: path[i].y });
    }
    delete conn._dragOffset;
    delete conn._autoNudge;
  }

  /* ================================================================
     UNDO SYSTEM
     ================================================================ */

  function captureSnapshot() {
    return {
      components: JSON.parse(JSON.stringify(components.map(function (c) {
        return { id: c.id, type: c.type, x: c.x, y: c.y, values: c.values, orient: c.orient, extension: 0, rotation: 0, reading: 0 };
      }))),
      connections: JSON.parse(JSON.stringify(connections.map(function (cn) {
        return { from: cn.from, to: cn.to, waypoints: cn.waypoints, pressure: 0, flow: 0, flowDir: 0 };
      }))),
      nextId: nextId,
      annStrokes: JSON.parse(JSON.stringify(annStrokes)),
      annShapes: JSON.parse(JSON.stringify(annShapes))
    };
  }

  function saveUndoState() {
    undoStack.push(captureSnapshot());
    if (undoStack.length > MAX_UNDO) undoStack.shift();
    redoStack = []; /* a new action invalidates the redo history */
  }

  function restoreSnapshot(state) {
    components = state.components;
    connections = state.connections;
    nextId = state.nextId;
    if (state.annStrokes) annStrokes = state.annStrokes;
    if (state.annShapes) annShapes = state.annShapes;
    annSelectedIdx = -1; annSelectedType = '';
    selectedComp = null;
    selectedConn = -1;
    connectingFrom = null;
    particles = [];
    if (running) computeCircuit();
    draw();
  }

  function performUndo() {
    if (undoStack.length === 0) return;
    redoStack.push(captureSnapshot());
    if (redoStack.length > MAX_UNDO) redoStack.shift();
    restoreSnapshot(undoStack.pop());
  }

  function performRedo() {
    if (redoStack.length === 0) return;
    undoStack.push(captureSnapshot());
    if (undoStack.length > MAX_UNDO) undoStack.shift();
    restoreSnapshot(redoStack.pop());
  }

  /* ================================================================
     SMART COMPONENT PLACEMENT
     ================================================================ */

  function findFreeSpot(def) {
    var pad = 30, step = 100, margin = 20;
    for (var sy = margin; sy + def.h < H - margin; sy += step) {
      for (var sx = margin; sx + def.w < W - margin; sx += step) {
        var cx = Math.round(sx / 20) * 20;
        var cy = Math.round(sy / 20) * 20;
        var overlap = false;
        for (var i = 0; i < components.length; i++) {
          var ed = getEffectiveDims(components[i]);
          if (cx < components[i].x + ed.w + pad && cx + def.w + pad > components[i].x &&
              cy < components[i].y + ed.h + pad && cy + def.h + pad > components[i].y) {
            overlap = true; break;
          }
        }
        if (!overlap) return { x: cx, y: cy };
      }
    }
    return { x: Math.round((W / 2 - def.w / 2 + components.length * 30) / 20) * 20, y: Math.round((H / 2 - def.h / 2 + components.length * 30) / 20) * 20 };
  }

  function addComponent(type) {
    var def = COMP_DEFS[type];
    if (!def) return;
    saveUndoState();
    var pos = findFreeSpot(def);
    var vals = {};
    for (var k in def.params) vals[k] = def.params[k].def;
    var comp = { id: nextId++, type: type, x: pos.x, y: pos.y, orient: 0, values: vals, extension: 0, rotation: 0, reading: 0 };
    components.push(comp);
    selectedComp = comp;
    updateProperties();
    draw();
  }

  /* ================================================================
     PROPERTIES PANEL
     ================================================================ */

  function updateProperties() {
    if (!selectedComp) {
      propsPanel.style.display = 'none';
      return;
    }
    var def = COMP_DEFS[selectedComp.type];
    if (!def || !def.params || Object.keys(def.params).length === 0) {
      propsPanel.style.display = 'none';
      return;
    }
    propsPanel.style.display = '';
    propsBody.innerHTML = '';
    for (var k in def.params) {
      var p = def.params[k];
      var val = selectedComp.values[k];
      var label = document.createElement('label');
      if (p.type === 'select') {
        label.textContent = p.label;
        var sel = document.createElement('select');
        for (var o = 0; o < p.options.length; o++) {
          var opt = document.createElement('option');
          opt.value = p.options[o];
          opt.textContent = p.options[o];
          if (p.options[o] === val) opt.selected = true;
          sel.appendChild(opt);
        }
        (function (key, select) {
          select.addEventListener('change', function () {
            selectedComp.values[key] = select.value;
            if (running) computeCircuit();
            draw();
          });
        })(k, sel);
        label.appendChild(sel);
      } else {
        var span = document.createElement('span');
        span.className = 'prop-val';
        span.textContent = p.label + ': ' + val;
        label.appendChild(span);
        var range = document.createElement('input');
        range.type = 'range';
        range.min = p.min;
        range.max = p.max;
        range.step = p.step;
        range.value = val;
        /* Editable number input paired with the slider — exact value entry */
        var num = document.createElement('input');
        num.type = 'number';
        num.className = 'props-num';
        num.setAttribute('inputmode', 'decimal');
        num.min = p.min;
        num.max = p.max;
        num.step = p.step;
        num.value = val;
        num.setAttribute('aria-label', p.label);
        (function (key, rng, sp, param, numEl) {
          rng.addEventListener('input', function () {
            var v = parseFloat(rng.value);
            selectedComp.values[key] = v;
            numEl.value = v;
            sp.textContent = param.label + ': ' + v;
            if (running) computeCircuit();
            draw();
          });
          function commitNum() {
            var v = parseFloat(numEl.value);
            if (isNaN(v)) { numEl.value = selectedComp.values[key]; return; }
            v = Math.min(param.max, Math.max(param.min, v));
            numEl.value = v;
            selectedComp.values[key] = v;
            rng.value = v;
            sp.textContent = param.label + ': ' + v;
            if (running) computeCircuit();
            draw();
          }
          numEl.addEventListener('focus', function () { saveUndoState(); });
          numEl.addEventListener('change', commitNum);
          numEl.addEventListener('keydown', function (e) { if (e.key === 'Enter') { commitNum(); numEl.blur(); } });
        })(k, range, span, p, num);
        label.appendChild(range);
        label.appendChild(num);
      }
      propsBody.appendChild(label);
    }
  }

  /* ================================================================
     SIMULATION ENGINE — Pneumatic BFS
     ================================================================ */

  function buildAdjacency() {
    var adj = {};
    for (var i = 0; i < connections.length; i++) {
      var cn = connections[i];
      var fId = cn.from.compId, tId = cn.to.compId;
      if (!adj[fId]) adj[fId] = [];
      if (!adj[tId]) adj[tId] = [];
      adj[fId].push({ conn: cn, connIdx: i, otherCompId: tId, otherPort: cn.to.portIdx, myPort: cn.from.portIdx });
      adj[tId].push({ conn: cn, connIdx: i, otherCompId: fId, otherPort: cn.from.portIdx, myPort: cn.to.portIdx });
    }
    return adj;
  }

  /* Solver diagnostics — surfaced in the warning bar while running. */
  var _solverUnsettled = false;
  var _lastUnsettledWarn = -99;
  var _lastBothSolWarn = -99;

  function computeCircuit() {
    /* Build adjacency ONCE per tick — pneumatic BFS, computeElectrical (run multiple
       times by the iterate-until-stable loop), and cross-domain feedback all share it. */
    _adjCache = buildAdjacency();

    /* Preserve relay/timer coil state from previous frame for self-holding
       circuits. `_effCoil` (the armature state every contact reads) MUST be
       re-seeded from the previous tick's SETTLED coil state too — inside the
       iterate loop it is deliberately sticky, and carrying that sticky value
       into the next tick made a self-hold re-latch the instant a Stop button
       was released, because the first BFS of the new tick still saw the
       self-hold contact closed. */
    for (var cp = 0; cp < components.length; cp++) {
      components[cp]._prevCoilEnergized = components[cp]._coilEnergized || false;
      components[cp]._effCoil = components[cp]._coilEnergized || false;
    }

    /* Reset all */
    for (var i = 0; i < connections.length; i++) {
      connections[i].pressure = 0;
      connections[i].flow = 0;
      connections[i].flowDir = 0;
      connections[i]._voltage = 0;
    }
    for (var c = 0; c < components.length; c++) {
      components[c]._localPressure = 0;
      components[c]._localFlow = 0;
      components[c]._extending = false;
      components[c]._stalled = false;
      components[c]._elecEnergized = false;
      components[c]._coilEnergized = false;
      components[c]._y1Energized = false;
      components[c]._y2Energized = false;
      components[c]._exhaustCenter = false;
      components[c]._workingVented = false;
      components[c]._vacuumActive = false;
      components[c]._vacuumLevel = 0;
      components[c]._gripping = false;
      components[c]._discharging = false;
      /* _reliefActive, _sequenceOpen and _tankP carry state across frames — don't reset */
    }

    /* Step 1: Update limit switch & pressure switch states from PREVIOUS frame
       (cylinder positions and pressures persist from last animation frame) */
    updateSensorStates();

    /* Steps 2–4: ITERATE-UNTIL-STABLE electrical evaluation.
       FluidSIM-style: a chain of N relays / timer contacts must settle in one tick
       so the displayed behaviour matches the user's mental model. We loop:
         a) computeElectrical  (relay coils + contacts)
         b) updateTimerStates  (timer contacts based on coil state)
       Compare _coilEnergized + _timerFired snapshots; break when stable.
       Cap at SOLVER_MAX_ITER as runaway-loop protection — and if we hit the cap
       the answer is NOT converged, so say so instead of silently displaying a
       half-settled circuit (relay race / oscillating self-interrupting rung). */
    var SOLVER_MAX_ITER = 24;
    var snap = function() {
      var s = [];
      for (var ss = 0; ss < components.length; ss++) {
        var sc = components[ss];
        s.push((sc._coilEnergized ? 'C' : '') + (sc._timerFired ? 'T' : '') +
               (sc._elecClosed ? 'X' : '') + (sc._y1Energized ? '1' : '') +
               (sc._y2Energized ? '2' : '') + (sc._effCoil ? 'E' : ''));
      }
      return s.join('|');
    };
    var prevSnap = snap();
    var _settled = false;
    for (var iter = 0; iter < SOLVER_MAX_ITER; iter++) {
      for (var re = 0; re < components.length; re++) {
        components[re]._elecEnergized = false;
        /* Promote current _coilEnergized to _prevCoilEnergized so self-hold latches survive. */
        components[re]._prevCoilEnergized = components[re]._coilEnergized || components[re]._prevCoilEnergized || false;
        components[re]._coilEnergized = false;
        components[re]._y1Energized = false;
        components[re]._y2Energized = false;
      }
      computeElectrical();
      updateTimerStates();
      var newSnap = snap();
      if (newSnap === prevSnap) { _settled = true; break; }
      prevSnap = newSnap;
    }
    _solverUnsettled = !_settled;
    if (_solverUnsettled && running && (simTime - _lastUnsettledWarn) > 4) {
      _lastUnsettledWarn = simTime;
      flashWarning('Circuit did not settle — check for relay race/oscillation (a coil that interrupts its own rung, or a chain deeper than ' + SOLVER_MAX_ITER + ' stages)');
    }

    /* EN 574 two-hand safety enforcement: PBs tagged safetyPair='A' and 'B' must be
       pressed within 0.5 s of each other. If outside the window, force the LATER button
       open — breaks the series chain and de-energises the press cylinder. Anti-tie-down. */
    var pbA = null, pbB = null;
    for (var sp = 0; sp < components.length; sp++) {
      var spc = components[sp];
      if (spc.type !== 'push-button-no' && spc.type !== 'push-button-nc') continue;
      var sPair = spc.values && spc.values.safetyPair;
      if (sPair === 'A') pbA = spc;
      else if (sPair === 'B') pbB = spc;
    }
    if (pbA && pbB) {
      var aP = pbA.values.pressed === 'Pressed';
      var bP = pbB.values.pressed === 'Pressed';
      if (aP && bP && pbA._pressTime && pbB._pressTime) {
        var dt = Math.abs(pbA._pressTime - pbB._pressTime);
        if (dt > 0.5) {
          /* Tie-down violation: force the later-pressed button open. */
          var late = (pbA._pressTime > pbB._pressTime) ? pbA : pbB;
          late.values.pressed = (late.type === 'push-button-no') ? 'Open' : 'Closed';
          late._safetyFault = true;
          /* Re-run electrical pass once to propagate the cleared state. */
          for (var rr = 0; rr < components.length; rr++) {
            components[rr]._elecEnergized = false;
            components[rr]._coilEnergized = false;
            components[rr]._y1Energized = false;
            components[rr]._y2Energized = false;
          }
          computeElectrical();
          updateTimerStates();
        } else {
          pbA._safetyFault = false; pbB._safetyFault = false;
        }
      } else {
        pbA._safetyFault = false; pbB._safetyFault = false;
      }
    }

    /* Step 5: Apply solenoid valve positions based on final electrical state */
    applySolenoidStates();

    var adj = _adjCache; /* Reuse the per-tick adjacency cache built at top of computeCircuit. */

    /* Collect ALL air supplies — FluidSIM supports multi-compressor circuits.
       Each supply is seeded into the BFS queue with its own pressure/flow. */
    var supplies = [];
    for (var s = 0; s < components.length; s++) {
      if (components[s].type === 'air-supply') supplies.push(components[s]);
    }

    /* Air tank (receiver) reserve: a charged tank keeps the pneumatic side
       alive when no compressor exists (e.g. deleted mid-run) — the
       receiver's real job. Charging happens after the BFS below. */
    _tankReserveActive = false;
    var tankSources = [];
    if (supplies.length === 0) {
      for (var tk = 0; tk < components.length; tk++) {
        if (components[tk].type === 'air-tank' && (components[tk]._tankP || 0) > 0.5) tankSources.push(components[tk]);
      }
      if (tankSources.length === 0) {
        /* No air at all: show a dead pneumatic side (not stale values) but
           keep the electrical readouts live — electrical-only circuits are valid. */
        if (running) updateDeadPneumaticReadouts();
        updateElectricalReadouts();
        _adjCache = null;
        return;
      }
      _tankReserveActive = true;
    }

    /* Primary supply readouts use the highest-pressure source. */
    var supply = supplies[0] || null;
    var supplyPressure = supply ? (supply.values.pressure || 6) : tankSources[0]._tankP;
    var supplyFlow = supply ? (supply.values.flow || 200)
      : Math.min(200, ((tankSources[0].values && tankSources[0].values.volume) || 50) * 3);
    for (var sv = 1; sv < supplies.length; sv++) {
      var sp = supplies[sv].values.pressure || 6;
      if (sp > supplyPressure) { supply = supplies[sv]; supplyPressure = sp; supplyFlow = supplies[sv].values.flow || 200; }
    }

    /* Multi-source BFS: seed every supply simultaneously. _localPressure max-merges. */
    var visited = {};
    var queue = [];
    for (var sq = 0; sq < supplies.length; sq++) {
      var spc = supplies[sq];
      var sPP = spc.values.pressure || 6;
      var sPF = spc.values.flow || 200;
      spc._localPressure = sPP;
      spc._localFlow = sPF;
      queue.push({ compId: spc.id, pressure: sPP, flow: sPF });
      visited[spc.id] = true;
    }
    /* Discharging tanks act as BFS sources when no compressor is present */
    for (var tq = 0; tq < tankSources.length; tq++) {
      var tnk = tankSources[tq];
      var tFlow = Math.min(200, ((tnk.values && tnk.values.volume) || 50) * 3);
      tnk._localPressure = tnk._tankP;
      tnk._localFlow = tFlow;
      tnk._discharging = true;
      queue.push({ compId: tnk.id, pressure: tnk._tankP, flow: tFlow });
      visited[tnk.id] = true;
    }

    while (queue.length > 0) {
      var cur = queue.shift();
      var comp = findComp(cur.compId);
      if (!comp) continue;
      var links = adj[cur.compId] || [];

      for (var li = 0; li < links.length; li++) {
        var link = links[li];
        var other = findComp(link.otherCompId);
        if (!other) continue;

        var canPass = getPassthrough(comp, link.myPort, cur.pressure, cur.flow);
        if (!canPass.canFlow) continue;

        var outPressure = cur.pressure - (canPass.pressureDrop || 0);
        var outFlow = Math.min(cur.flow, canPass.flowLimit || cur.flow);
        if (outPressure < 0.1) continue;

        link.conn.pressure = outPressure;
        link.conn.flow = outFlow;
        link.conn.flowDir = (link.conn.from.compId === cur.compId) ? 1 : -1;

        other._localPressure = Math.max(other._localPressure || 0, outPressure);
        other._localFlow = Math.max(other._localFlow || 0, outFlow);

        if (!visited[other.id]) {
          visited[other.id] = true;
          queue.push({ compId: other.id, pressure: outPressure, flow: outFlow });
        }
      }
    }

    /* Second BFS pass — off-delay timers in drain mode act as virtual supplies.
       The 2-port pneumatic timer-off uses its pilot input as the supply path.
       Once the pilot drops, the main BFS no longer reaches the timer, so the
       output would die immediately. To preserve the "stay-on for delay" behaviour,
       we re-inject the remembered supply pressure at the timer's output port (idx 1)
       and propagate forward. Connection pressures are max-merged. */
    for (var ti2 = 0; ti2 < components.length; ti2++) {
      var todTimer = components[ti2];
      if (todTimer.type !== 'timer-off') continue;
      if (!(todTimer._timerDrain > 0) || !(todTimer._timerSupplyP > 0)) continue;
      var todQueue = [{ compId: todTimer.id, pressure: todTimer._timerSupplyP, flow: 80 }];
      var todVisited = {}; todVisited[todTimer.id] = true;
      while (todQueue.length > 0) {
        var todCur = todQueue.shift();
        var todComp = findComp(todCur.compId);
        if (!todComp) continue;
        var todLinks = adj[todCur.compId] || [];
        for (var todLi = 0; todLi < todLinks.length; todLi++) {
          var todLink = todLinks[todLi];
          if (todCur.compId === todTimer.id && todLink.myPort !== 1) continue;
          var todOther = findComp(todLink.otherCompId);
          if (!todOther) continue;
          var todCanPass;
          if (todCur.compId === todTimer.id) {
            todCanPass = { canFlow: true, pressureDrop: 0.1 };
          } else {
            todCanPass = getPassthrough(todComp, todLink.myPort, todCur.pressure, todCur.flow);
            if (!todCanPass.canFlow) continue;
          }
          var todOutP = todCur.pressure - (todCanPass.pressureDrop || 0);
          var todOutF = Math.min(todCur.flow, todCanPass.flowLimit || todCur.flow);
          if (todOutP < 0.1) continue;
          if (todOutP > todLink.conn.pressure) {
            todLink.conn.pressure = todOutP;
            todLink.conn.flow = Math.max(todLink.conn.flow, todOutF);
            todLink.conn.flowDir = (todLink.conn.from.compId === todCur.compId) ? 1 : -1;
          }
          todOther._localPressure = Math.max(todOther._localPressure || 0, todOutP);
          todOther._localFlow = Math.max(todOther._localFlow || 0, todOutF);
          if (!todVisited[todOther.id]) {
            todVisited[todOther.id] = true;
            todQueue.push({ compId: todOther.id, pressure: todOutP, flow: todOutF });
          }
        }
      }
    }

    /* Post-BFS: correct flow direction by pressure gradient */
    for (var fd = 0; fd < connections.length; fd++) {
      var cn = connections[fd];
      if (cn.pressure <= 0) continue;
      var fc = findComp(cn.from.compId);
      var tc = findComp(cn.to.compId);
      if (!fc || !tc) continue;
      var fP = fc._localPressure || 0;
      var tP = tc._localPressure || 0;
      if (fP > tP + 0.05) cn.flowDir = 1;
      else if (tP > fP + 0.05) cn.flowDir = -1;
    }

    /* Auto-shift pneumatic pilot-operated valves based on pilot port pressure.
       Solenoid-operated valves (domain:'electro') are shifted by applySolenoidStates
       earlier; we skip them here to avoid double-control. */
    var pilotTypes = ['v52-pilot', 'v52-pilot-single', 'v32-pilot-nc', 'v53-pilot-closed', 'v53-pilot-exhaust', 'v43-pilot-single', 'v43-pilot-double'];
    for (var pv = 0; pv < components.length; pv++) {
      var pvComp = components[pv];
      var pvType = pvComp.type;
      if (pilotTypes.indexOf(pvType) === -1) continue;
      var pvDef = COMP_DEFS[pvType];
      if (!pvDef) continue;
      /* Helper: get max pressure on a given port index */
      var getPilotP = function(compId, portIdx) {
        var pval = 0;
        for (var pci = 0; pci < connections.length; pci++) {
          var pcn = connections[pci];
          if ((pcn.to.compId === compId && pcn.to.portIdx === portIdx) ||
              (pcn.from.compId === compId && pcn.from.portIdx === portIdx))
            pval = Math.max(pval, pcn.pressure);
        }
        return pval;
      };
      if (pvType === 'v52-pilot') {
        /* v52-pilot ports here: idx 5 = label '12' (right), idx 6 = label '14' (left) */
        var p12 = getPilotP(pvComp.id, 5);
        var p14 = getPilotP(pvComp.id, 6);
        if (p12 > 0.5) pvComp.values.position = 'Position A';
        else if (p14 > 0.5) pvComp.values.position = 'Position B';
        /* else: bistable — holds last position */
      } else if (pvType === 'v52-pilot-single') {
        var p14s = getPilotP(pvComp.id, 5);
        pvComp.values.position = (p14s > 0.5) ? 'Actuated' : 'Normal';
      } else if (pvType === 'v32-pilot-nc') {
        var p12r = getPilotP(pvComp.id, 3);
        pvComp.values.position = (p12r > 0.5) ? 'Actuated' : 'Normal';
      } else if (pvType === 'v53-pilot-closed' || pvType === 'v53-pilot-exhaust') {
        /* idx 5 = pilot 12 → Retract, idx 6 = pilot 14 → Extend; spring-centered */
        var p12c = getPilotP(pvComp.id, 5);
        var p14c = getPilotP(pvComp.id, 6);
        if (p12c > 0.5 && p14c <= 0.5) pvComp.values.position = 'Retract';
        else if (p14c > 0.5 && p12c <= 0.5) pvComp.values.position = 'Extend';
        else pvComp.values.position = 'Center';
      } else if (pvType === 'v43-pilot-single') {
        var p14s43 = getPilotP(pvComp.id, 4);
        pvComp.values.position = (p14s43 > 0.5) ? 'Extend' : 'Center';
      } else if (pvType === 'v43-pilot-double') {
        var p12d = getPilotP(pvComp.id, 4);
        var p14d = getPilotP(pvComp.id, 5);
        if (p12d > 0.5 && p14d <= 0.5) pvComp.values.position = 'Extend';
        else if (p14d > 0.5 && p12d <= 0.5) pvComp.values.position = 'Retract';
        else pvComp.values.position = 'Center';
      }
    }

    /* Determine cylinder/actuator port pressures from connections and set extend flags */
    for (var ac2 = 0; ac2 < components.length; ac2++) {
      var cmp = components[ac2];
      var cType = cmp.type;
      if (cType === 'cyl-sa') {
        cmp._capPressure = 0;
        for (var ci2 = 0; ci2 < connections.length; ci2++) {
          var cn2 = connections[ci2];
          if ((cn2.from.compId === cmp.id && cn2.from.portIdx === 0) || (cn2.to.compId === cmp.id && cn2.to.portIdx === 0))
            cmp._capPressure = Math.max(cmp._capPressure, cn2.pressure);
        }
        /* Force balance: F_cap = P_cap[bar]·1e5 · area[m²]; load[N] = values.load.
           Spring force ≈ 50 N + 5 N/bar nominal — approximated by 0.5 bar threshold. */
        var saBore = (cmp.values.bore || 40) / 1000;
        var saArea = Math.PI / 4 * saBore * saBore;
        var saForce = (cmp._capPressure || 0) * 1e5 * saArea;
        var saLoad = (cmp.values.load || 0) + 50; /* +50 N for spring */
        cmp._stalled = (cmp._capPressure > 0.5) && (saForce < saLoad);
        cmp._extending = (cmp._capPressure > 0.5) && !cmp._stalled;
      }
      if (cType === 'cyl-da' || cType === 'cyl-rodless') {
        cmp._capPressure = 0;
        cmp._rodPressure = 0;
        for (var ci3 = 0; ci3 < connections.length; ci3++) {
          var cn3 = connections[ci3];
          if ((cn3.from.compId === cmp.id && cn3.from.portIdx === 0) || (cn3.to.compId === cmp.id && cn3.to.portIdx === 0))
            cmp._capPressure = Math.max(cmp._capPressure, cn3.pressure);
          if ((cn3.from.compId === cmp.id && cn3.from.portIdx === 1) || (cn3.to.compId === cmp.id && cn3.to.portIdx === 1))
            cmp._rodPressure = Math.max(cmp._rodPressure, cn3.pressure);
        }
        /* Force balance: net force = P_cap · A_bore − P_rod · A_annulus − load (extend dir). */
        var daBore = (cmp.values.bore || 50) / 1000;
        var daRod  = (cmp.values.rod  || 20) / 1000;
        var daABore = Math.PI / 4 * daBore * daBore;
        var daAAnn  = daABore - Math.PI / 4 * daRod * daRod;
        var daLoad  = cmp.values.load || 0;
        var daExtForce  = (cmp._capPressure || 0) * 1e5 * daABore - (cmp._rodPressure || 0) * 1e5 * daAAnn;
        var daRetForce  = (cmp._rodPressure || 0) * 1e5 * daAAnn  - (cmp._capPressure || 0) * 1e5 * daABore;
        var wantExtend = (cmp._capPressure > cmp._rodPressure + 0.3);
        cmp._stalled = wantExtend && (daExtForce < daLoad);
        cmp._extending = wantExtend && !cmp._stalled;
        cmp._netForce = daExtForce; /* exposed for readouts */
      }
      if (cType === 'rotary-act') {
        cmp._portAPressure = 0;
        cmp._portBPressure = 0;
        for (var ci4 = 0; ci4 < connections.length; ci4++) {
          var cn4 = connections[ci4];
          if ((cn4.from.compId === cmp.id && cn4.from.portIdx === 0) || (cn4.to.compId === cmp.id && cn4.to.portIdx === 0))
            cmp._portAPressure = Math.max(cmp._portAPressure, cn4.pressure);
          if ((cn4.from.compId === cmp.id && cn4.from.portIdx === 1) || (cn4.to.compId === cmp.id && cn4.to.portIdx === 1))
            cmp._portBPressure = Math.max(cmp._portBPressure, cn4.pressure);
        }
        cmp._extending = (cmp._portAPressure > cmp._portBPressure + 0.3);
      }
    }

    /* (Removed dead duplicate v52-pilot loop — fully handled by pilotTypes loop above.) */

    /* Vacuum pass — venturi generators with supply pressure > 2 bar create vacuum
       on port V (idx 2). Propagates negative pressure to connected suction-cup endpoints.
       Suction cup with _vacuumLevel ≥ vacuumThreshold counts as "gripping a workpiece". */
    for (var vg = 0; vg < components.length; vg++) {
      var vgc = components[vg];
      if (vgc.type !== 'venturi') continue;
      var vgSupply = vgc._localPressure || 0;
      vgc._vacuumActive = (vgSupply > 2);
      vgc._vacuumLevel = vgc._vacuumActive ? (vgc.values.vacuumLevel || 0.6) : 0;
      if (!vgc._vacuumActive) continue;
      /* Find connections leaving port idx 2 (V) and propagate vacuum to suction cups */
      for (var vci = 0; vci < connections.length; vci++) {
        var vcn = connections[vci];
        var vNeighbor = null;
        if (vcn.from.compId === vgc.id && vcn.from.portIdx === 2) vNeighbor = findComp(vcn.to.compId);
        else if (vcn.to.compId === vgc.id && vcn.to.portIdx === 2) vNeighbor = findComp(vcn.from.compId);
        if (!vNeighbor) continue;
        vcn._vacuum = vgc._vacuumLevel; /* annotation for rendering / inspection */
        if (vNeighbor.type === 'suction-cup') {
          vNeighbor._vacuumLevel = Math.max(vNeighbor._vacuumLevel || 0, vgc._vacuumLevel);
          vNeighbor._vacuumActive = true;
          vNeighbor._gripping = (vNeighbor._vacuumLevel >= 0.3);
        }
      }
    }

    /* Mark exhaust-centre valves (5/3 exhaust-ctr, 5/3 pilot-exhaust, 4/3 exhaust-ctr).
       FluidSIM: when these valves are in Center, working ports A & B vent to atmosphere.
       Cylinders fed by such a valve become free-running / drift toward retracted. */
    for (var ev = 0; ev < components.length; ev++) {
      var evc = components[ev];
      var evt = evc.type;
      if ((evt === 'v53-exhaust' || evt === 'v53-pilot-exhaust' || evt === 'v43-exhaust') &&
          (evc.values.position || 'Center') === 'Center') {
        evc._exhaustCenter = true;
      }
    }
    for (var ec = 0; ec < components.length; ec++) {
      var ecc = components[ec];
      if (ecc.type !== 'cyl-da' && ecc.type !== 'cyl-sa' && ecc.type !== 'cyl-rodless') continue;
      for (var ecn = 0; ecn < connections.length; ecn++) {
        var ecnn = connections[ecn];
        var oOther = null, oPort = -1;
        if (ecnn.from.compId === ecc.id) { oOther = findComp(ecnn.to.compId); oPort = ecnn.to.portIdx; }
        else if (ecnn.to.compId === ecc.id) { oOther = findComp(ecnn.from.compId); oPort = ecnn.from.portIdx; }
        if (!oOther || !oOther._exhaustCenter) continue;
        /* Working ports for v53/v43: idx 1 = A-out (port 2), idx 3 = B-out (port 4). */
        if (oPort === 1 || oPort === 3) ecc._workingVented = true;
      }
    }

    /* Update measuring instruments */
    for (var g = 0; g < components.length; g++) {
      var gComp = components[g];
      if (gComp.type === 'gauge')      gComp.reading = gComp._localPressure || 0;
      if (gComp.type === 'flow-meter') gComp.reading = gComp._localFlow || 0;
      if (gComp.type === 'proximity') {
        var thr = (gComp.values && gComp.values.threshold) || 0.5;
        gComp.reading = ((gComp._localPressure || 0) >= thr) ? 1 : 0;
      }
    }

    /* Cross-domain feedback: pressure switches may change after pneumatic BFS */
    computeCrossDomainFeedback();

    /* Air tank (receiver) charge/discharge step — a real gas balance, not a
       per-frame nudge. For an isothermal receiver the gauge pressure moves by
       the normal volume exchanged divided by the tank volume:
            Δp [bar] = (Q [NL/min] / 60 × dt [s]) / V [L]
       so the rate is frame-rate independent and scales with ACTUAL demand.
       A receiver with nothing moving therefore holds its pressure (only a small
       standing loss through valves and fittings), instead of bleeding to zero
       while the supply readout still showed full pressure. */
    var atDt = _lastDt || (1 / 60);
    /* Live demand: every actuator currently in motion draws air, scaled by
       bore² (nominal ~130 NL/min for an 80 mm bore). */
    var epDemand = 0;
    for (var adm = 0; adm < components.length; adm++) {
      var admC = components[adm];
      if (admC.type !== 'cyl-da' && admC.type !== 'cyl-sa' && admC.type !== 'cyl-rodless') continue;
      if ((admC._speedMMS || 0) > 0) {
        var admB = admC.values.bore || 50;
        epDemand += (admB / 80) * (admB / 80) * 130;
      }
    }
    _lastAirDemand = epDemand;
    for (var atk = 0; atk < components.length; atk++) {
      var at = components[atk];
      if (at.type !== 'air-tank') continue;
      if (at._tankP === undefined) at._tankP = 0;
      var atVol = (at.values && at.values.volume) || 50;
      if (at._discharging) {
        /* Reserve duty: bleeding at the circuit's live demand (min 5 NL/min to
           represent standing losses), NOT at a fixed idle rate. */
        var atQout = Math.max(5, epDemand);
        at._tankP = Math.max(0, at._tankP - (atQout / 60 * atDt) / atVol);
      } else {
        var atLineP = at._localPressure || 0;
        if (atLineP > at._tankP) {
          /* Charging uses the compressor capacity left after the actuators. */
          var atQin = Math.max(10, (at._localFlow || 100) - epDemand);
          at._tankP = Math.min(atLineP, at._tankP + (atQin / 60 * atDt) / atVol);
        }
      }
    }

    /* Update readouts */
    var rPressure = document.getElementById('r-pressure');
    var rFlow = document.getElementById('r-flow');
    var rPower = document.getElementById('r-power');
    var rForce = document.getElementById('r-force');
    var rSpeed = document.getElementById('r-speed');
    var rStatus = document.getElementById('r-status');

    rPressure.textContent = convVal(supplyPressure, 'bar').toFixed(1);
    /* Supply flow is FREE AIR (normal litres), the figure a compressor is rated
       in — not the compressed volume that reaches the cylinder. */
    rFlow.textContent = convVal(supplyFlow, 'NL/min').toFixed(unitSystem === 'imperial' ? 1 : 0);

    /* Find first cylinder for force/speed readout */
    var firstCyl = null;
    for (var fc = 0; fc < components.length; fc++) {
      if (components[fc].type === 'cyl-da' || components[fc].type === 'cyl-sa') { firstCyl = components[fc]; break; }
    }
    if (firstCyl) {
      var bore = firstCyl.values.bore || 50;
      var area = Math.PI / 4 * bore * bore;
      var force = (firstCyl._localPressure || 0) * 0.1 * area;
      rForce.textContent = convVal(force, 'N').toFixed(0);
      /* Speed readout — read straight off the value the ANIMATION integrated
         this frame (cylinderSpeedMMS), so the displayed mm/s and the on-screen
         stroke can never disagree. It already includes the NL/min → actual-flow
         conversion and any meter-out / quick-exhaust effect. */
      rSpeed.textContent = convVal(firstCyl._speedMMS || 0, 'mm/s').toFixed(unitSystem === 'imperial' ? 1 : 0);
    } else {
      rForce.textContent = '0';
      rSpeed.textContent = '0';
    }

    /* Air consumption per CYCLE — the number you size a compressor with, and
       the same formula tools/pneumatic-circuit uses so the two agree:
         V_N = (A_bore × L + A_ann × L) × (p_g + 1) / 1e6   [NL per cycle]
       A double-acting cylinder consumes on BOTH strokes, so the annulus volume
       counts too; a single-acting cylinder returns on its spring, so only the
       bore volume is charged. This is a sizing figure, so it is reported for
       every cylinder in the circuit, not just the one currently extending. */
    var totalConsumption = 0;
    for (var ac = 0; ac < components.length; ac++) {
      var acc = components[ac];
      if (acc.type !== 'cyl-da' && acc.type !== 'cyl-sa') continue;
      var b = acc.values.bore || 50;
      var rr = (acc.type === 'cyl-sa') ? 0 : (acc.values.rod || 0);
      var strk = acc.values.stroke || 150;
      var aBore = Math.PI / 4 * b * b;
      var aAnn = Math.PI / 4 * (b * b - rr * rr);
      var volMm3 = (acc.type === 'cyl-sa') ? (aBore * strk) : (aBore * strk + aAnn * strk);
      totalConsumption += volMm3 / 1e6 * (supplyPressure + 1);
    }
    rPower.textContent = convVal(totalConsumption, 'NL/cycle').toFixed(unitSystem === 'imperial' ? 3 : 1);
    rStatus.textContent = !running ? 'Idle'
      : (_tankReserveActive ? 'Air tank reserve — no compressor' : 'Running');
    rStatus.style.color = _tankReserveActive ? '#ffbb33' : '';

    updateElectricalReadouts();

    /* Invalidate per-tick adjacency cache (regenerated next frame). */
    _adjCache = null;
  }

  /* Electrical readouts — also used for electrical-only circuits (no air supply) */
  function updateElectricalReadouts() {
    var rVoltage = document.getElementById('r-voltage');
    var rSolenoids = document.getElementById('r-solenoids');
    if (rVoltage) {
      var psu = null;
      for (var psi = 0; psi < components.length; psi++) {
        if (components[psi].type === 'power-supply-24v') { psu = components[psi]; break; }
      }
      rVoltage.textContent = psu ? (psu.values.voltage || 24) : '0';
    }
    if (rSolenoids) {
      var solCount = 0;
      for (var sci = 0; sci < components.length; sci++) {
        var sct = components[sci].type;
        if ((sct === 'v52-single' || sct === 'v52-double' || sct === 'v53-solenoid' || sct === 'v32-solenoid' || sct === 'solenoid-coil') &&
            (components[sci]._elecEnergized || components[sci]._y1Energized || components[sci]._y2Energized)) solCount++;
      }
      rSolenoids.textContent = solCount;
    }
  }

  /* No compressor and no stored air: show a dead pneumatic side, not stale values */
  function updateDeadPneumaticReadouts() {
    var ids = { 'r-pressure': '0.0', 'r-flow': '0', 'r-force': '0', 'r-speed': '0', 'r-power': '0.0' };
    for (var k in ids) { var el = document.getElementById(k); if (el) el.textContent = ids[k]; }
    var st = document.getElementById('r-status');
    if (st) { st.textContent = 'No air supply'; st.style.color = '#ff6666'; }
  }

  /* getPassthrough — EXIT semantics: returns true if flow can EXIT through portIdx.
     BFS propagates FROM supply OUTWARD; each call checks whether the component
     allows supply-side flow to exit through the given port toward the next component. */
  function getPassthrough(comp, portIdx, pressure, flow) {
    var t = comp.type;
    var v = comp.values || {};

    /* Air supply — always passes (single port) */
    if (t === 'air-supply' || t === 'air-tank') return { canFlow: true, pressureDrop: 0 };

    /* FRL and filter/regulator — 2-port passthrough */
    if (t === 'frl' || t === 'regulator') {
      var maxP = v.setting || 6;
      return { canFlow: true, pressureDrop: Math.max(0, pressure - maxP) };
    }
    if (t === 'filter') return { canFlow: true, pressureDrop: 0.2 };

    /* 2/2 on/off valve — ports: 0=In, 1=Out */
    if (t === 'v22-push') {
      if (v.position !== 'Open') return { canFlow: false };
      if (portIdx === 1) return { canFlow: true, pressureDrop: 0.05 };
      return { canFlow: false };
    }

    /* 2/2 Push NC — normally open, push to close */
    if (t === 'v22-push-nc') {
      if (v.position === 'Open') return { canFlow: true, pressureDrop: 0.05 };
      return { canFlow: false };
    }

    /* 3/2 valves — ports: 0=port1(supply), 1=port3(exhaust), 2=port2(output)
       NC valve: Normal = supply blocked; Actuated = 1→2 (supply to output)
       NO valve: Normal = 1→2 (flow); Actuated (Pressed) = blocked */
    if (t.indexOf('v32') === 0) {
      /* Skip electrical ports (Y+/Y-) on solenoid variants */
      var v32def = COMP_DEFS[t];
      if (v32def && v32def.ports[portIdx] && v32def.ports[portIdx].elec) return { canFlow: false };
      var pos = v.position || 'Normal';
      var isActuated = (pos !== 'Normal');
      /* NO variants: reversed logic — flow in Normal state */
      if (t === 'v32-push-no' || t === 'v32-roller-no') {
        if (!isActuated) {
          if (portIdx === 2) return { canFlow: true, pressureDrop: 0.1 };
        }
        return { canFlow: false };
      }
      /* NC variants (default) */
      if (isActuated) {
        if (portIdx === 2) return { canFlow: true, pressureDrop: 0.1 };
        return { canFlow: false };
      }
      return { canFlow: false };
    }

    /* 5/2 valves — ports: 0=port1(supply), 1=port2(A-out), 2=port3(A-exh), 3=port4(B-out), 4=port5(B-exh)
       Position A (Normal): supply(1)→A(2), B(4) exhausts to (5) — but exhaust is to atmosphere, no supply pressure
       Position B (Energised): supply(1)→B(4), A(2) exhausts to (3)
       NOTE: Exhaust paths vent to atmosphere — they don't carry supply pressure in the BFS.
       The BFS only propagates supply-side pressure. Cylinder retraction happens because
       the opposite side LOSES pressure (exhaust is open), not because exhaust has pressure. */
