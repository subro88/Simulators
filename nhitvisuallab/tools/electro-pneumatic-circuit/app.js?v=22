      if (rcActive) return entryPort === 0 ? [1] : [0];
      return [];
    }

    /* Counter: count coil (0↔1) and reset coil (2↔3) are current-passing loads;
       output contact COM(4)↔NO(5) closes once the count reaches the preset. */
    if (t === 'counter-ep') {
      if (entryPort === 0) return [1];
      if (entryPort === 1) return [0];
      if (entryPort === 2) return [3];
      if (entryPort === 3) return [2];
      var reached = comp._countReached || false;
      if (entryPort === 4) return reached ? [5] : [];
      if (entryPort === 5) return reached ? [4] : [];
      return [];
    }

    /* Timer relays: coil (0↔1) and contact (2↔3) separate.
       Timer contacts use _timerFired which persists from updateTimerStates(). */
    if (t === 'timer-relay-on' || t === 'timer-relay-off') {
      if (entryPort === 0) return [1]; /* coil passthrough */
      if (entryPort === 1) return [0];
      var timerFired = comp._timerFired || false;
      if (entryPort === 2) return timerFired ? [3] : [];
      if (entryPort === 3) return timerFired ? [2] : [];
      return [];
    }

    /* Pressure switch: pneumatic port (0) separate, electrical COM(1)↔NO/NC(2).
       Mode 'NO': contact closes when threshold reached.
       Mode 'NC': contact opens  when threshold reached (closed at rest). */
    if (t === 'pressure-switch-ep') {
      if (entryPort === 0) return []; /* pneumatic - no internal elec connection */
      var psClosed = comp._elecClosed || false;
      var psNc = (v.mode === 'NC');
      var psActive = psNc ? !psClosed : psClosed;
      if (entryPort === 1) return psActive ? [2] : [];
      if (entryPort === 2) return psActive ? [1] : [];
      return [];
    }

    /* Limit switch: COM(0)↔NO/NC(1) */
    if (t === 'limit-switch-ep') {
      var lsClosed = comp._elecClosed || false;
      var lsNc = (v.mode === 'NC');
      var lsActive = lsNc ? !lsClosed : lsClosed;
      if (lsActive) return entryPort === 0 ? [1] : [0];
      return [];
    }

    /* Solenoid valves: Y+(elec) ↔ Y-(elec) form coil circuit, pneumatic ports separate */
    if (t === 'v52-single' || t === 'v32-solenoid') {
      var def = COMP_DEFS[t];
      /* Find the two electrical ports */
      var elecPorts = [];
      for (var ep = 0; ep < def.ports.length; ep++) { if (def.ports[ep].elec) elecPorts.push(ep); }
      if (elecPorts.length === 2) {
        if (entryPort === elecPorts[0]) return [elecPorts[1]];
        if (entryPort === elecPorts[1]) return [elecPorts[0]];
      }
      return [];
    }
    if (t === 'v52-double' || t === 'v53-solenoid') {
      var defD = COMP_DEFS[t];
      var elecPortsD = [];
      for (var epd = 0; epd < defD.ports.length; epd++) { if (defD.ports[epd].elec) elecPortsD.push(epd); }
      /* Y1+(5)↔Y1-(6), Y2+(7)↔Y2-(8) */
      if (elecPortsD.length >= 2) {
        if (entryPort === elecPortsD[0]) return [elecPortsD[1]];
        if (entryPort === elecPortsD[1]) return [elecPortsD[0]];
      }
      if (elecPortsD.length >= 4) {
        if (entryPort === elecPortsD[2]) return [elecPortsD[3]];
        if (entryPort === elecPortsD[3]) return [elecPortsD[2]];
      }
      return [];
    }

    /* Power supply: +24V(0) and 0V(1) are NOT internally connected */
    if (t === 'power-supply-24v') return [];

    return [];
  }

  function applySolenoidStates() {
    /* ── PASS A: stand-alone 'solenoid-coil' blocks feed their target valve.
       A coil now declares WHICH spool side it drives (Y1 / Y2) and contributes
       to the SAME _y1Energized / _y2Energized flags the integrated Y+/Y- ports
       use — so a double-solenoid (or 5/3) circuit can actually be built from
       coil symbols. Previously the coil only ever forced 'Position B' and could
       not drive a v53-solenoid at all. ── */
    for (var sc0 = 0; sc0 < components.length; sc0++) {
      var scComp = components[sc0];
      if (scComp.type !== 'solenoid-coil') continue;
      var scLinkedId = scComp.values.linkedValve;
      var scValve = null;
      if (scLinkedId) {
        scValve = findComp(scLinkedId);
      } else {
        /* Auto-drive the NEAREST solenoid valve in range (the common student
           trap is leaving "Linked Valve ID" at 0). */
        var scDef = COMP_DEFS['solenoid-coil'];
        var scCx = scComp.x + scDef.w / 2, scCy = scComp.y + scDef.h / 2;
        var scBest = 260, scNearest = null;
        for (var vv = 0; vv < components.length; vv++) {
          var vc = components[vv];
          if (vc.type !== 'v52-single' && vc.type !== 'v52-double' &&
              vc.type !== 'v32-solenoid' && vc.type !== 'v53-solenoid') continue;
          var vcDef = COMP_DEFS[vc.type];
          var vdx = scCx - (vc.x + vcDef.w / 2), vdy = scCy - (vc.y + vcDef.h / 2);
          var vdist = Math.sqrt(vdx * vdx + vdy * vdy);
          if (vdist < scBest) { scBest = vdist; scNearest = vc; }
        }
        scValve = scNearest;
      }
      scComp._autoLinkedValve = (!scLinkedId && scValve) ? scValve.id : 0;
      scComp._noValveWarn = !scValve;      /* diagnostics: coil with no valve to drive */
      if (!scValve || !scComp._elecEnergized) continue;
      var scSide = (scComp.values && scComp.values.side) || 'Y1';
      if (scValve.type === 'v52-double' || scValve.type === 'v53-solenoid') {
        if (scSide === 'Y2') scValve._y2Energized = true;
        else scValve._y1Energized = true;
      } else {
        /* Single-solenoid spring-return valve: OR into its coil state and let
           the normal pass below handle shift / spring return. */
        scValve._elecEnergized = true;
      }
    }

    for (var i = 0; i < components.length; i++) {
      var comp = components[i];
      var vt = comp.type;
      /* Single solenoid valves (spring return): energized → shift, de-energized → Normal */
      if (vt === 'v52-single' || vt === 'v32-solenoid') {
        if (comp._elecEnergized) {
          comp.values.position = 'Energised';
        } else {
          /* Spring return — only reset if valve has Y+/Y- ports (electro valve) */
          var def = COMP_DEFS[vt];
          var hasElecPorts = false;
          for (var ep = 0; ep < def.ports.length; ep++) { if (def.ports[ep].elec) { hasElecPorts = true; break; } }
          if (hasElecPorts) comp.values.position = 'Normal';
        }
      } else if (vt === 'v52-double') {
        /* Double solenoid (bistable, FluidSIM-correct):
             Y1 (ports 5/6) energised → shift to Position B
             Y2 (ports 7/8) energised → shift to Position A
             Neither (or both)        → hold last position (no spring) */
        if (comp._y1Energized && !comp._y2Energized) comp.values.position = 'Position B';
        else if (comp._y2Energized && !comp._y1Energized) comp.values.position = 'Position A';
        /* else hold last */
        flagBothSolenoids(comp);
      } else if (vt === 'v53-solenoid') {
        /* 5/3 double solenoid, SPRING-CENTRED (standard):
             Y1 energised → Extend, Y2 energised → Retract,
             neither (or both) → springs return the spool to Centre (closed) */
        if (comp._y1Energized && !comp._y2Energized) comp.values.position = 'Extend';
        else if (comp._y2Energized && !comp._y1Energized) comp.values.position = 'Retract';
        else comp.values.position = 'Center';
        flagBothSolenoids(comp);
      }
    }
  }

  /* Both coils of a double-solenoid valve commanded at once is a WIRING FAULT,
     not a valid state: the spool is pushed from both ends, the outcome is
     undefined, and both coils cook. Real circuits prevent it with a mutual
     interlock (each rung broken by the other relay's NC contact). */
  function flagBothSolenoids(comp) {
    comp._bothSolFault = !!(comp._y1Energized && comp._y2Energized);
    if (comp._bothSolFault && running && (simTime - _lastBothSolWarn) > 4) {
      _lastBothSolWarn = simTime;
      flashWarning('Both solenoids of valve #' + comp.id + ' commanded at the same time — add a mutual interlock (break each rung with the other relay’s NC contact)');
    }
  }

  /* Pressure-switch switching differential: ON at p >= set, OFF at p <= set-diff. */
  function psHysteresis(wasClosed, p, set, diff) {
    if (wasClosed) return p > (set - diff);
    return p >= set;
  }

  /* Update all sensor and timer states using PREVIOUS frame's physical state.
     This runs BEFORE the electrical BFS so sensors can affect the circuit. */
  function updateSensorStates() {
    for (var i = 0; i < components.length; i++) {
      var comp = components[i];
      var t = comp.type;

      /* ── Limit Switch: trips at the linked cylinder's stroke position.
         `sense` picks the direction: 'At / past trigger' is the extended-end
         switch (FESTO 1B2 / a1), 'At / before trigger' is the RETRACTED-end
         switch (1B1 / a0) — with triggerAt now allowed down to 0 %, a proper
         A+/A− sequence with retract confirmation can be built. ── */
      if (t === 'limit-switch-ep') {
        comp._elecClosed = false;
        var lsAtRetract = (comp.values && comp.values.sense === 'At / before trigger');
        /* Check linked cylinder by ID */
        var linkedId = comp.values && comp.values.linkedCylinder;
        if (linkedId) {
          var cyl = findComp(linkedId);
          if (cyl) {
            var trigger = (comp.values.triggerAt === undefined ? 95 : comp.values.triggerAt) / 100;
            var lsExt = cyl.extension || 0;
            comp._elecClosed = lsAtRetract ? (lsExt <= trigger) : (lsExt >= trigger);
          }
        } else {
          /* Auto-detect: find nearest cylinder within a sensible radius so a switch
             doesn't silently bind to an unrelated cylinder on a busy sheet. */
          var lsDef = COMP_DEFS[t];
          var lsCx = comp.x + (lsDef ? lsDef.w / 2 : 22);
          var lsCy = comp.y + (lsDef ? lsDef.h / 2 : 20);
          var AUTO_LINK_RADIUS = 260; /* px — beyond this, no auto-link */
          var bestDist = AUTO_LINK_RADIUS;
          var bestCyl = null;
          for (var ci = 0; ci < components.length; ci++) {
            var cc = components[ci];
            if (cc.type === 'cyl-da' || cc.type === 'cyl-sa' || cc.type === 'cyl-rodless') {
              var ccDef = COMP_DEFS[cc.type];
              var ccCx = cc.x + ccDef.w / 2;
              var ccCy = cc.y + ccDef.h / 2;
              var dx = lsCx - ccCx, dy = lsCy - ccCy;
              var dist = Math.sqrt(dx * dx + dy * dy);
              if (dist < bestDist) {
                bestDist = dist;
                bestCyl = cc;
              }
            }
          }
          comp._autoLinkedCyl = 0;
          if (bestCyl) {
            /* Honour the switch's own triggerAt setting (was hardcoded 0.9,
               inconsistent with the explicitly-linked branch) */
            var autoTrig = ((comp.values && comp.values.triggerAt !== undefined) ? comp.values.triggerAt : 95) / 100;
            var autoExt = bestCyl.extension || 0;
            comp._elecClosed = lsAtRetract ? (autoExt <= autoTrig) : (autoExt >= autoTrig);
            comp._autoLinkedCyl = bestCyl.id; /* Track for debug/display */
          }
        }
      }

      /* ── Pneumatic Limit Switch (NC / NO): the roller lever is tripped by the
         linked cylinder's stroke position, exactly like the electrical one, but
         it switches an air line instead of a circuit. ── */
      if (t === 'limit-nc' || t === 'limit-no') {
        var plCyl = null;
        var plLinked = comp.values && comp.values.linkedCylinder;
        if (plLinked) {
          plCyl = findComp(plLinked);
        } else {
          /* Auto-detect the nearest cylinder, same radius rule as limit-switch-ep */
          var plDef = COMP_DEFS[t];
          var plCx = comp.x + plDef.w / 2, plCy = comp.y + plDef.h / 2;
          var plBest = 260;
          for (var pli = 0; pli < components.length; pli++) {
            var plc = components[pli];
            if (plc.type !== 'cyl-da' && plc.type !== 'cyl-sa' && plc.type !== 'cyl-rodless') continue;
            var plcDef = COMP_DEFS[plc.type];
            var pldx = plCx - (plc.x + plcDef.w / 2), pldy = plCy - (plc.y + plcDef.h / 2);
            var pldist = Math.sqrt(pldx * pldx + pldy * pldy);
            if (pldist < plBest) { plBest = pldist; plCyl = plc; }
          }
          comp._autoLinkedCyl = plCyl ? plCyl.id : 0;
        }
        if (plCyl) {
          var plTrig = ((comp.values && comp.values.triggerAt !== undefined) ? comp.values.triggerAt : 95) / 100;
          var plAtRetract = (comp.values && comp.values.sense === 'At / before trigger');
          var plExt = plCyl.extension || 0;
          var plTripped = plAtRetract ? (plExt <= plTrig) : (plExt >= plTrig);
          comp.values.position = plTripped ? 'Actuated' : 'Normal';
        }
      }

      /* ── Reed Switch: magnetic sensor — closes when the piston is WITHIN a
         window (±8%) of a set position (retracted / mid / extended). This is
         the position-window behaviour that distinguishes it from a limit
         switch's "past threshold" trip. ── */
      if (t === 'reed-switch-ep') {
        comp._elecClosed = false;
        var reTarget = 1; /* Extended */
        var rePos = comp.values && comp.values.position;
        if (rePos === 'Retracted') reTarget = 0;
        else if (rePos === 'Mid-stroke') reTarget = 0.5;
        var reCyl = null;
        var reLinked = comp.values && comp.values.linkedCylinder;
        if (reLinked) {
          reCyl = findComp(reLinked);
        } else {
          var reDef = COMP_DEFS[t];
          var reCx = comp.x + reDef.w / 2, reCy = comp.y + reDef.h / 2;
          var reBest = 260;
          for (var rci = 0; rci < components.length; rci++) {
            var rcc = components[rci];
            if (rcc.type !== 'cyl-da' && rcc.type !== 'cyl-sa' && rcc.type !== 'cyl-rodless') continue;
            var rccDef = COMP_DEFS[rcc.type];
            var rdx = reCx - (rcc.x + rccDef.w / 2), rdy = reCy - (rcc.y + rccDef.h / 2);
            var rdist = Math.sqrt(rdx * rdx + rdy * rdy);
            if (rdist < reBest) { reBest = rdist; reCyl = rcc; }
          }
          comp._autoLinkedCyl = reCyl ? reCyl.id : 0;
        }
        if (reCyl) {
          comp._elecClosed = Math.abs((reCyl.extension || 0) - reTarget) <= 0.08;
        }
      }

      /* ── Pressure Switch: trips at the setpoint, resets one switching
         differential BELOW it. Real electromechanical switches (EN 60947-5-1,
         FESTO PEV / SDE series) have 0.3–1 bar hysteresis; a bare p >= set
         comparison chatters at the setpoint and re-solves the whole net every
         frame. ── */
      if (t === 'pressure-switch-ep') {
        var threshold = (comp.values && comp.values.threshold) || 3;
        var psDiff = (comp.values && comp.values.diff !== undefined) ? comp.values.diff : 0.5;
        /* Use _localPressure from previous frame's pneumatic BFS */
        comp._elecClosed = psHysteresis(comp._elecClosed, comp._localPressure || 0, threshold, psDiff);
      }

      /* Timers are updated separately in updateTimerStates() after electrical BFS */
    }
  }

  /* Update timer relay states — called AFTER computeElectrical so _coilEnergized is set */
  function updateTimerStates() {
    for (var i = 0; i < components.length; i++) {
      var comp = components[i];

      if (comp.type === 'timer-relay-on') {
        var coilOn = (comp._effCoil !== undefined) ? !!comp._effCoil : !!comp._coilEnergized;
        var delay = (comp.values && comp.values.delay) || 3;
        if (coilOn) {
          if (!comp._timerStart) comp._timerStart = simTime;
          /* _timerElapsed feeds the on-delay progress bar — it was read by the
             symbol but never assigned, so the bar never moved. */
          comp._timerElapsed = simTime - comp._timerStart;
          comp._timerFired = comp._timerElapsed >= delay;
        } else {
          comp._timerStart = 0;
          comp._timerElapsed = 0;
          comp._timerFired = false;
        }
      }

      if (comp.type === 'timer-relay-off') {
        var coilOnOff = (comp._effCoil !== undefined) ? !!comp._effCoil : !!comp._coilEnergized;
        var delayOff = (comp.values && comp.values.delay) || 3;
        if (coilOnOff) {
          comp._timerFired = true;
          comp._timerOffStart = 0;
        } else {
          if (comp._timerFired && !comp._timerOffStart) comp._timerOffStart = simTime;
          if (comp._timerOffStart) {
            if ((simTime - comp._timerOffStart) >= delayOff) {
              comp._timerFired = false;
              comp._timerOffStart = 0;
            }
          }
        }
      }
    }
  }

  /* Counter edge detection — runs ONCE per real frame (NOT inside the
     iterate-to-stable loop, which would over-count). Reads _cntEnergized /
     _rstEnergized from the last electrical solve and updates the count. */
  function advanceCounters() {
    for (var i = 0; i < components.length; i++) {
      var comp = components[i];
      if (comp.type !== 'counter-ep') continue;
      if (comp._count === undefined) comp._count = 0;
      var preset = (comp.values && comp.values.preset) || 3;
      /* Reset dominates. _rstPending catches a tap that was made and released
         between two frames, so a quick click on the Reset button always zeroes. */
      if (comp._rstEnergized || comp._rstPending) {
        comp._count = 0;
        comp._rstPending = false;
      } else if (comp._cntEnergized && !comp._cntPrev) {
        /* Rising edge → one count. A real IEC counter keeps counting PAST the
           preset (only the OUTPUT latches), so the n/preset display must not
           freeze at n = preset. Clamped only to keep the readout legible. */
        comp._count = Math.min(9999, comp._count + 1);
      }
      comp._cntPrev = !!comp._cntEnergized;
      comp._countReached = comp._count >= preset;
    }
  }

  /* Re-run sensors after pneumatic BFS for cross-domain feedback */
  function computeCrossDomainFeedback() {
    var changed = false;
    for (var i = 0; i < components.length; i++) {
      var comp = components[i];
      if (comp.type === 'pressure-switch-ep') {
        var threshold = (comp.values && comp.values.threshold) || 3;
        var csDiff = (comp.values && comp.values.diff !== undefined) ? comp.values.diff : 0.5;
        var wasClosed = comp._elecClosed;
        comp._elecClosed = psHysteresis(wasClosed, comp._localPressure || 0, threshold, csDiff);
        if (comp._elecClosed !== wasClosed) changed = true;
      }
    }
    /* If pressure switch state changed, re-run electrical to propagate */
    if (changed) {
      /* Reset electrical states */
      for (var c = 0; c < components.length; c++) {
        components[c]._elecEnergized = false;
        components[c]._coilEnergized = false;
      }
      computeElectrical();
      applySolenoidStates();
    }
  }

  function canConnect(fromCompId, fromPortIdx, toCompId, toPortIdx) {
    var fc = findComp(fromCompId);
    var tc = findComp(toCompId);
    if (!fc || !tc) return false;
    var fd = COMP_DEFS[fc.type];
    var td = COMP_DEFS[tc.type];
    var fp = fd.ports[fromPortIdx];
    var tp = td.ports[toPortIdx];
    return !!(fp && fp.elec) === !!(tp && tp.elec);
  }

  function getConnectionDomain(conn) {
    var fc = findComp(conn.from.compId);
    if (!fc) return 'pneumatic';
    var fd = COMP_DEFS[fc.type];
    if (!fd) return 'pneumatic';
    var fp = fd.ports[conn.from.portIdx];
    return (fp && fp.elec) ? 'electrical' : 'pneumatic';
  }

  /* ================================================================
     ANIMATION LOOP
     ================================================================ */

  var lastTime = 0;

  /* Trace the discharge path from a cylinder port to atmosphere (up to 5 hops).
     Used to detect:
       - flow-control / throttle on the exhaust line  → tightens factor
       - quick-exhaust valve                          → boosts speed (qevBoost)
       - exhaust port of a valve / silencer           → terminal (good)
     Returns { factor, qevBoost } where factor=1 is unrestricted. */
  function traceExhaustPath(startCompId, startPortIdx) {
    var factor = 1.0, qevBoost = 1.0;
    var visited = {};
    var maxDepth = 5;
    function walk(cid, pidx, depth) {
      if (depth > maxDepth) return;
      var key = cid + ':' + pidx;
      if (visited[key]) return;
      visited[key] = true;
      for (var ci = 0; ci < connections.length; ci++) {
        var cn = connections[ci];
        var otherId = null, otherPortIdx = null;
        if (cn.from.compId === cid && cn.from.portIdx === pidx) { otherId = cn.to.compId;   otherPortIdx = cn.to.portIdx;   }
        else if (cn.to.compId === cid && cn.to.portIdx === pidx) { otherId = cn.from.compId; otherPortIdx = cn.from.portIdx; }
        else continue;
        var oc = findComp(otherId);
        if (!oc) continue;
        var ot = oc.type;
        var odef = COMP_DEFS[ot];
        if (!odef) continue;
        var oPort = odef.ports[otherPortIdx];
        var oLabel = oPort ? oPort.label : '';
        if (isExhaustPort(ot, oLabel, oPort && oPort.elec)) continue; /* terminal — good */
        if (ot === 'flow-control') {
          /* Electro-pneumatic uses port labels reversed: idx 0 = '2' (down/inlet), idx 1 = '1' (up/outlet).
             Controlled direction here is idx 0 → idx 1 (entering at the inlet). */
          if (otherPortIdx === 0) {
            factor = Math.min(factor, Math.max(0.1, (oc.values.flow || 80) / 200));
          }
        } else if (ot === 'throttle') {
          factor = Math.min(factor, Math.max(0.05, (oc.values.opening || 50) / 100));
        } else if (ot === 'quick-exhaust') {
          /* QEV boost only when entered via the cylinder-side port (idx 1 = '2' = up) */
          if (otherPortIdx === 1) {
            qevBoost = Math.max(qevBoost, 1.8);
            continue;
          }
        }
        for (var op = 0; op < odef.ports.length; op++) {
          if (op === otherPortIdx) continue;
          walk(otherId, op, depth + 1);
        }
      }
    }
    walk(startCompId, startPortIdx, 0);
    return { factor: factor, qevBoost: qevBoost };
  }

  /* Stroke length in mm, guarded against a missing/zero parameter. */
  function strokeMM(cyl) {
    var s = (cyl.values && cyl.values.stroke) || 150;
    return (s < 1) ? 150 : s;
  }

  /* ── PISTON SPEED — the single source of truth ───────────────────────────
     Shared by the mm/s readout and the on-screen stroke animation (identical
     model to tools/pneumatic-circuit, so the two engines agree).

     Compressed-air flow is quoted in NORMAL litres (free air at 1 atm). The air
     that actually fills the cylinder is compressed to line pressure, so the
     volumetric flow at the cylinder is the free-air figure divided by the
     ABSOLUTE pressure:
         Q_actual [L/min] = Q_N / (p_gauge + 1)
         v [mm/s]         = Q_actual × 1e6 / 60 / A [mm²]
     Example: 200 NL/min at 6 bar into a 50 mm bore
         200 / 7 = 28.57 L/min ; A = π/4 × 50² = 1963 mm² ; v = 242 mm/s.
     Skipping the ÷(p+1) step overstates the speed by a factor of 7 at 6 bar. */
  function cylinderSpeedMMS(cyl, isExtending) {
    if (cyl._stalled) return 0;
    var bore = cyl.values.bore || 50;
    /* Retraction fills the annular area (bore² − rod²) which is smaller, so the
       piston moves FASTER on the same flow. A rodless cylinder is symmetric. */
    var rod = (cyl.type === 'cyl-da') ? (cyl.values.rod || 0) : 0;
    var area = isExtending ? (Math.PI / 4 * bore * bore)
                           : (Math.PI / 4 * (bore * bore - rod * rod));
    if (area < 1) area = Math.PI / 4 * bore * bore;
    var qN = cyl._localFlow || 0;          /* NL/min reaching this cylinder */
    if (qN <= 0) return 0;
    var capP = cyl._capPressure || 0;
    var rodP = (cyl.type === 'cyl-sa') ? 0 : (cyl._rodPressure || 0);
    var activeP = isExtending ? (capP || cyl._localPressure || 0)
                              : (rodP || cyl._localPressure || 0);
    var v = qN / (activeP + 1) * 1e6 / 60 / area;   /* mm/s */
    /* Meter-out / quick-exhaust throttle the PHYSICAL speed: the piston can only
       travel as fast as the opposite face can empty. */
    var exhaustPortIdx;
    if (cyl.type === 'cyl-sa') exhaustPortIdx = 0;          /* single port vents to spring */
    else exhaustPortIdx = isExtending ? 1 : 0;               /* DA: extend vents rod; retract vents cap */
    var exh = (cyl.type === 'cyl-sa' && isExtending)
      ? { factor: 1.0, qevBoost: 1.0 }
      : traceExhaustPath(cyl.id, exhaustPortIdx);
    return v * exh.factor * exh.qevBoost;
  }

  /* Single-acting spring return: the SPRING sets the speed, not the supply
     (the cap side is exhausting, so there is no inlet flow to divide by area).
     Reference ≈0.8 stroke/s at 50 mm bore, scaled by √(50/bore), throttled by
     whatever sits on the cap-side exhaust path. */
  function saSpringSpeedMMS(cyl) {
    if (cyl._stalled) return 0;
    var bore = cyl.values.bore || 40;
    var exh = traceExhaustPath(cyl.id, 0);
    var frac = Math.max(0.1, 0.8 * Math.sqrt(50 / bore)) * exh.factor * exh.qevBoost;
    return frac * strokeMM(cyl);
  }

  /* Physical speed → animation step. v/stroke is the exact fraction of stroke
     per second (300 mm stroke at 100 mm/s → 3 s), clamped per frame so a tiny
     bore on a big flow cannot jump a whole stroke inside one frame. */
  function strokeStep(cyl, speedMMS, dt) {
    var step = speedMMS / strokeMM(cyl) * dt;
    if (!(step > 0)) return 0;
    return Math.min(0.08, step);
  }

  /* Advance pneumatic on/off-delay timer reservoirs using real dt.
     Called once per frame BEFORE computeCircuit so the BFS sees up-to-date state.
     Pilot pressure is read from last frame's connection pressures. */
  function advanceTimers(dt) {
    for (var tc = 0; tc < components.length; tc++) {
      var tcComp = components[tc];
      if (tcComp.type !== 'timer-on' && tcComp.type !== 'timer-off') continue;
      var pP = 0;
      for (var tci = 0; tci < connections.length; tci++) {
        var tcn = connections[tci];
        if ((tcn.from.compId === tcComp.id && tcn.from.portIdx === 0) ||
            (tcn.to.compId   === tcComp.id && tcn.to.portIdx   === 0)) {
          pP = Math.max(pP, tcn.pressure);
        }
      }
      var delay = tcComp.values.delay || 3;
      if (tcComp.type === 'timer-on') {
        if (pP > 0.5) {
          tcComp._timerFill = Math.min(delay, (tcComp._timerFill || 0) + dt);
        } else {
          tcComp._timerFill = 0;
        }
        tcComp._timerFired = (tcComp._timerFill || 0) >= delay;
      } else {
        if (pP > 0.5) {
          tcComp._timerDrain = delay;
          tcComp._timerSupplyP = pP;
        } else if ((tcComp._timerDrain || 0) > 0) {
          tcComp._timerDrain = Math.max(0, tcComp._timerDrain - dt);
          if (tcComp._timerDrain <= 0) tcComp._timerSupplyP = 0;
        }
        tcComp._timerFired = (tcComp._timerDrain || 0) > 0;
      }
    }
  }

  function animate(timestamp) {
    if (!running) return;
    var dt = Math.min((timestamp - lastTime) / 1000, 0.05);
    lastTime = timestamp;
    simTime += dt;
    _lastDt = dt;   /* real elapsed time — used by the air-receiver model */

    /* Pneumatic timer state advanced once per frame with REAL dt — separate
       from BFS so we never tick multiple times per frame on click/edit. */
    advanceTimers(dt);
    advanceCounters(); /* once-per-frame count edge, before continuity solve */
    computeCircuit();

    /* Displacement diagram: sample + redraw (throttled) while the card is open */
    sampleDisplacement();
    if (_dispCanvas) {
      var _ddCard = document.getElementById('disp-diagram-card');
      if (_ddCard && _ddCard.open) {
        _dispDrawAccum = (_dispDrawAccum || 0) + dt;
        if (_dispDrawAccum > 0.1) { _dispDrawAccum = 0; drawDisplacement(); }
      }
    }

    /* Buzzer: sound while any buzzer component carries current */
    var anyBuzz = false;
    for (var bz = 0; bz < components.length; bz++) {
      if (components[bz].type === 'buzzer-ep' && components[bz]._elecEnergized) { anyBuzz = true; break; }
    }
    setBuzzer(anyBuzz);

    /* Update cylinders — speed reflects supply flow + bore + meter-out path */
    for (var c = 0; c < components.length; c++) {
      var comp = components[c];
      if (comp.type === 'cyl-sa' || comp.type === 'cyl-da' || comp.type === 'cyl-rodless') {
        var prev = comp.extension;
        /* Animation is driven by the SAME physical speed the readout shows:
           fraction of stroke per second = v [mm/s] / stroke [mm]. */
        comp._speedMMS = 0;
        if (comp._extending) {
          var extendSpeed = cylinderSpeedMMS(comp, true);
          if (comp.extension < 1) comp._speedMMS = extendSpeed;
          comp.extension = Math.min(1, comp.extension + strokeStep(comp, extendSpeed, dt));
        } else if (comp.type === 'cyl-sa') {
          if (comp._capPressure < 0.5) {
            var saSpeed = saSpringSpeedMMS(comp);
            if (comp.extension > 0) comp._speedMMS = saSpeed;
            comp.extension = Math.max(0, comp.extension - strokeStep(comp, saSpeed, dt));
          }
        } else {
          if (comp._rodPressure > comp._capPressure + 0.3) {
            var daSpeed = cylinderSpeedMMS(comp, false);
            if (comp.extension > 0) comp._speedMMS = daSpeed;
            comp.extension = Math.max(0, comp.extension - strokeStep(comp, daSpeed, dt));
          } else if (comp._workingVented && comp.extension > 0) {
            /* Exhaust-centre venting: both ports open to atmosphere → cylinder drifts.
               No external load model, so simulate gravity-assist retraction at 30% rate. */
            comp.extension = Math.max(0, comp.extension - dt * 0.15);
          }
        }
        if (prev < 1 && comp.extension >= 1) playHiss();
        if (prev > 0 && comp.extension <= 0) playHiss();
      }
      if (comp.type === 'rotary-act') {
        var maxAngle = (comp.values.angle || 180) * Math.PI / 180;
        var flowScale = Math.max(0.1, Math.min(1.8, (comp._localFlow || 80) / 80));
        if (comp._extending) {
          var exhA = traceExhaustPath(comp.id, 1);
          var cwRate = 2 * flowScale * exhA.factor * exhA.qevBoost;
          comp.rotation = Math.min(maxAngle, (comp.rotation || 0) + dt * cwRate);
        } else if ((comp._portBPressure || 0) > (comp._portAPressure || 0) + 0.3) {
          var exhB = traceExhaustPath(comp.id, 0);
          var ccwRate = 2 * flowScale * exhB.factor * exhB.qevBoost;
          comp.rotation = Math.max(0, (comp.rotation || 0) - dt * ccwRate);
        }
      }
    }

    /* Update particles */
    for (var p = 0; p < particles.length; p++) {
      var part = particles[p];
      var conn = connections[part.connIdx];
      if (!conn || conn.pressure <= 0) continue;
      part.t += part.speed * dt * (conn.flowDir || 1);
      if (part.t > 1) part.t -= 1;
      if (part.t < 0) part.t += 1;
      var path = _pathCache[part.connIdx];
      if (path) {
        var len = polylineLength(path);
        var pos = interpolatePolyline(path, part.t * len);
        part.x = pos.x;
        part.y = pos.y;
        part.pressure = conn.pressure;
      }
    }

    draw();
    animFrame = requestAnimationFrame(animate);
  }

  function startSimulation() {
    if (running) return;
    running = true;
    _dispBuf = []; _dispDrawAccum = 0; /* fresh displacement trace */
    btnRun.style.display = 'none';
    btnStop.style.display = '';
    simReadouts.style.display = '';

    /* Create particles */
    particles = [];
    for (var i = 0; i < connections.length; i++) {
      for (var j = 0; j < 4; j++) {
        particles.push({ connIdx: i, t: j / 4, x: 0, y: 0, speed: 0.3 + Math.random() * 0.2, pressure: 0 });
      }
    }

    /* Solve once BEFORE validating so auto-link results (nearest valve /
       nearest cylinder) are known and the messages match what the sim does. */
    computeCircuit();

    /* Validate circuit and show warnings for common user mistakes */
    var warnings = [];
    var hasPSU = false, hasAirSupply = false, hasCylinder = false;
    var coilLabelCount = {}, contactRefs = [], hasEStop = false, bistableValves = [];
    var pbList = [], pairA = false, pairB = false;
    for (var vi = 0; vi < components.length; vi++) {
      var vc = components[vi];
      if (vc.type === 'power-supply-24v') hasPSU = true;
      if (vc.type === 'air-supply') hasAirSupply = true;
      if (vc.type === 'cyl-da' || vc.type === 'cyl-sa' || vc.type === 'cyl-rodless') hasCylinder = true;
      if (vc.type === 'e-stop') hasEStop = true;
      if (vc.type === 'v52-double') bistableValves.push(vc);
      if (vc.type === 'relay-spdt') {
        var kl = (vc.values && vc.values.label) || 'K1';
        coilLabelCount[kl] = (coilLabelCount[kl] || 0) + 1;
      }
      if (vc.type === 'relay-contact') contactRefs.push((vc.values && vc.values.coil) || 'K1');
      if (vc.type === 'push-button-no') {
        pbList.push(vc);
        var sp2 = vc.values && vc.values.safetyPair;
        if (sp2 === 'A') pairA = true;
        else if (sp2 === 'B') pairB = true;
      }
      /* Check pressure switch has pneumatic connection */
      if (vc.type === 'pressure-switch-ep') {
        var pConnected = false;
        for (var vci = 0; vci < connections.length; vci++) {
          var vcn = connections[vci];
          if ((vcn.from.compId === vc.id && vcn.from.portIdx === 0) || (vcn.to.compId === vc.id && vcn.to.portIdx === 0)) {
            var otherComp = findComp(vcn.from.compId === vc.id ? vcn.to.compId : vcn.from.compId);
            if (otherComp) { var otherDef = COMP_DEFS[otherComp.type]; var otherPort = otherDef.ports[vcn.from.compId === vc.id ? vcn.to.portIdx : vcn.from.portIdx]; if (!otherPort || !otherPort.elec) pConnected = true; }
          }
        }
        if (!pConnected) warnings.push('Pressure switch P-In port not connected to pneumatic line');
      }
    }
    if (!hasAirSupply) warnings.push('No air supply — pneumatic circuit needs a compressor');
    if (!hasPSU && components.some(function(c){ return COMP_DEFS[c.type] && COMP_DEFS[c.type].ports.some(function(p){ return p.elec; }); }))
      warnings.push('Electrical components present but no 24V power supply');
    /* Solenoid coils bound by numeric ID silently unbind when unset or when
       the target valve is deleted — surface both cases. */
    for (var sci2 = 0; sci2 < components.length; sci2++) {
      var scc = components[sci2];
      if (scc.type !== 'solenoid-coil') continue;
      var linkId = scc.values.linkedValve || 0;
      /* An unset coil AUTO-LINKS to the nearest valve within 260 px, so the
         message must say that rather than claim the coil does nothing. */
      if (!linkId) warnings.push(scc._autoLinkedValve
        ? 'Solenoid coil auto-linked to the nearest valve (ID ' + scc._autoLinkedValve + ') — set "Linked Valve ID" to make it explicit'
        : 'Solenoid coil has no valve in range — set its "Linked Valve ID" in properties');
      else if (!findComp(linkId)) warnings.push('Solenoid coil links to valve ID ' + linkId + ' which no longer exists');
    }

    /* Relay contact referencing a coil that is not on the sheet. Silently
       treating it as de-energised leaves an NC contact PERMANENTLY CLOSED — a
       phantom wire that can never open a stop or interlock rung. */
    var reportedOrphan = {};
    for (var orf = 0; orf < contactRefs.length; orf++) {
      var oref = contactRefs[orf];
      if (!coilLabelCount[oref] && !reportedOrphan[oref]) {
        reportedOrphan[oref] = true;
        warnings.push('Relay contact references coil ' + oref + ' — no such coil on sheet (contact is shown faulted and conducts in neither position)');
      }
    }
    /* Two coils sharing a label are ONE relay as far as contact logic goes —
       the aux contacts follow the OR of both, almost never what was drawn. */
    for (var dkl in coilLabelCount) {
      if (coilLabelCount[dkl] > 1) warnings.push('Duplicate coil label ' + dkl + ' on ' + coilLabelCount[dkl] + ' relays — every contact labelled ' + dkl + ' follows BOTH coils; give each relay its own label');
    }

    /* EN 574: a plain two-button SERIES start — what most students actually
       build — is not a two-hand control at all unless the anti-tie-down timing
       is being checked, and nothing used to say so. Detect the series pair
       directly (one button's output wired to the other's input). */
    var seriesPB = false;
    for (var sa = 0; sa < pbList.length && !seriesPB; sa++) {
      for (var sb = 0; sb < pbList.length && !seriesPB; sb++) {
        if (sa === sb) continue;
        for (var sci = 0; sci < connections.length; sci++) {
          var scn = connections[sci];
          var f = scn.from, tt = scn.to;
          if ((f.compId === pbList[sa].id && f.portIdx === 1 && tt.compId === pbList[sb].id && tt.portIdx === 0) ||
              (tt.compId === pbList[sa].id && tt.portIdx === 1 && f.compId === pbList[sb].id && f.portIdx === 0)) {
            seriesPB = true; break;
          }
        }
      }
    }
    if (seriesPB && !(pairA && pairB)) {
      warnings.push('EN 574: two start buttons wired in series is NOT a compliant two-hand control on its own — set "Two-Hand Pair" to A and B on the two buttons so the 0.5 s anti-tie-down check runs');
    } else if ((pairA !== pairB) && pbList.length >= 2) {
      warnings.push('EN 574: only one half of the two-hand pair is set — the anti-tie-down check needs BOTH an A and a B button');
    }

    /* EN ISO 13849 / EN 60204-1: a bistable valve REMEMBERS its position, so
       cutting control power does not move the actuator. Real behaviour, and
       exactly the safety trap worth teaching. */
    if (hasEStop && bistableValves.length > 0) {
      warnings.push('E-stop upstream of a bistable valve does not de-actuate the cylinder — the 5/2 double-solenoid spool holds its last position. Add a dump valve, or use a spring-return / exhaust-centre valve for the safety function');
    }

    if (warnings.length > 0) {
      warningBar.innerHTML = '\u26a0 ' + warnings.join(' &bull; ');
      warningBar.style.display = '';
      if (_warnTimer) clearTimeout(_warnTimer);
      _warnTimer = setTimeout(function () { warningBar.style.display = 'none'; }, 9000);
    }

    lastTime = performance.now();
    animFrame = requestAnimationFrame(animate);
  }

  function stopSimulation() {
    running = false;
    if (animFrame) cancelAnimationFrame(animFrame);
    btnRun.style.display = '';
    btnStop.style.display = 'none';
    simReadouts.style.display = 'none';
    /* Reset extensions and persistent state for a clean restart.
       EN 60204-1 §9.2.5.4 — RESTART AFTER STOP MUST NOT BE AUTOMATIC. The
       coil-latch fields below used to survive a Stop, and computeCircuit() seeds
       _prevCoilEnergized from them, so a self-holding relay re-latched at t = 0
       on the next Run with no start signal at all. Everything that carries an
       energised or latched state is cleared here, and spring-return valves go
       back to their normal position. */
    for (var c = 0; c < components.length; c++) {
      var sc = components[c];
      sc.extension = 0;
      sc.rotation = 0;
      sc.reading = 0;
      sc._localPressure = 0;
      sc._localFlow = 0;
      sc._speedMMS = 0;
      sc._extending = false;
      sc._timerFill = 0;
      sc._timerDrain = 0;
      sc._timerSupplyP = 0;
      sc._timerFired = false;
      sc._timerStart = 0;
      sc._timerOffStart = 0;
      sc._timerElapsed = 0;
      sc._sequenceOpen = false;
      sc._reliefActive = false;
      sc._vacuumActive = false;
      sc._vacuumLevel = 0;
      sc._count = 0;
      sc._cntPrev = false;
      sc._countReached = false;
      /* ── Coil / latch / sensor state — the unexpected-restart fix ── */
      sc._coilEnergized = false;
      sc._prevCoilEnergized = false;
      sc._effCoil = false;
      sc._elecEnergized = false;
      sc._elecClosed = false;
      sc._y1Energized = false;
      sc._y2Energized = false;
      sc._bothSolFault = false;
      sc._cntEnergized = false;
      sc._rstEnergized = false;
      sc._rstPending = false;
      sc._pilotPressure = 0;
      sc._pilotUnlocked = false;
      sc._signalVented = false;
      sc._pressTime = 0;
      sc._safetyFault = false;
      sc._momentaryActive = false;
      sc._latched = false;
      /* Momentary operators return to rest — a latched button must not survive
         a Stop, that is exactly the tie-down EN 574 forbids. */
      if (sc.type === 'push-button-no') sc.values.pressed = 'Open';
      else if (sc.type === 'push-button-nc') sc.values.pressed = 'Closed';
      /* Spring-return / spring-centred valves go home. A bistable v52-double is
         deliberately NOT reset — a real double-solenoid valve retains its
         position with no power, which is the safety lesson it exists to teach. */
      else if (sc.type === 'v52-single' || sc.type === 'v32-solenoid') sc.values.position = 'Normal';
      else if (sc.type === 'v53-solenoid') sc.values.position = 'Center';
    }
    _solverUnsettled = false;
    particles = [];
    setBuzzer(false); /* silence buzzer when simulation stops */
    for (var i = 0; i < connections.length; i++) {
      connections[i].pressure = 0;
      connections[i].flow = 0;
    }
    draw();
  }

  /* ================================================================
     PRE-BUILT CIRCUITS
     ================================================================ */

  function buildCircuit(name) {
    saveUndoState();
    components = [];
    connections = [];
    nextId = 1;
    particles = [];
    selectedComp = null;
    selectedConn = -1;
    if (running) stopSimulation();

    var desc = '';

    /* ── SHEET LAYOUT STANDARD — identical on all ten pre-built circuits ──
       The two domains never share a column, so each half can be read alone:

         PNEUMATIC (power) sheet   x   20 … 470
         reserved gap              x  470 … 540
         ELECTRICAL (control)sheet x  540 … 900

       Control sheet is a ladder: the 24 V supply sits at the bottom-left, its
       +24 V terminal feeds a vertical rail at x = 560, every rung hangs off
       that rail and reads LEFT → RIGHT, and all 0 V returns come back along a
       single bus at y = 510. Only two families of wire ever leave the control
       sheet, and both use a reserved lane so the coil ↔ valve link is obvious:
         SOL  — solenoid feeds, corridor y = 360 (or 190/215 when the wire has
                to reach the Y2 side, which faces left)
         BUS  — 0 V returns, y = 510
       Keeping these numbers fixed is what makes the ten sheets legible. */
    var RAILX = 560;   /* +24 V rail — the supply's own centre-line */
    var BUSY  = 510;   /* 0 V return bus */
    var SOLY  = 360;   /* solenoid corridor, single-cylinder sheets */

    /* 0 V return: drop straight down in a clear column, then run the bus home. */
    function toZeroV(fromId, fromPort, psuId, dropX) {
      connectVia(fromId, fromPort, psuId, 1, [{ x: dropX, y: BUSY }, { x: RAILX, y: BUSY }]);
    }
    /* Control → solenoid: leave the ladder in a clear column, cross the gap in
       the corridor, then rise to the coil terminal. */
    function toCoil(fromId, fromPort, valveId, valvePort, dropX, riseX, lane) {
      connectVia(fromId, fromPort, valveId, valvePort,
        [{ x: dropX, y: lane === undefined ? SOLY : lane }, { x: riseX, y: lane === undefined ? SOLY : lane }]);
    }

    switch (name) {
      case 'direct-solenoid':
        desc = 'Direct solenoid control: one push button in series with the solenoid of a 5/2 single-solenoid valve (Y+/Y−) — the simplest electro-pneumatic circuit there is. Power part: Compressor → Tank → FRL → valve → cylinder, exhaust through both silencers. Control part: +24V → S1 → Y+ → 0V. Press and HOLD S1 to extend — it is a momentary button, so releasing it drops the coil and the spring returns the valve (cylinder retracts). Shift+click latches S1 if you want it to stay in.';
        /* ── Power sheet ── */
        addComp('air-supply', 20, 430, { pressure: 6, flow: 200 });     /* 1 compressor */
        addComp('air-tank', 100, 410, { volume: 50 });                  /* 2 receiver */
        addComp('frl', 170, 410, { setting: 6 });                       /* 3 FRL */
        addComp('v52-single', 300, 250, { position: 'Normal' });        /* 4 5/2 single sol. */
        addComp('cyl-da', 250, 60, { bore: 50, rod: 20, stroke: 150 }); /* 5 cylinder */
        addComp('silencer', 230, 340, {});                              /* 6 exhaust 3 */
        addComp('silencer', 350, 340, {});                              /* 7 exhaust 5 */
        connect(1, 0, 2, 0);  /* compressor → tank */
        connect(2, 1, 3, 0);  /* tank → FRL */
        connect(3, 1, 4, 0);  /* FRL → valve port 1 */
        connect(4, 3, 5, 0);  /* port 4 → cap  (Energised = extend) */
        connect(4, 1, 5, 1);  /* port 2 → rod  (Normal = retracted) */
        connect(4, 4, 6, 0);  /* port 5 → silencer */
        connect(4, 2, 7, 0);  /* port 3 → silencer */
        /* ── Control sheet ── */
        addComp('power-supply-24v', 535, 430, { voltage: 24 });         /* 8 24V DC */
        addComp('push-button-no', 580, 220, {});                        /* 9 S1, rung y=240 */
        connect(8, 0, 9, 0);                        /* +24V rail → S1 */
        toCoil(9, 1, 4, 5, 660, 470);               /* S1 → Y+ */
        toZeroV(4, 6, 8, 430);                      /* Y− → 0V bus */
        break;

      case 'self-holding':
        desc = 'Self-holding (latching) relay — the standard Festo start/stop rung. Rung 1 reads left to right: +24V → S0 (Stop, NC) → S1 (Start, NO) → K1 coil → 0V. K1’s own NO contact is wired back across S1, so a momentary tap on Start latches the coil; pressing Stop breaks the rung and it drops out. A second K1 NO contact feeds the valve solenoid. Stopping and re-starting the simulation always leaves the latch OPEN — a relay must never pick up on its own when power returns.';
        addComp('air-supply', 20, 430, { pressure: 6, flow: 200 });     /* 1 */
        addComp('air-tank', 100, 410, { volume: 50 });                  /* 2 */
        addComp('frl', 170, 410, { setting: 6 });                       /* 3 */
        addComp('v52-single', 300, 250, { position: 'Normal' });        /* 4 */
        addComp('cyl-da', 250, 60, { bore: 50, rod: 20, stroke: 150 }); /* 5 */
        addComp('silencer', 230, 340, {});                              /* 6 */
        addComp('silencer', 350, 340, {});                              /* 7 */
        connect(1, 0, 2, 0); connect(2, 1, 3, 0); connect(3, 1, 4, 0);
        connect(4, 3, 5, 0); connect(4, 1, 5, 1); connect(4, 4, 6, 0); connect(4, 2, 7, 0);
        /* ── Control sheet — rung 1: Stop → Start → K1 coil ── */
        addComp('power-supply-24v', 535, 430, { voltage: 24 });         /* 8 */
        addComp('push-button-nc', 580, 60, {});                         /* 9 S0 Stop */
        addComp('push-button-no', 680, 60, {});                         /* 10 S1 Start */
        addComp('relay-spdt', 780, 50, { label: 'K1' });                /* 11 K1 */
        connect(8, 0, 9, 0);    /* rail → S0 */
        connect(9, 1, 10, 0);   /* S0 → S1 */
        connect(10, 1, 11, 0);  /* S1 → K1 A1 */
        toZeroV(11, 1, 8, 880); /* K1 A2 → 0V */
        connectVia(9, 1, 11, 2, [{ x: 644, y: 122 }, { x: 740, y: 122 }]);   /* node R → K1 COM */
        connectVia(11, 3, 11, 0, [{ x: 862, y: 172 }, { x: 760, y: 172 }]); /* K1 NO → A1 (self-hold) */
        toCoil(11, 3, 4, 5, 900, 470);   /* K1 NO → valve Y+ */
        toZeroV(4, 6, 8, 430);           /* Y− → 0V */
        break;

      case 'auto-return-limit':
        desc = 'True auto-return with a bistable valve. Press S1 → coil Y1 shifts the 5/2 double-solenoid valve to position B → cylinder extends. At 90 % of stroke limit switch S2 closes → coil Y2 flips the spool back to position A → cylinder retracts on its own. Because the valve has no spring it remembers its last position, so a momentary pulse on either coil is enough — that is what makes the return automatic. The green lamp is wired in parallel with Y2 and marks full extension.';
