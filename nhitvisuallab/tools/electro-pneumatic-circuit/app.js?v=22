  function drawCylSASymbol(w, h, comp) {
    var ext = (comp.extension || 0);
    var pX = 10 + ext * (w - 30);
    ctx.fillStyle = '#1a2535';
    ctx.strokeStyle = '#5a8ab5';
    ctx.lineWidth = 1.5;
    /* Barrel */
    ctx.strokeRect(4, 4, w - 8, h - 8);
    ctx.fillRect(4, 4, w - 8, h - 8);
    /* Piston */
    ctx.fillStyle = running ? '#42a5f5' : '#4a6a8a';
    ctx.fillRect(pX, 6, 4, h - 12);
    /* Rod */
    ctx.strokeStyle = running ? '#42a5f5' : '#4a6a8a';
    ctx.lineWidth = 3;
    ctx.beginPath();
    ctx.moveTo(pX + 4, h / 2);
    ctx.lineTo(w - 4, h / 2);
    ctx.stroke();
    /* Spring */
    ctx.strokeStyle = '#667799';
    ctx.lineWidth = 1;
    var springStart = pX + 8;
    var springEnd = w - 10;
    if (springEnd > springStart + 10) {
      ctx.beginPath();
      ctx.moveTo(springStart, h / 2);
      var numCoils = 4;
      var coilW = (springEnd - springStart) / numCoils;
      for (var sc = 0; sc < numCoils; sc++) {
        ctx.lineTo(springStart + sc * coilW + coilW * 0.25, h / 2 - 6);
        ctx.lineTo(springStart + sc * coilW + coilW * 0.75, h / 2 + 6);
      }
      ctx.lineTo(springEnd, h / 2);
      ctx.stroke();
    }
  }

