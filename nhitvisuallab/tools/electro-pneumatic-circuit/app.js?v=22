  /* Rebuilt once per draw pass — components/ids only change between frames. */
  function rebuildDesignations() {
    _desigMap = {};
    var counts = {};
    for (var i = 0; i < components.length; i++) {
      var c = components[i];
      var L = DESIG_LETTER[c.type];
      if (!L) continue;
      counts[L] = (counts[L] || 0) + 1;
      _desigMap[c.id] = L + counts[L];
    }
  }

  function designationOf(comp) {
    if (!_desigMap) rebuildDesignations();
    return (comp && _desigMap[comp.id]) || '';
