  function addComp(type, x, y, vals) {
    var def = COMP_DEFS[type];
    if (!def) return;
    var values = {};
    for (var k in def.params) values[k] = def.params[k].def;
    for (var k2 in vals) values[k2] = vals[k2];
    components.push({ id: nextId++, type: type, x: x, y: y, orient: 0, values: values, extension: 0, rotation: 0, reading: 0 });
  }

  function connect(fromId, fromPort, toId, toPort) {
    connections.push({ from: { compId: fromId, portIdx: fromPort }, to: { compId: toId, portIdx: toPort }, pressure: 0, flow: 0, flowDir: 0 });
  }

  /* Same as connect(), but pins the route through explicit corridor points.
     Used by the pre-built circuits so the few wires that have to leave the
     control sheet (coil → valve, every 0 V return) always travel in the same
     reserved lanes instead of wherever the auto-router happens to bend. */
  function connectVia(fromId, fromPort, toId, toPort, wps) {
    connections.push({ from: { compId: fromId, portIdx: fromPort }, to: { compId: toId, portIdx: toPort }, waypoints: wps, pressure: 0, flow: 0, flowDir: 0 });
  }

  /* ================================================================
     EVENT HANDLERS
     ================================================================ */

  function getCanvasPos(e) {
    var rect = canvas.getBoundingClientRect();
    var sx = (e.clientX - rect.left) * (W / rect.width);
    var sy = (e.clientY - rect.top) * (H / rect.height);
    return { x: (sx - viewOffX) / viewScale, y: (sy - viewOffY) / viewScale };
  }

  function getCanvasPosSafe(e) {
    var rect = canvas.getBoundingClientRect();
    return { x: e.clientX - rect.left, y: e.clientY - rect.top };
