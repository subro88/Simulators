  /* True if a (component, port-label) is an exhaust-to-atmosphere port.
     Exhaust ports may still accept connections (silencer, flow-control for
     meter-out, quick-exhaust) but render in red so the user knows they vent
     to atmosphere. Electrical ports are NEVER treated as exhaust. */
  function isExhaustPort(compType, portLabel, isElec) {
    if (isElec) return false;
    if (!portLabel) return false;
    if (compType === 'tee') return false;       /* T-connector '3' is a junction */
    if (compType === 'silencer') return true;   /* silencer is itself an exhaust */
    if (/^v(22|32|43|52|53)/.test(compType)) {
      return portLabel === '3' || portLabel === '5' || portLabel === 'T' || portLabel === 'R';
    }
    if (compType === 'relief') return portLabel === '2' || portLabel === '3' || portLabel === 'R';
    if (compType === 'quick-exhaust') return portLabel === '3' || portLabel === 'R';
    if (compType === 'venturi') return portLabel === 'R';
    /* 3/2 roller-lever trip valve: port 3 vents the signal line at rest */
    if (compType === 'limit-nc' || compType === 'limit-no') return portLabel === '3';
    return false;
  }

  /* ================================================================
     EN 81346 REFERENCE DESIGNATIONS  (S = manual/position input,
     B = converting sensor, K = relay, Y = solenoid, H = signalling,
     P = measuring / indicating device)
     Instances are auto-numbered per letter in sheet order, so a canvas
     reads S1/S2/K1/Y1/H1/P1 like a real EN 60204-1 schematic.
     ================================================================ */
  var DESIG_LETTER = {
    'push-button-no': 'S', 'push-button-nc': 'S', 'toggle-switch': 'S', 'e-stop': 'S',
    'limit-switch-ep': 'S', 'limit-nc': 'S', 'limit-no': 'S',
    'pressure-switch-ep': 'B', 'reed-switch-ep': 'B', 'proximity': 'B',
    'indicator-lamp': 'H', 'buzzer-ep': 'P', 'counter-ep': 'P',
    'solenoid-coil': 'Y'
  };
