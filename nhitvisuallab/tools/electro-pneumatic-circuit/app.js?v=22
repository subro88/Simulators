  /* IEC 60947-5-1 terminal marking for sensor / auxiliary contacts:
     NC pair = 11-12, NO pair = 13-14. The static port label in COMP_DEFS is
     only the default ('COM' / 'NO'); the drawn label follows the chosen mode. */
  function terminalLabel(comp, portIdx, fallback) {
    if (!comp) return fallback;
    var t = comp.type, v = comp.values || {};
    var isNc = (v.mode === 'NC');
    if (t === 'limit-switch-ep' || t === 'reed-switch-ep') {
      if (portIdx === 0) return isNc ? '11' : '13';
      if (portIdx === 1) return isNc ? '12' : '14';
    } else if (t === 'pressure-switch-ep') {
      if (portIdx === 1) return isNc ? '11' : '13';
      if (portIdx === 2) return isNc ? '12' : '14';
    } else if (t === 'relay-contact') {
      var rcNc = (v.mode === 'NC');
      if (portIdx === 0) return rcNc ? '11' : '13';
      if (portIdx === 1) return rcNc ? '12' : '14';
    }
    return fallback;
  }

  /* Tooltip text for the IEC terminal markings above (kept out of PORT_DESC
