    for (var i = 0; i <= steps; i++) {
      var tt = (i / steps) * maxT;
      var vv = simG * tt;
      if (tt > tFall) vv = simG * tFall;
      var px = gx + (tt / maxT) * gw;
      var py = gy + gh - (vv / maxV) * gh;
      if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
    }
    ctx.stroke();
    ctx.setLineDash([]);

    ctx.font = '10px Courier New';
    ctx.fillStyle = 'rgba(61,220,132,0.5)';
