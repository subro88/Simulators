  function checkPractice() {
    if (practiceChecked) return;
    var val = parseFloat(ppInput.value);
    if (isNaN(val)) { ppFeedback.textContent = 'Enter a number'; ppFeedback.className = 'feedback err'; return; }
    practiceChecked = true;
    practiceTotal++;

    var correct = practiceProblem.answer;
    var tol = Math.max(Math.abs(correct) * 0.05, 0.1);
    var isOk = Math.abs(val - correct) <= tol;

    if (isOk) {
      practiceScore++;
      ppFeedback.textContent = 'Correct! ' + correct.toFixed(2) + ' ' + practiceProblem.unit;
      ppFeedback.className = 'feedback ok';
    } else {
      ppFeedback.textContent = 'Incorrect. Answer: ' + correct.toFixed(2) + ' ' + practiceProblem.unit;
      ppFeedback.className = 'feedback err';
    }
    updatePracticeScore();
    ppInput.disabled = true;
    ppCheck.style.display = 'none';
    ppNext.style.display = '';

    /* show solution */
    ppSolution.style.display = '';
    var solHtml = '<h4>Solution</h4>';
