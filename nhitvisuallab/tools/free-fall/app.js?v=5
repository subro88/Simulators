  /* ================================================================
     PHYSICS / SIMULATION
     ================================================================ */
  function resetBall(b) {
    b.y = simHeight;
    b.v = 0;
    b.s = 0;
    b.t = 0;
    b.trail = [];
    b.landed = false;
  }

  function updateBall(b, dt, g, useDrag, mass, radius) {
    if (b.landed) return;

    if (useDrag) {
      var Cd = 0.47, rho = 1.225, A = Math.PI * radius * radius;
      var Fd = 0.5 * Cd * rho * A * b.v * b.v;
      var a = g - Fd / mass;
      if (a < 0) a = 0;
      b.v += a * dt;
    } else {
      b.v += g * dt;
    }

    b.s += b.v * dt;
    b.t += dt;
    b.y = simHeight - b.s;

    /* trail recording (every few frames) */
    if (b.trail.length === 0 || b.s - b.trail[b.trail.length - 1].s > simHeight * 0.03) {
      b.trail.push({ s: b.s, t: b.t });
    }

    if (b.s >= simHeight) {
      b.s = simHeight;
      b.y = 0;
      /* In vacuum the integrated v already matches v=√(2gh); snap to the exact
         analytic value to remove tiny dt error. With drag ON the integrated v
         is the physically correct (lower) impact speed — never overwrite it. */
      if (!useDrag) b.v = Math.sqrt(2 * g * simHeight);
      b.landed = true;
    }
  }

  /* True (drag-aware) fall time via a quick coarse integration. For vacuum it
     reduces to the closed form. Used for graph scaling AND Auto playback speed. */
  function estimateFallTime(h, g, drag, mass, radius) {
    if (!drag) return Math.sqrt(2 * h / g);
    var v = 0, s = 0, t = 0, dt = 0.02, guard = 0;
    var k = 0.5 * 0.47 * 1.225 * Math.PI * radius * radius;   /* ½·Cd·ρ·A */
    while (s < h && guard++ < 500000) {
      var a = g - k * v * v / mass;
      if (a < 0) a = 0;
      v += a * dt; s += v * dt; t += dt;
    }
    return t;
  }

  function dropFallTime() {
    var t = estimateFallTime(simHeight, simG, airRes, 1, 0.05);
    if (multiBall) t = Math.max(t, estimateFallTime(simHeight, simG, airRes, 10, 0.10));
    return t;
  }

  function computeAutoSpeed() {
    var s = dropFallTime() / PLAYBACK_TARGET;
    var steps = [1, 2, 5, 10, 25, 50, 100, 200, 500];
    for (var i = 0; i < steps.length; i++) { if (steps[i] >= s) return steps[i]; }
    return steps[steps.length - 1];
  }
  function refreshAutoSpeed() { autoSpeedVal = computeAutoSpeed(); updateSpeedReadout(); }
  function effectiveSpeed() { return simSpeed === 'auto' ? autoSpeedVal : simSpeed; }

  function startDrop() {
    if (animating) return;

    resetBall(ball1);
    resetBall(ball2);
    graphPoints = [];
    impactFlash = 0;
    impactFlash2 = 0;

    refreshAutoSpeed();
    totalFallTime = dropFallTime();
    animating = true;
    animStartTs = null;
    btnDrop.disabled = true;

    animFrame = requestAnimationFrame(tick);
  }

  function tick(ts) {
    if (!animating) return;
    if (!animStartTs) animStartTs = ts;

    /* Advance physical time by speed× per real frame. Sub-step so each physics
       step stays ≤8 ms of PHYSICAL time — keeps the v² drag integration accurate
       no matter how high the playback speed is. */
    var frameDt = (1 / 60) * effectiveSpeed();
    var sub = Math.max(1, Math.min(2000, Math.ceil(frameDt / 0.008)));
    var dt = frameDt / sub;

    for (var i = 0; i < sub; i++) {
      if (!ball1.landed) updateBall(ball1, dt, simG, airRes, 1, 0.05);
      if (multiBall && !ball2.landed) updateBall(ball2, dt, simG, airRes, 10, 0.10);
      if (ball1.landed && (!multiBall || ball2.landed)) break;
    }

    /* record graph data (once per frame keeps the array bounded) */
    graphPoints.push({ t: ball1.t, s: ball1.s, v: ball1.v });

    /* impact flashes + thud */
    if (ball1.landed && impactFlash === 0) { impactFlash = 1; playThud(Math.min(0.45, ball1.v / 90)); }
    if (multiBall && ball2.landed && impactFlash2 === 0) { impactFlash2 = 1; playThud(Math.min(0.45, ball2.v / 90)); }

    /* decay flashes */
    if (impactFlash > 0) impactFlash = Math.max(0, impactFlash - 0.025);
    if (impactFlash2 > 0) impactFlash2 = Math.max(0, impactFlash2 - 0.025);

    /* update readouts */
    updateReadoutsLive();

    draw();

    /* check if done */
    var allLanded = ball1.landed && (!multiBall || ball2.landed);
    var flashesDone = impactFlash <= 0 && impactFlash2 <= 0;
    if (allLanded && flashesDone) {
      animating = false;
      btnDrop.disabled = false;
      return;
    }

    animFrame = requestAnimationFrame(tick);
  }

  function stopAnimation() {
    animating = false;
    if (animFrame) cancelAnimationFrame(animFrame);
    animFrame = null;
    btnDrop.disabled = false;
  }

  function resetSim() {
    stopAnimation();
    resetBall(ball1);
    resetBall(ball2);
    graphPoints = [];
    impactFlash = 0;
    impactFlash2 = 0;
    refreshAutoSpeed();          /* Auto factor tracks current height / g / drag */
    updateReadoutsStatic();
    draw();
  }

  /* ================================================================
     READOUTS
     ================================================================ */
  function updateReadoutsLive() {
    rHeight.textContent = toD(Math.max(0, simHeight - ball1.s)).toFixed(2);
    rDist.textContent = toD(ball1.s).toFixed(2);
    rVel.textContent = toD(ball1.v).toFixed(2);
    rTime.textContent = ball1.t.toFixed(2);
    rGval.textContent = toD(simG).toFixed(2);
    rPlanet.textContent = simPlanet;
    updateLearnPanels();
  }

  function updateReadoutsStatic() {
    rHeight.textContent = toD(simHeight).toFixed(2);
    rDist.textContent = '0.00';
    rVel.textContent = '0.00';
    rTime.textContent = '0.00';
    rGval.textContent = toD(simG).toFixed(2);
    rPlanet.textContent = simPlanet;
    updateLearnPanels();
  }

  /* Refresh all unit-bearing labels (readout units, stepper labels, stepper
     displayed values) when the SI/Imperial toggle flips or g/height change. */
  function syncUnitUI() {
    if (uHeight) uHeight.textContent = ' ' + uLen();
    if (uDist) uDist.textContent = ' ' + uLen();
    if (uVel) uVel.textContent = ' ' + uVel0();
    if (uGval) uGval.textContent = ' ' + uAcc();
    if (heightLabel) heightLabel.textContent = 'Drop Height (' + uLen() + ')';
    if (customGLabel) customGLabel.innerHTML = 'Custom g (' + uAcc() + ')';
    if (heightVal) heightVal.max = Math.round(toD(MAX_H));
    syncSteppers();
  }
  /* uVel is also a DOM ref name; alias the unit string helper to avoid clash */
  function uVel0() { return imperial ? 'ft/s' : 'm/s'; }

  /* Mirror current SI state into the stepper number inputs (display units),
     guarding the field the user is actively typing in. */
  function syncSteppers() {
    if (document.activeElement !== heightVal) {
      heightVal.value = +toD(simHeight).toFixed(imperial ? 1 : 0);
    }
    if (document.activeElement !== customGVal) {
      customGVal.value = +toD(simG).toFixed(imperial ? 2 : 2);
    }
  }

  /* ================================================================
     MODE SWITCHING
     ================================================================ */
  document.getElementById('mode-tabs').addEventListener('click', function (e) {
    if (!e.target.matches('.pill')) return;
    var newMode = e.target.dataset.mode;
    if (newMode === mode) return;
    document.querySelectorAll('#mode-tabs .pill').forEach(function (p) {
      p.classList.toggle('active', p === e.target);
    });
    switchMode(newMode);
  });

  function switchMode(m) {
    mode = m;
    stopAnimation();

    /* hide all panels */
    simPanel.style.display = 'none';
    catRow.style.display = 'none';
    itemSelector.style.display = 'none';
    itemInfo.style.display = 'none';
    practicePanel.style.display = 'none';
    practiceBar.style.display = 'none';
    quizPanel.style.display = 'none';
    quizBar.style.display = 'none';
    quizResult.style.display = 'none';

    /* simulate-only siblings (action bar, learn panels, hint) */
    var simOnly = (m === 'simulate');
    if (actionBar) actionBar.style.display = simOnly ? '' : 'none';
    var lp = $('learn-panels'); if (lp) lp.style.display = simOnly ? '' : 'none';
    if (hintBar && !simOnly) hintBar.style.display = 'none';

    /* show canvas for simulate/explore, hide for practice/quiz */
    var canvasCard = cvs.parentElement;
    canvasCard.style.display = (m === 'simulate' || m === 'explore') ? '' : 'none';

    if (m === 'simulate') {
      simPanel.style.display = '';
      resetSim();
    } else if (m === 'explore') {
      catRow.style.display = '';
      itemSelector.style.display = '';
      buildConceptGrid();
      draw();
    } else if (m === 'practice') {
      practicePanel.style.display = '';
      practiceBar.style.display = '';
      practiceScore = 0;
