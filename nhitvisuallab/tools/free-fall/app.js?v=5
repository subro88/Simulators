  /* ================================================================
     STATE
     ================================================================ */
  var W = 900, H = 560;
  var DPR = window.devicePixelRatio || 1;
  var mode = 'simulate';
  var curCat = 'gravity';
  var curConcept = null;

  /* sim state */
  var simHeight = 20;       /* drop height in metres (internal SI) */
  var simG = 9.81;          /* gravity m/s^2 (internal SI) */
  var simPlanet = 'Earth';
  var airRes = false;
  var multiBall = false;
  var showEq = true;        /* on-canvas classical equation */
  var showGrid = true;      /* graph grid lines */

  /* unit system — all internals stay SI; display-only conversion */
  var imperial = false;
  var FT = 3.280839895;     /* metres -> feet */
  function toD(siVal, kind) {
    /* kind: 'len' | 'vel' | 'acc' — all share the same ft factor */
    return imperial ? siVal * FT : siVal;
  }
  function fromD(dispVal) { return imperial ? dispVal / FT : dispVal; }
  function uLen() { return imperial ? 'ft' : 'm'; }
  function uAcc() { return imperial ? 'ft/s²' : 'm/s²'; }

  /* drop-height range — 1 m … 10 km. The slider is LOG-scaled over the 4
     decades (slider units 0..1000) so the common 1–100 m band stays usable by
     drag; the stepper still types any exact value. */
  var MAX_H = 10000;
  var SLIDER_MAX = 1000;
  var LOG_MAX = Math.log(MAX_H) / Math.LN10;          /* = 4 */
  function niceHeight(h) {
    if (h < 50) return Math.round(h);
    if (h < 500) return Math.round(h / 5) * 5;
    if (h < 2000) return Math.round(h / 25) * 25;
    return Math.round(h / 100) * 100;
  }
  function sliderToHeight(u) {
    return niceHeight(Math.pow(10, (u / SLIDER_MAX) * LOG_MAX));
  }
  function heightToSlider(h) {
    h = Math.max(1, Math.min(MAX_H, h));
    return Math.round(SLIDER_MAX * (Math.log(h) / Math.LN10) / LOG_MAX);
  }

  /* playback speed — 'auto' or a number (×). Auto sizes tall drops to a few
     seconds of real time; readouts always show TRUE physical time. */
  var simSpeed = 'auto';
  var PLAYBACK_TARGET = 5;     /* aim: a drop takes ~this many real seconds */
  var autoSpeedVal = 1;        /* last computed Auto factor */
  var animating = false;
  var animTime = 0;
  var animFrame = null;
  var animStartTs = null;
  var totalFallTime = 0;
  var ready = false;        /* true once drawing constants are assigned (see INIT) */
  var dispW = 900;          /* current displayed canvas width (CSS px) */

  /* ball states */
  var ball1 = { y: 0, v: 0, s: 0, t: 0, trail: [], landed: false };
  var ball2 = { y: 0, v: 0, s: 0, t: 0, trail: [], landed: false }; /* heavy ball */
  var impactFlash = 0;
  var impactFlash2 = 0;

  /* graph data */
  var graphPoints = [];      /* [{t, s, v}] */

  /* practice */
  var practiceProblem = null, practiceScore = 0, practiceTotal = 0, practiceChecked = false;

  /* quiz */
  var quizQuestions = [], quizIdx = 0, quizScore = 0, quizAnswered = false;

  /* ================================================================
     CANVAS SETUP
     ================================================================ */
  /* HiDPI, aspect-locked. Backing store = displayed CSS width × DPR so text
     stays crisp on retina/mobile; logical drawing coords remain W×H. */
  function resizeCanvas() {
    var parent = cvs.parentElement;
    var cssW = (parent ? parent.clientWidth - 16 : 0) || cvs.getBoundingClientRect().width || W;
    if (cssW < 50) cssW = W;                /* guard against 0 at first paint */
    dispW = cssW;
    DPR = Math.max(1, Math.min(window.devicePixelRatio || 1, 3));
    cvs.width = Math.round(cssW * DPR);
    cvs.height = Math.round(cssW * (H / W) * DPR);
    ctx.setTransform(cvs.width / W, 0, 0, cvs.height / H, 0, 0);
    /* Skip drawing until the DRAWING-section constants are assigned (INIT
       sets ready=true). The first call here only sizes the backing store. */
    if (ready) draw();
  }
  resizeCanvas();
  if (window.ResizeObserver) {
    new ResizeObserver(function () { resizeCanvas(); }).observe(cvs.parentElement || cvs);
  } else {
    window.addEventListener('resize', resizeCanvas);
  }

  /* ================================================================
     DRAWING
     ================================================================ */
  var SCENE_LEFT = 50;
  var SCENE_WIDTH = 280;
  var GRAPH_LEFT = 380;
  var GRAPH_WIDTH = 480;
  var MARGIN_TOP = 40;
  var MARGIN_BOTTOM = 50;
  var sceneH = H - MARGIN_TOP - MARGIN_BOTTOM;

  function metresToPixel(m) {
    /* map 0..simHeight to sceneH..0 (top to bottom) */
    return MARGIN_TOP + (1 - m / Math.max(simHeight, 1)) * sceneH;
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);

    if (mode === 'simulate') {
      drawScene();
      drawGraphs();
    } else if (mode === 'explore') {
      drawExploreCanvas();
    } else {
      /* practice / quiz - show idle scene */
      drawIdleScene();
    }
  }

  var SCENE_RIGHT = SCENE_LEFT + SCENE_WIDTH + 30;

  /* Grounded studio background for the left scene column: vertical gradient +
     a soft accent spotlight behind the drop path. Clipped to the scene so it
     never washes over the graphs on the right. Reused by the idle scene. */
  function drawSceneBackground(rightEdge, glowX) {
    var bg = ctx.createLinearGradient(0, 0, 0, H);
    bg.addColorStop(0, '#0b0e17');
    bg.addColorStop(0.55, '#101422');
    bg.addColorStop(1, '#171c2a');
    ctx.fillStyle = bg;
    ctx.fillRect(0, 0, rightEdge, H);

    ctx.save();
    ctx.beginPath(); ctx.rect(0, 0, rightEdge, H); ctx.clip();
    var gy = MARGIN_TOP + sceneH * 0.4;
    var glow = ctx.createRadialGradient(glowX, gy, 18, glowX, gy, SCENE_WIDTH * 0.95);
    glow.addColorStop(0, 'rgba(124,77,255,0.13)');
    glow.addColorStop(1, 'rgba(124,77,255,0)');
    ctx.fillStyle = glow;
    ctx.fillRect(0, 0, rightEdge, H);
    ctx.restore();
  }

  /* Ground plane: a shaded band the ball lands on, with a bright front edge. */
  function drawGroundPlane(groundY) {
    var x0 = SCENE_LEFT - 12, w = SCENE_WIDTH + 24;
    ctx.save();
    var gp = ctx.createLinearGradient(0, groundY, 0, groundY + 16);
    gp.addColorStop(0, 'rgba(74,85,128,0.50)');
    gp.addColorStop(1, 'rgba(16,20,34,0)');
    ctx.fillStyle = gp;
    ctx.fillRect(x0, groundY, w, 16);
    /* faint receding hatch */
    ctx.strokeStyle = 'rgba(90,104,150,0.30)';
    ctx.lineWidth = 1;
    for (var hx = x0; hx < x0 + w; hx += 12) {
      ctx.beginPath();
      ctx.moveTo(hx, groundY);
      ctx.lineTo(hx - 6, groundY + 8);
      ctx.stroke();
    }
    /* bright front edge */
    ctx.strokeStyle = 'rgba(160,178,218,0.85)';
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(x0, groundY + 0.5);
    ctx.lineTo(x0 + w, groundY + 0.5);
    ctx.stroke();
    ctx.restore();
  }

  /* Soft contact shadow under a ball — tightens & darkens as it nears the
     ground (proximity = fraction of the drop completed). Grounds the ball and
     doubles as a depth/closing-in cue. */
  function drawContactShadow(x, groundY, ballR, proximity) {
    var t = Math.max(0, Math.min(1, proximity));
    var rx = ballR * (2.5 - 1.3 * t);
    var alpha = 0.12 + 0.32 * t;
    ctx.save();
    var sg = ctx.createRadialGradient(x, groundY + 3, 0, x, groundY + 3, rx);
    sg.addColorStop(0, 'rgba(0,0,0,' + alpha.toFixed(3) + ')');
    sg.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.fillStyle = sg;
    ctx.beginPath();
    ctx.ellipse(x, groundY + 3, rx, ballR * (0.55 - 0.22 * t), 0, 0, Math.PI * 2);
    ctx.fill();
    ctx.restore();
  }

  /* Vertical motion-blur streak trailing a falling ball; length grows with
     speed so acceleration is visible. Drawn behind the ball. */
  function drawVelocityStreak(x, y, ballR, v, hi) {
    var len = Math.min(64, v * 1.5);
    if (len < 8) return;
    ctx.save();
    var sg = ctx.createLinearGradient(0, y - len, 0, y);
    sg.addColorStop(0, 'rgba(124,77,255,0)');
    sg.addColorStop(1, hi);
    ctx.fillStyle = sg;
    ctx.globalAlpha = 0.4;
    ctx.beginPath();
    ctx.moveTo(x - ballR * 0.55, y);
    ctx.lineTo(x - ballR * 0.12, y - len);
    ctx.lineTo(x + ballR * 0.12, y - len);
    ctx.lineTo(x + ballR * 0.55, y);
    ctx.closePath();
    ctx.fill();
    ctx.restore();
  }

  function drawScene() {
    var groundY = MARGIN_TOP + sceneH;

    /* grounded background + spotlight (behind the active drop column) */
    var colX = SCENE_LEFT + SCENE_WIDTH * (multiBall ? 0.45 : 0.4);
    drawSceneBackground(SCENE_RIGHT, colX);

    /* separator line */
    ctx.strokeStyle = '#2a3050';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(SCENE_LEFT + SCENE_WIDTH + 40, 10);
    ctx.lineTo(SCENE_LEFT + SCENE_WIDTH + 40, H - 10);
    ctx.stroke();

    /* ground plane */
    drawGroundPlane(groundY);

    /* ruler / scale on left */
    drawRuler(groundY);

    /* drop height indicator (dashed line at top) */
    var topY = metresToPixel(simHeight);
    ctx.setLineDash([4, 4]);
    ctx.strokeStyle = 'rgba(124,77,255,0.4)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(SCENE_LEFT, topY);
    ctx.lineTo(SCENE_LEFT + SCENE_WIDTH, topY);
    ctx.stroke();
    ctx.setLineDash([]);

    /* height label */
    ctx.font = '11px Segoe UI, sans-serif';
    ctx.fillStyle = '#b388ff';
    ctx.textAlign = 'center';
    ctx.fillText(toD(simHeight).toFixed(imperial ? 1 : 0) + ' ' + uLen(), SCENE_LEFT + SCENE_WIDTH / 2, topY - 8);

    /* ball 1 trail (afterimages) */
    drawTrail(ball1.trail, '#7c4dff', SCENE_LEFT + SCENE_WIDTH * 0.4);

    /* ball 1 */
    var ball1Y = metresToPixel(simHeight - ball1.s);
    var ball1X = SCENE_LEFT + SCENE_WIDTH * 0.4;
    if (multiBall) ball1X = SCENE_LEFT + SCENE_WIDTH * 0.3;

    /* contact shadow + speed streak (behind the ball) */
    drawContactShadow(ball1X, groundY, 14, ball1.s / Math.max(simHeight, 1));
    if (animating && !ball1.landed) drawVelocityStreak(ball1X, ball1Y, 14, ball1.v, 'rgba(179,136,255,0.45)');

    /* impact flash for ball 1 */
    if (impactFlash > 0) {
      ctx.save();
      ctx.globalAlpha = impactFlash;
      var flashGrad = ctx.createRadialGradient(ball1X, groundY, 0, ball1X, groundY, 40 * impactFlash);
      flashGrad.addColorStop(0, 'rgba(124,77,255,0.8)');
      flashGrad.addColorStop(0.5, 'rgba(124,77,255,0.3)');
      flashGrad.addColorStop(1, 'rgba(124,77,255,0)');
      ctx.fillStyle = flashGrad;
      ctx.beginPath();
      ctx.arc(ball1X, groundY, 40, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }

    /* draw ball 1 */
    drawBall(ball1X, ball1Y, 14, '#7c4dff', '#b388ff');

    /* ball label */
    if (multiBall) {
      ctx.font = '10px Segoe UI, sans-serif';
      ctx.fillStyle = '#b388ff';
      ctx.textAlign = 'center';
      ctx.fillText('1 kg', ball1X, ball1Y + 24);
    }

    /* ball 2 (multi-ball mode) */
    if (multiBall) {
      var ball2X = SCENE_LEFT + SCENE_WIDTH * 0.6;
      var ball2Y = metresToPixel(simHeight - ball2.s);

      drawTrail(ball2.trail, '#f5c842', ball2X);

      /* contact shadow + speed streak */
      drawContactShadow(ball2X, groundY, 20, ball2.s / Math.max(simHeight, 1));
      if (animating && !ball2.landed) drawVelocityStreak(ball2X, ball2Y, 20, ball2.v, 'rgba(245,225,130,0.45)');

      /* impact flash for ball 2 */
      if (impactFlash2 > 0) {
        ctx.save();
        ctx.globalAlpha = impactFlash2;
        var flashGrad2 = ctx.createRadialGradient(ball2X, groundY, 0, ball2X, groundY, 40 * impactFlash2);
        flashGrad2.addColorStop(0, 'rgba(245,200,66,0.8)');
        flashGrad2.addColorStop(0.5, 'rgba(245,200,66,0.3)');
        flashGrad2.addColorStop(1, 'rgba(245,200,66,0)');
        ctx.fillStyle = flashGrad2;
        ctx.beginPath();
        ctx.arc(ball2X, groundY, 40, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      }

      drawBall(ball2X, ball2Y, 20, '#f5c842', '#fff176');

      ctx.font = '10px Segoe UI, sans-serif';
      ctx.fillStyle = '#f5c842';
      ctx.textAlign = 'center';
      ctx.fillText('10 kg', ball2X, ball2Y + 30);
    }

    /* stopwatch display */
    drawStopwatch();

    /* time-compression indicator (below the stopwatch) */
    var sp = effectiveSpeed();
    if (sp > 1) {
      ctx.font = 'bold 10px Segoe UI, sans-serif';
      ctx.fillStyle = '#f5c842';
      ctx.textAlign = 'center';
      ctx.fillText('▶ ' + sp + '× time', SCENE_LEFT + SCENE_WIDTH - 30, MARGIN_TOP + 64);
    }

    /* on-canvas classical equation with rolling output (Pattern 3) */
    drawCanvasEquation(groundY);
  }

  function drawHaloText(txt, x, y, color, font) {
    ctx.font = font || 'bold 12px Courier New';
    ctx.lineJoin = 'round';
    ctx.lineWidth = 3.5;
    ctx.strokeStyle = 'rgba(13,17,23,0.88)';
    ctx.strokeText(txt, x, y);
    ctx.fillStyle = color;
    ctx.fillText(txt, x, y);
  }

  function drawCanvasEquation(groundY) {
    if (!showEq) return;
    /* On a narrow canvas the fixed-size Drop/Reset buttons rise into this
       band; hide the (redundant) overlay there — the formula row and Live
       Equations panel below cover it. */
    if (dispW < 560) return;
    /* Sit just ABOVE the ground line, centered in the scene column. The
       Drop/Reset floating buttons live in the bottom-left corner (below the
       ground line), so this vertical offset keeps the two clear of each other. */
    var cx = SCENE_LEFT + SCENE_WIDTH / 2;
    var y1 = groundY - 42, y2 = groundY - 24;
    ctx.textAlign = 'center';
    ctx.textBaseline = 'alphabetic';
    drawHaloText('s = \u00BDg\u00B7t\u00B2 = ' + toD(ball1.s).toFixed(2) + ' ' + uLen(), cx, y1, '#b388ff');
    drawHaloText('v = g\u00B7t = ' + toD(ball1.v).toFixed(2) + ' ' + uVel0(), cx, y2, '#3ddc84');
  }

  function drawBall(x, y, r, color, highlight) {
    /* glow */
    ctx.save();
    ctx.shadowColor = color;
    ctx.shadowBlur = 18;

    /* ball gradient */
    var ballGrad = ctx.createRadialGradient(x - r * 0.3, y - r * 0.3, r * 0.1, x, y, r);
    ballGrad.addColorStop(0, highlight);
    ballGrad.addColorStop(0.6, color);
    ballGrad.addColorStop(1, '#1a0a3e');
    ctx.fillStyle = ballGrad;
    ctx.beginPath();
    ctx.arc(x, y, r, 0, Math.PI * 2);
    ctx.fill();
    ctx.restore();

    /* specular highlight */
    ctx.fillStyle = 'rgba(255,255,255,0.25)';
    ctx.beginPath();
    ctx.arc(x - r * 0.25, y - r * 0.25, r * 0.35, 0, Math.PI * 2);
    ctx.fill();
  }

  function drawTrail(trail, color, xPos) {
    for (var i = 0; i < trail.length; i++) {
      var pt = trail[i];
      var alpha = 0.08 + 0.15 * (i / trail.length);
      var py = metresToPixel(simHeight - pt.s);
      ctx.globalAlpha = alpha;
      ctx.fillStyle = color;
      ctx.beginPath();
      ctx.arc(xPos, py, 10, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.globalAlpha = 1;
  }

  function drawRuler(groundY) {
    var topY = metresToPixel(simHeight);
    var rulerX = SCENE_LEFT - 5;

    /* ruler line */
    ctx.strokeStyle = '#6b7a99';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(rulerX, topY);
    ctx.lineTo(rulerX, groundY);
    ctx.stroke();

    /* tick marks — adaptive ~8 nice ticks in display units across the full
       1 m … 10 km range; positions map back to physical metres. */
    var maxD = toD(simHeight);
    var step = niceTick(maxD);
    ctx.font = '9px Courier New';
    ctx.fillStyle = '#6b7a99';
    ctx.textAlign = 'right';

    for (var d = 0; d <= maxD + step * 0.001; d += step) {
      var ty = metresToPixel(fromD(d));
      ctx.beginPath();
      ctx.moveTo(rulerX - 4, ty);
      ctx.lineTo(rulerX, ty);
      ctx.stroke();
      ctx.fillText(fmtTick(d), rulerX - 7, ty + 3);
    }
  }

  function niceTick(range) {
    if (range <= 0) return 1;
    var raw = range / 8;
    var mag = Math.pow(10, Math.floor(Math.log(raw) / Math.LN10));
    var n = raw / mag;
    return (n <= 1 ? 1 : n <= 2 ? 2 : n <= 5 ? 5 : 10) * mag;
  }
  function fmtTick(d) {
    if (d >= 1000) return (d / 1000) + 'k';
    return (d % 1 === 0) ? String(d) : d.toFixed(1);
  }

  function drawStopwatch() {
    var cx = SCENE_LEFT + SCENE_WIDTH - 30;
    var cy = MARGIN_TOP + 25;

    /* background circle */
    ctx.fillStyle = 'rgba(22,27,39,0.85)';
    ctx.strokeStyle = '#2a3050';
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.arc(cx, cy, 28, 0, Math.PI * 2);
    ctx.fill();
    ctx.stroke();

    /* time text */
    ctx.font = 'bold 13px Courier New';
    ctx.fillStyle = '#7c4dff';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(ball1.t.toFixed(2), cx, cy - 2);

    ctx.font = '8px Segoe UI, sans-serif';
    ctx.fillStyle = '#6b7a99';
    ctx.fillText('sec', cx, cy + 13);
    ctx.textBaseline = 'alphabetic';
  }

  function drawGraphs() {
    /* draw two stacked graphs: distance vs time (top), velocity vs time (bottom) */
    var gTop = 30;
    var gH = (H - 80) / 2 - 10;
    var gW = GRAPH_WIDTH - 40;
    var gLeft = GRAPH_LEFT + 55;

    /* --- Distance vs Time graph --- */
    drawGraphBox(gLeft, gTop, gW, gH, 'Distance vs Time', 's (m)', 't (s)');
    drawDistanceGraph(gLeft, gTop, gW, gH);

    /* --- Velocity vs Time graph --- */
    var g2Top = gTop + gH + 40;
    drawGraphBox(gLeft, g2Top, gW, gH, 'Velocity vs Time', 'v (m/s)', 't (s)');
