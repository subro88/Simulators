     ================================================================ */
  function startQuiz() {
    /* pick 5 random from pool */
    var pool = QUIZ_POOL.slice();
    quizQuestions = [];
    while (quizQuestions.length < 5 && pool.length > 0) {
      var idx = randInt(0, pool.length - 1);
      quizQuestions.push(pool.splice(idx, 1)[0]);
    }
    quizIdx = 0;
    quizScore = 0;
    quizAnswered = false;
    quizResult.style.display = 'none';
    quizPanel.style.display = '';
    quizBar.style.display = '';
    showQuizQuestion();
  }

  function showQuizQuestion() {
    var q = quizQuestions[quizIdx];
    qbarNum.textContent = quizIdx + 1;
    quizAnswered = false;

    var html = '<p class="qp-prompt">' + q.q + '</p>';
    html += '<div class="answer-grid">';
    q.opts.forEach(function (opt, i) {
      html += '<button class="answer-btn" data-idx="' + i + '">' + opt + '</button>';
    });
    html += '</div>';
    html += '<div style="display:flex;align-items:center;gap:10px;margin-top:12px;">';
    html += '<span class="quiz-feedback" id="q-feedback"></span>';
    html += '<button class="btn btn-primary" id="q-next" style="display:none;margin-left:auto;">Next \u2192</button>';
    html += '</div>';
    quizPanel.innerHTML = html;

    /* event listeners */
    quizPanel.querySelectorAll('.answer-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (quizAnswered) return;
        submitQuizAnswer(+btn.dataset.idx);
      });
    });
  }

  function submitQuizAnswer(idx) {
    quizAnswered = true;
    var q = quizQuestions[quizIdx];
    var btns = quizPanel.querySelectorAll('.answer-btn');
    var fb = quizPanel.querySelector('#q-feedback');
    var nextBtn = quizPanel.querySelector('#q-next');

    btns.forEach(function (btn) {
      var bi = +btn.dataset.idx;
      btn.classList.add('locked');
      if (bi === q.correct) btn.classList.add('correct');
      if (bi === idx && idx !== q.correct) btn.classList.add('wrong');
    });

    if (idx === q.correct) {
      quizScore++;
      fb.textContent = 'Correct!';
      fb.className = 'quiz-feedback ok';
    } else {
      fb.textContent = 'Incorrect. Answer: ' + q.opts[q.correct];
      fb.className = 'quiz-feedback err';
    }

    /* store user answer for result display */
    q.userAnswer = idx;

    nextBtn.style.display = '';
    nextBtn.addEventListener('click', function () {
      quizIdx++;
      if (quizIdx < 5) {
        showQuizQuestion();
      } else {
        showQuizResult();
      }
    });
  }

  function showQuizResult() {
    quizPanel.style.display = 'none';
    quizBar.style.display = 'none';
    quizResult.style.display = '';

    var sc = quizScore;
    var scoreClass = sc === 5 ? 'perfect' : sc >= 3 ? 'good' : 'poor';
    var stars = sc === 5 ? '\u2605\u2605\u2605' : sc >= 3 ? '\u2605\u2605' : '\u2605';
    var verdict = sc === 5 ? 'Perfect!' : sc >= 3 ? 'Good job!' : 'Keep practicing!';

    var html = '<div class="qr-header">';
    html += '<div class="qr-title-wrap"><span class="qr-title">Quiz Complete</span><span class="qr-stars">' + stars + '</span></div>';
    html += '<div class="qr-score-wrap"><span class="qr-score ' + scoreClass + '">' + sc + '/5</span><span class="qr-verdict">' + verdict + '</span></div>';
    html += '</div>';

    html += '<div class="qr-rows">';
    quizQuestions.forEach(function (q, i) {
      var isOk = q.userAnswer === q.correct;
      html += '<div class="qr-row ' + (isOk ? 'ok' : 'err') + '">';
      html += '<span class="qr-qnum">Q' + (i + 1) + '</span>';
      html += '<span class="qr-detail"><strong>' + q.opts[q.correct] + '</strong>';
      if (!isOk) html += ' (you: ' + q.opts[q.userAnswer] + ')';
      html += '</span>';
      html += '<span class="qr-mark">' + (isOk ? '\u2713' : '\u2717') + '</span>';
      html += '</div>';
    });
    html += '</div>';

    html += '<button class="btn btn-primary" id="btn-new-quiz">New Quiz</button>';
    quizResult.innerHTML = html;

    document.getElementById('btn-new-quiz').addEventListener('click', function () {
      quizResult.style.display = 'none';
      startQuiz();
    });
  }

  /* ================================================================
     LEARNING PANELS — Live Equations (KaTeX) + What-if coach
     latex-auto.js observes #lp-eq-body & #calc-modal-body and renders.
     ================================================================ */
  function fmt(n, d) { return (+n).toFixed(d == null ? 2 : d); }
  var _eqCache = '', _coachCache = '';

  function updateLearnPanels() {
    if (!lpEqBody) return;
    var h = simHeight, g = simG;
    var tFall = Math.sqrt(2 * h / g);
    var vImp = Math.sqrt(2 * g * h);
    var L = uLen(), V = uVel0();
    var hD = fmt(toD(h)), gD = fmt(toD(g)), tD = fmt(tFall), vD = fmt(toD(vImp));
    var html =
      '<div class="eq-line">\\[ t=\\sqrt{\\dfrac{2h}{g}}=\\sqrt{\\dfrac{2(' + hD + ')}{' + gD + '}}=' + tD + '\\ \\text{s} \\]</div>' +
      '<div class="eq-line">\\[ v=g\\,t=' + gD + '\\times' + tD + '=' + vD + '\\ \\text{' + V + '} \\]</div>' +
      '<div class="eq-line">\\[ v=\\sqrt{2gh}=\\sqrt{2(' + gD + ')(' + hD + ')}=' + vD + '\\ \\text{' + V + '} \\]</div>' +
      '<div class="eq-line">\\[ s=\\tfrac{1}{2}g\\,t^{2}\\ \\Rightarrow\\ h=' + hD + '\\ \\text{' + L + '} \\]</div>';
    if (html !== _eqCache) { _eqCache = html; lpEqBody.innerHTML = html; }
    updateCoach(h, g, tFall, vImp);
  }

  function updateCoach(h, g, tFall, vImp) {
    if (!lpCoachBody) return;
    var items = [];
    var tEarth = Math.sqrt(2 * h / 9.81);
    if (Math.abs(g - 9.81) > 0.05) {
      var ratio = tFall / tEarth;
      items.push('On <strong>' + simPlanet + '</strong> (g = ' + fmt(g) + ' m/s²) the same drop takes <strong>' +
        fmt(ratio) + '×</strong> ' + (ratio > 1 ? 'longer' : 'shorter') + ' than on Earth.');
    } else {
      items.push('At <strong>' + fmt(toD(h)) + ' ' + uLen() + '</strong> the ball hits the ground in <strong>' +
        fmt(tFall) + ' s</strong> with impact speed <strong>' + fmt(toD(vImp)) + ' ' + uVel0() + '</strong>.');
    }
    items.push('Double the height to <strong>' + fmt(toD(h * 2)) + ' ' + uLen() +
      '</strong> and the fall time only grows by √2 (×1.41), not ×2 — because s ∝ t².');
    if (airRes) {
      items.push('<strong>Air resistance is ON:</strong> drag grows with v² until it balances weight, so the ball approaches a constant <strong>terminal velocity</strong> instead of v = gt.');
    } else if (multiBall) {
      items.push('<strong>Two balls, no air:</strong> mass cancels out of t = √(2h/g), so both land together — Galileo’s result.');
    } else {
      items.push('In a vacuum, mass never appears in t = √(2h/g) — a feather and a hammer would land together.');
    }
    var html = items.map(function (t) { return '<div class="coach-item"><span>▸</span><span>' + t + '</span></div>'; }).join('');
    if (html !== _coachCache) { _coachCache = html; lpCoachBody.innerHTML = html; }
  }

