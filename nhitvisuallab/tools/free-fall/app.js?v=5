  var calcModal = $('calc-modal'), calcBody = $('calc-modal-body'), calcClose = $('calc-modal-close');
  var ctxMenu = $('ctx-menu');
  var hintBar = $('hint-bar'), hintClose = $('hint-close');
  var lpEqBody = $('lp-eq-body'), lpCoachBody = $('lp-coach-body');
