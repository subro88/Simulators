    for (var i = 0; i <= steps; i++) {
      var tt = (i / steps) * maxT;
      var ss = 0.5 * simG * tt * tt;
      if (ss > simHeight) ss = simHeight;
      var px = gx + (tt / maxT) * gw;
      var py = gy + gh - (ss / maxS) * gh;
      if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
    }
    ctx.stroke();
    ctx.setLineDash([]);

    /* label */
