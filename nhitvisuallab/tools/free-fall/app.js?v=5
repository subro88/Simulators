  function drawDistanceGraph(gx, gy, gw, gh) {
    if (graphPoints.length < 2) {
      /* draw theoretical curve (light) */
      drawTheoreticalDistanceCurve(gx, gy, gw, gh);
      return;
    }
    var maxT = totalFallTime > 0 ? totalFallTime * 1.1 : graphPoints[graphPoints.length - 1].t * 1.1;
    var maxS = simHeight * 1.05;
    if (maxT < 0.1) maxT = 1;

    /* grid lines */
    drawGridLines(gx, gy, gw, gh, maxT, maxS);

    /* theoretical curve (dashed) */
    ctx.setLineDash([4, 3]);
    ctx.strokeStyle = 'rgba(124,77,255,0.25)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    var steps = 60;
    for (var i = 0; i <= steps; i++) {
      var tt = (i / steps) * maxT;
      var ss = 0.5 * simG * tt * tt;
      if (ss > simHeight) ss = simHeight;
      var px = gx + (tt / maxT) * gw;
      var py = gy + gh - (ss / maxS) * gh;
      if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
    }
    ctx.stroke();
    ctx.setLineDash([]);

    /* actual data */
    ctx.strokeStyle = '#7c4dff';
    ctx.lineWidth = 2;
    ctx.beginPath();
    for (var j = 0; j < graphPoints.length; j++) {
      var p = graphPoints[j];
      var ppx = gx + (p.t / maxT) * gw;
      var ppy = gy + gh - (p.s / maxS) * gh;
      if (j === 0) ctx.moveTo(ppx, ppy); else ctx.lineTo(ppx, ppy);
    }
    ctx.stroke();

    /* current point dot */
    if (graphPoints.length > 0) {
      var last = graphPoints[graphPoints.length - 1];
      var dotX = gx + (last.t / maxT) * gw;
      var dotY = gy + gh - (last.s / maxS) * gh;
      ctx.fillStyle = '#b388ff';
      ctx.beginPath();
      ctx.arc(dotX, dotY, 4, 0, Math.PI * 2);
      ctx.fill();
    }
  }

  function drawVelocityGraph(gx, gy, gw, gh) {
    if (graphPoints.length < 2) {
      drawTheoreticalVelocityCurve(gx, gy, gw, gh);
      return;
    }
    var maxT = totalFallTime > 0 ? totalFallTime * 1.1 : graphPoints[graphPoints.length - 1].t * 1.1;
    var maxV = Math.sqrt(2 * simG * simHeight) * 1.15;
    if (airRes) {
      /* find max v from data */
      var dataMaxV = 0;
      for (var k = 0; k < graphPoints.length; k++) {
        if (graphPoints[k].v > dataMaxV) dataMaxV = graphPoints[k].v;
      }
      maxV = Math.max(maxV, dataMaxV * 1.15);
    }
    if (maxT < 0.1) maxT = 1;
    if (maxV < 1) maxV = 10;

    /* grid */
    drawGridLines(gx, gy, gw, gh, maxT, maxV);

    /* theoretical line (dashed) */
    ctx.setLineDash([4, 3]);
    ctx.strokeStyle = 'rgba(124,77,255,0.25)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    var tMax = Math.sqrt(2 * simHeight / simG);
    var stepsV = 60;
    for (var i = 0; i <= stepsV; i++) {
      var tt = (i / stepsV) * maxT;
      var vv = simG * tt;
      if (tt > tMax) vv = simG * tMax;
      var px = gx + (tt / maxT) * gw;
      var py = gy + gh - (vv / maxV) * gh;
      if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
    }
    ctx.stroke();
    ctx.setLineDash([]);

    /* actual data */
    ctx.strokeStyle = '#3ddc84';
    ctx.lineWidth = 2;
    ctx.beginPath();
    for (var j = 0; j < graphPoints.length; j++) {
      var p = graphPoints[j];
      var ppx = gx + (p.t / maxT) * gw;
      var ppy = gy + gh - (p.v / maxV) * gh;
      if (j === 0) ctx.moveTo(ppx, ppy); else ctx.lineTo(ppx, ppy);
    }
    ctx.stroke();

    /* current point dot */
    if (graphPoints.length > 0) {
      var last = graphPoints[graphPoints.length - 1];
      var dotX = gx + (last.t / maxT) * gw;
      var dotY = gy + gh - (last.v / maxV) * gh;
      ctx.fillStyle = '#3ddc84';
      ctx.beginPath();
      ctx.arc(dotX, dotY, 4, 0, Math.PI * 2);
      ctx.fill();
    }

    /* terminal velocity label if air resistance */
    if (airRes && graphPoints.length > 10) {
      var lastPt = graphPoints[graphPoints.length - 1];
      if (lastPt.v > 0) {
        var tvY = gy + gh - (lastPt.v / maxV) * gh;
        ctx.setLineDash([3, 3]);
        ctx.strokeStyle = 'rgba(255,85,85,0.5)';
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(gx, tvY);
        ctx.lineTo(gx + gw, tvY);
        ctx.stroke();
        ctx.setLineDash([]);

        ctx.font = '9px Segoe UI, sans-serif';
        ctx.fillStyle = '#ff5555';
        ctx.textAlign = 'right';
        ctx.fillText('v_t \u2248 ' + lastPt.v.toFixed(1) + ' m/s', gx + gw - 5, tvY - 5);
      }
    }
  }

  function drawGridLines(gx, gy, gw, gh, maxX, maxY) {
    ctx.strokeStyle = 'rgba(42,48,80,0.4)';
    ctx.lineWidth = 0.5;
    ctx.font = '8px Courier New';
    ctx.fillStyle = '#4a5580';

    /* horizontal grid */
    var ySteps = 4;
    for (var i = 1; i <= ySteps; i++) {
      var yy = gy + gh - (i / ySteps) * gh;
      if (showGrid) {
        ctx.beginPath();
        ctx.moveTo(gx, yy);
        ctx.lineTo(gx + gw, yy);
        ctx.stroke();
      }
      ctx.textAlign = 'right';
      ctx.fillText((maxY * i / ySteps).toFixed(1), gx - 4, yy + 3);
    }

    /* vertical grid */
    var xSteps = 4;
    for (var j = 1; j <= xSteps; j++) {
      var xx = gx + (j / xSteps) * gw;
      if (showGrid) {
        ctx.beginPath();
        ctx.moveTo(xx, gy);
        ctx.lineTo(xx, gy + gh);
        ctx.stroke();
      }
      ctx.textAlign = 'center';
      ctx.fillText((maxX * j / xSteps).toFixed(1), xx, gy + gh + 12);
    }

    /* origin labels */
    ctx.textAlign = 'right';
    ctx.fillText('0', gx - 4, gy + gh + 3);
    ctx.textAlign = 'center';
    ctx.fillText('0', gx, gy + gh + 12);
  }

  function drawTheoreticalDistanceCurve(gx, gy, gw, gh) {
