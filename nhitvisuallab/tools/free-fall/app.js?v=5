  /* ================================================================
     EXPORT — CSV (time history) + PNG (watermarked canvas)
     ================================================================ */
  function downloadBlob(data, mime, name) {
    var blob = new Blob([data], { type: mime });
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url; a.download = name;
    document.body.appendChild(a); a.click();
    document.body.removeChild(a);
    setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
  }

  function exportCSV() {
    var rows = [];
    var L = uLen(), V = uVel0();
    rows.push('# MechSimulator — Free Fall Simulator');
    rows.push('# Planet: ' + simPlanet + ', g = ' + fmt(toD(simG)) + ' ' + uAcc() +
      ', height = ' + fmt(toD(simHeight)) + ' ' + L + ', air resistance = ' + (airRes ? 'ON' : 'OFF'));
    rows.push('t (s),s (' + L + '),v (' + V + ')');
    var src = graphPoints.length > 1 ? graphPoints : null;
    if (src) {
      for (var i = 0; i < src.length; i++) {
        rows.push(fmt(src[i].t, 3) + ',' + fmt(toD(src[i].s), 3) + ',' + fmt(toD(src[i].v), 3));
      }
    } else {
      /* theoretical drag-free sweep */
      var tFall = Math.sqrt(2 * simHeight / simG);
      var N = 50;
      for (var k = 0; k <= N; k++) {
        var t = (k / N) * tFall;
        var s = 0.5 * simG * t * t;
        var v = simG * t;
        rows.push(fmt(t, 3) + ',' + fmt(toD(s), 3) + ',' + fmt(toD(v), 3));
      }
    }
    downloadBlob(rows.join('\n'), 'text/csv', 'free-fall-' + simPlanet.toLowerCase() + '.csv');
  }

  function exportPNG() {
    var out = document.createElement('canvas');
    out.width = cvs.width; out.height = cvs.height;
    var octx = out.getContext('2d');
    octx.fillStyle = '#0d1117';
    octx.fillRect(0, 0, out.width, out.height);
    octx.drawImage(cvs, 0, 0);
    /* watermark */
    octx.font = 'bold ' + Math.round(out.width * 0.018) + 'px Segoe UI, sans-serif';
    octx.fillStyle = 'rgba(179,136,255,0.7)';
    octx.textAlign = 'right';
    octx.fillText('mechsimulator.com — Free Fall', out.width - 14, out.height - 12);
    out.toBlob(function (blob) {
      var url = URL.createObjectURL(blob);
      var a = document.createElement('a');
      a.href = url; a.download = 'free-fall-' + simPlanet.toLowerCase() + '.png';
      document.body.appendChild(a); a.click(); document.body.removeChild(a);
      setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
    });
  }

  if (btnCsv) btnCsv.addEventListener('click', exportCSV);
  if (btnPng) btnPng.addEventListener('click', exportPNG);

  /* ================================================================
     RIGHT-CLICK CONTEXT MENU (on the simulation canvas)
     ================================================================ */
  function buildCtxMenu(items) {
    ctxMenu.innerHTML = '';
    items.forEach(function (it) {
      if (it.sep) { var s = document.createElement('div'); s.className = 'ctx-sep'; ctxMenu.appendChild(s); return; }
      var d = document.createElement('div');
      d.className = 'ctx-item'; d.textContent = it.label;
      d.addEventListener('click', function () { hideCtxMenu(); it.fn(); });
      ctxMenu.appendChild(d);
    });
  }
  function showCtxMenu(x, y) {
    ctxMenu.classList.add('active');
    var mw = ctxMenu.offsetWidth || 190, mh = ctxMenu.offsetHeight || 200;
    ctxMenu.style.left = Math.min(x, window.innerWidth - mw - 8) + 'px';
    ctxMenu.style.top = Math.min(y, window.innerHeight - mh - 8) + 'px';
  }
  function hideCtxMenu() { if (ctxMenu) ctxMenu.classList.remove('active'); }

  if (cvs) cvs.addEventListener('contextmenu', function (e) {
    if (mode !== 'simulate' && mode !== 'explore') return;
    e.preventDefault();
    var vImp = Math.sqrt(2 * simG * simHeight);
    buildCtxMenu([
      { label: '▶ Drop', fn: startDrop },
      { label: '↺ Reset', fn: resetSim },
      { sep: true },
      { label: 'Copy impact velocity', fn: function () {
          var txt = fmt(toD(vImp)) + ' ' + uVel0();
          if (navigator.clipboard) navigator.clipboard.writeText(txt);
        } },
      { label: 'Export CSV', fn: exportCSV },
      { label: 'Export PNG', fn: exportPNG },
      { sep: true },
      { label: (showGrid ? '✓ ' : '') + 'Graph grid', fn: function () {
          showGrid = !showGrid; chkGrid.checked = showGrid;
          chkGrid.parentElement.classList.toggle('checked', showGrid); draw();
        } },
      { label: (showEq ? '✓ ' : '') + 'Canvas equation', fn: function () {
          showEq = !showEq; chkEq.checked = showEq;
          chkEq.parentElement.classList.toggle('checked', showEq); draw();
        } }
    ]);
    showCtxMenu(e.clientX, e.clientY);
  });
  document.addEventListener('click', function (e) { if (ctxMenu && !ctxMenu.contains(e.target)) hideCtxMenu(); });
  window.addEventListener('blur', hideCtxMenu);

  /* ================================================================
     SOUND — procedural impact thud (Web Audio, no external files)
     ================================================================ */
  var audioCtx = null;
  function ensureAudio() {
    if (!audioCtx && (window.AudioContext || window.webkitAudioContext)) {
      audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    }
    return audioCtx;
  }
  document.addEventListener('pointerdown', function once() { ensureAudio(); document.removeEventListener('pointerdown', once); }, { once: true });

  function playThud(intensity) {
    var ac = ensureAudio();
    if (!ac) return;
    var now = ac.currentTime;
    var vol = Math.max(0.05, Math.min(0.5, intensity || 0.3));
    /* low sine thump */
    var osc = ac.createOscillator(), g1 = ac.createGain();
    osc.type = 'sine';
    osc.frequency.setValueAtTime(150, now);
    osc.frequency.exponentialRampToValueAtTime(55, now + 0.18);
    g1.gain.setValueAtTime(vol, now);
    g1.gain.exponentialRampToValueAtTime(0.0001, now + 0.22);
    osc.connect(g1).connect(ac.destination);
    osc.start(now); osc.stop(now + 0.24);
    /* short noise burst */
    var len = Math.floor(ac.sampleRate * 0.08);
    var buf = ac.createBuffer(1, len, ac.sampleRate);
    var ch = buf.getChannelData(0);
    for (var i = 0; i < len; i++) ch[i] = (Math.random() * 2 - 1) * (1 - i / len);
    var noise = ac.createBufferSource(); noise.buffer = buf;
    var g2 = ac.createGain(); g2.gain.setValueAtTime(vol * 0.5, now);
    g2.gain.exponentialRampToValueAtTime(0.0001, now + 0.09);
    noise.connect(g2).connect(ac.destination);
    noise.start(now); noise.stop(now + 0.09);
  }

  /* ================================================================
     FIRST-TIME HINT
     ================================================================ */
  function initHint() {
    if (!hintBar) return;
    var dismissed = false;
    try { dismissed = localStorage.getItem('ff-hint-dismissed') === '1'; } catch (e) {}
    if (!dismissed) hintBar.style.display = '';
    if (hintClose) hintClose.addEventListener('click', function () {
      hintBar.style.display = 'none';
      try { localStorage.setItem('ff-hint-dismissed', '1'); } catch (e) {}
    });
  }

  /* ================================================================
     KEYBOARD SHORTCUTS
     ================================================================ */
  document.addEventListener('keydown', function (e) {
    var tag = (e.target.tagName || '').toLowerCase();
    if (tag === 'input' || tag === 'textarea' || tag === 'select') return;
    if (mode !== 'simulate') return;
    if (e.key === ' ' || e.code === 'Space') { e.preventDefault(); startDrop(); }
    else if (e.key === 'r' || e.key === 'R') { resetSim(); }
  });

  /* ================================================================
     INIT
     ================================================================ */
  ready = true;             /* drawing constants are now all assigned */
  resizeCanvas();           /* size backing store to actual width + first paint */
  syncUnitUI();
  wireLearnPanels();
  initHint();
  refreshAutoSpeed();
  updateReadoutsStatic();
  draw();

})();
