    var cards = Array.prototype.slice.call(document.querySelectorAll('.learn-card'));
    if (expAll) expAll.addEventListener('click', function () { cards.forEach(function (c) { c.open = true; }); });
    if (colAll) colAll.addEventListener('click', function () { cards.forEach(function (c) { c.open = false; }); });
  }

  /* ================================================================
     SHOW-CALCULATIONS MODAL (Pattern 2)
     ================================================================ */
  function buildCalcSteps() {
    var h = simHeight, g = simG;
    var tFall = Math.sqrt(2 * h / g);
    var vImp = Math.sqrt(2 * g * h);
    var L = uLen(), V = uVel0();
    var hD = fmt(toD(h)), gD = fmt(toD(g)), tD = fmt(tFall), vD = fmt(toD(vImp));
    var keImp = 0.5 * 1 * vImp * vImp; /* per kg basis shown symbolically */

    var html = '';
    html += '<div class="cs-inputs"><span class="cs-badge">Current State</span>' +
      '<div class="cs-given"><span>h = ' + hD + ' ' + L + '</span><span>g = ' + gD + ' ' + uAcc() + '</span>' +
      '<span>Planet: ' + simPlanet + '</span><span>Air resistance: ' + (airRes ? 'ON' : 'OFF') + '</span></div>' +
      '<p class="cs-si-note">Object released from rest (u = 0). ' +
      (airRes ? 'Drag-free equations shown for reference; with air resistance the real impact speed is lower.' : 'Vacuum / drag-free assumption.') +
      '</p></div>';

    html += '<div class="cs-step"><div class="cs-step-hd"><span class="cs-num">Step 1</span>' +
      '<span class="cs-title">Time to reach the ground</span></div>' +
      '<div class="cs-formula">\\( t = \\sqrt{2h/g} \\)</div>' +
      '<div class="cs-calc">\\( t = \\sqrt{\\dfrac{2(' + hD + ')}{' + gD + '}} \\)</div>' +
      '<div class="cs-result">\\( t = ' + tD + '\\ \\text{s} \\)</div></div>';

    html += '<div class="cs-step"><div class="cs-step-hd"><span class="cs-num">Step 2</span>' +
      '<span class="cs-title">Velocity at impact</span></div>' +
      '<div class="cs-formula">\\( v = g\\,t = \\sqrt{2gh} \\)</div>' +
      '<div class="cs-calc">\\( v = ' + gD + '\\times' + tD + ' = \\sqrt{2(' + gD + ')(' + hD + ')} \\)</div>' +
      '<div class="cs-result">\\( v = ' + vD + '\\ \\text{' + V + '} \\)</div></div>';

    html += '<div class="cs-step"><div class="cs-step-hd"><span class="cs-num">Step 3</span>' +
      '<span class="cs-title">Distance check via s = ½gt²</span></div>' +
      '<div class="cs-formula">\\( s = \\tfrac{1}{2}g\\,t^{2} \\)</div>' +
      '<div class="cs-calc">\\( s = \\tfrac{1}{2}(' + gD + ')(' + tD + ')^{2} \\)</div>' +
      '<div class="cs-result">\\( s = ' + hD + '\\ \\text{' + L + '} = h\\ \\checkmark \\)</div></div>';

    html += '<div class="cs-step"><div class="cs-step-hd"><span class="cs-num">Step 4</span>' +
      '<span class="cs-title">Energy (per kg of mass)</span></div>' +
      '<div class="cs-formula">\\( \\tfrac{1}{2}v^{2} = g\\,h \\)</div>' +
      '<div class="cs-result">\\( \\tfrac{1}{2}v^{2} = ' + fmt(keImp) + '\\ \\text{J/kg} = g\\,h \\)</div></div>';

    return html;
  }

  function openCalcModal() {
