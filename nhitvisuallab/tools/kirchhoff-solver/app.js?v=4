  function resetAll() {
    circuitType = 'hbridge';
    v1 = 12; v2 = 8; v3 = 6; r1 = 100; r2 = 200; r3 = 150; r4 = 220; r5 = 180;
    showMesh = true; showNodeV = true; showPower = false; showGrid = false;
