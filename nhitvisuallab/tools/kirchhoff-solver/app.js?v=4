  function showQuizQuestion() {
    if (quizIdx >= quizPool.length) { showQuizResult(); return; }
    var q = quizPool[quizIdx];
    qbarNum.textContent = quizIdx + 1;
    quizAnswered = false;

    var html = '<p class="qp-prompt">Q' + (quizIdx + 1) + '. ' + q.prompt + '</p>';

    if (q.type === 'mcq') {
      html += '<div class="answer-grid">';
      for (var i = 0; i < q.options.length; i++) {
        html += '<button class="answer-btn" data-idx="' + i + '">' + q.options[i] + '</button>';
      }
      html += '</div>';
    } else {
      html += '<div class="quiz-input-row">';
      html += '<input class="qi-input" id="qi-val" type="number" step="any" placeholder="Answer">';
      html += '<span class="qi-unit">' + q.unit + '</span>';
      html += '<button class="btn btn-primary" id="qi-submit">Submit</button>';
      html += '</div>';
      html += '<p class="quiz-feedback" id="qi-feedback"></p>';
    }

    quizPanel.innerHTML = html;

    if (q.type === 'mcq') {
      var btns = quizPanel.querySelectorAll('.answer-btn');
      for (var b = 0; b < btns.length; b++) {
        btns[b].addEventListener('click', onMCQClick);
      }
    } else {
      var submitBtn = document.getElementById('qi-submit');
      var qiInput = document.getElementById('qi-val');
      submitBtn.addEventListener('click', onNumericSubmit);
      qiInput.addEventListener('keydown', function (e) { if (e.key === 'Enter') onNumericSubmit(); });
      qiInput.focus();
    }
  }

  function onMCQClick(e) {
    if (quizAnswered) return;
    quizAnswered = true;
    var q = quizPool[quizIdx];
    var chosen = parseInt(e.currentTarget.getAttribute('data-idx'));
    var correct = chosen === q.correct;

    var btns = quizPanel.querySelectorAll('.answer-btn');
    for (var i = 0; i < btns.length; i++) {
      btns[i].classList.add('locked');
      if (i === q.correct) btns[i].classList.add('correct');
      if (i === chosen && !correct) btns[i].classList.add('wrong');
    }

    if (correct) quizScore++;
    quizHistory.push({ q: q, correct: correct, chosen: q.options[chosen], correctAnswer: q.options[q.correct] });

    setTimeout(function () { quizIdx++; showQuizQuestion(); }, 1200);
  }

  function onNumericSubmit() {
    if (quizAnswered) return;
    var qiInput = document.getElementById('qi-val');
    var feedback = document.getElementById('qi-feedback');
    var val = parseFloat(qiInput.value);
    if (isNaN(val)) { feedback.textContent = 'Enter a number'; feedback.className = 'quiz-feedback err'; return; }
    quizAnswered = true;
    var q = quizPool[quizIdx];
    var tol = q.tol || 0.5;
    var correct = Math.abs(val - q.answer) <= tol;

    if (correct) {
      feedback.textContent = 'Correct!';
      feedback.className = 'quiz-feedback ok';
      quizScore++;
    } else {
      feedback.textContent = 'Incorrect. Answer: ' + q.answer + ' ' + q.unit;
      feedback.className = 'quiz-feedback err';
    }
    quizHistory.push({ q: q, correct: correct, chosen: val + ' ' + q.unit, correctAnswer: q.answer + ' ' + q.unit });
    qiInput.disabled = true;

    setTimeout(function () { quizIdx++; showQuizQuestion(); }, 1500);
  }

  function showQuizResult() {
    quizPanel.style.display = 'none';
    quizBar.style.display = 'none';
    quizResult.style.display = '';

    var pct = Math.round(quizScore / quizPool.length * 100);
    var stars = '';
    var cls = 'poor';
    if (pct >= 90) { stars = '\u2605\u2605\u2605\u2605\u2605'; cls = 'perfect'; }
    else if (pct >= 70) { stars = '\u2605\u2605\u2605\u2605\u2606'; cls = 'good'; }
    else if (pct >= 50) { stars = '\u2605\u2605\u2605\u2606\u2606'; cls = 'good'; }
    else { stars = '\u2605\u2605\u2606\u2606\u2606'; }

    var verdictText = pct === 100 ? 'Perfect score!' : pct >= 70 ? 'Good work!' : 'Keep practicing.';

    var html = '<div class="qr-header">';
    html += '<div class="qr-title-wrap"><span class="qr-title">Quiz Complete</span><span class="qr-stars">' + stars + '</span></div>';
    html += '<div class="qr-score-wrap"><span class="qr-score ' + cls + '">' + pct + '%</span><br><span class="qr-verdict">' + verdictText + ' (' + quizScore + '/' + quizPool.length + ')</span></div>';
    html += '</div>';

    html += '<div class="qr-rows">';
    for (var i = 0; i < quizHistory.length; i++) {
      var h = quizHistory[i];
      var rowCls = h.correct ? 'ok' : 'err';
      html += '<div class="qr-row ' + rowCls + '">';
      html += '<span class="qr-qnum">Q' + (i + 1) + '</span>';
      html += '<span class="qr-detail"><strong>' + (h.correct ? h.chosen : h.chosen) + '</strong>';
      if (!h.correct) html += ' \u2014 Correct: ' + h.correctAnswer;
      html += '</span>';
      html += '<span class="qr-mark">' + (h.correct ? '\u2713' : '\u2717') + '</span>';
      html += '</div>';
    }
    html += '</div>';

    html += '<button class="btn btn-primary" id="quiz-retry">Retake Quiz</button>';

    quizResult.innerHTML = html;

    document.getElementById('quiz-retry').addEventListener('click', function () {
      quizResult.style.display = 'none';
      initQuiz();
    });
  }

