  /* ── Sliders + steppers (bidirectional) ─────────────────────── */
  var stepCfg = {
    v1: { sl: v1Slider, inp: v1ValEl, min: 1,  max: 24,   step: 0.5, bump: 0.5, dec: 1 },
    v2: { sl: v2Slider, inp: v2ValEl, min: 1,  max: 24,   step: 0.5, bump: 0.5, dec: 1 },
    v3: { sl: v3Slider, inp: v3ValEl, min: 1,  max: 24,   step: 0.5, bump: 0.5, dec: 1 },
    r1: { sl: r1Slider, inp: r1ValEl, min: 10, max: 1000, step: 1,   bump: 10,  dec: 0 },
    r2: { sl: r2Slider, inp: r2ValEl, min: 10, max: 1000, step: 1,   bump: 10,  dec: 0 },
    r3: { sl: r3Slider, inp: r3ValEl, min: 10, max: 1000, step: 1,   bump: 10,  dec: 0 },
    r4: { sl: r4Slider, inp: r4ValEl, min: 10, max: 1000, step: 1,   bump: 10,  dec: 0 },
    r5: { sl: r5Slider, inp: r5ValEl, min: 10, max: 1000, step: 1,   bump: 10,  dec: 0 }
  };

  function getVar(k) {
    return { v1: v1, v2: v2, v3: v3, r1: r1, r2: r2, r3: r3, r4: r4, r5: r5 }[k];
  }
  function setVar(k, x) {
    if (k === 'v1') v1 = x; else if (k === 'v2') v2 = x; else if (k === 'v3') v3 = x;
    else if (k === 'r1') r1 = x; else if (k === 'r2') r2 = x; else if (k === 'r3') r3 = x;
    else if (k === 'r4') r4 = x; else if (k === 'r5') r5 = x;
  }
  function clampStep(k, x) {
    var c = stepCfg[k];
    if (isNaN(x)) x = getVar(k);
    x = Math.max(c.min, Math.min(c.max, x));
    x = Math.round(x / c.step) * c.step;
    return x;
  }
  function fmtVal(k, x) { var c = stepCfg[k]; return c.dec ? x.toFixed(c.dec) : String(x); }

  function recompute() { calcPhysics(); updateReadouts(); }

  function applyValue(k, x) {
    x = clampStep(k, x);
    setVar(k, x);
    var c = stepCfg[k];
    c.sl.value = x;
    if (document.activeElement !== c.inp) c.inp.value = fmtVal(k, x);
    recompute();
  }

  function syncInputs() {
    for (var k in stepCfg) {
      var c = stepCfg[k], v = getVar(k);
      c.sl.value = v;
      if (document.activeElement !== c.inp) c.inp.value = fmtVal(k, v);
    }
  }

  Object.keys(stepCfg).forEach(function (key) {
    var c = stepCfg[key];
    c.sl.addEventListener('input', function () { applyValue(key, parseFloat(c.sl.value)); });
    c.inp.addEventListener('change', function () { applyValue(key, parseFloat(c.inp.value)); });
    c.inp.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') { applyValue(key, parseFloat(c.inp.value)); c.inp.blur(); }
    });
  });

  Array.prototype.forEach.call(document.querySelectorAll('.stepper-btn'), function (btn) {
    btn.addEventListener('click', function () {
      var key = btn.getAttribute('data-step');
      var dir = parseInt(btn.getAttribute('data-dir'), 10);
      applyValue(key, getVar(key) + dir * stepCfg[key].bump);
    });
  });

