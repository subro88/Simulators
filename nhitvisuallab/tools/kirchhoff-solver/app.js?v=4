  function drawExploreDiagram(concept) {
    clearCanvas();
    ctx.font = 'bold 16px sans-serif';
    ctx.fillStyle = '#66bb6a';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'top';
    ctx.fillText(concept.name, W / 2, 20);

    ctx.font = 'bold 14px "Courier New", monospace';
    ctx.fillStyle = '#ffa000';
    ctx.fillText(concept.formula, W / 2, 48);

    switch (concept.diagram) {
      case 'kcl': drawDiagramKCL(); break;
      case 'kvl': drawDiagramKVL(); break;
      case 'superposition': drawDiagramSuperposition(); break;
      case 'mesh': drawDiagramMesh(); break;
      case 'nodevoltage': drawDiagramNodeVoltage(); break;
      case 'thevenin': drawDiagramThevenin(); break;
    }
  }

  function drawDiagramKCL() {
    var cx = 450, cy = 240;
    /* Node */
    ctx.beginPath();
    ctx.arc(cx, cy, 8, 0, Math.PI * 2);
    ctx.fillStyle = '#ffa000';
    ctx.fill();
    ctx.font = 'bold 14px sans-serif';
    ctx.fillStyle = '#ffa000';
    ctx.textAlign = 'center';
    ctx.fillText('Node', cx, cy - 20);

    /* Incoming arrows */
    var dirs = [[-1, -0.5], [-1, 0.5], [1, -0.5], [1, 0.5], [0, -1]];
    var labels = ['I\u2081', 'I\u2082', 'I\u2083', 'I\u2084', 'I\u2085'];
    var colors = ['#3ddc84', '#3ddc84', '#ff5555', '#ff5555', '#3ddc84'];
    for (var i = 0; i < 5; i++) {
      var dx = dirs[i][0] * 100, dy = dirs[i][1] * 100;
      var sx = cx + dx, sy = cy + dy;
      var entering = colors[i] === '#3ddc84';
      drawWire(sx, sy, cx, cy, colors[i]);
      /* Arrow head — entering currents point INTO the node, leaving currents
         point AWAY from it (out at the far end of the wire) */
      var ang, hx, hy;
      if (entering) {
        ang = Math.atan2(cy - sy, cx - sx);
        hx = cx - 12 * Math.cos(ang); hy = cy - 12 * Math.sin(ang);
      } else {
        ang = Math.atan2(sy - cy, sx - cx);
        hx = sx; hy = sy;
      }
      ctx.beginPath();
      ctx.moveTo(hx, hy);
      ctx.lineTo(hx - 8 * Math.cos(ang - 0.4), hy - 8 * Math.sin(ang - 0.4));
      ctx.lineTo(hx - 8 * Math.cos(ang + 0.4), hy - 8 * Math.sin(ang + 0.4));
      ctx.closePath();
      ctx.fillStyle = colors[i];
      ctx.fill();
      ctx.font = 'bold 12px "Courier New", monospace';
      ctx.fillStyle = colors[i];
      ctx.textAlign = 'center';
      ctx.fillText(labels[i], sx, sy - 14);
    }
    ctx.font = '13px sans-serif';
    ctx.fillStyle = '#dde3f0';
    ctx.textAlign = 'center';
    ctx.fillText('\u03A3I_in = \u03A3I_out   (I\u2081 + I\u2082 + I\u2085 = I\u2083 + I\u2084)', cx, 390);
    ctx.fillText('Green = entering, Red = leaving', cx, 415);
  }

  function drawDiagramKVL() {
    /* Series loop: battery (left) + R1, R2 (top) + R3 (bottom) */
    var x = 200, y = 100, w = 500, h = 280;
    /* Top rail, broken where R1 and R2 sit */
    drawWire(x, y, x + 50, y, '#42a5f5');
    drawWire(x + 170, y, x + 250, y, '#42a5f5');
    drawWire(x + 370, y, x + w, y, '#42a5f5');
    /* Right side */
    drawWire(x + w, y, x + w, y + h, '#42a5f5');
    /* Bottom rail, broken where R3 sits */
    drawWire(x + w, y + h, x + 310, y + h, '#42a5f5');
    drawWire(x + 190, y + h, x, y + h, '#42a5f5');
    /* Left side carries the source (+ up → conventional current clockwise) */
    drawWire(x, y + h, x, y + h / 2 + 16, '#42a5f5');
    drawWire(x, y + h / 2 - 16, x, y, '#42a5f5');

    drawResistorH(x + 50, y, 120, 100, 'R1');
    drawResistorH(x + 250, y, 120, 200, 'R2');
    drawResistorH(x + 190, y + h, 120, 150, 'R3');
    drawBattery(x, y + h / 2, 12, true);

    /* KVL equation */
    ctx.font = '13px sans-serif';
    ctx.fillStyle = '#dde3f0';
    ctx.textAlign = 'center';
    ctx.fillText('V_source = V_R1 + V_R2 + V_R3', W / 2, 420);
    ctx.fillText('\u03A3V_rises \u2212 \u03A3V_drops = 0  around any closed loop', W / 2, 445);

    /* Loop arrow */
    drawMeshArrow(450, 240, 70, 'KVL', true);
  }

  function drawDiagramSuperposition() {
    /* Show original circuit, then two sub-circuits */
    ctx.font = 'bold 12px sans-serif';
    ctx.fillStyle = '#dde3f0';
    ctx.textAlign = 'center';
    ctx.fillText('Original Circuit', 200, 85);
    ctx.fillText('Source 1 Only', 500, 85);
    ctx.fillText('Source 2 Only', 780, 85);

    /* Simplified: 3 boxes */
    var boxes = [[100, 100, 200, 280], [400, 100, 200, 280], [680, 100, 200, 280]];
    for (var i = 0; i < 3; i++) {
      ctx.strokeStyle = '#2a3050';
      ctx.lineWidth = 1;
      ctx.strokeRect(boxes[i][0], boxes[i][1], boxes[i][2], boxes[i][3]);

      ctx.font = '11px sans-serif';
      ctx.fillStyle = '#6b7a99';
      ctx.textAlign = 'center';
      if (i === 0) {
        ctx.fillText('V1 + V2 + R1,R2,R3', boxes[i][0] + 100, boxes[i][1] + 140);
      } else if (i === 1) {
        ctx.fillText('V1 active, V2 = 0', boxes[i][0] + 100, boxes[i][1] + 130);
        ctx.fillText('(V2 shorted)', boxes[i][0] + 100, boxes[i][1] + 150);
      } else {
        ctx.fillText('V2 active, V1 = 0', boxes[i][0] + 100, boxes[i][1] + 130);
        ctx.fillText('(V1 shorted)', boxes[i][0] + 100, boxes[i][1] + 150);
      }
    }

    /* Plus and equals signs */
    ctx.font = 'bold 24px sans-serif';
    ctx.fillStyle = '#66bb6a';
    ctx.textAlign = 'center';
    ctx.fillText('=', 350, 240);
    ctx.fillText('+', 630, 240);

    ctx.font = '13px sans-serif';
    ctx.fillStyle = '#dde3f0';
    ctx.fillText('I_total = I_due_to_V1 + I_due_to_V2', W / 2, 420);
  }

  function drawDiagramMesh() {
    /* Draw 2-loop mesh with labeled equations */
    var ax = 200, ay = 120, bx = 450, by = 120, cx = 700, cy = 120;
    var dy = 340;
    var myM = (ay + dy) / 2;

    drawWire(ax, ay, ax + 30, ay, '#42a5f5');
    drawWire(bx - 30, ay, bx, ay, '#42a5f5');
