  function calcPhysics() {
    if (circuitType === 'three-loop') {
      calcThreeLoop();
    } else {
      calcTwoLoop();
    }
  }

  function calcTwoLoop() {
    /* Standard 2-loop mesh:
       Loop 1: V1 = I1*(R1+R2) - I2*R2
       Loop 2: V2 = I2*(R3+R2) - I1*R2
       Matrix: [R1+R2, -R2; -R2, R3+R2] [I1;I2] = [V1;V2]
    */
    var a11 = r1 + r2, a12 = -r2;
    var a21 = -r2, a22 = r3 + r2;
    var det = a11 * a22 - a12 * a21;
    if (Math.abs(det) < 1e-10) det = 1e-10;

    var I1 = (v1 * a22 - v2 * a12) / det;
    var I2 = (a11 * v2 - a21 * v1) / det;
    var Ir2 = I1 - I2;

    var VB = v1 - I1 * r1;

    var Pr1 = I1 * I1 * r1;
    var Pr2 = Ir2 * Ir2 * r2;
    var Pr3 = I2 * I2 * r3;
    var Ptotal = Pr1 + Pr2 + Pr3;

    phys = {
      loops: 2,
      I1: I1, I2: I2, I3: 0,
      Ir2: Ir2,
      VB: VB,
      Pr1: Pr1, Pr2: Pr2, Pr3: Pr3, Pr4: 0, Pr5: 0,
      Ptotal: Ptotal
    };
  }

  function calcThreeLoop() {
    /* 3-loop ladder/mesh:
       Loop 1: V1 = I1*(R1+R2) - I2*R2
       Loop 2: 0  = -I1*R2 + I2*(R2+R3+R4) - I3*R4
       Loop 3: V3 = -I2*R4 + I3*(R4+R5)
    */
    var a11 = r1 + r2, a12 = -r2, a13 = 0;
    var a21 = -r2, a22 = r2 + r3 + r4, a23 = -r4;
    var a31 = 0, a32 = -r4, a33 = r4 + r5;

    var b1 = v1, b2 = 0, b3 = v3;

    /* Cramer's rule for 3x3 */
    var det = a11 * (a22 * a33 - a23 * a32)
            - a12 * (a21 * a33 - a23 * a31)
            + a13 * (a21 * a32 - a22 * a31);
    if (Math.abs(det) < 1e-10) det = 1e-10;

    var I1 = (b1 * (a22 * a33 - a23 * a32) - a12 * (b2 * a33 - a23 * b3) + a13 * (b2 * a32 - a22 * b3)) / det;
    var I2 = (a11 * (b2 * a33 - a23 * b3) - b1 * (a21 * a33 - a23 * a31) + a13 * (a21 * b3 - b2 * a31)) / det;
    var I3 = (a11 * (a22 * b3 - b2 * a32) - a12 * (a21 * b3 - b2 * a31) + b1 * (a21 * a32 - a22 * a31)) / det;

    var Ir2 = I1 - I2;
    var Ir4 = I2 - I3;
    var VB = v1 - I1 * r1;

    var Pr1 = I1 * I1 * r1;
    var Pr2 = Ir2 * Ir2 * r2;
    var Pr3 = I2 * I2 * r3;
    var Pr4 = Ir4 * Ir4 * r4;
    var Pr5 = I3 * I3 * r5;
    var Ptotal = Pr1 + Pr2 + Pr3 + Pr4 + Pr5;

    phys = {
      loops: 3,
      I1: I1, I2: I2, I3: I3,
      Ir2: Ir2, Ir4: Ir4,
      VB: VB,
      Pr1: Pr1, Pr2: Pr2, Pr3: Pr3, Pr4: Pr4, Pr5: Pr5,
      Ptotal: Ptotal
    };
  }

