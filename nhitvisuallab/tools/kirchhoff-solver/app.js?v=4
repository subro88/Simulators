  /* ── Export CSV / PNG ────────────────────────────────────────── */
  function downloadBlob(blob, name) {
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url; a.download = name;
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
    setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
  }
  function exportCSV() {
    var rows = [['Quantity', 'Value', 'Unit']];
    rows.push(['Circuit', circuitType, '']);
    rows.push(['V1', v1.toFixed(1), 'V']);
    rows.push(['V2', v2.toFixed(1), 'V']);
    if (circuitType === 'three-loop') rows.push(['V3', v3.toFixed(1), 'V']);
    rows.push(['R1', r1, 'ohm']); rows.push(['R2', r2, 'ohm']); rows.push(['R3', r3, 'ohm']);
    if (circuitType === 'three-loop') { rows.push(['R4', r4, 'ohm']); rows.push(['R5', r5, 'ohm']); }
    rows.push(['I1', (phys.I1 * 1000).toFixed(2), 'mA']);
    rows.push(['I2', (phys.I2 * 1000).toFixed(2), 'mA']);
    if (circuitType === 'three-loop') rows.push(['I3', (phys.I3 * 1000).toFixed(2), 'mA']);
    rows.push(['I_R2', (phys.Ir2 * 1000).toFixed(2), 'mA']);
    rows.push(['V_nodeB', phys.VB.toFixed(3), 'V']);
    rows.push(['P_R1', (phys.Pr1 * 1000).toFixed(2), 'mW']);
    rows.push(['P_R2', (phys.Pr2 * 1000).toFixed(2), 'mW']);
    rows.push(['P_R3', (phys.Pr3 * 1000).toFixed(2), 'mW']);
    if (circuitType === 'three-loop') {
      rows.push(['P_R4', (phys.Pr4 * 1000).toFixed(2), 'mW']);
      rows.push(['P_R5', (phys.Pr5 * 1000).toFixed(2), 'mW']);
    }
    rows.push(['P_total', (phys.Ptotal * 1000).toFixed(2), 'mW']);
    var csv = rows.map(function (r) { return r.join(','); }).join('\n');
    downloadBlob(new Blob([csv], { type: 'text/csv' }), 'kirchhoff-' + circuitType + '.csv');
  }
  function exportPNG() {
    var tmp = document.createElement('canvas');
    tmp.width = cvs.width; tmp.height = cvs.height;
