  function draw(time) {
    clearCanvas();

    /* Title */
    ctx.font = 'bold 14px sans-serif';
    ctx.fillStyle = '#6b7a99';
    ctx.textAlign = 'left';
    ctx.textBaseline = 'top';
    var titleMap = { hbridge: 'H-Bridge (2-Loop)', tnetwork: 'T-Network (2-Loop)', ladder: 'Ladder (2-Loop)', 'three-loop': '3-Loop Ladder' };
    ctx.fillText(titleMap[circuitType] || '', 15, 15);

    /* Equations overlay */
    ctx.font = '11px "Courier New", monospace';
    ctx.fillStyle = '#6b7a99';
    ctx.textAlign = 'right';
    if (circuitType === 'three-loop') {
      ctx.fillText('Loop 1: V1 = I\u2081R1 + (I\u2081\u2212I\u2082)R2', W - 15, 15);
      ctx.fillText('Loop 2: 0 = \u2212I\u2081R2 + I\u2082(R2+R3+R4) \u2212 I\u2083R4', W - 15, 30);
      ctx.fillText('Loop 3: V3 = \u2212I\u2082R4 + I\u2083(R4+R5)', W - 15, 45);
    } else {
      ctx.fillText('Loop 1: V1 = I\u2081(R1+R2) \u2212 I\u2082\u00B7R2', W - 15, 15);
      ctx.fillText('Loop 2: V2 = I\u2082(R3+R2) \u2212 I\u2081\u00B7R2', W - 15, 30);
    }

    switch (circuitType) {
      case 'hbridge': drawHBridge(time); break;
      case 'tnetwork': drawTNetwork(time); break;
      case 'ladder': drawLadder(time); break;
      case 'three-loop': drawThreeLoop(time); break;
    }
  }

