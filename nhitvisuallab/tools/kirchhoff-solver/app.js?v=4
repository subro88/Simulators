    tctx.fillStyle = 'rgba(221,227,240,0.55)';
    tctx.textAlign = 'right'; tctx.textBaseline = 'bottom';
    tctx.fillText('mechsimulator.com — Kirchhoff Solver', tmp.width - 12, tmp.height - 10);
    tmp.toBlob(function (blob) { if (blob) downloadBlob(blob, 'kirchhoff-' + circuitType + '.png'); });
  }
  function copyValues() {
