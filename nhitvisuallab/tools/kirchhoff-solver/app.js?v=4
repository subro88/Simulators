     ================================================================ */

  function setMode(newMode) {
    mode = newMode;

    /* Update tabs */
    var pills = modeTabs.querySelectorAll('.pill');
    for (var i = 0; i < pills.length; i++) {
      pills[i].classList.toggle('active', pills[i].getAttribute('data-mode') === newMode);
    }

    /* Show/hide panels */
    simPanel.style.display = newMode === 'simulate' ? '' : 'none';
    catRow.style.display = newMode === 'explore' ? '' : 'none';
    itemSelector.style.display = newMode === 'explore' ? '' : 'none';
    itemInfo.style.display = newMode === 'explore' && selectedConcept ? '' : 'none';
    practicePanel.style.display = newMode === 'practice' ? '' : 'none';
    practiceBar.style.display = newMode === 'practice' ? '' : 'none';
    quizPanel.style.display = newMode === 'quiz' ? '' : 'none';
    quizBar.style.display = newMode === 'quiz' ? '' : 'none';
    quizResult.style.display = 'none';

    stopAnimation();

    if (newMode === 'simulate') {
      calcPhysics();
      updateReadouts();
      startAnimation();
    } else if (newMode === 'explore') {
      buildExploreGrid();
      if (selectedConcept) drawExploreDiagram(selectedConcept);
      else { clearCanvas(); drawExploreWelcome(); }
    } else if (newMode === 'practice') {
      drawPracticeCanvas();
      if (!curProblem) nextPractice();
    } else if (newMode === 'quiz') {
      drawQuizCanvas();
      initQuiz();
    }
  }

