  function clearCanvas() {
    var g = ctx.createLinearGradient(0, 0, 0, H);
    g.addColorStop(0, '#1a2030');
    g.addColorStop(0.55, '#161b27');
    g.addColorStop(1, '#10141e');
    ctx.fillStyle = g;
    ctx.fillRect(0, 0, W, H);
    var spot = ctx.createRadialGradient(W / 2, H * 0.52, 60, W / 2, H * 0.52, W * 0.55);
    spot.addColorStop(0, 'rgba(102,187,106,0.05)');
    spot.addColorStop(1, 'rgba(102,187,106,0)');
    ctx.fillStyle = spot;
    ctx.fillRect(0, 0, W, H);
    if (showGrid) {
      ctx.strokeStyle = 'rgba(139,157,195,0.10)';
      ctx.lineWidth = 1;
      for (var gx = 0; gx <= W; gx += 30) { ctx.beginPath(); ctx.moveTo(gx, 0); ctx.lineTo(gx, H); ctx.stroke(); }
      for (var gy = 0; gy <= H; gy += 30) { ctx.beginPath(); ctx.moveTo(0, gy); ctx.lineTo(W, gy); ctx.stroke(); }
    }
  }

  function drawWire(x1, y1, x2, y2, color) {
    ctx.lineCap = 'round';
    ctx.beginPath();
    ctx.moveTo(x1, y1);
    ctx.lineTo(x2, y2);
    ctx.strokeStyle = 'rgba(0,0,0,0.35)';
    ctx.lineWidth = 4;
    ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(x1, y1);
    ctx.lineTo(x2, y2);
    ctx.strokeStyle = color || '#42a5f5';
    ctx.lineWidth = 2.5;
    ctx.stroke();
  }

  function drawBattery(x, y, V, vertical, plusDown) {
    /* Two-cell battery for a VERTICAL wire: plates horizontal (perpendicular
       to the wire), stacked along it. IEC convention: long-thin = +,
       short-thick = \u2212. plusDown mirrors the cell so the + terminal faces the
       bottom (ground) rail \u2014 required by this tool's mesh sign convention for
       V2/V3. Callers must leave a \u00b116 px wire gap around (x,y). */
    ctx.save();
    ctx.translate(x, y);
    if (!vertical) ctx.rotate(Math.PI / 2);
    var s = plusDown ? -1 : 1;
    var plates = [
      { py: -9 * s, half: 13, w: 2,   color: '#ff5555' }, /* long thin  + */
      { py: -3 * s, half: 6,  w: 4.5, color: '#42a5f5' }, /* short thick \u2212 */
      { py:  3 * s, half: 13, w: 2,   color: '#ff5555' },
      { py:  9 * s, half: 6,  w: 4.5, color: '#42a5f5' }
    ];
    ctx.lineCap = 'round';
    for (var i = 0; i < plates.length; i++) {
      var p = plates[i];
      ctx.beginPath();
      ctx.moveTo(-p.half, p.py); ctx.lineTo(p.half, p.py);
      ctx.strokeStyle = p.color; ctx.lineWidth = p.w;
      ctx.stroke();
    }

    /* + / \u2212 terminal marks (beside the outermost plates) */
    ctx.font = 'bold 11px sans-serif';
    ctx.textAlign = 'left'; ctx.textBaseline = 'middle';
    ctx.fillStyle = '#ff5555';
    ctx.fillText('+', 18, -10 * s);
    ctx.fillStyle = '#42a5f5';
    ctx.fillText('\u2212', 18, 10 * s);

    /* Voltage label (left side, clear of the wire) */
    ctx.font = 'bold 12px "Courier New", monospace';
    ctx.fillStyle = '#ffa000';
    ctx.textAlign = 'right';
    ctx.fillText(V.toFixed(1) + ' V', -18, 0);

    ctx.restore();
  }

  function drawResistorH(x, y, w, R, label) {
    /* Horizontal zigzag resistor */
    var segs = 6;
    var segW = w / segs;
    var amp = 10;
    ctx.beginPath();
    ctx.moveTo(x, y);
    for (var i = 0; i < segs; i++) {
      var dir = (i % 2 === 0) ? -1 : 1;
      ctx.lineTo(x + segW * (i + 0.5), y + amp * dir);
      ctx.lineTo(x + segW * (i + 1), y);
    }
    ctx.strokeStyle = '#66bb6a';
    ctx.lineWidth = 2.5;
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';
    ctx.stroke();

    /* Label */
    ctx.font = 'bold 11px "Courier New", monospace';
    ctx.fillStyle = '#66bb6a';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'top';
    ctx.fillText(label + ' = ' + R + ' \u03A9', x + w / 2, y + amp + 4);
  }

  function drawResistorV(x, y, h, R, label) {
    /* Vertical zigzag resistor */
    var segs = 6;
    var segH = h / segs;
    var amp = 10;
    ctx.beginPath();
    ctx.moveTo(x, y);
    for (var i = 0; i < segs; i++) {
      var dir = (i % 2 === 0) ? -1 : 1;
      ctx.lineTo(x + amp * dir, y + segH * (i + 0.5));
      ctx.lineTo(x, y + segH * (i + 1));
    }
    ctx.strokeStyle = '#66bb6a';
    ctx.lineWidth = 2.5;
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';
    ctx.stroke();

    /* Label */
    ctx.save();
    ctx.font = 'bold 11px "Courier New", monospace';
    ctx.fillStyle = '#66bb6a';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'bottom';
    ctx.fillText(label + '=' + R + '\u03A9', x + amp + 28, y + h / 2 + 4);
    ctx.restore();
  }

  function drawPowerGlow(x, y, w, h, power) {
    if (!showPower) return;
    var maxP = 2; /* watts for full glow */
    var intensity = Math.min(power / maxP, 1);
    if (intensity < 0.01) return;
    var grad = ctx.createRadialGradient(x + w / 2, y + h / 2, 0, x + w / 2, y + h / 2, Math.max(w, h));
    grad.addColorStop(0, 'rgba(255,152,0,' + (0.4 * intensity) + ')');
    grad.addColorStop(1, 'rgba(255,152,0,0)');
    ctx.fillStyle = grad;
    ctx.fillRect(x - 10, y - 10, w + 20, h + 20);
  }

  function drawMeshArrow(cx, cy, radius, label, clockwise) {
    if (!showMesh) return;
    ctx.beginPath();
    var start = clockwise ? -0.3 : 0.3;
    var end = clockwise ? Math.PI * 1.7 : -Math.PI * 1.7;
    ctx.arc(cx, cy, radius, start, end, !clockwise);
    ctx.strokeStyle = 'rgba(102,187,106,0.5)';
    ctx.lineWidth = 1.5;
    ctx.setLineDash([4, 3]);
    ctx.stroke();
    ctx.setLineDash([]);

    /* Arrow head — tip must point ALONG the direction of travel */
    var angle = end;
    var ax = cx + radius * Math.cos(angle);
    var ay = cy + radius * Math.sin(angle);
    var headAngle = clockwise ? angle + Math.PI / 2 : angle - Math.PI / 2; /* forward tangent */
    var tx = ax + 6 * Math.cos(headAngle);
    var ty = ay + 6 * Math.sin(headAngle);
    ctx.beginPath();
    ctx.moveTo(tx, ty);
    ctx.lineTo(tx - 10 * Math.cos(headAngle - 0.42), ty - 10 * Math.sin(headAngle - 0.42));
    ctx.lineTo(tx - 10 * Math.cos(headAngle + 0.42), ty - 10 * Math.sin(headAngle + 0.42));
    ctx.closePath();
    ctx.fillStyle = 'rgba(102,187,106,0.75)';
    ctx.fill();

    /* Label */
    ctx.font = 'bold 13px "Courier New", monospace';
    ctx.fillStyle = '#66bb6a';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText(label, cx, cy);
  }

  function drawNodeLabel(x, y, label, voltage) {
    /* Draw a small circle and label for a node */
    ctx.beginPath();
    ctx.arc(x, y, 4, 0, Math.PI * 2);
    ctx.fillStyle = '#ffa000';
    ctx.fill();

    ctx.font = 'bold 12px sans-serif';
    ctx.fillStyle = '#ffa000';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'bottom';
    ctx.fillText(label, x, y - 8);

    if (showNodeV && voltage !== undefined) {
      ctx.font = '10px "Courier New", monospace';
      ctx.fillStyle = '#ff5555';
      ctx.textBaseline = 'top';
      ctx.fillText(voltage.toFixed(2) + ' V', x, y + 8);
    }
  }

  function drawCurrentDots(path, current, time) {
    if (Math.abs(current) < 1e-6) return;
    var speed = current * 800; /* pixels per second scaled */
    var dotSpacing = 30;
    var totalLen = 0;
    var segs = [];
    for (var i = 1; i < path.length; i++) {
      var dx = path[i][0] - path[i - 1][0];
      var dy = path[i][1] - path[i - 1][1];
      var len = Math.sqrt(dx * dx + dy * dy);
      segs.push({ sx: path[i - 1][0], sy: path[i - 1][1], dx: dx / len, dy: dy / len, len: len, start: totalLen });
      totalLen += len;
    }
    if (totalLen < 1) return;

    var nDots = Math.max(2, Math.floor(totalLen / dotSpacing));
    ctx.save();
    ctx.shadowColor = current > 0 ? 'rgba(61,220,132,0.9)' : 'rgba(255,85,85,0.9)';
    ctx.shadowBlur = 6;
    for (var d = 0; d < nDots; d++) {
      var pos = ((d / nDots) * totalLen + speed * time) % totalLen;
      if (pos < 0) pos += totalLen;
      /* Find which segment */
      for (var s = 0; s < segs.length; s++) {
        if (pos >= segs[s].start && pos < segs[s].start + segs[s].len) {
          var t = pos - segs[s].start;
          var px = segs[s].sx + segs[s].dx * t;
          var py = segs[s].sy + segs[s].dy * t;
          ctx.beginPath();
          ctx.arc(px, py, 3, 0, Math.PI * 2);
          ctx.fillStyle = current > 0 ? '#3ddc84' : '#ff5555';
          ctx.fill();
          break;
        }
      }
    }
    ctx.restore();
  }

  function drawCurrentArrow(x1, y1, x2, y2, current) {
    var mx = (x1 + x2) / 2, my = (y1 + y2) / 2;
    var dx = x2 - x1, dy = y2 - y1;
    var len = Math.sqrt(dx * dx + dy * dy);
    if (len < 1) return;
    dx /= len; dy /= len;
    var horiz = Math.abs(dx) > Math.abs(dy); /* orientation BEFORE sign flip */

    if (current < 0) { dx = -dx; dy = -dy; }

    /* Arrow */
    ctx.beginPath();
    ctx.moveTo(mx - dx * 8, my - dy * 8);
    ctx.lineTo(mx + dx * 8, my + dy * 8);
    ctx.strokeStyle = 'rgba(61,220,132,0.7)';
    ctx.lineWidth = 2;
    ctx.stroke();

    ctx.beginPath();
    ctx.moveTo(mx + dx * 8, my + dy * 8);
    ctx.lineTo(mx + dx * 8 - 6 * (dx * 0.866 - dy * 0.5), my + dy * 8 - 6 * (dy * 0.866 + dx * 0.5));
    ctx.lineTo(mx + dx * 8 - 6 * (dx * 0.866 + dy * 0.5), my + dy * 8 - 6 * (dy * 0.866 - dx * 0.5));
    ctx.closePath();
    ctx.fillStyle = 'rgba(61,220,132,0.7)';
    ctx.fill();

    /* Label — above horizontal wires (clear of resistor labels below them),
       left of vertical wires (resistor labels sit on the right) */
    ctx.font = '10px "Courier New", monospace';
    ctx.fillStyle = '#3ddc84';
    ctx.textBaseline = 'middle';
    if (horiz) {
      ctx.textAlign = 'center';
      ctx.fillText(Math.abs(current * 1000).toFixed(1) + ' mA', mx, my - 14);
    } else {
      ctx.textAlign = 'right';
      ctx.fillText(Math.abs(current * 1000).toFixed(1) + ' mA', mx - 14, my);
    }
    ctx.textAlign = 'center';
  }

  /* ================================================================
     DRAWING — CIRCUIT TOPOLOGIES
     ================================================================ */

  /* H-Bridge: 2-loop standard layout
       A ──R1── B ──R3── C
       |        |        |
      V1       R2       V2
       |        |        |
       D ────── E ────── F  (ground)
  */
  function drawHBridge(time) {
    var ax = 150, ay = 100;
    var bx = 450, by = 100;
    var cx = 750, cy = 100;
    var dx = 150, dy = 380;
    var ex = 450, ey = 380;
    var fx = 750, fy = 380;

    /* Power glow on resistors */
    drawPowerGlow(ax, ay - 15, bx - ax, 30, phys.Pr1);
    drawPowerGlow(bx - 15, by, 30, ey - by, phys.Pr2);
    drawPowerGlow(bx, ay - 15, cx - bx, 30, phys.Pr3);

    /* Wires */
    drawWire(ax, ay, ax + 30, ay, '#42a5f5');       /* A to R1 start */
    drawWire(bx - 30, by, bx, by, '#42a5f5');       /* R1 end to B */
    drawWire(bx, by, bx + 30, by, '#42a5f5');       /* B to R3 start */
    drawWire(cx - 30, cy, cx, cy, '#42a5f5');       /* R3 end to C */

    var myL = (ay + dy) / 2, myR = (cy + fy) / 2;
    drawWire(ax, ay, ax, myL - 16, '#42a5f5');      /* A down to V1 + plate */
    drawWire(ax, myL + 16, ax, dy, '#42a5f5');      /* V1 − plate to D */
    drawWire(cx, cy, cx, myR - 16, '#42a5f5');      /* C down to V2 − plate */
    drawWire(cx, myR + 16, cx, fy, '#42a5f5');      /* V2 + plate to F */

    drawWire(bx, by, bx, by + 30, '#42a5f5');       /* B down to R2 start */
    drawWire(bx, ey - 30, bx, ey, '#42a5f5');       /* R2 end to E */

    drawWire(dx, dy, ex, ey, '#42a5f5');             /* D to E bottom */
    drawWire(ex, ey, fx, fy, '#42a5f5');             /* E to F bottom */

    /* Resistors */
    drawResistorH(ax + 30, ay, bx - ax - 60, r1, 'R1');
    drawResistorV(bx, by + 30, ey - by - 60, r2, 'R2');
    drawResistorH(bx + 30, by, cx - bx - 60, r3, 'R3');

    /* Batteries \u2014 V2's + terminal faces the ground rail: the mesh equations
       (V2 = I2(R3+R2) \u2212 I1\u00b7R2) drive I2 clockwise, which requires the rise
       to occur going C\u2192F. Node C therefore sits at \u2212V2 w.r.t. ground. */
    drawBattery(ax, myL, v1, true);
    drawBattery(cx, myR, v2, true, true);

    /* Mesh arrows */
    drawMeshArrow(300, 240, 55, 'I\u2081', true);
    drawMeshArrow(600, 240, 55, 'I\u2082', true);

    /* Node labels */
    drawNodeLabel(ax, ay, 'A', v1);
    drawNodeLabel(bx, by, 'B', phys.VB);
    drawNodeLabel(cx, cy, 'C', -v2);
    drawNodeLabel(ex, ey, 'E (GND)', undefined);

    /* Current arrows on branches */
    drawCurrentArrow(ax + 30, ay, bx - 30, ay, phys.I1);
    drawCurrentArrow(bx + 30, by, cx - 30, by, phys.I2);
    drawCurrentArrow(bx, by + 30, bx, ey - 30, phys.Ir2);

    /* Animated dots \u2014 BRANCH currents (each branch carries its true current,
       so KCL is visible at every junction) */
    drawCurrentDots([[ax, dy], [ax, ay]], phys.I1, time);   /* V1 branch up */
    drawCurrentDots([[ax, ay], [bx, by]], phys.I1, time);   /* R1 */
    drawCurrentDots([[bx, by], [bx, ey]], phys.Ir2, time);  /* R2 shunt down */
    drawCurrentDots([[bx, by], [cx, cy]], phys.I2, time);   /* R3 */
    drawCurrentDots([[cx, cy], [cx, fy]], phys.I2, time);   /* V2 branch down */
    drawCurrentDots([[ex, ey], [dx, dy]], phys.I1, time);   /* bottom E\u2192D */
    drawCurrentDots([[fx, fy], [ex, ey]], phys.I2, time);   /* bottom F\u2192E */

    /* Ground symbol */
    drawGround(ex, ey + 10);
  }

  function drawTNetwork(time) {
    /* T-Network: R1 and R3 on top, R2 drops down from center */
    var ax = 120, ay = 140;
    var bx = 450, by = 140;
    var cx = 780, cy = 140;
    var ey = 380; /* bottom rail */

    drawPowerGlow(ax, ay - 15, bx - ax, 30, phys.Pr1);
    drawPowerGlow(bx - 15, by, 30, ey - by, phys.Pr2);
    drawPowerGlow(bx, ay - 15, cx - bx, 30, phys.Pr3);

    /* Wires top */
    drawWire(ax, ay, ax + 40, ay, '#42a5f5');
    drawWire(bx - 40, by, bx, by, '#42a5f5');
    drawWire(bx, by, bx + 40, by, '#42a5f5');
    drawWire(cx - 40, cy, cx, cy, '#42a5f5');

    /* Vertical wires (split around the batteries) */
    var myT = (ay + ey) / 2;
    drawWire(ax, ay, ax, myT - 16, '#42a5f5');
    drawWire(ax, myT + 16, ax, ey, '#42a5f5');
    drawWire(cx, cy, cx, myT - 16, '#42a5f5');
    drawWire(cx, myT + 16, cx, ey, '#42a5f5');
    drawWire(bx, by, bx, by + 30, '#42a5f5');
    drawWire(bx, ey - 30, bx, ey, '#42a5f5');

    /* Bottom rail */
    drawWire(ax, ey, bx, ey, '#42a5f5');
    drawWire(bx, ey, cx, ey, '#42a5f5');

    /* Batteries — V2 + terminal toward ground (mesh sign convention) */
    drawBattery(ax, myT, v1, true);
    drawBattery(cx, myT, v2, true, true);

    /* Resistors */
    drawResistorH(ax + 40, ay, bx - ax - 80, r1, 'R1');
    drawResistorV(bx, by + 30, ey - by - 60, r2, 'R2');
    drawResistorH(bx + 40, by, cx - bx - 80, r3, 'R3');

    /* Mesh arrows */
    drawMeshArrow(285, 260, 50, 'I\u2081', true);
    drawMeshArrow(615, 260, 50, 'I\u2082', true);

    /* Nodes */
    drawNodeLabel(ax, ay, 'A', v1);
    drawNodeLabel(bx, by, 'B', phys.VB);
    drawNodeLabel(cx, cy, 'C', -v2);
    drawNodeLabel(bx, ey, 'D (GND)', undefined);

    /* Current arrows */
    drawCurrentArrow(ax + 40, ay, bx - 40, ay, phys.I1);
    drawCurrentArrow(bx + 40, by, cx - 40, by, phys.I2);
    drawCurrentArrow(bx, by + 30, bx, ey - 30, phys.Ir2);

    /* Branch-current dots */
    drawCurrentDots([[ax, ey], [ax, ay]], phys.I1, time);
    drawCurrentDots([[ax, ay], [bx, by]], phys.I1, time);
    drawCurrentDots([[bx, by], [bx, ey]], phys.Ir2, time);
    drawCurrentDots([[bx, by], [cx, cy]], phys.I2, time);
    drawCurrentDots([[cx, cy], [cx, ey]], phys.I2, time);
    drawCurrentDots([[bx, ey], [ax, ey]], phys.I1, time);
    drawCurrentDots([[cx, ey], [bx, ey]], phys.I2, time);

    drawGround(bx, ey + 10);
  }

  function drawLadder(time) {
    /* Flat two-rail ladder: V1 left rung, R1 & R3 in series along the top rail,
       R2 as a central shunt rung, V2 right rung. Same valid 2-mesh equations as
       the H-bridge, drawn in a distinct horizontal ladder style. */
    var ax = 120, topY = 120;
    var bx = 460;
    var cx = 800 - 40; /* 760 */
    var botY = 370;

    /* Power glow */
    drawPowerGlow(ax, topY - 15, bx - ax, 30, phys.Pr1);
    drawPowerGlow(bx - 15, topY, 30, botY - topY, phys.Pr2);
    drawPowerGlow(bx, topY - 15, cx - bx, 30, phys.Pr3);

    /* Top & bottom rails (thicker to read as ladder rails) */
    ctx.strokeStyle = '#42a5f5'; ctx.lineWidth = 3; ctx.lineCap = 'round';
    /* Left rung (V1) and right rung (V2) verticals are drawn as wires below */

    /* Top rail segments (broken where resistors sit) */
    drawWire(ax, topY, ax + 30, topY, '#42a5f5');
    drawWire(bx - 30, topY, bx, topY, '#42a5f5');
    drawWire(bx, topY, bx + 30, topY, '#42a5f5');
    drawWire(cx - 30, topY, cx, topY, '#42a5f5');

    /* Left & right rungs (verticals carrying batteries) */
    var myLad = (topY + botY) / 2;
    drawWire(ax, topY, ax, myLad - 16, '#42a5f5');
    drawWire(ax, myLad + 16, ax, botY, '#42a5f5');
    drawWire(cx, topY, cx, myLad - 16, '#42a5f5');
    drawWire(cx, myLad + 16, cx, botY, '#42a5f5');

    /* Centre rung (R2 shunt) */
    drawWire(bx, topY, bx, topY + 30, '#42a5f5');
    drawWire(bx, botY - 30, bx, botY, '#42a5f5');

    /* Bottom rail */
    drawWire(ax, botY, cx, botY, '#42a5f5');

    /* Resistors */
    drawResistorH(ax + 30, topY, bx - ax - 60, r1, 'R1');
    drawResistorV(bx, topY + 30, botY - topY - 60, r2, 'R2');
    drawResistorH(bx + 30, topY, cx - bx - 60, r3, 'R3');

    /* Batteries on the end rungs — V2 + terminal toward ground */
    drawBattery(ax, myLad, v1, true);
    drawBattery(cx, myLad, v2, true, true);

    /* Mesh arrows */
    drawMeshArrow((ax + bx) / 2, (topY + botY) / 2, 50, 'I₁', true);
    drawMeshArrow((bx + cx) / 2, (topY + botY) / 2, 50, 'I₂', true);

    /* Nodes */
    drawNodeLabel(ax, topY, 'A', v1);
    drawNodeLabel(bx, topY, 'B', phys.VB);
    drawNodeLabel(cx, topY, 'C', -v2);
    drawNodeLabel(bx, botY, 'D (GND)', undefined);

    /* Current arrows */
    drawCurrentArrow(ax + 30, topY, bx - 30, topY, phys.I1);
    drawCurrentArrow(bx + 30, topY, cx - 30, topY, phys.I2);
    drawCurrentArrow(bx, topY + 30, bx, botY - 30, phys.Ir2);

    /* Branch-current dots */
    drawCurrentDots([[ax, botY], [ax, topY]], phys.I1, time);
    drawCurrentDots([[ax, topY], [bx, topY]], phys.I1, time);
    drawCurrentDots([[bx, topY], [bx, botY]], phys.Ir2, time);
    drawCurrentDots([[bx, topY], [cx, topY]], phys.I2, time);
    drawCurrentDots([[cx, topY], [cx, botY]], phys.I2, time);
    drawCurrentDots([[bx, botY], [ax, botY]], phys.I1, time);
    drawCurrentDots([[cx, botY], [bx, botY]], phys.I2, time);

    drawGround(bx, botY + 10);
  }

  function drawThreeLoop(time) {
    /* 3-loop circuit
       A ──R1── B ──R3── C ──R5── F
       |        |        |        |
      V1       R2       R4       V3
       |        |        |        |
       G ────── H ────── J ────── K  (ground)
    */
    var ax = 80, ay = 100;
    var bx = 280, by = 100;
    var cx2 = 500, cy2 = 100;
    var fx = 720, fy = 100;
    var gy = 380;

    drawPowerGlow(ax, ay - 15, bx - ax, 30, phys.Pr1);
    drawPowerGlow(bx - 15, by, 30, gy - by, phys.Pr2);
    drawPowerGlow(bx, ay - 15, cx2 - bx, 30, phys.Pr3);
    drawPowerGlow(cx2 - 15, cy2, 30, gy - cy2, phys.Pr4);
    drawPowerGlow(cx2, ay - 15, fx - cx2, 30, phys.Pr5);

    /* Top wires */
    drawWire(ax, ay, ax + 25, ay, '#42a5f5');
    drawWire(bx - 25, by, bx, by, '#42a5f5');
    drawWire(bx, by, bx + 25, by, '#42a5f5');
    drawWire(cx2 - 25, cy2, cx2, cy2, '#42a5f5');
    drawWire(cx2, cy2, cx2 + 25, cy2, '#42a5f5');
    drawWire(fx - 25, fy, fx, fy, '#42a5f5');

    /* Vertical wires (split around the batteries) */
    var my3 = (ay + gy) / 2;
    drawWire(ax, ay, ax, my3 - 16, '#42a5f5');
    drawWire(ax, my3 + 16, ax, gy, '#42a5f5');
    drawWire(bx, by, bx, by + 25, '#42a5f5');
    drawWire(bx, gy - 25, bx, gy, '#42a5f5');
    drawWire(cx2, cy2, cx2, cy2 + 25, '#42a5f5');
    drawWire(cx2, gy - 25, cx2, gy, '#42a5f5');
    drawWire(fx, fy, fx, my3 - 16, '#42a5f5');
    drawWire(fx, my3 + 16, fx, gy, '#42a5f5');

    /* Bottom wires */
    drawWire(ax, gy, bx, gy, '#42a5f5');
    drawWire(bx, gy, cx2, gy, '#42a5f5');
    drawWire(cx2, gy, fx, gy, '#42a5f5');

    /* Resistors */
    drawResistorH(ax + 25, ay, bx - ax - 50, r1, 'R1');
    drawResistorV(bx, by + 25, gy - by - 50, r2, 'R2');
    drawResistorH(bx + 25, by, cx2 - bx - 50, r3, 'R3');
    drawResistorV(cx2, cy2 + 25, gy - cy2 - 50, r4, 'R4');
    drawResistorH(cx2 + 25, cy2, fx - cx2 - 50, r5, 'R5');

    /* Batteries — V3 + terminal toward ground (Loop 3: V3 = −I2R4 + I3(R4+R5)) */
    drawBattery(ax, my3, v1, true);
    drawBattery(fx, my3, v3, true, true);

    /* Mesh arrows */
    drawMeshArrow(180, 240, 42, 'I\u2081', true);
    drawMeshArrow(390, 240, 42, 'I\u2082', true);
    drawMeshArrow(610, 240, 42, 'I\u2083', true);

    /* Nodes */
    drawNodeLabel(ax, ay, 'A', v1);
    drawNodeLabel(bx, by, 'B', phys.VB);
    drawNodeLabel(cx2, cy2, 'C', undefined);
    drawNodeLabel(fx, fy, 'F', -v3);
    drawNodeLabel(bx, gy, 'GND', undefined);

    /* Current arrows */
    drawCurrentArrow(ax + 25, ay, bx - 25, ay, phys.I1);
    drawCurrentArrow(bx + 25, by, cx2 - 25, by, phys.I2);
    drawCurrentArrow(cx2 + 25, cy2, fx - 25, fy, phys.I3);
    drawCurrentArrow(bx, by + 25, bx, gy - 25, phys.Ir2);
    drawCurrentArrow(cx2, cy2 + 25, cx2, gy - 25, phys.Ir4);

    /* Branch-current dots */
    drawCurrentDots([[ax, gy], [ax, ay]], phys.I1, time);      /* V1 up */
    drawCurrentDots([[ax, ay], [bx, by]], phys.I1, time);      /* R1 */
    drawCurrentDots([[bx, by], [bx, gy]], phys.Ir2, time);     /* R2 down */
    drawCurrentDots([[bx, by], [cx2, cy2]], phys.I2, time);    /* R3 */
    drawCurrentDots([[cx2, cy2], [cx2, gy]], phys.Ir4, time);  /* R4 down */
    drawCurrentDots([[cx2, cy2], [fx, fy]], phys.I3, time);    /* R5 */
    drawCurrentDots([[fx, fy], [fx, gy]], phys.I3, time);      /* V3 down */
    drawCurrentDots([[bx, gy], [ax, gy]], phys.I1, time);      /* bottom H→G */
    drawCurrentDots([[cx2, gy], [bx, gy]], phys.I2, time);     /* bottom J→H */
    drawCurrentDots([[fx, gy], [cx2, gy]], phys.I3, time);     /* bottom K→J */

    drawGround(bx, gy + 10);
  }

  function drawGround(x, y) {
    ctx.strokeStyle = '#6b7a99';
    ctx.lineWidth = 2;
    ctx.beginPath(); ctx.moveTo(x - 12, y); ctx.lineTo(x + 12, y); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(x - 8, y + 5); ctx.lineTo(x + 8, y + 5); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(x - 4, y + 10); ctx.lineTo(x + 4, y + 10); ctx.stroke();
  }

  /* ================================================================
     DRAWING — MAIN DRAW (SIMULATE MODE)
