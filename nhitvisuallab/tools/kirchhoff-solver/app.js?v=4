    chkNodes.checked = true; chkNodes.parentElement.classList.add('checked');
    chkPower.checked = false; chkPower.parentElement.classList.remove('checked');
    var cps = circuitTabs.querySelectorAll('.pill');
    for (var i = 0; i < cps.length; i++) {
      cps[i].classList.toggle('active', cps[i].getAttribute('data-type') === 'hbridge');
    }
    updateCircuitUI();
    syncInputs();
    recompute();
    redrawForMode();
  }

  /* ── Calculation modal ───────────────────────────────────────── */
  function calcStep(num, title, formula, calculation, result) {
    var html = '<div class="cs-step"><div class="cs-step-hd">';
    html += '<span class="cs-num">Step ' + num + '</span>';
    html += '<span class="cs-title">' + title + '</span></div>';
    if (formula) html += '<div class="cs-formula">' + formula + '</div>';
    if (calculation) html += '<div class="cs-calc">' + calculation.replace(/\n/g, '<br>') + '</div>';
    if (result != null) html += '<div class="cs-result">→ <strong>' + result + '</strong></div>';
    html += '</div>';
    return html;
  }
  function rN(x, d) {
    if (!isFinite(x)) return String(x);
    var p = Math.pow(10, d || 0);
    return (Math.round(x * p) / p).toString();
  }

  function build2LoopSteps() {
    var det = (r1 + r2) * (r3 + r2) - r2 * r2;
    var h = '';
    h += calcStep(1, 'Write KVL around each mesh (clockwise)',
      '\\[ V_1 = I_1(R_1+R_2) - I_2 R_2 \\]\\[ V_2 = I_2(R_3+R_2) - I_1 R_2 \\]',
      '\\(' + v1.toFixed(1) + ' = I_1(' + (r1 + r2) + ') - I_2(' + r2 + ')\\)\n\\(' + v2.toFixed(1) + ' = I_2(' + (r3 + r2) + ') - I_1(' + r2 + ')\\)',
      null);
    h += calcStep(2, 'Determinant of the coefficient matrix',
      '\\[ \\Delta = (R_1+R_2)(R_3+R_2) - R_2^{2} \\]',
      '\\(\\Delta = ' + (r1 + r2) + ' \\times ' + (r3 + r2) + ' - ' + r2 + '^{2} = ' + det + '\\)',
      'Δ = ' + det + ' Ω²');
    h += calcStep(3, 'Mesh current I₁ (Cramer’s rule)',
      '\\[ I_1 = \\dfrac{V_1(R_3+R_2) + V_2 R_2}{\\Delta} \\]',
      '\\(I_1 = \\dfrac{' + v1.toFixed(1) + ' \\times ' + (r3 + r2) + ' + ' + v2.toFixed(1) + ' \\times ' + r2 + '}{' + det + '}\\)',
      rN(phys.I1 * 1000, 1) + ' mA');
    h += calcStep(4, 'Mesh current I₂',
      '\\[ I_2 = \\dfrac{V_2(R_1+R_2) + V_1 R_2}{\\Delta} \\]',
      '\\(I_2 = \\dfrac{' + v2.toFixed(1) + ' \\times ' + (r1 + r2) + ' + ' + v1.toFixed(1) + ' \\times ' + r2 + '}{' + det + '}\\)',
      rN(phys.I2 * 1000, 1) + ' mA');
    h += calcStep(5, 'Branch current through the shared resistor R₂',
      '\\[ I_{R_2} = I_1 - I_2 \\]',
      '\\(I_{R_2} = ' + rN(phys.I1 * 1000, 1) + ' - ' + rN(phys.I2 * 1000, 1) + '\\)',
      rN(phys.Ir2 * 1000, 1) + ' mA');
    h += calcStep(6, 'Voltage at node B',
      '\\[ V_B = V_1 - I_1 R_1 \\]',
      '\\(V_B = ' + v1.toFixed(1) + ' - ' + rN(phys.I1, 4) + ' \\times ' + r1 + '\\)',
      rN(phys.VB, 2) + ' V');
    h += calcStep(7, 'Power dissipation (P = I²R)',
      '\\[ P = I^{2} R, \\qquad P_{total} = \\sum I^{2} R \\]',
      '\\(P_{R1} = ' + rN(phys.Pr1 * 1000, 1) + '\\;mW,\\; P_{R2} = ' + rN(phys.Pr2 * 1000, 1) + '\\;mW,\\; P_{R3} = ' + rN(phys.Pr3 * 1000, 1) + '\\;mW\\)',
      'P_total = ' + rN(phys.Ptotal * 1000, 1) + ' mW');
    return h;
  }

  function build3LoopSteps() {
    var h = '';
    h += calcStep(1, 'Write KVL for the three meshes',
      '\\[ V_1 = I_1(R_1+R_2) - I_2 R_2 \\]\\[ 0 = -I_1 R_2 + I_2(R_2+R_3+R_4) - I_3 R_4 \\]\\[ V_3 = -I_2 R_4 + I_3(R_4+R_5) \\]',
      null, null);
    h += calcStep(2, 'Solve the 3×3 linear system (Cramer’s rule)',
      '\\[ \\mathbf{A}\\,\\mathbf{I} = \\mathbf{V} \\]',
      'Coefficient matrix built from R1…R5; right-hand side = (V1, 0, V3).',
      null);
    h += calcStep(3, 'Resulting mesh currents', null,
      '\\(I_1 = \\mathbf{' + rN(phys.I1 * 1000, 1) + '}\\;mA,\\; I_2 = \\mathbf{' + rN(phys.I2 * 1000, 1) + '}\\;mA,\\; I_3 = \\mathbf{' + rN(phys.I3 * 1000, 1) + '}\\;mA\\)',
      null);
    h += calcStep(4, 'Shared-branch currents',
      '\\[ I_{R_2} = I_1 - I_2, \\qquad I_{R_4} = I_2 - I_3 \\]',
      '\\(I_{R_2} = ' + rN(phys.Ir2 * 1000, 1) + '\\;mA\\)',
      rN(phys.Ir2 * 1000, 1) + ' mA');
    h += calcStep(5, 'Total power dissipated',
      '\\[ P_{total} = \\sum I^{2} R \\]',
      '\\(P_{total} = ' + rN(phys.Ptotal * 1000, 1) + '\\;mW\\)',
      rN(phys.Ptotal * 1000, 1) + ' mW');
    return h;
  }

  function buildCalcSteps() {
    var titleMap = { hbridge: 'H-Bridge', tnetwork: 'T-Network', ladder: 'Ladder', 'three-loop': '3-Loop' };
    var html = '<div class="cs-inputs"><span class="cs-badge">Given — ' + (titleMap[circuitType] || '') + '</span>';
    html += '<div class="cs-given">';
    html += '<span>V1 = ' + v1.toFixed(1) + ' V</span><span>V2 = ' + v2.toFixed(1) + ' V</span>';
    if (circuitType === 'three-loop') html += '<span>V3 = ' + v3.toFixed(1) + ' V</span>';
    html += '<span>R1 = ' + r1 + ' Ω</span><span>R2 = ' + r2 + ' Ω</span><span>R3 = ' + r3 + ' Ω</span>';
    if (circuitType === 'three-loop') html += '<span>R4 = ' + r4 + ' Ω</span><span>R5 = ' + r5 + ' Ω</span>';
    html += '</div>';
    html += '<p class="cs-si-note">ⓘ KVL applied per mesh, solved by Cramer’s rule. Currents in mA, power in mW.</p></div>';
    html += (circuitType === 'three-loop') ? build3LoopSteps() : build2LoopSteps();
    return html;
  }

