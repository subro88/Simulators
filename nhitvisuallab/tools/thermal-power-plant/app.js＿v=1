/* ─── 6. Massive 3D Boiler & Steam Drum Cutaway (Center Right) ─── */
function draw3DBoiler() {
  const bx = 830, by = 180, bw = 240, bh = 340, bd = 110;
  
  // 3D Boiler Outer Framework (Isometric Cutaway)
  // Left wall
  plantCtx.beginPath();
  plantCtx.moveTo(bx, by + 40);
  plantCtx.lineTo(bx + bd * 0.7, by);
  plantCtx.lineTo(bx + bd * 0.7, by + bh);
  plantCtx.lineTo(bx, by + bh + 40);
  plantCtx.closePath();
  plantCtx.fillStyle = '#1c2530';
  plantCtx.fill();
  plantCtx.strokeStyle = '#2d3b4e';
  plantCtx.lineWidth = 2;
  plantCtx.stroke();
  
  // Back & Right Wall Structure
  plantCtx.beginPath();
  plantCtx.moveTo(bx + bd * 0.7, by);
  plantCtx.lineTo(bx + bw + bd * 0.7, by + 50);
  plantCtx.lineTo(bx + bw + bd * 0.7, by + bh + 50);
  plantCtx.lineTo(bx + bd * 0.7, by + bh);
  plantCtx.closePath();
  plantCtx.fillStyle = '#263238';
  plantCtx.fill();
  plantCtx.stroke();
  
  // Open Cutaway Interior Glow (Furnace Chamber)
  const fg = plantCtx.createRadialGradient(bx + 110, by + 220, 20, bx + 110, by + 220, 140);
  const flameIntensity = (S.currentMW / 300);
  fg.addColorStop(0, `rgba(255, 140, 0, ${0.75 * flameIntensity})`);
  fg.addColorStop(0.4, `rgba(229, 57, 53, ${0.55 * flameIntensity})`);
  fg.addColorStop(1, 'rgba(0, 0, 0, 0)');
  plantCtx.fillStyle = fg;
  plantCtx.fillRect(bx + 15, by + 90, bw - 30, bh - 110);
  
  // Vertical Red Water-Wall Tubes Grid
  plantCtx.strokeStyle = '#ef5350';
  plantCtx.lineWidth = 3;
  for (let i = 0; i < 11; i++) {
    const wx = bx + 30 + i * 16;
    plantCtx.beginPath();
    plantCtx.moveTo(wx, by + 105);
    plantCtx.lineTo(wx, by + 300);
    plantCtx.stroke();
  }
  
  // Superheater serpentine coils (upper section)
  plantCtx.strokeStyle = '#ff7043';
  plantCtx.lineWidth = 3.5;
  for (let s = 0; s < 4; s++) {
    const sx = bx + 55 + s * 38;
    plantCtx.beginPath();
    for (let k = 0; k < 6; k++) {
      const sy = by + 120 + k * 14;
      const off = (k % 2 === 0) ? 14 : -14;
      if (k === 0) plantCtx.moveTo(sx + off, sy);
      else plantCtx.lineTo(sx + off, sy);
    }
    plantCtx.stroke();
  }
  
  // Animated Roaring Flame Tongues inside Furnace
  if (S.running) {
    const ft = S.t * Math.PI * 2;
    for (let f = 0; f < 6; f++) {
      const fx = bx + 45 + f * 26;
      const fy = by + 285;
      const fh = (60 + Math.sin(ft * 3 + f * 1.2) * 22) * flameIntensity;
      
      // Outer flame
      plantCtx.beginPath();
      plantCtx.moveTo(fx - 14, fy);
      plantCtx.quadraticCurveTo(fx - 18, fy - fh * 0.5, fx, fy - fh);
      plantCtx.quadraticCurveTo(fx + 18, fy - fh * 0.5, fx + 14, fy);
      plantCtx.closePath();
      plantCtx.fillStyle = 'rgba(255, 87, 34, 0.85)';
      plantCtx.fill();
      
      // Inner hot core
      plantCtx.beginPath();
      plantCtx.moveTo(fx - 6, fy);
      plantCtx.quadraticCurveTo(fx - 8, fy - fh * 0.4, fx, fy - fh * 0.75);
      plantCtx.quadraticCurveTo(fx + 8, fy - fh * 0.4, fx + 6, fy);
      plantCtx.closePath();
      plantCtx.fillStyle = 'rgba(255, 235, 59, 0.95)';
      plantCtx.fill();
    }
  }
  
  // 3D Steam Drum Cylinder at Boiler Crown
  const dx = bx + 30, dy = by + 15, dw = 160, dh = 30;
  plantCtx.beginPath();
  plantCtx.roundRect(dx, dy, dw, dh, 14);
  const drumGrad = plantCtx.createLinearGradient(dx, dy, dx, dy + dh);
  drumGrad.addColorStop(0, '#78909c');
  drumGrad.addColorStop(0.5, '#eceff1');
  drumGrad.addColorStop(1, '#37474f');
  plantCtx.fillStyle = drumGrad;
  plantCtx.fill();
  plantCtx.strokeStyle = '#263238';
  plantCtx.lineWidth = 2;
  plantCtx.stroke();
  
  plantCtx.fillStyle = '#0d47a1';
  plantCtx.font = 'bold 11px Segoe UI, sans-serif';
  plantCtx.textAlign = 'center';
  plantCtx.fillText('STEAM DRUM', dx + dw/2, dy + 19);
  
  // Large Red 3D Flow Arrows (Downpass circulation)
  plantCtx.fillStyle = '#d32f2f';
  plantCtx.beginPath();
  plantCtx.moveTo(bx + 175, by + 120);
  plantCtx.lineTo(bx + 195, by + 120);
  plantCtx.lineTo(bx + 195, by + 170);
  plantCtx.lineTo(bx + 208, by + 170);
  plantCtx.lineTo(bx + 185, by + 205);
  plantCtx.lineTo(bx + 162, by + 170);
  plantCtx.lineTo(bx + 175, by + 170);
  plantCtx.closePath();
  plantCtx.fill();
}

/* ─── 7. Coupled Steam Turbine & Generator Assembly (Center) ─── */
function drawCoupledTurbineGenerator() {
  // Common Bedplate Foundation
  plantCtx.beginPath();
  plantCtx.moveTo(330, 520);
  plantCtx.lineTo(710, 410);
  plantCtx.lineTo(730, 450);
  plantCtx.lineTo(350, 560);
  plantCtx.closePath();
  plantCtx.fillStyle = '#37474f';
  plantCtx.fill();
  plantCtx.strokeStyle = '#263238';
  plantCtx.lineWidth = 2;
  plantCtx.stroke();
  
  /* ─── Generator (Left unit) ─── */
  const gx = 355, gy = 480, gw = 125, gh = 65;
  
  // Generator 3D Cylinder Stator Housing (Yellow/Gold)
  plantCtx.beginPath();
  plantCtx.roundRect(gx, gy - gh/2, gw, gh, 10);
  const genGrad = plantCtx.createLinearGradient(gx, gy - gh/2, gx, gy + gh/2);
  genGrad.addColorStop(0, '#ffd54f');
  genGrad.addColorStop(0.4, '#ffb300');
  genGrad.addColorStop(1, '#ff8f00');
  plantCtx.fillStyle = genGrad;
  plantCtx.fill();
  plantCtx.strokeStyle = '#e65100';
  plantCtx.lineWidth = 2;
  plantCtx.stroke();
  
  // Front Inspection Hatch & Bearing Cap
  plantCtx.beginPath();
  plantCtx.ellipse(gx + 25, gy, 18, 24, 0, 0, Math.PI * 2);
  plantCtx.fillStyle = '#455a64';
  plantCtx.fill();
  plantCtx.strokeStyle = '#263238';
  plantCtx.stroke();
  
  // Generator Label
  plantCtx.fillStyle = '#ffffff';
  plantCtx.font = 'bold 12px Segoe UI, sans-serif';
  plantCtx.textAlign = 'center';
  plantCtx.fillText('GENERATOR', gx + gw/2 + 8, gy + 4);
  
  /* ─── DIRECT MECHANICAL COUPLING SHAFT (The Link) ─── */
  const cpx = gx + gw;
  const cpy = gy;
  const cpw = 36;
  
  // Central Steel Shaft
  plantCtx.fillStyle = '#b0bec5';
  plantCtx.fillRect(cpx, cpy - 9, cpw, 18);
  plantCtx.strokeStyle = '#37474f';
  plantCtx.lineWidth = 1.5;
  plantCtx.strokeRect(cpx, cpy - 9, cpw, 18);
  
  // Heavy Rigid Coupling Flange Collar (Orange/Red)
  plantCtx.fillStyle = '#e65100';
  plantCtx.fillRect(cpx + 8, cpy - 16, 20, 32);
  plantCtx.strokeStyle = '#bf360c';
  plantCtx.strokeRect(cpx + 8, cpy - 16, 20, 32);
  
  // Rotating Bolt Marks on Coupling
  if (S.running) {
    const rot = (S.t * S.simSpeed * 12) % Math.PI;
    plantCtx.fillStyle = '#ffffff';
    plantCtx.fillRect(cpx + 16, cpy - 12 + Math.sin(rot) * 10, 4, 4);
  }
  
  /* ─── Steam Turbine (Right unit - coupled) ─── */
  const tx = cpx + cpw, ty = gy - 10, tw = 120, th = 80;
  
  // Turbine 3D Stepped Casing (High Pressure to Low Pressure Expansion)
  plantCtx.beginPath();
  plantCtx.moveTo(tx, ty - th * 0.35);
  plantCtx.lineTo(tx + tw, ty - th * 0.55);
  plantCtx.lineTo(tx + tw, ty + th * 0.55);
  plantCtx.lineTo(tx, ty + th * 0.35);
  plantCtx.closePath();
  
  const turbGrad = plantCtx.createLinearGradient(tx, ty - th/2, tx, ty + th/2);
  turbGrad.addColorStop(0, '#78909c');
  turbGrad.addColorStop(0.5, '#b0bec5');
  turbGrad.addColorStop(1, '#455a64');
  plantCtx.fillStyle = turbGrad;
  plantCtx.fill();
  plantCtx.strokeStyle = '#263238';
  plantCtx.lineWidth = 2;
  plantCtx.stroke();
  
  // Cutaway Window showing Spinning Bladed Rotor inside Turbine
  const cutW = 75, cutH = 46;
  const cutX = tx + 18, cutY = ty - cutH/2;
  plantCtx.fillStyle = '#1e2836';
  plantCtx.fillRect(cutX, cutY, cutW, cutH);
  plantCtx.strokeStyle = '#00e5ff';
  plantCtx.lineWidth = 1.5;
  plantCtx.strokeRect(cutX, cutY, cutW, cutH);
  
  // Spinning Multi-Stage Turbine Blades
  if (S.running) {
    const bladeAngle = S.t * S.simSpeed * Math.PI * 16;
    for (let stage = 0; stage < 5; stage++) {
      const bx = cutX + 10 + stage * 13;
      const bScale = 1.0 + stage * 0.22;
      
      for (let b = 0; b < 6; b++) {
        const a = bladeAngle + (b / 6) * Math.PI * 2;
        const by = ty + Math.sin(a) * (14 * bScale);
        plantCtx.fillStyle = (b % 2 === 0) ? '#4fc3f7' : '#e0f7fa';
        plantCtx.fillRect(bx - 2, by - 2, 4, 4);
      }
    }
  }
  
  plantCtx.fillStyle = '#ffffff';
  plantCtx.font = 'bold 12px Segoe UI, sans-serif';
  plantCtx.textAlign = 'center';
  plantCtx.fillText('STEAM TURBINE', tx + tw/2, ty + th/2 + 18);
  
  /* ─── Condenser Box (Situated DIRECTLY Below Turbine) ─── */
  const cdx = tx - 10, cdy = ty + th/2 + 25, cdw = 105, cdh = 60;
  plantCtx.fillStyle = '#1e293b';
  plantCtx.fillRect(cdx, cdy, cdw, cdh);
  plantCtx.strokeStyle = '#38bdf8';
  plantCtx.lineWidth = 2;
  plantCtx.strokeRect(cdx, cdy, cdw, cdh);
  
  // Water level in condenser hotwell
  plantCtx.fillStyle = 'rgba(56, 189, 248, 0.4)';
  plantCtx.fillRect(cdx + 2, cdy + cdh - 22, cdw - 4, 20);
  
  plantCtx.fillStyle = '#38bdf8';
  plantCtx.font = 'bold 10px Segoe UI, sans-serif';
  plantCtx.fillText('CONDENSER', cdx + cdw/2, cdy + 20);
  plantCtx.font = '9px Segoe UI, sans-serif';
  plantCtx.fillText('0.07 bar vacuum', cdx + cdw/2, cdy + 33);
}

/* ─── 8. 3D Interconnecting Piping with Flow Animation ─── */
function draw3DPipes() {
  const t = S.t * S.simSpeed;
  
  // 1. High-Pressure Main Steam Pipes (Boiler Steam Drum -> Superheater -> Turbine)
  drawFlowPipe([
    [990, 215],
    [990, 150],
    [720, 150],
    [720, 420],
    [640, 420]
  ], '#ff3d00', 8, t * 1.5, 'steam');
  
  // 2. High-Pressure Steam Loop 2
  drawFlowPipe([
    [960, 215],
    [960, 135],
    [700, 135],
    [700, 400],
    [635, 400]
  ], '#ff6e40', 6, t * 1.5 + 0.3, 'steam');
  
  // 3. Feedwater Recovery Pipe (Condenser Hotwell -> Feed Pump -> Boiler Economiser)
  drawFlowPipe([
    [635, 600],
    [635, 630],
    [820, 630],
    [820, 390],
    [850, 390]
  ], '#00e5ff', 6, t * 0.9, 'water');
  
  // 4. Cooling Water Supply Pipe (Cooling Towers -> Condenser)
  drawFlowPipe([
    [240, 440],
    [320, 440],
    [520, 565],
    [560, 565]
  ], '#29b6f6', 6, t * 1.1, 'cool');
  
  // 5. Warm Cooling Water Return Pipe (Condenser -> Cooling Towers)
  drawFlowPipe([
    [560, 580],
    [500, 580],
    [300, 460],
    [220, 460]
  ], '#ff7043', 6, t * 1.1 + 0.5, 'warm');
  
  // 6. Flue Gas Duct (Boiler Outpass -> ESP -> Chimneys)
  drawFlowPipe([
    [1070, 440],
    [1110, 440],
    [1180, 480],
    [1250, 480]
  ], '#78909c', 10, t * 0.7, 'gas');
}

function drawFlowPipe(pts, color, width, flowPhase, type) {
  // Base outer pipe casing
  plantCtx.strokeStyle = '#1e293b';
  plantCtx.lineWidth = width + 4;
  plantCtx.lineCap = 'round';
  plantCtx.lineJoin = 'round';
  plantCtx.beginPath();
  plantCtx.moveTo(pts[0][0], pts[0][1]);
  for (let i = 1; i < pts.length; i++) plantCtx.lineTo(pts[i][0], pts[i][1]);
  plantCtx.stroke();
  
  // Inner colored pipe
  plantCtx.strokeStyle = color;
  plantCtx.lineWidth = width;
  plantCtx.stroke();
  
  // Animated moving dashed flow particles
  if (S.running) {
    plantCtx.strokeStyle = '#ffffff';
    plantCtx.lineWidth = width * 0.55;
    plantCtx.setLineDash([10, 16]);
    plantCtx.lineDashOffset = -flowPhase * 36;
    plantCtx.stroke();
    plantCtx.setLineDash([]);
  }
}

/* ─── 9. Hotspot Callout Badges & Labels ─── */
function drawHotspotBadges() {
  for (const hs of HOTSPOTS) {
    const isHovered = (hs.id === S.hoveredId);
    const pulse = Math.sin(S.t * 6) * 3;
    
    // Outer glow on hover
    if (isHovered) {
      plantCtx.beginPath();
      plantCtx.arc(hs.cx, hs.cy, 24 + pulse, 0, Math.PI * 2);
      plantCtx.fillStyle = 'rgba(229, 57, 53, 0.45)';
      plantCtx.fill();
    }
    
    // Circular Badge
    plantCtx.beginPath();
    plantCtx.arc(hs.cx, hs.cy, 16, 0, Math.PI * 2);
    plantCtx.fillStyle = isHovered ? '#d32f2f' : '#b71c1c';
    plantCtx.fill();
    plantCtx.strokeStyle = '#ffffff';
    plantCtx.lineWidth = 2.5;
    plantCtx.stroke();
    
    // Badge Number text
    plantCtx.fillStyle = '#ffffff';
    plantCtx.font = 'bold 13px Segoe UI, sans-serif';
    plantCtx.textAlign = 'center';
    plantCtx.textBaseline = 'middle';
    plantCtx.fillText(hs.label.charAt(0), hs.cx, hs.cy);
    plantCtx.textBaseline = 'alphabetic';
  }
}

/* ─────────────────────────────────────────────────────────────
   REAL-TIME TELEMETRY GRAPH ENGINE
   ───────────────────────────────────────────────────────────── */
function renderTelemetryGraph() {
  teleCtx.clearRect(0, 0, TW, TH);
  
  // Background
  teleCtx.fillStyle = '#0b0e14';
  teleCtx.fillRect(0, 0, TW, TH);
  
  // Grid Lines
  teleCtx.strokeStyle = 'rgba(42, 48, 80, 0.45)';
  teleCtx.lineWidth = 1;
  for (let y = 30; y < TH; y += 40) {
    teleCtx.beginPath();
    teleCtx.moveTo(60, y);
    teleCtx.lineTo(TW - 20, y);
    teleCtx.stroke();
  }
  for (let x = 60; x < TW - 20; x += 120) {
    teleCtx.beginPath();
    teleCtx.moveTo(x, 15);
    teleCtx.lineTo(x, TH - 25);
    teleCtx.stroke();
  }
  
  // Y-Axis Labels
  teleCtx.fillStyle = '#6b7a99';
  teleCtx.font = '10px Courier New, monospace';
  teleCtx.textAlign = 'right';
  teleCtx.fillText('100%', 52, 35);
  teleCtx.fillText('75%', 52, 75);
  teleCtx.fillText('50%', 52, 115);
  teleCtx.fillText('25%', 52, 155);
  teleCtx.fillText('0%', 52, TH - 25);
  
  const graphX = 60;
  const graphW = TW - 80;
  const graphH = TH - 45;
  const graphY0 = TH - 25;
  
  // Draw Traces
  if (S.traces.mw)   drawTrace(history.mw,   0, 320,  '#e53935', 2.5, graphX, graphW, graphH, graphY0);
  if (S.traces.temp) drawTrace(history.temp, 800, 1600, '#ff9800', 2.0, graphX, graphW, graphH, graphY0);
  if (S.traces.pres) drawTrace(history.pres, 0, 200,  '#29b6f6', 2.0, graphX, graphW, graphH, graphY0);
  if (S.traces.eff)  drawTrace(history.eff,  20, 50,  '#3ddc84', 2.0, graphX, graphW, graphH, graphY0);
  if (S.traces.coal) drawTrace(history.coal, 0, 130,  '#ab47bc', 2.0, graphX, graphW, graphH, graphY0);
}

function drawTrace(arr, minVal, maxVal, color, lineWidth, gx, gw, gh, gy0) {
  if (arr.length < 2) return;
  
  teleCtx.strokeStyle = color;
  teleCtx.lineWidth = lineWidth;
  teleCtx.beginPath();
  
  for (let i = 0; i < arr.length; i++) {
    const val = arr[i];
    const norm = Math.max(0, Math.min(1, (val - minVal) / (maxVal - minVal)));
    const px = gx + (i / (MAX_HISTORY - 1)) * gw;
    const py = gy0 - norm * gh;
    
    if (i === 0) teleCtx.moveTo(px, py);
    else teleCtx.lineTo(px, py);
  }
  teleCtx.stroke();
}

/* ─────────────────────────────────────────────────────────────
   MAIN ANIMATION LOOP
   ───────────────────────────────────────────────────────────── */
let lastFrameTime = performance.now();

function mainLoop(now) {
  const dt = Math.min(0.1, (now - lastFrameTime) / 1000.0);
  lastFrameTime = now;
  
  if (S.running) {
    S.t += dt * S.simSpeed;
    updatePhysics(dt);
  }
  
  render3DPlant();
  renderTelemetryGraph();
  
  requestAnimationFrame(mainLoop);
}

/* ─────────────────────────────────────────────────────────────
   EVENT LISTENERS & INTERACTION CONTROLS
   ───────────────────────────────────────────────────────────── */

// 1. Generation Slider Control
genSlider.addEventListener('input', e => {
  S.targetMW = parseFloat(e.target.value);
  genVal.textContent = `${S.targetMW.toFixed(0)} MW`;
});

// Preset Buttons (30%, 70%, 100%)
document.querySelectorAll('.btn-preset').forEach(btn => {
  btn.addEventListener('click', () => {
    const mw = parseFloat(btn.dataset.mw);
    genSlider.value = mw;
    S.targetMW = mw;
    genVal.textContent = `${mw.toFixed(0)} MW`;
  });
});

// 2. Play / Pause & Reset Controls
btnStart.addEventListener('click', () => {
  S.running = !S.running;
  btnStart.innerHTML = S.running ? '&#9616;&#9616; Pause' : '&#9654; Run';
});

btnReset.addEventListener('click', () => {
  S.zoom = 1.0;
  S.panX = 0; S.panY = 0;
  S.targetMW = 210;
  S.currentMW = 210;
  genSlider.value = 210;
  genVal.textContent = '210 MW';
  S.running = true;
  btnStart.innerHTML = '&#9616;&#9616; Pause';
});

// 3. Animation Speed Slider
speedSlider.addEventListener('input', e => {
  S.simSpeed = parseFloat(e.target.value);
  speedVal.textContent = `${S.simSpeed.toFixed(1)}×`;
});

// 4. Trace Filter Buttons for Telemetry Graph
document.querySelectorAll('.trace-pill').forEach(btn => {
  btn.addEventListener('click', () => {
    const trace = btn.dataset.trace;
    S.traces[trace] = !S.traces[trace];
    btn.classList.toggle('active', S.traces[trace]);
  });
});

// 5. Mode Tabs (Simulate / Explore / Info)
document.querySelectorAll('#mode-tabs .pill').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('#mode-tabs .pill').forEach(p => p.classList.remove('active'));
    btn.classList.add('active');
    S.mode = btn.dataset.mode;
    
    const note = document.getElementById('explore-note');
    if (note) note.style.display = (S.mode === 'explore') ? 'block' : 'none';
    if (S.mode !== 'explore' && expPanel) expPanel.classList.remove('visible');
  });
});

// 6. Smooth Mouse Wheel Zoom (0.3x to 5.0x centered at cursor)
plantCanvas.addEventListener('wheel', e => {
  e.preventDefault();
  const factor = e.deltaY < 0 ? 1.12 : 0.89;
  const rect = plantCanvas.getBoundingClientRect();
  const mx = (e.clientX - rect.left) * (PW / rect.width);
  const my = (e.clientY - rect.top)  * (PH / rect.height);
  
  S.panX = mx - (mx - S.panX) * factor;
  S.panY = my - (my - S.panY) * factor;
  S.zoom = Math.max(0.3, Math.min(5.0, S.zoom * factor));
}, { passive: false });

// 7. Mouse Drag Panning
plantCanvas.addEventListener('mousedown', e => {
  if (e.button === 0) {
    S.dragStart = { x: e.clientX - S.panX, y: e.clientY - S.panY };
  }
});
window.addEventListener('mousemove', e => {
  if (S.dragStart) {
    S.panX = e.clientX - S.dragStart.x;
    S.panY = e.clientY - S.dragStart.y;
  }
});
window.addEventListener('mouseup', () => { S.dragStart = null; });

// 8. Tooltip Inspection & Explore Click
plantCanvas.addEventListener('mousemove', e => {
  if (S.dragStart) return;
  const rect = plantCanvas.getBoundingClientRect();
  const mx = ((e.clientX - rect.left) * (PW / rect.width) - S.panX) / S.zoom;
  const my = ((e.clientY - rect.top)  * (PH / rect.height) - S.panY) / S.zoom;
  
  let found = null;
  for (const hs of HOTSPOTS) {
    if (Math.hypot(mx - hs.cx, my - hs.cy) < hs.r) {
      found = hs;
      break;
    }
  }
  
  if (found) {
    S.hoveredId = found.id;
    tooltip.innerHTML = found.html;
    
    // Inject real-time parameters into tooltip
    const tipMw = document.getElementById('tip-gen-mw');
    if (tipMw) tipMw.textContent = `${S.currentMW.toFixed(1)} MW`;
    const tipTemp = document.getElementById('tip-boiler-temp');
    if (tipTemp) tipTemp.textContent = `${S.boilerTemp.toFixed(0)} °C`;
    const tipPres = document.getElementById('tip-steam-pres');
    if (tipPres) tipPres.textContent = `${S.steamPres.toFixed(1)} bar`;
    const tipCoal = document.getElementById('tip-coal-feed');
    if (tipCoal) tipCoal.textContent = `${S.coalFeed.toFixed(1)} t/hr`;
    
    tooltip.classList.add('visible');
    
    const tx = Math.min(e.clientX + 16, window.innerWidth - 360);
    const ty = Math.max(10, Math.min(e.clientY - 10, window.innerHeight - 280));
    tooltip.style.left = `${tx}px`;
    tooltip.style.top  = `${ty}px`;
  } else {
    S.hoveredId = null;
    tooltip.classList.remove('visible');
  }
});

plantCanvas.addEventListener('mouseleave', () => {
  S.hoveredId = null;
  tooltip.classList.remove('visible');
});

// Click in Explore Mode -> Display Spec Panel
plantCanvas.addEventListener('click', e => {
  if (S.mode !== 'explore') return;
  const rect = plantCanvas.getBoundingClientRect();
  const mx = ((e.clientX - rect.left) * (PW / rect.width) - S.panX) / S.zoom;
  const my = ((e.clientY - rect.top)  * (PH / rect.height) - S.panY) / S.zoom;
  
  for (const hs of HOTSPOTS) {
    if (Math.hypot(mx - hs.cx, my - hs.cy) < hs.r && hs.explore) {
      showExplorePanel(hs);
      return;
    }
  }
});

function showExplorePanel(hs) {
  const ep = hs.explore;
  const statsHtml = ep.stats.map(([k,v]) =>
    `<div class="explore-stat"><span class="explore-stat-key">${k}</span><span class="explore-stat-val">${v}</span></div>`
  ).join('');
  const formulaHtml = ep.formula
    ? `<div class="explore-formula"><strong>Key Formulae:</strong><br>${ep.formula.replace(/\n/g,'<br>')}</div>`
    : '';
  expPanel.innerHTML = `
    <div class="explore-panel-header">
      <div class="ep-num">${ep.num}</div>
      <h3>${ep.title}</h3>
    </div>
    <div class="explore-body">
      <div class="explore-desc">${ep.desc.replace(/\n/g,'<br>')}</div>
      <div>
        <div class="explore-stats">${statsHtml}</div>
        ${formulaHtml}
      </div>
    </div>
    <button class="explore-close" onclick="document.getElementById('explore-panel').classList.remove('visible')">✕ Close</button>
  `;
  expPanel.classList.add('visible');
  expPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

/* ─────────────────────────────────────────────────────────────
   START APPLICATION
   ───────────────────────────────────────────────────────────── */
requestAnimationFrame(mainLoop);

})();
