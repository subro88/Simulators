/* ─────────────────────────────────────────────────────────────
   PHYSICS ENGINE & TELEMETRY UPDATER
   ───────────────────────────────────────────────────────────── */
let lastTelemetryUpdate = 0;

function updatePhysics(dt) {
  // First-order lag response to target MW setpoint (thermal inertia)
  const lagSpeed = S.simSpeed * 1.5 * dt;
  S.currentMW += (S.targetMW - S.currentMW) * Math.min(1, lagSpeed);
  
  // Correlated thermodynamics variables based on current MW load ratio
  const loadRatio = S.currentMW / 300.0; // 0.2 to 1.0
  
  // Minor realistic sinusoidal noise
  const noise1 = Math.sin(S.t * 2.5) * 0.8;
  const noise2 = Math.cos(S.t * 1.7) * 0.4;
  
  S.boilerTemp   = 1150 + loadRatio * 320 + noise1 * 4;           // 1150°C -> 1470°C
  S.steamPres    = 90 + loadRatio * 85 + noise2 * 0.8;             // 90 bar -> 175 bar
  S.steamFlow    = 180 + loadRatio * 750 + noise1 * 5;             // 180 t/h -> 930 t/h
  S.coalFeed     = 25 + loadRatio * 82 + noise2 * 0.5;             // 25 t/h -> 107 t/h
  S.flueGasFlow  = 220 + loadRatio * 700;                          // kNm3/h
  S.turbineRpm   = 3000 + (Math.sin(S.t * 8.0) * 0.4);             // Solid 3000 RPM
  
  // Thermal efficiency curve: peaks around 75-85% load
  const optimalLoad = 0.78;
  const dev = loadRatio - optimalLoad;
  S.efficiency   = 41.2 - (dev * dev * 14.0) + (noise1 * 0.05);   // ~37% to 41.2%
  
  // Push to history rolling buffer every 100ms
  const now = performance.now();
  if (now - lastTelemetryUpdate > 100) {
    lastTelemetryUpdate = now;
    history.time.push(history.time.length);
    history.mw.push(S.currentMW);
    history.temp.push(S.boilerTemp);
    history.pres.push(S.steamPres);
    history.eff.push(S.efficiency);
    history.coal.push(S.coalFeed);
    
    if (history.time.length > MAX_HISTORY) {
      history.time.shift();
      history.mw.shift();
      history.temp.shift();
      history.pres.shift();
      history.eff.shift();
      history.coal.shift();
    }
  }
  
  // Update Live Badges
  document.getElementById('r-power-mw').textContent    = S.currentMW.toFixed(1);
  document.getElementById('r-boiler-temp').textContent = S.boilerTemp.toFixed(0);
  document.getElementById('r-steam-pres').textContent  = S.steamPres.toFixed(1);
  document.getElementById('r-turbine-rpm').textContent = S.turbineRpm.toFixed(0);
  document.getElementById('r-efficiency').textContent  = S.efficiency.toFixed(1);
  document.getElementById('r-coal-feed').textContent   = S.coalFeed.toFixed(1);
}

/* ─────────────────────────────────────────────────────────────
   3D ISOMETRIC PROJECTION RENDERING ENGINE
   ───────────────────────────────────────────────────────────── */
function render3DPlant() {
  plantCtx.clearRect(0, 0, PW, PH);
  plantCtx.save();
  
  // Apply Zoom & Pan Transform
  plantCtx.translate(S.panX, S.panY);
  plantCtx.scale(S.zoom, S.zoom);
  
  // 1. Background Environment & Lake
  drawEnvironment();
  
  // 2. Island, Cooling Towers & Water Channels (Left)
  drawIslandAndCoolingTowers();
  
  // 3. Grid Pylons & Step-Up Transformer (Top Left - Clean No Overlap)
  drawGridAndTransformer();
  
  // 4. Coal Yard, Heap & Conveyor Trestle (Bottom)
  drawCoalSystem();
  
  // 5. ESP & Triple Chimneys (Far Right)
  drawESPAndChimneys();
  
  // 6. Massive 3D Boiler & Steam Drum Cutaway (Center Right)
  draw3DBoiler();
  
  // 7. Directly Coupled Steam Turbine & Generator Assembly (Center)
  drawCoupledTurbineGenerator();
  
  // 8. 3D Interconnecting Piping with Flow Animation
  draw3DPipes();
  
  // 9. Hotspot Callout Badges & Labels
  drawHotspotBadges();
  
  plantCtx.restore();
}

/* ─── 1. Background Environment ─── */
function drawEnvironment() {
  // Deep gradient background
  const bgGrad = plantCtx.createLinearGradient(0, 0, PW, PH);
  bgGrad.addColorStop(0, '#0d121c');
  bgGrad.addColorStop(0.6, '#131b2a');
  bgGrad.addColorStop(1, '#0b0f17');
  plantCtx.fillStyle = bgGrad;
  plantCtx.fillRect(0, 0, PW, PH);
  
  // Subtle isometric plant ground slab (gray concrete pad)
  plantCtx.beginPath();
  plantCtx.moveTo(280, 520);
  plantCtx.lineTo(760, 270);
  plantCtx.lineTo(1390, 480);
  plantCtx.lineTo(910, 740);
  plantCtx.closePath();
  plantCtx.fillStyle = '#18202e';
  plantCtx.fill();
  plantCtx.strokeStyle = '#223048';
  plantCtx.lineWidth = 2;
  plantCtx.stroke();
  
  // Isometric floor grid lines on concrete slab
  plantCtx.strokeStyle = 'rgba(42, 60, 90, 0.25)';
  plantCtx.lineWidth = 1;
  for (let i = 1; i < 8; i++) {
    const t = i / 8;
    // Axis 1
    plantCtx.beginPath();
    plantCtx.moveTo(280 + (760 - 280) * t, 520 + (270 - 520) * t);
    plantCtx.lineTo(910 + (1390 - 910) * t, 740 + (480 - 740) * t);
    plantCtx.stroke();
    // Axis 2
    plantCtx.beginPath();
    plantCtx.moveTo(280 + (910 - 280) * t, 520 + (740 - 520) * t);
    plantCtx.lineTo(760 + (1390 - 760) * t, 270 + (480 - 270) * t);
    plantCtx.stroke();
  }
}

