function drawSingleCoolingTower(cx, cy, w, h) {
  const topW = w * 0.55;
  const waistW = w * 0.42;
  const botW = w;
  
  // Tower body
  plantCtx.beginPath();
  plantCtx.moveTo(cx - botW/2, cy);
  plantCtx.bezierCurveTo(cx - waistW, cy - h*0.45, cx - waistW, cy - h*0.75, cx - topW/2, cy - h);
  plantCtx.lineTo(cx + topW/2, cy - h);
  plantCtx.bezierCurveTo(cx + waistW, cy - h*0.75, cx + waistW, cy - h*0.45, cx + botW/2, cy);
  plantCtx.closePath();
  
  const twGrad = plantCtx.createLinearGradient(cx - w, cy, cx + w, cy);
  twGrad.addColorStop(0, '#546e7a');
  twGrad.addColorStop(0.5, '#90a4ae');
  twGrad.addColorStop(1, '#37474f');
  plantCtx.fillStyle = twGrad;
  plantCtx.fill();
  plantCtx.strokeStyle = '#263238';
  plantCtx.lineWidth = 1.5;
  plantCtx.stroke();
  
  // Top lip ellipse
  plantCtx.beginPath();
  plantCtx.ellipse(cx, cy - h, topW/2, 6, 0, 0, Math.PI * 2);
  plantCtx.fillStyle = '#263238';
  plantCtx.fill();
  plantCtx.strokeStyle = '#78909c';
  plantCtx.stroke();
  
  // Animated Steam / Vapor Plume Rising
  if (S.running) {
    const loadFactor = S.currentMW / 300;
    for (let p = 0; p < 5; p++) {
      const pt = (S.t * 0.6 + p / 5) % 1;
      const py = (cy - h) - pt * (70 + loadFactor * 50);
      const px = cx + Math.sin(p * 2 + S.t * 3) * (10 + pt * 18);
      const pr = 8 + pt * 22;
      const alpha = (1 - pt) * 0.35 * loadFactor;
      
      plantCtx.beginPath();
      plantCtx.arc(px, py, pr, 0, Math.PI * 2);
      plantCtx.fillStyle = `rgba(224, 242, 254, ${alpha})`;
      plantCtx.fill();
    }
  }
}

/* ─── 3. Grid Pylons & Step-Up Transformer (Top Left - No Overlap) ─── */
function drawGridAndTransformer() {
  // Step-Up Transformer (Yellow 3D isometric cuboid)
  const tx = 345, ty = 205, tw = 65, th = 60, td = 40;
  
  // Transformer Front Face
  plantCtx.fillStyle = '#ffb300';
  plantCtx.fillRect(tx, ty, tw, th);
  plantCtx.strokeStyle = '#c67c00';
  plantCtx.lineWidth = 2;
  plantCtx.strokeRect(tx, ty, tw, th);
  
  // Transformer Top Face
  plantCtx.beginPath();
  plantCtx.moveTo(tx, ty);
  plantCtx.lineTo(tx + td * 0.7, ty - td * 0.5);
  plantCtx.lineTo(tx + tw + td * 0.7, ty - td * 0.5);
  plantCtx.lineTo(tx + tw, ty);
  plantCtx.closePath();
  plantCtx.fillStyle = '#ffd54f';
  plantCtx.fill();
  plantCtx.stroke();
  
  // Transformer Right Face
  plantCtx.beginPath();
  plantCtx.moveTo(tx + tw, ty);
  plantCtx.lineTo(tx + tw + td * 0.7, ty - td * 0.5);
  plantCtx.lineTo(tx + tw + td * 0.7, ty + th - td * 0.5);
  plantCtx.lineTo(tx + tw, ty + th);
  plantCtx.closePath();
  plantCtx.fillStyle = '#ffa000';
  plantCtx.fill();
  plantCtx.stroke();
  
  // High Voltage Bushings on Top
  for (let b = 0; b < 3; b++) {
    const bx = tx + 15 + b * 20;
    const by = ty - 12;
    plantCtx.fillStyle = '#37474f';
    plantCtx.fillRect(bx - 3, by, 6, 12);
    plantCtx.beginPath();
    plantCtx.arc(bx, by, 5, 0, Math.PI * 2);
    plantCtx.fillStyle = '#cfd8dc';
    plantCtx.fill();
  }
  
  // Lightning Bolt Emblem on front
  plantCtx.beginPath();
  plantCtx.moveTo(tx + tw/2 + 2, ty + 15);
  plantCtx.lineTo(tx + tw/2 - 8, ty + 33);
  plantCtx.lineTo(tx + tw/2 + 1, ty + 33);
  plantCtx.lineTo(tx + tw/2 - 4, ty + 48);
  plantCtx.lineTo(tx + tw/2 + 9, ty + 28);
  plantCtx.lineTo(tx + tw/2 + 1, ty + 28);
  plantCtx.closePath();
  plantCtx.fillStyle = '#212121';
  plantCtx.fill();
  
  // Isolated Phase Busduct (IPB) from Generator to Transformer
  plantCtx.strokeStyle = '#f57c00';
  plantCtx.lineWidth = 6;
  plantCtx.beginPath();
  plantCtx.moveTo(410, 455);
  plantCtx.lineTo(410, 310);
  plantCtx.lineTo(375, 275);
  plantCtx.stroke();
  
  // Transmission Pylon 1 (High in Background - Well Separated from Transformer)
  drawLatticePylon(240, 155, 95);
  
  // Transmission Pylon 2 (Further Back towards Village)
  drawLatticePylon(120, 115, 75);
  
  // Overhead Catenary Power Transmission Lines
  plantCtx.strokeStyle = '#90a4ae';
  plantCtx.lineWidth = 1.5;
  for (let l = 0; l < 3; l++) {
    const off = l * 6;
    // From Transformer to Pylon 1
    plantCtx.beginPath();
    plantCtx.moveTo(tx + 15 + l*18, ty - 12);
    plantCtx.quadraticCurveTo(280, 130 + off, 240, 85 + off);
    plantCtx.stroke();
    
    // From Pylon 1 to Pylon 2
    plantCtx.beginPath();
    plantCtx.moveTo(240, 85 + off);
    plantCtx.quadraticCurveTo(180, 95 + off, 120, 60 + off);
    plantCtx.stroke();
  }
  
  // Distant Village Houses on green hill
  drawMiniHouse(55, 115);
  drawMiniHouse(85, 105);
}

function drawLatticePylon(px, py, h) {
  plantCtx.strokeStyle = '#78909c';
  plantCtx.lineWidth = 1.5;
  
  // Main lattice legs
  plantCtx.beginPath();
  plantCtx.moveTo(px - 16, py);
  plantCtx.lineTo(px, py - h);
  plantCtx.lineTo(px + 16, py);
  plantCtx.stroke();
  
  // Crossarms
  plantCtx.beginPath();
  plantCtx.moveTo(px - 28, py - h * 0.75);
  plantCtx.lineTo(px + 28, py - h * 0.75);
  plantCtx.moveTo(px - 22, py - h * 0.55);
  plantCtx.lineTo(px + 22, py - h * 0.55);
  plantCtx.stroke();
  
  // Diagonal braces
  plantCtx.beginPath();
  plantCtx.moveTo(px - 14, py - 15); plantCtx.lineTo(px + 10, py - 35);
  plantCtx.moveTo(px + 14, py - 15); plantCtx.lineTo(px - 10, py - 35);
  plantCtx.moveTo(px - 10, py - 35); plantCtx.lineTo(px + 6, py - 55);
  plantCtx.moveTo(px + 10, py - 35); plantCtx.lineTo(px - 6, py - 55);
  plantCtx.stroke();
  
  // Glass disc insulator strings
  for (let i = -1; i <= 1; i++) {
    plantCtx.fillStyle = '#b0bec5';
    plantCtx.fillRect(px + i * 22 - 2, py - h * 0.75, 4, 10);
  }
}

function drawMiniHouse(hx, hy) {
  plantCtx.fillStyle = '#c62828';
  plantCtx.beginPath();
  plantCtx.moveTo(hx, hy - 12);
  plantCtx.lineTo(hx - 10, hy - 4);
  plantCtx.lineTo(hx + 10, hy - 4);
  plantCtx.closePath();
  plantCtx.fill();
  
  plantCtx.fillStyle = '#eceff1';
  plantCtx.fillRect(hx - 8, hy - 4, 16, 12);
  plantCtx.fillStyle = '#ffb300';
  plantCtx.fillRect(hx - 4, hy - 1, 4, 4);
}

