    for (let c = 0; c < numLumps; c++) {
      const ct = (S.t * S.simSpeed * 0.7 + c / numLumps) % 1;
      const cx = x1 + (x2 - x1) * ct;
      const cy = y1 + (y2 - y1) * ct - 4;
      
      plantCtx.beginPath();
      plantCtx.arc(cx, cy, 4, 0, Math.PI * 2);
      plantCtx.fillStyle = '#0a0a0f';
      plantCtx.fill();
    }
  }
}

