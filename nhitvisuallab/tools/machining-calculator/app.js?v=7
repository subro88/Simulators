        '<div class="formula">' + item.formula.replace(/\n/g, '<br>') + '</div>' +
        '<p>' + item.desc + '</p>' +
        '<div class="example"><strong>Worked Example:</strong><br>' + item.example.replace(/\n/g, '<br>') + '</div>';
