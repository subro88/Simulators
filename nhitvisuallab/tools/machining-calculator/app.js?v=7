      return { q: 'Find the motor power for Q = ' + mrr + ' mm\u00B3/min cutting ' + MATERIALS[mi].name + ' with k\u1D9C = ' + kc + ' N/mm\u00B2 and \u03B7 = 0.75.', a: P, u: 'kW', tol: Math.max(0.02, P * 0.03),
        sol: 'P\u1D9C = Q \u00D7 k\u1D9C / (60 \u00D7 10\u2076)\nP\u1D9C = ' + mrr + ' \u00D7 ' + kc + ' / 60 000 000 = ' + round(mrr * kc / 6e7, 3) + ' kW\nP_motor = P\u1D9C / \u03B7 = ' + round(mrr * kc / 6e7, 3) + ' / 0.75\nP_motor = ' + P + ' kW' };
    },
    function () {
      var n = [0.125, 0.25, 0.45][Math.floor(Math.random() * 3)];
      var C = [180, 250, 300, 350, 400][Math.floor(Math.random() * 5)];
      var V = 80 + Math.floor(Math.random() * 200);
      var T = round(Math.pow(C / V, 1 / n), 2);
      return { q: 'Taylor: with C = ' + C + ' and n = ' + n + ', find the tool life at a cutting speed of ' + V + ' m/min.', a: T, u: 'min', tol: Math.max(0.05, T * 0.04),
        sol: 'V \u00D7 T\u207F = C  \u21D2  T = (C / V)^(1/n)\nT = (' + C + ' / ' + V + ')^(1/' + n + ')\nT = ' + round(C / V, 3) + '^' + round(1 / n, 3) + '\nT = ' + T + ' min' };
    },
    function () {
      var f = round(0.08 + Math.random() * 0.3, 2);
      var re = [0.2, 0.4, 0.8, 1.2][Math.floor(Math.random() * 4)];
      var Ra = round(f * f * 1000 / (31.2 * re), 2);
      return { q: 'Estimate the theoretical surface finish Ra for turning at f = ' + f + ' mm/rev with a nose radius of ' + re + ' mm.', a: Ra, u: '\u00B5m', tol: Math.max(0.02, Ra * 0.03),
        sol: 'R\u2090 \u2248 f\u00B2 / (31.2 \u00D7 r\u03B5)   [f, r\u03B5 in mm \u2192 Ra in mm]\nR\u2090 = ' + f + '\u00B2 \u00D7 1000 / (31.2 \u00D7 ' + re + ')\nR\u2090 = ' + Ra + ' \u00B5m' };
    },
    function () {
      var D = 6 + Math.floor(Math.random() * 18);
      var f = round(0.08 + Math.random() * 0.2, 2);
      var mi = Math.floor(Math.random() * MATERIALS.length);
      var m = MATERIALS[mi];
      var h = (f / 2) * Math.sin(59 * Math.PI / 180);
      var kc = m.kc11 * Math.pow(h, -m.mc);
      var M = round(kc * f * D * D / 8000, 2);
      return { q: 'Find the drilling torque for a ' + D + ' mm drill in ' + m.name + ' at f = ' + f + ' mm/rev. Use k\u1D9C = ' + round(kc, 0) + ' N/mm\u00B2 and M\u1D9C = k\u1D9C f D\u00B2 / 8000.', a: M, u: 'N\u00B7m', tol: Math.max(0.05, M * 0.03),
        sol: 'M\u1D9C = k\u1D9C \u00D7 f \u00D7 D\u00B2 / 8000\nM\u1D9C = ' + round(kc, 0) + ' \u00D7 ' + f + ' \u00D7 ' + D + '\u00B2 / 8000\nM\u1D9C = ' + M + ' N\u00B7m' };
    }
  ];

  var pracNewBtn   = $('prac-new');
  var pracCheckBtn = $('prac-check');
  var pracShowBtn  = $('prac-show');
  var pracInput    = $('prac-input');
  var pracQuestion = $('prac-question');
  var pracUnitEl   = $('prac-unit');
  var pracFeedback = $('prac-feedback');
  var pracScoreEl  = $('prac-score');
  var pracSolPanel = $('prac-solution');

  function newPractice() {
    var gen = PRACTICE_GENERATORS[Math.floor(Math.random() * PRACTICE_GENERATORS.length)];
    var prob = gen();
    pracAnswer = prob.a;
    pracUnit = prob.u;
    pracSolution = prob.sol;
    pracQuestion.textContent = prob.q;
    pracUnitEl.textContent = prob.u;
    pracInput.value = '';
    pracFeedback.textContent = '';
    pracFeedback.className = 'feedback';
    pracSolPanel.style.display = 'none';
    pracInput.focus();
    /* A per-question tolerance, never a blanket 0.5 — several answers
       here are legitimately below 1. */
    pracInput._tol = prob.tol;
  }

  if (pracNewBtn) pracNewBtn.addEventListener('click', newPractice);

  if (pracCheckBtn) pracCheckBtn.addEventListener('click', function () {
    var val = parseFloat(pracInput.value);
    if (isNaN(val)) { pracFeedback.textContent = 'Enter a number.'; pracFeedback.className = 'feedback err'; return; }
    pracTotal++;
    var tol = pracInput._tol;
    if (!(tol > 0)) tol = Math.max(Math.abs(pracAnswer) * 0.02, Math.abs(pracAnswer) < 10 ? 0.01 : 0.5);
    if (Math.abs(val - pracAnswer) <= tol) {
      pracScore++;
      pracFeedback.textContent = 'Correct!';
      pracFeedback.className = 'feedback ok';
    } else {
      pracFeedback.textContent = 'Incorrect. Answer: ' + pracAnswer + ' ' + pracUnit;
      pracFeedback.className = 'feedback err';
    }
    pracScoreEl.textContent = pracScore + ' / ' + pracTotal;
  });

  if (pracShowBtn) pracShowBtn.addEventListener('click', function () {
    pracSolPanel.style.display = '';
    var lines = pracSolution.split('\n');
    pracSolPanel.innerHTML = '<strong>Solution:</strong><br>' + lines.map(function (l) { return '<div class="step">' + (l || '&nbsp;') + '</div>'; }).join('');
  });

  if (pracInput) pracInput.addEventListener('keydown', function (e) { if (e.key === 'Enter') pracCheckBtn.click(); });

  /* ══════════════════════════════════════════════════════════
     20. QUIZ MODE
  ══════════════════════════════════════════════════════════ */
  var QUIZ_SIZE = 5;
  var quizSet = [], quizIdx = 0, quizScore = 0, quizAnswered = false;

  var QUIZ_POOL = [
    { type: 'mcq', q: 'Which formula correctly calculates spindle speed from cutting speed?', opts: ['N = 1000V / (\u03C0D)', 'N = \u03C0D / (1000V)', 'N = V \u00D7 D / 1000', 'N = 1000 / (V\u03C0D)'], ans: 0 },
    { type: 'mcq', q: 'Which material allows the highest cutting speed with carbide tools?', opts: ['Stainless Steel', 'Titanium', 'Aluminium', 'Cast Iron'], ans: 2 },
    { type: 'mcq', q: 'In the Kienzle equation k\u1D9C = k\u1D9C\u2081.\u2081 h\u207B\u1D50\u1D9C, what happens as the chip gets thinner?', opts: ['k\u1D9C falls', 'k\u1D9C rises', 'k\u1D9C is unchanged', 'k\u1D9C becomes negative'], ans: 1 },
    { type: 'mcq', q: 'In milling, the table feed rate equals:', opts: ['f \u00D7 N', 'f\u2082 \u00D7 z \u00D7 N', 'V \u00D7 D', 'f\u2082 \u00D7 N / z'], ans: 1 },
    { type: 'mcq', q: 'Facing a bar at constant RPM: what happens to the cutting speed as the tool moves towards centre?', opts: ['It rises', 'It stays constant', 'It falls to zero', 'It doubles'], ans: 2 },
    { type: 'mcq', q: 'Machine efficiency (\u03B7) in power calculations is typically:', opts: ['0.50', '0.75', '0.90', '1.00'], ans: 1 },
    { type: 'mcq', q: 'Radial engagement below about 30% of the cutter diameter thins the chip. The correct response is to:', opts: ['Reduce the feed per tooth', 'Increase the feed per tooth', 'Reduce the spindle speed', 'Increase the depth of cut only'], ans: 1 },
    { type: 'mcq', q: 'In Taylor\u2019s equation VT\u207F = C, which tool material has the LARGEST exponent n?', opts: ['HSS', 'Carbide', 'Ceramic', 'They are all equal'], ans: 2 },
    { type: 'mcq', q: 'Why must the drill point length (about 0.3D) be added when drilling a through hole?', opts: ['To allow for tool wear', 'Because the conical point must clear the far face', 'To account for chip packing', 'To allow for spindle run-out'], ans: 1 },
    { type: 'mcq', q: 'In tapping, the feed per revolution must equal:', opts: ['Half the pitch', 'The thread pitch', 'The tap diameter', 'The chamfer length'], ans: 1 },
    { type: 'mcq', q: 'Theoretical surface finish Ra improves fastest when you:', opts: ['Increase spindle speed', 'Halve the feed', 'Increase depth of cut', 'Reduce the nose radius'], ans: 1 },
    { type: 'mcq', q: 'Spindle torque is related to cutting power by:', opts: ['M = P \u00D7 N', 'M = 30000P / (\u03C0N)', 'M = P / N\u00B2', 'M = \u03C0NP / 30000'], ans: 1 },
    { type: 'mcq', q: 'A reamer removes:', opts: ['A solid cylinder', 'A thin annulus of stock', 'A conical plug', 'A helical groove'], ans: 1 },
    { type: 'mcq', q: 'Increasing the depth of cut while keeping other parameters constant will:', opts: ['Decrease MRR', 'Increase MRR', 'Not affect MRR', 'Decrease RPM'], ans: 1 },
    { type: 'num', gen: function () {
      var D = 40 + Math.floor(Math.random() * 40);
      var V = 20 + Math.floor(Math.random() * 30);
      return { q: 'Calculate spindle speed: V = ' + V + ' m/min, D = ' + D + ' mm', a: round(1000 * V / (Math.PI * D), 0), u: 'rev/min', tol: 2 };
    } },
    { type: 'num', gen: function () {
      var f = round(0.1 + Math.random() * 0.2, 2);
      var N = 200 + Math.floor(Math.random() * 300);
      return { q: 'Find the feed rate in mm/min: f = ' + f + ' mm/rev, N = ' + N + ' rev/min', a: round(f * N, 1), u: 'mm/min', tol: 1 };
    } },
    { type: 'num', gen: function () {
      var D = 50 + Math.floor(Math.random() * 50);
      var N = 100 + Math.floor(Math.random() * 200);
      return { q: 'Find the cutting speed: D = ' + D + ' mm, N = ' + N + ' rev/min', a: round(Math.PI * D * N / 1000, 1), u: 'm/min', tol: 0.5 };
    } },
    { type: 'num', gen: function () {
      var D = 40 + Math.floor(Math.random() * 60);
      var f = round(0.1 + Math.random() * 0.2, 2);
      var N = 200 + Math.floor(Math.random() * 300);
      var T = round((D / 2) / (f * N), 3);
      return { q: 'Facing time for a ' + D + ' mm bar at f = ' + f + ' mm/rev, N = ' + N + ' rev/min (travel = radius)', a: T, u: 'min', tol: Math.max(0.005, T * 0.04) };
    } },
    { type: 'num', gen: function () {
      var fz = round(0.05 + Math.random() * 0.1, 2);
      var Z = 3 + Math.floor(Math.random() * 4);
      var N = 250 + Math.floor(Math.random() * 300);
      return { q: 'Table feed: f\u2082 = ' + fz + ' mm/tooth, z = ' + Z + ', N = ' + N + ' rev/min', a: round(fz * Z * N, 1), u: 'mm/min', tol: 2 };
    } },
    { type: 'num', gen: function () {
      var P = round(0.8 + Math.random() * 4, 2);
      var N = 300 + Math.floor(Math.random() * 1200);
      var M = round(30000 * P / (Math.PI * N), 2);
      return { q: 'Spindle torque for P\u1D9C = ' + P + ' kW at N = ' + N + ' rev/min', a: M, u: 'N\u00B7m', tol: Math.max(0.05, M * 0.04) };
    } },
    { type: 'num', gen: function () {
      var f = round(0.1 + Math.random() * 0.2, 2);
      var re = [0.4, 0.8, 1.2][Math.floor(Math.random() * 3)];
      var Ra = round(f * f * 1000 / (31.2 * re), 2);
      return { q: 'Theoretical Ra at f = ' + f + ' mm/rev with nose radius ' + re + ' mm', a: Ra, u: '\u00B5m', tol: Math.max(0.02, Ra * 0.04) };
    } }
  ];

  var quizCounter  = $('quiz-counter');
  var quizQuestion = $('quiz-question');
  var quizOptions  = $('quiz-options');
  var quizInputGrp = $('quiz-input-group');
  var quizInput    = $('quiz-input');
  var quizUnitEl   = $('quiz-unit');
  var quizSubmit   = $('quiz-submit');
  var quizNext     = $('quiz-next');
  var quizFeedback = $('quiz-feedback');
  var quizResult   = $('quiz-result');
  var quizBar      = $('quiz-bar');

  function shuffle(arr) {
    for (var i = arr.length - 1; i > 0; i--) {
      var j = Math.floor(Math.random() * (i + 1));
      var t = arr[i]; arr[i] = arr[j]; arr[j] = t;
    }
    return arr;
  }

  function startQuiz() {
    quizScore = 0; quizIdx = 0; quizAnswered = false;
    quizResult.style.display = 'none';
    quizBar.style.display = '';
    var pool = shuffle(QUIZ_POOL.slice());
    quizSet = [];
    for (var i = 0; i < Math.min(QUIZ_SIZE, pool.length); i++) {
      var item = pool[i];
      if (item.type === 'num') {
        var g = item.gen();
        quizSet.push({ type: 'num', q: g.q, a: g.a, u: g.u, tol: g.tol, given: null });
      } else {
        quizSet.push({ type: 'mcq', q: item.q, opts: item.opts, ans: item.ans, given: null });
      }
    }
    showQuizQuestion();
  }

  function showQuizQuestion() {
    var item = quizSet[quizIdx];
    quizCounter.textContent = 'Q ' + (quizIdx + 1) + ' / ' + QUIZ_SIZE;
    quizQuestion.textContent = item.q;
    quizFeedback.textContent = '';
    quizFeedback.className = 'feedback';
    quizSubmit.style.display = '';
    quizNext.style.display = 'none';
    quizAnswered = false;

    if (item.type === 'mcq') {
      quizInputGrp.style.display = 'none';
      quizOptions.style.display = '';
      quizOptions.innerHTML = '';
      item.opts.forEach(function (opt, oi) {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'quiz-option';
        btn.textContent = opt;
        btn.dataset.idx = oi;
        btn.addEventListener('click', function () {
          quizOptions.querySelectorAll('.quiz-option').forEach(function (b) { b.classList.remove('selected'); });
          btn.classList.add('selected');
        });
        quizOptions.appendChild(btn);
      });
    } else {
      quizOptions.style.display = 'none';
      quizInputGrp.style.display = '';
      quizInput.value = '';
      quizUnitEl.textContent = item.u;
      quizInput.focus();
    }
  }

  quizSubmit.addEventListener('click', function () {
    if (quizAnswered) return;
    var item = quizSet[quizIdx];
    var correct = false;

    if (item.type === 'mcq') {
      var sel = quizOptions.querySelector('.quiz-option.selected');
      if (!sel) { quizFeedback.textContent = 'Select an answer.'; quizFeedback.className = 'feedback err'; return; }
      var chosen = +sel.dataset.idx;
      item.given = item.opts[chosen];
      correct = (chosen === item.ans);
      quizOptions.querySelectorAll('.quiz-option').forEach(function (b, bi) {
        b.disabled = true;
        if (bi === item.ans) b.classList.add('correct');
        if (bi === chosen && !correct) b.classList.add('wrong');
      });
    } else {
      var val = parseFloat(quizInput.value);
      if (isNaN(val)) { quizFeedback.textContent = 'Enter a number.'; quizFeedback.className = 'feedback err'; return; }
      item.given = val;
      var tol = item.tol > 0 ? item.tol : Math.max(Math.abs(item.a) * 0.02, Math.abs(item.a) < 10 ? 0.01 : 0.5);
      correct = Math.abs(val - item.a) <= tol;
    }

    quizAnswered = true;
    if (correct) {
      quizScore++;
      quizFeedback.textContent = 'Correct!';
      quizFeedback.className = 'feedback ok';
    } else {
      var ca = item.type === 'mcq' ? item.opts[item.ans] : item.a + ' ' + item.u;
      quizFeedback.textContent = 'Incorrect. Answer: ' + ca;
      quizFeedback.className = 'feedback err';
    }
    item._correct = correct;
    quizSubmit.style.display = 'none';
    quizNext.style.display = '';
  });

  quizNext.addEventListener('click', function () {
    quizIdx++;
    if (quizIdx >= QUIZ_SIZE) showQuizResult();
    else showQuizQuestion();
  });

  quizInput.addEventListener('keydown', function (e) { if (e.key === 'Enter') quizSubmit.click(); });

  function showQuizResult() {
    quizBar.style.display = 'none';
    quizResult.style.display = '';
    var scoreClass = quizScore === QUIZ_SIZE ? 'perfect' : quizScore >= 3 ? 'good' : 'poor';
    var stars = quizScore === QUIZ_SIZE ? '\u2605\u2605\u2605' : quizScore >= 3 ? '\u2605\u2605' : '\u2605';

    var html = '<div class="qr-header"><div class="qr-score ' + scoreClass + '">' + quizScore + ' / ' + QUIZ_SIZE + '</div><div class="qr-stars">' + stars + '</div></div>';
    html += '<div class="qr-rows">';
    quizSet.forEach(function (item, i) {
      var rowClass = item._correct ? 'ok' : 'err';
      var mark = item._correct ? '\u2713' : '\u2717';
      var ca = item.type === 'mcq' ? item.opts[item.ans] : item.a + ' ' + item.u;
      var ga = item.given;
      if (item.type === 'num' && ga !== null) ga = ga + ' ' + item.u;
      html += '<div class="qr-row ' + rowClass + '"><span class="qr-q">Q' + (i + 1) + ': ' + item.q + '</span>';
      html += '<span class="qr-a">Your: ' + (ga === null ? '-' : ga) + '</span>';
      if (!item._correct) html += '<span class="qr-a" style="color:var(--green)">Ans: ' + ca + '</span>';
      html += '<span class="qr-mark">' + mark + '</span></div>';
    });
    html += '</div><button class="btn btn-primary" type="button" id="quiz-retry">New Quiz</button>';
    quizResult.innerHTML = html;
    $('quiz-retry').addEventListener('click', startQuiz);
  }

