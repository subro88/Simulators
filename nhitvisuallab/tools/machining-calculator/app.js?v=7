/* ── Cutting speed chart: live filter ────────────────────────────────── */
(function () {
  'use strict';

  var input = document.getElementById('cs-filter');
  var table = document.getElementById('cs-table');
  var count = document.getElementById('cs-count');
  if (!input || !table) return;

  var rows = Array.prototype.slice.call(table.tBodies[0].rows);
  var total = rows.length;

  function report(n) {
    if (count) {
      count.textContent = n === total ? total + ' materials' : n + ' of ' + total + ' materials';
    }
  }

  input.addEventListener('input', function () {
    var q = input.value.trim().toLowerCase();
    // Accept both spellings so "aluminum" finds "Aluminium".
    var alt = q.replace('aluminum', 'aluminium');
    var shown = 0;
    rows.forEach(function (r) {
      var name = r.cells[0].textContent.toLowerCase();
      var hit = !q || name.indexOf(q) !== -1 || name.indexOf(alt) !== -1;
      r.hidden = !hit;
      if (hit) shown++;
    });
    report(shown);
  });

  report(total);
})();
