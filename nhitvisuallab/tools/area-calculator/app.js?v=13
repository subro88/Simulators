    requestDraw();
  }
  document.querySelectorAll('[data-gallery]').forEach(function (b) {
    b.addEventListener('click', function () { loadGallery(b.getAttribute('data-gallery')); });
  });
  /* Custom Shape — separate full-width button under the shape grid */
