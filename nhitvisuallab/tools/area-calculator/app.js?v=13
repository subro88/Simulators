  var PRACTICE_SHAPES = ['square','rectangle','right-triangle','equilateral','circle','semicircle','ellipse','trapezoid','parallelogram','rhombus','hexagon','sector','annulus'];
  function randomShapeKey() {
    return PRACTICE_SHAPES[Math.floor(Math.random() * PRACTICE_SHAPES.length)];
  }
  function randInt(a, b) { return Math.floor(a + Math.random() * (b - a + 1)); }
  function makeQuestion() {
    var key = randomShapeKey();
    var shape = SHAPES[key];
    var dims = {};
    shape.dims.forEach(function (dm) {
      var step = dm.step || 1;
      var range = (dm.max - dm.min) / step;
      var i = randInt(0, range);
      dims[dm.key] = dm.min + i * step;
    });
    // annulus sanity: R must be > r
    if (key === 'annulus' && dims.R <= dims.r + 0.5) dims.R = dims.r + randInt(1, 3);
    var answer = shape.compute(dims);
    return { key: key, dims: dims, answer: answer };
  }

  function newPractice() {
    state.practice.q = makeQuestion();
    var q = state.practice.q;
    var shape = SHAPES[q.key];
    var dimsTxt = shape.dims.map(function (dm) { return dm.label + ' = ' + fmt(q.dims[dm.key]) + ' ' + (dm.unit || (dm.key === 'theta' ? '°' : uLen())); }).join(', ');
    $('pq-prompt').innerHTML = '<strong>Find the area of this ' + shape.label + '</strong> &mdash; ' + dimsTxt + '. Round to 2 decimals.';
    drawPracticeShape($('practice-canvas'), q.key, q.dims);
    $('pq-input').value = '';
    $('pq-feedback').className = 'pq-feedback';
    $('pq-feedback').textContent = '';
  }
  function drawPracticeShape(cv, key, dims) {
    var pctx = cv.getContext('2d');
    var dpr = window.devicePixelRatio || 1;
    var w = Math.min(560, cv.parentElement.getBoundingClientRect().width - 16);
    var h = Math.round(w * 0.5);
    cv.style.width = w + 'px'; cv.style.height = h + 'px';
    cv.width = w * dpr; cv.height = h * dpr;
    pctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    pctx.fillStyle = '#0a0d14'; pctx.fillRect(0, 0, w, h);

    var saveShape = state.shape, saveDims = state.dims[saveShape], saveW = W, saveH = H, saveCtx = ctx;
    state.shape = key; state.dims[key] = dims;
    W = w; H = h; ctx = pctx;
    var geom = shapeGeometry();
    drawShapeOutline(geom, 1, 0.22);
    drawDimensionsFor(geom, 1);
    state.shape = saveShape; state.dims[saveShape] = saveDims;
    W = saveW; H = saveH; ctx = saveCtx;
  }
