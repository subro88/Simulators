  function attachStepperEditing() {
    document.querySelectorAll('#dim-controls .stepper-val').forEach(function (span) {
      span.title = 'Click to type a value';
      span.addEventListener('click', function () {
        var key = span.getAttribute('data-dim-val');
        var dim = SHAPES[state.shape].dims.find(function (d) { return d.key === key; });
        if (!dim) return;
        var current = state.dims[state.shape][key];
        var input = document.createElement('input');
        input.type = 'number';
        input.className = 'stepper-input';
        input.value = current;
        input.min = '0.0001';
        // No max — user can type any positive value
        input.step = 'any';
        input.title = 'Type any positive value. Values outside the slider range still calculate; canvas keeps the min/max visual size.';
        span.replaceWith(input);
        input.focus();
        input.select();
        function commit() {
          var v = parseFloat(input.value);
          if (isNaN(v) || v <= 0) {
            // Reject zero/negative — flash red, keep previous value
            input.style.borderColor = '#ff5555';
            input.style.background = 'rgba(255,85,85,0.15)';
            $('play-status').textContent = '⚠ ' + (dim.label || key) + ' must be greater than 0';
            $('play-status').style.color = '#ff5555';
            playError();
            input.value = current;
            input.select();
            return; // don't commit, don't rebuild
          }
          state.dims[state.shape][key] = v;
          // clear any prior error styling
          $('play-status').style.color = '';
          if ($('play-status').textContent.indexOf('must be greater than 0') >= 0) {
            $('play-status').textContent = 'Press Simulate';
          }
          // rebuild controls to restore span
          buildDimControls();
          attachStepperEditing();
          resetAnim();
          updateFormulaPanel(false);
          requestDraw();
        }
        input.addEventListener('blur', commit);
        input.addEventListener('keydown', function (e) {
          if (e.key === 'Enter') input.blur();
          if (e.key === 'Escape') { input.value = current; input.blur(); }
        });
      });
    });
  }

