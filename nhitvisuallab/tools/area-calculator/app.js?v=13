    var dir = initHeadingRad;
    for (var i = 0; i < n; i++) {
      var L = edges[i] * PX_PER_UNIT;
      x += Math.cos(dir) * L;
      y += Math.sin(dir) * L;
      if (i < n - 1) {
        pts.push({ x: x, y: y });
        var interior = angles[i + 1] * Math.PI / 180;
        var exteriorTurn = Math.PI - interior;
        dir += exteriorTurn * winding;
      }
    }
    // Final (x,y) should equal anchor for perfect closure
    var gap = Math.hypot(x - anchor.x, y - anchor.y);
    // Derive closure angle at v0: the interior angle at the start vertex.
    // After walking, dir = direction of last edge (n-1 → v0 ideal end).
    // initHeadingRad = direction of edge 0 (v0 → v1).
    // The turn made when reaching v0 (heading change from edge n-1 to edge 0):
    var turn = initHeadingRad - dir;
    while (turn >  Math.PI) turn -= 2 * Math.PI;
    while (turn < -Math.PI) turn += 2 * Math.PI;
    // For a polygon with our winding sign, a positive turn × winding indicates a convex vertex.
    // Interior angle = π − (turn × winding).
    var v0Interior = Math.PI - turn * winding;
    while (v0Interior <  0)            v0Interior += 2 * Math.PI;
    while (v0Interior >= 2 * Math.PI)  v0Interior -= 2 * Math.PI;
    return {
      pts: pts,
      end: { x: x, y: y },
      closureGapPx: gap,
      closureAngleDeg: v0Interior * 180 / Math.PI
    };
  }
  /* Auto-close: keep n-1 walked points, replace last edge to go straight to anchor.
     This adjusts edges[n-1] and angle at v0 to whatever closes the polygon. */
  function autoCloseSpec(walked, anchor) {
    var newPts = walked.pts.slice(); // contains v0..v_{n-1}
    // last edge would go from newPts[n-1] back to anchor (which equals newPts[0])
    return newPts;
  }
  function recomputeTriangulation() {
    state.custom.triangles = [];
    state.custom.selfIntersect = false;
    if (!state.custom.closed || state.custom.pts.length < 3) return;
    state.custom.selfIntersect = isSelfIntersecting(state.custom.pts);
    if (!state.custom.selfIntersect) {
      state.custom.triangles = earClipTriangulate(state.custom.pts);
    }
  }

  /* ── Animation step counts per shape ────────────────────── */
  function totalStepsFor(shape) {
    if (shape === 'custom') {
      if (!state.custom.closed || state.custom.pts.length < 3) return 0;
      if (state.custom.selfIntersect) return 1;
      if (state.anim.kind === 'perimeter') {
        // 1 outline + n edges + 1 total
        return 1 + state.custom.pts.length + 1;
      }
      var t = state.custom.triangles.length || (state.custom.pts.length - 2);
      return 1 + t + 1;
    }
    return 5;
  }

  /* ── Drawing ────────────────────────────────────────────── */
  var rafReq = 0;
  function requestDraw() {
    if (rafReq) return;
    rafReq = requestAnimationFrame(function () { rafReq = 0; draw(); });
  }

  function clearBg() {
    ctx.clearRect(0, 0, W, H);
    // grid bg
    ctx.save();
    ctx.strokeStyle = 'rgba(255,255,255,0.04)';
    ctx.lineWidth = 1;
    var step = 24;
    for (var x = 0; x < W; x += step) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, H); ctx.stroke(); }
    for (var y = 0; y < H; y += step) { ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(W, y); ctx.stroke(); }
    ctx.restore();
  }

  function strokePoly(pts, closed) {
    ctx.beginPath();
    for (var i = 0; i < pts.length; i++) {
      var p = pts[i];
      if (i === 0) ctx.moveTo(p.x, p.y); else ctx.lineTo(p.x, p.y);
    }
    if (closed) ctx.closePath();
    ctx.stroke();
  }
  function fillPoly(pts) {
    if (pts.length < 3) return;
    ctx.beginPath();
    for (var i = 0; i < pts.length; i++) {
      var p = pts[i];
      if (i === 0) ctx.moveTo(p.x, p.y); else ctx.lineTo(p.x, p.y);
    }
    ctx.closePath();
    ctx.fill();
  }

  function drawShapeOutline(geom, drawProgress, fillAlpha) {
    fillAlpha = (fillAlpha == null) ? 0.18 : fillAlpha;
    ctx.save();
    ctx.lineWidth = 3;
    ctx.lineJoin = 'round';
    ctx.lineCap = 'round';
    ctx.strokeStyle = '#ff6fb1';
    ctx.shadowColor = 'rgba(255,111,177,0.6)';
    ctx.shadowBlur = 12;
    ctx.fillStyle = 'rgba(255,111,177,' + fillAlpha + ')';

    if (geom.kind === 'circle') {
      ctx.beginPath();
      var end = -Math.PI / 2 + drawProgress * Math.PI * 2;
      ctx.arc(geom.cx, geom.cy, geom.r, -Math.PI / 2, end);
      ctx.stroke();
      if (drawProgress >= 0.999) { ctx.beginPath(); ctx.arc(geom.cx, geom.cy, geom.r, 0, Math.PI * 2); ctx.fill(); }
    } else if (geom.kind === 'semicircle') {
      ctx.beginPath();
      var start = Math.PI, endA = Math.PI + drawProgress * Math.PI;
      ctx.arc(geom.cx, geom.cy, geom.r, start, endA);
      if (drawProgress >= 0.999) { ctx.lineTo(geom.cx + geom.r, geom.cy); ctx.closePath(); ctx.fill(); ctx.beginPath(); ctx.arc(geom.cx, geom.cy, geom.r, Math.PI, Math.PI * 2); ctx.lineTo(geom.cx - geom.r, geom.cy); ctx.closePath(); }
      ctx.stroke();
    } else if (geom.kind === 'ellipse') {
      ctx.beginPath();
      ctx.ellipse(geom.cx, geom.cy, geom.a, geom.b, 0, -Math.PI / 2, -Math.PI / 2 + drawProgress * Math.PI * 2);
      ctx.stroke();
      if (drawProgress >= 0.999) { ctx.beginPath(); ctx.ellipse(geom.cx, geom.cy, geom.a, geom.b, 0, 0, Math.PI * 2); ctx.fill(); }
    } else if (geom.kind === 'sector') {
      var rad = geom.theta * Math.PI / 180;
      ctx.beginPath();
      ctx.moveTo(geom.cx, geom.cy);
      ctx.arc(geom.cx, geom.cy, geom.r, -Math.PI / 2, -Math.PI / 2 + rad * drawProgress);
      ctx.closePath();
      if (drawProgress >= 0.999) ctx.fill();
      ctx.stroke();
    } else if (geom.kind === 'annulus') {
      ctx.beginPath();
      ctx.arc(geom.cx, geom.cy, geom.R, -Math.PI / 2, -Math.PI / 2 + drawProgress * Math.PI * 2);
      ctx.stroke();
      if (drawProgress >= 0.999) {
        ctx.fillStyle = 'rgba(255,111,177,' + fillAlpha + ')';
        ctx.beginPath();
        ctx.arc(geom.cx, geom.cy, geom.R, 0, Math.PI * 2);
        ctx.arc(geom.cx, geom.cy, geom.r, 0, Math.PI * 2, true);
        ctx.fill();
        ctx.beginPath(); ctx.arc(geom.cx, geom.cy, geom.r, 0, Math.PI * 2); ctx.stroke();
      }
    } else {
      // poly: draw progressively
      var pts = geom.pts;
      if (pts.length < 2) {
        // draw points if any
        pts.forEach(function (p) { ctx.beginPath(); ctx.arc(p.x, p.y, 4, 0, Math.PI * 2); ctx.fillStyle = '#ff6fb1'; ctx.fill(); });
        ctx.restore(); return;
      }
      var total = pts.length;
      var k = drawProgress * total;
      var floor = Math.floor(k);
      var frac = k - floor;
      ctx.beginPath();
      ctx.moveTo(pts[0].x, pts[0].y);
      for (var i = 1; i <= floor && i < total; i++) ctx.lineTo(pts[i].x, pts[i].y);
      if (floor < total) {
        var a = pts[floor], b = pts[(floor + 1) % total];
        ctx.lineTo(a.x + (b.x - a.x) * frac, a.y + (b.y - a.y) * frac);
      }
      if (drawProgress >= 0.999 && !geom.open) { ctx.closePath(); ctx.fill(); }
      ctx.stroke();
    }
    ctx.restore();
  }

  /* ── Dimension annotations (drawn between step 2 and onward) ── */
  /* Key ("kind:key") of the editable dimension pill the pointer is over, or null */
  var hoverDimKey = null;
  function drawDimArrow(p1, p2, label, color, offset, editKey) {
    var dx = p2.x - p1.x, dy = p2.y - p1.y;
    var len = Math.sqrt(dx * dx + dy * dy);
    if (len < 4) return;
    var nx = -dy / len, ny = dx / len;
    var off = offset || 18;
    var q1 = { x: p1.x + nx * off, y: p1.y + ny * off };
    var q2 = { x: p2.x + nx * off, y: p2.y + ny * off };
    ctx.save();
    ctx.strokeStyle = color; ctx.fillStyle = color; ctx.lineWidth = 1.6;
    ctx.beginPath(); ctx.moveTo(q1.x, q1.y); ctx.lineTo(q2.x, q2.y); ctx.stroke();
    // ticks
    ctx.beginPath(); ctx.moveTo(p1.x, p1.y); ctx.lineTo(q1.x, q1.y); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(p2.x, p2.y); ctx.lineTo(q2.x, q2.y); ctx.stroke();
    // arrowheads
    drawArrowhead(q1, q2, 7); drawArrowhead(q2, q1, 7);
    // label + hotspot
    var mx = (q1.x + q2.x) / 2, my = (q1.y + q2.y) / 2;
    ctx.restore();
    drawDimLabel(label, mx, my, color, editKey ? 'shape-dim' : null, editKey);
  }

  function drawArrowhead(from, to, sz) {
    var dx = to.x - from.x, dy = to.y - from.y, ang = Math.atan2(dy, dx);
    ctx.save();
    ctx.beginPath();
    ctx.moveTo(to.x, to.y);
    ctx.lineTo(to.x - sz * Math.cos(ang - 0.5), to.y - sz * Math.sin(ang - 0.5));
    ctx.lineTo(to.x - sz * Math.cos(ang + 0.5), to.y - sz * Math.sin(ang + 0.5));
    ctx.closePath();
    ctx.fill();
    ctx.restore();
  }

  /* drawDimLabel — draws a value pill at (cx,cy) and registers a clickable hotspot.
     editKind: 'shape-dim' | 'custom-edge' | 'custom-angle'
     editKey: shape-dim key (e.g. 's') | edge index | vertex index */
  function drawDimLabel(text, cx, cy, color, editKind, editKey) {
    ctx.save();
    ctx.font = 'bold 13px Segoe UI, system-ui, sans-serif';
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    var tw = ctx.measureText(text).width;
    /* Editable labels reserve room for a small ✎ cue so users know they're clickable */
    var editable = editKind != null;
    var cue = editable ? ' ✎' : '';
    if (editable) tw = ctx.measureText(text + cue).width;
    var pad = 5, w = tw + pad * 2, h = 20;
    /* Highlight (invert) the pill the pointer is currently over */
    var isHover = editable && (editKind + ':' + editKey) === hoverDimKey;
    ctx.fillStyle = isHover ? color : '#0d1117';
    ctx.strokeStyle = color;
    ctx.lineWidth = 1.4;
    ctx.beginPath();
    if (ctx.roundRect) ctx.roundRect(cx - w/2, cy - h/2, w, h, 6);
    else ctx.rect(cx - w/2, cy - h/2, w, h);
    ctx.fill(); ctx.stroke();
    ctx.fillStyle = isHover ? '#0d1117' : color;
    ctx.fillText(text + cue, cx, cy);
    if (editable) {
      state.dimHotspots.push({
        x: cx - w/2, y: cy - h/2, w: w, h: h,
        kind: editKind, key: editKey, color: color, text: text
      });
    }
    ctx.restore();
  }

  function drawDimensionsFor(geom, alpha) {
    var d = state.dims[state.shape];
    state.dimHotspots = []; // reset each render so hotspots match current label positions
    ctx.save();
    ctx.globalAlpha = alpha;
    switch (state.shape) {
      case 'square': {
        var pts = geom.pts;
        drawDimArrow(pts[3], pts[2], 's = ' + fmt(d.s) + ' ' + uLen(), '#ff6fb1', 22, 's');
        break;
      }
      case 'rectangle': {
        var pts = geom.pts;
        drawDimArrow(pts[3], pts[2], 'l = ' + fmt(d.l) + ' ' + uLen(), '#ff6fb1', 22, 'l');
        drawDimArrow(pts[2], pts[1], 'w = ' + fmt(d.w) + ' ' + uLen(), '#4cc9f0', 22, 'w');
        break;
      }
      case 'right-triangle': {
        var pts = geom.pts;
        drawDimArrow(pts[0], pts[1], 'b = ' + fmt(d.b) + ' ' + uLen(), '#ff6fb1', 22, 'b');
        drawDimArrow(pts[2], pts[0], 'h = ' + fmt(d.h) + ' ' + uLen(), '#4cc9f0', 22, 'h');
        break;
      }
      case 'equilateral': {
        var pts = geom.pts;
        drawDimArrow(pts[2], pts[1], 's = ' + fmt(d.s) + ' ' + uLen(), '#ff6fb1', 22, 's');
        break;
      }
      case 'scalene': {
        var pts = geom.pts;
        drawDimArrow(pts[0], pts[1], 'b = ' + fmt(d.b) + ' ' + uLen(), '#4cc9f0', 22, 'b');
        drawDimArrow(pts[1], pts[2], 'a = ' + fmt(d.a) + ' ' + uLen(), '#ff6fb1', 22, 'a');
        drawDimArrow(pts[2], pts[0], 'c = ' + fmt(d.c) + ' ' + uLen(), '#ffd166', 22, 'c');
        break;
      }
      case 'circle': case 'semicircle': {
        var p1 = { x: geom.cx, y: geom.cy }, p2 = { x: geom.cx + geom.r, y: geom.cy };
        // draw radius line + label
        ctx.strokeStyle = '#ff6fb1'; ctx.lineWidth = 2; ctx.setLineDash([5, 4]);
        ctx.beginPath(); ctx.moveTo(p1.x, p1.y); ctx.lineTo(p2.x, p2.y); ctx.stroke();
        ctx.setLineDash([]);
        ctx.fillStyle = '#ff6fb1';
        ctx.font = 'bold 13px Segoe UI, system-ui, sans-serif';
        ctx.textAlign = 'center';
        drawDimLabel('r = ' + fmt(d.r) + ' ' + uLen(), (p1.x + p2.x) / 2, p1.y - 8, '#ff6fb1', 'shape-dim', 'r');
        break;
      }
      case 'ellipse': {
        ctx.strokeStyle = '#ff6fb1'; ctx.lineWidth = 2; ctx.setLineDash([5, 4]);
        ctx.beginPath(); ctx.moveTo(geom.cx, geom.cy); ctx.lineTo(geom.cx + geom.a, geom.cy); ctx.stroke();
        ctx.setLineDash([5, 4]);
        ctx.strokeStyle = '#4cc9f0';
        ctx.beginPath(); ctx.moveTo(geom.cx, geom.cy); ctx.lineTo(geom.cx, geom.cy - geom.b); ctx.stroke();
        ctx.setLineDash([]);
        ctx.fillStyle = '#ff6fb1';
        ctx.font = 'bold 13px Segoe UI, system-ui, sans-serif';
        drawDimLabel('a = ' + fmt(d.a) + ' ' + uLen(), geom.cx + geom.a / 2, geom.cy - 6, '#ff6fb1', 'shape-dim', 'a');
        ctx.fillStyle = '#4cc9f0';
        drawDimLabel('b = ' + fmt(d.b) + ' ' + uLen(), geom.cx + 16, geom.cy - geom.b / 2, '#4cc9f0', 'shape-dim', 'b');
        break;
      }
      case 'parallelogram': {
        var pts = geom.pts;
        drawDimArrow(pts[0], pts[1], 'b = ' + fmt(d.b) + ' ' + uLen(), '#ff6fb1', 22, 'b');
        // perpendicular height: between the two horizontal sides
        ctx.strokeStyle = '#4cc9f0'; ctx.lineWidth = 2; ctx.setLineDash([5, 4]);
        var mx = pts[0].x + (pts[1].x - pts[0].x) * 0.25;
        ctx.beginPath(); ctx.moveTo(mx, pts[0].y); ctx.lineTo(mx, pts[3].y); ctx.stroke();
        ctx.setLineDash([]);
        ctx.fillStyle = '#4cc9f0';
        ctx.font = 'bold 13px Segoe UI, system-ui, sans-serif';
        drawDimLabel('h = ' + fmt(d.h) + ' ' + uLen(), mx - 24, (pts[0].y + pts[3].y) / 2, '#4cc9f0', 'shape-dim', 'h');
        break;
      }
      case 'rhombus': case 'kite': {
        var pts = geom.pts;
        ctx.strokeStyle = '#ff6fb1'; ctx.lineWidth = 2; ctx.setLineDash([5, 4]);
        ctx.beginPath(); ctx.moveTo(pts[1].x, pts[1].y); ctx.lineTo(pts[3].x, pts[3].y); ctx.stroke();
        ctx.strokeStyle = '#4cc9f0';
        ctx.beginPath(); ctx.moveTo(pts[0].x, pts[0].y); ctx.lineTo(pts[2].x, pts[2].y); ctx.stroke();
        ctx.setLineDash([]);
        ctx.font = 'bold 13px Segoe UI, system-ui, sans-serif';
        ctx.fillStyle = '#ff6fb1';
        drawDimLabel('d₁ = ' + fmt(d.d1) + ' ' + uLen(), (pts[1].x + pts[3].x) / 2, (pts[1].y + pts[3].y) / 2 - 8, '#ff6fb1', 'shape-dim', 'd1');
        ctx.fillStyle = '#4cc9f0';
        drawDimLabel('d₂ = ' + fmt(d.d2) + ' ' + uLen(), (pts[0].x + pts[2].x) / 2 + 16, (pts[0].y + pts[2].y) / 2, '#4cc9f0', 'shape-dim', 'd2');
        break;
      }
      case 'trapezoid': {
        var pts = geom.pts;
        drawDimArrow(pts[0], pts[1], 'a = ' + fmt(d.a) + ' ' + uLen(), '#ff6fb1', -22, 'a');
        drawDimArrow(pts[3], pts[2], 'b = ' + fmt(d.b) + ' ' + uLen(), '#4cc9f0', 22, 'b');
        ctx.strokeStyle = '#ffd166'; ctx.lineWidth = 2; ctx.setLineDash([5, 4]);
        ctx.beginPath(); ctx.moveTo(pts[0].x + 12, pts[0].y); ctx.lineTo(pts[0].x + 12, pts[3].y); ctx.stroke();
        ctx.setLineDash([]);
        ctx.fillStyle = '#ffd166';
        ctx.font = 'bold 13px Segoe UI, system-ui, sans-serif';
        drawDimLabel('h = ' + fmt(d.h) + ' ' + uLen(), pts[0].x - 16, (pts[0].y + pts[3].y) / 2, '#ffd166', 'shape-dim', 'h');
        break;
      }
      case 'pentagon': case 'hexagon': case 'octagon': {
        var pts = geom.pts;
        drawDimArrow(pts[0], pts[1], 's = ' + fmt(d.s) + ' ' + uLen(), '#ff6fb1', 18, 's');
        break;
      }
      case 'sector': {
        ctx.strokeStyle = '#ff6fb1'; ctx.lineWidth = 2; ctx.setLineDash([5, 4]);
        ctx.beginPath(); ctx.moveTo(geom.cx, geom.cy); ctx.lineTo(geom.cx, geom.cy - geom.r); ctx.stroke();
        ctx.setLineDash([]);
        ctx.fillStyle = '#ff6fb1';
        ctx.font = 'bold 13px Segoe UI, system-ui, sans-serif';
        drawDimLabel('r = ' + fmt(d.r) + ' ' + uLen(), geom.cx + 18, geom.cy - geom.r / 2, '#ff6fb1', 'shape-dim', 'r');
        // angle arc
        ctx.strokeStyle = '#4cc9f0'; ctx.lineWidth = 2;
        var rad = d.theta * Math.PI / 180;
        ctx.beginPath();
        ctx.arc(geom.cx, geom.cy, 26, -Math.PI / 2, -Math.PI / 2 + rad);
        ctx.stroke();
        ctx.fillStyle = '#4cc9f0';
        drawDimLabel('θ = ' + fmt(d.theta) + '°', geom.cx + 32, geom.cy + 6, '#4cc9f0', 'shape-dim', 'theta');
        break;
      }
      case 'annulus': {
        ctx.strokeStyle = '#ff6fb1'; ctx.lineWidth = 2; ctx.setLineDash([5, 4]);
        ctx.beginPath(); ctx.moveTo(geom.cx, geom.cy); ctx.lineTo(geom.cx + geom.R, geom.cy); ctx.stroke();
        ctx.strokeStyle = '#4cc9f0';
        ctx.beginPath(); ctx.moveTo(geom.cx, geom.cy); ctx.lineTo(geom.cx, geom.cy + geom.r); ctx.stroke();
        ctx.setLineDash([]);
        ctx.font = 'bold 13px Segoe UI, system-ui, sans-serif';
        drawDimLabel('R = ' + fmt(Math.max(d.R, d.r + 0.5)) + ' ' + uLen(), geom.cx + geom.R / 2, geom.cy - 6, '#ff6fb1', 'shape-dim', 'R');
        drawDimLabel('r = ' + fmt(d.r) + ' ' + uLen(), geom.cx + 6, geom.cy + geom.r / 2, '#4cc9f0', 'shape-dim', 'r');
        break;
      }
    }
    ctx.restore();
  }

  /* ── Confetti ───────────────────────────────────────────── */
  function launchConfetti(cx, cy) {
    var cols = ['#ff6fb1', '#4cc9f0', '#ffd166', '#95e06c', '#c79bff', '#ff8a3d'];
    for (var i = 0; i < 60; i++) {
      var ang = Math.random() * Math.PI * 2;
      var sp = 1.5 + Math.random() * 4.5;
      state.confetti.push({
        x: cx, y: cy,
        vx: Math.cos(ang) * sp,
        vy: Math.sin(ang) * sp - 1,
        rot: Math.random() * Math.PI,
        vr: (Math.random() - 0.5) * 0.3,
        size: 3 + Math.random() * 4,
        color: cols[Math.floor(Math.random() * cols.length)],
        life: 1
      });
    }
    playSuccess();
  }
  function updateConfetti() {
    for (var i = state.confetti.length - 1; i >= 0; i--) {
      var c = state.confetti[i];
      c.x += c.vx; c.y += c.vy; c.vy += 0.12;
      c.rot += c.vr; c.life -= 0.012;
      if (c.life <= 0 || c.y > H + 20) state.confetti.splice(i, 1);
    }
  }
  function drawConfetti() {
    state.confetti.forEach(function (c) {
      ctx.save();
      ctx.globalAlpha = Math.max(0, c.life);
      ctx.translate(c.x, c.y); ctx.rotate(c.rot);
      ctx.fillStyle = c.color;
      ctx.fillRect(-c.size / 2, -c.size / 2, c.size, c.size * 1.6);
      ctx.restore();
    });
  }

  /* ── Custom polygon triangulation animation state ───────── */
  var triAnim = { activeIdx: 0, partialT: 1, runningSum: 0, triangleAreas: [] };

  /* ── Main draw ──────────────────────────────────────────── */
  function draw() {
    clearBg();
    var geom = shapeGeometry();
    var a = state.anim;

    if (state.shape === 'custom') {
      drawCustom(geom);
    } else {
      // determine drawProgress based on step
      var drawProg, dimAlpha = 0;
      if (!a.running && !a.done) {
        // idle: full shape, dimensions always visible (so user sees them update with sliders)
        drawProg = 1;
        dimAlpha = state.showDims ? 1 : 0;
      } else if (a.step === 1) {
        drawProg = a.t;
      } else {
        drawProg = 1;
        if (a.step >= 2) dimAlpha = Math.min(1, a.step === 2 ? a.t : 1);
      }
      drawShapeOutline(geom, drawProg, drawProg >= 0.999 ? 0.18 : 0.06);
      if (dimAlpha > 0 && state.showDims) drawDimensionsFor(geom, dimAlpha);

      // On-canvas calculation card (formula → substitution → result, with typewriter + pulse)
      drawCalcCard();
    }

    if (state.confetti.length) drawConfetti();
  }

  /* ── Custom-mode calc card (shoelace) ───────────────────── */
  function drawCustomCalcCard(cards) {
    ctx.save();
    var labelFont = 'bold 11px "Segoe UI", system-ui, sans-serif';
    var bodyFont  = 'bold 14px "Courier New", monospace';
    var bigFont   = 'bold 17px "Courier New", monospace';
    var maxW = 0;
    cards.forEach(function (L) {
      ctx.font = L.big ? bigFont : bodyFont;
      var w = ctx.measureText(L.body).width;
      ctx.font = labelFont;
      var lw = ctx.measureText(L.label.toUpperCase()).width + 14;
      maxW = Math.max(maxW, w + lw + 24);
    });
    var pad = 10, cardX = 12, cardY = 12;
    cards.forEach(function (L) {
      var h = L.big ? 36 : 28;
      var glow = L.big ? (12 + 6 * Math.sin(performance.now() / 220)) : (L.glow || 8);
      ctx.save();
      ctx.translate(cardX, cardY);
      ctx.fillStyle = 'rgba(13, 17, 23, 0.86)';
      ctx.strokeStyle = L.color; ctx.lineWidth = 1.6;
      ctx.shadowColor = L.color; ctx.shadowBlur = glow;
      ctx.beginPath();
      if (ctx.roundRect) ctx.roundRect(0, 0, maxW, h, 9);
      else ctx.rect(0, 0, maxW, h);
      ctx.fill(); ctx.stroke();
      ctx.shadowBlur = 0;
      ctx.font = labelFont; ctx.textAlign = 'left'; ctx.textBaseline = 'middle';
      var labelText = L.label.toUpperCase();
      var labelW = ctx.measureText(labelText).width + 12;
      ctx.fillStyle = L.color + '33';
      ctx.fillRect(pad - 2, h/2 - 9, labelW, 18);
      ctx.fillStyle = L.color;
      ctx.fillText(labelText, pad + 4, h/2);
      ctx.font = L.big ? bigFont : bodyFont;
      ctx.fillText(L.body, pad + labelW + 10, h/2);
      ctx.restore();
      cardY += h + 6;
    });
    ctx.restore();
  }

  /* ── On-canvas calculation card ─────────────────────────── */
  function drawCalcCard() {
    if (state.shape === 'custom') return; // custom mode uses the side tri-panel
    var step = state.anim.step, t = state.anim.t;
    var shape = SHAPES[state.shape];
    var d = state.dims[state.shape];
    var lines = [];
    var isPeri = state.anim.kind === 'perimeter';
    var symbol = isPeri ? 'P' : 'A';
    var formulaSym = isPeri ? (shape.perimeterSym || '—') : shape.formulaSym;
    var subFn      = isPeri ? (shape.perimeterSub || function(){return '—';}) : shape.sub;
    var computeFn  = isPeri ? (shape.perimeter || function(){return 0;})       : shape.compute;
    var unitText   = isPeri ? uLen() : uArea();

    function add(label, body, color, reveal, big) {
      lines.push({ label: label, body: body, color: color, reveal: reveal, big: !!big, pulse: !!big });
    }

    if (state.anim.running || state.anim.done) {
      if (step >= 3 || state.anim.done) {
        add('Formula', symbol + ' = ' + formulaSym.replace(/^[ACP]\s*=\s*/, ''), '#4cc9f0',
            state.anim.done ? 1 : (step === 3 ? Math.min(1, t * 1.4) : 1), false);
      }
      if (step >= 4 || state.anim.done) {
        add('Substitute', symbol + ' = ' + subFn(d).replace(/^[ACP]\s*=\s*/, ''), '#ffd166',
            state.anim.done ? 1 : (step === 4 ? Math.min(1, t * 1.4) : 1), false);
      }
      if (step >= 5 || state.anim.done) {
        var v = computeFn(d);
        add('Result', symbol + ' = ' + fmt(v, 2) + ' ' + unitText, '#95e06c',
            state.anim.done ? 1 : Math.min(1, t * 1.4), true);
      }
    }
    if (!lines.length) return;

    // Measure widest line
    ctx.save();
    var labelFont = 'bold 11px "Segoe UI", system-ui, sans-serif';
    var bodyFont  = 'bold 15px "Courier New", monospace';
    var bigFont   = 'bold 18px "Courier New", monospace';
    var maxW = 0;
    lines.forEach(function (L) {
      ctx.font = L.big ? bigFont : bodyFont;
      var w = ctx.measureText(L.body).width;
      ctx.font = labelFont;
      var lw = ctx.measureText(L.label.toUpperCase()).width + 14;
      maxW = Math.max(maxW, w + lw + 24);
    });

    var pad = 10;
    var cardX = 12, cardY = 12;
    var lineH = 30, bigH = 38;

    lines.forEach(function (L) {
      var h = L.big ? bigH : lineH;
      var revealed = L.body.slice(0, Math.ceil(L.body.length * L.reveal));

      // pulse for result line
      var glow = L.big ? (12 + 6 * Math.sin(performance.now() / 220)) : 8;

      // background card with neon border
      ctx.save();
      ctx.translate(cardX, cardY);
      ctx.fillStyle = 'rgba(13, 17, 23, 0.86)';
      ctx.strokeStyle = L.color;
      ctx.lineWidth = 1.6;
      ctx.shadowColor = L.color;
      ctx.shadowBlur = glow;
      ctx.beginPath();
      if (ctx.roundRect) ctx.roundRect(0, 0, maxW, h, 9);
      else ctx.rect(0, 0, maxW, h);
      ctx.fill(); ctx.stroke();
      ctx.shadowBlur = 0;

      // Label chip on the left
      ctx.fillStyle = L.color;
      ctx.font = labelFont;
      ctx.textAlign = 'left'; ctx.textBaseline = 'middle';
      var labelText = L.label.toUpperCase();
      var labelW = ctx.measureText(labelText).width + 12;
      ctx.fillStyle = L.color + (L.big ? '44' : '33');
      ctx.fillRect(pad - 2, h/2 - 9, labelW, 18);
      ctx.fillStyle = L.color;
      ctx.fillText(labelText, pad + 4, h/2);

      // Body text
      ctx.font = L.big ? bigFont : bodyFont;
      ctx.fillStyle = L.color;
      ctx.fillText(revealed, pad + labelW + 10, h/2 + (L.big ? 1 : 0));

      // typewriter caret
      if (L.reveal < 1) {
        var caretX = pad + labelW + 10 + ctx.measureText(revealed).width + 2;
        var blink = (performance.now() % 600) < 300;
        if (blink) {
          ctx.fillStyle = L.color;
          ctx.fillRect(caretX, h/2 - (L.big ? 9 : 7), 2, L.big ? 18 : 14);
        }
      }
      ctx.restore();

      cardY += h + 6;
    });
    ctx.restore();
  }

  function drawAreaBadge(cx, cy, text) {
    ctx.save();
    ctx.font = 'bold 16px Segoe UI, system-ui, sans-serif';
    var tw = ctx.measureText(text).width;
    var pad = 12, w = tw + pad * 2, h = 30;
    ctx.fillStyle = 'rgba(149,224,108,0.18)';
    ctx.strokeStyle = '#95e06c'; ctx.lineWidth = 1.6;
    ctx.beginPath();
    if (ctx.roundRect) ctx.roundRect(cx - w/2, cy - h/2, w, h, 10);
    else ctx.rect(cx - w/2, cy - h/2, w, h);
    ctx.fill(); ctx.stroke();
    ctx.fillStyle = '#95e06c';
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.fillText(text, cx, cy);
    ctx.restore();
  }

  function drawCustom(geom) {
    var pts = state.custom.pts;
    var a = state.anim;
    state.dimHotspots = []; // reset for custom edge/angle hotspots

    // Perimeter mode: walk edges sequentially with running sum
    if ((a.running || a.done) && pts.length >= 3 && state.custom.closed && !state.custom.selfIntersect && a.kind === 'perimeter') {
      var nP = pts.length;
      var completedP = 0, partialEi = -1, partialT = 1;
      if (a.step === 1) { /* outline only */ }
      else if (a.step >= 2 && a.step < 2 + nP) { completedP = a.step - 2; partialEi = completedP; partialT = a.t; }
      else if (a.step >= 2 + nP) completedP = nP;
      var palette = ['#ff6fb1', '#4cc9f0', '#ffd166', '#95e06c', '#c79bff', '#ff8a3d', '#26d4b7', '#ffafd2'];
      // Highlight completed edges
      ctx.save();
      ctx.lineCap = 'round'; ctx.lineWidth = 4;
      for (var ei2 = 0; ei2 < completedP; ei2++) {
        ctx.strokeStyle = palette[ei2 % palette.length];
        var pA = pts[ei2], pB = pts[(ei2 + 1) % nP];
        ctx.beginPath(); ctx.moveTo(pA.x, pA.y); ctx.lineTo(pB.x, pB.y); ctx.stroke();
      }
      // Partial edge (animating)
      if (partialEi >= 0 && partialEi < nP) {
        var pa = pts[partialEi], pb = pts[(partialEi + 1) % nP];
        var mx = pa.x + (pb.x - pa.x) * partialT, my = pa.y + (pb.y - pa.y) * partialT;
        ctx.strokeStyle = palette[partialEi % palette.length];
        ctx.setLineDash([6, 3]);
        ctx.beginPath(); ctx.moveTo(pa.x, pa.y); ctx.lineTo(mx, my); ctx.stroke();
        ctx.setLineDash([]);
      }
      ctx.restore();
    }

    // Ear-clipped triangulation render (area mode)
    if ((a.running || a.done) && pts.length >= 3 && state.custom.closed && !state.custom.selfIntersect && a.kind !== 'perimeter') {
      var tris = state.custom.triangles;
      var triCount = tris.length;
      var completed = 0, partialIdx = -1, partialT = 1;
      if (a.step === 1) {
        // just outline
      } else if (a.step >= 2 && a.step < 2 + triCount) {
        completed = a.step - 2;
        partialIdx = completed;
        partialT = a.t;
      } else if (a.step >= 2 + triCount) {
        completed = triCount;
      }
      var palette = ['#ff6fb1', '#4cc9f0', '#ffd166', '#95e06c', '#c79bff', '#ff8a3d', '#26d4b7', '#ffafd2'];
      for (var i = 0; i < completed; i++) {
        var T = tris[i];
        var tri = [T.a, T.b, T.c];
        ctx.save();
        ctx.fillStyle = palette[i % palette.length] + '55';
        ctx.strokeStyle = palette[i % palette.length];
        ctx.lineWidth = 2;
        fillPoly(tri); strokePoly(tri, true);
        var cxT = (tri[0].x + tri[1].x + tri[2].x) / 3;
        var cyT = (tri[0].y + tri[1].y + tri[2].y) / 3;
        ctx.font = 'bold 12px Segoe UI, system-ui, sans-serif';
        ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
        var areaT = triArea(tri[0], tri[1], tri[2]);
        var lbl = 'T' + (i + 1) + ' = ' + fmt(pxAreaToUnit(areaT), 2) + ' ' + uArea();
        var tw = ctx.measureText(lbl).width;
        ctx.fillStyle = palette[i % palette.length];
        ctx.beginPath();
        if (ctx.roundRect) ctx.roundRect(cxT - tw/2 - 4, cyT - 9, tw + 8, 18, 5);
        else ctx.rect(cxT - tw/2 - 4, cyT - 9, tw + 8, 18);
        ctx.fill();
        ctx.fillStyle = '#0d1117';
        ctx.fillText(lbl, cxT, cyT);
        ctx.restore();
      }
      if (partialIdx >= 0 && partialIdx < triCount) {
        var Tp = tris[partialIdx];
        var trip = [Tp.a, Tp.b, Tp.c];
        ctx.save();
        ctx.strokeStyle = palette[partialIdx % palette.length];
        ctx.lineWidth = 2.5;
        ctx.setLineDash([5, 4]);
        var midA = { x: trip[0].x + (trip[1].x - trip[0].x) * partialT, y: trip[0].y + (trip[1].y - trip[0].y) * partialT };
        var midB = { x: trip[0].x + (trip[2].x - trip[0].x) * partialT, y: trip[0].y + (trip[2].y - trip[0].y) * partialT };
        ctx.beginPath();
        ctx.moveTo(trip[0].x, trip[0].y);
        ctx.lineTo(midA.x, midA.y);
        ctx.lineTo(midB.x, midB.y);
        ctx.closePath();
        ctx.fillStyle = palette[partialIdx % palette.length] + '33';
        ctx.fill(); ctx.stroke();
        ctx.setLineDash([]);
        ctx.restore();
      }
    }

    // Self-intersection warning overlay
    if (state.custom.closed && state.custom.selfIntersect) {
      ctx.save();
      var msg = '⚠ Self-intersecting polygon — cannot triangulate. Move vertices to remove edge crossings.';
      ctx.font = 'bold 13px Segoe UI, system-ui, sans-serif';
      ctx.fillStyle = '#0d1117';
      ctx.strokeStyle = '#ff5555';
      ctx.lineWidth = 1.6;
      var tw = ctx.measureText(msg).width + 24;
      var x = (W - tw) / 2, y = H - 56;
      ctx.beginPath();
      if (ctx.roundRect) ctx.roundRect(x, y, tw, 30, 8); else ctx.rect(x, y, tw, 30);
      ctx.fill(); ctx.stroke();
      ctx.fillStyle = '#ff5555'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.fillText(msg, x + tw/2, y + 15);
      ctx.restore();
    }

    // outline + vertices
    ctx.save();
    ctx.strokeStyle = '#ff6fb1';
    ctx.lineWidth = (a.running || a.done) ? 2 : 3;
    ctx.lineJoin = 'round'; ctx.lineCap = 'round';
    if (!(a.running || a.done) && state.custom.closed && pts.length >= 3) {
      ctx.fillStyle = 'rgba(255,111,177,0.14)';
      fillPoly(pts);
    }
    if (pts.length >= 2) strokePoly(pts, state.custom.closed);
    // vertex dots — with hover + drag highlights
    pts.forEach(function (p, idx) {
      var isFirst = (idx === 0);
      var isHover = (state.custom.hoverIdx === idx);
      var isDrag = (state.custom.dragIdx === idx);
      var r = isFirst ? 7 : 5;
      if (isHover || isDrag) {
        ctx.beginPath();
        ctx.arc(p.x, p.y, r + 5, 0, Math.PI * 2);
        ctx.fillStyle = isDrag ? 'rgba(149,224,108,0.35)' : 'rgba(255,209,102,0.3)';
        ctx.fill();
      }
      ctx.beginPath();
      ctx.arc(p.x, p.y, r, 0, Math.PI * 2);
      ctx.fillStyle = isFirst ? '#ffd166' : '#ff6fb1';
      ctx.fill();
      if (isFirst && pts.length >= 3 && !state.custom.closed) {
        ctx.beginPath();
        ctx.arc(p.x, p.y, r + 3, 0, Math.PI * 2);
        ctx.strokeStyle = '#ffd166'; ctx.lineWidth = 1.4; ctx.setLineDash([3, 3]);
        ctx.stroke(); ctx.setLineDash([]);
      }
    });
    ctx.restore();

    // styled calc card for custom polygon
    if ((a.running || a.done) && state.custom.closed && pts.length >= 3 && !state.custom.selfIntersect) {
      if (a.kind === 'perimeter') {
        var spP = computeEdgesAngles(pts);
        var nE = spP.edges.length;
        var completedE = 0, partialT2 = 1;
        if (a.step === 1) { completedE = 0; }
        else if (a.step >= 2 && a.step < 2 + nE) { completedE = a.step - 2; partialT2 = a.t; }
        else if (a.step >= 2 + nE) completedE = nE;
        var sumP = 0;
        for (var iP = 0; iP < completedE; iP++) sumP += spP.edges[iP];
        var perHi = '';
        if (completedE > 0) perHi = 'L' + completedE + ' = ' + fmt(spP.edges[completedE - 1], 2) + ' ' + uLen();
        var pCards = [
          { label: 'Method', body: 'P = Σ Lᵢ  (sum of all edge lengths)', color: '#4cc9f0', glow: 8, big: false }
        ];
        if (perHi) pCards.push({ label: 'Current', body: perHi, color: '#ffd166', glow: 10, big: false });
        pCards.push({
          label: a.done ? 'Total' : 'Σ Running',
          body: 'P = ' + fmt(sumP, 2) + ' ' + uLen() + '   (' + completedE + ' / ' + nE + ' edges)',
          color: '#95e06c', glow: a.done ? 16 : 10, big: a.done
        });
        drawCustomCalcCard(pCards);
      } else {
        var tris2 = state.custom.triangles;
        var triCount2 = tris2.length;
        var completed2 = Math.min(triCount2, Math.max(0, a.step - 1));
        var sum = 0;
        var perTriHi = '';
        for (var i2 = 0; i2 < completed2; i2++) sum += triArea(tris2[i2].a, tris2[i2].b, tris2[i2].c);
        if (completed2 > 0) {
          var lastT = tris2[completed2 - 1];
          var ta = triArea(lastT.a, lastT.b, lastT.c);
          perTriHi = 'T' + completed2 + ' = ' + fmt(pxAreaToUnit(ta), 2) + ' ' + uArea();
        }
        var cards = [
          { label: 'Method', body: 'Ear-clip △ ⇒ Σ Tᵢ  (each △ lies inside)', color: '#4cc9f0', glow: 8, big: false }
        ];
        if (perTriHi) cards.push({ label: 'Current', body: perTriHi, color: '#ffd166', glow: 10, big: false });
        cards.push({
          label: a.done ? 'Total' : 'Σ Running',
          body: 'A = ' + fmt(pxAreaToUnit(sum), 2) + ' ' + uArea() + '   (' + completed2 + ' / ' + triCount2 + ' Δ)',
          color: '#95e06c', glow: a.done ? 16 : 10, big: a.done
        });
        drawCustomCalcCard(cards);
      }
    }

    // Custom polygon: edge-length labels (midpoint) + interior-angle markers per vertex
    // Show only when polygon is closed and we're not running an animation (so labels don't clutter the playback).
    if (state.custom.closed && pts.length >= 3 && !state.custom.selfIntersect && state.showDims && !a.running) {
      var spec = computeEdgesAngles(pts);
      // Edge labels at midpoint
      for (var ei = 0; ei < pts.length; ei++) {
        var p0 = pts[ei], p1 = pts[(ei + 1) % pts.length];
        var midX = (p0.x + p1.x) / 2;
        var midY = (p0.y + p1.y) / 2;
        // small offset perpendicular to the edge so label sits outside polygon center
        var dx = p1.x - p0.x, dy = p1.y - p0.y;
        var len = Math.hypot(dx, dy) || 1;
        var nx = -dy / len, ny = dx / len; // perpendicular
        // determine outward direction: sign of (mid - centroid) dotted with normal
        var cxP = 0, cyP = 0;
        for (var ii = 0; ii < pts.length; ii++) { cxP += pts[ii].x; cyP += pts[ii].y; }
        cxP /= pts.length; cyP /= pts.length;
        var outX = midX - cxP, outY = midY - cyP;
        var outward = (nx * outX + ny * outY) >= 0 ? 1 : -1;
        var off = 18;
        var lblX = midX + nx * off * outward;
        var lblY = midY + ny * off * outward;
        drawDimLabel(fmt(spec.edges[ei], 2) + ' ' + uLen(), lblX, lblY, '#ff6fb1', 'custom-edge', ei);
      }
      // Angle markers at each vertex (small text inside the polygon near the vertex)
      for (var vi = 0; vi < pts.length; vi++) {
        var prev = pts[(vi - 1 + pts.length) % pts.length];
        var curr = pts[vi];
        var next = pts[(vi + 1) % pts.length];
        // direction bisecting the two edges, pointing INTO the polygon
        var v1x = prev.x - curr.x, v1y = prev.y - curr.y;
        var v2x = next.x - curr.x, v2y = next.y - curr.y;
        var n1 = Math.hypot(v1x, v1y) || 1, n2 = Math.hypot(v2x, v2y) || 1;
        var bx = v1x / n1 + v2x / n2, by = v1y / n1 + v2y / n2;
        var bn = Math.hypot(bx, by);
        if (bn < 0.001) {
          // Collinear — pick a perpendicular direction
          bx = -v1y / n1; by = v1x / n1; bn = 1;
        }
        // For reflex vertex, push the marker the OPPOSITE direction (outside polygon-interior side)
        var isReflex = spec.angles[vi] > 180;
        var dirSign = isReflex ? -1 : 1;
        var px2 = curr.x + (bx / bn) * 28 * dirSign;
        var py2 = curr.y + (by / bn) * 28 * dirSign;
        drawDimLabel(fmt(spec.angles[vi], 1) + '°', px2, py2, '#4cc9f0', 'custom-angle', vi);
      }
    }

    // hint if empty
    if (pts.length === 0 && !(a.running || a.done)) {
      ctx.save();
      ctx.font = '16px Segoe UI, system-ui, sans-serif';
      ctx.fillStyle = '#6b7a99';
      ctx.textAlign = 'center';
      ctx.fillText('✦ Click on the canvas to drop vertices ✦', W / 2, H / 2);
      ctx.restore();
    }
  }

  /* ── Formula panel updates ──────────────────────────────── */
  function updateFormulaPanel(showResult) {
    var shape = SHAPES[state.shape];
    var d = state.dims[state.shape];
    var isPeri = state.anim.kind === 'perimeter';
    var symbol = isPeri ? 'P' : 'A';
    var sym  = isPeri ? (shape.perimeterSym || shape.formulaSym) : shape.formulaSym;
    var sub  = isPeri ? (shape.perimeterSub || shape.sub) : shape.sub;
    var comp = isPeri ? (shape.perimeter || shape.compute) : shape.compute;
    var unit = isPeri ? uLen() : uArea();
    $('f-label').textContent = symbol;
    $('f-expr').textContent = sym.replace(/^[ACP]\s*=\s*/, '');
    if (state.shape === 'custom' && (!state.custom.closed || state.custom.pts.length < 3)) {
      $('f-expr').textContent = 'Draw at least 3 points and close the shape, then press Find Area or Find Perimeter';
    }
    if (showResult) {
      $('f-eq2').style.display = '';
      $('f-sub').style.display = '';
      var subText;
      if (state.shape === 'custom') {
        subText = isPeri ? 'sum of edge lengths' : 'sum of triangle areas';
      } else {
        subText = sub(d).replace(/^[ACP]\s*=\s*/, '');
      }
      $('f-sub').textContent = subText;
      $('f-eq3').style.display = '';
      $('f-result').style.display = '';
      var val;
      if (state.shape === 'custom') {
        if (isPeri) {
          var sp = (state.custom.pts.length >= 3) ? computeEdgesAngles(state.custom.pts) : null;
          val = sp ? sp.edges.reduce(function (a, b) { return a + b; }, 0) : 0;
        } else {
          val = pxAreaToUnit(polygonArea(state.custom.pts));
        }
      } else {
        val = comp(d);
      }
      $('f-result').textContent = fmt(val, 2) + ' ' + unit;
    } else {
      $('f-eq2').style.display = 'none';
      $('f-sub').style.display = 'none';
      $('f-eq3').style.display = 'none';
      $('f-result').style.display = 'none';
    }
    $('step-narration').style.display = 'block';
    $('step-narration').textContent = shape.hint || '';
  }

  /* ── Readouts ───────────────────────────────────────────── */
  function updateReadouts() {
    var shape = SHAPES[state.shape];
    var isPeri = state.anim.kind === 'perimeter';
    $('rb-shape').textContent = shape.label;
    var total = totalStepsFor(state.shape);
    $('rb-step').textContent = state.anim.step;
    $('rb-total').textContent = total;
    $('rb-status').textContent = state.anim.done ? 'Done' : (state.anim.running ? 'Animating' : 'Ready');
    var unit = isPeri ? uLen() : uArea();
    if (state.anim.done) {
      var val;
      if (state.shape === 'custom') {
        if (isPeri) {
          var sp = (state.custom.pts.length >= 3) ? computeEdgesAngles(state.custom.pts) : null;
          val = sp ? sp.edges.reduce(function (a, b) { return a + b; }, 0) : 0;
        } else {
          val = pxAreaToUnit(polygonArea(state.custom.pts));
        }
      } else {
        var fn = isPeri ? (shape.perimeter || shape.compute) : shape.compute;
        val = fn(state.dims[state.shape]);
      }
      $('rb-area').textContent = fmt(val, 2);
      $('rb-area-unit').textContent = unit;
    } else {
      $('rb-area').textContent = '—';
      $('rb-area-unit').textContent = unit;
    }
  }

  /* ── Animation engine ───────────────────────────────────── */
  function resetAnim() {
    if (state.anim.raf) cancelAnimationFrame(state.anim.raf);
    state.anim = { running: false, step: 0, totalSteps: 0, t: 0, speed: state.anim.speed, lastTs: 0, raf: 0, paused: false, done: false, kind: state.anim.kind || 'area' };
    state.confetti = [];
    updateReadouts();
    requestDraw();
  }

  function startAnim() {
    if (state.shape === 'custom') {
      if (state.custom.pts.length < 3) {
        $('play-status').textContent = 'Need at least 3 points!';
        playError();
        return;
      }
      if (!state.custom.closed) { state.custom.closed = true; recomputeTriangulation(); }
      if (state.custom.selfIntersect) {
        $('play-status').textContent = '⚠ Self-intersecting polygon — cannot compute area. Drag vertices to fix.';
        playError();
        return;
      }
    }
    state.anim.running = true;
    state.anim.done = false;
    state.anim.step = 1;
    state.anim.t = 0;
    state.anim.totalSteps = totalStepsFor(state.shape);
    state.confetti = [];
    $('play-status').textContent = 'Simulating…';
    updateReadouts();
    updateFormulaPanel(false);
    if (!state.anim.lastTs) state.anim.lastTs = performance.now();
    tickAnim(performance.now());
    playPop();
  }

  function tickAnim(ts) {
    if (state.confetti.length) updateConfetti();

    if (state.anim.running && !state.anim.paused) {
      var dt = (ts - state.anim.lastTs) / 1000;
      state.anim.lastTs = ts;
      // duration per step in seconds:
      var perStep = 0.9 / state.anim.speed;
      state.anim.t += dt / perStep;
      if (state.anim.t >= 1) {
        state.anim.t = 0;
        state.anim.step += 1;
        playTri();
        if (state.anim.step > state.anim.totalSteps) {
          finishAnim();
        } else {
          handleStepEnter(state.anim.step);
        }
      }
      updateReadouts();
    } else {
      state.anim.lastTs = ts;
    }
    requestDraw();
    if (state.anim.running || state.confetti.length || state.anim.done) {
      state.anim.raf = requestAnimationFrame(tickAnim);
    } else {
      state.anim.raf = 0;
    }
  }

  function handleStepEnter(step) {
    var shape = SHAPES[state.shape];
    var totalSteps = state.anim.totalSteps;
    if (state.shape === 'custom') {
      if (state.anim.kind === 'perimeter') {
        var n = state.custom.pts.length;
        var sp = computeEdgesAngles(state.custom.pts);
        if (step === 1) {
          $('step-narration').textContent = 'Outline drawn. Walking around the polygon to sum ' + n + ' edges…';
        } else if (step >= 2 && step <= 1 + n) {
          var ei = step - 2;
          $('step-narration').textContent = 'Edge ' + (ei + 1) + ' length = ' + fmt(sp.edges[ei], 2) + ' ' + uLen() + ' — adding to total.';
        } else if (step === totalSteps) {
          $('step-narration').textContent = 'All ' + n + ' edges added. Total = polygon perimeter.';
        }
      } else {
        var triCount = state.custom.triangles.length;
        if (step === 1) {
          $('step-narration').textContent = 'Outline drawn. Ear-clipping triangulation finds ' + triCount + ' triangles inside…';
        } else if (step >= 2 && step <= 1 + triCount) {
          var i = step - 2;
          var T = state.custom.triangles[i];
          var a = triArea(T.a, T.b, T.c);
          $('step-narration').textContent = 'Triangle T' + (i + 1) + ' (inside polygon) area = ' + fmt(pxAreaToUnit(a), 2) + ' ' + uArea() + ' — adding to total.';
        } else if (step === totalSteps) {
          $('step-narration').textContent = 'All ' + triCount + ' interior triangles added. Total = polygon area.';
        }
      }
      updateFormulaPanel(step === totalSteps);
      if (step === totalSteps) {
        launchConfetti(W / 2, H / 2);
      }
    } else {
      // standard shape
      var isPeri = state.anim.kind === 'perimeter';
      var symbol = isPeri ? 'P' : 'A';
      var sym  = isPeri ? (shape.perimeterSym || shape.formulaSym) : shape.formulaSym;
      var sub  = isPeri ? (shape.perimeterSub || shape.sub) : shape.sub;
      var comp = isPeri ? (shape.perimeter || shape.compute) : shape.compute;
      var unit = isPeri ? uLen() : uArea();
      var noun = isPeri ? 'perimeter' : 'area';
      if (step === 1) $('step-narration').textContent = 'Drawing the shape…';
      else if (step === 2) $('step-narration').textContent = 'Marking the dimensions you measured.';
      else if (step === 3) { $('step-narration').textContent = 'Writing the ' + noun + ' formula.'; $('f-label').textContent = symbol; $('f-expr').textContent = sym.replace(/^[ACP]\s*=\s*/, ''); $('f-eq2').style.display = 'none'; $('f-sub').style.display = 'none'; $('f-eq3').style.display = 'none'; $('f-result').style.display = 'none'; }
      else if (step === 4) { $('step-narration').textContent = 'Substituting your numbers.'; $('f-eq2').style.display = ''; $('f-sub').style.display = ''; $('f-sub').textContent = sub(state.dims[state.shape]).replace(/^[ACP]\s*=\s*/, ''); }
      else if (step === 5) {
        $('step-narration').textContent = 'And the final ' + noun + ' is…';
        $('f-eq3').style.display = '';
        $('f-result').style.display = '';
        var v = comp(state.dims[state.shape]);
        $('f-result').textContent = fmt(v, 2) + ' ' + unit;
        launchConfetti(W / 2, H / 2);
      }
    }
  }

  function finishAnim() {
    state.anim.running = false;
    state.anim.done = true;
    state.anim.step = state.anim.totalSteps;
    $('play-status').textContent = 'Done — ' + (state.anim.kind === 'perimeter' ? 'perimeter' : 'area') + ' shown.';
    updateReadouts();
    updateFormulaPanel(true);
  }

  function showInstant() {
    resetAnim();
    state.anim.done = true;
    state.anim.step = totalStepsFor(state.shape);
    state.anim.totalSteps = state.anim.step;
    if (state.shape === 'custom' && !state.custom.closed && state.custom.pts.length >= 3) { state.custom.closed = true; recomputeTriangulation(); }
    if (state.shape === 'custom' && state.custom.selfIntersect) {
      $('play-status').textContent = '⚠ Self-intersecting polygon — cannot compute area.';
      playError();
      state.anim.done = false;
      return;
    }
    updateFormulaPanel(true);
    updateReadouts();
    $('play-status').textContent = 'Result shown';
    launchConfetti(W / 2, H / 2);
    if (!state.anim.raf) {
      state.anim.lastTs = performance.now();
      state.anim.raf = requestAnimationFrame(tickAnim);
    }
    requestDraw();
  }

  /* ── Custom-draw events (with drag + delete + hover) ────── */
  function canvasToLocal(e) {
    var rect = canvas.getBoundingClientRect();
    return { x: e.clientX - rect.left, y: e.clientY - rect.top };
  }
  function findVertexAt(p) {
    var pts = state.custom.pts;
    for (var i = 0; i < pts.length; i++) {
      if (Math.hypot(p.x - pts[i].x, p.y - pts[i].y) < 12) return i;
    }
    return -1;
  }
  function snapshotHistory() {
    if (state.shape !== 'custom') return;
    state.history.push({ pts: state.custom.pts.map(function(p){return {x:p.x,y:p.y};}), closed: state.custom.closed });
    if (state.history.length > 30) state.history.shift();
    state.future.length = 0;
  }
  function applyHistory(snap) {
    state.custom.pts = snap.pts.map(function(p){return {x:p.x,y:p.y};});
    state.custom.closed = snap.closed;
    recomputeTriangulation();
  }

  /* ── Hotspot hit-test + inline editor ──────────────────── */
  function findHotspotAt(p) {
    var pad = 6; /* forgiving hit-area so pills are easier to click */
    for (var i = state.dimHotspots.length - 1; i >= 0; i--) {
      var h = state.dimHotspots[i];
      if (p.x >= h.x - pad && p.x <= h.x + h.w + pad && p.y >= h.y - pad && p.y <= h.y + h.h + pad) return h;
    }
    return null;
  }
  function spawnDimEditor(hs) {
    // Close any prior editor
    if (state.dimEditInput && state.dimEditInput.parentNode) state.dimEditInput.parentNode.removeChild(state.dimEditInput);
    var initial = '';
    if (hs.kind === 'shape-dim') {
      initial = state.dims[state.shape][hs.key];
    } else if (hs.kind === 'custom-edge') {
      var sp = computeEdgesAngles(state.custom.pts);
      initial = fmt(sp.edges[hs.key], 4);
    } else if (hs.kind === 'custom-angle') {
      var sp2 = computeEdgesAngles(state.custom.pts);
      initial = fmt(sp2.angles[hs.key], 2);
    }
    var input = document.createElement('input');
    input.type = 'number'; input.step = 'any'; input.min = '0.0001';
    input.value = initial;
    input.className = 'dim-edit-input';
    input.style.color = hs.color;
    input.style.borderColor = hs.color;
    // Position over the canvas (relative to canvas-card)
    var parentRect = canvas.parentElement.getBoundingClientRect();
    var canvasRect = canvas.getBoundingClientRect();
    input.style.left = (canvasRect.left - parentRect.left + hs.x - 4) + 'px';
    input.style.top  = (canvasRect.top  - parentRect.top  + hs.y - 4) + 'px';
    input.style.border = '2px solid ' + hs.color;
    canvas.parentElement.appendChild(input);
    state.dimEditInput = input;
    setTimeout(function () { input.focus(); input.select(); }, 0);
    var cancelled = false;
    function commit() {
      if (cancelled) return;
      var v = parseFloat(input.value);
      if (!(v > 0)) {
        input.classList.add('invalid');
        $('play-status').textContent = '⚠ Value must be greater than 0';
        $('play-status').style.color = '#ff5555';
        playError();
        setTimeout(function () { input.focus(); input.select(); }, 0);
        return;
      }
      applyDimEdit(hs, v);
      removeEditor();
    }
    function removeEditor() {
      if (input.parentNode) input.parentNode.removeChild(input);
      state.dimEditInput = null;
    }
    input.addEventListener('blur', commit);
    input.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') { input.blur(); }
      else if (e.key === 'Escape') { cancelled = true; removeEditor(); }
    });
  }
  function applyDimEdit(hs, v) {
    if (hs.kind === 'shape-dim') {
      state.dims[state.shape][hs.key] = v;
      // sync slider thumb + stepper value if they exist
      var slider = document.querySelector('input[data-dim="' + hs.key + '"]');
      var span = document.querySelector('[data-dim-val="' + hs.key + '"]');
      var dim = SHAPES[state.shape].dims.find(function (d) { return d.key === hs.key; });
      if (slider && dim) slider.value = Math.max(dim.min, Math.min(v, dim.max));
      if (span) span.textContent = fmt(v);
      $('play-status').style.color = '';
      $('play-status').textContent = SHAPES[state.shape].label + ' · ' + hs.key + ' = ' + fmt(v) + ' ' + uLen();
      resetAnim();
      updateFormulaPanel(false);
      requestDraw();
    } else if (hs.kind === 'custom-edge' || hs.kind === 'custom-angle') {
      // Edit polygon spec via turtle-walk rebuild
      var sp = computeEdgesAngles(state.custom.pts);
      if (hs.kind === 'custom-edge') sp.edges[hs.key] = v;
      else                            sp.angles[hs.key] = v;
      var walked = rebuildPolygonFromSpec(sp.edges, sp.angles, sp.anchor, sp.initHeadingRad, sp.winding);
      var perimeterPx = sp.edges.reduce(function (a, b) { return a + b; }, 0) * PX_PER_UNIT;
      var gapFrac = perimeterPx > 0 ? walked.closureGapPx / perimeterPx : 0;
      // If closure is acceptable, use walked verts; otherwise auto-close (snap last vertex to anchor implicitly)
      var newPts = walked.pts.slice(); // walked.pts already has n vertices (v0..v_{n-1});
      // The implicit (n-1 → 0) edge closes the polygon by construction.
      snapshotHistory();
      state.custom.pts = newPts;
      state.custom.closed = true;
      recomputeTriangulation();
      resetAnim();
      state.anim.done = false;
      $('play-status').style.color = '';
      if (gapFrac > 0.005) {
        $('play-status').textContent = '↺ Polygon rebuilt — last edge auto-adjusted to close (gap ' + fmt(gapFrac * 100, 1) + '%)';
      } else {
        $('play-status').textContent = '↺ Polygon rebuilt';
      }
      requestDraw();
    }
  }

  canvas.addEventListener('pointerdown', function (e) {
    if (state.mode !== 'simulate') return;
    // Hit-test dim hotspots FIRST (works for standard shapes and custom polygons)
    var pHotspot = canvasToLocal(e);
    var hs = findHotspotAt(pHotspot);
    if (hs) {
      e.preventDefault();
      spawnDimEditor(hs);
      return;
    }
    if (state.shape !== 'custom') return;
    if (state.anim.running || state.anim.done) return;
    var p = canvasToLocal(e);
    var hit = findVertexAt(p);
    if (hit >= 0) {
      if (hit === 0 && state.custom.pts.length >= 3 && !state.custom.closed) {
        snapshotHistory();
        state.custom.closed = true;
        recomputeTriangulation();
        playPop();
        $('play-status').textContent = state.custom.selfIntersect ? '⚠ Self-intersecting — fix edges' : 'Closed! Press Simulate to triangulate.';
        requestDraw();
        return;
      }
      // start drag
      state.custom.dragIdx = hit;
      canvas.classList.add('dragging');
      canvas.setPointerCapture(e.pointerId);
      snapshotHistory();
      return;
    }
    if (state.custom.closed) return;
    snapshotHistory();
    state.custom.pts.push(p);
    playClick();
    requestDraw();
  });
  canvas.addEventListener('pointermove', function (e) {
    if (state.mode !== 'simulate') return;
    var p0 = canvasToLocal(e);
    // Hot-spot hover (works for any shape) — only if not dragging
    if (state.shape !== 'custom' || state.custom.dragIdx < 0) {
      var hs0 = findHotspotAt(p0);
      var newKey = hs0 ? (hs0.kind + ':' + hs0.key) : null;
      if (hs0) {
        canvas.classList.add('dim-hover');
      } else {
        canvas.classList.remove('dim-hover');
      }
      if (newKey !== hoverDimKey) { hoverDimKey = newKey; requestDraw(); }
    }
    if (state.shape !== 'custom') return;
    var p = p0;
    if (state.custom.dragIdx >= 0) {
      state.custom.pts[state.custom.dragIdx].x = p.x;
      state.custom.pts[state.custom.dragIdx].y = p.y;
      if (state.custom.closed) recomputeTriangulation();
      requestDraw();
      return;
    }
    var hit = findVertexAt(p);
    if (hit !== state.custom.hoverIdx) {
      state.custom.hoverIdx = hit;
      canvas.style.cursor = hit >= 0 ? 'grab' : 'crosshair';
      requestDraw();
    }
  });
  canvas.addEventListener('pointerup', function (e) {
    if (state.custom.dragIdx >= 0) {
      state.custom.dragIdx = -1;
      canvas.classList.remove('dragging');
      canvas.style.cursor = 'crosshair';
      playClick();
    }
  });
  canvas.addEventListener('pointercancel', function () {
    if (state.custom.dragIdx >= 0) {
      state.custom.dragIdx = -1;
      canvas.classList.remove('dragging');
      canvas.style.cursor = 'crosshair';
    }
  });

  $('draw-finish').addEventListener('click', function () {
    if (state.custom.pts.length >= 3) {
      snapshotHistory();
      state.custom.closed = true;
      recomputeTriangulation();
      $('play-status').textContent = state.custom.selfIntersect ? '⚠ Self-intersecting — fix edges' : 'Closed! Press Simulate to triangulate.';
      playPop();
      requestDraw();
    } else { playError(); $('play-status').textContent = 'Need at least 3 points first.'; }
  });
  $('draw-undo').addEventListener('click', function () {
    snapshotHistory();
    if (state.custom.closed) { state.custom.closed = false; }
    else state.custom.pts.pop();
    recomputeTriangulation();
    playClick();
    requestDraw();
  });
  $('draw-clear').addEventListener('click', function () {
    snapshotHistory();
    state.custom.pts = []; state.custom.closed = false;
    resetAnim();
    playClick();
    requestDraw();
  });

  /* ── Custom-polygon gallery ─────────────────────────────── */
  var GALLERY = {
    L: function (cx, cy, sz) {
      return [
        { x: cx - sz, y: cy - sz * 0.8 },
        { x: cx + sz * 0.2, y: cy - sz * 0.8 },
        { x: cx + sz * 0.2, y: cy + sz * 0.1 },
        { x: cx + sz, y: cy + sz * 0.1 },
        { x: cx + sz, y: cy + sz * 0.8 },
        { x: cx - sz, y: cy + sz * 0.8 }
      ];
    },
    T: function (cx, cy, sz) {
      return [
        { x: cx - sz, y: cy - sz * 0.7 },
        { x: cx + sz, y: cy - sz * 0.7 },
        { x: cx + sz, y: cy - sz * 0.2 },
        { x: cx + sz * 0.3, y: cy - sz * 0.2 },
        { x: cx + sz * 0.3, y: cy + sz * 0.7 },
        { x: cx - sz * 0.3, y: cy + sz * 0.7 },
        { x: cx - sz * 0.3, y: cy - sz * 0.2 },
        { x: cx - sz, y: cy - sz * 0.2 }
      ];
    },
    plus: function (cx, cy, sz) {
      var a = sz * 0.3, b = sz * 0.8;
      return [
        { x: cx - a, y: cy - b }, { x: cx + a, y: cy - b },
        { x: cx + a, y: cy - a }, { x: cx + b, y: cy - a },
        { x: cx + b, y: cy + a }, { x: cx + a, y: cy + a },
        { x: cx + a, y: cy + b }, { x: cx - a, y: cy + b },
        { x: cx - a, y: cy + a }, { x: cx - b, y: cy + a },
        { x: cx - b, y: cy - a }, { x: cx - a, y: cy - a }
      ];
    },
    arrow: function (cx, cy, sz) {
      return [
        { x: cx - sz, y: cy - sz * 0.3 },
        { x: cx + sz * 0.2, y: cy - sz * 0.3 },
        { x: cx + sz * 0.2, y: cy - sz * 0.7 },
        { x: cx + sz, y: cy },
        { x: cx + sz * 0.2, y: cy + sz * 0.7 },
        { x: cx + sz * 0.2, y: cy + sz * 0.3 },
        { x: cx - sz, y: cy + sz * 0.3 }
      ];
    },
    house: function (cx, cy, sz) {
      return [
        { x: cx - sz, y: cy + sz * 0.6 },
        { x: cx - sz, y: cy - sz * 0.2 },
        { x: cx, y: cy - sz * 0.8 },
        { x: cx + sz, y: cy - sz * 0.2 },
        { x: cx + sz, y: cy + sz * 0.6 }
      ];
    },
    star: function (cx, cy, sz) {
      var pts = [];
      var n = 5;
      for (var i = 0; i < n * 2; i++) {
        var r = (i % 2 === 0) ? sz : sz * 0.42;
        var a = -Math.PI / 2 + i * Math.PI / n;
        pts.push({ x: cx + r * Math.cos(a), y: cy + r * Math.sin(a) });
      }
      return pts;
    }
  };
  function loadGallery(key) {
    var cx = W / 2, cy = H / 2, sz = Math.min(W, H) * 0.32;
    var fn = GALLERY[key]; if (!fn) return;
    snapshotHistory();
    state.custom.pts = fn(cx, cy, sz);
