    // Compact iPad-friendly: aspect 0.6 but capped so layout stays one-screen
    var h = Math.min(460, Math.round(w * 0.55));
    if (h < 280) h = 280;
    var dpr = window.devicePixelRatio || 1;
    canvas.style.width = w + 'px';
    canvas.style.height = h + 'px';
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    W = w; H = h;
    requestDraw();
