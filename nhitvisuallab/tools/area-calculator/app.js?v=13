    showQuizQ();
  }
  function showQuizQ() {
    var q = state.quiz.qs[state.quiz.idx];
    var shape = SHAPES[q.key];
    var dimsTxt = shape.dims.map(function (dm) { return dm.label + ' = ' + fmt(q.dims[dm.key]) + ' ' + (dm.unit || (dm.key === 'theta' ? '°' : uLen())); }).join(', ');
    $('qz-idx').textContent = state.quiz.idx + 1;
    $('qz-score').textContent = state.quiz.score;
    $('qz-prompt').innerHTML = '<strong>Find the area of this ' + shape.label + '</strong> &mdash; ' + dimsTxt + '.';
    drawPracticeShape($('quiz-canvas'), q.key, q.dims);
    $('qz-input').value = '';
    $('qz-feedback').className = 'pq-feedback';
    $('qz-feedback').textContent = '';
    $('qz-submit').disabled = false;
    $('qz-next').disabled = true;
    state.quiz.answered = false;
  }
  $('qz-submit').addEventListener('click', function () {
    if (state.quiz.answered) return;
    var q = state.quiz.qs[state.quiz.idx];
    var v = parseFloat($('qz-input').value);
    if (isNaN(v)) { $('qz-feedback').className = 'pq-feedback wrong'; $('qz-feedback').textContent = 'Please enter a number.'; playError(); return; }
    var tol = Math.max(0.05, q.answer * 0.01);
    var ok = Math.abs(v - q.answer) <= tol;
    if (ok) {
      state.quiz.score += 1;
      $('qz-feedback').className = 'pq-feedback correct';
      $('qz-feedback').textContent = '✓ Correct! Area = ' + fmt(q.answer, 2);
      playSuccess();
    } else {
      $('qz-feedback').className = 'pq-feedback wrong';
      $('qz-feedback').textContent = '✗ The correct answer is ' + fmt(q.answer, 2) + '.';
      playError();
    }
    state.quiz.results.push({ key: q.key, given: v, ans: q.answer, ok: ok });
    state.quiz.answered = true;
    $('qz-submit').disabled = true;
    $('qz-next').disabled = false;
    $('qz-score').textContent = state.quiz.score;
  });
  $('qz-next').addEventListener('click', function () {
    state.quiz.idx += 1;
    if (state.quiz.idx >= state.quiz.qs.length) {
      showQuizResult();
    } else showQuizQ();
  });
  $('qz-new').addEventListener('click', startQuiz);
  function showQuizResult() {
    $('quiz-panel').style.display = 'none';
    $('quiz-result').style.display = '';
    var sc = state.quiz.score;
    var stars = sc === 5 ? '⭐⭐⭐' : sc >= 3 ? '🟢🟢' : '🔴';
    $('qr-stars').textContent = stars;
    $('qr-score').textContent = sc + ' / 5';
    var html = '';
    state.quiz.results.forEach(function (r, i) {
      html += '<div class="qr-row ' + (r.ok ? 'ok' : 'no') + '">Q' + (i + 1) + ' (' + SHAPES[r.key].label + '): you said ' + (isNaN(r.given) ? '—' : fmt(r.given, 2)) + ', answer was ' + fmt(r.ans, 2) + '</div>';
    });
    $('qr-breakdown').innerHTML = html;
  }

  /* ── Triangle panel during custom triangulation ─────────── */
  function updateTriPanel() {
    var panel = $('tri-panel');
    if (!panel) return;
    if (state.shape !== 'custom' || !(state.anim.running || state.anim.done) || state.custom.pts.length < 3 || !state.custom.closed || state.custom.selfIntersect) {
      panel.style.display = 'none';
      return;
    }
    panel.style.display = 'block';
    var tris = state.custom.triangles;
    var triCount = tris.length;
    var completed = Math.min(triCount, Math.max(0, state.anim.step - 1));
    var palette = ['#ff6fb1', '#4cc9f0', '#ffd166', '#95e06c', '#c79bff', '#ff8a3d', '#26d4b7', '#ffafd2'];
    var html = '<div class="tri-panel-title">Ear-clip Δ Areas</div>';
    var total = 0;
    for (var i = 0; i < triCount; i++) {
      var T = tris[i];
      var a = triArea(T.a, T.b, T.c);
      var done = i < completed;
      if (done) total += a;
      html += '<div class="tri-row' + (i === completed - 1 ? ' new' : '') + '" style="opacity:' + (done ? 1 : 0.35) + '">' +
              '<span><span class="tri-dot" style="background:' + palette[i % palette.length] + '"></span>T' + (i + 1) + '</span>' +
              '<span>' + (done ? fmt(pxAreaToUnit(a), 2) + ' ' + uArea() : '—') + '</span>' +
              '</div>';
    }
    html += '<div class="tri-row tri-total"><span>Σ Total</span><span>' + fmt(pxAreaToUnit(total), 2) + ' ' + uArea() + '</span></div>';
    panel.innerHTML = html;
  }

  /* ── Scalene triangle-inequality warning ────────────────── */
  function checkScaleneInequality() {
    if (state.shape !== 'scalene') return true;
    var d = state.dims.scalene;
    var ok = (d.a + d.b > d.c) && (d.b + d.c > d.a) && (d.a + d.c > d.b);
    var status = $('play-status');
    if (!ok) {
      status.textContent = '⚠ Triangle inequality fails — these sides cannot form a triangle.';
      status.style.color = '#ff5555';
    } else {
      status.style.color = '';
    }
    return ok;
  }

  /* ── Wrap draw() to also update tri-panel ───────────────── */
  var _origDraw = draw;
  draw = function () { _origDraw(); updateTriPanel(); };

  /* ── Wrap buildDimControls to re-attach editing + revalidate ── */
  var _origBuildDim = buildDimControls;
  buildDimControls = function () {
    _origBuildDim();
    attachStepperEditing();
    if (state.shape === 'scalene') checkScaleneInequality();
  };
  $('dim-controls').addEventListener('input', function () {
    if (state.shape === 'scalene') checkScaleneInequality();
  });

  /* ── Define-Dimensions modal ────────────────────────────── */
  var dimModalState = { spec: null, originalPts: null };

  function refreshDefineDimsButton() {
    var btn = $('btn-define-dims');
    if (!btn) return;
    var visible = (state.shape === 'custom' && state.custom.closed &&
                   state.custom.pts.length >= 3 && !state.custom.selfIntersect &&
                   state.anim.done);
    btn.style.display = visible ? 'block' : 'none';
  }

  function openDefineModal() {
    if (state.shape !== 'custom' || !state.custom.closed || state.custom.pts.length < 3) return;
    if (state.custom.selfIntersect) {
      $('play-status').textContent = '⚠ Fix self-intersection before defining dimensions';
      return;
    }
    dimModalState.spec = computeEdgesAngles(state.custom.pts);
    dimModalState.originalPts = state.custom.pts.map(function (p) { return { x: p.x, y: p.y }; });
    renderDimModalRows();
    $('dim-modal').style.display = 'flex';
    playClick();
  }
  function closeDefineModal() {
    $('dim-modal').style.display = 'none';
  }
  function renderDimModalRows() {
    var sp = dimModalState.spec;
    var n = sp.edges.length;
    var rows = '';
    for (var i = 0; i < n; i++) {
      var edgeNext = sp.edges[i];
      var ang = sp.angles[i];
      var isDerived = (i === 0); // angle[0] is the closure angle when walking
      rows +=
        '<tr' + (isDerived ? ' class="derived"' : '') + '>' +
          '<td>V' + (i + 1) + '</td>' +
          '<td>' +
            '<input type="number" class="dim-input" data-kind="edge" data-i="' + i + '" value="' + (Math.round(edgeNext * 10000) / 10000) + '" step="any" min="0.0001">' +
            '<span class="dim-unit">' + uLen() + '</span>' +
          '</td>' +
          '<td>' +
            '<input type="number" class="dim-input" data-kind="angle" data-i="' + i + '" value="' + (Math.round(ang * 100) / 100) + '" step="any" min="0.0001" max="359.9999"' + (isDerived ? ' readonly title="Closure angle — derived from walking the other angles"' : '') + '>' +
            '<span class="dim-unit">°</span>' +
          '</td>' +
        '</tr>';
    }
    $('dim-modal-rows').innerHTML = rows;
    updateDimModalSummary();
    // Live update on every edit
    document.querySelectorAll('#dim-modal-rows .dim-input').forEach(function (inp) {
      inp.addEventListener('input', function () {
        var v = parseFloat(inp.value);
        if (!(v > 0)) { inp.classList.add('invalid'); }
        else inp.classList.remove('invalid');
        updateDimModalSummary();
      });
    });
  }
  function readDimModalSpec() {
    var sp = dimModalState.spec;
    var n = sp.edges.length;
    var edges = sp.edges.slice(), angles = sp.angles.slice();
    var ok = true;
    document.querySelectorAll('#dim-modal-rows .dim-input').forEach(function (inp) {
      var v = parseFloat(inp.value);
      var i = +inp.getAttribute('data-i');
      var kind = inp.getAttribute('data-kind');
      if (!(v > 0)) { ok = false; return; }
      if (kind === 'edge') edges[i] = v;
      else angles[i] = v;
    });
    return { edges: edges, angles: angles, ok: ok };
  }
  function updateDimModalSummary() {
    var read = readDimModalSpec();
    var n = read.edges.length;
    var summary = $('dim-modal-summary');
    if (!read.ok) {
      summary.className = 'dim-modal-summary warn';
      summary.innerHTML = '⚠ All edges and angles must be positive.';
      return;
    }
    var angleSum = 0;
    for (var i = 1; i < n; i++) angleSum += read.angles[i]; // exclude derived angle[0]
    var expectedSum = (n - 2) * 180; // total interior sum
    var derivedAngle0 = expectedSum - angleSum; // what angle[0] SHOULD be for angle-sum consistency

    var walked = rebuildPolygonFromSpec(read.edges, read.angles, dimModalState.spec.anchor, dimModalState.spec.initHeadingRad, dimModalState.spec.winding);
    var gapUnits = walked.closureGapPx / PX_PER_UNIT;
    var perimeter = read.edges.reduce(function (a, b) { return a + b; }, 0);
    var gapPct = perimeter > 0 ? (gapUnits / perimeter * 100) : 0;

    // Compute area via shoelace of walked points
    var area = polySignedAreaAbs(walked.pts) / (PX_PER_UNIT * PX_PER_UNIT);

    var html = '';
    html += '<strong>n = ' + n + '</strong> sides &nbsp;·&nbsp; ';
    html += 'Σ interior angles = <strong>' + fmt(angleSum + read.angles[0], 2) + '°</strong> (required: ' + fmt(expectedSum, 0) + '°)<br>';
    html += 'Derived closure angle at V1 = <strong>' + fmt(walked.closureAngleDeg, 2) + '°</strong> (your input: ' + fmt(read.angles[0], 2) + '°)<br>';
    html += 'Closure gap = <strong>' + fmt(gapUnits, 3) + ' ' + uLen() + '</strong> (' + fmt(gapPct, 2) + '% of perimeter) ';
    html += 'Reconstructed area ≈ <strong>' + fmt(area, 2) + ' ' + uArea() + '</strong>';

    var goodClosure = (gapPct < 0.5);
    summary.className = 'dim-modal-summary ' + (goodClosure ? 'ok' : 'warn');
    if (!goodClosure) html = '<strong style="color:var(--red)">⚠ Polygon does not close</strong> &mdash; press <strong>Auto-close</strong> to snap the last edge.<br>' + html;
    summary.innerHTML = html;
  }
  function polySignedAreaAbs(pts) {
    return Math.abs(polySignedArea(pts));
  }
  function applyDefineModal(autoClose) {
    var read = readDimModalSpec();
    if (!read.ok) { $('play-status').textContent = '⚠ Some edges/angles invalid (must be > 0)'; playError(); return; }
    var sp = dimModalState.spec;
    var walked = rebuildPolygonFromSpec(read.edges, read.angles, sp.anchor, sp.initHeadingRad, sp.winding);
    var newPts;
    if (autoClose) {
      // Use the walked n vertices (v0..v_{n-1}); the implicit last edge will be exactly
      // from v_{n-1} back to v0 (anchor). So the polygon closes by construction.
      newPts = walked.pts.slice();
    } else {
      var gapPx = walked.closureGapPx;
      var perimeterPx = read.edges.reduce(function (a, b) { return a + b; }, 0) * PX_PER_UNIT;
      if (perimeterPx > 0 && gapPx / perimeterPx > 0.005) {
        $('play-status').textContent = '⚠ Closure gap too large — use Auto-close or adjust values';
        $('play-status').style.color = '#ff5555';
        playError();
        return;
      }
      newPts = walked.pts.slice();
    }
    snapshotHistory();
    state.custom.pts = newPts;
    state.custom.closed = true;
    recomputeTriangulation();
    resetAnim();
    state.anim.done = false;
    $('play-status').style.color = '';
    $('play-status').textContent = 'Polygon redefined — press Simulate to triangulate';
    closeDefineModal();
    playSuccess();
    requestDraw();
  }
  function resetDefineModal() {
    if (!dimModalState.originalPts) return;
    dimModalState.spec = computeEdgesAngles(dimModalState.originalPts);
    renderDimModalRows();
    playClick();
  }
  // Wire buttons
  $('btn-define-dims').addEventListener('click', openDefineModal);
  $('dim-modal-cancel').addEventListener('click', closeDefineModal);
  $('dim-modal-apply').addEventListener('click', function () { applyDefineModal(false); });
  $('dim-modal-autoclose').addEventListener('click', function () { applyDefineModal(true); });
  $('dim-modal-reset').addEventListener('click', resetDefineModal);
  // Click outside modal closes it
  $('dim-modal').addEventListener('click', function (e) {
    if (e.target === $('dim-modal')) closeDefineModal();
  });
  // Esc closes modal
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && $('dim-modal').style.display === 'flex') closeDefineModal();
  });

  /* Hook button visibility into updateReadouts — called from every state-change
     path including finishAnim, showInstant, resetAnim, selectShape, etc. */
  var _origUpdateReadouts = updateReadouts;
  updateReadouts = function () { _origUpdateReadouts(); refreshDefineDimsButton(); };

  /* ── Init ───────────────────────────────────────────────── */
  buildShapeGrid();
  buildDimControls();
  renderPresets();
  resize();
  updateFormulaPanel(false);
  updateReadouts();
})();
