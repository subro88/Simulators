          solution: [
            'r = d/2 = ' + (r) + ' mm',
            'J = π·d⁴/32 = π·' + d + '⁴/32 = ' + J.toFixed(0) + ' mm⁴',
            'τ = T·r/J = ' + T + '×1000 × ' + r + ' / ' + J.toFixed(0) + ' = ' + tau.toFixed(1) + ' MPa'
          ]
        };
      },
      function () {
        var d = Math.round((Math.random() * 10 + 10));
