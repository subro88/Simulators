  function drawExploreCanvas() {
    var c = $('explore-canvas'); if (!c) return;
    var x = c.getContext('2d');
    var cW = XW, cH = XH;   /* logical space — backing store is DPR-scaled */
    x.fillStyle = '#0d1117';
    x.fillRect(0, 0, cW, cH);
    x.fillStyle = '#ff8c42';
    x.font = '700 14px Segoe UI';
    x.textAlign = 'center';
    x.fillText(EXPLORE[currentCat][currentItemIdx].name, cW / 2, 30);
    /* Simple schematic: round shaft with torque arrows */
    var cy = cH / 2 + 10;
    var x0 = 200, x1 = cW - 200;
    x.fillStyle = '#e0e6f0';
    x.fillRect(x0, cy - 18, x1 - x0, 36);
    x.strokeStyle = '#3a4575';
    x.strokeRect(x0, cy - 18, x1 - x0, 36);
    /* Twist helix preview */
    x.strokeStyle = 'rgba(13,17,23,0.55)';
    x.lineWidth = 1.2;
    for (var k = 0; k < 3; k++) {
      var phase = k * Math.PI * 2 / 3;
      x.beginPath();
      for (var s = 0; s <= 40; s++) {
        var u = s / 40;
        var xx = x0 + u * (x1 - x0);
        var yy = cy + 16 * Math.sin(phase + u * Math.PI * 0.8);
        if (s === 0) x.moveTo(xx, yy); else x.lineTo(xx, yy);
      }
      x.stroke();
    }
    /* Torque arrows */
    drawTorqueArrow(x, x0 - 20, cy, -1);
    drawTorqueArrow(x, x1 + 20, cy,  1);
    x.fillStyle = '#dde3f0';
    x.font = '600 11px Segoe UI';
    x.textAlign = 'center';
    x.fillText('T', x0 - 50, cy + 5);
    x.fillText('T', x1 + 50, cy + 5);
  }
  function drawTorqueArrow(ctx, cx, cy, dir) {
    ctx.strokeStyle = '#ff8c42';
    ctx.lineWidth = 2.5;
    ctx.beginPath();
    ctx.arc(cx, cy, 26, dir > 0 ? -Math.PI * 0.6 : Math.PI * 0.4, dir > 0 ? Math.PI * 0.5 : Math.PI * 1.5);
    ctx.stroke();
    /* Arrowhead */
    ctx.fillStyle = '#ff8c42';
    ctx.beginPath();
    if (dir > 0) {
      ctx.moveTo(cx + 8, cy - 24);
      ctx.lineTo(cx, cy - 34);
      ctx.lineTo(cx + 12, cy - 32);
    } else {
      ctx.moveTo(cx - 8, cy - 24);
      ctx.lineTo(cx, cy - 34);
      ctx.lineTo(cx - 12, cy - 32);
    }
    ctx.fill();
  }

