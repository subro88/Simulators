            '   = ' + J.toFixed(0) + ' mm⁴'
          ]
        };
      },
      function () {
        var d = Math.round((Math.random() * 10 + 10));
        var L = Math.round((Math.random() * 100 + 80) / 10) * 10;
        var T = Math.round((Math.random() * 40 + 20));
        var G = 80;
        var J = Math.PI * Math.pow(d, 4) / 32;
        var theta = (T * 1000 * L) / (G * 1000 * J);
        var thetaDeg = theta * 180 / Math.PI;
        return {
          prompt: 'A mild steel shaft (G = 80 GPa) of diameter ' + d + ' mm and length ' + L + ' mm carries a torque of ' + T + ' N·m. Calculate the angle of twist in degrees.',
          unit: '°',
          answer: thetaDeg,
          tol: 0.03,
          solution: [
            'J = π·d⁴/32 = ' + J.toFixed(0) + ' mm⁴',
            'θ = T·L/(G·J) = ' + T + '×1000 × ' + L + ' / (' + (G*1000) + ' × ' + J.toFixed(0) + ') = ' + theta.toFixed(4) + ' rad',
            'θ = ' + theta.toFixed(4) + ' × 180/π = ' + thetaDeg.toFixed(2) + '°'
