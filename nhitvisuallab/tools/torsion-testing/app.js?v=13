  function wireUI() {
    /* Mode tabs */
    var modeTabs = document.querySelectorAll('#mode-tabs .pill');
    for (var i = 0; i < modeTabs.length; i++) {
      (function (t) {
        t.addEventListener('click', function () {
          for (var k = 0; k < modeTabs.length; k++) modeTabs[k].classList.remove('active');
          t.classList.add('active');
          switchMode(t.dataset.value);
          playClick();
        });
      })(modeTabs[i]);
    }

    /* Unit toggle */
    var unitTabs = document.querySelectorAll('#unit-toggle .pill');
    for (var u = 0; u < unitTabs.length; u++) {
      (function (t) {
        t.addEventListener('click', function () {
          for (var k = 0; k < unitTabs.length; k++) {
            unitTabs[k].classList.remove('active');
            unitTabs[k].setAttribute('aria-pressed', 'false');
          }
          t.classList.add('active');
          t.setAttribute('aria-pressed', 'true');
          state.units = t.dataset.value;
          refreshUnits();
          playClick();
        });
      })(unitTabs[u]);
    }

    /* Test type */
    var ttTabs = document.querySelectorAll('#test-type-tabs .pill');
    for (var tt = 0; tt < ttTabs.length; tt++) {
      (function (t) {
        t.addEventListener('click', function () {
          if (state.animPhase === 'running') return;
          for (var k = 0; k < ttTabs.length; k++) ttTabs[k].classList.remove('active');
          t.classList.add('active');
          state.testType = t.dataset.value;
          $('field-din').style.display = state.testType === 'hollow' ? '' : 'none';
          advanceStep(3);
          playClick();
          resetTest();
        });
      })(ttTabs[tt]);
    }

    /* Steppers */
    /* The inner-diameter stepper allows 2-20 mm while the outer allows 6-25, so
       the bore could be set larger than the shaft. polarJ() and the renderer
       both guard with min(din, dia-1) so nothing breaks, but the input would
       still read 20 while the tool quietly computed with 5. Keep the control
       honest by clamping it to the current outer diameter. */
    function clampInnerDia() {
      var maxIn = state.dia - 1;
      if (state.din > maxIn) {
        state.din = maxIn;
        var inp = $('input-din');
        if (inp) {
          inp.value = maxIn;
          var lo = parseFloat(inp.min), hi = parseFloat(inp.max);
          var fill = $('fill-din');
          if (fill) fill.style.width = (((maxIn - lo) / (hi - lo)) * 100) + '%';
        }
      }
    }
    wireStepper('input-dia',   'fill-dia',   'dia',   function () { clampInnerDia(); advanceStep(2); resetTest(); }, 'length');
    wireStepper('input-din',   'fill-din',   'din',   function () { clampInnerDia(); resetTest(); }, 'length');
    wireStepper('input-gl',    'fill-gl',    'gl',    function () { advanceStep(2); resetTest(); }, 'length');
    wireStepper('input-speed', 'fill-speed', 'speed', function () { advanceStep(4); }, 'speed');

    /* Action buttons */
    $('gab-mount').addEventListener('click', mountSpecimen);
    $('gab-start').addEventListener('click', startTest);
    $('gab-reset').addEventListener('click', function () { resetTest(); playClick(); });
    $('gab-csv').addEventListener('click', exportCSV);
    $('gab-png').addEventListener('click', exportPNG);
    $('gab-report').addEventListener('click', exportTestReport);
    $('gab-calc').addEventListener('click', openCalcModal);
    $('calc-modal-close').addEventListener('click', closeCalcModal);
    $('calc-modal').addEventListener('click', function (e) {
      if (e.target === this) closeCalcModal();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && $('calc-modal').classList.contains('active')) closeCalcModal();
    });
    /* Hidden refs for context menu */
    $('btn-export-csv').addEventListener('click', exportCSV);
    $('btn-export-png').addEventListener('click', exportPNG);

    /* Graph view toggle (T-θ ↔ τ-γ) */
    var gvTabs = document.querySelectorAll('#graph-view-tabs .pill');
    for (var gv = 0; gv < gvTabs.length; gv++) {
      (function (t) {
        t.addEventListener('click', function () {
          for (var k = 0; k < gvTabs.length; k++) {
            gvTabs[k].classList.remove('active');
            gvTabs[k].setAttribute('aria-pressed', 'false');
          }
          t.classList.add('active');
          t.setAttribute('aria-pressed', 'true');
          state.showTauGamma = t.dataset.value === 'tau-gamma';
          drawGraph();
          playClick();
        });
      })(gvTabs[gv]);
    }
    /* Clear ghost button */
    var ghostBtn = $('btn-ghost-clear');
    if (ghostBtn) ghostBtn.addEventListener('click', function () {
      state.ghostCurve = null;
      state.ghostLabel = '';
      ghostBtn.style.display = 'none';
      drawGraph();
      playClick();
    });

    /* Practice */
    $('btn-check').addEventListener('click', checkPracticeAnswer);
    $('btn-show-sol').addEventListener('click', showSolution);
    $('btn-next-p').addEventListener('click', newPracticeQ);
    /* Quiz */
    $('btn-quiz-next').addEventListener('click', nextQuiz);
    $('btn-new-quiz').addEventListener('click', startQuiz);

    /* Context menus */
    graphCanvas.addEventListener('contextmenu', function (e) {
      e.preventDefault();
      var items = [
        { icon: '📈', label: 'Save Graph as PNG', action: exportPNG },
        { icon: '📄', label: 'Export CSV Data',   action: exportCSV },
        { icon: '📜', label: 'Export PDF Report', action: exportTestReport },
        { sep: true },
        { icon: state.showGrid ? '☑' : '☐',
          label: state.showGrid ? 'Hide Grid' : 'Show Grid',
          action: function () { state.showGrid = !state.showGrid; drawGraph(); } },
        { sep: true },
        { icon: '↺', label: 'Reset Test', action: resetTest }
      ];
      showCtxMenu(e.clientX, e.clientY, items);
    });
    machineCanvas.addEventListener('contextmenu', function (e) {
      e.preventDefault();
      var items = [
        { icon: '📜', label: 'Export PDF Report', action: exportTestReport },
        { icon: state.showDims ? '☑' : '☐',
          label: state.showDims ? 'Hide Dimensions' : 'Show Dimensions',
          action: function () { state.showDims = !state.showDims; drawMachine(); } },
        { sep: true },
        { icon: '↺', label: 'Reset Test', action: resetTest }
      ];
      showCtxMenu(e.clientX, e.clientY, items);
    });

    /* ─── E-Stop hit zone ─────────────────────────────────────────
       The mushroom-shaped emergency-stop button is painted into the
       control console at (MW - 86, MH - 43). Make that area an
       actual clickable hot-spot. */
    function eStopHit(e) {
      var rect = machineCanvas.getBoundingClientRect();
      /* Map into LOGICAL space. This used to divide by the backing store,
         which was only correct while backing == logical; now that the canvas
         is DPR-scaled that would land the hit-test off by the DPR factor. */
      var sx = MW / rect.width;
      var sy = MH / rect.height;
      var cx = (e.clientX - rect.left) * sx;
      var cy = (e.clientY - rect.top)  * sy;
      /* console x = 30, y = MH-76, w = MW-60, h = 66 → ex,ey ≈ (MW-86, MH-43) */
      var ex = MW - 86, ey = MH - 43;
      var dx = cx - ex, dy = cy - ey;
      return Math.sqrt(dx * dx + dy * dy) < 22;
    }
    machineCanvas.addEventListener('pointermove', function (e) {
      machineCanvas.style.cursor = eStopHit(e) ? 'pointer' : '';
    });
    machineCanvas.addEventListener('pointerdown', function (e) {
      if (e.button !== 0) return;
      if (!eStopHit(e)) return;
      e.preventDefault();
      triggerEStop();
    });

    /* Keyboard shortcuts */
    document.addEventListener('keydown', function (e) {
      if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
      if (e.key === '1') document.querySelector('#mode-tabs .pill[data-value="simulate"]').click();
      else if (e.key === '2') document.querySelector('#mode-tabs .pill[data-value="explore"]').click();
      else if (e.key === '3') document.querySelector('#mode-tabs .pill[data-value="practice"]').click();
      else if (e.key === '4') document.querySelector('#mode-tabs .pill[data-value="quiz"]').click();
      else if (e.key === ' ') {
        if (state.animPhase === 'idle') mountSpecimen();
        else if (state.animPhase === 'mounted') startTest();
        e.preventDefault();
      }
      else if (e.key === 'r' || e.key === 'R') resetTest();
    });
  }

  function wireLearnPanels() {
    var expAll = $('learn-expand-all');
    var colAll = $('learn-collapse-all');
    var cards = document.querySelectorAll('.learn-card');
    if (expAll) expAll.addEventListener('click', function () {
      for (var i = 0; i < cards.length; i++) cards[i].open = true;
      drawStressDistribution();
    });
    if (colAll) colAll.addEventListener('click', function () {
      for (var i = 0; i < cards.length; i++) cards[i].open = false;
    });
    /* Redraw stress chart whenever its card opens */
    var stressCard = $('lp-stress');
    if (stressCard) stressCard.addEventListener('toggle', function () {
      if (stressCard.open) drawStressDistribution();
    });
  }

  /* ── BOOT ── */
  initCanvases();
  fitAllCanvases();
  buildLabSteps();
  buildMaterialTabs();
  wireUI();
  wireLearnPanels();
  drawMachine();
  drawGraph();
  updateBadges();
  renderLearningPanels();

  /* Refit and repaint on resize — the backing stores must follow the card
     widths, otherwise every canvas goes soft again as soon as the window
     changes. There was no resize handling at all before. */
  window.addEventListener('resize', function () {
    fitAllCanvases();
    drawMachine();
    drawGraph();
    renderLearningPanels();
    if (typeof drawExploreCanvas === 'function' && state.mode === 'explore') drawExploreCanvas();
  });

})();
