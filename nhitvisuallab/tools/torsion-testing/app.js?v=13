    mctx.font = '700 8px "Segoe UI"';
    mctx.textAlign = 'left';
    mctx.fillText(state.testType === 'solid' ? 'SOLID' : 'HOLLOW', x + 6, y + h - 5);
    mctx.fillStyle = '#ff8c42';
    mctx.font = '700 8px Courier New';
    mctx.textAlign = 'right';
    mctx.fillText('θ = ' + fmt(state.rotAngleDeg, 1) + '°', x + w - 6, y + h - 5);
  }

  /* ── Specimen between the two chucks — dog-bone profile with helix ── */
  function drawSpecimen() {
    var leftX = L_CHUCK_X, rightX = R_CHUCK_X;
    var midY = AXIS_Y;
    var specLen = rightX - leftX;
    var maxD = 25;
    var pxPerMm = 1.05;
    var dOuter = Math.min(state.dia, maxD) * pxPerMm;
    var dInner = state.testType === 'hollow' ? Math.min(state.din, state.dia - 1) * pxPerMm : 0;
    var dGrip = 24;
    var gripIn = 22;
    var filletLen = 20;

    var fractured = state.animPhase === 'fractured';
    var mat = MATERIALS[state.matIdx];
    var theta = state.rotAngleDeg * Math.PI / 180;

    function drawProfile(x0, x1, twistEnd) {
      /* Dog-bone outline path */
      mctx.beginPath();
      mctx.moveTo(x0, midY - dGrip / 2);
      mctx.lineTo(x0 + gripIn, midY - dGrip / 2);
      mctx.quadraticCurveTo(x0 + gripIn + filletLen / 2, midY - dGrip / 2,
        x0 + gripIn + filletLen, midY - dOuter / 2);
      mctx.lineTo(x1 - gripIn - filletLen, midY - dOuter / 2);
      mctx.quadraticCurveTo(x1 - gripIn - filletLen / 2, midY - dGrip / 2,
        x1 - gripIn, midY - dGrip / 2);
      mctx.lineTo(x1, midY - dGrip / 2);
      mctx.lineTo(x1, midY + dGrip / 2);
      mctx.lineTo(x1 - gripIn, midY + dGrip / 2);
      mctx.quadraticCurveTo(x1 - gripIn - filletLen / 2, midY + dGrip / 2,
        x1 - gripIn - filletLen, midY + dOuter / 2);
      mctx.lineTo(x0 + gripIn + filletLen, midY + dOuter / 2);
      mctx.quadraticCurveTo(x0 + gripIn + filletLen / 2, midY + dGrip / 2,
        x0 + gripIn, midY + dGrip / 2);
      mctx.lineTo(x0, midY + dGrip / 2);
      mctx.closePath();
      var sg = mctx.createLinearGradient(0, midY - dGrip / 2, 0, midY + dGrip / 2);
      sg.addColorStop(0, '#9aa6c0');
      sg.addColorStop(0.4, '#e0e6f0');
      sg.addColorStop(0.6, '#e0e6f0');
      sg.addColorStop(1, '#7a87a4');
      mctx.fillStyle = sg;
      mctx.fill();
      mctx.strokeStyle = '#3a4575';
      mctx.lineWidth = 1;
      mctx.stroke();
      if (dInner > 0) {
        mctx.fillStyle = 'rgba(13,17,23,0.55)';
        mctx.fillRect(x0 + 4, midY - dInner / 2, x1 - x0 - 8, dInner);
      }
      /* Helix surface lines clipped to gauge section */
      mctx.save();
      var gx0 = x0 + gripIn + filletLen;
      var gx1 = x1 - gripIn - filletLen;
      var gW = gx1 - gx0;
      mctx.beginPath();
      mctx.rect(gx0, midY - dOuter / 2, gW, dOuter);
      mctx.clip();
      var N = 5;
      for (var k = 0; k < N; k++) {
        var phase = (k / N) * Math.PI * 2;
        mctx.strokeStyle = 'rgba(13,17,23,0.55)';
        mctx.lineWidth = 1.2;
        mctx.beginPath();
        for (var s = 0; s <= 40; s++) {
          var u = s / 40;
          var sxp = gx0 + u * gW;
          var localTwist = u * twistEnd;
          var yOff = (dOuter / 2 - 1) * Math.sin(phase + localTwist);
          if (s === 0) mctx.moveTo(sxp, midY + yOff);
          else mctx.lineTo(sxp, midY + yOff);
        }
        mctx.stroke();
      }
      mctx.restore();
    }

    if (fractured) {
      var brittle = mat.type === 'brittle';
      var splitX = leftX + specLen * 0.5;
      drawProfile(leftX, splitX - 2, theta * 0.45);
      drawProfile(splitX + (brittle ? 10 : 4), rightX, theta * 0.55);
      mctx.strokeStyle = '#ff5555';
      mctx.lineWidth = 2.4;
      mctx.beginPath();
      if (brittle) {
        /* A brittle torsion fracture follows the plane of maximum tensile
           stress, which is a 45° helix — and the label right below says "45°".
           The old endpoints spanned 1.2*d horizontally against d+4 vertically,
           which is not 45° and drifted with the specimen diameter: 49° on a thin
           shaft, 42° on a thick one. Equal horizontal and vertical half-spans
           make it exactly 45° at every diameter. */
        var halfF = dOuter / 2 + 2;
        mctx.moveTo(splitX - halfF, midY - halfF);
        mctx.lineTo(splitX + halfF, midY + halfF);
      } else {
        mctx.moveTo(splitX, midY - dOuter / 2 - 3);
        mctx.lineTo(splitX, midY + dOuter / 2 + 3);
      }
      mctx.stroke();
      mctx.fillStyle = '#ff5555';
      mctx.font = '700 10px Segoe UI';
      mctx.textAlign = 'center';
      mctx.fillText(brittle ? 'BRITTLE 45° FRACTURE' : 'DUCTILE TRANSVERSE FRACTURE',
        leftX + specLen / 2, midY - dGrip / 2 - 12);
    } else {
      drawProfile(leftX, rightX, theta);
    }

    /* Dimension lines */
    if (state.showDims) {
      var dimY = midY + dGrip / 2 + 14;
      mctx.strokeStyle = '#6b7a99';
      mctx.lineWidth = 0.8;
      mctx.setLineDash([3, 3]);
      mctx.beginPath();
      mctx.moveTo(leftX + gripIn + filletLen, midY + dOuter / 2);
      mctx.lineTo(leftX + gripIn + filletLen, dimY + 6);
      mctx.moveTo(rightX - gripIn - filletLen, midY + dOuter / 2);
      mctx.lineTo(rightX - gripIn - filletLen, dimY + 6);
      mctx.stroke();
      mctx.setLineDash([]);
      mctx.beginPath();
      mctx.moveTo(leftX + gripIn + filletLen, dimY);
      mctx.lineTo(rightX - gripIn - filletLen, dimY);
      mctx.stroke();
      function arrow(xa, dir) {
        mctx.beginPath();
        mctx.moveTo(xa, dimY);
        mctx.lineTo(xa + dir * 4, dimY - 3);
        mctx.lineTo(xa + dir * 4, dimY + 3);
        mctx.closePath();
        mctx.fillStyle = '#6b7a99';
        mctx.fill();
      }
      arrow(leftX + gripIn + filletLen, 1);
      arrow(rightX - gripIn - filletLen, -1);
      mctx.fillStyle = '#dde3f0';
      mctx.font = '600 10px Courier New';
      mctx.textAlign = 'center';
      mctx.fillText('L₀ = ' + fmt(toD(state.gl, 'length'), state.units === 'si' ? 0 : 1) + ' ' + uLabel('length'),
        leftX + specLen / 2, dimY + 12);
      var dimText = 'd = ' + fmt(toD(state.dia, 'length'), state.units === 'si' ? 1 : 2) + ' ' + uLabel('length');
      if (state.testType === 'hollow') {
        dimText += '   dᵢ = ' + fmt(toD(state.din, 'length'), state.units === 'si' ? 1 : 2);
      }
      mctx.fillText(dimText, leftX + specLen / 2, midY - dOuter / 2 - 6);
    }
  }

  /* Cross-section disc — animates with twist. Called from drawScopePanel. */
  function drawCrossSection(cx, cy, R) {
    var grad = mctx.createRadialGradient(cx, cy, 0, cx, cy, R);
    grad.addColorStop(0,    '#3a4575');
    grad.addColorStop(0.5,  '#7a87a4');
    grad.addColorStop(0.85, '#e8a062');
    grad.addColorStop(1,    '#ff5555');
    mctx.fillStyle = grad;
    mctx.beginPath(); mctx.arc(cx, cy, R, 0, Math.PI * 2); mctx.fill();
    mctx.strokeStyle = '#3a4575'; mctx.lineWidth = 1;
    mctx.stroke();
    if (state.testType === 'hollow') {
      var innerR = R * Math.min(state.din, state.dia - 1) / state.dia;
      mctx.fillStyle = '#0d1117';
      mctx.beginPath(); mctx.arc(cx, cy, innerR, 0, Math.PI * 2); mctx.fill();
      mctx.strokeStyle = '#3a4575';
      mctx.stroke();
    }
    var refAng = -Math.PI / 2;
    mctx.strokeStyle = '#6b7a99'; mctx.lineWidth = 1;
    mctx.setLineDash([3, 3]);
    mctx.beginPath();
    mctx.moveTo(cx, cy);
    mctx.lineTo(cx + Math.cos(refAng) * (R + 6), cy + Math.sin(refAng) * (R + 6));
    mctx.stroke();
    mctx.setLineDash([]);
    var visAng = -Math.PI / 2 + state.rotAngleDeg * Math.PI / 180;
    mctx.strokeStyle = '#ff8c42'; mctx.lineWidth = 2.2;
    mctx.beginPath();
    mctx.moveTo(cx, cy);
    mctx.lineTo(cx + Math.cos(visAng) * R, cy + Math.sin(visAng) * R);
    mctx.stroke();
    mctx.fillStyle = '#ff8c42';
    mctx.beginPath(); mctx.arc(cx + Math.cos(visAng) * R, cy + Math.sin(visAng) * R, 2.5, 0, Math.PI * 2); mctx.fill();
    if (Math.abs(state.rotAngleDeg) > 1) {
      var sweep = Math.min(Math.abs(state.rotAngleDeg * Math.PI / 180), Math.PI * 1.95);
      mctx.strokeStyle = 'rgba(255,140,66,0.55)';
      mctx.lineWidth = 1.2;
      mctx.beginPath();
      mctx.arc(cx, cy, R + 5, -Math.PI / 2, -Math.PI / 2 + sweep);
      mctx.stroke();
    }
    mctx.fillStyle = '#dde3f0';
    mctx.font = '600 7px "Segoe UI"';
    mctx.textAlign = 'left';
    mctx.fillText('τ=0', cx + 4, cy + 3);
    mctx.fillStyle = '#ff5555';
    mctx.fillText('τmax', cx + Math.cos(Math.PI / 4) * (R + 4) + 1,
                          cy + Math.sin(Math.PI / 4) * (R + 4) + 4);
  }

  /* ============================================================
     S8 — GRAPH CANVAS (Torque vs Angle of Twist)
     ============================================================ */
  var GW = 560, GH = 430;
  var GOX = 70, GOY = 30, GGW = GW - GOX - 30, GGH = GH - GOY - 60;
  var graphCanvas, gctx;

  /* Per-point accessors for the two graph views.
     T-θ: x = theta (deg),  y = torque (N·m)
     τ-γ: x = gamma (—),    y = tau    (MPa) */
  function gx(pt) { return state.showTauGamma ? pt.gamma  : pt.theta; }
  function gy(pt) { return state.showTauGamma ? pt.tau    : pt.torque; }

  function getGraphScales() {
    var maxX = 0, maxY = 0;
    var arrays = [state.curveData, state.ghostCurve || []];
    for (var a = 0; a < arrays.length; a++) {
      for (var i = 0; i < arrays[a].length; i++) {
        var px = gx(arrays[a][i]), py = gy(arrays[a][i]);
        if (px > maxX) maxX = px;
        if (py > maxY) maxY = py;
      }
    }
    var mat = MATERIALS[state.matIdx];
    if (state.showTauGamma) {
      maxX = Math.max(maxX * 1.1, (mat.gf || 0.4) * 1.05, 0.01);
      maxY = Math.max(maxY * 1.15, mat.tu * 1.05, 1);
    } else {
      var maxAng = angleFromGamma(mat.gf || 0.4);
      var maxTor = torqueFromTau(mat.tu);
      maxX = Math.max(maxX * 1.1, maxAng * 1.05, 5);
      maxY = Math.max(maxY * 1.15, maxTor * 1.05, 1);
    }
    return { maxX: maxX, maxY: maxY };
  }

  function drawGraph() {
    if (!gctx) return;
    gctx.fillStyle = '#0d1117';
    gctx.fillRect(0, 0, GW, GH);

    var sc = getGraphScales();
    var maxX = sc.maxX, maxY = sc.maxY;
    var isTauGamma = state.showTauGamma;

    /* Grid */
    if (state.showGrid) {
      gctx.strokeStyle = '#1f2535';
      gctx.lineWidth = 0.6;
      for (var gn = 1; gn <= 5; gn++) {
        var yL = GOY + GGH - (gn / 5) * GGH;
        gctx.beginPath(); gctx.moveTo(GOX, yL); gctx.lineTo(GOX + GGW, yL); gctx.stroke();
        var xL = GOX + (gn / 5) * GGW;
        gctx.beginPath(); gctx.moveTo(xL, GOY); gctx.lineTo(xL, GOY + GGH); gctx.stroke();
      }
    }

    /* Axes */
    gctx.strokeStyle = '#3a4575';
    gctx.lineWidth = 1.5;
    gctx.beginPath();
    gctx.moveTo(GOX, GOY);
    gctx.lineTo(GOX, GOY + GGH);
    gctx.lineTo(GOX + GGW, GOY + GGH);
    gctx.stroke();

    /* Tick labels */
    gctx.fillStyle = '#6b7a99';
    gctx.font = '10px Courier New';
    gctx.textAlign = 'right';
    for (var ly = 0; ly <= 5; ly++) {
      var v = (ly / 5) * maxY;
      var yy = GOY + GGH - (ly / 5) * GGH;
      var disp = isTauGamma ? toD(v, 'stress') : toD(v, 'torque');
      gctx.fillText(fmt(disp, disp < 5 ? 1 : 0), GOX - 6, yy + 3);
    }
    gctx.textAlign = 'center';
    for (var lx = 0; lx <= 5; lx++) {
      var va = (lx / 5) * maxX;
      var xx = GOX + (lx / 5) * GGW;
      gctx.fillText(isTauGamma ? va.toFixed(3) : fmt(va, 0), xx, GOY + GGH + 14);
    }

    /* Axis titles */
    gctx.fillStyle = '#dde3f0';
    gctx.font = '600 11px Segoe UI';
    gctx.textAlign = 'center';
    gctx.fillText(isTauGamma ? 'Shear Strain  γ' : 'Angle of Twist  θ (°)',
      GOX + GGW / 2, GH - 14);
    gctx.save();
    gctx.translate(14, GOY + GGH / 2);
    gctx.rotate(-Math.PI / 2);
    gctx.fillText(isTauGamma
      ? 'Shear Stress  τ (' + uLabel('stress') + ')'
      : 'Torque  T (' + uLabel('torque') + ')', 0, 0);
    gctx.restore();

    /* Title — colour-coded per view so the two are easy to tell apart */
    var titleColor = isTauGamma ? '#4ec9b0' : '#ff8c42';
    gctx.fillStyle = titleColor;
    gctx.font = '700 12px Segoe UI';
    gctx.textAlign = 'left';
    gctx.fillText(isTauGamma ? 'Shear Stress vs Shear Strain  (τ – γ)' : 'Torque vs Angle of Twist  (T – θ)',
      GOX, 18);
    /* Subtitle clarifying what each view means */
    gctx.fillStyle = '#6b7a99';
    gctx.font = '500 9px Segoe UI';
    gctx.fillText(isTauGamma
      ? 'material property — independent of specimen size'
      : 'raw test data — what the machine records',
      GOX, 31);
    gctx.fillStyle = '#6b7a99';
    gctx.font = '600 9px Segoe UI';
    gctx.textAlign = 'right';
    gctx.fillText(MATERIALS[state.matIdx].name + ' · ' +
      (state.testType === 'solid' ? 'Solid' : 'Hollow'),
      GOX + GGW, 18);
    /* Geometry scaling reminder (small, lower-right) */
    gctx.fillStyle = '#5a6585';
    gctx.font = '500 8px Segoe UI';
    gctx.fillText(isTauGamma ? 'γ = r θ / L' : 'τ = T r / J',
      GOX + GGW, 31);

    var sx = function (a) { return GOX + (a / maxX) * GGW; };
    var sy = function (t) { return GOY + GGH - (t / maxY) * GGH; };

    /* Ghost (previous test) overlay — drawn first */
    if (state.ghostCurve && state.ghostCurve.length) {
      gctx.strokeStyle = 'rgba(149,167,200,0.55)';
      gctx.setLineDash([5, 4]);
      gctx.lineWidth = 1.6;
      gctx.beginPath();
      for (var gi = 0; gi < state.ghostCurve.length; gi++) {
        var gpx = sx(gx(state.ghostCurve[gi]));
        var gpy = sy(gy(state.ghostCurve[gi]));
        if (gi === 0) gctx.beginPath(), gctx.moveTo(gpx, gpy);
        else gctx.lineTo(gpx, gpy);
      }
      gctx.stroke();
      gctx.setLineDash([]);
      gctx.fillStyle = 'rgba(149,167,200,0.85)';
      gctx.font = '600 9px Segoe UI';
      gctx.textAlign = 'right';
      gctx.fillText('Ghost: ' + (state.ghostLabel || ''), GOX + GGW, 32);
    }

    if (state.curveData.length === 0) {
      gctx.fillStyle = '#6b7a99';
      gctx.font = '600 11px Segoe UI';
      gctx.textAlign = 'center';
      gctx.fillText('Mount specimen and press Start to begin', GOX + GGW / 2, GOY + GGH / 2);
      return;
    }

    /* Fill under curve — colour-coded per view */
    var curveColor = isTauGamma ? '#4ec9b0' : '#ff8c42';
    var fillColor  = isTauGamma ? 'rgba(78,201,176,0.10)' : 'rgba(255,140,66,0.10)';
    gctx.fillStyle = fillColor;
    gctx.beginPath();
    gctx.moveTo(sx(0), sy(0));
    for (var i = 0; i < state.curveData.length; i++) {
      gctx.lineTo(sx(gx(state.curveData[i])), sy(gy(state.curveData[i])));
    }
    var last = state.curveData[state.curveData.length - 1];
    gctx.lineTo(sx(gx(last)), sy(0));
    gctx.closePath();
    gctx.fill();

    /* Curve */
    gctx.strokeStyle = curveColor;
    gctx.lineWidth = 2.2;
    /* τ-γ view: dashed line to further distinguish from T-θ */
    if (isTauGamma) gctx.setLineDash([8, 3]);
    gctx.beginPath();
    for (var p = 0; p < state.curveData.length; p++) {
      var x2 = sx(gx(state.curveData[p]));
      var y2 = sy(gy(state.curveData[p]));
      if (p === 0) gctx.moveTo(x2, y2); else gctx.lineTo(x2, y2);
    }
    gctx.stroke();
    gctx.setLineDash([]);

    /* Markers if we have results */
    var r = state.results;
    if (r) {
      var mat = MATERIALS[state.matIdx];
      if (r.thetaY !== null && r.torqueY !== null && r.ty !== null) {
        var ypt = isTauGamma ? { x: r.ty / (mat.G * 1000), y: r.ty } : { x: r.thetaY, y: r.torqueY };
        markPoint(sx(ypt.x), sy(ypt.y), '#3ddc84', 'Y');
      }
      if (r.thetaU !== null && r.torqueU !== null) {
        var gammaU = r.gammaF * 0.6;
        for (var ui = 0; ui < state.curveData.length; ui++) {
          if (state.curveData[ui].torque === r.torqueU) {
            gammaU = state.curveData[ui].gamma; break;
          }
        }
        var upt = isTauGamma ? { x: gammaU, y: r.tu } : { x: r.thetaU, y: r.torqueU };
        markPoint(sx(upt.x), sy(upt.y), '#f5c842', 'U');
      }
      if (r.thetaF !== null && r.torqueF !== null) {
        var fpt = isTauGamma
          ? { x: r.gammaF, y: state.curveData[state.curveData.length - 1].tau }
          : { x: r.thetaF, y: r.torqueF };
        gctx.strokeStyle = '#ff5555';
        gctx.lineWidth = 2;
        var fx = sx(fpt.x), fy = sy(fpt.y);
        gctx.beginPath();
        gctx.moveTo(fx - 5, fy - 5); gctx.lineTo(fx + 5, fy + 5);
        gctx.moveTo(fx + 5, fy - 5); gctx.lineTo(fx - 5, fy + 5);
        gctx.stroke();
      }
    }
  }

  /* ============================================================
     S8b — LEARNING PANELS (live equations + stress dist + coach)
     ============================================================ */
  var _lpCache = { eq: '', coach: '' };

  function renderLearningPanels() {
    var mat = MATERIALS[state.matIdx];
    var J = polarJ();
    var r = state.dia / 2;
    var last = state.curveData.length ? state.curveData[state.curveData.length - 1] : null;
    var T = last ? last.torque : 0;
    var theta = last ? last.theta : 0;
    var tau = last ? last.tau : 0;
    var gamma = last ? last.gamma : 0;

    /* Equations */
    var dStr = fmt(toD(state.dia, 'length'), state.units === 'si' ? 1 : 2);
    var Lstr = fmt(toD(state.gl, 'length'), state.units === 'si' ? 0 : 1);
    var uL = uLabel('length');
    var rows = [];
    if (state.testType === 'solid') {
      rows.push({ title: 'Polar moment of inertia (solid)',
        latex: '\\[ J = \\frac{\\pi d^{4}}{32} = \\frac{\\pi (' + dStr + '\\text{ ' + uL + '})^{4}}{32} = ' + fmt(J, 0) + ' \\text{ mm}^{4} \\]' });
    } else {
      var diStr = fmt(toD(state.din, 'length'), state.units === 'si' ? 1 : 2);
      rows.push({ title: 'Polar moment of inertia (hollow)',
        latex: '\\[ J = \\frac{\\pi(d_o^{4} - d_i^{4})}{32} = ' + fmt(J, 0) + ' \\text{ mm}^{4} \\]   (d_o = ' + dStr + ', d_i = ' + diStr + ' ' + uL + ')' });
    }
    rows.push({ title: 'Shear stress at outer fibre',
      latex: '\\[ \\tau = \\frac{T\\,r}{J} = \\frac{(' + fmt(T, 2) + '\\times 1000)(' + r + ')}{' + fmt(J, 0) + '} = ' + fmt(tau, 1) + ' \\text{ MPa} \\]' });
    rows.push({ title: 'Shear strain at outer fibre',
      latex: '\\[ \\gamma = \\frac{r\\,\\theta}{L} = \\frac{(' + r + ')(' + fmt(theta * Math.PI / 180, 4) + ')}{' + Lstr + '} = ' + fmt(gamma, 5) + ' \\]' });
    rows.push({ title: 'Modulus of rigidity (material constant)',
      latex: '\\[ G = \\frac{\\tau}{\\gamma} = ' + mat.G + ' \\text{ GPa} \\]' });

    var html = '';
    for (var i = 0; i < rows.length; i++) {
      html += '<div class="eq-row"><div class="eq-title">' + rows[i].title + '</div>' + rows[i].latex + '</div>';
    }
    var eqEl = $('lp-eq-body');
    if (eqEl && html !== _lpCache.eq) {
      eqEl.innerHTML = html;
      _lpCache.eq = html;
    }

    /* Coach */
    var coach = [];
    var failureClass = mat.type === 'brittle' ? 'warn' : 'ok';
    coach.push({ cls: failureClass,
      text: '<strong>Expected failure:</strong> ' + (mat.type === 'brittle'
        ? '45° helical (brittle) — fracture occurs along the plane of maximum tensile stress.'
        : mat.type === 'semi-brittle'
        ? 'Mixed — partial shear deformation followed by an oblique fracture.'
        : 'Transverse (ductile) — failure on the plane of maximum shear stress.') });
    coach.push({ cls: '',
      text: '<strong>τmax / G ratio:</strong> ' + (mat.tu / (mat.G * 1000)).toFixed(4) +
        '  (≈ shear strain at peak torque). Lower ratio → stiffer, less deformable material.' });
    if (state.testType === 'hollow') {
      var solidJ = Math.PI * Math.pow(state.dia, 4) / 32;
      var hollowJ = J;
      var Jratio = (hollowJ / solidJ * 100).toFixed(0);
      coach.push({ cls: 'ok',
        text: '<strong>Hollow vs solid:</strong> J is ' + Jratio + '% of an equivalent solid shaft, but mass drops to ~' +
          ((1 - state.din * state.din / (state.dia * state.dia)) * 100).toFixed(0) + '% — excellent stiffness-to-weight.' });
    }
    if (state.results) {
      coach.push({ cls: 'ok',
        text: '<strong>Modulus of rupture:</strong> ' + fmt(toD(state.results.mor, 'stress'), 0) + ' ' + uLabel('stress') +
          ' — apparent shear stress at fracture using elastic τ = Tr/J. Always ≥ true τu because plastic flow redistributes stress.' });
    }
    var coachHtml = '';
    for (var c = 0; c < coach.length; c++) {
      coachHtml += '<div class="lp-coach-item ' + coach[c].cls + '">' + coach[c].text + '</div>';
    }
    var coachEl = $('lp-coach-body');
    if (coachEl && coachHtml !== _lpCache.coach) {
      coachEl.innerHTML = coachHtml;
      _lpCache.coach = coachHtml;
    }

    drawStressDistribution();
  }

  /* Mini chart: τ(r) — linear ramp from 0 at centre to τmax at outer fibre.
     For hollow shafts, also start from inner radius. */
  function drawStressDistribution() {
    var c = $('lp-stress-canvas'); if (!c) return;
    var x = c.getContext('2d');
    var W = SW, H = SH;   /* logical space — backing store is DPR-scaled */
    x.fillStyle = '#0d1117';
    x.fillRect(0, 0, W, H);

    var pad = { l: 60, r: 30, t: 30, b: 36 };
    var pw = W - pad.l - pad.r, ph = H - pad.t - pad.b;

    var mat = MATERIALS[state.matIdx];
    var last = state.curveData.length ? state.curveData[state.curveData.length - 1] : null;
    var tauOuter = last ? last.tau : 0;
    if (tauOuter < 1) tauOuter = mat.ty || mat.tu * 0.5;
    var rO = state.dia / 2;
    var rI = state.testType === 'hollow' ? Math.min(state.din, state.dia - 1) / 2 : 0;

    /* Axes */
    x.strokeStyle = '#3a4575'; x.lineWidth = 1.2;
    x.beginPath();
    x.moveTo(pad.l, pad.t); x.lineTo(pad.l, pad.t + ph); x.lineTo(pad.l + pw, pad.t + ph);
    x.stroke();

    /* Title */
    x.fillStyle = '#ff8c42';
    x.font = '700 11px Segoe UI';
    x.textAlign = 'left';
    x.fillText('Shear stress τ(r) across the cross-section', pad.l, 18);

    /* Tick labels */
    x.fillStyle = '#6b7a99';
    x.font = '10px Courier New';
    x.textAlign = 'right';
    for (var ly = 0; ly <= 4; ly++) {
      var v = (ly / 4) * tauOuter;
      var yy = pad.t + ph - (ly / 4) * ph;
      x.fillText(fmt(toD(v, 'stress'), 0), pad.l - 6, yy + 3);
    }
    x.textAlign = 'center';
    for (var lx = 0; lx <= 4; lx++) {
      var rVal = -rO + (lx / 4) * 2 * rO;
      x.fillText(rVal.toFixed(1), pad.l + (lx / 4) * pw, pad.t + ph + 14);
    }

    /* Axis labels */
    x.fillStyle = '#dde3f0';
    x.font = '600 10px Segoe UI';
    x.textAlign = 'center';
    x.fillText('Radial position r (mm) — centre at 0', pad.l + pw / 2, H - 8);
    x.save();
    x.translate(14, pad.t + ph / 2);
    x.rotate(-Math.PI / 2);
    x.fillText('τ (' + uLabel('stress') + ')', 0, 0);
    x.restore();

    /* τ(r) line — V-shape from centre */
    function sx(r) { return pad.l + ((r + rO) / (2 * rO)) * pw; }
    function sy(tau) { return pad.t + ph - (tau / tauOuter) * ph; }

    x.strokeStyle = '#ff8c42'; x.lineWidth = 2.4;
    x.beginPath();
    /* Left side: -rO → -rI */
    x.moveTo(sx(-rO), sy(tauOuter));
    x.lineTo(sx(-rI), sy((rI / rO) * tauOuter));
    /* If hollow, jump across the bore */
    if (rI > 0) {
      x.moveTo(sx(rI), sy((rI / rO) * tauOuter));
    } else {
      x.lineTo(sx(0), sy(0));
    }
    x.lineTo(sx(rO), sy(tauOuter));
    x.stroke();

    /* Shade hollow bore */
    if (rI > 0) {
      x.fillStyle = 'rgba(13,17,23,0.6)';
      x.fillRect(sx(-rI), pad.t, sx(rI) - sx(-rI), ph);
      x.strokeStyle = '#3a4575';
      x.setLineDash([3, 3]);
      x.beginPath();
      x.moveTo(sx(-rI), pad.t); x.lineTo(sx(-rI), pad.t + ph);
      x.moveTo(sx(rI), pad.t);  x.lineTo(sx(rI), pad.t + ph);
      x.stroke();
      x.setLineDash([]);
      x.fillStyle = '#6b7a99';
      x.font = '600 9px Segoe UI';
      x.textAlign = 'center';
      x.fillText('hollow bore', pad.l + pw / 2, pad.t + ph / 2);
    }

    /* Annotate τmax */
    x.fillStyle = '#ff5555';
    x.font = '600 10px Courier New';
    x.textAlign = 'left';
    x.fillText('τmax = ' + fmt(toD(tauOuter, 'stress'), 0) + ' ' + uLabel('stress'),
      pad.l + pw - 130, pad.t + 14);
  }

  function markPoint(x, y, color, label) {
    gctx.fillStyle = color;
    gctx.beginPath(); gctx.arc(x, y, 4.5, 0, Math.PI * 2); gctx.fill();
    gctx.fillStyle = color;
    gctx.font = '700 10px Courier New';
    gctx.textAlign = 'left';
    gctx.fillText(label, x + 7, y - 5);
  }

  /* ============================================================
     S9 — BADGES + RESULTS
     ============================================================ */
  function updateBadges() {
    var last = state.curveData.length ? state.curveData[state.curveData.length - 1] :
      { torque: 0, theta: 0, tau: 0, gamma: 0 };
    $('badge-torque').textContent = fmt(toD(last.torque, 'torque'), 2) + ' ' + uLabel('torque');
    $('badge-angle').textContent  = fmt(last.theta, 1) + '°';
    $('badge-stress').textContent = fmt(toD(last.tau, 'stress'), 0) + ' ' + uLabel('stress');
    $('badge-strain').textContent = fmt(last.gamma, 4);
  }

  function showResults() {
    var r = state.results;
    if (!r) { $('results-row').style.display = 'none'; return; }
    $('results-row').style.display = '';
    $('res-G').textContent  = fmt(toD(r.G, 'modulus'), state.units === 'si' ? 1 : 2);
    $('res-ty').textContent = r.ty === null ? '—' : fmt(toD(r.ty, 'stress'), 0);
    $('res-tu').textContent = fmt(toD(r.tu, 'stress'), 0);
    $('res-mor').textContent = fmt(toD(r.mor, 'stress'), 0);
    $('res-ty-torque').textContent = r.torqueY === null ? '—' : fmt(toD(r.torqueY, 'torque'), 2);
    $('res-tmax').textContent = fmt(toD(r.torqueU, 'torque'), 2);
    $('res-thetaf').textContent = fmt(r.thetaF, 1);
    $('res-J').textContent = fmt(toD(polarJ(), 'polar'), state.units === 'si' ? 0 : 4);
    updateResultUnitLabels();
  }

  /* Card captions, in card order. Called on every unit switch as well as
     after a test, so they are never stale. */
  function updateResultUnitLabels() {
    var labels = document.querySelectorAll('.readout-unit');
    if (labels.length < 8) return;
    var caps = [uLabel('modulus'), uLabel('stress'), uLabel('stress'), uLabel('stress'),
                uLabel('torque'), uLabel('torque'), '°', uLabel('polar')];
    for (var i = 0; i < 8; i++) labels[i].textContent = caps[i];
  }

  function computeResults(fullCurve) {
    var mat = MATERIALS[state.matIdx];
    var torqueY = null, thetaY = null;
    var torqueU = 0, thetaU = 0;
    var lastPt = fullCurve[fullCurve.length - 1];

    if (mat.ty !== null) {
      torqueY = torqueFromTau(mat.ty);
      thetaY = angleFromGamma(mat.ty / (mat.G * 1000));
    }
    for (var i = 0; i < fullCurve.length; i++) {
      if (fullCurve[i].torque > torqueU) {
        torqueU = fullCurve[i].torque;
        thetaU = fullCurve[i].theta;
      }
    }

    /* Modulus of rupture = elastic-formula-applied shear stress at max torque */
    var mor = torqueU * (state.dia / 2) * 1000 / polarJ();

    return {
      G: mat.G,
      ty: mat.ty,
      tu: mat.tu,
      mor: mor,
      torqueY: torqueY,
      torqueU: torqueU,
      torqueF: lastPt ? lastPt.torque : 0,
      thetaY: thetaY,
      thetaU: thetaU,
      thetaF: lastPt ? lastPt.theta : 0,
      gammaF: lastPt ? lastPt.gamma : 0,
      failureMode: mat.type === 'brittle' ? 'Brittle (45° helical)' :
                   mat.type === 'semi-brittle' ? 'Semi-brittle (mixed)' :
                   'Ductile (transverse)'
    };
  }

  /* ============================================================
     S10 — TEST LIFECYCLE
     ============================================================ */
  var animTimer = null;
  var fullCurve = [];
  var animIdx = 0;

  function mountSpecimen() {
    if (state.animPhase !== 'idle') return;
    state.animPhase = 'mounted';
    playMount();
    advanceStep(5);
    $('gab-start').disabled = false;
    $('gab-mount').classList.remove('cp-guide-blink');
    $('gab-start').classList.add('cp-guide-blink');
    drawMachine();
  }

  function startTest() {
    if (state.animPhase !== 'mounted') return;
    state.animPhase = 'running';
    advanceStep(6);
    playMotor();
    $('gab-start').disabled = true;
    $('gab-start').classList.remove('cp-guide-blink');
    /* Visual cue: pulsing border on the machine canvas card while testing */
    var mCard = $('machine-canvas') && $('machine-canvas').closest('.canvas-card');
    if (mCard) mCard.classList.add('is-running');

    var mat = MATERIALS[state.matIdx];
    var raw = buildShearCurve(mat);
    fullCurve = curveToTorqueAngle(raw);
    state.curveData = [];
    animIdx = 0;

    /* Slower, more readable animation. At rate=6°/min ≈ 9s; at rate=1 ≈ 30s. */
    var totalMs = Math.max(4500, 30000 / Math.max(state.speed, 1));
    var stepMs = totalMs / fullCurve.length;

    animTimer = setInterval(function () {
      if (animIdx >= fullCurve.length) {
        clearInterval(animTimer);
        animTimer = null;
        finishTest();
        return;
      }
      state.curveData.push(fullCurve[animIdx]);
      state.rotAngleDeg = fullCurve[animIdx].theta;
      animIdx++;
      drawMachine();
      drawGraph();
      updateBadges();
      renderLearningPanels();
    }, stepMs);
  }

  function finishTest() {
    state.animPhase = 'fractured';
    state.results = computeResults(fullCurve);
    playCrack();
    advanceStep(7);
    /* Stop the running-pulse on the canvas card */
    var mCard = $('machine-canvas') && $('machine-canvas').closest('.canvas-card');
    if (mCard) mCard.classList.remove('is-running');
    drawMachine();
    drawGraph();
    updateBadges();
    showResults();
    renderLearningPanels();
  }

  /* Drive a redraw loop while the E-Stop is latched so the halo and
     FAULT LED keep flashing. Stops automatically when the latch is
     released. */
  var eStopAnimRAF = null;
  function eStopAnimate() {
    if (!state.eStopLatched) { eStopAnimRAF = null; return; }
    drawMachine();
    eStopAnimRAF = requestAnimationFrame(eStopAnimate);
  }

  /* Emergency stop — abort whatever is happening, mark the machine
     latched in FAULT state until the user explicitly resets. */
  function triggerEStop() {
    if (state.eStopLatched) return;
    /* Two-tone alarm */
    playTone(880, 0.18, 'square', 0.12);
    setTimeout(function () { playTone(440, 0.22, 'square', 0.12); }, 200);
    setTimeout(function () { playTone(880, 0.18, 'square', 0.12); }, 420);
    /* Stop running animation if any */
    if (animTimer) { clearInterval(animTimer); animTimer = null; }
    var mCard = $('machine-canvas') && $('machine-canvas').closest('.canvas-card');
    if (mCard) mCard.classList.remove('is-running');
    /* Latch into FAULT state */
    state.eStopLatched = true;
    state.animPhase = 'estopped';
    $('gab-mount').disabled = true;
    $('gab-start').disabled = true;
    $('gab-mount').classList.remove('cp-guide-blink');
    $('gab-start').classList.remove('cp-guide-blink');
    drawMachine();
    drawGraph();
    if (!eStopAnimRAF) eStopAnimRAF = requestAnimationFrame(eStopAnimate);
  }

  function resetTest() {
    if (animTimer) { clearInterval(animTimer); animTimer = null; }
    var mCard = $('machine-canvas') && $('machine-canvas').closest('.canvas-card');
    if (mCard) mCard.classList.remove('is-running');
    /* Clear E-Stop latch — Reset is what releases the safety lockout */
    state.eStopLatched = false;
    $('gab-mount').disabled = false;
    /* If we just finished a test, stash the curve as a ghost for the next run */
    if (state.animPhase === 'fractured' && state.curveData.length > 4) {
      state.ghostCurve = state.curveData.slice();
      state.ghostLabel = MATERIALS[state.matIdx].name + ' · ' +
        (state.testType === 'solid' ? 'Solid' : 'Hollow');
      var ghostBtn = $('btn-ghost-clear');
      if (ghostBtn) ghostBtn.style.display = '';
    }
    state.animPhase = 'idle';
    state.rotAngleDeg = 0;
    state.curveData = [];
    state.results = null;
    state.labStep = 0;
    fullCurve = [];
    animIdx = 0;
    $('gab-start').disabled = true;
    $('gab-mount').classList.add('cp-guide-blink');
    $('gab-start').classList.remove('cp-guide-blink');
    $('results-row').style.display = 'none';
    buildLabSteps();
    drawMachine();
    drawGraph();
    updateBadges();
  }

  /* ============================================================
     S11 — LAB STEPS RAIL
     ============================================================ */
  var LAB_STEPS = [
    { label: 'Select Material',   icon: '1' },
    { label: 'Specimen Geometry', icon: '2' },
    { label: 'Solid / Hollow',    icon: '3' },
    { label: 'Twist Rate',        icon: '4' },
    { label: 'Mount Specimen',    icon: '5' },
    { label: 'Apply Torque',      icon: '6' },
    { label: 'View Results',      icon: '7' }
  ];

  function buildLabSteps() {
    var el = $('lab-steps'); if (!el) return;
    el.innerHTML = '';
    for (var i = 0; i < LAB_STEPS.length; i++) {
      var div = document.createElement('div');
      var cls = 'lab-step';
      if (i === state.labStep) cls += ' active';
      if (i < state.labStep) cls += ' done';
      div.className = cls;
      var n = document.createElement('span');
      n.className = 'lab-step-num';
      n.textContent = i < state.labStep ? '✓' : LAB_STEPS[i].icon;
      div.appendChild(n);
      var lbl = document.createElement('span');
      lbl.textContent = LAB_STEPS[i].label;
      div.appendChild(lbl);
      el.appendChild(div);
    }
  }
  function advanceStep(target) {
    if (target > state.labStep) state.labStep = target;
    buildLabSteps();
  }

  /* ============================================================
     S12 — MATERIAL TABS (+ Custom)
     ============================================================ */
  function buildMaterialTabs() {
    var host = $('material-tabs'); if (!host) return;
    host.innerHTML = '';
    for (var i = 0; i < MATERIALS.length; i++) {
      var btn = document.createElement('button');
      btn.className = 'pill' + (i === state.matIdx ? ' active' : '');
      btn.textContent = MATERIALS[i].name;
      btn.dataset.idx = i;
      (function (idx) {
        btn.addEventListener('click', function () {
          if (state.animPhase === 'running') return;
          state.matIdx = idx;
          buildMaterialTabs();
          advanceStep(1);
          playClick();
          resetTest();
        });
      })(i);
      host.appendChild(btn);
    }
    /* Custom button */
    var custom = document.createElement('button');
    custom.className = 'pill';
    custom.style.borderStyle = 'dashed';
    custom.style.border = '1px dashed var(--accent)';
    custom.textContent = '+ Custom';
    custom.addEventListener('click', function () { openCustomMaterialModal(); playClick(); });
    host.appendChild(custom);
  }

  /* ============================================================
     S13 — CUSTOM MATERIAL MODAL
     ============================================================ */
  var CM_FIELDS = [
    { key: 'name', label: 'Name', type: 'text',   min: null, max: null, hint: 'e.g. Inconel 718' },
    { key: 'G',    label: 'G (GPa)',   type: 'number', min: 5,    max: 200,  hint: '5 – 200' },
    { key: 'ty',   label: 'τ_y (MPa)', type: 'number', min: 10,   max: 1500, hint: '10 – 1500 (optional)' },
    { key: 'tu',   label: 'τ_u (MPa)', type: 'number', min: 20,   max: 2000, hint: '20 – 2000' },
    { key: 'gf',   label: 'γ_f',       type: 'number', min: 0.001, max: 1.5, hint: '0.001 – 1.5' }
  ];

  function openCustomMaterialModal() {
    var overlay = document.createElement('div');
    overlay.className = 'cm-overlay';
    var modal = document.createElement('div');
    modal.className = 'cm-modal';
    var html = '<div class="cm-title">Custom Material</div>' +
      '<div class="cm-subtitle">Define shear properties. Ranges in parentheses must be respected.</div>' +
      '<div class="cm-grid">';
    for (var i = 0; i < CM_FIELDS.length; i++) {
      var f = CM_FIELDS[i];
      var fullCls = f.key === 'name' ? ' full' : '';
      var hint = f.type === 'number' ? '<span class="cm-range">' + f.hint + '</span>' : '';
      html += '<div class="cm-field' + fullCls + '">' +
        '<label class="cm-label">' + f.label + ' ' + hint + '</label>' +
        '<input class="cm-input" data-key="' + f.key + '" type="' + f.type + '"' +
        (f.type === 'number' ? ' step="any"' : '') + ' placeholder="' + (f.hint || '') + '">' +
        '</div>';
    }
    html += '</div><div class="cm-error-msg" id="cm-err"></div>' +
      '<div class="cm-actions">' +
        '<button class="btn btn-ghost" id="cm-cancel">Cancel</button>' +
        '<button class="btn btn-primary" id="cm-save">Add</button>' +
      '</div>';
    modal.innerHTML = html;
    overlay.appendChild(modal);
    document.body.appendChild(overlay);

    document.getElementById('cm-cancel').addEventListener('click', function () {
      document.body.removeChild(overlay);
    });
    document.getElementById('cm-save').addEventListener('click', function () {
      var data = {};
      var inputs = modal.querySelectorAll('.cm-input');
      var err = '';
      for (var i = 0; i < inputs.length; i++) {
        var inp = inputs[i];
        var k = inp.dataset.key;
        var f = null;
        for (var j = 0; j < CM_FIELDS.length; j++) if (CM_FIELDS[j].key === k) f = CM_FIELDS[j];
        var raw = inp.value.trim();
        inp.classList.remove('error');
        if (f.type === 'text') {
          if (!raw) { err = 'Name is required'; inp.classList.add('error'); break; }
          data[k] = raw;
        } else {
          if (raw === '' && k === 'ty') { data[k] = null; continue; }
          var v = parseFloat(raw);
          if (!isFinite(v) || v < f.min || v > f.max) {
            err = f.label + ' must be between ' + f.min + ' and ' + f.max;
            inp.classList.add('error'); break;
          }
          data[k] = v;
        }
      }
      if (err) { document.getElementById('cm-err').textContent = err; playError(); return; }
      if (data.ty && data.ty >= data.tu) {
        document.getElementById('cm-err').textContent = 'τ_y must be less than τ_u';
        playError(); return;
      }
      MATERIALS.push({
        name: data.name, G: data.G, ty: data.ty, tu: data.tu, gf: data.gf,
        type: data.ty === null ? 'brittle' : (data.gf < 0.05 ? 'semi-brittle' : 'ductile')
      });
      state.matIdx = MATERIALS.length - 1;
      document.body.removeChild(overlay);
      buildMaterialTabs();
      resetTest();
      playSuccess();
    });
  }

  /* ============================================================
     S14 — STEPPER WIRING
     ============================================================ */
  /* Every stepper registers itself so refreshUnits() can restate the box in
     the active unit system. `kind` names the CONV family; state[prop] is
     always SI, the input always shows display units. */
  var STEPPERS = [];
  function wireStepper(inputId, fillId, prop, onChange, kind) {
    var inp = $(inputId), fill = $(fillId);
    var siMin = parseFloat(inp.min), siMax = parseFloat(inp.max);
    var siStep = parseFloat(inp.step) || 1;
    var initialised = false;
    kind = kind || 'length';

    function refresh() {
      var v = fromD(parseFloat(inp.value), kind);   /* typed value → SI */
      if (!isFinite(v)) v = siMin;
      if (v < siMin) v = siMin;
      if (v > siMax) v = siMax;
      state[prop] = v;
      if (document.activeElement !== inp) inp.value = dispVal(v);
      if (fill) fill.style.width = (((v - siMin) / (siMax - siMin)) * 100) + '%';
      if (initialised) onChange && onChange();
    }
    function dispVal(si) {
      var d = toD(si, kind);
      return state.units === 'imperial' && CONV[kind] && CONV[kind].f !== 1
        ? +d.toFixed(3) : +d.toFixed(2);
    }
    /* Restate the box, its bounds and its step in the displayed unit. */
    function syncUnits() {
      var lo = toD(siMin, kind), hi = toD(siMax, kind);
      inp.min = +lo.toFixed(3);
      inp.max = +hi.toFixed(3);
      inp.step = (state.units === 'imperial' && CONV[kind] && CONV[kind].f !== 1) ? 'any' : siStep;
      inp.value = dispVal(state[prop]);
      if (fill) fill.style.width = (((state[prop] - siMin) / (siMax - siMin)) * 100) + '%';
    }
    STEPPERS.push(syncUnits);

    inp.addEventListener('change', function () { refresh(); inp.value = dispVal(state[prop]); playClick(); });
    inp.addEventListener('input', refresh);
    var row = inp.closest('.stepper-row');
    if (row) {
      var dec = row.querySelector('.stepper-dec');
      var inc = row.querySelector('.stepper-inc');
      /* Step in SI so the increment stays a round engineering value. */
      dec.addEventListener('click', function () {
        state[prop] = Math.max(siMin, state[prop] - siStep); syncUnits(); refresh(); playClick();
      });
      inc.addEventListener('click', function () {
        state[prop] = Math.min(siMax, state[prop] + siStep); syncUnits(); refresh(); playClick();
      });
    }
    refresh();
    initialised = true;
  }
  function syncSteppersToUnits() { STEPPERS.forEach(function (f) { f(); }); }

  /* ============================================================
     S15 — MODE SWITCHING
     ============================================================ */
  function switchMode(m) {
    state.mode = m;
    $('sim-wrapper').style.display      = m === 'simulate' ? '' : 'none';
    $('explore-wrapper').style.display  = m === 'explore'  ? '' : 'none';
    $('practice-wrapper').style.display = m === 'practice' ? '' : 'none';
    $('quiz-wrapper').style.display     = m === 'quiz'     ? '' : 'none';
    /* Hide badges in practice/quiz */
    var bg = $('graph-badges');
    if (bg) bg.style.display = (m === 'practice' || m === 'quiz') ? 'none' : '';
    if (m === 'explore') initExplore();
    if (m === 'practice') newPracticeQ();
    if (m === 'quiz') startQuiz();
  }

