  /* ============================================================
     S21 — INIT / WIRING
     ============================================================ */
  /* ── Hi-DPI canvas fitting ───────────────────────────────────────
     All four canvases carried fixed width/height attributes while the CSS
     stretches them to their cards, so on a 2x display they were presenting
     upscaled bitmaps: machine 1.66x, graph 2.14x and the shear-stress diagram
     4.40x. Size each backing store to real device pixels and scale the context
     so the existing logical coordinate systems still map onto the whole canvas —
     no drawing code changes, and each canvas keeps its authored aspect ratio so
     the CSS layout is untouched. */
  var SW = 540, SH = 200;     /* lp-stress-canvas logical size */
  var XW = 900, XH = 400;     /* explore-canvas   logical size */

  function fitCanvas(cv, logicalW, logicalH) {
    if (!cv) return;
    var dpr = window.devicePixelRatio || 1;
    var displayW = cv.getBoundingClientRect().width;
    if (!(displayW > 40)) displayW = logicalW;   /* never size off a pre-layout measurement */
    var displayH = displayW * (logicalH / logicalW);
    cv.width  = Math.round(displayW * dpr);
    cv.height = Math.round(displayH * dpr);
    var scale = (displayW * dpr) / logicalW;
    cv.getContext('2d').setTransform(scale, 0, 0, scale, 0, 0);
  }

  function fitAllCanvases() {
    fitCanvas($('machine-canvas'), MW, MH);
    fitCanvas($('graph-canvas'),   GW, GH);
    fitCanvas($('lp-stress-canvas'), SW, SH);
    fitCanvas($('explore-canvas'), XW, XH);
  }

  function initCanvases() {
    machineCanvas = $('machine-canvas'); mctx = machineCanvas.getContext('2d');
    graphCanvas = $('graph-canvas');     gctx = graphCanvas.getContext('2d');
  }

