  function buildReportGraph(mat) {
    var W = 1100, H = 620;
    var c = document.createElement('canvas');
    c.width = W; c.height = H;
    var x = c.getContext('2d');
    x.fillStyle = '#ffffff';
    x.fillRect(0, 0, W, H);
    var pad = { l: 80, r: 30, t: 50, b: 60 };
    var pw = W - pad.l - pad.r, ph = H - pad.t - pad.b;
    x.fillStyle = '#8a4b1c';
    x.font = 'bold 20px Segoe UI, sans-serif';
    x.textAlign = 'center';
    x.fillText('Torque – Angle of Twist Curve', W / 2, 24);
    x.fillStyle = '#37474f';
    x.font = '13px Segoe UI, sans-serif';
    x.fillText(mat.name + '  —  ' + (state.testType === 'solid' ? 'Solid round (ASTM E143)' : 'Hollow tube'), W / 2, 44);

    if (!state.curveData.length) return c.toDataURL('image/png');

    var maxT = 0, maxA = 0;
    for (var i = 0; i < state.curveData.length; i++) {
      if (state.curveData[i].torque > maxT) maxT = state.curveData[i].torque;
      if (state.curveData[i].theta > maxA) maxA = state.curveData[i].theta;
    }
    maxT = Math.max(maxT * 1.15, 1);
    maxA = Math.max(maxA * 1.1, 1);

    x.strokeStyle = '#cfd8dc';
    x.lineWidth = 0.6;
    x.font = '11px Courier New';
    x.fillStyle = '#455a64';
    x.textAlign = 'right';
    for (var gy = 0; gy <= 5; gy++) {
      var y0 = pad.t + ph - (gy / 5) * ph;
      x.beginPath(); x.moveTo(pad.l, y0); x.lineTo(pad.l + pw, y0); x.stroke();
      x.fillText(((gy / 5) * maxT).toFixed(1), pad.l - 6, y0 + 4);
    }
    x.textAlign = 'center';
    for (var gx = 0; gx <= 5; gx++) {
      var x0 = pad.l + (gx / 5) * pw;
      x.beginPath(); x.moveTo(x0, pad.t); x.lineTo(x0, pad.t + ph); x.stroke();
      x.fillText(((gx / 5) * maxA).toFixed(1), x0, pad.t + ph + 16);
    }
    x.strokeStyle = '#263238';
    x.lineWidth = 1.5;
    x.beginPath();
    x.moveTo(pad.l, pad.t);
    x.lineTo(pad.l, pad.t + ph);
    x.lineTo(pad.l + pw, pad.t + ph);
    x.stroke();
    x.fillStyle = '#263238';
    x.font = '600 13px Segoe UI';
    x.textAlign = 'center';
    x.fillText('Angle of Twist  θ  (°)', pad.l + pw / 2, H - 18);
    x.save();
    x.translate(22, pad.t + ph / 2);
    x.rotate(-Math.PI / 2);
    x.textAlign = 'center';
    x.fillText('Torque  T  (N·m)', 0, 0);
    x.restore();

    var sx = function (a) { return pad.l + (a / maxA) * pw; };
    var sy = function (t) { return pad.t + ph - (t / maxT) * ph; };

    x.fillStyle = 'rgba(255,140,66,0.13)';
    x.beginPath();
    x.moveTo(sx(0), sy(0));
    for (var ai = 0; ai < state.curveData.length; ai++) {
      x.lineTo(sx(state.curveData[ai].theta), sy(state.curveData[ai].torque));
    }
    var last = state.curveData[state.curveData.length - 1];
    x.lineTo(sx(last.theta), sy(0));
    x.closePath();
    x.fill();

    x.strokeStyle = '#d4691f';
    x.lineWidth = 2.2;
    x.beginPath();
    for (var pi = 0; pi < state.curveData.length; pi++) {
      var px = sx(state.curveData[pi].theta);
      var py = sy(state.curveData[pi].torque);
      if (pi === 0) x.moveTo(px, py); else x.lineTo(px, py);
    }
    x.stroke();

    var r = state.results;
    if (r) {
      if (r.thetaY && r.torqueY) {
        x.fillStyle = '#2e7d32';
        x.beginPath(); x.arc(sx(r.thetaY), sy(r.torqueY), 5, 0, Math.PI * 2); x.fill();
        x.fillStyle = '#1b5e20';
        x.font = '600 11px Courier New';
        x.textAlign = 'left';
        x.fillText('Yield  T_y = ' + r.torqueY.toFixed(1) + ' N·m', sx(r.thetaY) + 8, sy(r.torqueY) - 6);
      }
      if (r.thetaU && r.torqueU) {
        x.fillStyle = '#c62828';
        x.beginPath(); x.arc(sx(r.thetaU), sy(r.torqueU), 5, 0, Math.PI * 2); x.fill();
        x.fillStyle = '#b71c1c';
        x.font = '600 11px Courier New';
        x.textAlign = 'center';
        x.fillText('Max T = ' + r.torqueU.toFixed(1) + ' N·m', sx(r.thetaU), sy(r.torqueU) - 10);
      }
      x.strokeStyle = '#c62828'; x.lineWidth = 2;
      var fx = sx(last.theta), fy = sy(last.torque);
      x.beginPath();
      x.moveTo(fx - 5, fy - 5); x.lineTo(fx + 5, fy + 5);
      x.moveTo(fx + 5, fy - 5); x.lineTo(fx - 5, fy + 5);
      x.stroke();
      x.fillStyle = '#b71c1c';
      x.font = '600 11px Courier New';
      x.textAlign = 'left';
      x.fillText('Fracture', fx + 8, fy + 4);
    }

    x.fillStyle = 'rgba(0,0,0,0.30)';
    x.font = '11px Segoe UI';
    x.textAlign = 'right';
    x.fillText('mechsimulator.com', W - 14, H - 6);
    return c.toDataURL('image/png');
  }

