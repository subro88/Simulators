    mctx.fillStyle = '#1f2740';
    mctx.fillRect(x, y, w, 16);
    mctx.fillStyle = '#dde3f0';
    mctx.font = '700 8px "Segoe UI"';
    mctx.textAlign = 'left';
    mctx.fillText('CROSS-SECTION A–A', x + 6, y + 11);
    /* Live status dot */
    mctx.fillStyle = state.animPhase === 'running' ? '#3ddc84' : '#6b7a99';
    mctx.beginPath(); mctx.arc(x + w - 8, y + 8, 2.5, 0, Math.PI * 2); mctx.fill();
    /* Screen area */
    drawCrossSection(x + w / 2, y + 78, Math.min(w, h) / 2 - 22);
    /* Footer */
    mctx.fillStyle = '#0d1117';
    mctx.fillRect(x, y + h - 16, w, 16);
