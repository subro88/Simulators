  function calcStep(num, title, formula, calculation, result) {
    var html = '<div class="cs-step"><div class="cs-step-hd">';
    html += '<span class="cs-num">Step ' + num + '</span>';
    html += '<span class="cs-title">' + title + '</span></div>';
    if (formula)     html += '<div class="cs-formula">' + formula + '</div>';
    if (calculation) html += '<div class="cs-calc">' + calculation.replace(/\n/g, '<br>') + '</div>';
    if (result != null) html += '<div class="cs-result">→ <strong>' + result + '</strong></div>';
    html += '</div>';
    return html;
  }

  function openCalcModal() {
    var r = state.results;
    if (!r) { playError(); alert('Run a complete test first — calculations are derived from the test data.'); return; }
    var mat = MATERIALS[state.matIdx];
    var d = state.dia, di = state.din, L = state.gl;
    var rOut = d / 2;
    var J = polarJ();
    var Jstr = fmt(J, 0);
    var html = '';

    /* Given block */
    html += '<div class="cs-inputs">';
    html += '<span class="cs-badge">Given</span>';
    html += '<div class="cs-given">';
    html += '<span>Material: <strong>' + mat.name + '</strong></span>';
    html += '<span>Geometry: <strong>' + (state.testType === 'solid' ? 'solid' : 'hollow') + '</strong></span>';
    html += '<span>d = ' + d + ' mm</span>';
    if (state.testType === 'hollow') html += '<span>d_i = ' + di + ' mm</span>';
    html += '<span>L = ' + L + ' mm</span>';
    html += '<span>Twist rate = ' + state.speed + ' °/min</span>';
    html += '</div></div>';

    /* Step 1 — J */
    if (state.testType === 'solid') {
      html += calcStep(1, 'Polar moment of inertia (solid)',
        '\\[ J = \\frac{\\pi d^{4}}{32} \\]',
        'J = π × ' + d + '^4 / 32\n  = π × ' + Math.pow(d, 4).toFixed(0) + ' / 32',
        Jstr + ' mm⁴');
    } else {
      html += calcStep(1, 'Polar moment of inertia (hollow)',
        '\\[ J = \\frac{\\pi(d_o^{4} - d_i^{4})}{32} \\]',
        'J = π × (' + d + '^4 − ' + di + '^4) / 32\n  = π × (' + Math.pow(d,4).toFixed(0) + ' − ' + Math.pow(di,4).toFixed(0) + ') / 32',
        Jstr + ' mm⁴');
    }

    /* Step 2 — Modulus of rigidity (from elastic slope) */
    html += calcStep(2, "Modulus of rigidity (G)",
      '\\[ G = \\frac{T \\, L}{J \\, \\theta} \\]',
      'From the elastic region of the T-θ curve, slope dT/dθ implies G = ' + r.G + ' GPa\n  (textbook value for ' + mat.name + ')',
      r.G + ' GPa');

    /* Step 3 — Yield shear stress (if ductile) */
    if (r.ty !== null && r.torqueY !== null) {
      html += calcStep(3, 'Shear yield strength τ_y',
        '\\[ \\tau_y = \\frac{T_y \\, r}{J} \\]',
        'τ_y = (' + fmt(r.torqueY, 2) + ' × 1000) × ' + rOut + ' / ' + Jstr +
        '\n  = ' + fmt(r.torqueY * 1000 * rOut / J, 1),
        fmt(toD(r.ty, 'stress'), 0) + ' ' + uLabel('stress'));
    } else {
      html += calcStep(3, 'Shear yield strength τ_y',
        '\\[ \\tau_y = \\frac{T_y \\, r}{J} \\]',
        'Material is brittle — no distinct yield point on the T-θ curve.', '—');
    }

    /* Step 4 — Ultimate shear stress */
    html += calcStep(4, 'Ultimate shear stress τ_u',
      '\\[ \\tau_u = \\frac{T_{\\max} \\, r}{J} \\]',
      'τ_u = (' + fmt(r.torqueU, 2) + ' × 1000) × ' + rOut + ' / ' + Jstr +
      '\n  = ' + fmt(r.torqueU * 1000 * rOut / J, 1),
      fmt(toD(r.tu, 'stress'), 0) + ' ' + uLabel('stress'));

    /* Step 5 — Modulus of rupture */
    html += calcStep(5, 'Modulus of rupture',
      '\\[ \\text{MoR} = \\frac{T_{\\max} \\, r}{J} \\quad \\text{(elastic-formula applied at failure)} \\]',
      'MoR = ' + fmt(r.torqueU * 1000 * rOut / J, 1) + ' MPa\n  (Apparent shear at peak — exceeds true τ_u because plastic flow redistributes stress.)',
      fmt(toD(r.mor, 'stress'), 0) + ' ' + uLabel('stress'));

    /* Step 6 — Angle at fracture */
    var gFracRad = r.gammaF * L / rOut;
    html += calcStep(6, 'Angle of twist at fracture',
      '\\[ \\theta_f = \\frac{\\gamma_f \\, L}{r} \\]',
      'θ_f = (' + fmt(r.gammaF, 4) + ' × ' + L + ') / ' + rOut +
      '\n  = ' + fmt(gFracRad, 4) + ' rad\n  = ' + fmt(gFracRad * 180 / Math.PI, 1) + '°',
      fmt(r.thetaF, 1) + '°');

    /* Step 7 — Failure mode */
    html += calcStep(7, 'Failure mode interpretation',
      '\\[ \\sigma_{1,\\text{ tensile}} = \\tau_{\\max} \\text{ on a } 45° \\text{ helix} \\]',
      mat.type === 'brittle'
        ? 'τ_max also generates a tensile σ_1 of equal magnitude on the 45° plane. ' +
          'For brittle materials, tensile strength < shear strength, so failure occurs on the 45° helix.'
        : mat.type === 'semi-brittle'
        ? 'Material yields partially before the tensile σ_1 on the 45° plane drives a clean cleavage. Mixed fracture surface.'
        : 'Material yields well before σ_1 reaches its tensile limit. Failure occurs on the plane of maximum shear (transverse).',
      r.failureMode);

    $('calc-modal-body').innerHTML = html;
    $('calc-modal').classList.add('active');
    /* KaTeX auto-render observer will pick this up */
  }

