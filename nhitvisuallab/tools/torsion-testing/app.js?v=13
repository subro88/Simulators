/* Torsion Testing Machine Virtual Lab — UTM-pattern build */
(function () {
  'use strict';

  /* ============================================================
     S1 — DOM HELPERS
     ============================================================ */
  function $(id) { return document.getElementById(id); }

  /* ============================================================
     S2 — MATERIALS (shear properties)
     G  : modulus of rigidity (GPa)
     ty : shear yield strength (MPa)   — '—' for brittle
     tu : ultimate shear strength (MPa)
     gf : shear strain at fracture (—)
     type: 'ductile' | 'brittle' | 'semi-brittle'
     ============================================================ */
  var MATERIALS = [
    { name: 'Mild Steel',        G: 80, ty: 145, tu: 330, gf: 0.40, type: 'ductile' },
    { name: 'Aluminium 6061-T6', G: 26, ty: 160, tu: 205, gf: 0.12, type: 'ductile' },
    { name: 'Cast Iron (grey)',  G: 40, ty: null, tu: 170, gf: 0.006, type: 'brittle' },
    { name: 'Copper (annealed)', G: 44, ty: 40,  tu: 200, gf: 0.50, type: 'ductile' },
    { name: 'Brass C26000',      G: 39, ty: 75,  tu: 235, gf: 0.55, type: 'ductile' },
    { name: 'High-C Steel 1080', G: 80, ty: 400, tu: 750, gf: 0.15, type: 'semi-brittle' },
    { name: 'Stainless 304',     G: 77, ty: 125, tu: 515, gf: 0.50, type: 'ductile' },
    { name: 'Ti-6Al-4V',         G: 44, ty: 550, tu: 760, gf: 0.10, type: 'ductile' },
    { name: 'Nickel (ann.)',     G: 76, ty: 65,  tu: 290, gf: 0.45, type: 'ductile' },
    { name: 'Magnesium AZ31B',   G: 17, ty: 90,  tu: 150, gf: 0.12, type: 'ductile' },
    { name: 'Phosphor Bronze',   G: 41, ty: 200, tu: 380, gf: 0.30, type: 'ductile' },
    { name: 'Inconel 718',       G: 77, ty: 620, tu: 830, gf: 0.20, type: 'ductile' },
    { name: 'Tool Steel D2',     G: 78, ty: null, tu: 1100, gf: 0.02, type: 'brittle' }
  ];

  /* ============================================================
     S3 — STATE
     ============================================================ */
  var state = {
    mode: 'simulate',
    units: 'si',          /* 'si' | 'imperial' */
    matIdx: 0,
    testType: 'solid',    /* 'solid' | 'hollow' */
    dia: 12,              /* mm — outer diameter */
    din: 6,               /* mm — inner diameter (hollow) */
    gl: 100,              /* mm — gauge length */
    speed: 6,             /* deg/min — twist rate */
    animPhase: 'idle',    /* 'idle' | 'mounted' | 'running' | 'fractured' */
    rotAngleDeg: 0,       /* current angle of twist (deg) */
    curveData: [],        /* [{theta, torque, tau, gamma}] */
    results: null,
    labStep: 0,
    showGrid: true,
    showDims: true,
    eStopLatched: false,
    showTauGamma: false,
    ghostCurve: null,
    ghostLabel: '',
    audioCtx: null,
    soundOn: true,
    pScore: 0, pTotal: 0, pCurrent: null,
    quiz: { idx: 0, score: 0, items: [], current: null }
  };

  /* ============================================================
     S4 — UNIT CONVERSIONS
     SI base: length=mm, torque=N·m, stress=MPa, angle=deg
     Imperial: length=in, torque=lbf·ft, stress=psi, angle=deg
     ============================================================ */
  var CONV = {
    length:  { f: 1 / 25.4,     l: 'in' },
    torque:  { f: 0.737562,     l: 'lbf·ft' },
    stress:  { f: 145.038,      l: 'psi' },
    speed:   { f: 1,            l: '°/min' },  /* angle units same */
    modulus: { f: 0.145038,     l: 'Msi' },    /* GPa   → Msi (10⁶ psi) */
    polar:   { f: 2.402510e-6,  l: 'in⁴' }     /* mm⁴   → in⁴ */
  };
  function toD(v, kind) {
    if (v === null || v === undefined || v === '—') return v;
    if (state.units === 'imperial' && CONV[kind]) return v * CONV[kind].f;
    return v;
  }
  /* Inverse of toD — turns a value typed in the displayed unit back into SI. */
  function fromD(v, kind) {
    if (v === null || v === undefined || v === '—') return v;
    if (state.units === 'imperial' && CONV[kind]) return v / CONV[kind].f;
    return v;
  }
  function uLabel(kind) {
    if (state.units === 'si') {
      if (kind === 'length') return 'mm';
      if (kind === 'torque') return 'N·m';
      if (kind === 'stress') return 'MPa';
      if (kind === 'speed')  return '°/min';
      if (kind === 'modulus') return 'GPa';
      if (kind === 'polar')  return 'mm⁴';
    } else {
      if (CONV[kind]) return CONV[kind].l;
      if (kind === 'length') return 'in';
    }
    return '';
  }
  function fmt(v, n) {
    if (v === null || v === undefined || v === '—') return '—';
    if (typeof v !== 'number' || !isFinite(v)) return '—';
    return v.toFixed(n === undefined ? 2 : n);
  }

  /* ============================================================
     S5 — PHYSICS HELPERS
     ============================================================ */
  function polarJ() {
    var d = state.dia;
    if (state.testType === 'hollow') {
      var di = Math.min(state.din, d - 1);
      return (Math.PI / 32) * (Math.pow(d, 4) - Math.pow(di, 4));   /* mm^4 */
    }
    return (Math.PI / 32) * Math.pow(d, 4);
  }
  /* T (N·m) ↔ τ (MPa) using r in mm, J in mm^4
     τ [MPa] = T[N·mm] · r[mm] / J[mm^4] = (T[N·m] * 1000) * r / J */
  function tauFromTorque(T_Nm) {
    var r = state.dia / 2;
    return (T_Nm * 1000) * r / polarJ();
  }
  function torqueFromTau(tau_MPa) {
    var r = state.dia / 2;
    return tau_MPa * polarJ() / (r * 1000);
  }
  /* γ = r·θ / L (with θ in rad) */
  function gammaFromAngle(thetaDeg) {
    var r = state.dia / 2;
    var L = state.gl;
    return (r * (thetaDeg * Math.PI / 180)) / L;
  }
  function angleFromGamma(gamma) {
    var r = state.dia / 2;
    var L = state.gl;
    return (gamma * L / r) * 180 / Math.PI;
  }

  /* Build the canonical τ(γ) curve for the material — used both for live
     animation and for analytical max-angle estimation. */
  function buildShearCurve(mat) {
    /* Three regions: elastic up to τy at γy=τy/G, plastic to τu at γu=0.6·γf,
       then softening to fracture (τ drops 15% for ductile, falls fast for brittle). */
    var pts = [];
    var G_MPa = mat.G * 1000;  /* GPa → MPa */
    var ty = mat.ty || (mat.tu * 0.6);
    var tu = mat.tu;
    var gy = ty / G_MPa;
    var gf = mat.gf;
    var gu = Math.max(gy * 1.05, gf * 0.6);

    if (mat.type === 'brittle') {
      /* Nearly linear to fracture, slight curvature near peak — high resolution */
      var N1 = 200;
      for (var i = 0; i <= N1; i++) {
        var g = (i / N1) * gf;
        var tStress = G_MPa * g;
        if (tStress > tu) tStress = tu * (1 - 0.02 * (g / gf - 0.95));
        pts.push({ gamma: g, tau: Math.max(tStress, 0) });
      }
      return pts;
    }

    /* Ductile / semi-brittle — 240 total points (60 elastic + 120 hardening + 60 softening) */
    var N = 60;
    for (var a = 0; a <= N; a++) {
      var ga = (a / N) * gy;
      pts.push({ gamma: ga, tau: G_MPa * ga });
    }
    var M = 120;
    for (var b = 1; b <= M; b++) {
      var t = b / M;
      var gp = gy + t * (gu - gy);
      /* Smooth concave-down rise from τy to τu */
      var tp = ty + (tu - ty) * Math.sin(t * Math.PI / 2);
      pts.push({ gamma: gp, tau: tp });
    }
    var K = 60;
    var softFrac = mat.type === 'semi-brittle' ? 0.78 : 0.88;
    for (var c = 1; c <= K; c++) {
      var u = c / K;
      var gpr = gu + u * (gf - gu);
      var tpr = tu - (tu * (1 - softFrac)) * u;
      pts.push({ gamma: gpr, tau: Math.max(tpr, 0) });
    }
    return pts;
  }

  /* Convert a τ-γ curve to a T-θ curve under current geometry. */
  function curveToTorqueAngle(tauGamma) {
    var out = [];
    for (var i = 0; i < tauGamma.length; i++) {
      out.push({
        gamma: tauGamma[i].gamma,
        tau:   tauGamma[i].tau,
        theta: angleFromGamma(tauGamma[i].gamma),
        torque: torqueFromTau(tauGamma[i].tau)
      });
    }
    return out;
  }

  /* ============================================================
     S6 — SOUND (Web Audio)
     ============================================================ */
  function audioCtx() {
    if (!state.audioCtx) {
      try { state.audioCtx = new (window.AudioContext || window.webkitAudioContext)(); }
      catch (e) { state.soundOn = false; }
    }
    return state.audioCtx;
  }
  function playTone(freq, dur, type, vol) {
    if (!state.soundOn) return;
    var ctx = audioCtx(); if (!ctx) return;
    var o = ctx.createOscillator(), g = ctx.createGain();
    o.type = type || 'sine'; o.frequency.value = freq;
    g.gain.setValueAtTime(vol || 0.06, ctx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + dur);
    o.connect(g); g.connect(ctx.destination);
    o.start(); o.stop(ctx.currentTime + dur);
  }
  function playClick()   { playTone(720, 0.05, 'square', 0.04); }
  function playSuccess() { playTone(880, 0.12, 'sine', 0.09); setTimeout(function(){ playTone(1320, 0.15, 'sine', 0.08); }, 110); }
  function playError()   { playTone(220, 0.18, 'sawtooth', 0.07); }
  function playMount()   { playTone(380, 0.13, 'sine', 0.06); setTimeout(function(){ playTone(560, 0.1, 'sine', 0.06); }, 130); }
  function playMotor()   { playTone(180, 0.25, 'triangle', 0.045); }
  function playCrack()   { playTone(140, 0.35, 'sawtooth', 0.12); setTimeout(function(){ playTone(90, 0.25, 'sawtooth', 0.08); }, 60); }

  /* ============================================================
     S7 — MACHINE CANVAS
     ============================================================ */
  var MW = 720, MH = 540;
  var machineCanvas, mctx;

  /* Machine geometry — kept here so every helper agrees on the layout */
  var BED_TOP = 400, BED_BOT = 455;
  var COL_TOP = 195;
  var AXIS_Y = 265;                       /* specimen + chuck centreline */
  var L_COL_X = 120, R_COL_X = MW - 120;  /* column centre lines */
  var L_CHUCK_X = 200, R_CHUCK_X = MW - 200;
  var CHUCK_R = 38;

  function drawMachine() {
    if (!mctx) return;
    /* Background — workshop wall + floor gradient */
    var bg = mctx.createLinearGradient(0, 0, 0, MH);
    bg.addColorStop(0, '#0f1320');
    bg.addColorStop(0.55, '#0d1117');
    bg.addColorStop(1, '#070a12');
    mctx.fillStyle = bg;
    mctx.fillRect(0, 0, MW, MH);

    /* Subtle workshop floor grid */
    mctx.strokeStyle = 'rgba(40,52,82,0.35)';
    mctx.lineWidth = 1;
    for (var gx = 0; gx < MW; gx += 60) {
      mctx.beginPath(); mctx.moveTo(gx, BED_BOT); mctx.lineTo(gx + 30, MH); mctx.stroke();
    }

    /* Far shadow line below bed (depth cue) */
    var shGrad = mctx.createLinearGradient(0, BED_BOT, 0, BED_BOT + 24);
    shGrad.addColorStop(0, 'rgba(0,0,0,0.55)');
    shGrad.addColorStop(1, 'rgba(0,0,0,0)');
    mctx.fillStyle = shGrad;
    mctx.fillRect(40, BED_BOT, MW - 80, 24);

    /* Machine body */
    drawBed();
    drawColumn(L_COL_X, 'left');
    drawColumn(R_COL_X, 'right');
    drawTorqueCell();
    drawMotorAndGearbox();
    drawTwistIndicator();          /* attached to drive end */
    /* Spindle shafts connecting column to chuck on each side */
    drawSpindle(L_COL_X + 32, L_CHUCK_X - 19, AXIS_Y, 'reaction');
    drawSpindle(R_CHUCK_X + 19, R_COL_X - 32, AXIS_Y, 'drive');
    drawSpecimen();
    drawScrollChuck(L_CHUCK_X, AXIS_Y, 'reaction');
    drawScrollChuck(R_CHUCK_X, AXIS_Y, 'drive');

    /* Cross-section "scope" panel — centred above the specimen */
    drawScopePanel(MW / 2 - 80, 38, 160, 142);

    /* Bottom control console */
    drawControlConsole();

    /* Brand strip at very top-left, status text top-right */
    mctx.fillStyle = 'rgba(255,140,66,0.95)';
    mctx.font = '800 14px "Segoe UI", sans-serif';
    mctx.textAlign = 'left';
    mctx.fillText('MechSim TT-100', 16, 18);
    mctx.fillStyle = '#6b7a99';
    mctx.font = '600 9px "Segoe UI"';
    mctx.fillText('Universal Torsion Testing Machine · 100 N·m', 16, 30);
    /* Status label top-right */
    mctx.textAlign = 'right';
    var modeText, modeColor;
    if (state.eStopLatched) {
      modeText = 'E-STOPPED';
      modeColor = (Math.floor(Date.now() / 400) % 2 === 0) ? '#ff5555' : '#6b1212';
    } else if (state.animPhase === 'idle')    { modeText = 'STANDBY';  modeColor = '#6b7a99'; }
    else if (state.animPhase === 'mounted')   { modeText = 'READY';    modeColor = '#42a5f5'; }
    else if (state.animPhase === 'running')   { modeText = 'TESTING';  modeColor = '#ff8c42'; }
    else                                       { modeText = 'COMPLETE'; modeColor = '#3ddc84'; }
    mctx.fillStyle = '#6b7a99';
    mctx.font = '600 9px "Segoe UI"';
    mctx.fillText('MODE', MW - 16, 14);
    mctx.fillStyle = modeColor;
    mctx.font = '800 14px "Segoe UI"';
    mctx.fillText(modeText, MW - 16, 30);

    /* E-stop banner across the centre — only when latched */
    if (state.eStopLatched) {
      var bw = 340, bh = 36, bx = MW / 2 - bw / 2, by = 200;
      mctx.fillStyle = 'rgba(110,18,18,0.92)';
      mctx.fillRect(bx, by, bw, bh);
      mctx.strokeStyle = '#ff5555'; mctx.lineWidth = 2;
      mctx.strokeRect(bx + 0.5, by + 0.5, bw - 1, bh - 1);
      mctx.fillStyle = '#fff';
      mctx.font = '800 16px "Segoe UI"';
      mctx.textAlign = 'center';
      mctx.fillText('⚠  EMERGENCY STOP ACTIVATED', bx + bw / 2, by + 17);
      mctx.fillStyle = '#ffcccc';
      mctx.font = '600 9px "Segoe UI"';
      mctx.fillText('Press RESET to release the safety lockout', bx + bw / 2, by + 30);
    }
  }

  /* ── Cast-iron bed with T-slot and mounting bolts ── */
  function drawBed() {
    var x0 = 30, x1 = MW - 30, y0 = BED_TOP, y1 = BED_BOT;
    /* Main body */
    var g = mctx.createLinearGradient(0, y0, 0, y1);
    g.addColorStop(0, '#39435e');
    g.addColorStop(0.45, '#2a3349');
    g.addColorStop(1, '#181d2c');
    mctx.fillStyle = g;
    mctx.fillRect(x0, y0, x1 - x0, y1 - y0);
    /* Highlight ledge */
    mctx.fillStyle = 'rgba(255,255,255,0.06)';
    mctx.fillRect(x0, y0, x1 - x0, 2);
    /* T-slot (recessed strip) */
    mctx.fillStyle = '#0d1117';
    mctx.fillRect(x0 + 24, y0 + 8, x1 - x0 - 48, 6);
    mctx.fillStyle = 'rgba(0,0,0,0.6)';
    mctx.fillRect(x0 + 24, y0 + 8, x1 - x0 - 48, 1);
    /* Hatched chamfer at front edge */
    mctx.strokeStyle = 'rgba(0,0,0,0.45)';
    mctx.lineWidth = 1;
    for (var hx = x0 + 6; hx < x1 - 6; hx += 6) {
      mctx.beginPath(); mctx.moveTo(hx, y1 - 4); mctx.lineTo(hx + 4, y1); mctx.stroke();
    }
    /* Mounting bolt heads at corners */
    [[x0 + 14, y0 + 22], [x1 - 14, y0 + 22], [x0 + 14, y1 - 12], [x1 - 14, y1 - 12]].forEach(function (p) {
      mctx.fillStyle = '#1a2030';
      mctx.beginPath(); mctx.arc(p[0], p[1], 4, 0, Math.PI * 2); mctx.fill();
      mctx.strokeStyle = '#4a5575'; mctx.lineWidth = 1.2;
      mctx.stroke();
      /* hex pattern */
      mctx.strokeStyle = '#0d1117';
      mctx.beginPath();
      for (var hi = 0; hi < 6; hi++) {
        var ang = hi * Math.PI / 3;
        var px = p[0] + Math.cos(ang) * 2.5;
        var py = p[1] + Math.sin(ang) * 2.5;
        if (hi === 0) mctx.moveTo(px, py); else mctx.lineTo(px, py);
      }
      mctx.closePath();
      mctx.stroke();
    });
    /* Feet (front pads) */
    mctx.fillStyle = '#1f2535';
    mctx.fillRect(x0 - 6, y1 - 8, 28, 10);
    mctx.fillRect(x1 - 22, y1 - 8, 28, 10);
  }

  /* ── Heavy cast-iron column ── */
  function drawColumn(cx, side) {
    var w = 64, h = BED_TOP - COL_TOP;
    var x = cx - w / 2;
    var g = mctx.createLinearGradient(x, 0, x + w, 0);
    g.addColorStop(0, '#1a1f2e');
    g.addColorStop(0.4, '#2c3550');
    g.addColorStop(0.6, '#2c3550');
    g.addColorStop(1, '#161a26');
    mctx.fillStyle = g;
    mctx.fillRect(x, COL_TOP, w, h);
    mctx.strokeStyle = '#3a4575'; mctx.lineWidth = 1.2;
    mctx.strokeRect(x + 0.5, COL_TOP + 0.5, w - 1, h - 1);
    /* Vertical highlight */
    mctx.fillStyle = 'rgba(255,255,255,0.04)';
    mctx.fillRect(x + 6, COL_TOP, 3, h);
    /* Bolt rosette top and bottom */
    [COL_TOP + 14, BED_TOP - 14].forEach(function (by) {
      [-1, 1].forEach(function (s) {
        mctx.fillStyle = '#0d1117';
        mctx.beginPath(); mctx.arc(cx + s * 18, by, 3.5, 0, Math.PI * 2); mctx.fill();
        mctx.strokeStyle = '#5066a0'; mctx.lineWidth = 0.8; mctx.stroke();
      });
    });
    /* Side label */
    mctx.save();
    mctx.translate(cx + (side === 'left' ? -w / 2 - 6 : w / 2 + 6), AXIS_Y + 50);
    mctx.rotate(-Math.PI / 2);
    mctx.fillStyle = '#5a6685';
    mctx.font = '700 8px "Segoe UI"';
    mctx.textAlign = 'center';
    mctx.fillText(side === 'left' ? 'REACTION SIDE' : 'DRIVE SIDE', 0, 0);
    mctx.restore();
  }

  /* ── 3-jaw scroll chuck on the inboard face of a column ── */
  /* Spindle / bearing housing connecting the column to the chuck.
     x0,x1 mark the horizontal extent. A central drive shaft passes
     through a bearing housing, with two pillow-block style mounts
     bolted to the column at one end and a coupling flange at the
     other (toward the chuck). */
  function drawSpindle(x0, x1, cy, side) {
    if (x1 < x0) { var tmp = x0; x0 = x1; x1 = tmp; }
    var w = x1 - x0;
    /* Bearing housing — a thick rectangular block straddling the axis */
    var housH = 30;     /* housing total height */
    var housY = cy - housH / 2;
    var hg = mctx.createLinearGradient(0, housY, 0, housY + housH);
    hg.addColorStop(0,   '#1c2236');
    hg.addColorStop(0.5, '#4a5575');
    hg.addColorStop(1,   '#13182a');
    mctx.fillStyle = hg;
    mctx.fillRect(x0, housY, w, housH);
    mctx.strokeStyle = '#0d1117'; mctx.lineWidth = 1;
    mctx.strokeRect(x0 + 0.5, housY + 0.5, w - 1, housH - 1);
    /* Top + bottom rib (cast-iron parting line) */
    mctx.fillStyle = 'rgba(0,0,0,0.45)';
    mctx.fillRect(x0, cy - 1, w, 2);
    /* Mounting bolts on the column-side end (4 visible: 2 top, 2 bottom) */
    var colEnd = side === 'reaction' ? x0 : x1;
    var bolts = [[colEnd + (side === 'reaction' ?  4 :  -4), housY + 5],
                 [colEnd + (side === 'reaction' ?  4 :  -4), housY + housH - 5]];
    bolts.forEach(function (p) {
      mctx.fillStyle = '#0d1117';
      mctx.beginPath(); mctx.arc(p[0], p[1], 2.4, 0, Math.PI * 2); mctx.fill();
      mctx.strokeStyle = '#5066a0'; mctx.lineWidth = 0.8;
      mctx.stroke();
    });
    /* Drive shaft running through the housing — bright steel core */
    var shaftH = 10;
    var shg = mctx.createLinearGradient(0, cy - shaftH / 2, 0, cy + shaftH / 2);
    shg.addColorStop(0, '#7a87a4');
    shg.addColorStop(0.5, '#e0e6f0');
    shg.addColorStop(1, '#5a6585');
    mctx.fillStyle = shg;
    /* Shaft slightly overhangs the housing toward the chuck end */
    var shaftX0 = x0 - (side === 'drive' ? 4 : 0);
    var shaftX1 = x1 + (side === 'reaction' ? 4 : 0);
    mctx.fillRect(shaftX0, cy - shaftH / 2, shaftX1 - shaftX0, shaftH);
    mctx.strokeStyle = '#3a4575'; mctx.lineWidth = 0.8;
    mctx.strokeRect(shaftX0 + 0.5, cy - shaftH / 2 + 0.5, shaftX1 - shaftX0 - 1, shaftH - 1);
    /* Coupling flange where the shaft meets the chuck back flange */
    var coupX = side === 'reaction' ? x1 - 4 : x0;
    mctx.fillStyle = '#3a4575';
    mctx.fillRect(coupX, cy - housH / 2 + 4, 5, housH - 8);
    mctx.strokeStyle = '#0d1117';
    mctx.strokeRect(coupX + 0.5, cy - housH / 2 + 4.5, 4, housH - 9);
    /* Small grease nipple on top of the housing */
    mctx.fillStyle = '#5a6585';
    mctx.fillRect(x0 + w / 2 - 2, housY - 4, 4, 4);
    mctx.fillStyle = '#0d1117';
    mctx.fillRect(x0 + w / 2 - 1, housY - 6, 2, 3);
  }

  /* Side-profile of a self-centring chuck. The chuck body is a stubby
     cylinder; we see its silhouette from the side. `dir` is +1 if the
     chuck is on the left (specimen exits to the right) or -1 on the
     right (specimen exits to the left). */
  function drawScrollChuck(cx, cy, side) {
    var dir = side === 'reaction' ? 1 : -1;
    /* Body dimensions — wider in Y (chuck diameter) than X (axial length) */
    var halfH = CHUCK_R;          /* vertical half-height (chuck radius) */
    var bodyW = 26;               /* axial length of chuck body */
    var faceX = cx + dir * bodyW / 2;   /* inboard face (toward specimen) */
    var backX = cx - dir * bodyW / 2;   /* outboard face (toward column) */

    /* Back flange (where chuck bolts to the spindle) — a thin wider disc */
    var flangeH = halfH + 4;
    mctx.fillStyle = '#1f2740';
    mctx.fillRect(Math.min(backX, backX - dir * 6), cy - flangeH, 6, flangeH * 2);
    mctx.strokeStyle = '#0d1117';
    mctx.strokeRect(Math.min(backX, backX - dir * 6) + 0.5, cy - flangeH + 0.5, 6, flangeH * 2 - 1);

    /* Main body — radial gradient suggesting cylinder curvature */
    var bodyGrad = mctx.createLinearGradient(0, cy - halfH, 0, cy + halfH);
    bodyGrad.addColorStop(0,   '#1c2236');
    bodyGrad.addColorStop(0.5, '#5a6585');
    bodyGrad.addColorStop(1,   '#1c2236');
    mctx.fillStyle = bodyGrad;
    /* Capsule shape: rectangle with rounded ends */
    var bx = Math.min(backX, faceX);
    mctx.beginPath();
    mctx.moveTo(bx + 4, cy - halfH);
    mctx.lineTo(bx + bodyW - 4, cy - halfH);
    mctx.quadraticCurveTo(bx + bodyW, cy - halfH, bx + bodyW, cy - halfH + 4);
    mctx.lineTo(bx + bodyW, cy + halfH - 4);
    mctx.quadraticCurveTo(bx + bodyW, cy + halfH, bx + bodyW - 4, cy + halfH);
    mctx.lineTo(bx + 4, cy + halfH);
    mctx.quadraticCurveTo(bx, cy + halfH, bx, cy + halfH - 4);
    mctx.lineTo(bx, cy - halfH + 4);
    mctx.quadraticCurveTo(bx, cy - halfH, bx + 4, cy - halfH);
    mctx.closePath();
    mctx.fill();
    mctx.strokeStyle = '#0d1117'; mctx.lineWidth = 1;
    mctx.stroke();

    /* Surface shading — a few horizontal highlight lines suggesting
       the brushed cylindrical body */
    mctx.strokeStyle = 'rgba(255,255,255,0.06)';
    mctx.lineWidth = 1;
    [-halfH * 0.55, -halfH * 0.2, halfH * 0.25].forEach(function (yOff) {
      mctx.beginPath();
      mctx.moveTo(bx + 4, cy + yOff);
      mctx.lineTo(bx + bodyW - 4, cy + yOff);
      mctx.stroke();
    });

    /* Inboard end-face ring (the chuck face we'd see edge-on) */
    mctx.strokeStyle = '#0d1117';
    mctx.lineWidth = 1.5;
    mctx.beginPath();
    mctx.moveTo(faceX, cy - halfH);
    mctx.lineTo(faceX, cy + halfH);
    mctx.stroke();
    /* Subtle inboard rim highlight */
    mctx.strokeStyle = 'rgba(220,228,240,0.35)';
    mctx.lineWidth = 1;
    mctx.beginPath();
    mctx.moveTo(faceX - dir * 1, cy - halfH + 2);
    mctx.lineTo(faceX - dir * 1, cy + halfH - 2);
    mctx.stroke();

    /* Three jaw heads protruding from the inboard face — drawn as small
       rectangular tabs at top, bottom, and one side (so the user reads
       this as a 3-jaw chuck rather than a smooth cylinder). The top and
       bottom tabs are mirrored; the third jaw is on the far side
       (hidden but drawn faintly behind the specimen). */
    var jawExt = 8;       /* how far jaws extend past the face */
    var jawW = 10;        /* jaw width along the axis */
    mctx.fillStyle = '#9aa6c0';
    mctx.strokeStyle = '#0d1117';
    mctx.lineWidth = 1;
    /* Top jaw */
    var jx0 = faceX - dir * jawW;
    var jx1 = faceX + dir * jawExt;
    var jaw0L = Math.min(jx0, jx1), jaw0W = Math.abs(jx1 - jx0);
    mctx.fillRect(jaw0L, cy - halfH * 0.95, jaw0W, 10);
    mctx.strokeRect(jaw0L + 0.5, cy - halfH * 0.95 + 0.5, jaw0W - 1, 9);
    /* Bottom jaw */
    mctx.fillRect(jaw0L, cy + halfH * 0.95 - 10, jaw0W, 10);
    mctx.strokeRect(jaw0L + 0.5, cy + halfH * 0.95 - 9.5, jaw0W - 1, 9);
    /* Centre clamp — small ring around where the specimen exits */
    mctx.fillStyle = '#3a4575';
    mctx.fillRect(jaw0L, cy - 7, jaw0W, 14);
    mctx.strokeStyle = '#0d1117';
    mctx.strokeRect(jaw0L + 0.5, cy - 6.5, jaw0W - 1, 13);
    /* Specimen exit groove on the inboard face */
    mctx.strokeStyle = '#0d1117';
    mctx.lineWidth = 0.8;
    mctx.beginPath();
    mctx.moveTo(faceX + dir * jawExt, cy - 3);
    mctx.lineTo(faceX + dir * jawExt, cy + 3);
    mctx.stroke();

    /* Chuck key socket — small recessed hex on the cylindrical surface */
    mctx.fillStyle = '#0d1117';
    mctx.beginPath();
    mctx.arc(cx, cy - halfH + 8, 3, 0, Math.PI * 2);
    mctx.fill();
    mctx.strokeStyle = '#3a4575';
    mctx.lineWidth = 0.8;
    mctx.stroke();
    /* Hex key cut */
    mctx.strokeStyle = '#5a6585';
    mctx.lineWidth = 0.6;
    mctx.beginPath();
    for (var h = 0; h < 6; h++) {
      var ha = h * Math.PI / 3;
      var hpx = cx + Math.cos(ha) * 1.8;
      var hpy = cy - halfH + 8 + Math.sin(ha) * 1.8;
      if (h === 0) mctx.moveTo(hpx, hpy); else mctx.lineTo(hpx, hpy);
    }
    mctx.closePath();
    mctx.stroke();

    /* Mounting bolt heads on the back flange (4 visible) */
    mctx.fillStyle = '#0d1117';
    [-halfH * 0.7, -halfH * 0.25, halfH * 0.25, halfH * 0.7].forEach(function (yOff) {
      mctx.beginPath();
      mctx.arc(backX - dir * 3, cy + yOff, 1.6, 0, Math.PI * 2);
      mctx.fill();
    });

    /* Rotation indicator — tiny notch on the inboard face that moves
       with the twist on the drive side only. Helps the eye see motion. */
    if (side === 'drive' && Math.abs(state.rotAngleDeg) > 0.1) {
      var notchAng = state.rotAngleDeg * Math.PI / 180;
      /* Project a 3D notch onto the 2D side view — the notch is on the
         circular face at radius halfH-6 and angle notchAng. In side view
         we only see its vertical position. */
      var ny = cy + Math.sin(notchAng) * (halfH - 6);
      var nVisible = Math.cos(notchAng) > -0.2;   /* hide when on the far side */
      if (nVisible) {
        mctx.fillStyle = '#ff8c42';
        mctx.beginPath();
        mctx.arc(faceX + dir * 2, ny, 1.8, 0, Math.PI * 2);
        mctx.fill();
      }
    }
  }

  /* ── Torque transducer housing + cable on the reaction side ── */
  function drawTorqueCell() {
    /* Horizontal cylinder body inside the left column */
    var cx = L_COL_X, cy = AXIS_Y;
    var bodyW = 70, bodyH = 28;
    /* Body */
    var g = mctx.createLinearGradient(0, cy - bodyH / 2, 0, cy + bodyH / 2);
    g.addColorStop(0, '#3d4869');
    g.addColorStop(0.5, '#252c44');
    g.addColorStop(1, '#13182a');
    mctx.fillStyle = g;
    mctx.fillRect(cx - bodyW / 2, cy - bodyH / 2, bodyW, bodyH);
    mctx.strokeStyle = '#0d1117'; mctx.lineWidth = 1;
    mctx.strokeRect(cx - bodyW / 2 + 0.5, cy - bodyH / 2 + 0.5, bodyW - 1, bodyH - 1);
    /* Strain-gauge stripe (centre rib with red LED) */
    mctx.fillStyle = '#0d1117';
    mctx.fillRect(cx - bodyW / 2 + 8, cy - 3, bodyW - 16, 6);
    mctx.fillStyle = state.animPhase === 'running' ? '#ff8c42' : '#3ddc84';
    mctx.beginPath(); mctx.arc(cx - bodyW / 2 + 14, cy, 2.2, 0, Math.PI * 2); mctx.fill();
    /* Junction box on top of the left column */
    var jbX = L_COL_X, jbY = COL_TOP + 22;
    mctx.fillStyle = '#1a2030';
    mctx.fillRect(jbX - 22, jbY - 14, 44, 28);
    mctx.strokeStyle = '#3a4575'; mctx.lineWidth = 1;
    mctx.strokeRect(jbX - 22.5, jbY - 14.5, 45, 29);
    mctx.fillStyle = '#dde3f0';
    mctx.font = '700 7px "Segoe UI"';
    mctx.textAlign = 'center';
    mctx.fillText('JUNCTION', jbX, jbY - 2);
    mctx.fillText('BOX', jbX, jbY + 6);
    /* Cable from torque cell up to junction box (smooth bezier) */
    mctx.strokeStyle = '#0d1117'; mctx.lineWidth = 5;
    mctx.beginPath();
    mctx.moveTo(cx + bodyW / 2 - 6, cy - bodyH / 2);
    mctx.bezierCurveTo(cx + 40, cy - 40, jbX + 20, jbY + 30, jbX + 8, jbY + 14);
    mctx.stroke();
    mctx.strokeStyle = '#2a3050'; mctx.lineWidth = 3;
    mctx.stroke();
    mctx.strokeStyle = '#3a4575'; mctx.lineWidth = 1;
    mctx.stroke();
    /* Label */
    mctx.fillStyle = '#6b7a99';
    mctx.font = '700 8px "Segoe UI"';
    mctx.textAlign = 'center';
    mctx.fillText('TORQUE CELL', cx, cy + bodyH / 2 + 12);
    mctx.fillStyle = '#3ddc84';
    mctx.font = '700 9px Courier New';
    var Tnow = state.curveData.length ? state.curveData[state.curveData.length - 1].torque : 0;
    mctx.fillText(fmt(Tnow, 1) + ' Nm', cx, cy + 2);
  }

  /* ── Drive motor (ribbed cylinder) + worm gearbox + back shaft ── */
  function drawMotorAndGearbox() {
    /* Worm gearbox: integrated into the top of the right column,
       so motor → gearbox → drive shaft → chuck is a clean line. */
    var gbX = R_COL_X, gbY = COL_TOP + 26;
    var gbW = 56, gbH = 40;
    var gG = mctx.createLinearGradient(gbX - gbW / 2, 0, gbX + gbW / 2, 0);
    gG.addColorStop(0, '#1a2030');
    gG.addColorStop(0.5, '#2c3550');
    gG.addColorStop(1, '#13182a');
    mctx.fillStyle = gG;
    mctx.fillRect(gbX - gbW / 2, gbY - gbH / 2, gbW, gbH);
    mctx.strokeStyle = '#0d1117'; mctx.lineWidth = 1;
    mctx.strokeRect(gbX - gbW / 2 + 0.5, gbY - gbH / 2 + 0.5, gbW - 1, gbH - 1);
    /* Worm gearbox label / inspection plate */
    mctx.fillStyle = '#dde3f0';
    mctx.font = '700 8px "Segoe UI"';
    mctx.textAlign = 'center';
    mctx.fillText('GEARBOX', gbX, gbY + 4);
    mctx.fillStyle = '#6b7a99';
    mctx.font = '600 7px "Segoe UI"';
    mctx.fillText('1:200', gbX, gbY + 14);
    /* Output shaft running down inside the column to the chuck */
    mctx.strokeStyle = '#5a6585'; mctx.lineWidth = 4;
    mctx.beginPath();
    mctx.moveTo(gbX, gbY + gbH / 2);
    mctx.lineTo(gbX, AXIS_Y - CHUCK_R - 4);
    mctx.stroke();
    mctx.strokeStyle = 'rgba(255,255,255,0.08)';
    mctx.lineWidth = 1;
    mctx.beginPath();
    mctx.moveTo(gbX - 1.5, gbY + gbH / 2);
    mctx.lineTo(gbX - 1.5, AXIS_Y - CHUCK_R - 4);
    mctx.stroke();

    /* Motor body — ribbed cylinder mounted to the side of gearbox (left input) */
    var motR = 20;
    var motX = gbX - gbW / 2 - motR - 4, motY = gbY;
    var motGrad = mctx.createRadialGradient(motX - 6, motY - 6, 4, motX, motY, motR);
    motGrad.addColorStop(0, '#4a5575');
    motGrad.addColorStop(1, '#13182a');
    mctx.fillStyle = motGrad;
    mctx.beginPath(); mctx.arc(motX, motY, motR, 0, Math.PI * 2); mctx.fill();
    mctx.strokeStyle = '#0d1117'; mctx.lineWidth = 1;
    mctx.stroke();
    /* Cooling fins — vertical lines across the circle */
    mctx.strokeStyle = '#1a2030'; mctx.lineWidth = 1;
    for (var f = -3; f <= 3; f++) {
      var fx = motX + f * 5;
      var dy = Math.sqrt(Math.max(motR * motR - (f * 5) * (f * 5), 1));
      mctx.beginPath();
      mctx.moveTo(fx, motY - dy + 2);
      mctx.lineTo(fx, motY + dy - 2);
      mctx.stroke();
    }
    /* Shaft from motor into gearbox */
    mctx.fillStyle = '#5a6585';
    mctx.fillRect(motX + motR - 2, motY - 3, 8, 6);
    /* Motor labels */
    mctx.fillStyle = '#ff8c42';
    mctx.font = '700 7px "Segoe UI"';
    mctx.textAlign = 'center';
    mctx.fillText('MOTOR', motX, motY - 2);
    mctx.fillStyle = '#dde3f0';
    mctx.font = '600 7px Courier New';
    mctx.fillText('0.5 kW', motX, motY + 8);
    /* Active LED if running */
    mctx.fillStyle = state.animPhase === 'running' ? '#3ddc84' : '#2a3050';
    mctx.beginPath(); mctx.arc(motX, motY - motR - 4, 2.5, 0, Math.PI * 2); mctx.fill();
  }

  /* ── Twist indicator: protractor disc attached to drive shaft.
     Placed BELOW the right chuck (between chuck and bed) so it sits
     visibly without overlapping the gearbox or column. ── */
  function drawTwistIndicator() {
    var cx = R_CHUCK_X;
    var cy = AXIS_Y + CHUCK_R + 38;
    var R = 26;
    /* Stationary protractor scale (large disc behind the chuck) */
    mctx.fillStyle = '#161b27';
    mctx.beginPath(); mctx.arc(cx, cy, R, 0, Math.PI * 2); mctx.fill();
    mctx.strokeStyle = '#3a4575'; mctx.lineWidth = 1.3;
    mctx.stroke();
    /* Tick marks every 10° on the visible half (back side of chuck) */
    mctx.strokeStyle = '#5a6585';
    for (var t = 0; t < 36; t++) {
      var ang = t * Math.PI / 18 - Math.PI / 2;
      var r1 = R - 4, r2 = R - (t % 9 === 0 ? 10 : 6);
      mctx.lineWidth = t % 9 === 0 ? 1.6 : 0.8;
      mctx.beginPath();
      mctx.moveTo(cx + Math.cos(ang) * r1, cy + Math.sin(ang) * r1);
      mctx.lineTo(cx + Math.cos(ang) * r2, cy + Math.sin(ang) * r2);
      mctx.stroke();
    }
    /* Numbers 0 / 90 / 180 / 270 */
    mctx.fillStyle = '#8b9dc3';
    mctx.font = '600 8px Courier New';
    mctx.textAlign = 'center';
    mctx.fillText('0',  cx,        cy - R + 14);
    mctx.fillText('90', cx + R - 9, cy + 3);
    mctx.fillText('180', cx,       cy + R - 6);
    mctx.fillText('270', cx - R + 11, cy + 3);
    /* Live pointer */
    var p = (state.rotAngleDeg % 360) * Math.PI / 180 - Math.PI / 2;
    mctx.strokeStyle = '#ff8c42'; mctx.lineWidth = 2.2;
    mctx.beginPath();
    mctx.moveTo(cx, cy);
    mctx.lineTo(cx + Math.cos(p) * (R - 5), cy + Math.sin(p) * (R - 5));
    mctx.stroke();
    mctx.fillStyle = '#ff8c42';
    mctx.beginPath(); mctx.arc(cx, cy, 3, 0, Math.PI * 2); mctx.fill();
    /* Number rolls (digital readout below) */
    mctx.fillStyle = '#0d1117';
    mctx.fillRect(cx - 26, cy + R + 4, 52, 14);
    mctx.strokeStyle = '#3a4575'; mctx.lineWidth = 1;
    mctx.strokeRect(cx - 26.5, cy + R + 3.5, 53, 15);
    mctx.fillStyle = '#3ddc84';
    mctx.font = '700 10px Courier New';
    mctx.textAlign = 'center';
    mctx.fillText(fmt(state.rotAngleDeg, 1) + '°', cx, cy + R + 15);
  }

  /* ── Bottom control console with E-Stop and LED panel ── */
  function drawControlConsole() {
    var x = 30, y = MH - 76, w = MW - 60, h = 66;
    /* Console body */
    var g = mctx.createLinearGradient(0, y, 0, y + h);
    g.addColorStop(0, '#1f2740');
    g.addColorStop(1, '#0d1320');
    mctx.fillStyle = g;
    mctx.fillRect(x, y, w, h);
    mctx.strokeStyle = '#2a3050'; mctx.lineWidth = 1.5;
    mctx.strokeRect(x + 0.5, y + 0.5, w - 1, h - 1);
    /* Top highlight */
    mctx.fillStyle = 'rgba(255,255,255,0.06)';
    mctx.fillRect(x, y, w, 2);

    /* Brand plate (left) */
    mctx.fillStyle = '#0d1117';
    mctx.fillRect(x + 12, y + 10, 150, 46);
    mctx.strokeStyle = '#3a4575'; mctx.lineWidth = 1;
    mctx.strokeRect(x + 12.5, y + 10.5, 149, 45);
    mctx.fillStyle = '#ff8c42';
    mctx.font = '700 11px "Segoe UI"';
    mctx.textAlign = 'left';
    mctx.fillText('MechSim™', x + 22, y + 26);
    mctx.fillStyle = '#dde3f0';
    mctx.font = '700 13px "Segoe UI"';
    mctx.fillText('TT-100', x + 22, y + 42);
    mctx.fillStyle = '#6b7a99';
    mctx.font = '600 7px "Segoe UI"';
    mctx.fillText('100 N·m  ·  IP54', x + 22, y + 52);

    /* LED status column (centre-left).
       FAULT flashes when E-Stop is latched, solid on fracture. */
    var faultOn = state.eStopLatched
      ? (Math.floor(Date.now() / 400) % 2 === 0)
      : state.animPhase === 'fractured';
    var leds = [
      { label: 'PWR',     on: !state.eStopLatched,             color: '#3ddc84' },
      { label: 'READY',   on: state.animPhase === 'mounted',   color: '#42a5f5' },
      { label: 'TESTING', on: state.animPhase === 'running',   color: '#ff8c42' },
      { label: 'FAULT',   on: faultOn,                         color: '#ff5555' }
    ];
    var lx = x + 180;
    for (var i = 0; i < leds.length; i++) {
      var ly = y + 14 + i * 12;
      mctx.fillStyle = leds[i].on ? leds[i].color : '#1a2030';
      mctx.beginPath(); mctx.arc(lx, ly, 4, 0, Math.PI * 2); mctx.fill();
      if (leds[i].on) {
        mctx.shadowColor = leds[i].color;
        mctx.shadowBlur = 6;
        mctx.beginPath(); mctx.arc(lx, ly, 3.5, 0, Math.PI * 2); mctx.fill();
        mctx.shadowBlur = 0;
      }
      mctx.fillStyle = '#dde3f0';
      mctx.font = '600 8px "Segoe UI"';
      mctx.textAlign = 'left';
      mctx.fillText(leds[i].label, lx + 8, ly + 3);
    }

    /* Digital readout (centre) */
    var dx = x + 260, dy = y + 12, dw = 200, dh = 42;
    mctx.fillStyle = '#0d1117';
    mctx.fillRect(dx, dy, dw, dh);
    mctx.strokeStyle = '#3a4575'; mctx.lineWidth = 1;
    mctx.strokeRect(dx + 0.5, dy + 0.5, dw - 1, dh - 1);
    /* Two readout fields */
    mctx.fillStyle = '#6b7a99';
    mctx.font = '600 7px "Segoe UI"';
    mctx.textAlign = 'left';
    mctx.fillText('TORQUE', dx + 8, dy + 10);
    mctx.fillText('ANGLE',  dx + 108, dy + 10);
    var last = state.curveData.length ? state.curveData[state.curveData.length - 1] : { torque: 0, theta: 0 };
    mctx.fillStyle = '#3ddc84';
    mctx.font = '700 16px Courier New';
    mctx.fillText(fmt(toD(last.torque, 'torque'), 2), dx + 8, dy + 28);
    mctx.fillText(fmt(last.theta, 1) + '°',           dx + 108, dy + 28);
    mctx.fillStyle = '#6b7a99';
    mctx.font = '600 7px "Segoe UI"';
    mctx.fillText(uLabel('torque'), dx + 8, dy + 38);
    mctx.fillText('deg', dx + 108, dy + 38);

    /* Emergency-stop button (right) — mushroom-shaped red push-button.
       When latched the cap is recessed (smaller + darker) and gets a
       glowing halo so the user sees it's been pressed. */
    var ex = x + w - 56, ey = y + h / 2;
    var pressed = state.eStopLatched;
    /* Mounting collar */
    mctx.fillStyle = '#dba600';
    mctx.beginPath(); mctx.arc(ex, ey, 22, 0, Math.PI * 2); mctx.fill();
    mctx.fillStyle = '#0d1117';
    mctx.beginPath(); mctx.arc(ex, ey, 19, 0, Math.PI * 2); mctx.fill();
    /* Halo when latched (pulses) */
    if (pressed) {
      var halo = Math.abs(Math.sin(Date.now() / 250)) * 0.6 + 0.2;
      mctx.fillStyle = 'rgba(255,85,85,' + halo + ')';
      mctx.beginPath(); mctx.arc(ex, ey, 26, 0, Math.PI * 2); mctx.fill();
    }
    /* Red button — smaller and darker when pressed */
    var capR = pressed ? 14 : 17;
    var btnGrad = mctx.createRadialGradient(ex - 4, ey - 6, 2, ex, ey, capR + 1);
    if (pressed) {
      btnGrad.addColorStop(0, '#b21a1a');
      btnGrad.addColorStop(0.6, '#7a1414');
      btnGrad.addColorStop(1, '#3a0808');
    } else {
      btnGrad.addColorStop(0, '#ff8a85');
      btnGrad.addColorStop(0.6, '#d92e2e');
      btnGrad.addColorStop(1, '#6e1212');
    }
    mctx.fillStyle = btnGrad;
    mctx.beginPath(); mctx.arc(ex, ey, capR, 0, Math.PI * 2); mctx.fill();
    mctx.strokeStyle = '#000'; mctx.lineWidth = 1;
    mctx.stroke();
    /* E-Stop text */
    mctx.fillStyle = '#fff';
    mctx.font = '800 7px "Segoe UI"';
    mctx.textAlign = 'center';
    mctx.fillText('EMERGENCY', ex, ey - 3);
    mctx.fillText('STOP', ex, ey + 5);
    /* Caption */
    mctx.fillStyle = '#6b7a99';
    mctx.font = '600 7px "Segoe UI"';
    mctx.fillText('E-STOP', ex, ey + 30);
  }

  /* ── Cross-section scope panel (mini monitor in top-right) ── */
  function drawScopePanel(x, y, w, h) {
    /* Outer frame (monitor body) */
    mctx.fillStyle = '#13182a';
    mctx.fillRect(x, y, w, h);
    mctx.strokeStyle = '#2a3050'; mctx.lineWidth = 1.5;
    mctx.strokeRect(x + 0.5, y + 0.5, w - 1, h - 1);
