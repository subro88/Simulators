  function startQuiz() {
    state.quiz = { idx: 0, score: 0, items: [], current: null };
    /* Sample 5 unique questions */
    var pool = QUIZ_BANK.slice();
    for (var i = pool.length - 1; i > 0; i--) {
      var j = Math.floor(Math.random() * (i + 1));
      var t = pool[i]; pool[i] = pool[j]; pool[j] = t;
    }
    /* Shuffle each question's OPTIONS as well as the question order. Six of the
       eight authored questions put the answer at index 1, and the options were
       rendered in authored order, so always picking the second button scored
       75%. Copy each question first so the pool is never mutated across runs. */
    state.quiz.items = pool.slice(0, 5).map(function (src) {
      var q = {};
      for (var k in src) if (Object.prototype.hasOwnProperty.call(src, k)) q[k] = src[k];
      if (q.opts && q.opts.length) {
        var order = q.opts.map(function (opt, oi) { return { opt: opt, i: oi }; });
        for (var i2 = order.length - 1; i2 > 0; i2--) {
          var j2 = Math.floor(Math.random() * (i2 + 1));
          var t2 = order[i2]; order[i2] = order[j2]; order[j2] = t2;
        }
        q.opts = order.map(function (o) { return o.opt; });
        q.ans = order.findIndex(function (o) { return o.i === src.ans; });
      }
      return q;
    });
    $('quiz-panel').style.display = '';
    $('quiz-result').style.display = 'none';
    $('btn-quiz-next').style.display = 'none';
    showQuizQ();
