    itemInfo.style.display = 'none';
    buildExploreGrid();
  });

  /* ================================================================
     PRACTICE + QUIZ (unchanged behaviour)
     ================================================================ */
  function newPractice() {
    var gen = PROBLEM_GEN[randInt(0, PROBLEM_GEN.length - 1)];
    currentProblem = gen();
