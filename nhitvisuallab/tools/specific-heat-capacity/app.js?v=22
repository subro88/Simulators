    rHeat.textContent  = u.fromHeatKJ(heatInput).toFixed(u.hDigits);
    rUnitTa.textContent = ' ' + u.tempLabel;
    rUnitTb.textContent = ' ' + u.tempLabel;
    rUnitDta.textContent = ' ' + u.dTempLabel;
    rUnitDtb.textContent = ' ' + u.dTempLabel;
