        ctx.beginPath();
        ctx.arc(tipX + (Math.random() - 0.5) * flameW * 0.4,
                y - fh - Math.random() * 12,
                0.6 + Math.random() * 1.2, 0, Math.PI * 2);
        ctx.fill();
      }
    }
