    ctx.fillStyle = '#546e7a'; ctx.textAlign = 'left'; ctx.textBaseline = 'top';
    ctx.fillText(boltLabel() + '  |  ' + gradeLabel() + '  |  ' + nBolts + ' bolt' + (nBolts > 1 ? 's' : '') + '  |  ' + jointType.charAt(0).toUpperCase() + jointType.slice(1) + ' joint', infoX, infoY);

    ctx.font = '600 10px "Segoe UI", sans-serif';
