  /* ================================================================
     UPDATE READOUTS
     ================================================================ */
  function updateReadouts() {
    var u = U();
    setText('#r-stress',  cv(results.sigma, u.stress));  setUnit('#u-stress',  u.stress.u);
    setText('#r-preload', cv(results.Fi, u.force));       setUnit('#u-preload', u.force.u);
    setText('#r-torque', cv(results.torque, u.torque));   setUnit('#u-torque', u.torque.u);
    setText('#r-fos',     results.fos.toFixed(2));
    setText('#r-bforce',  cv(results.Fb, u.force));       setUnit('#u-bforce',  u.force.u);
    setText('#r-cratio',  results.C.toFixed(3));
    setText('#r-sep',     cv(results.Psep, u.force));     setUnit('#u-sep',     u.force.u);
    setText('#r-proof',   cv(results.Fp, u.force));       setUnit('#u-proof',   u.force.u);
    setText('#r-area',    cv(results.At, u.area));        setUnit('#u-area',    u.area.u);
    setText('#r-shear',   cv(results.tau, u.stress));     setUnit('#u-shear',   u.stress.u);
    setText('#r-bearing', cv(results.sigma_b, u.stress)); setUnit('#u-bearing', u.stress.u);
    setText('#r-grip',    cv(results.grip, u.len));       setUnit('#u-grip',    u.len.u);
    /* the same figure, shown beside the two plate inputs that produce it */
    setText('#grip-inline', cv(results.grip, u.len));
    var gu = $('#grip-inline-unit'); if (gu) gu.textContent = u.len.u;
    setText('#r-pct',     results.pct.toFixed(0));
    setText('#r-stretch', cv(results.stretch, u.len3));    setUnit('#u-stretch', u.len3.u);
    setText('#r-kb',      cv(results.kb, u.stiff));        setUnit('#u-kb',      u.stiff.u);
    setText('#r-km',      cv(results.km, u.stiff));        setUnit('#u-km',      u.stiff.u);
    setText('#r-n0',      fmtFactor(results.n0));
    setText('#r-nl',      fmtFactor(results.nL));
    setText('#r-nf',      fmtFactor(results.nf));
    setText('#r-slip',    cv(results.Fslip, u.force));     setUnit('#u-slip',    u.force.u);
    setText('#r-nslip',   fmtFactor(results.nSlip));

    /* Hide cards that do not apply to the current joint type — a card showing a
       number the joint cannot produce is worse than no card at all. */
    var showSB = (jointType === 'shear' || jointType === 'combined');
    var showAx = (jointType !== 'shear');
    [['#card-shear', showSB], ['#card-bearing', showSB],
     ['#card-slip', showSB], ['#card-nslip', showSB],
     ['#card-n0', showAx], ['#card-nl', showAx], ['#card-nf', showAx]
    ].forEach(function (pair) {
      var el = $(pair[0]); if (el) el.style.display = pair[1] ? '' : 'none';
    });

    /* Colour-code every safety factor on the same scale. */
    colourFactor('#r-fos',   results.fos,   2.0, 1.0);
    colourFactor('#r-n0',    results.n0,    1.5, 1.0);
    colourFactor('#r-nl',    results.nL,    1.5, 1.0);
    colourFactor('#r-nf',    results.nf,    1.5, 1.0);
    colourFactor('#r-nslip', results.nSlip, 1.25, 1.0);

    /* Over-tightening warning: the preload itself is at or past proof. */
    var pctEl = $('#r-pct');
    if (pctEl) pctEl.style.color = results.pct > 100 ? '#ff5555' : results.pct > 95 ? '#f5c842' : '';
  }

  /* A factor pinned at the 99.9 clamp means "no demand at all", not "99.9 safe". */
  function fmtFactor(v) { return v >= 99.9 ? '\u221E' : v.toFixed(2); }
  function colourFactor(sel, val, good, warn) {
    var el = $(sel); if (!el) return;
    el.style.color = val >= good ? '#3ddc84' : val >= warn ? '#f5c842' : '#ff5555';
  }

  /* ================================================================
     UI — MODE SWITCHING
     ================================================================ */
  function setMode(m) {
    mode = m;
    $$('#mode-tabs .pill').forEach(function (p) {
      p.classList.toggle('active', p.dataset.mode === m);
    });
    var simPanels = ['#sim-panel', '#canvas-tools', '#learn-panels'];
    var explorePanels = ['#cat-row', '#item-selector', '#item-info'];
    var practicePanels = ['#practice-panel', '#practice-bar'];
    var quizPanels = ['#quiz-panel', '#quiz-bar', '#quiz-result'];

    simPanels.concat(explorePanels, practicePanels, quizPanels).forEach(function (s) { hide($(s)); });


    if (m === 'simulate') {
      simPanels.forEach(function (s) { show($(s)); });
    }
    if (m === 'explore') {
      explorePanels.forEach(function (s) { show($(s)); });
      buildConceptGrid();
    }
    if (m === 'practice') {
      practicePanels.forEach(function (s) { show($(s)); });
      newPractice();
    }
    if (m === 'quiz') {
      show($('#quiz-panel')); show($('#quiz-bar'));
      startQuiz();
    }
    render();
  }

  $('#mode-tabs').addEventListener('click', function (e) {
    if (!e.target.matches('.pill')) return;
    setMode(e.target.dataset.mode);
  });

  /* ================================================================
     UI — SIMULATE CONTROLS (state-driven, stepper + undo aware)
     ================================================================ */

  /* Every field stores SI. `dsp` names the unit spec it is shown in, and the
     Imperial column gives the step and decimals to use once converted — an
     inch joint wants 1/16 in plate steps, not 1 mm converted to 0.039 in.
     Without this the tool would ask for a 3/4" bolt through a "12 mm" plate. */
  var FIELD = {
    load:  { get: function () { return extLoad; }, set: function (v) { extLoad = v; }, min: 1, max: 500, step: 5,  slider: 'load-slider',  input: 'load-input',
             dsp: 'force',  istep: 1,      idec: 1, unitEl: 'load-unit' },
    nbolt: { get: function () { return nBolts; },  set: function (v) { nBolts = v; },  min: 1, max: 12,  step: 1,  slider: 'nbolt-slider', input: 'nbolt-input' },
    t1:    { get: function () { return plate1; },  set: function (v) { plate1 = v; },  min: 3, max: 50,  step: 1,  slider: 't1-slider',    input: 't1-input',
             dsp: 'len',    istep: 0.0625, idec: 4, unitEl: 't1-unit' },
    t2:    { get: function () { return plate2; },  set: function (v) { plate2 = v; },  min: 3, max: 50,  step: 1,  slider: 't2-slider',    input: 't2-input',
             dsp: 'len',    istep: 0.0625, idec: 4, unitEl: 't2-unit' },
    preload: { get: function () { return preloadPct; }, set: function (v) { preloadPct = v; }, min: 40, max: 95,   step: 5, slider: 'preload-slider', input: 'preload-input' },
    torqin:  { get: function () { return torqueIn; },   set: function (v) { torqueIn = v; },   min: 1,  max: 2000, step: 5, slider: 'torque-slider',  input: 'torque-input',
             dsp: 'torque', istep: 5,      idec: 0, unitEl: 'torque-unit' }
  };
  /* A field's min/max/step/decimals in whatever units are on screen. */
  function fieldView(f) {
    if (!f.dsp || !imperial) return { k: 1, min: f.min, max: f.max, step: f.step, dec: 0, u: f.dsp ? U()[f.dsp].u : '' };
    var spec = U()[f.dsp], k = spec.f;
    return { k: k, min: f.min * k, max: f.max * k, step: f.istep, dec: f.idec, u: spec.u };
  }
  function toSI(f, dv)  { var v = fieldView(f); return dv / v.k; }
  function toDisp(f, si) { var v = fieldView(f); return si * v.k; }
  /* Clamp in SI but round on the display grid, so a typed value survives the
     round trip exactly in whichever units it was typed. */
  function clampF(f, siVal) {
    var v = fieldView(f);
    var dv = Math.max(v.min, Math.min(v.max, siVal * v.k));
    var pow = Math.pow(10, v.dec);
    return (Math.round(dv * pow) / pow) / v.k;
  }

  /* Push a SI value into a slider + stepper pair, converting to display units
     and re-stating the control's own min/max/step so the widget matches. */
  function mirror(name, si, force) {
    var f = FIELD[name]; if (!f) return;
    var v = fieldView(f), dv = si * v.k;
    var txt = dv.toFixed(v.dec);
    if (txt.indexOf('.') >= 0) txt = txt.replace(/0+$/, '').replace(/\.$/, '');
    var inp = $('#' + f.input);
    if (inp) {
      inp.min = v.min; inp.max = v.max; inp.step = v.step;
      /* Never fight the user mid-type — except when the step came FROM the
         focused input itself (arrow keys), where the display must follow. */
      if (force || document.activeElement !== inp) inp.value = txt;
    }
    if (f.unitEl) { var ue = $('#' + f.unitEl); if (ue) ue.textContent = v.u; }
    /* Fill the value cell in proportion to where the value sits in its own
       range — the visual feedback the slider used to provide. */
    if (inp) {
      var span = v.max - v.min;
      var pct = span > 0 ? (dv - v.min) / span * 100 : 0;
      inp.style.setProperty('--pct', Math.max(0, Math.min(100, pct)).toFixed(2) + '%');
    }
    /* Grey the button that can no longer do anything. */
    var e2 = v.step * 1e-6;
    var dec = $('.step-btn[data-step="' + name + '"][data-dir="-1"]');
    var inc = $('.step-btn[data-step="' + name + '"][data-dir="1"]');
    if (dec) dec.disabled = dv <= v.min + e2;
    if (inc) inc.disabled = dv >= v.max - e2;
  }
  function syncInputs() {
    populateSelects();
    var nf = $('#nut-factor'); if (nf) nf.value = String(nutFactor.toFixed(2));
    var sp = $('#shear-plane'); if (sp) sp.value = shearPlane;
    var np = $('#n-planes');    if (np) np.value = String(nPlanes);
    var sm = $('#slip-mu');     if (sm) sm.value = slipMu.toFixed(2);
    $$('#joint-tabs .pill').forEach(function (p) { p.classList.toggle('active', p.dataset.joint === jointType); });
    $$('#drive-tabs .pill').forEach(function (p) { p.classList.toggle('active', p.dataset.drive === driveMode); });

    /* Only the control that is actually driving the joint is shown — the other
       would be an input whose value the tool silently ignores. */
    var gP = $('#grp-preload'), gT = $('#grp-torque');
    if (gP) gP.style.display = (driveMode === 'preload') ? '' : 'none';
    if (gT) gT.style.display = (driveMode === 'torque')  ? '' : 'none';
    var sr = $('#shear-row');
    if (sr) sr.style.display = (jointType === 'shear' || jointType === 'combined') ? '' : 'none';

    mirror('preload', preloadPct);
    mirror('torqin',  torqueIn);
    mirror('load',    extLoad);
    mirror('nbolt',   nBolts);
    mirror('t1',      plate1);
    mirror('t2',      plate2);
    $$('#unit-tabs .pill').forEach(function (p) { p.classList.toggle('active', (p.dataset.unit === 'imp') === imperial); });
    updatePresetActive();
  }
  function syncToggleDOM() {
    var z = $('#chk-zones'); if (z) z.checked = showZones;
    var d = $('#chk-dims');  if (d) d.checked = showDims;
    var e = $('#chk-equation'); if (e) e.checked = showEq;
  }

  /* ---- Undo / redo (settled-snapshot model) ---- */
  function snap() {
    return { bs: boltSize, bg: boltGrade, el: extLoad, nb: nBolts, p1: plate1, p2: plate2,
             jt: jointType, im: imperial, sz: showZones, sd: showDims, se: showEq,
             nf: nutFactor, dm: driveMode, pp: preloadPct, tq: torqueIn,
             sp: shearPlane, np: nPlanes, mu: slipMu, pr: activePreset,
             st: boltStd, ts: threadSeries };
  }
  function restore(s) {
    if (!s) return;
    boltSize = s.bs; boltGrade = s.bg; extLoad = s.el; nBolts = s.nb; plate1 = s.p1; plate2 = s.p2; jointType = s.jt;
    nutFactor  = (s.nf === undefined) ? 0.20      : s.nf;
    driveMode  = (s.dm === undefined) ? 'preload' : s.dm;
    preloadPct = (s.pp === undefined) ? 90        : s.pp;
    torqueIn   = (s.tq === undefined) ? 63        : s.tq;
    shearPlane = (s.sp === undefined) ? 'shank'   : s.sp;
    nPlanes    = (s.np === undefined) ? 1         : s.np;
    slipMu     = (s.mu === undefined) ? 0.30      : s.mu;
    activePreset = (s.pr === undefined) ? null : s.pr;
    boltStd      = (s.st === undefined) ? 'metric' : s.st;
    threadSeries = (s.ts === undefined) ? defaultSeries(boltStd) : s.ts;
    imperial  = (s.im === undefined) ? false : !!s.im;
    showZones = (s.sz === undefined) ? true  : !!s.sz;
    showDims  = (s.sd === undefined) ? true  : !!s.sd;
    showEq    = (s.se === undefined) ? true  : !!s.se;
    syncToggleDOM(); syncInputs(); render();
  }
  var settled = null;
  function commit() {
    var cur = JSON.stringify(snap());
    if (settled === null) { settled = cur; return; }
    if (cur === settled) return;
    undoStack.push(settled); settled = cur; redoStack = []; updateUndoBtns();
  }
  function performUndo() {
    if (!undoStack.length) return;
    redoStack.push(settled); settled = undoStack.pop();
    restore(JSON.parse(settled)); updateUndoBtns();
  }
  function performRedo() {
    if (!redoStack.length) return;
    undoStack.push(settled); settled = redoStack.pop();
    restore(JSON.parse(settled)); updateUndoBtns();
  }
  function updateUndoBtns() {
    var ub = $('#btn-undo'), rb = $('#btn-redo');
    if (ub) ub.disabled = !undoStack.length;
    if (rb) rb.disabled = !redoStack.length;
  }

  /* ---- Field change (no commit — for live slider drag) ---- */
  function applyField(name, val, doCommit) {
    var f = FIELD[name]; if (!f) return;
    f.set(clampF(f, val));
    clearPreset();
    syncInputs(); render();
    if (doCommit) commit();
  }

  /* Bolt size / grade selects */
  $('#bolt-size').addEventListener('change', function () {
    boltSize = this.value; clearPreset(); syncInputs(); render(); commit();
  });
  var tsSel = $('#thread-series');
  if (tsSel) tsSel.addEventListener('change', function () {
    var d = BOLT_DATA[boltSize].d;
    threadSeries = this.value;
    boltSize = nearestSize(boltStd, threadSeries, d);
    clearPreset(); syncInputs(); render(); commit();
  });
  $('#bolt-grade').addEventListener('change', function () { boltGrade = this.value; clearPreset(); syncInputs(); render(); commit(); });
  $('#nut-factor').addEventListener('change', function () { nutFactor = parseFloat(this.value); clearPreset(); syncInputs(); render(); commit(); });

  $('#shear-plane').addEventListener('change', function () { shearPlane = this.value; clearPreset(); syncInputs(); render(); commit(); });
  $('#n-planes').addEventListener('change',    function () { nPlanes = parseInt(this.value, 10) || 1; clearPreset(); syncInputs(); render(); commit(); });
  $('#slip-mu').addEventListener('change',     function () { slipMu = parseFloat(this.value); clearPreset(); syncInputs(); render(); commit(); });

  /* Tighten-by tabs. Seed the target you are switching TO from the value the
     tool is currently showing, so flipping the mode does not jump the joint. */
  $('#drive-tabs').addEventListener('click', function (e) {
    if (!e.target.matches('.pill')) return;
    var next = e.target.dataset.drive;
    if (next === driveMode) return;
    var f;
    if (next === 'torque') {
      f = FIELD.torqin; torqueIn = clampF(f, results.torque);
    } else {
      f = FIELD.preload; preloadPct = clampF(f, Math.round(results.pct / 5) * 5);
    }
    driveMode = next;
    clearPreset(); syncInputs(); render(); commit();
  });

  /* Joint type tabs */
  $('#joint-tabs').addEventListener('click', function (e) {
    if (!e.target.matches('.pill')) return;
    jointType = e.target.dataset.joint; clearPreset(); syncInputs(); render(); commit();
  });

  /* Sliders: live on input, commit on change(release) */
  ['load', 'nbolt', 't1', 't2', 'preload', 'torqin'].forEach(function (name) {
    var f = FIELD[name], inp = $('#' + f.input);
    if (!inp) return;
    inp.addEventListener('change', function () {
      var v = parseFloat(this.value);
      if (isNaN(v)) { mirror(name, f.get()); return; }
      applyField(name, toSI(f, v), true);
    });
    /* With the slider gone, the arrow keys are the fast way to sweep a value. */
    inp.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') { this.blur(); return; }
      if (e.key !== 'ArrowUp' && e.key !== 'ArrowDown') return;
      e.preventDefault();
      stepField(name, e.key === 'ArrowUp' ? 1 : -1);
      mirror(name, f.get(), true);
    });
  });

  /* Step ONTO the grid, not just along it. Arriving in Imperial from a metric
     plate leaves 0.4724 in on screen; one press should give a real 1/16 in size
     (0.5) rather than 0.5349. Values only ever change on a press, so nothing
     drifts on its own. */
  function stepField(name, dir, commitNow) {
    var f = FIELD[name]; if (!f) return;
    var v = fieldView(f), cur = f.get() * v.k, e = v.step * 1e-6;
    var next = dir > 0 ? (Math.floor((cur + e) / v.step) + 1) * v.step
                       : (Math.ceil((cur - e) / v.step) - 1) * v.step;
    applyField(name, toSI(f, next), commitNow !== false);
  }

  /* Stepper +/- buttons, with press-and-hold repeat — the slider used to be the
     way to cross a wide range quickly, so the buttons have to cover that now.
     One undo entry per gesture, not per repeat tick. */
  $$('.step-btn').forEach(function (btn) {
    var name = btn.dataset.step, dir = +btn.dataset.dir;
    if (!FIELD[name]) return;
    var holdTimer = null, repeatTimer = null, held = false;

    function stopHold() {
      clearTimeout(holdTimer); clearInterval(repeatTimer);
      holdTimer = repeatTimer = null;
      if (held) { held = false; commit(); }
    }
    btn.addEventListener('pointerdown', function (ev) {
      if (ev.button && ev.button !== 0) return;
      if (btn.disabled) return;
      stepField(name, dir, false);
      holdTimer = setTimeout(function () {
        held = true;
        repeatTimer = setInterval(function () {
          if (btn.disabled) { stopHold(); return; }
          stepField(name, dir, false);
        }, 70);
      }, 420);
    });
    ['pointerup', 'pointerleave', 'pointercancel'].forEach(function (t) {
      btn.addEventListener(t, function () {
        var wasHeld = held;
        stopHold();
        if (!wasHeld) commit();   /* a plain click still records one undo step */
      });
    });
    btn.addEventListener('click', function (ev) { ev.preventDefault(); });
  });

  /* ---- Presets ---- */
  var PRESETS = {
    flange:     { bs: 'M16', bg: '8.8',  el: 80,  nb: 8,  p1: 20, p2: 20, jt: 'tension' },
    bracket:    { bs: 'M10', bg: '8.8',  el: 25,  nb: 4,  p1: 10, p2: 8,  jt: 'shear' },
    pressure:   { bs: 'M20', bg: '10.9', el: 150, nb: 12, p1: 30, p2: 25, jt: 'tension' },
    structural: { bs: 'M24', bg: '10.9', el: 200, nb: 6,  p1: 25, p2: 20, jt: 'combined' }
  };
  var activePreset = null;
  function clearPreset() { activePreset = null; updatePresetActive(); }
  function updatePresetActive() {
    var sel = $('#preset-select');
    if (sel) sel.value = activePreset || '';
  }
  function applyPreset(name) {
    var p = PRESETS[name]; if (!p) return;
    if (boltStd !== 'metric') { imperial = false; setStandard('metric'); }
    boltSize = p.bs; boltGrade = p.bg; extLoad = p.el; nBolts = p.nb; plate1 = p.p1; plate2 = p.p2; jointType = p.jt;
    activePreset = name; syncInputs(); render(); commit();
  }
  var presetSel = $('#preset-select');
  if (presetSel) presetSel.addEventListener('change', function () {
    if (this.value) applyPreset(this.value); else clearPreset();
  });

  /* ---- Unit toggle ---- */
  $('#unit-tabs').addEventListener('click', function (e) {
    if (!e.target.matches('.pill')) return;
    imperial = e.target.dataset.unit === 'imp';
    setStandard(imperial ? 'inch' : 'metric');
    clearPreset(); syncInputs(); render(); commit();
  });

  /* ---- Canvas feature toggles ---- */
  var zChk = $('#chk-zones'), dChk = $('#chk-dims'), eChk = $('#chk-equation');
  if (zChk) zChk.addEventListener('change', function () { showZones = this.checked; render(); commit(); });
  if (dChk) dChk.addEventListener('change', function () { showDims = this.checked; render(); commit(); });
  if (eChk) eChk.addEventListener('change', function () { showEq = this.checked; render(); commit(); });

  /* ---- Action bar ---- */
  var bU = $('#btn-undo'); if (bU) bU.addEventListener('click', performUndo);
  var bR = $('#btn-redo'); if (bR) bR.addEventListener('click', performRedo);
  var bC = $('#btn-csv');  if (bC) bC.addEventListener('click', exportCSV);
  var bP = $('#btn-png');  if (bP) bP.addEventListener('click', exportPNG);
  var bD = $('#btn-pdf'); if (bD) bD.addEventListener('click', exportPDF);
  var bX = $('#btn-reset'); if (bX) bX.addEventListener('click', resetAll);

  document.addEventListener('keydown', function (e) {
    if (mode !== 'simulate') return;
    var t = e.target;
    if (t && (t.tagName === 'INPUT' || t.tagName === 'SELECT' || t.tagName === 'TEXTAREA')) return;
    if ((e.ctrlKey || e.metaKey) && (e.key === 'z' || e.key === 'Z')) {
      e.preventDefault();
      if (e.shiftKey) performRedo(); else performUndo();
    } else if ((e.ctrlKey || e.metaKey) && (e.key === 'y' || e.key === 'Y')) {
      e.preventDefault(); performRedo();
    }
  });

  function resetAll() {
    boltStd = imperial ? 'inch' : 'metric';
    threadSeries = defaultSeries(boltStd);
    boltSize = imperial ? '1/2-13' : 'M10';
    boltGrade = imperial ? 'SAE5' : '8.8';
    extLoad = 30; nBolts = 4; plate1 = 12; plate2 = 12; jointType = 'tension';
    nutFactor = 0.20; driveMode = 'preload'; preloadPct = 90; torqueIn = 63;
    activePreset = null;
    shearPlane = 'shank'; nPlanes = 1; slipMu = 0.30;
    showZones = true; showDims = true; showEq = true;
    activePreset = null;
    syncToggleDOM(); syncInputs(); render(); commit();
  }

  /* ================================================================
     EXPLORE MODE
     ================================================================ */
  function buildConceptGrid() {
    var grid = $('#concept-grid');
    grid.innerHTML = '';
    var filtered = CONCEPTS.filter(function (c) { return c.cat === selCat; });
    filtered.forEach(function (c, i) {
      var btn = document.createElement('button');
      btn.className = 'is-btn' + (i === selConcept ? ' active' : '');
      btn.innerHTML = '<span class="is-btn-name">' + c.name + '</span><span class="is-btn-sym">' + c.symbol + '</span>';
      btn.addEventListener('click', function () {
        selConcept = i;
        $$('.is-btn').forEach(function (b) { b.classList.remove('active'); });
        btn.classList.add('active');
        showConceptInfo(c);
        render();
      });
      grid.appendChild(btn);
    });
    if (filtered[selConcept]) showConceptInfo(filtered[selConcept]);
  }

  function showConceptInfo(c) {
    var el = $('#item-info');
    el.innerHTML =
      '<div class="ii-top"><span class="ii-name">' + c.name + '</span><span class="ii-cat-badge">' + c.cat + '</span></div>' +
      '<p class="ii-desc">' + c.desc + '</p>' +
      '<div class="formula-box"><span class="fb-formula">' + c.formula + '</span><span class="fb-unit">Unit: ' + c.unit + '</span></div>' +
      '<div class="example-box"><h4>Worked Example</h4><p class="ex-problem">' + c.example.problem + '</p>' +
      c.example.steps.map(function (s) { return '<p class="ex-step">' + s + '</p>'; }).join('') +
      '</div>';
    show(el);
  }

  $('#cat-tabs').addEventListener('click', function (e) {
    if (!e.target.matches('.pill')) return;
    selCat = e.target.dataset.cat;
    selConcept = 0;
    $$('#cat-tabs .pill').forEach(function (p) { p.classList.toggle('active', p === e.target); });
    buildConceptGrid();
    render();
  });

  /* ================================================================
     PRACTICE MODE
     ================================================================ */
  function newPractice() {
    pAnswered = false;
    var fn = PROBLEM_GEN[randInt(0, PROBLEM_GEN.length - 1)];
    pProblem = fn();
    $('#pp-prompt').textContent = pProblem.prompt;
    $('#pp-unit').textContent = pProblem.unit;
    $('#pp-input').value = '';
    $('#pp-input').disabled = false;
    $('#pp-feedback').textContent = '';
    hide($('#pp-next'));
    hide($('#pp-solution'));
    render();
  }

  $('#pp-check').addEventListener('click', function () {
    if (pAnswered || !pProblem) return;
    pAnswered = true;
    pTotal++;
    var val = parseFloat($('#pp-input').value);
    var tol = (pProblem.tol != null) ? pProblem.tol
            : Math.max(Math.abs(pProblem.answer) * 0.03, Math.abs(pProblem.answer) < 10 ? 0.01 : 0.5);
    var ok = !isNaN(val) && Math.abs(val - pProblem.answer) <= tol;
    if (ok) pScore++;
    $('#pp-feedback').textContent = ok ? '\u2714 Correct!' : '\u2718 Incorrect \u2014 answer: ' + pProblem.answer + ' ' + pProblem.unit;
    $('#pp-feedback').className = 'feedback ' + (ok ? 'ok' : 'err');
    $('#pp-input').disabled = true;
    show($('#pp-next'));
    /* Show solution */
    var solEl = $('#pp-solution');
    solEl.innerHTML = '<h4>Step-by-Step Solution</h4>' +
      pProblem.steps.map(function (s) { return '<p class="sol-step">' + s.replace(/= ([0-9.]+)/, '= <strong>$1</strong>') + '</p>'; }).join('');
    show(solEl);
    $('#pbar-score-val').textContent = pScore + ' / ' + pTotal;
  });

  $('#pp-next').addEventListener('click', newPractice);

  /* Enter key submits practice */
  $('#pp-input').addEventListener('keydown', function (e) {
    if (e.key === 'Enter') $('#pp-check').click();
  });

  /* ================================================================
     QUIZ MODE
     ================================================================ */
  function startQuiz() {
    quizScore = 0; quizIdx = 0; quizAnswered = false;
    quizQs = shuffleArr(QUIZ_POOL).slice(0, 5);
    hide($('#quiz-result'));
    show($('#quiz-panel')); show($('#quiz-bar'));
    showQuizQ();
  }

  function showQuizQ() {
    quizAnswered = false;
    var q = quizQs[quizIdx];
    $('#qbar-num').textContent = quizIdx + 1;
    var panel = $('#quiz-panel');

    if (q.type === 'mcq') {
      var opts = q.options.slice();
      var correctText = opts[q.correct];
      var shuffled = shuffleArr(opts);
      q._correctIdx = shuffled.indexOf(correctText);
      panel.innerHTML = '<p class="qp-prompt">Q' + (quizIdx + 1) + '. ' + q.prompt + '</p>' +
        '<div class="answer-grid">' +
        shuffled.map(function (o, i) {
          return '<button class="answer-btn" data-idx="' + i + '">' + o + '</button>';
        }).join('') + '</div>' +
        '<p class="quiz-feedback" id="qfb"></p>' +
        '<button class="btn btn-ghost" id="q-next" style="display:none;margin-top:10px;">Next \u2192</button>';
      panel.querySelectorAll('.answer-btn').forEach(function (btn) {
        btn.addEventListener('click', function () { submitMCQ(+btn.dataset.idx, q._correctIdx, panel); });
      });
    } else {
      panel.innerHTML = '<p class="qp-prompt">Q' + (quizIdx + 1) + '. ' + q.prompt + '</p>' +
        '<div class="quiz-input-row"><input class="qi-input" id="qi-val" type="number" step="any" placeholder="Your answer"><span class="qi-unit">' + q.unit + '</span>' +
        '<button class="btn btn-primary" id="q-submit">Submit</button></div>' +
        '<p class="quiz-feedback" id="qfb"></p>' +
        '<button class="btn btn-ghost" id="q-next" style="display:none;margin-top:10px;">Next \u2192</button>';
      panel.querySelector('#q-submit').addEventListener('click', function () { submitNumeric(q, panel); });
      panel.querySelector('#qi-val').addEventListener('keydown', function (e) {
        if (e.key === 'Enter') panel.querySelector('#q-submit').click();
      });
    }
    var nextBtn = panel.querySelector('#q-next');
    if (nextBtn) nextBtn.addEventListener('click', nextQuizQ);
    render();
  }

  function submitMCQ(chosen, correct, panel) {
    if (quizAnswered) return;
    quizAnswered = true;
    var btns = panel.querySelectorAll('.answer-btn');
    btns.forEach(function (b, i) {
      b.classList.add('locked');
      if (i === correct) b.classList.add('correct');
      if (i === chosen && i !== correct) b.classList.add('wrong');
    });
    var ok = chosen === correct;
    if (ok) quizScore++;
    quizQs[quizIdx]._given = btns[chosen].textContent;
    quizQs[quizIdx]._ok = ok;
    panel.querySelector('#qfb').textContent = ok ? '\u2714 Correct!' : '\u2718 Incorrect';
    panel.querySelector('#qfb').className = 'quiz-feedback ' + (ok ? 'ok' : 'err');
    show(panel.querySelector('#q-next'));
  }

  function submitNumeric(q, panel) {
    if (quizAnswered) return;
    quizAnswered = true;
    var val = parseFloat(panel.querySelector('#qi-val').value);
    var tol = (q.tol != null) ? q.tol
            : Math.max(Math.abs(q.answer) * 0.03, Math.abs(q.answer) < 10 ? 0.01 : 0.5);
    var ok = !isNaN(val) && Math.abs(val - q.answer) <= tol;
    if (ok) quizScore++;
    q._given = isNaN(val) ? 'No answer' : val;
    q._ok = ok;
    panel.querySelector('#qfb').textContent = ok ? '\u2714 Correct!' : '\u2718 Answer: ' + q.answer + ' ' + q.unit;
    panel.querySelector('#qfb').className = 'quiz-feedback ' + (ok ? 'ok' : 'err');
    panel.querySelector('#qi-val').disabled = true;
    panel.querySelector('#q-submit').disabled = true;
    show(panel.querySelector('#q-next'));
  }

  function nextQuizQ() {
    quizIdx++;
    if (quizIdx >= quizQs.length) { showQuizResult(); return; }
    showQuizQ();
  }

  function showQuizResult() {
    hide($('#quiz-panel')); hide($('#quiz-bar'));
    var el = $('#quiz-result');
    var pct = quizScore / quizQs.length;
    var cls = pct === 1 ? 'perfect' : pct >= 0.6 ? 'good' : 'poor';
    var stars = pct === 1 ? '\u2605\u2605\u2605' : pct >= 0.6 ? '\u2605\u2605' : '\u2605';
    var verdict = pct === 1 ? 'Perfect Score!' : pct >= 0.6 ? 'Good Job!' : 'Keep Practising';

    el.innerHTML =
      '<div class="qr-header"><div class="qr-title-wrap"><span class="qr-title">Quiz Complete</span><span class="qr-stars">' + stars + '</span></div>' +
      '<div class="qr-score-wrap"><span class="qr-score ' + cls + '">' + quizScore + '/' + quizQs.length + '</span><div class="qr-verdict">' + verdict + '</div></div></div>' +
      '<div class="qr-rows">' +
