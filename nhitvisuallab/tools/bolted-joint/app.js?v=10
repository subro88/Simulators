  /* ================================================================
     CANVAS CONTEXT MENU
     ================================================================ */
  function wireContextMenu() {
    var menu = $('#ctx-menu'); if (!menu) return;
    cvs.addEventListener('contextmenu', function (e) {
      if (mode !== 'simulate') return;
      e.preventDefault();
      menu.classList.add('active'); menu.setAttribute('aria-hidden', 'false');
      var mw = menu.offsetWidth || 170, mh = menu.offsetHeight || 160;
      var x = Math.min(e.clientX, window.innerWidth - mw - 6);
      var y = Math.min(e.clientY, window.innerHeight - mh - 6);
      menu.style.left = x + 'px'; menu.style.top = y + 'px';
    });
    function closeMenu() { menu.classList.remove('active'); menu.setAttribute('aria-hidden', 'true'); }
    document.addEventListener('click', closeMenu);
    document.addEventListener('scroll', closeMenu, true);
    menu.addEventListener('click', function (e) {
      var act = e.target && e.target.dataset ? e.target.dataset.act : null;
      if (act === 'csv') exportCSV();
      else if (act === 'png') exportPNG();
      else if (act === 'reset') resetAll();
      else if (act === 'copy') {
        var u = U();
        var txt = boltLabel() + ' ' + gradeLabel() + ' | Fb=' + cv(results.Fb, u.force) + ' ' + u.force.u +
                  ' | σ=' + cv(results.sigma, u.stress) + ' ' + u.stress.u + ' | FoS=' + results.fos.toFixed(2);
        if (navigator.clipboard) navigator.clipboard.writeText(txt);
      }
      closeMenu();
    });
  }

