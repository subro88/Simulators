  /* ================================================================
     PHYSICS ENGINE
     ================================================================ */

  var E_STEEL = 207000; /* MPa — Young's modulus of steel */

  function calculateAll() {
    var bolt = BOLT_DATA[boltSize];
    var grade = gradeFor(boltGrade, bolt.d);
    var d = bolt.d;

    /* Tensile stress area, grip, proof load */
    results.At = bolt.At;
    results.grip = plate1 + plate2;                       /* Lg, mm */
    results.Fp = results.At * grade.Sp / 1000;            /* kN */

    /* ---- Tightening: preload <-> torque ----------------------------------
       T = K * d * Fi is the short-form relation (Shigley Eq. 8-27). With d in mm
       and Fi in kN the units land directly on N.m, since
       (d/1000 m) * (Fi*1000 N) = d * Fi. K bundles thread and collar friction and
       is the dominant uncertainty in any torque method.
       Either end can be the input: specify a preload target as a percentage of
       proof load, or specify the torque you will actually apply and read off the
       preload it produces. */
    if (driveMode === 'torque') {
      results.torque = torqueIn;
      results.Fi  = torqueIn / (nutFactor * d);           /* kN */
      results.pct = results.Fp > 0 ? 100 * results.Fi / results.Fp : 0;
    } else {
      results.pct = preloadPct;
      results.Fi  = (preloadPct / 100) * results.Fp;      /* kN */
      results.torque = nutFactor * d * results.Fi;        /* N.m */
    }

    /* Joint stiffness (SI: N/mm). kb = At*E/Lg ;
       km via Wileman/Shigley empirical fit for steel members. */
    var Lg = Math.max(results.grip, 1);
    var kb = results.At * E_STEEL / Lg;                                 /* N/mm */
    var km = E_STEEL * d * 0.78715 * Math.exp(0.62873 * d / Lg);        /* N/mm */
    results.kb = kb / 1000;                               /* kN/mm */
    results.km = km / 1000;
    var C = kb / (kb + km);
    results.C = C;

    var P = extLoad / nBolts;                             /* external load per bolt, kN */
    var sepPer = results.Fi / Math.max(1 - C, 1e-6);     /* per-bolt separation load */
    results.Psep = nBolts * sepPer;                       /* total separation load, kN */

    /* Bolt axial force & stress (preload-aware). */
    if (jointType === 'tension' || jointType === 'combined') {
      /* Bolt sees Fi + C·P until the joint separates, then the full load. */
      results.Fb = (P <= sepPer) ? (results.Fi + C * P) : P;
    } else {
      /* Pure shear: the bolt still carries its preload tension. */
      results.Fb = results.Fi;
    }
    results.sigma = results.Fb * 1000 / results.At;       /* MPa — total bolt axial stress */

    /* Bolt elongation. The bolt is a spring of rate kb, so the stretch you would
       measure with a micrometer or an ultrasonic gauge is simply Fi/kb. This is
       the check used whenever preload actually matters, because it bypasses K. */
    results.stretch    = results.kb > 0 ? results.Fi / results.kb : 0;   /* mm at preload */
    results.stretchTot = results.kb > 0 ? results.Fb / results.kb : 0;   /* mm under load  */

    /* ---- Shear -----------------------------------------------------------
       Which area resists shear depends on where the shear plane falls. Through
       the plain shank it is the full circle; if the threads run into the joint
       the plane cuts the thread and the standards fall back on At. Double shear
       (a butt joint with two cover plates) halves the stress by giving the load
       two planes to cross. */
    var Ashear = (shearPlane === 'thread') ? results.At : (Math.PI * d * d / 4);
    results.Ashear = Ashear;
    var isShear = (jointType === 'shear' || jointType === 'combined');
    results.tau = isShear
      ? extLoad * 1000 / (nBolts * nPlanes * Ashear) : 0;

    /* Bearing stress on the thinner plate. Unchanged by the number of shear
       planes: in a double-shear butt joint the centre plate still carries the
       whole per-bolt load against its own thickness. */
    var tMin = Math.min(plate1, plate2);
    results.sigma_b = isShear ? extLoad * 1000 / (nBolts * d * tMin) : 0;

    /* ---- Slip resistance (friction-grip / preloaded shear connection) -----
       A preloaded shear joint is not meant to reach the bolt at all: the clamping
       force generates friction across the faying surfaces and the plates never
       move. Slip resistance is mu * Fi per surface, per bolt. Bolt shear is the
       reserve after slip, not the design condition. */
    results.Fslip = nBolts * nPlanes * slipMu * results.Fi;      /* kN, joint total */
    results.nSlip = (isShear && extLoad > 0) ? results.Fslip / extLoad : 99.9;

    /* ---- Separation and load factors (Shigley Eqs. 8-29, 8-30) -----------
       n0: how many times the applied load the joint can take before the members
           lift apart. nL: how many times it can take before the bolt reaches proof.
       These answer different questions from the stress-based FoS, and a joint can
       easily pass one and fail the other. */
    if (jointType !== 'shear' && P > 0) {
      results.n0 = results.Fi / (P * Math.max(1 - C, 1e-6));
      results.nL = C > 0 ? (results.Fp - results.Fi) / (C * P) : 99.9;
      if (results.nL < 0) results.nL = 0;
    } else {
      results.n0 = 99.9; results.nL = 99.9;
    }

    /* ---- Fatigue (Goodman, repeated external load 0 -> P) -----------------
       The textbook case: the external load cycles between zero and P, so
       sigma_a = C*P/(2*At) and sigma_m = sigma_a + sigma_i. Substituting into
       Shigley Eq. 8-38 and cancelling (sigma_m - sigma_i = sigma_a) leaves
         nf = Se(Sut - sigma_i) / [sigma_a (Sut + Se)].
       Se is the fully corrected endurance strength of a ROLLED thread — cut
       threads are roughly 30% worse and this figure would not apply. */
    var sigma_i = results.Fi * 1000 / results.At;         /* MPa — preload stress */
    if (jointType !== 'shear' && P > 0) {
      results.sigma_a = C * P * 1000 / (2 * results.At);
      var denom = results.sigma_a * (grade.Su + grade.Se);
      results.nf = denom > 0 ? grade.Se * (grade.Su - sigma_i) / denom : 99.9;
      if (results.nf < 0) results.nf = 0;
    } else {
      results.sigma_a = 0; results.nf = 99.9;
    }

    /* Shear stress on the shank area (kept for the von Mises combination) */
    /* Factor of safety against proof strength */
    if (jointType === 'combined') {
      results.sigma_vm = Math.sqrt(results.sigma * results.sigma + 3 * results.tau * results.tau);
      results.fos = results.sigma_vm > 0 ? grade.Sp / results.sigma_vm : 99.9;
    } else if (jointType === 'shear') {
      results.sigma_vm = 0;
      results.fos = results.tau > 0 ? (0.577 * grade.Sp) / results.tau : 99.9;
    } else {
      results.sigma_vm = 0;
      results.fos = results.sigma > 0 ? grade.Sp / results.sigma : 99.9;
    }
    if (results.fos > 99.9) results.fos = 99.9;
    if (results.n0  > 99.9) results.n0  = 99.9;
    if (results.nL  > 99.9) results.nL  = 99.9;
    if (results.nf  > 99.9) results.nf  = 99.9;
    if (results.nSlip > 99.9) results.nSlip = 99.9;
  }

