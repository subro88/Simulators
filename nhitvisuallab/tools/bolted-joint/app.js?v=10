      html += step('Shear &amp; bearing stress',
        '\\[ \\tau = \\dfrac{F}{n\\,n_s\\,' + aName + '},\\quad \\sigma_{br} = \\dfrac{F}{n\\,d\\,t} \\]',
        '\\(\\tau = \\dfrac{' + (extLoad * 1000) + '}{' + nBolts + '\\times' + nPlanes + '\\times' + results.Ashear.toFixed(1) + '}\\) &mdash; plane through the ' + (shearPlane === 'thread' ? 'threads' : 'shank') + ', ' + (nPlanes === 2 ? 'double' : 'single') + ' shear',
        '\\(\\tau = \\mathbf{' + fS(results.tau) + '\\;' + l.S + '},\\; \\sigma_{br} = \\mathbf{' + fS(results.sigma_b) + '\\;' + l.S + '}\\)');

