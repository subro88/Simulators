    }

    /* ── Nut ── */
    var nutY = botPlateY + 4;
    /* Hex nut as polygon */
    ctx.fillStyle = '#455a64';
    ctx.beginPath();
    var nutW2 = headW * 0.5;
    ctx.moveTo(cx - nutW2, nutY + 2);
    ctx.lineTo(cx - nutW2 * 0.85, nutY);
    ctx.lineTo(cx + nutW2 * 0.85, nutY);
    ctx.lineTo(cx + nutW2, nutY + 2);
    ctx.lineTo(cx + nutW2, nutY + nutH - 2);
    ctx.lineTo(cx + nutW2 * 0.85, nutY + nutH);
    ctx.lineTo(cx - nutW2 * 0.85, nutY + nutH);
    ctx.lineTo(cx - nutW2, nutY + nutH - 2);
