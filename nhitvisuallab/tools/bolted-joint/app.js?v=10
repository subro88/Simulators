    if (driveMode === 'torque') {
      if (results.pct > 100) items.push(['bad', '<strong>' + cv(results.torque, u.torque) + ' ' + u.torque.u + '</strong> drives this bolt to <strong>' + results.pct.toFixed(0) + '% of proof load</strong> — past the proof point, so the bolt takes a permanent set. Reduce the torque or go up a grade.']);
      else if (results.pct > 95) items.push(['warn', 'That torque reaches <strong>' + results.pct.toFixed(0) + '% of proof</strong>. There is almost no margin left for friction scatter.']);
      else if (results.pct < 50) items.push(['warn', 'That torque only reaches <strong>' + results.pct.toFixed(0) + '% of proof</strong> — a slack joint that will loosen and fatigue.']);
      else items.push([null, '<strong>' + cv(results.torque, u.torque) + ' ' + u.torque.u + '</strong> at K = ' + nutFactor.toFixed(2) + ' produces <strong>' + cv(results.Fi, u.force) + ' ' + fu + '</strong> of preload — ' + results.pct.toFixed(0) + '% of proof load.']);
