  }

  function drawStressBarChart(bolt, grade) {
    var grd = gradeFor(boltGrade, BOLT_DATA[boltSize].d);
    var barX = STRESS_X0 + 20;
    var barW = 50;
    var chartTop = 50;
    var chartBot = 390;
    var chartH = chartBot - chartTop;
    var gap = 65;

    /* Find max value for scale */
    var maxVal = grd.Sp;
    var values = [
      { label: 'Tensile', val: results.sigma, color: '#ff5555', limit: grd.Sp },
      { label: 'Shear', val: results.tau, color: '#3ddc84', limit: 0.577 * grd.Sp },
      { label: 'Bearing', val: results.sigma_b, color: '#f5c842', limit: grd.Sy },
      { label: 'FoS', val: Math.min(results.fos, 5), color: '#42a5f5', limit: 5, isFoS: true }
    ];

    /* Scale to proof strength for stress, 5 for FoS */
    values.forEach(function (v, i) {
      var bx = barX + i * gap;
      var scaleMax = v.isFoS ? 5 : maxVal;
      var barH = (v.val / scaleMax) * chartH;
      barH = Math.min(barH, chartH);
      barH = Math.max(barH, 2);

      /* Background bar */
      ctx.fillStyle = 'rgba(42,48,80,0.5)';
      roundRect(ctx, bx, chartTop, barW, chartH, 4);
      ctx.fill();

      /* Value bar */
      ctx.fillStyle = v.color;
      var barY = chartBot - barH;
      roundRect(ctx, bx, barY, barW, barH, 4);
      ctx.fill();

      /* Danger / safe indicator */
      if (!v.isFoS) {
        var limitH = (v.limit / scaleMax) * chartH;
        var limitY = chartBot - limitH;
        ctx.strokeStyle = 'rgba(221,227,240,0.4)'; ctx.lineWidth = 1;
        ctx.setLineDash([4, 3]);
        ctx.beginPath();
        ctx.moveTo(bx - 5, limitY); ctx.lineTo(bx + barW + 5, limitY);
        ctx.stroke();
        ctx.setLineDash([]);
        ctx.font = '600 7px "Segoe UI", sans-serif';
        ctx.fillStyle = '#6b7a99';
        ctx.textAlign = 'center'; ctx.textBaseline = 'bottom';
        ctx.fillText('Limit', bx + barW / 2, limitY - 2);
      } else {
        /* FoS safe line at 2.0 */
        var safeH = (2.0 / 5) * chartH;
        var safeY = chartBot - safeH;
        ctx.strokeStyle = 'rgba(61,220,132,0.5)'; ctx.lineWidth = 1;
        ctx.setLineDash([4, 3]);
        ctx.beginPath();
        ctx.moveTo(bx - 5, safeY); ctx.lineTo(bx + barW + 5, safeY);
        ctx.stroke();
        ctx.setLineDash([]);
        ctx.font = '600 7px "Segoe UI", sans-serif';
        ctx.fillStyle = '#3ddc84';
        ctx.textAlign = 'center'; ctx.textBaseline = 'bottom';
        ctx.fillText('Safe', bx + barW / 2, safeY - 2);
      }

      /* Value text */
      ctx.font = '700 11px "Courier New", monospace';
      ctx.fillStyle = v.color;
      ctx.textAlign = 'center'; ctx.textBaseline = 'bottom';
      if (v.isFoS) {
        ctx.fillText(results.fos.toFixed(2), bx + barW / 2, barY - 4);
      } else {
        ctx.fillText(cv(v.val, U().stress), bx + barW / 2, barY - 4);
      }

      /* Label */
      ctx.font = '600 9px "Segoe UI", sans-serif';
      ctx.fillStyle = '#dde3f0';
      ctx.textAlign = 'center'; ctx.textBaseline = 'top';
      ctx.fillText(v.label, bx + barW / 2, chartBot + 8);

      /* Unit */
      ctx.font = '600 8px "Segoe UI", sans-serif';
      ctx.fillStyle = '#6b7a99';
      ctx.fillText(v.isFoS ? '' : U().stress.u, bx + barW / 2, chartBot + 22);
    });

    /* FoS status badge */
    var fosX = STRESS_X0 + 20;
    var fosY = chartBot + 48;
    var fosOk = results.fos >= 2.0;
    var fosWarn = results.fos >= 1.0 && results.fos < 2.0;

    ctx.fillStyle = fosOk ? 'rgba(61,220,132,0.15)' : fosWarn ? 'rgba(245,200,66,0.15)' : 'rgba(255,85,85,0.15)';
    roundRect(ctx, fosX, fosY, 280, 30, 8);
    ctx.fill();
    ctx.strokeStyle = fosOk ? '#3ddc84' : fosWarn ? '#f5c842' : '#ff5555';
    ctx.lineWidth = 1.5;
    roundRect(ctx, fosX, fosY, 280, 30, 8);
    ctx.stroke();

    ctx.font = '700 11px "Segoe UI", sans-serif';
    ctx.fillStyle = fosOk ? '#3ddc84' : fosWarn ? '#f5c842' : '#ff5555';
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    var statusText = fosOk ? 'SAFE — FoS = ' + results.fos.toFixed(2) : fosWarn ? 'MARGINAL — FoS = ' + results.fos.toFixed(2) : 'UNSAFE — FoS = ' + results.fos.toFixed(2);
    ctx.fillText(statusText, fosX + 140, fosY + 15);
  }

  /* Utility: rounded rect */
  function roundRect(ctx, x, y, w, h, r) {
    ctx.beginPath();
    ctx.moveTo(x + r, y);
    ctx.lineTo(x + w - r, y);
    ctx.quadraticCurveTo(x + w, y, x + w, y + r);
    ctx.lineTo(x + w, y + h - r);
    ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
    ctx.lineTo(x + r, y + h);
    ctx.quadraticCurveTo(x, y + h, x, y + h - r);
    ctx.lineTo(x, y + r);
    ctx.quadraticCurveTo(x, y, x + r, y);
    ctx.closePath();
  }

