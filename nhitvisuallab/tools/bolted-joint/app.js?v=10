    ctx.beginPath();
    ctx.moveTo(dimX - 4, topPlateY); ctx.lineTo(dimX + 4, topPlateY);
    ctx.moveTo(dimX - 4, botPlateY); ctx.lineTo(dimX + 4, botPlateY);
    ctx.stroke();
    ctx.font = '600 9px "Segoe UI", sans-serif';
    ctx.fillStyle = '#6b7a99';
    ctx.textAlign = 'left'; ctx.textBaseline = 'middle';
    ctx.fillText('Lg=' + cv(results.grip, U().len) + U().len.u, dimX + 6, cy);

    /* Bolt diameter */
    ctx.strokeStyle = '#6b7a99'; ctx.lineWidth = 1;
    ctx.setLineDash([3, 2]);
    var dimBY = botPlateY + nutH + 30;
    ctx.beginPath();
    ctx.moveTo(cx - shankW / 2, dimBY);
    ctx.lineTo(cx + shankW / 2, dimBY);
    ctx.stroke();
    ctx.setLineDash([]);
    ctx.beginPath();
    ctx.moveTo(cx - shankW / 2, dimBY - 4);
    ctx.lineTo(cx - shankW / 2, dimBY + 4);
    ctx.moveTo(cx + shankW / 2, dimBY - 4);
    ctx.lineTo(cx + shankW / 2, dimBY + 4);
    ctx.stroke();
    ctx.fillStyle = '#6b7a99';
    ctx.textAlign = 'center'; ctx.textBaseline = 'top';
    ctx.fillText('\u00F8' + bolt.d + 'mm', cx, dimBY + 5);
    } /* end showDims */

    /* ── Info box ── */
    var infoX = JOINT_X0;
    var infoY = botPlateY + nutH + 55;
