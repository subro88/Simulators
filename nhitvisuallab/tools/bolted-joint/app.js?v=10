      '\\(\\delta = \\dfrac{' + results.Fi.toFixed(1) + '}{' + results.kb.toFixed(0) + '}\\;\\mathrm{mm}\\)',
      '\\(\\mathbf{' + cv(results.stretch, U().len3) + '\\;' + Lu + '}\\)');

    if (jointType !== 'shear') {
      html += step('Resultant bolt force &amp; stress',
        '\\[ F_b = F_i + C\\,P,\\quad \\sigma_b = \\dfrac{F_b}{A_t} \\]',
        '\\(F_b = ' + fF(results.Fi) + ' + ' + results.C.toFixed(3) + '\\times' + fF(P) + ' = ' + fF(results.Fb) + '\\;' + l.F + '\\)',
        '\\(\\sigma_b = \\mathbf{' + fS(results.sigma) + '\\;' + l.S + '}\\)');

      html += step('Separation and load factors',
        '\\[ n_0 = \\dfrac{F_i}{P(1-C)},\\quad n_L = \\dfrac{F_p - F_i}{C\\,P} \\]',
