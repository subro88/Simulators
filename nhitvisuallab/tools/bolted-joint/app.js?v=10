    var P = extLoad / nBolts;
    var Psep = results.Fi / Math.max(1 - results.C, 1e-6);
    var xmax = Math.max(Psep * 1.35, P * 1.3, 1);
    var ymax = Math.max(results.Fp * 1.2, results.Fb * 1.25, 1);
    var SX = function (v) { return pad.l + (v / xmax) * pw; };
    var SY = function (v) { return pad.t + ph - (v / ymax) * ph; };

