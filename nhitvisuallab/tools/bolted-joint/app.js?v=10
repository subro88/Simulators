    /* Head detail lines */
    ctx.strokeStyle = '#90a4ae'; ctx.lineWidth = 0.8;
    for (var hd = 0; hd < 3; hd++) {
      var hx = cx - headW / 4 + hd * headW / 4;
      ctx.beginPath();
      ctx.moveTo(hx, headY + 3);
      ctx.lineTo(hx, headY + headH - 3);
