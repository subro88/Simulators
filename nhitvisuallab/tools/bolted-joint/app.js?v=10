    /* ── Bolt shank ── */
    ctx.fillStyle = '#546e7a';
    ctx.fillRect(cx - shankW / 2, topPlateY - 4, shankW, totalH + 8);
    ctx.strokeStyle = '#78909c'; ctx.lineWidth = 1;
    ctx.strokeRect(cx - shankW / 2, topPlateY - 4, shankW, totalH + 8);

    /* Thread marks on lower portion */
    ctx.strokeStyle = '#90a4ae'; ctx.lineWidth = 0.7;
    var threadStart = midY - 4;
    var threadEnd = botPlateY + 6;
    for (var tm = threadStart; tm < threadEnd; tm += 3) {
      ctx.beginPath();
      ctx.moveTo(cx - shankW / 2, tm);
      ctx.lineTo(cx + shankW / 2, tm);
