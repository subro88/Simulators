        '\\(n_0 = \\mathbf{' + fmtTex(results.n0) + '}\\) (joint opens), \\(n_L = \\mathbf{' + fmtTex(results.nL) + '}\\) (bolt reaches proof)');

      html += step('Fatigue &mdash; Goodman, load cycling 0 &rarr; P',
        '\\[ \\sigma_a = \\dfrac{C\\,P}{2A_t},\\qquad n_f = \\dfrac{S_e\\,(S_{ut}-\\sigma_i)}{\\sigma_a\\,(S_{ut}+S_e)} \\]',
        '\\(\\sigma_i = ' + (results.Fi * 1000 / results.At).toFixed(1) + ',\\; \\sigma_a = ' + results.sigma_a.toFixed(1) + '\\;\\mathrm{MPa};\\; S_{ut} = ' + g.Su + ',\\; S_e = ' + g.Se + '\\;\\mathrm{MPa}\\)',
