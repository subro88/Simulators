      x.fillStyle = '#546e7a'; x.font = '12px "Segoe UI", sans-serif'; x.textAlign = 'left';
      x.fillText('Friction is the design condition in a preloaded joint;', pad.l, FH - 30);
      x.fillText('bolt shear and plate bearing are the reserve behind it.', pad.l, FH - 14);
