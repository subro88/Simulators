  /* Why a preloaded bolt survives cycling: the load line is nearly flat. */
  function drawFatigueDiag() {
    ctx.font = '700 14px "Segoe UI", sans-serif';
    ctx.fillStyle = '#dde3f0'; ctx.textAlign = 'center';
    ctx.fillText('Bolt Fatigue — preload flattens the load line', W / 2, 35);

    var ox = 130, oy = 340, pw = 420, ph = 250;

    /* Axes */
    ctx.strokeStyle = '#546e7a'; ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.moveTo(ox, oy - ph); ctx.lineTo(ox, oy); ctx.lineTo(ox + pw, oy); ctx.stroke();
    ctx.font = '600 11px "Segoe UI", sans-serif';
    ctx.fillStyle = '#8fa3b0'; ctx.textAlign = 'center';
    ctx.fillText('External load per bolt, P', ox + pw / 2, oy + 26);
    ctx.save();
    ctx.translate(ox - 48, oy - ph / 2); ctx.rotate(-Math.PI / 2);
    ctx.fillText('Bolt force, Fb', 0, 0);
    ctx.restore();

    /* Preload floor */
    var yFi = oy - ph * 0.52;
    ctx.strokeStyle = 'rgba(66,165,245,0.75)'; ctx.lineWidth = 2; ctx.setLineDash([5, 4]);
    ctx.beginPath(); ctx.moveTo(ox, yFi); ctx.lineTo(ox + pw, yFi); ctx.stroke();
    ctx.setLineDash([]);
    ctx.font = '700 11px "Courier New", monospace';
    ctx.fillStyle = '#42a5f5'; ctx.textAlign = 'left';
    ctx.fillText('Fi', ox + 6, yFi - 8);

    /* Preloaded bolt: shallow line of slope C, starting at Fi */
    var xSep = ox + pw * 0.66;
    ctx.strokeStyle = '#3ddc84'; ctx.lineWidth = 3;
    ctx.beginPath(); ctx.moveTo(ox, yFi); ctx.lineTo(xSep, yFi - ph * 0.17); ctx.stroke();
    /* past separation it snaps onto the 45-degree "bolt carries everything" line */
    ctx.setLineDash([5, 4]); ctx.lineWidth = 2;
    ctx.beginPath(); ctx.moveTo(xSep, yFi - ph * 0.17); ctx.lineTo(ox + pw, oy - ph * 0.93); ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = '#3ddc84'; ctx.font = '600 11px "Segoe UI", sans-serif';
    ctx.fillText('slope C — preloaded', ox + 14, yFi - ph * 0.13);
    ctx.fillStyle = '#ff8a65';
    ctx.beginPath(); ctx.arc(xSep, yFi - ph * 0.17, 4, 0, Math.PI * 2); ctx.fill();
    ctx.strokeStyle = 'rgba(255,138,101,0.6)'; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(xSep, yFi - ph * 0.17 - 5); ctx.lineTo(xSep, yFi - ph * 0.30); ctx.stroke();
    ctx.textAlign = 'center';
    ctx.fillText('joint separates', xSep, yFi - ph * 0.34);
    ctx.textAlign = 'left';

    /* Un-preloaded bolt: 45-degree line from the origin */
    ctx.strokeStyle = '#ff5555'; ctx.lineWidth = 2.5;
    ctx.beginPath(); ctx.moveTo(ox, oy); ctx.lineTo(ox + pw * 0.80, oy - ph * 0.92); ctx.stroke();
    ctx.fillStyle = '#ff5555';
    ctx.fillText('slope 1 — no preload', ox + pw * 0.30, oy - ph * 0.22);

    /* The stress amplitude each one has to survive */
    ctx.font = '600 11px "Segoe UI", sans-serif';
    ctx.textAlign = 'left'; ctx.textBaseline = 'top';
    ctx.fillStyle = '#8fa3b0';
    ctx.fillText('For the same 0 → P cycle', 610, 110);
    ctx.fillStyle = '#3ddc84';
    ctx.fillText('preloaded:   σa = C·P / 2At', 610, 134);
    ctx.fillStyle = '#ff5555';
    ctx.fillText('no preload:  σa = P / 2At', 610, 156);
    ctx.fillStyle = '#dde3f0';
    ctx.fillText('At C = 0.25 the preloaded bolt', 610, 190);
    ctx.fillText('sees a quarter of the alternating', 610, 208);
    ctx.fillText('stress — and fatigue life scales', 610, 226);
    ctx.fillText('on σa, not on mean stress.', 610, 244);
    ctx.fillStyle = '#6b7a99';
    ctx.fillText('Se (rolled thread): 129 MPa for 8.8,', 610, 280);
    ctx.fillText('162 for 10.9, 190 for 12.9.', 610, 298);
    ctx.fillText('Cracks start at the first engaged', 610, 322);
    ctx.fillText('thread, beside the nut face.', 610, 340);
  }

  function drawStiffnessDiag() {
    ctx.font = '700 14px "Segoe UI", sans-serif';
    ctx.fillStyle = '#dde3f0'; ctx.textAlign = 'center';
    ctx.fillText('Joint Stiffness Model', W / 2, 35);

    /* Spring model diagram */
    var cx = W / 2, topY = 90;

    /* Bolt spring (left) */
    ctx.font = '600 11px "Segoe UI", sans-serif';
    ctx.fillStyle = '#42a5f5'; ctx.textAlign = 'center';
    ctx.fillText('Bolt (kb)', cx - 100, topY);

    ctx.strokeStyle = '#42a5f5'; ctx.lineWidth = 2;
    var springY = topY + 20;
    ctx.beginPath(); ctx.moveTo(cx - 100, springY); ctx.lineTo(cx - 100, springY + 15); ctx.stroke();
    for (var s = 0; s < 5; s++) {
      var sy = springY + 15 + s * 25;
      ctx.beginPath();
      ctx.moveTo(cx - 100, sy);
      ctx.lineTo(cx - 115, sy + 8);
      ctx.lineTo(cx - 85, sy + 17);
      ctx.lineTo(cx - 100, sy + 25);
      ctx.stroke();
    }
    ctx.beginPath(); ctx.moveTo(cx - 100, springY + 140); ctx.lineTo(cx - 100, springY + 160); ctx.stroke();

    /* Member spring (right) */
    ctx.fillStyle = '#f5c842';
    ctx.fillText('Members (km)', cx + 100, topY);

    ctx.strokeStyle = '#f5c842'; ctx.lineWidth = 2;
    ctx.beginPath(); ctx.moveTo(cx + 100, springY); ctx.lineTo(cx + 100, springY + 15); ctx.stroke();
    for (var s2 = 0; s2 < 5; s2++) {
      var sy2 = springY + 15 + s2 * 25;
      ctx.beginPath();
      ctx.moveTo(cx + 100, sy2);
      ctx.lineTo(cx + 85, sy2 + 8);
      ctx.lineTo(cx + 115, sy2 + 17);
      ctx.lineTo(cx + 100, sy2 + 25);
      ctx.stroke();
    }
    ctx.beginPath(); ctx.moveTo(cx + 100, springY + 140); ctx.lineTo(cx + 100, springY + 160); ctx.stroke();

    /* Connecting bars */
    ctx.strokeStyle = '#6b7a99'; ctx.lineWidth = 3;
    ctx.beginPath(); ctx.moveTo(cx - 110, springY); ctx.lineTo(cx + 110, springY); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(cx - 110, springY + 160); ctx.lineTo(cx + 110, springY + 160); ctx.stroke();

    /* Formula */
    ctx.font = '700 16px "Courier New", monospace';
    ctx.fillStyle = '#546e7a';
    ctx.fillText('C = kb / (kb + km)', cx, springY + 200);

    ctx.font = '600 11px "Segoe UI", sans-serif';
    ctx.fillStyle = '#6b7a99';
    ctx.fillText('Bolt load increase = C \u00D7 F_ext', cx, springY + 230);
    ctx.fillText('Lower C = better fatigue life', cx, springY + 255);
  }

  /* ================================================================
     RENDER
     ================================================================ */
  function render() {
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = '#0d1117';
    ctx.fillRect(0, 0, W, H);

    if (mode === 'simulate') {
      calculateAll();
      drawSimulate();
      updateReadouts();
      updateLearnPanels();
      updateCoach();
    } else if (mode === 'explore') {
      var c = CONCEPTS.filter(function (cc) { return cc.cat === selCat; });
      if (c[selConcept]) drawConceptDiagram(c[selConcept]);
    } else if (mode === 'practice') {
      drawPracticeCanvas();
    } else if (mode === 'quiz') {
      drawQuizCanvas();
    }
  }

