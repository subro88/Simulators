      ctx.fillStyle = 'rgba(61,220,132,0.2)';
      ctx.fillRect(cx - shankW / 2 - 10, midY - 4, shankW + 20, 8);

      /* Bearing stress zones */
      ctx.fillStyle = 'rgba(245,200,66,0.15)';
      ctx.fillRect(cx - shankW / 2 - 3, topPlateY, 6, p1h);
      ctx.fillRect(cx + shankW / 2 - 3, topPlateY, 6, p1h);
      ctx.fillRect(cx - shankW / 2 - 3, midY, 6, p2h);
      ctx.fillRect(cx + shankW / 2 - 3, midY, 6, p2h);
    }

    /* ── Force arrows ── */
    /* Preload arrows (bolt tension) */
    var arrowOffset = headW / 2 + 25;

    ctx.strokeStyle = '#42a5f5'; ctx.lineWidth = 2.5;
    /* Top preload arrow (pointing down into plate) */
    ctx.beginPath();
    ctx.moveTo(cx - arrowOffset, headY + headH / 2);
    ctx.lineTo(cx - arrowOffset, topPlateY + p1h / 2);
    ctx.stroke();
    ctx.fillStyle = '#42a5f5';
    ctx.beginPath();
    ctx.moveTo(cx - arrowOffset, topPlateY + p1h / 2 + 2);
    ctx.lineTo(cx - arrowOffset - 5, topPlateY + p1h / 2 - 8);
    ctx.lineTo(cx - arrowOffset + 5, topPlateY + p1h / 2 - 8);
    ctx.closePath(); ctx.fill();

    /* Bottom preload arrow (pointing up into plate) */
    ctx.strokeStyle = '#42a5f5'; ctx.lineWidth = 2.5;
    ctx.beginPath();
    ctx.moveTo(cx - arrowOffset, nutY + nutH / 2);
    ctx.lineTo(cx - arrowOffset, midY + p2h / 2);
    ctx.stroke();
    ctx.fillStyle = '#42a5f5';
    ctx.beginPath();
    ctx.moveTo(cx - arrowOffset, midY + p2h / 2 - 2);
    ctx.lineTo(cx - arrowOffset - 5, midY + p2h / 2 + 8);
    ctx.lineTo(cx - arrowOffset + 5, midY + p2h / 2 + 8);
    ctx.closePath(); ctx.fill();

    /* Preload label */
    var uF = U().force;
    ctx.font = '700 10px "Courier New", monospace';
    ctx.fillStyle = '#42a5f5';
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.fillText('Fi=' + cv(results.Fi, uF) + uF.u, cx - arrowOffset, cy);

    /* External load arrows */
    if (jointType === 'tension' || jointType === 'combined') {
      var extArrowX = cx + arrowOffset + 15;
      /* Downward tension arrow */
      ctx.strokeStyle = '#ff5555'; ctx.lineWidth = 2.5;
      ctx.beginPath();
      ctx.moveTo(extArrowX, headY - 20);
      ctx.lineTo(extArrowX, headY + 5);
      ctx.stroke();
      ctx.fillStyle = '#ff5555';
      ctx.beginPath();
      ctx.moveTo(extArrowX, headY + 7);
      ctx.lineTo(extArrowX - 5, headY - 3);
      ctx.lineTo(extArrowX + 5, headY - 3);
      ctx.closePath(); ctx.fill();

      /* Upward tension arrow */
      ctx.strokeStyle = '#ff5555'; ctx.lineWidth = 2.5;
      ctx.beginPath();
      ctx.moveTo(extArrowX, nutY + nutH + 20);
      ctx.lineTo(extArrowX, nutY + nutH - 5);
      ctx.stroke();
      ctx.fillStyle = '#ff5555';
      ctx.beginPath();
      ctx.moveTo(extArrowX, nutY + nutH - 7);
      ctx.lineTo(extArrowX - 5, nutY + nutH + 3);
      ctx.lineTo(extArrowX + 5, nutY + nutH + 3);
      ctx.closePath(); ctx.fill();

      ctx.font = '700 10px "Courier New", monospace';
      ctx.fillStyle = '#ff5555';
      ctx.textAlign = 'left';
      ctx.fillText('F=' + cv(extLoad, uF) + uF.u, extArrowX + 8, cy);
    }

    if (jointType === 'shear' || jointType === 'combined') {
      /* Horizontal shear arrows at interface */
      var shearY1 = topPlateY + p1h / 2;
      var shearY2 = midY + p2h / 2;
      var shearArrowX1 = plateX + plateW + 10;
      var shearArrowX2 = plateX - 10;

      /* Right arrow on top plate */
      ctx.strokeStyle = '#3ddc84'; ctx.lineWidth = 2.5;
      ctx.beginPath();
      ctx.moveTo(shearArrowX1, shearY1);
      ctx.lineTo(shearArrowX1 + 35, shearY1);
      ctx.stroke();
      ctx.fillStyle = '#3ddc84';
      ctx.beginPath();
      ctx.moveTo(shearArrowX1 + 37, shearY1);
      ctx.lineTo(shearArrowX1 + 27, shearY1 - 5);
      ctx.lineTo(shearArrowX1 + 27, shearY1 + 5);
      ctx.closePath(); ctx.fill();

      /* Left arrow on bottom plate */
      ctx.strokeStyle = '#3ddc84'; ctx.lineWidth = 2.5;
      ctx.beginPath();
      ctx.moveTo(shearArrowX2, shearY2);
      ctx.lineTo(shearArrowX2 - 35, shearY2);
      ctx.stroke();
      ctx.fillStyle = '#3ddc84';
      ctx.beginPath();
      ctx.moveTo(shearArrowX2 - 37, shearY2);
      ctx.lineTo(shearArrowX2 - 27, shearY2 - 5);
      ctx.lineTo(shearArrowX2 - 27, shearY2 + 5);
      ctx.closePath(); ctx.fill();

      ctx.font = '700 9px "Courier New", monospace';
      ctx.fillStyle = '#3ddc84';
      ctx.textAlign = 'center';
      ctx.fillText('Shear', shearArrowX1 + 20, shearY1 - 10);
    }

    /* ── Dimension lines ── */
    if (showDims) {
    var dimX = plateX + plateW + 55;

    /* Grip length */
    ctx.strokeStyle = '#6b7a99'; ctx.lineWidth = 1;
    ctx.setLineDash([3, 2]);
    ctx.beginPath();
