  function drawJointCrossSection(bolt, grade) {
    var cx = (JOINT_X0 + JOINT_X1) / 2;
    var cy = 220;

    /* Scale factors */
    var pScale = 2.8; /* pixels per mm for plates */
    var bScale = 3.5; /* pixels per mm for bolt diameter */

    var p1h = plate1 * pScale;
    var p2h = plate2 * pScale;
    var totalH = p1h + p2h;
    var boltDia = bolt.d * bScale;
    var headW = bolt.dw * bScale;
    var headH = bolt.head_h * bScale;
    var nutH = bolt.nut_h * bScale;
    var shankW = bolt.d * bScale * 0.85;

    var topPlateY = cy - totalH / 2;
    var midY = cy - totalH / 2 + p1h;
    var botPlateY = cy + totalH / 2;

    /* Plate widths */
    var plateW = 340;
    var plateX = cx - plateW / 2;

    /* ── Top plate ── */
    ctx.fillStyle = 'rgba(84,110,122,0.35)';
    ctx.fillRect(plateX, topPlateY, plateW, p1h);
    ctx.strokeStyle = '#546e7a'; ctx.lineWidth = 2;
    ctx.strokeRect(plateX, topPlateY, plateW, p1h);

    /* Hatching on top plate */
    ctx.save();
    ctx.beginPath();
    ctx.rect(plateX, topPlateY, plateW, p1h);
    ctx.clip();
    ctx.strokeStyle = 'rgba(84,110,122,0.15)'; ctx.lineWidth = 1;
    for (var i = -plateW; i < plateW + p1h; i += 10) {
      ctx.beginPath();
      ctx.moveTo(plateX + i, topPlateY);
      ctx.lineTo(plateX + i + p1h, topPlateY + p1h);
      ctx.stroke();
    }
    ctx.restore();

    /* ── Bottom plate ── */
    ctx.fillStyle = 'rgba(84,110,122,0.25)';
    ctx.fillRect(plateX, midY, plateW, p2h);
    ctx.strokeStyle = '#546e7a'; ctx.lineWidth = 2;
    ctx.strokeRect(plateX, midY, plateW, p2h);

    /* Hatching on bottom plate (opposite direction) */
    ctx.save();
    ctx.beginPath();
    ctx.rect(plateX, midY, plateW, p2h);
    ctx.clip();
    ctx.strokeStyle = 'rgba(84,110,122,0.12)'; ctx.lineWidth = 1;
    for (var j = -plateW; j < plateW + p2h; j += 10) {
      ctx.beginPath();
      ctx.moveTo(plateX + j, midY + p2h);
      ctx.lineTo(plateX + j + p2h, midY);
      ctx.stroke();
    }
    ctx.restore();

    /* Plate labels */
    ctx.font = '600 10px "Segoe UI", sans-serif';
    ctx.fillStyle = '#78909c'; ctx.textAlign = 'left'; ctx.textBaseline = 'middle';
    ctx.fillText('Plate 1: ' + plate1 + ' mm', plateX + 8, topPlateY + p1h / 2);
    ctx.fillText('Plate 2: ' + plate2 + ' mm', plateX + 8, midY + p2h / 2);

    /* ── Joint interface line ── */
    ctx.strokeStyle = '#ff5555'; ctx.lineWidth = 1;
    ctx.setLineDash([4, 3]);
    ctx.beginPath();
    ctx.moveTo(plateX, midY); ctx.lineTo(plateX + plateW, midY);
    ctx.stroke();
    ctx.setLineDash([]);

    /* ── Bolt hole ── */
    ctx.fillStyle = '#0d1117';
    ctx.fillRect(cx - shankW / 2 - 2, topPlateY - 2, shankW + 4, totalH + 4);

    /* ── Bolt head ── */
    var headY = topPlateY - headH - 4;
    ctx.fillStyle = '#546e7a';
    roundRect(ctx, cx - headW / 2, headY, headW, headH, 3);
    ctx.fill();
    ctx.strokeStyle = '#78909c'; ctx.lineWidth = 1.5;
    roundRect(ctx, cx - headW / 2, headY, headW, headH, 3);
