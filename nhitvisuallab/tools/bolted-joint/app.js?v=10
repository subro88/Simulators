        x.fillStyle = '#eceff1'; x.fillRect(pad.l, y, pw - 30, bh);
        x.fillStyle = b.c;       x.fillRect(pad.l, y, Math.max(wpx, 2), bh);
        x.fillStyle = '#263238'; x.font = '600 13px "Segoe UI", sans-serif';
