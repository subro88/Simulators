    if (result != null) html += '<div class="cs-result">&rarr; ' + result + '</div>';
    return html + '</div>';
  }
  function buildCalcSteps() {
    var b = BOLT_DATA[boltSize], g = gradeFor(boltGrade, BOLT_DATA[boltSize].d), l = Lunit();
    var P = extLoad / nBolts;
    var Tu = imperial ? '\\mathrm{lb\\!\\cdot\\!ft}' : '\\mathrm{N\\!\\cdot\\!m}';
    var Lu = imperial ? '\\mathrm{in}' : '\\mathrm{mm}';
    var n = 0, html = '';
    function step(t, f, c, r) { n++; return calcStep(n, t, f, c, r); }

    html += '<div class="cs-inputs"><span class="cs-badge">Given &mdash; Current State</span>';
    html += '<div class="cs-given"><span>Bolt: ' + boltLabel() + '</span><span>' + gradeLabel() + '</span><span>d = ' + b.d.toFixed(b.std === 'inch' ? 2 : 0) + ' mm</span><span>p = ' + b.p.toFixed(b.std === 'inch' ? 3 : 2) + ' mm</span>' +
            '<span>n = ' + nBolts + '</span><span>F = ' + extLoad + ' kN</span><span>L_g = ' + results.grip + ' mm</span>' +
            '<span>S_p = ' + g.Sp + ' MPa</span><span>K = ' + nutFactor.toFixed(2) + '</span><span>Joint: ' + jointType + '</span></div>';
    html += '<p class="cs-si-note">&#9432; Internal maths in SI; results follow the SI / Imperial toggle. Property class ' +
            boltGrade + ' is read from the ISO 898-1 row for d ' + (b.d > 16 ? '&gt;' : '&le;') + ' 16 mm.</p></div>';

    html += step('Tensile stress area',
      '\\[ A_t = \\tfrac{\\pi}{4}(d - 0.9382\\,p)^2 \\]',
      '\\(A_t = \\tfrac{\\pi}{4}(' + b.d + ' - 0.9382\\times' + b.p + ')^2\\)',
      '\\(\\mathbf{' + b.At + '\\;\\mathrm{mm^2}}\\)');

    html += step('Proof load',
      '\\[ F_p = A_t\\,S_p \\]',
      '\\(F_p = ' + b.At + '\\times' + g.Sp + '\\;\\mathrm{N}\\)',
      '\\(\\mathbf{' + fF(results.Fp) + '\\;' + l.F + '}\\)');

    if (driveMode === 'torque') {
      html += step('Preload from the applied torque',
        '\\[ T = K\\,d\\,F_i \\;\\Rightarrow\\; F_i = \\dfrac{T}{K\\,d} \\]',
        '\\(F_i = \\dfrac{' + torqueIn + '}{' + nutFactor.toFixed(2) + '\\times' + b.d + '}\\)',
        '\\(\\mathbf{' + fF(results.Fi) + '\\;' + l.F + '}\\) &mdash; ' + results.pct.toFixed(0) + '% of proof load');
    } else {
      html += step('Preload target (' + preloadPct + '% of proof)',
        '\\[ F_i = ' + (preloadPct / 100).toFixed(2) + '\\,A_t\\,S_p \\]',
        '\\(F_i = ' + (preloadPct / 100).toFixed(2) + '\\times' + b.At + '\\times' + g.Sp + '\\;\\mathrm{N}\\)',
        '\\(\\mathbf{' + fF(results.Fi) + '\\;' + l.F + '}\\)');
      html += step('Tightening torque',
        '\\[ T = K\\,d\\,F_i \\]',
        '\\(T = ' + nutFactor.toFixed(2) + '\\times' + b.d + '\\times' + results.Fi.toFixed(1) + '\\)',
        '\\(\\mathbf{' + cv(results.torque, U().torque) + '\\;' + Tu + '}\\) &mdash; the torque method holds this to about &plusmn;25%');
    }

    html += step('Joint stiffness &amp; load ratio',
      '\\[ k_b = \\dfrac{A_t E}{L_g},\\quad k_m = E\\,d\\,(0.78715)e^{0.62873\\,d/L_g},\\quad C = \\dfrac{k_b}{k_b+k_m} \\]',
      '\\(k_b = ' + results.kb.toFixed(0) + '\\;\\mathrm{kN/mm},\\; k_m = ' + results.km.toFixed(0) + '\\;\\mathrm{kN/mm}\\)',
