      var g = gradeFor(boltGrade, BOLT_DATA[boltSize].d);
      var shearCap = 0.577 * g.Sp * results.Ashear * nBolts * nPlanes / 1000;   /* kN */
      var bearCap  = g.Sy * BOLT_DATA[boltSize].d * Math.min(plate1, plate2) * nBolts / 1000;
      var bars = [
        { l: 'Applied load',      v: extLoad,        c: '#c62828' },
        { l: 'Slip resistance',   v: results.Fslip,  c: '#2e7d32' },
