        a: eta, u: '%', tol: 0.4,
        s: 'ηb = 3.6×10⁶ / (BSFC × LHV) = 3.6×10⁶ / (' + bsfc + ' × 44000) = ' + eta + '%\n(3.6×10⁶ converts kWh to kJ and kg to g.)' };
    },
    function () {
      var IP = rd(rr(30, 90), 1), em = rd(rr(0.75, 0.92), 2);
      return { q: 'An engine has an indicated power of ' + IP + ' kW and a mechanical efficiency of ' + em + '. What is the friction power?',
        a: rd(IP * (1 - em), 2), u: 'kW', tol: Math.max(0.1, IP * 0.015),
        s: 'Ẇb = ηmech·Ẇi = ' + em + ' × ' + IP + ' = ' + rd(IP * em, 2) + ' kW\nFriction power = Ẇi − Ẇb = ' + IP + ' − ' + rd(IP * em, 2) + ' = ' + rd(IP * (1 - em), 2) + ' kW' };
