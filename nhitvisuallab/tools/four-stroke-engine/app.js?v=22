  function switchMode(m) {
    st.mode = m;
    $('sim-panel').style.display      = (m === 'simulate') ? '' : 'none';
    $('explore-panel').style.display  = (m === 'explore')  ? '' : 'none';
    $('practice-panel').style.display = (m === 'practice') ? '' : 'none';
    $('quiz-panel').style.display     = (m === 'quiz')     ? '' : 'none';
    if (m === 'simulate') { resizeCanvas(); }
    else if (playing) togglePlay();
    if (m === 'explore')  buildExplore();
    if (m === 'practice') resetPractice();
    if (m === 'quiz')     startQuiz();
  }

  function wireLearnPanels() {
    var ex = $('learn-expand-all'), co = $('learn-collapse-all');
    var cards = Array.prototype.slice.call(document.querySelectorAll('.learn-card'));
    if (ex) ex.addEventListener('click', function () { cards.forEach(function (c) { c.open = true; }); });
    if (co) co.addEventListener('click', function () { cards.forEach(function (c) { c.open = false; }); });
  }

  function init() {
    /* Mode tabs */
    $('mode-tabs').addEventListener('click', function (e) {
      var b = e.target.closest ? e.target.closest('.pill') : null;
      if (!b || !this.contains(b)) return;
      document.querySelectorAll('#mode-tabs .pill').forEach(function (p) { p.classList.toggle('active', p === b); });
      switchMode(b.dataset.value);
    });
