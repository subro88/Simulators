    disp:  function () { return imp() ? { l: 'in³', k: 61.0237,     d: 1 } : { l: 'L',     k: 1,       d: 2 }; },
    press: function () { return imp() ? { l: 'psi',     k: 0.1450377,   d: 0 } : { l: 'kPa',   k: 1,       d: 0 }; },
    mep:   function () { return imp() ? { l: 'psi',     k: 0.1450377,   d: 0 } : { l: 'bar',   k: 0.01,    d: 2 }; },
    temp:  function () { return imp() ? { l: '°R', k: 1.8,         d: 0 } : { l: 'K',     k: 1,       d: 0 }; },
    pow:   function () { return imp() ? { l: 'hp',      k: 1.341022,    d: 1 } : { l: 'kW',    k: 1,       d: 1 }; },
    torq:  function () { return imp() ? { l: 'lbf·ft', k: 0.7375621, d: 1 } : { l: 'N·m', k: 1, d: 1 }; },
    engy:  function () { return imp() ? { l: 'BTU',     k: 0.9478171,   d: 3 } : { l: 'kJ',    k: 1,       d: 3 }; },
    spec:  function () { return imp() ? { l: 'BTU/lbm', k: 0.4299226,   d: 0 } : { l: 'kJ/kg', k: 1,       d: 0 }; },
    sfc:   function () { return imp() ? { l: 'lb/hp·h', k: 0.00164399, d: 3 } : { l: 'g/kWh', k: 1,  d: 0 }; },
    mass:  function () { return imp() ? { l: 'lbm',     k: 0.00220462,  d: 5 } : { l: 'g',     k: 1,       d: 3 }; }
  };
