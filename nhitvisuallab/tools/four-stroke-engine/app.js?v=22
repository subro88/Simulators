  function bar(label, frac, color) {
    if (!isFinite(frac)) {
      return '<div class="perf-row"><div class="perf-lbl">' + label +
             '<span class="perf-val">\u2014</span></div>' +
             '<div class="perf-track"></div></div>';
    }
    var pct = Math.max(0, Math.min(1, frac)) * 100;
    return '<div class="perf-row"><div class="perf-lbl">' + label +
           '<span class="perf-val">' + pct.toFixed(1) + '%</span></div>' +
           '<div class="perf-track"><div class="perf-fill" style="width:' + pct.toFixed(1) +
           '%;background:' + color + '"></div></div></div>';
  }

  /* ═══════════════════════════════════════════════════════════════
     SHOW CALCULATIONS MODAL — Pattern 2 + Pattern 5
     ═══════════════════════════════════════════════════════════════ */
  function calcStep(num, title, formula, calculation, result) {
    var h = '<div class="cs-step"><div class="cs-step-hd">';
    h += '<span class="cs-num">Step ' + num + '</span><span class="cs-title">' + title + '</span></div>';
    if (formula)     h += '<div class="cs-formula">' + formula + '</div>';
    if (calculation) h += '<div class="cs-calc">' + calculation + '</div>';
    if (result != null) h += '<div class="cs-result">\u2192 <strong>' + result + '</strong></div>';
    return h + '</div>';
  }

  function buildCalcSteps() {
    var c = computeCycle();
    var h = '';
    h += '<div class="cs-inputs"><span class="cs-badge">Given</span><div class="cs-given">' +
         '<span>B = ' + n(st.bore, 1) + ' mm</span><span>L = ' + n(st.strokeLen, 1) + ' mm</span>' +
         '<span>n = ' + st.nCyl + '</span><span>r = ' + n(st.cr, 2) + '</span>' +
         '<span>N = ' + st.rpm + ' rpm</span><span>p_man = ' + n(st.pMan, 1) + ' kPa</span>' +
         '<span>q_in = ' + n(st.qin, 0) + ' kJ/kg</span><span>AFR = ' + n(st.afr, 1) + '</span>' +
         '<span>η_mech = ' + n(st.etaMech, 2) + '</span></div>' +
         '<p class="cs-si-note">Cold air standard: γ = 1.4, c<sub>v</sub> = 0.718, c<sub>p</sub> = 1.005 kJ/kg·K, R = 0.287 kJ/kg·K. ' +
         'All working is in SI; any Imperial display is converted at the end.</p></div>';

    h += calcStep(1, 'Swept and clearance volume',
      '\\[ V_s = \\dfrac{\\pi}{4}B^2 L \\qquad V_c = \\dfrac{V_s}{r-1} \\]',
      '\\( V_s = \\dfrac{\\pi}{4}(' + n(st.bore / 1000, 4) + ')^2(' + n(st.strokeLen / 1000, 4) + ') = ' +
      n(c.g.Vs * 1e6, 2) + '\\;\\mathrm{cm^3} \\)<br>\\( V_c = \\dfrac{' + n(c.g.Vs * 1e6, 2) + '}{' +
      n(c.r - 1, 2) + '} = ' + n(c.g.Vc * 1e6, 2) + '\\;\\mathrm{cm^3} \\)',
      n(c.g.Vs * 1e6, 1) + ' cm³ swept per cylinder, ' + n(c.g.dispL, 2) + ' L total');

    h += calcStep(2, 'Trapped charge at state 1 (BDC)',
      '\\[ m = \\dfrac{p_1 V_1}{R T_1}, \\quad T_1 \\text{ from mixing fresh charge with residual gas} \\]',
      '\\( m = \\dfrac{' + n(c.P1, 1) + ' \\times ' + (c.V1).toExponential(3).replace('e', ' \\times 10^{') + '}}{0.287 \\times ' +
      n(c.T1, 1) + '} = ' + (c.m).toExponential(3).replace('e', ' \\times 10^{') + '}\\;\\mathrm{kg} \\)',
      n(c.m * 1000, 4) + ' g, with ' + n(c.fRes * 100, 1) + '% residual gas, T₁ = ' + n(c.T1, 1) + ' K');

    h += calcStep(3, 'Isentropic compression 1→2',
      '\\[ T_2 = T_1 r^{\\gamma-1} \\qquad p_2 = p_1 r^{\\gamma} \\]',
      '\\( T_2 = ' + n(c.T1, 1) + ' \\times ' + n(c.r, 2) + '^{0.4} = ' + n(c.T2, 1) + '\\;\\mathrm{K} \\)<br>' +
      '\\( p_2 = ' + n(c.P1, 1) + ' \\times ' + n(c.r, 2) + '^{1.4} = ' + n(c.P2, 0) + '\\;\\mathrm{kPa} \\)',
      'T₂ = ' + n(c.T2, 0) + ' K, p₂ = ' + n(c.P2 / 100, 1) + ' bar');

    if (c.otto) {
      h += calcStep(4, 'Constant-volume heat addition 2→3',
        '\\[ q_{in} = c_v (T_3 - T_2) \\;\\Rightarrow\\; T_3 = T_2 + \\dfrac{q_{in}}{c_v}, \\quad \\dfrac{p_3}{p_2} = \\dfrac{T_3}{T_2} \\]',
        '\\( T_3 = ' + n(c.T2, 1) + ' + \\dfrac{' + n(c.qin, 0) + '}{0.718} = ' + n(c.T3, 1) + '\\;\\mathrm{K} \\)<br>' +
        '\\( p_3 = ' + n(c.P2, 0) + ' \\times \\dfrac{' + n(c.T3, 0) + '}{' + n(c.T2, 0) + '} = ' + n(c.P3, 0) + '\\;\\mathrm{kPa} \\)',
        'T₃ = ' + n(c.T3, 0) + ' K, p₃ = ' + n(c.P3 / 100, 1) + ' bar');
      h += calcStep(5, 'Isentropic expansion 3→4',
        '\\[ T_4 = \\dfrac{T_3}{r^{\\gamma-1}} \\qquad p_4 = \\dfrac{p_3}{r^{\\gamma}} \\]',
        '\\( T_4 = \\dfrac{' + n(c.T3, 0) + '}{' + n(c.r, 2) + '^{0.4}} = ' + n(c.T4, 1) + '\\;\\mathrm{K} \\)',
        'T₄ = ' + n(c.T4, 0) + ' K, p₄ = ' + n(c.P4 / 100, 2) + ' bar');
    } else {
      h += calcStep(4, 'Constant-pressure heat addition 2→3',
        '\\[ q_{in} = c_p (T_3 - T_2) \\;\\Rightarrow\\; T_3 = T_2 + \\dfrac{q_{in}}{c_p}, \\quad \\rho = \\dfrac{V_3}{V_2} = \\dfrac{T_3}{T_2} \\]',
        '\\( T_3 = ' + n(c.T2, 1) + ' + \\dfrac{' + n(c.qin, 0) + '}{1.005} = ' + n(c.T3, 1) + '\\;\\mathrm{K} \\)<br>' +
        '\\( \\rho = \\dfrac{' + n(c.T3, 0) + '}{' + n(c.T2, 0) + '} = ' + n(c.rho, 3) + ' \\)',
        'T₃ = ' + n(c.T3, 0) + ' K, cutoff ratio ρ = ' + n(c.rho, 3) + ', p₃ = p₂ = ' + n(c.P3 / 100, 1) + ' bar');
      h += calcStep(5, 'Isentropic expansion 3→4',
        '\\[ \\dfrac{V_4}{V_3} = \\dfrac{r}{\\rho} \\qquad T_4 = T_3\\left(\\dfrac{\\rho}{r}\\right)^{\\gamma-1} \\]',
        '\\( \\dfrac{V_4}{V_3} = \\dfrac{' + n(c.r, 2) + '}{' + n(c.rho, 3) + '} = ' + n(c.r / c.rho, 3) + ' \\)<br>' +
        '\\( T_4 = ' + n(c.T3, 0) + ' \\times ' + n(c.r / c.rho, 3) + '^{-0.4} = ' + n(c.T4, 1) + '\\;\\mathrm{K} \\)',
        'T₄ = ' + n(c.T4, 0) + ' K, p₄ = ' + n(c.P4 / 100, 2) + ' bar');
    }

    h += calcStep(6, 'Heat rejected and net work',
      '\\[ q_{out} = c_v(T_4 - T_1) \\qquad w_{net} = q_{in} - q_{out} \\qquad \\eta_{th} = \\dfrac{w_{net}}{q_{in}} \\]',
      '\\( q_{out} = 0.718(' + n(c.T4, 1) + ' - ' + n(c.T1, 1) + ') = ' + n(c.qout, 1) + '\\;\\mathrm{kJ/kg} \\)<br>' +
      '\\( w_{net} = ' + n(c.qin, 0) + ' - ' + n(c.qout, 1) + ' = ' + n(c.wNet, 1) + '\\;\\mathrm{kJ/kg} \\)<br>' +
      '\\( \\eta_{th} = \\dfrac{' + n(c.wNet, 1) + '}{' + n(c.qin, 0) + '} = ' + n(c.etaTh, 4) + ' \\)',
      'η_th = ' + n(c.etaTh * 100, 2) + '%  (closed form ' +
      n((c.otto ? ottoEta(c.r) : dieselEta(c.r, c.rho)) * 100, 2) + '% ✓)');

    h += calcStep(7, 'Mean effective pressure',
      '\\[ \\mathrm{IMEP}_{gross} = \\dfrac{m\\,w_{net}}{V_s} \\qquad \\mathrm{PMEP} = p_{exh} - p_{man} \\]',
      '\\( \\mathrm{IMEP}_{gross} = \\dfrac{' + (c.m).toExponential(3).replace('e', ' \\times 10^{') + '} \\times ' +
      n(c.wNet, 1) + '}{' + (c.g.Vs).toExponential(3).replace('e', ' \\times 10^{') + '}} = ' + n(c.imepG, 0) + '\\;\\mathrm{kPa} \\)<br>' +
      '\\( \\mathrm{IMEP}_{net} = ' + n(c.imepG, 0) + ' - (' + n(c.Pexh, 0) + ' - ' + n(c.P1, 0) + ') = ' + n(c.imepN, 0) + '\\;\\mathrm{kPa} \\)',
      'IMEP = ' + n(c.imepN / 100, 2) + ' bar, BMEP = ' + n(c.bmep / 100, 2) + ' bar');

    h += calcStep(8, 'Power and torque',
      '\\[ \\dot{W}_i = \\mathrm{IMEP}\\cdot V_s\\cdot n_{cyl}\\cdot\\dfrac{N}{120} \\qquad \\dot{W}_b = \\eta_{mech}\\dot{W}_i \\qquad T = \\dfrac{60\\,\\dot{W}_b}{2\\pi N} \\]',
      '\\( \\dot{W}_i = ' + n(c.imepN, 0) + ' \\times ' + (c.g.Vs).toExponential(3).replace('e', ' \\times 10^{') + '} \\times ' +
      st.nCyl + ' \\times \\dfrac{' + st.rpm + '}{120} = ' + n(c.IP, 2) + '\\;\\mathrm{kW} \\)<br>' +
      '\\( \\dot{W}_b = ' + n(st.etaMech, 2) + ' \\times ' + n(c.IP, 2) + ' = ' + n(c.BP, 2) + '\\;\\mathrm{kW} \\)<br>' +
      '\\( T = \\dfrac{60 \\times ' + n(c.BP * 1000, 0) + '}{2\\pi \\times ' + st.rpm + '} = ' + n(c.torque, 1) + '\\;\\mathrm{N\\,m} \\)',
      'Brake power ' + fmtU(c.BP, UN.pow) + ', torque ' + fmtU(c.torque, UN.torq));

    h += calcStep(9, 'Fuel flow, BSFC and brake thermal efficiency',
      '\\[ \\dot{m}_f = \\dfrac{m_{fresh}}{\\mathrm{AFR}}\\,n_{cyl}\\dfrac{N}{120} \\qquad \\mathrm{BSFC} = \\dfrac{\\dot{m}_f}{\\dot{W}_b} \\qquad \\eta_{b} = \\dfrac{\\dot{W}_b}{\\dot{m}_f\\,\\mathrm{LHV}} \\]',
      '\\( \\dot{m}_f = ' + (c.mdotF).toExponential(3).replace('e', ' \\times 10^{') + '}\\;\\mathrm{kg/s} = ' +
      n(c.mdotF * 3600, 3) + '\\;\\mathrm{kg/h} \\)<br>' +
      '\\( \\mathrm{BSFC} = ' + n(c.bsfc, 0) + '\\;\\mathrm{g/kWh} \\)<br>' +
      '\\( \\eta_b = \\dfrac{' + n(c.BP, 2) + '}{' + n(c.fuelPow, 2) + '} = ' + n(c.etaBrake, 4) + ' \\)',
      'BSFC ' + fmtU(c.bsfc, UN.sfc) + ', brake thermal efficiency ' + n(c.etaBrake * 100, 1) + '%');
    return h;
  }

  function openCalc() {
    var body = $('calc-modal-body');
    if (body) body.innerHTML = buildCalcSteps();
