    sedan:  { name: '2.0 L petrol sedan', fuel: 'petrol', bore: 86, strokeLen: 86, nCyl: 4,
              cr: 10.5, rpm: 2500, pMan: 101.325, qin: 1350, afr: 14.7, etaMech: 0.86 },
    turbo:  { name: '1.4 L turbo petrol', fuel: 'petrol', bore: 74.5, strokeLen: 80, nCyl: 4,
              cr: 9.8, rpm: 3000, pMan: 175, qin: 1250, afr: 13.5, etaMech: 0.86 },
    tdi:    { name: '2.0 L TDI diesel', fuel: 'diesel', bore: 81, strokeLen: 95.5, nCyl: 4,
