  /* ═══════════════════════════════════════════════════════════════
     CONTROL WIRING
     Every numeric parameter is a slider plus a companion text input
     (anti-pattern 8). The slider always carries the SI value; the text
     input shows and accepts the current display units.
     ═══════════════════════════════════════════════════════════════ */
  var PARAMS = {
    rpm:       { min: 400,  max: 8000, step: 50,   dec: 0, unit: null,      lbl: 'rpm' },
    cr:        { min: 6,    max: 24,   step: 0.1,  dec: 1, unit: null,      lbl: ': 1' },
    qin:       { min: 200,  max: 2000, step: 10,   dec: 0, unit: UN.spec },
    pMan:      { min: 30,   max: 320,  step: 1,    dec: 0, unit: UN.press },
    bore:      { min: 40,   max: 160,  step: 0.5,  dec: 1, unit: UN.len },
    strokeLen: { min: 40,   max: 190,  step: 0.5,  dec: 1, unit: UN.len },
    nCyl:      { min: 1,    max: 12,   step: 1,    dec: 0, unit: null,      lbl: 'cyl' },
    rodRatio:  { min: 2.8,  max: 5,    step: 0.05, dec: 2, unit: null,      lbl: 'L/r' },
    afr:       { min: 10,   max: 60,   step: 0.1,  dec: 1, unit: null,      lbl: ': 1' },
    etaMech:   { min: 0.55, max: 0.98, step: 0.01, dec: 2, unit: null,      lbl: '' },
    pExh:      { min: 100,  max: 260,  step: 1,    dec: 0, unit: UN.press },
    tIn:       { min: 250,  max: 400,  step: 1,    dec: 0, unit: UN.temp },
    ivo:       { min: 0,    max: 45,   step: 1,    dec: 0, unit: null,      lbl: '° BTDC' },
    ivc:       { min: 10,   max: 90,   step: 1,    dec: 0, unit: null,      lbl: '° ABDC' },
    evo:       { min: 10,   max: 90,   step: 1,    dec: 0, unit: null,      lbl: '° BBDC' },
    evc:       { min: 0,    max: 45,   step: 1,    dec: 0, unit: null,      lbl: '° ATDC' },
    animSpeed: { min: 0.05, max: 3,    step: 0.05, dec: 2, unit: null,      lbl: '×' }
  };

  function paramDisplay(key) {
    var p = PARAMS[key], v = st[key];
    if (!p.unit) return { v: v, d: p.dec, l: p.lbl == null ? '' : p.lbl };
    var u = p.unit();
    /* Small lengths need extra decimals in inches or the round trip
       silently loses tenths of a millimetre. */
    var d = u.d;
    if (p.unit === UN.len && imp()) d = 3;
    return { v: v * u.k, d: d, l: u.l };
  }
  function paramToSI(key, shown) {
    var p = PARAMS[key];
    if (!p.unit) return shown;
    return shown / p.unit().k;
  }

  function syncParam(key) {
    var sl = $('sl-' + key), inp = $('in-' + key), un = $('un-' + key);
    var d = paramDisplay(key);
    if (sl) sl.value = st[key];
    /* Never overwrite an input the user is typing into (anti-pattern 2). */
    if (inp && document.activeElement !== inp) inp.value = d.v.toFixed(d.d);
    if (un) un.textContent = d.l;
  }
  function syncAllParams() { for (var k in PARAMS) syncParam(k); }

  function setParam(key, siValue, opts) {
    var p = PARAMS[key];
    var v = parseFloat(siValue);
    if (!isFinite(v)) { syncParam(key); return; }
    v = Math.max(p.min, Math.min(p.max, v));
    if (key === 'nCyl') v = Math.round(v);
    /* The compression-ratio range is fuel-dependent; keep the slider
       attributes, the text input and the stored value as one range
       instead of three copies that can disagree. */
    if (key === 'cr') {
      var lim = crLimits();
      v = Math.max(lim[0], Math.min(lim[1], v));
    }
    st[key] = v;
    if (!opts || !opts.quiet) { afterChange(); }
    else syncParam(key);
  }

  function crLimits() { return st.fuel === 'diesel' ? [12, 24] : [6, 14]; }
  function applyCRRange() {
    var lim = crLimits(), sl = $('sl-cr');
    if (sl) { sl.min = lim[0]; sl.max = lim[1]; }
    if (st.cr < lim[0]) st.cr = lim[0];
    if (st.cr > lim[1]) st.cr = lim[1];
    var hint = $('cr-range-hint');
    if (hint) hint.textContent = st.fuel === 'diesel' ? '12 – 24 (compression ignition)' : '6 – 14 (knock limit)';
  }

  /* The unit system and the cycle live in pill buttons, which
     shared/share-params.js cannot serialise. Mirror them into the hidden
     inputs so a shared link carries them, and so the numeric boxes — which
     hold display-unit values — are read back in the system they were
     written in. */
  function syncShareCarriers() {
    var u = $('share-units'); if (u) u.value = st.units;
    var f = $('share-fuel');  if (f) f.value = st.fuel;
  }

  function afterChange() {
    _cycleCache = null;
    syncShareCarriers();
    syncAllParams();
    updatePresetSelect();
    updateReadouts();
    if (!playing && !stepping) draw();
  }

  function nudge(key, dir) {
    var p = PARAMS[key];
    var v = st[key] + dir * p.step;
    v = Math.round(v / p.step) * p.step;
    /* Kill the binary residue Math.round leaves on values like 0.1 steps. */
    v = parseFloat(v.toFixed(6));
    setParam(key, v);
  }

  function wireParams() {
    document.querySelectorAll('.stepper-btn').forEach(function (b) {
      b.addEventListener('click', function () {
        nudge(b.dataset.param, parseFloat(b.dataset.dir));
      });
    });
    Object.keys(PARAMS).forEach(function (key) {
      var p = PARAMS[key];
      var sl = $('sl-' + key), inp = $('in-' + key);
      if (sl) {
        sl.min = p.min; sl.max = p.max; sl.step = p.step;
        sl.addEventListener('input', function () { setParam(key, this.value); });
      }
      if (inp) {
        var commit = function () { setParam(key, paramToSI(key, parseFloat(inp.value))); };
        inp.addEventListener('change', commit);
        inp.addEventListener('blur', commit);
        inp.addEventListener('keydown', function (e) { if (e.key === 'Enter') { commit(); inp.blur(); } });
      }
    });
  }

  /* ── Presets ── */
  function applyPreset(id) {
    var p = PRESETS[id];
    if (!p) return;
    for (var k in p) if (k !== 'name') st[k] = p[k];
    st.preset = id;
    applyFuelUI();
    applyCRRange();
    afterChange();
  }
  function updatePresetSelect() {
    /* Mark the dropdown as Custom the moment any preset field is edited. */
    var match = '';
    for (var id in PRESETS) {
      var p = PRESETS[id], same = true;
      for (var k in p) {
        if (k === 'name') continue;
        if (typeof p[k] === 'number' ? Math.abs(p[k] - st[k]) > 1e-9 : p[k] !== st[k]) { same = false; break; }
      }
      if (same) { match = id; break; }
    }
    st.preset = match || 'custom';
    var sel = $('preset-select');
    if (sel && sel.value !== st.preset) sel.value = st.preset;
  }

  function applyFuelUI() {
    document.querySelectorAll('#fuel-tabs .pill').forEach(function (b) {
      b.classList.toggle('active', b.dataset.value === st.fuel);
    });
    var qLbl = $('qin-label');
    if (qLbl) qLbl.textContent = st.fuel === 'petrol'
      ? 'Heat input qᵢₙ (constant volume)' : 'Heat input qᵢₙ (constant pressure)';
    var lm = $('load-mode-note');
    if (lm) lm.innerHTML = st.fuel === 'petrol'
      ? 'Petrol engines are <strong>quantity governed</strong>: the throttle sets manifold pressure, so load changes the mass of charge.'
      : 'Diesels are <strong>quality governed</strong>: there is no throttle, so load changes q<sub>in</sub> and therefore the cutoff ratio.';
  }

  function setFuel(f) {
    if (st.fuel === f) return;
    st.fuel = f;
    /* Air-fuel ratio and heat input are cycle-specific: petrol runs near
       stoichiometric and is throttled, a diesel runs lean and is governed
       on fuel quantity. Carrying the petrol values across would make the
       first diesel the user sees a nonsense one. */
    st.afr = (f === 'petrol') ? 14.7 : 22;
    st.qin = (f === 'petrol') ? 1250 : 1000;
    applyFuelUI();
    applyCRRange();
    afterChange();
  }

  /* ── Display toggles ── */
  function syncToggles() {
    [['chk-particles', 'showParticles'], ['chk-equation', 'showEquation'],
     ['chk-grid', 'showGrid'], ['chk-labels', 'showLabels'],
     ['chk-pumping', 'showPumping']].forEach(function (t) {
      var e = $(t[0]); if (e) e.checked = !!st[t[1]];
    });
  }
  function wireToggles() {
    [['chk-particles', 'showParticles'], ['chk-equation', 'showEquation'],
     ['chk-grid', 'showGrid'], ['chk-labels', 'showLabels'],
     ['chk-pumping', 'showPumping']].forEach(function (t) {
      var e = $(t[0]);
      if (e) e.addEventListener('change', function () { st[t[1]] = e.checked; draw(); });
    });
    var rst = $('cvt-reset');
    if (rst) rst.addEventListener('click', function () {
      st.showParticles = st.showEquation = st.showGrid = st.showLabels = st.showPumping = true;
      syncToggles(); draw();
    });
  }

  function resetAll() {
    var keep = st.mode;
    for (var k in DEFAULTS) st[k] = DEFAULTS[k];
    st.mode = keep;
    crankAngle = 0;
    particles = [];
    if (playing) togglePlay();
    stepping = false;
    applyFuelUI(); applyCRRange(); syncToggles();
    document.querySelectorAll('#units-tabs .pill').forEach(function (b) {
      b.classList.toggle('active', b.dataset.value === st.units);
    });
    document.querySelectorAll('#pane-tabs .pt-pill').forEach(function (b) {
      b.classList.toggle('active', b.dataset.pane === st.pane);
    });
    _cache = { eq: '', tbl: '', perf: '', coach: '' };
    afterChange();
  }

  /* ═══════════════════════════════════════════════════════════════
     EXPLORE MODE
     ═══════════════════════════════════════════════════════════════ */
  var CONCEPTS = [
    { cat: 'fundamentals', name: 'The Four Strokes',
      body: 'Intake, compression, power and exhaust take <strong>720° of crankshaft rotation</strong> — two full revolutions — for one power stroke. The camshaft therefore turns at half crank speed, which is why the valve timing diagram is drawn on a single circle while the piston completes two.' },
    { cat: 'fundamentals', name: 'TDC, BDC and Swept Volume',
      body: 'Top dead centre is the piston’s highest point, bottom dead centre its lowest. The volume between them is the <strong>swept volume</strong> \\(V_s = \\tfrac{\\pi}{4}B^2L\\); what remains above TDC is the <strong>clearance volume</strong> \\(V_c\\). Engine displacement is \\(V_s\\) times the number of cylinders.' },
    { cat: 'fundamentals', name: 'Compression Ratio',
      body: '\\(r = (V_s+V_c)/V_c\\). It is a ratio of volumes, not of pressures. Raising it raises efficiency but also raises the temperature at the end of compression — which is exactly what limits petrol engines (knock) and enables diesels (auto-ignition).' },
    { cat: 'fundamentals', name: 'Slider-Crank Motion',
      body: 'The piston does not move sinusoidally. With a finite connecting rod of length \\(L\\) and crank radius \\(R\\), displacement is \\(x = R(1-\\cos\\theta) + L\\left(1-\\sqrt{1-(R\\sin\\theta/L)^2}\\right)\\). At 90° crank the piston has already travelled about 57% of its stroke, not 50%. This simulator uses that exact expression for both the drawing and the volume.' },
    { cat: 'fundamentals', name: 'Why Four Strokes and Not Two',
      body: 'A four-stroke engine dedicates a whole revolution to gas exchange, so it scavenges cleanly and can use a proper lubrication system. It pays with half the firing frequency: at the same speed and displacement a two-stroke fires twice as often, which is why two-strokes have a better power-to-weight ratio and worse emissions.' },

    { cat: 'cycles', name: 'Otto Cycle — Constant Volume',
      body: 'Spark ignition burns a premixed charge in 2–3 ms while the piston is near TDC, so the volume barely changes. Idealised as constant-volume heat addition: \\(q_{in}=c_v(T_3-T_2)\\), and \\[\\eta_{th}=1-\\frac{1}{r^{\\gamma-1}}\\] — a function of compression ratio alone.' },
    { cat: 'cycles', name: 'Diesel Cycle — Constant Pressure',
      body: 'Fuel is injected into air already above its auto-ignition temperature, and injection lasts long enough that the piston is descending while heat is still being added. Idealised as constant-pressure heat addition: \\(q_{in}=c_p(T_3-T_2)\\), \\(\\rho=V_3/V_2=T_3/T_2\\), and \\[\\eta_{th}=1-\\frac{1}{r^{\\gamma-1}}\\left[\\frac{\\rho^\\gamma-1}{\\gamma(\\rho-1)}\\right]\\]' },
    { cat: 'cycles', name: 'The Cutoff Ratio Penalty',
      body: 'The bracketed term in the Diesel efficiency is always greater than 1 for \\(\\rho>1\\), so <strong>at the same compression ratio Diesel is always less efficient than Otto</strong>. Diesel engines win in practice only because they can run \\(r=16\\)–22 where a petrol engine would knock apart at 12.' },
    { cat: 'cycles', name: 'Air-Standard Assumptions',
      body: 'The working fluid is air behaving as an ideal gas with constant specific heats; combustion is replaced by heat transfer from outside; the exhaust and intake strokes are replaced by heat rejection at constant volume; every process is internally reversible. Each assumption is generous, which is why the air-standard efficiency roughly doubles the real one.' },
    { cat: 'cycles', name: 'Dual (Limited-Pressure) Cycle',
      body: 'Real compression-ignition engines are neither Otto nor Diesel: some fuel burns almost instantly at TDC after the ignition delay, and the rest burns as it is injected. The dual cycle adds heat first at constant volume, then at constant pressure, and models modern high-speed diesels far better than the pure Diesel cycle.' },
    { cat: 'cycles', name: 'Atkinson and Miller Cycles',
      body: 'Close the intake valve late and part of the charge is pushed back into the manifold: the <em>effective</em> compression ratio drops below the geometric one while the expansion ratio stays high. Expanding further than you compressed extracts more work from the same heat — the basis of most hybrid petrol engines.' },

    { cat: 'components', name: 'Piston, Rings and Rod',
      body: 'The piston transmits gas pressure through the gudgeon pin to the connecting rod. Three rings: two compression rings seal the combustion gases, the lower oil-control ring scrapes the bore. Ring blow-by is one reason real cylinders never reach the ideal compression pressure.' },
    { cat: 'components', name: 'Crankshaft and Counterweights',
      body: 'The crank converts reciprocating motion to rotation. Counterweights balance the rotating mass of the crankpin and big end; the reciprocating mass of piston and rod produces first- and second-order shaking forces that determine why some cylinder counts are inherently smoother than others.' },
    { cat: 'components', name: 'Valves and Camshaft',
      body: 'Poppet valves seal on a conical seat, so seating pressure rises with cylinder pressure. The cam lobe sets lift and duration. Because one cycle takes two crank revolutions, the camshaft is geared 2:1 to the crank — an error of one tooth on the cam belt retards every valve event by several degrees.' },
    { cat: 'components', name: 'Spark Plug vs Injector',
      body: 'A petrol engine ignites a homogeneous charge with a spark, typically 10–30° before TDC so that peak pressure arrives just after TDC. A diesel injects fuel at 300–2500 bar directly into hot air; ignition delay, not spark timing, sets the start of combustion.' },
    { cat: 'components', name: 'Flywheel',
      body: 'Only one stroke in four produces work, so the crankshaft would speed up and slow down violently within each cycle. The flywheel stores kinetic energy \\(\\tfrac{1}{2}I\\omega^2\\) during the power stroke and returns it during the other three. Fewer cylinders need a heavier flywheel.' },

    { cat: 'performance', name: 'Mean Effective Pressure',
      body: 'MEP is the constant pressure which, acting on the piston through one stroke, would do the same work as the whole cycle: \\[\\mathrm{MEP}=\\frac{W_{net}}{V_s}\\] It is displacement-independent, so it compares a 125 cc single with a 6.7 L six directly. Naturally aspirated petrol reaches 10–11 bar BMEP; turbo diesels exceed 20 bar.' },
    { cat: 'performance', name: 'Indicated, Friction and Brake Power',
      body: 'Indicated power is what the gas does on the piston; brake power is what leaves the crankshaft. The difference is friction and the work of driving oil pump, water pump and valvetrain. \\(\\eta_{mech}=\\dot W_b/\\dot W_i\\) is typically 0.75–0.90, and it falls toward zero at idle because friction is nearly independent of load.' },
    { cat: 'performance', name: 'Power from MEP',
      body: 'For a four-stroke engine \\[\\dot W = \\mathrm{MEP}\\cdot V_s \\cdot n_{cyl}\\cdot \\frac{N}{120}\\] The 120 (rather than 60) is the four-stroke penalty: one power stroke per two revolutions. Torque follows as \\(T = 60\\dot W/(2\\pi N)\\).' },
    { cat: 'performance', name: 'Volumetric Efficiency',
      body: 'The ratio of the fresh charge actually trapped to the mass that would fill the swept volume at manifold conditions. It peaks near 0.85–0.95 for a naturally aspirated engine at the speed its intake is tuned for, and it — not efficiency — is what sets the shape of the torque curve.' },
    { cat: 'performance', name: 'BSFC and Brake Thermal Efficiency',
      body: 'Brake specific fuel consumption is fuel flow per unit brake power, in g/kWh. It is the inverse of brake thermal efficiency: \\(\\eta_b = 3.6\\times10^6/(\\mathrm{BSFC}\\cdot \\mathrm{LHV})\\). A good petrol engine reaches 250 g/kWh, a large marine diesel 160 g/kWh — over 50% thermal efficiency.' },
    { cat: 'performance', name: 'Pumping Work',
      body: 'Below wide-open throttle a petrol engine draws air past a nearly closed plate, so the intake stroke happens at 30–50 kPa while the exhaust stroke happens above atmospheric. That negative loop at the bottom of the P–V diagram is pumping loss, and it is the single biggest reason petrol engines are inefficient in traffic.' },
    { cat: 'performance', name: 'Where the Fuel Energy Goes',
      body: 'Roughly: 25–35% to brake work, 25–30% out of the exhaust pipe as enthalpy, 25–30% into the coolant, and the rest to friction, radiation and incomplete combustion. Turbocharging recovers some exhaust energy; that is why a turbo raises both power and efficiency.' }
  ];

  function buildExplore() {
    var cat = document.querySelector('#explore-tabs .pill.active');
    cat = cat ? cat.dataset.cat : 'fundamentals';
    var grid = $('concept-grid'); if (!grid) return;
    var html = '';
    CONCEPTS.filter(function (c) { return c.cat === cat; }).forEach(function (c) {
      html += '<article class="concept-card"><h3>' + c.name + '</h3><p>' + c.body + '</p></article>';
    });
    grid.innerHTML = html;
    /* latex-auto.js only observes the equation panel and the calc modal,
       so this container has to be rendered explicitly. */
    if (window.renderMathInElement) {
      window.renderMathInElement(grid, {
        delimiters: [{ left: '\\[', right: '\\]', display: true },
                     { left: '\\(', right: '\\)', display: false }],
        throwOnError: false
      });
    }
  }

  /* ═══════════════════════════════════════════════════════════════
     PRACTICE MODE
     ═══════════════════════════════════════════════════════════════ */
  function rr(a, b) { return a + Math.random() * (b - a); }
  function ri(a, b) { return Math.floor(rr(a, b + 1)); }
  function rd(v, d) { return parseFloat(v.toFixed(d)); }

  var GENERATORS = [
    function () {
      var r = rd(rr(7, 12), 1);
      return { q: 'A petrol engine has a compression ratio of ' + r + ':1. Using the cold air-standard Otto cycle (γ = 1.4), what is its thermal efficiency?',
        a: rd(ottoEta(r) * 100, 1), u: '%', tol: 0.3,
        s: 'η = 1 − 1/r^(γ−1) = 1 − 1/' + r + '^0.4 = 1 − ' + rd(1 / Math.pow(r, 0.4), 4) + ' = ' + rd(ottoEta(r) * 100, 1) + '%' };
    },
    function () {
      var r = rd(rr(15, 21), 1), rho = rd(rr(1.6, 2.6), 2);
      return { q: 'A diesel engine runs a compression ratio of ' + r + ':1 with a cutoff ratio of ' + rho + '. Find the air-standard thermal efficiency.',
        a: rd(dieselEta(r, rho) * 100, 1), u: '%', tol: 0.4,
        s: 'η = 1 − (1/r^0.4)·[(ρ^1.4 − 1)/(1.4(ρ − 1))]\n= 1 − (1/' + rd(Math.pow(r, 0.4), 3) + ')·[(' +
           rd(Math.pow(rho, 1.4), 3) + ' − 1)/(1.4 × ' + rd(rho - 1, 2) + ')]\n= ' + rd(dieselEta(r, rho) * 100, 1) + '%' };
    },
    function () {
      var B = ri(65, 105), L = ri(70, 115), nc = [1, 2, 3, 4, 6][ri(0, 4)];
      var Vs = Math.PI / 4 * B * B * L / 1000;
      return { q: 'An engine has a bore of ' + B + ' mm, a stroke of ' + L + ' mm and ' + nc + ' cylinder' + (nc > 1 ? 's' : '') + '. What is its total displacement in cm³?',
        a: rd(Vs * nc, 0), u: 'cm³', tol: Math.max(2, Vs * nc * 0.01),
        s: 'Vs = (π/4)B²L = (π/4)(' + B + ')²(' + L + ') = ' + rd(Vs, 1) + ' cm³ per cylinder\nTotal = ' + rd(Vs, 1) + ' × ' + nc + ' = ' + rd(Vs * nc, 0) + ' cm³' };
    },
    function () {
      var Vs = ri(400, 700), r = rd(rr(8, 12), 1);
      var Vc = rd(Vs / (r - 1), 1);
      return { q: 'A cylinder sweeps ' + Vs + ' cm³ and the compression ratio is ' + r + ':1. What is the clearance volume?',
