        s: 'T3 = T2 + qin/cp = ' + T2 + ' + ' + qin + '/1.005 = ' + rd(T3, 0) + ' K\nρ = V3/V2 = T3/T2 = ' + rd(T3, 0) + '/' + T2 + ' = ' + rd(T3 / T2, 2) };
    },
    function () {
      var ivo = ri(5, 25), evc = ri(5, 25);
