  function fmtU(v, unit, dOverride) {
    var u = unit();
    if (!isFinite(v)) return '—';
    var d = (dOverride == null) ? u.d : dOverride;
    return (v * u.k).toFixed(d) + ' ' + u.l;
  }
  function valU(v, unit) { var u = unit(); return v * u.k; }
  function labU(unit) { return unit().l; }

  /* ── 5. Slider-crank kinematics ──────────────────────────────────
     Fraction of the stroke travelled from TDC, 0 at TDC and 1 at BDC.
     Everything — the drawn piston, the cylinder volume, the P-V trace —
     reads this one function, so the picture and the numbers can never
     describe pistons in different places. */
  function pistonFrac(theta) {
    var rad = theta * Math.PI / 180;
    var R = 0.5, L = R * st.rodRatio;
    var s = R * Math.sin(rad) / L;
    var disp = R * (1 - Math.cos(rad)) + L * (1 - Math.sqrt(Math.max(0, 1 - s * s)));
    return disp / (2 * R);
  }

  /* ── 6. Geometry ── */
  function geom() {
    var B = st.bore / 1000, S = st.strokeLen / 1000;
    var Vs = Math.PI / 4 * B * B * S;      // m³ swept per cylinder
    var Vc = Vs / (st.cr - 1);             // m³ clearance
    return {
      B: B, S: S, Vs: Vs, Vc: Vc,
      V1: Vs + Vc,                          // m³ at BDC
      dispL: Vs * st.nCyl * 1000,           // litres total
      Ap: Math.PI / 4 * B * B               // m² piston area
    };
  }
  /* Cylinder volume at a crank angle, m³. */
  function volAt(theta) {
    var g = geom();
    return g.Vc + g.Vs * pistonFrac(theta);
  }

  /* ── 7. The cycle ────────────────────────────────────────────────
     State 1 is taken at BDC with the trapped charge = fresh air + the
     residual gas left in the clearance volume. Solving the mixing
     balance gives T1 slightly above manifold temperature, which is the
     charge heating a real engine also sees. */
  var _cycleCache = null, _cycleKey = '';

  function cycleKey() {
    return [st.fuel, st.bore, st.strokeLen, st.nCyl, st.cr, st.rodRatio, st.rpm,
            st.pMan, st.qin, st.afr, st.etaMech, st.pExh, st.tIn].join('|');
  }

  function computeCycle() {
    var k = cycleKey();
    if (_cycleCache && k === _cycleKey) return _cycleCache;

    var g = geom();
    var r = st.cr, P1 = st.pMan, Tman = st.tIn, Pexh = st.pExh, qin = st.qin;
    var otto = (st.fuel === 'petrol');

    /* Residual-gas / charge-heating balance.
       State 1 is the mixture of fresh charge at manifold temperature with
       the burnt gas trapped in the clearance volume, so T1 sits above the
       manifold temperature exactly as it does in a real engine.

       Solved by bisection rather than by fixed-point iteration. The naive
       iteration Tres -> T1 -> T4 -> Tres has a loop gain above one once the
       exhaust/manifold pressure ratio passes about five: it then diverges
       monotonically instead of converging, and an iteration cap turns that
       into a silent wrong answer rather than an error (a 35/240 kPa case
       reached a compression-end temperature of 39 800 K). Bisection on a
       bracketed, physically bounded root cannot do that. */
    var Tres = 900, mRes = 0, mFresh = 0, m = 0, T1 = Tman;
    var T2 = 0, P2 = 0, T3 = 0, P3 = 0, V3 = g.Vc, T4 = 0, P4 = 0, rho = 1;
    var PVoR = P1 * g.V1 / R_GAS;   /* = m·T1  [kg·K] */
    var starved = false;

    /* One pass of the balance for a trial residual temperature; returns the
       residual temperature that trial implies. The root of
       residualPass(T) - T is the self-consistent state 1. */
    function residualPass(TresTry) {
      mRes = Pexh * g.Vc / (R_GAS * TresTry);
      var fresh = (PVoR - mRes * TresTry) / Tman;
      /* Negative means the burnt gas alone more than fills the cylinder at
         manifold pressure: the engine cannot induct anything at all. */
      starved = (fresh <= 0);
      mFresh = starved ? 0 : fresh;
      m  = mFresh + mRes;
      T1 = PVoR / m;

      T2 = T1 * Math.pow(r, GAMMA - 1);
      P2 = P1 * Math.pow(r, GAMMA);

      if (otto) {
        T3  = T2 + qin / CV;
        P3  = P2 * (T3 / T2);
        V3  = g.Vc;
        rho = 1;
        T4  = T3 / Math.pow(r, GAMMA - 1);
        P4  = P3 / Math.pow(r, GAMMA);
      } else {
        T3  = T2 + qin / CP;
        rho = T3 / T2;                          /* cutoff ratio = V3/V2 */
        P3  = P2;
        V3  = g.Vc * rho;
        var re = r / rho;                       /* expansion ratio */
        T4  = T3 / Math.pow(re, GAMMA - 1);
        P4  = P3 / Math.pow(re, GAMMA);
      }
      /* Exhaust temperature after blowdown to back-pressure, isentropic. */
      return T4 * Math.pow(Pexh / P4, (GAMMA - 1) / GAMMA);
    }

    var LO = Math.max(Tman, 200), HI = 6000;
    var fLo = residualPass(LO) - LO, fHi = residualPass(HI) - HI;
    if (fLo * fHi <= 0) {
      for (var bi = 0; bi < 60; bi++) {
        var mid = 0.5 * (LO + HI);
        var fMid = residualPass(mid) - mid;
        if (fLo * fMid <= 0) { HI = mid; fHi = fMid; } else { LO = mid; fLo = fMid; }
        if (HI - LO < 0.02) break;
      }
      Tres = 0.5 * (LO + HI);
    } else {
      /* No root in a physically sensible bracket — the operating point is
         not a working cycle. Pin to the bracket end and let the caller
         report it rather than inventing a temperature. */
      Tres = (Math.abs(fLo) < Math.abs(fHi)) ? LO : HI;
      starved = true;
    }
    residualPass(Tres);         /* leave every state variable on the root */

    /* Cutoff beyond BDC is not a valid Diesel cycle — flag it. */
    var cutoffOver = (!otto && rho >= r);

    /* Validity of the breathing solution.
       T1 is a mass-weighted mean of fresh charge at Tman and residual at
       Tres, so it is bounded by them; but at extreme back-pressure ratios
       the balance has a second, self-consistent root where the cylinder
       recycles almost pure exhaust and settles at thousands of kelvin.
       That root is arithmetically valid and physically meaningless, so it
       is rejected on volumetric efficiency: below 20% the cylinder is not
       breathing in any sense the air-standard cycle can describe. */
    var rhoManCheck = P1 / (R_GAS * Tman);
    var etaVolCheck = mFresh / (rhoManCheck * g.Vs);
    var cannotBreathe = starved || mFresh <= 0 || !(etaVolCheck > 0.2);

    var qout  = CV * (T4 - T1);                 // kJ/kg
    var wNet  = qin - qout;                     // kJ/kg  (closed part of cycle)
    var etaTh = wNet / qin;
    var Wgross = m * wNet;                      // kJ per cylinder per cycle
    var imepG  = Wgross / g.Vs;                 // kPa
    var pmep   = Pexh - P1;                     // kPa — pumping loss (positive when throttled)
    var Wpump  = pmep * g.Vs;                   // kJ per cylinder per cycle
    var imepN  = imepG - pmep;                  // kPa net indicated MEP
    var Wnet   = imepN * g.Vs;

    var cyclesPerSec = st.rpm / 120;            // four-stroke: one cycle per 2 rev
    var IP   = imepN * g.Vs * st.nCyl * cyclesPerSec;   // kW
    var BP   = st.etaMech * IP;                        // kW
    var bmep = st.etaMech * imepN;                     // kPa
    var fmep = imepN - bmep;                           // kPa friction MEP
    var torque = (st.rpm > 0) ? BP * 1000 * 60 / (2 * Math.PI * st.rpm) : 0;  // N·m

    /* Fuel flow from the real air-fuel ratio, not from q_in — see header. */
    var mFuel  = mFresh / st.afr;                      // kg per cylinder per cycle
    var mdotF  = mFuel * st.nCyl * cyclesPerSec;       // kg/s
    var fuelPow = mdotF * LHV[st.fuel];                // kW of fuel energy
    /* Fuel-referenced efficiencies only mean anything when the engine is
       actually breathing and producing positive work. Guarding on
       fuelPow > 0 alone let a starved cylinder divide by ~1e-12 and report
       a brake thermal efficiency of -3 268 419 645 %. */
    var usable   = !cannotBreathe && fuelPow > 1e-9 && BP > 0;
    var etaBrake = usable ? BP / fuelPow : NaN;
    var etaInd   = usable ? IP / fuelPow : NaN;
    var bsfc     = usable ? mdotF * 1000 * 3600 / BP : NaN;   // g/kWh

    /* Ideal volumetric efficiency — fresh charge against manifold density. */
    var etaVol = etaVolCheck;
    var fRes   = mRes / m;

    /* Entropy relative to state 1, kJ/(kg·K), for the T-s diagram. */
    var s1 = 0;
    var s2 = s1;
    var s3 = otto ? s2 + CV * Math.log(T3 / T2) : s2 + CP * Math.log(T3 / T2);
    var s4 = s3;

    var c = {
      g: g, otto: otto, r: r, rho: rho, cutoffOver: cutoffOver,
      cannotBreathe: cannotBreathe, usable: usable,
      P1: P1, T1: T1, V1: g.V1, P2: P2, T2: T2, V2: g.Vc,
      P3: P3, T3: T3, V3: V3, P4: P4, T4: T4, V4: g.V1,
      s1: s1, s2: s2, s3: s3, s4: s4,
      m: m, mFresh: mFresh, mRes: mRes, fRes: fRes, Tres: Tres,
      qin: qin, qout: qout, wNet: wNet, etaTh: etaTh,
      Wgross: Wgross, Wpump: Wpump, Wnet: Wnet,
      imepG: imepG, imepN: imepN, pmep: pmep, bmep: bmep, fmep: fmep,
      IP: IP, BP: BP, torque: torque,
      mFuel: mFuel, mdotF: mdotF, fuelPow: fuelPow,
      etaBrake: etaBrake, etaInd: etaInd, etaVol: etaVol, bsfc: bsfc,
      Pexh: Pexh, Tman: Tman, cyclesPerSec: cyclesPerSec
    };
    _cycleCache = c; _cycleKey = k;
    return c;
  }

  /* Closed-form air-standard efficiencies, used as an independent check
     of the state-by-state result and quoted in the learning panels. */
  function ottoEta(r) { return 1 - 1 / Math.pow(r, GAMMA - 1); }
  function dieselEta(r, rho) {
    if (Math.abs(rho - 1) < 1e-9) return ottoEta(r);
    return 1 - (1 / Math.pow(r, GAMMA - 1)) * ((Math.pow(rho, GAMMA) - 1) / (GAMMA * (rho - 1)));
  }

  /* ── 8. Valve events, in crank degrees on the 0–720 cycle ────────
     0 = TDC starting intake, 180 = BDC, 360 = TDC firing, 540 = BDC. */
  function valveEvents() {
    return {
      ivo: (720 - st.ivo) % 720,   // before TDC, i.e. late in the exhaust stroke
      ivc: 180 + st.ivc,           // after BDC
      evo: 540 - st.evo,           // before BDC
      evc: 720 + st.evc            // after TDC — wraps past 0
    };
  }
  function inArcDeg(a, from, to) {
    a = ((a % 720) + 720) % 720;
    from = ((from % 720) + 720) % 720;
    to   = ((to % 720) + 720) % 720;
    return (from <= to) ? (a >= from && a <= to) : (a >= from || a <= to);
  }
  /* Normalised valve lift 0–1, a smooth cam-like profile over the event. */
  function valveLift(a, from, to) {
    if (!inArcDeg(a, from, to)) return 0;
    var span = ((to - from) % 720 + 720) % 720;
    if (span < 1) return 0;
    var pos = ((a - from) % 720 + 720) % 720;
    return Math.pow(Math.sin(Math.PI * pos / span), 1.4);
  }
  function intakeLift(a) { var v = valveEvents(); return valveLift(a, v.ivo, v.ivc); }
  function exhaustLift(a) { var v = valveEvents(); return valveLift(a, v.evo, v.evc); }
  function overlapDeg() { return st.ivo + st.evc; }

  /* ── 9. Continuous cylinder state at a crank angle ───────────────
     The four ideal processes, plus a blowdown decay from EVO so the
     exhaust stroke does not start with a step change in pressure. */
  var BLOWDOWN_TAU = 12;   // degrees

  /* The four ideal closed processes, 180 deg (BDC, state 1) through
     540 deg (BDC, state 4), with no blowdown. stateAt() overlays blowdown
     on top of this for the P-V trace and the readouts; the T-s diagram
     needs the clean textbook expansion, which runs all the way to BDC. */
  function idealClosedState(ang) {
    var c = computeCycle();
    var Vx = volAt(ang);
    if (ang >= 180 && ang < 360) {
      var ratio = c.V1 / Vx;
      return { P: c.P1 * Math.pow(ratio, GAMMA), T: c.T1 * Math.pow(ratio, GAMMA - 1), V: Vx };
    }
    if (c.otto) {
      var er = Vx / c.V2;
      return { P: c.P3 / Math.pow(er, GAMMA), T: c.T3 / Math.pow(er, GAMMA - 1), V: Vx };
    }
    if (Vx <= c.V3) return { P: c.P3, T: c.T2 * (Vx / c.V2), V: Vx };   /* constant-pressure burn */
    var ef = Vx / c.V3;
    return { P: c.P3 / Math.pow(ef, GAMMA), T: c.T3 / Math.pow(ef, GAMMA - 1), V: Vx };
  }

  function stateAt(theta) {
    var a = ((theta % 720) + 720) % 720;
    var c = computeCycle();
    var V = volAt(a);
    var P, T;
    var ev = valveEvents();

    function idealClosed(ang) { return idealClosedState(ang); }

    if (a >= 180 && a < ev.evo) {
      var s = idealClosed(a); P = s.P; T = s.T;
    } else if (a >= ev.evo && a < 600) {
      /* Blowdown: exponential decay from the cylinder pressure at EVO
         toward the exhaust back-pressure, with T following isentropically. */
      var sE = idealClosed(Math.min(ev.evo, 539.999));
      var f = Math.exp(-(a - ev.evo) / BLOWDOWN_TAU);
      P = c.Pexh + (sE.P - c.Pexh) * f;
      T = sE.T * Math.pow(Math.max(P, 1) / sE.P, (GAMMA - 1) / GAMMA);
      if (T < c.Tres) T = c.Tres;
    } else if (a >= 600) {
      P = c.Pexh;
      T = c.Tres;
    } else {
      /* Intake stroke: manifold pressure; charge warming toward T1. */
      P = c.P1;
      var frac = Math.min(1, a / 180);
      T = c.Tres + (c.T1 - c.Tres) * Math.min(1, frac * 1.6);
      if (a >= 170) T = c.T1;
    }
    return { P: P, T: T, V: V, a: a };
  }

  function strokeName(a) {
    a = ((a % 720) + 720) % 720;
    if (a < 180) return 'Intake';
    if (a < 360) return 'Compression';
    if (a < 540) return 'Power';
    return 'Exhaust';
  }
  function strokeColor(n) {
    switch (n) {
      case 'Intake':      return '#42a5f5';
      case 'Compression': return '#ffa726';
      case 'Power':       return '#ef5350';
      case 'Exhaust':     return '#78909c';
      default:            return '#aaa';
    }
  }

  /* ═══════════════════════════════════════════════════════════════
