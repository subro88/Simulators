  var quiz = { qs: [], i: 0, score: 0, answered: false };
  function shuffle(a) { for (var i = a.length - 1; i > 0; i--) { var j = Math.floor(Math.random() * (i + 1)); var t = a[i]; a[i] = a[j]; a[j] = t; } return a; }

  function startQuiz() {
    quiz.qs = shuffle(QUIZ_POOL.slice()).slice(0, QUIZ_SIZE);
    quiz.i = 0; quiz.score = 0;
    $('quiz-result').style.display = 'none';
    $('quiz-bar').style.display = '';
    showQuizQ();
  }
  function showQuizQ() {
    var q = quiz.qs[quiz.i];
    quiz.answered = false;
    $('quiz-counter').textContent = 'Q ' + (quiz.i + 1) + ' / ' + quiz.qs.length;
    $('quiz-prompt').textContent = q.q;
    var opts = $('quiz-options');
    opts.innerHTML = '';
    q.o.forEach(function (t, i) {
      var b = document.createElement('button');
      b.type = 'button'; b.className = 'quiz-opt'; b.textContent = t; b.dataset.i = i;
      b.addEventListener('click', function () {
        if (quiz.answered) return;
        opts.querySelectorAll('.quiz-opt').forEach(function (x) { x.classList.remove('selected'); });
        b.classList.add('selected');
      });
      opts.appendChild(b);
    });
    $('quiz-feedback').textContent = '';
    $('quiz-feedback').className = 'feedback';
    $('btn-quiz-next').disabled = true;
    $('btn-quiz-submit').disabled = false;
  }
  function submitQuiz() {
    if (quiz.answered) return;
    var sel = document.querySelector('#quiz-options .quiz-opt.selected');
    var fb = $('quiz-feedback');
    if (!sel) { fb.textContent = 'Choose an answer first.'; fb.className = 'feedback warn'; return; }
    quiz.answered = true;
    var q = quiz.qs[quiz.i];
    var picked = parseInt(sel.dataset.i, 10);
    document.querySelectorAll('#quiz-options .quiz-opt').forEach(function (b, i) {
      if (i === q.c) b.classList.add('correct');
      else if (i === picked) b.classList.add('wrong');
      b.disabled = true;
    });
    if (picked === q.c) { quiz.score++; fb.textContent = '✓ Correct. ' + q.e; fb.className = 'feedback ok'; }
    else { fb.textContent = '✗ ' + q.e; fb.className = 'feedback bad'; }
    $('btn-quiz-submit').disabled = true;
    $('btn-quiz-next').disabled = false;
  }
  function nextQuizQ() {
    quiz.i++;
    if (quiz.i >= quiz.qs.length) showQuizResult();
    else showQuizQ();
  }
  function showQuizResult() {
    $('quiz-bar').style.display = 'none';
    var pct = Math.round(quiz.score / quiz.qs.length * 100);
    var msg = pct >= 85 ? 'Excellent — you have the four-stroke cycle cold.'
            : pct >= 60 ? 'Solid. Revisit the Explore cards on the topics you missed.'
            : 'Work through Explore mode, then run the simulator and watch the P–V diagram before trying again.';
    var r = $('quiz-result');
    r.innerHTML = '<div class="qr-score">' + quiz.score + ' / ' + quiz.qs.length + '</div>' +
      '<div class="qr-pct">' + pct + '%</div><p class="qr-msg">' + msg + '</p>' +
      '<div class="qr-retry"><button class="btn btn-primary" type="button" id="btn-retry-quiz">New Quiz</button></div>';
    r.style.display = '';
    $('btn-retry-quiz').addEventListener('click', startQuiz);
  }

