    },
    function () {
      var pman = ri(35, 70), pexh = ri(103, 115), Vs = ri(400, 600);
      var pmep = pexh - pman;
      return { q: 'A throttled petrol engine has a manifold pressure of ' + pman + ' kPa and an exhaust back-pressure of ' + pexh + ' kPa. What is the pumping mean effective pressure (PMEP) in kPa?',
        a: pmep, u: 'kPa', tol: 0.6,
        s: 'PMEP = p_exhaust − p_manifold = ' + pexh + ' − ' + pman + ' = ' + pmep + ' kPa\nThis is subtracted from the gross IMEP, so throttling costs work every single cycle.' };
    },
    function () {
      var N = ri(1200, 6000);
