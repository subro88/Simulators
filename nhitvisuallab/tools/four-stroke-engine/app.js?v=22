    },
    function () {
      var ivo = ri(5, 20), ivc = ri(30, 60);
      return { q: 'The intake valve opens ' + ivo + '° before TDC and closes ' + ivc + '° after BDC. For how many crank degrees is it open?',
        a: 180 + ivo + ivc, u: '°', tol: 0.5,
        s: 'Duration = ' + ivo + '° (before TDC) + 180° (TDC to BDC) + ' + ivc + '° (after BDC) = ' + (180 + ivo + ivc) + '°' };
    },
    function () {
      var mFresh = rd(rr(0.35, 0.85), 3), Vs = ri(400, 650), rho = 1.18;
      var ev = rd(mFresh / (rho * Vs * 1e-6 * 1000) * 100, 1);
      return { q: 'A cylinder of ' + Vs + ' cm³ swept volume traps ' + mFresh + ' g of fresh air per cycle. Ambient air density is 1.18 kg/m³. What is the volumetric efficiency?',
        a: ev, u: '%', tol: 0.6,
