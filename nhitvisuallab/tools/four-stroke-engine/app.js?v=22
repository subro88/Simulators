    }
  ];

  var practice = { p: null, right: 0, total: 0 };
  function newProblem() {
    practice.p = GENERATORS[Math.floor(Math.random() * GENERATORS.length)]();
    $('practice-prompt').textContent = practice.p.q;
    $('practice-unit').textContent = practice.p.u;
    $('practice-input').value = '';
    $('practice-feedback').textContent = '';
    $('practice-feedback').className = 'feedback';
    $('solution-panel').style.display = 'none';
    $('practice-input').focus();
  }
  function checkPractice() {
    if (!practice.p) return;
    var v = parseFloat($('practice-input').value);
    var fb = $('practice-feedback');
    if (!isFinite(v)) { fb.textContent = 'Enter a numeric answer first.'; fb.className = 'feedback warn'; return; }
    practice.total++;
    if (Math.abs(v - practice.p.a) <= practice.p.tol) {
      practice.right++;
      fb.textContent = '✓ Correct — ' + practice.p.a + ' ' + practice.p.u;
      fb.className = 'feedback ok';
    } else {
      fb.textContent = '✗ Not quite. The answer is ' + practice.p.a + ' ' + practice.p.u + '. Use "Show Solution" to see the working.';
      fb.className = 'feedback bad';
    }
    $('practice-score').textContent = practice.right + ' / ' + practice.total;
  }
  function showSolution() {
    if (!practice.p) return;
    var sp = $('solution-panel');
    sp.innerHTML = '<strong>Solution</strong><pre>' + practice.p.s + '</pre>';
    sp.style.display = '';
  }
  function resetPractice() {
    practice.right = 0; practice.total = 0;
    $('practice-score').textContent = '0 / 0';
    newProblem();
  }

