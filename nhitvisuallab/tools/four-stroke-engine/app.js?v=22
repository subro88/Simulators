    $('fuel-tabs').addEventListener('click', function (e) {
      var b = e.target.closest ? e.target.closest('.pill') : null;
      if (!b || !this.contains(b)) return;
      setFuel(b.dataset.value);
    });
    /* Units */
    var ut = $('units-tabs');
    if (ut) ut.addEventListener('click', function (e) {
      var b = e.target.closest ? e.target.closest('.pill') : null;
      if (!b || !this.contains(b)) return;
      st.units = b.dataset.value;
      document.querySelectorAll('#units-tabs .pill').forEach(function (p) { p.classList.toggle('active', p === b); });
      _cache = { eq: '', tbl: '', perf: '', coach: '' };
      afterChange();
    });
    /* Right-hand pane */
    var pt = $('pane-tabs');
    if (pt) pt.addEventListener('click', function (e) {
      var b = e.target.closest ? e.target.closest('.pt-pill') : null;
      if (!b || !this.contains(b)) return;
      st.pane = b.dataset.pane;
      document.querySelectorAll('#pane-tabs .pt-pill').forEach(function (p) { p.classList.toggle('active', p === b); });
      draw();
    });
    /* Explore category tabs */
    var et = $('explore-tabs');
    if (et) et.addEventListener('click', function (e) {
      var b = e.target.closest ? e.target.closest('.pill') : null;
      if (!b || !this.contains(b)) return;
      document.querySelectorAll('#explore-tabs .pill').forEach(function (p) { p.classList.toggle('active', p === b); });
      buildExplore();
    });
    /* Preset dropdown */
    var ps = $('preset-select');
    if (ps) ps.addEventListener('change', function () { if (this.value !== 'custom') applyPreset(this.value); });

    $('btn-play').addEventListener('click', togglePlay);
    $('btn-step').addEventListener('click', stepStroke);
    var br = $('btn-reset'); if (br) br.addEventListener('click', resetAll);
    var bc = $('btn-calc'); if (bc) bc.addEventListener('click', openCalc);
    var cc = $('calc-modal-close'); if (cc) cc.addEventListener('click', closeCalc);
    var cm = $('calc-modal');
    if (cm) cm.addEventListener('click', function (e) { if (e.target === cm) closeCalc(); });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') { closeCalc(); closeCtxMenu(); }
      if (st.mode !== 'simulate') return;
      var tag = (document.activeElement && document.activeElement.tagName) || '';
      if (tag === 'INPUT' || tag === 'SELECT' || tag === 'TEXTAREA') return;
      if (e.key === ' ') { e.preventDefault(); togglePlay(); }
      if (e.key === 's' || e.key === 'S') stepStroke();
    });

    var ec = $('btn-export-csv'); if (ec) ec.addEventListener('click', exportCSV);
    var ep = $('btn-export-png'); if (ep) ep.addEventListener('click', exportPNG);

    /* Practice mode */
    $('btn-check').addEventListener('click', checkPractice);
    $('btn-solution').addEventListener('click', showSolution);
    $('btn-next-practice').addEventListener('click', newProblem);
    $('practice-input').addEventListener('keydown', function (e) {
      if (e.key === 'Enter') checkPractice();
    });

    /* Quiz mode */
    $('btn-quiz-submit').addEventListener('click', submitQuiz);
    $('btn-quiz-next').addEventListener('click', nextQuizQ);

    canvas.addEventListener('contextmenu', function (e) { e.preventDefault(); showCtxMenu(e.clientX, e.clientY); });
    document.addEventListener('click', function (e) { if (ctxMenu && !ctxMenu.contains(e.target)) closeCtxMenu(); });
    window.addEventListener('scroll', closeCtxMenu, { passive: true });

    /* Restore path for a shared link. These fire before any numeric input
       is restored, because they sit ahead of the parameter grid in the DOM
       and share-params applies values in document order. */
    var su = $('share-units');
    if (su) su.addEventListener('change', function () {
      var v = (su.value === 'imp') ? 'imp' : 'si';
      if (v === st.units) return;
      st.units = v;
      document.querySelectorAll('#units-tabs .pill').forEach(function (p) {
        p.classList.toggle('active', p.dataset.value === v);
      });
      _cache = { eq: '', tbl: '', perf: '', coach: '' };
      afterChange();
    });
    var sf = $('share-fuel');
    if (sf) sf.addEventListener('change', function () {
      var v = (sf.value === 'diesel') ? 'diesel' : 'petrol';
      if (v === st.fuel) return;
      setFuel(v);
    });

    wireParams();
    wireToggles();
    wireLearnPanels();
    applyFuelUI();
    applyCRRange();
    syncToggles();
    document.querySelectorAll('#units-tabs .pill').forEach(function (b) { b.classList.toggle('active', b.dataset.value === st.units); });
    document.querySelectorAll('#pane-tabs .pt-pill').forEach(function (b) { b.classList.toggle('active', b.dataset.pane === st.pane); });

    window.addEventListener('resize', resizeCanvas);
    if (typeof ResizeObserver !== 'undefined') {
      /* Must call resizeCanvas, not draw — otherwise the backing store
         stays at the old size and everything goes soft. */
      new ResizeObserver(resizeCanvas).observe(canvas.parentElement || canvas);
    }
    resizeCanvas();
    afterChange();
  }

  init();
})();
