     ═══════════════════════════════════════════════════════════════ */

  var canvas = document.getElementById('engine-canvas');
  var ctx    = canvas.getContext('2d');
  var LW = 1000, LH = 560;      // logical drawing coordinates
  var narrow = false;
  var crankAngle = 0;

  /* ── Particles (gas flow visualisation) ── */
  var particles = [], MAX_PARTICLES = 90, layout = null;

  function haloText(txt, x, y, font, fill, align, halo) {
    ctx.save();
    ctx.font = font; ctx.textAlign = align || 'left';
    ctx.lineWidth = 3.5; ctx.lineJoin = 'round';
    ctx.strokeStyle = halo || 'rgba(8,11,20,0.85)';
    ctx.strokeText(txt, x, y);
    ctx.fillStyle = fill; ctx.fillText(txt, x, y);
    ctx.restore();
  }

  function spawnParticles(dt) {
    if (!st.showParticles || !layout || particles.length >= MAX_PARTICLES) return;
    var a = ((crankAngle % 720) + 720) % 720;
    var iL = intakeLift(a), eL = exhaustLift(a);
    var n = Math.min(4, Math.round(dt * 90));
    var i;
    if (iL > 0.12 && a < 200) {
      for (i = 0; i < n; i++) {
        particles.push(mkP(layout.inX + (Math.random() - 0.5) * layout.valveW,
          layout.cylY + 4, (Math.random() - 0.5) * 12, 30 + Math.random() * 55,
          st.fuel === 'petrol' ? '#42a5f5' : '#81d4fa', 2 + Math.random() * 2));
      }
    }
    if (eL > 0.12 && a > 480) {
      for (i = 0; i < n; i++) {
        particles.push(mkP(layout.exX + (Math.random() - 0.5) * layout.valveW,
          layout.cylY + 6, (Math.random() - 0.5) * 10, -40 - Math.random() * 60,
          '#90a4ae', 2 + Math.random() * 2));
      }
    }
    if (a >= 360 && a < 420) {   /* combustion */
      for (i = 0; i < 2; i++) {
        particles.push(mkP(layout.cylX + layout.cylW * (0.2 + Math.random() * 0.6),
          layout.cylY + 8 + Math.random() * 14, (Math.random() - 0.5) * 45,
          (Math.random() - 0.3) * 45, Math.random() < 0.5 ? '#ff7043' : '#ffca28',
          2 + Math.random() * 3));
      }
    }
  }
  function mkP(x, y, vx, vy, color, size) {
    return { x: x, y: y, vx: vx, vy: vy, color: color, size: size,
             life: 1, decay: 0.6 + Math.random() * 1.1 };
  }
  function updateParticles(dt) {
    if (dt > 0.1) dt = 0.1;
    for (var i = particles.length - 1; i >= 0; i--) {
      var p = particles[i];
      p.x += p.vx * dt; p.y += p.vy * dt;
      p.life -= p.decay * dt;
      if (p.life <= 0) particles.splice(i, 1);
      else if (layout) {
        if (p.y > layout.pistonY - 2) { p.y = layout.pistonY - 2; p.vy *= -0.35; }
        if (p.x < layout.cylX + 3) { p.x = layout.cylX + 3; p.vx *= -0.5; }
        if (p.x > layout.cylX + layout.cylW - 3) { p.x = layout.cylX + layout.cylW - 3; p.vx *= -0.5; }
      }
    }
  }
  function drawParticles() {
    if (!st.showParticles) return;
    ctx.save();
    for (var i = 0; i < particles.length; i++) {
      var p = particles[i];
      ctx.globalAlpha = Math.max(0, Math.min(1, p.life)) * 0.85;
      ctx.fillStyle = p.color;
      ctx.beginPath(); ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2); ctx.fill();
    }
    ctx.restore();
  }

  /* Canvas layout in logical coordinates. Shared by draw() and by the
     HTML overlays that have to sit on top of a specific region, so the
     two can never drift apart. */
  function layoutRects() {
    if (narrow) {
      return {
        eng:  { x: 6,  y: 8,   w: LW - 12, h: 470 },
        ind:  { x: 10, y: 486, w: LW - 20 },
        pane: { x: 6,  y: 518, w: LW - 12, h: LH - 526 }
      };
    }
    return {
      eng:  { x: 8,  y: 12,  w: LW * 0.47, h: LH - 64 },
      ind:  { x: 14, y: LH - 46, w: LW * 0.47 - 12 },
      pane: { x: LW * 0.47 + 22, y: 12, w: LW - (LW * 0.47 + 30), h: LH - 24 }
    };
  }

  /* ── Main render ── */
  function draw() {
    ctx.clearRect(0, 0, LW, LH);
    var L = layoutRects(), eng = L.eng, pane = L.pane, ind = L.ind;
    drawEngine(eng.x, eng.y, eng.w, eng.h);
    drawStrokeIndicator(ind.x, ind.y, ind.w);
    if (st.pane === 'pv')        drawPV(pane.x, pane.y, pane.w, pane.h);
    else if (st.pane === 'ts')   drawTS(pane.x, pane.y, pane.w, pane.h);
    else                         drawValveDiagram(pane.x, pane.y, pane.w, pane.h);
  }

  /* ── Engine cross-section ─────────────────────────────────────── */
  function drawEngine(x, y, w, h) {
    var a = ((crankAngle % 720) + 720) % 720;
    var strokeA = a % 360;
    var pf = pistonFrac(strokeA);
    var sName = strokeName(a);
    var sColor = strokeColor(sName);
    var c = computeCycle();

    /* ── True-to-scale slider-crank ──────────────────────────────────
       Every drawn length is one scale factor times a real engine
       dimension: crank radius = stroke/2, connecting rod = rodRatio ×
       crank radius, bore from the bore/stroke ratio, clearance height
       from the compression ratio. That means the drawn rod really is a
       rigid link — its length does not change as the crank turns — and
       the piston the rod carries sits exactly where pistonFrac() says.

       The vertical budget therefore has to hold, in order: the equation
       band, the valve gear above the head, the clearance volume, the
       swept stroke, half the piston, the rod at TDC, the crank circle,
       and the caption. Solving that for the stroke (rather than picking
       a fraction of the pane height) is what keeps the crankshaft on
       the canvas for every compression ratio and rod ratio. */
    var eqBand   = st.showEquation ? 32 : 8;
    var topPad   = 62;                       // valve stems, ports, plug
    var botText  = 46;                       // stroke title + live state line
    var crankGap = 34;                       // room for the flywheel ring
    var avail    = h - eqBand - topPad - botText - crankGap;
    var bs        = st.bore / st.strokeLen;                  // bore ÷ stroke
    var clearFrac = Math.min(0.4, 1 / (st.cr - 1));          // clearance ÷ stroke
    var pistonFr  = 0.45 * bs;                               // piston height ÷ stroke
    /* clearH + 0.55·pistonH + (rod + crankR) + crankR = avail, all ÷ stroke */
    var denom  = clearFrac + 0.55 * pistonFr + (st.rodRatio + 2) / 2;
    var travel = Math.max(50, avail / denom);

    var clearH  = travel * clearFrac;
    var pistonH = travel * pistonFr;
    var cylW    = travel * bs;
    var crankR  = travel / 2;
    var rodLen  = st.rodRatio * crankR;
    var cylH    = clearH + travel;

    var cylX = x + (w - cylW) / 2;
    var cylY = y + eqBand + topPad;
    var pistonY = cylY + clearH + pf * travel;

    var crankCX = cylX + cylW / 2;
    /* Crank centre = piston-pin height at TDC + rod + crank radius. */
    var crankCY = cylY + clearH + pistonH * 0.55 + rodLen + crankR;
    var crankRad = strokeA * Math.PI / 180;
    var crankPinX = crankCX + crankR * Math.sin(crankRad);
    var crankPinY = crankCY - crankR * Math.cos(crankRad);

    var iL = intakeLift(a), eL = exhaustLift(a);
    var valveW = cylW * 0.20, valveTravel = Math.max(8, cylH * 0.045);
    var inX = cylX + cylW * 0.27, exX = cylX + cylW * 0.73;

    layout = { cylX: cylX, cylY: cylY, cylW: cylW, cylH: cylH,
               pistonY: pistonY, inX: inX, exX: exX, valveW: valveW };

    /* ── Engine block ── */
    var blockGrad = ctx.createLinearGradient(cylX - 26, 0, cylX + cylW + 26, 0);
    blockGrad.addColorStop(0, '#232b3d');
    blockGrad.addColorStop(0.5, '#2d3748');
    blockGrad.addColorStop(1, '#1e2533');
    ctx.fillStyle = blockGrad;
    ctx.fillRect(cylX - 20, cylY - 34, cylW + 40, clearH + travel + pistonH + 30);
    ctx.strokeStyle = '#3f4a63'; ctx.lineWidth = 1.5;
    ctx.strokeRect(cylX - 20, cylY - 34, cylW + 40, clearH + travel + pistonH + 30);

    /* Cooling fins */
    ctx.strokeStyle = 'rgba(90,105,140,0.35)'; ctx.lineWidth = 1;
    for (var fi = 0; fi < 6; fi++) {
      var fy = cylY - 20 + fi * ((clearH + travel) / 6);
      ctx.beginPath(); ctx.moveTo(cylX - 18, fy); ctx.lineTo(cylX - 6, fy); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(cylX + cylW + 6, fy); ctx.lineTo(cylX + cylW + 18, fy); ctx.stroke();
    }

    /* ── Gas in the cylinder — colour and opacity track real pressure ── */
    var sNow = stateAt(a);
    var pFrac = Math.max(0, Math.min(1, (sNow.P - 50) / (Math.max(c.P3, 200) - 50)));
    var gasTop = cylY, gasBot = pistonY;
    var gg = ctx.createLinearGradient(0, gasTop, 0, gasBot);
    if (sName === 'Power') {
      gg.addColorStop(0, 'rgba(255,87,34,' + (0.25 + pFrac * 0.55) + ')');
      gg.addColorStop(1, 'rgba(255,152,0,' + (0.12 + pFrac * 0.3) + ')');
    } else if (sName === 'Compression') {
      gg.addColorStop(0, 'rgba(255,167,38,' + (0.12 + pFrac * 0.5) + ')');
      gg.addColorStop(1, 'rgba(255,183,77,' + (0.06 + pFrac * 0.28) + ')');
    } else if (sName === 'Intake') {
      gg.addColorStop(0, 'rgba(66,165,245,0.26)');
      gg.addColorStop(1, 'rgba(66,165,245,0.12)');
    } else {
      gg.addColorStop(0, 'rgba(120,144,156,0.30)');
      gg.addColorStop(1, 'rgba(120,144,156,0.13)');
    }
    ctx.fillStyle = gg;
    ctx.fillRect(cylX + 2, gasTop, cylW - 4, Math.max(0, gasBot - gasTop));

    /* Cylinder bore walls */
    ctx.strokeStyle = '#5a6b8c'; ctx.lineWidth = 3;
    ctx.beginPath(); ctx.moveTo(cylX, cylY - 2); ctx.lineTo(cylX, cylY + clearH + travel + pistonH); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(cylX + cylW, cylY - 2); ctx.lineTo(cylX + cylW, cylY + clearH + travel + pistonH); ctx.stroke();

    /* Cylinder head */
    ctx.fillStyle = '#39435c';
    ctx.fillRect(cylX - 12, cylY - 18, cylW + 24, 18);
    ctx.strokeStyle = '#5a6b8c'; ctx.lineWidth = 1.5;
    ctx.strokeRect(cylX - 12, cylY - 18, cylW + 24, 18);

    drawParticles();

    /* ── Valves ── */
    function drawValve(vx, lift, color, isIntake) {
      var open = lift * valveTravel;
      ctx.save();
      /* port */
      ctx.fillStyle = 'rgba(20,26,40,0.9)';
      ctx.fillRect(vx - valveW / 2 - 2, cylY - 34, valveW + 4, 20);
      /* stem */
      ctx.fillStyle = '#8fa1bd';
      ctx.fillRect(vx - 2, cylY - 40 + open, 4, 30);
      /* head */
      ctx.fillStyle = lift > 0.02 ? color : '#63758f';
      ctx.beginPath();
      ctx.moveTo(vx - valveW / 2, cylY - 8 + open);
      ctx.lineTo(vx + valveW / 2, cylY - 8 + open);
      ctx.lineTo(vx + valveW / 2 - 3, cylY - 1 + open);
      ctx.lineTo(vx - valveW / 2 + 3, cylY - 1 + open);
      ctx.closePath(); ctx.fill();
      if (lift > 0.05) {
        ctx.strokeStyle = color; ctx.lineWidth = 2; ctx.globalAlpha = 0.5 + lift * 0.5;
        ctx.setLineDash([4, 3]);
        ctx.beginPath();
        if (isIntake) { ctx.moveTo(vx, cylY - 44); ctx.lineTo(vx, cylY + 14); }
        else          { ctx.moveTo(vx, cylY + 14); ctx.lineTo(vx, cylY - 44); }
        ctx.stroke(); ctx.setLineDash([]);
        ctx.fillStyle = color;
        ctx.beginPath();
        if (isIntake) { ctx.moveTo(vx - 5, cylY + 8); ctx.lineTo(vx + 5, cylY + 8); ctx.lineTo(vx, cylY + 17); }
        else          { ctx.moveTo(vx - 5, cylY - 38); ctx.lineTo(vx + 5, cylY - 38); ctx.lineTo(vx, cylY - 47); }
        ctx.fill();
      }
      ctx.restore();
      if (st.showLabels) {
        haloText(isIntake ? 'IN' : 'EX', vx, cylY - 48, 'bold 10px sans-serif',
                 lift > 0.02 ? color : '#7b8aa8', 'center');
      }
    }
    drawValve(inX, iL, '#42a5f5', true);
    drawValve(exX, eL, '#ef5350', false);

    /* ── Spark plug / injector ── */
    var spX = cylX + cylW / 2;
    var headTop = cylY - 18;              /* top face of the cylinder head */
    var plugScale = Math.max(0.75, Math.min(1.5, cylW / 120));
    var chamber = { x: cylX + 2, y: cylY, w: cylW - 4, h: Math.max(2, pistonY - cylY) };
    if (st.fuel === 'petrol') drawSparkPlug(spX, headTop, cylY, a, plugScale, cylW, chamber);
    else drawInjector(spX, headTop, cylY, a, c, plugScale, cylW, clearH + travel * 0.42, chamber);

    /* ── Piston ── */
    var pg = ctx.createLinearGradient(0, pistonY, 0, pistonY + pistonH);
    pg.addColorStop(0, '#7d8ea6'); pg.addColorStop(0.35, '#546e7a'); pg.addColorStop(1, '#33424d');
    ctx.fillStyle = pg;
    ctx.fillRect(cylX + 2, pistonY, cylW - 4, pistonH);
    ctx.strokeStyle = '#94a6bd'; ctx.lineWidth = 1;
    ctx.strokeRect(cylX + 2, pistonY, cylW - 4, pistonH);
    ctx.strokeStyle = 'rgba(190,205,225,0.75)'; ctx.lineWidth = 1.4;
    for (var ri = 0; ri < 3; ri++) {
      var ry = pistonY + 4 + ri * 4;
      ctx.beginPath(); ctx.moveTo(cylX + 4, ry); ctx.lineTo(cylX + cylW - 4, ry); ctx.stroke();
    }

    /* Direction arrow */
    var down = (sName === 'Intake' || sName === 'Power');
    var ax = cylX + cylW + 34, amy = pistonY + pistonH / 2, dir = down ? 1 : -1;
    ctx.save();
    ctx.strokeStyle = sColor; ctx.fillStyle = sColor; ctx.lineWidth = 3;
    ctx.beginPath(); ctx.moveTo(ax, amy - 14 * dir); ctx.lineTo(ax, amy + 10 * dir); ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(ax - 7, amy + 10 * dir); ctx.lineTo(ax + 7, amy + 10 * dir);
    ctx.lineTo(ax, amy + 20 * dir); ctx.closePath(); ctx.fill();
    ctx.restore();

    /* ── Connecting rod, crank, flywheel ── */
    var pinX = cylX + cylW / 2, pinY = pistonY + pistonH * 0.55;
    ctx.strokeStyle = '#8b9dc3'; ctx.lineWidth = 6; ctx.lineCap = 'round';
    ctx.beginPath(); ctx.moveTo(pinX, pinY); ctx.lineTo(crankPinX, crankPinY); ctx.stroke();
    ctx.strokeStyle = '#5f7188'; ctx.lineWidth = 2;
    ctx.beginPath(); ctx.moveTo(pinX, pinY); ctx.lineTo(crankPinX, crankPinY); ctx.stroke();
    ctx.fillStyle = '#b0bec5';
    ctx.beginPath(); ctx.arc(pinX, pinY, 4.5, 0, Math.PI * 2); ctx.fill();

    ctx.strokeStyle = '#3f4a63'; ctx.lineWidth = 2;
    ctx.beginPath(); ctx.arc(crankCX, crankCY, crankR + 22, 0, Math.PI * 2); ctx.stroke();
    /* counterweight */
    var cwA = crankRad + Math.PI;
    ctx.fillStyle = '#37474f';
    ctx.beginPath();
    ctx.arc(crankCX + crankR * 0.62 * Math.sin(cwA), crankCY - crankR * 0.62 * Math.cos(cwA),
            crankR * 0.55, 0, Math.PI * 2);
    ctx.fill();
    ctx.strokeStyle = '#546e7a'; ctx.lineWidth = 1; ctx.stroke();
    /* crank arm */
    ctx.strokeStyle = '#607d8b'; ctx.lineWidth = 9; ctx.lineCap = 'round';
    ctx.beginPath(); ctx.moveTo(crankCX, crankCY); ctx.lineTo(crankPinX, crankPinY); ctx.stroke();
    ctx.fillStyle = '#37474f';
    ctx.beginPath(); ctx.arc(crankCX, crankCY, 9, 0, Math.PI * 2); ctx.fill();
    ctx.strokeStyle = '#90a4ae'; ctx.lineWidth = 2; ctx.stroke();
    ctx.fillStyle = '#b0bec5';
    ctx.beginPath(); ctx.arc(crankPinX, crankPinY, 5.5, 0, Math.PI * 2); ctx.fill();

    /* rotation direction */
    ctx.save();
    ctx.strokeStyle = sColor; ctx.lineWidth = 2; ctx.globalAlpha = 0.85;
    ctx.beginPath(); ctx.arc(crankCX, crankCY, crankR + 30, -Math.PI / 3, Math.PI / 6); ctx.stroke();
    var aa = Math.PI / 6, ar = crankR + 30;
    ctx.fillStyle = sColor;
    ctx.beginPath();
    ctx.moveTo(crankCX + ar * Math.cos(aa), crankCY + ar * Math.sin(aa));
    ctx.lineTo(crankCX + (ar - 7) * Math.cos(aa - 0.17), crankCY + (ar - 7) * Math.sin(aa - 0.17));
    ctx.lineTo(crankCX + (ar + 7) * Math.cos(aa - 0.17), crankCY + (ar + 7) * Math.sin(aa - 0.17));
    ctx.fill();
    ctx.restore();

    /* ── TDC / BDC reference lines ── */
    if (st.showLabels) {
      ctx.save();
      ctx.setLineDash([4, 4]); ctx.lineWidth = 1; ctx.strokeStyle = 'rgba(139,157,195,0.45)';
      ctx.beginPath(); ctx.moveTo(cylX - 34, cylY + clearH); ctx.lineTo(cylX + cylW + 12, cylY + clearH); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(cylX - 34, cylY + clearH + travel); ctx.lineTo(cylX + cylW + 12, cylY + clearH + travel); ctx.stroke();
      ctx.restore();
      haloText('TDC', cylX - 38, cylY + clearH + 4, 'bold 10px sans-serif', '#8b9dc3', 'right');
      haloText('BDC', cylX - 38, cylY + clearH + travel + 4, 'bold 10px sans-serif', '#8b9dc3', 'right');
      haloText('Vₑ', cylX + cylW + 16, cylY + clearH / 2 + 4, 'italic 10px serif', '#8b9dc3', 'left');
    }

    /* ── Engine spec block + stroke dimension in the spare width ──
       lu / ld are shared by the spec card and the stroke dimension, so
       they are declared before either block can be skipped. */
    var lu = UN.len(), ld = imp() ? 3 : 1;
    var specW = 140;
    if (st.showLabels && (x + w - specW - 6) > (cylX + cylW + 24)) {
      var bx = x + w - specW - 4, by = cylY - 10;
      ctx.save();
      ctx.fillStyle = 'rgba(13,17,30,0.78)';
      ctx.strokeStyle = 'rgba(139,157,195,0.22)'; ctx.lineWidth = 1;
      if (ctx.roundRect) { ctx.beginPath(); ctx.roundRect(bx, by, specW, 122, 8); ctx.fill(); ctx.stroke(); }
      else { ctx.fillRect(bx, by, specW, 122); ctx.strokeRect(bx, by, specW, 122); }
      ctx.restore();
      var specs = [
        ['B × L (' + lu.l + ')', (st.bore * lu.k).toFixed(ld) + ' × ' + (st.strokeLen * lu.k).toFixed(ld)],
        ['Cylinders', String(st.nCyl)],
        ['Displ.', fmtU(c.g.dispL, UN.disp)],
        ['CR', st.cr.toFixed(1) + ' : 1'],
        ['Vs / cyl', fmtU(c.g.Vs * 1e6, UN.vol)],
        ['Vc', fmtU(c.g.Vc * 1e6, UN.vol)]
      ];
      for (var si2 = 0; si2 < specs.length; si2++) {
        var ry = by + 19 + si2 * 17;
        ctx.font = '9px sans-serif'; ctx.fillStyle = '#8b9dc3'; ctx.textAlign = 'left';
        ctx.fillText(specs[si2][0], bx + 9, ry);
        ctx.font = 'bold 9.5px monospace'; ctx.fillStyle = '#dde3f0'; ctx.textAlign = 'right';
        ctx.fillText(specs[si2][1], bx + specW - 9, ry);
      }
      ctx.textAlign = 'left';

    }

    if (st.showLabels) {
      /* Stroke dimension line between the TDC and BDC reference lines. */
      var dx = cylX - 62;
      ctx.save();
      ctx.strokeStyle = 'rgba(139,157,195,0.6)'; ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(dx, cylY + clearH); ctx.lineTo(dx, cylY + clearH + travel); ctx.stroke();
      ctx.fillStyle = 'rgba(139,157,195,0.6)';
      ctx.beginPath(); ctx.moveTo(dx - 3.5, cylY + clearH + 7); ctx.lineTo(dx + 3.5, cylY + clearH + 7); ctx.lineTo(dx, cylY + clearH); ctx.fill();
      ctx.beginPath(); ctx.moveTo(dx - 3.5, cylY + clearH + travel - 7); ctx.lineTo(dx + 3.5, cylY + clearH + travel - 7); ctx.lineTo(dx, cylY + clearH + travel); ctx.fill();
      ctx.restore();
      ctx.save();
      ctx.translate(dx - 6, cylY + clearH + travel / 2); ctx.rotate(-Math.PI / 2);
      haloText('stroke ' + (st.strokeLen * lu.k).toFixed(ld) + ' ' + lu.l, 0, 0, 'bold 9px sans-serif', '#8b9dc3', 'center');
      ctx.restore();
    }

    /* ── Stroke title + live state ── */
    haloText(sName.toUpperCase() + ' STROKE', cylX + cylW / 2, y + h - 34,
             'bold 16px sans-serif', sColor, 'center');
    haloText(Math.round(crankAngle) + '° crank  ·  ' + fmtU(sNow.V * 1e6, UN.vol) +
             '  ·  ' + fmtU(sNow.P, UN.press) + '  ·  ' + fmtU(sNow.T, UN.temp),
             cylX + cylW / 2, y + h - 15, '12px monospace', '#b6c3e0', 'center');

    /* ── On-canvas classical equation (Unicode — canvas cannot do LaTeX) ── */
    if (st.showEquation) drawCanvasEquation(x + 8, y + 14, w - 16, c);
  }

  /* Classical efficiency equation in textbook typography. */
  function drawCanvasEquation(x, y, w, c) {
    var C_ETA = '#3ddc84', C_R = '#42a5f5', C_EQ = '#ffd54f', C_VAL = '#e6edf6';
    var sz = narrow ? { v: 14, s: 9, val: 11 } : { v: 16, s: 10, val: 12 };
    var varFont = 'italic 700 ' + sz.v + 'px "Cambria Math","Times New Roman",serif';
    var supFont = '700 ' + sz.s + 'px "Cambria Math","Times New Roman",serif';
    var valFont = '700 ' + sz.val + 'px "JetBrains Mono","Courier New",monospace';

    var parts;
    if (c.otto) {
      parts = [
        { t: 'η', f: varFont, c: C_ETA }, { t: 'th', f: supFont, c: C_ETA, sub: 1 },
        { t: ' = 1 − 1 / ', f: varFont, c: C_EQ },
        { t: 'r', f: varFont, c: C_R }, { t: 'γ−1', f: supFont, c: C_R, sup: 1 },
        { t: '   → ', f: varFont, c: C_EQ },
        { t: (c.etaTh * 100).toFixed(1) + ' %', f: valFont, c: C_VAL }
      ];
    } else {
      parts = [
        { t: 'η', f: varFont, c: C_ETA }, { t: 'th', f: supFont, c: C_ETA, sub: 1 },
        { t: ' = 1 − ', f: varFont, c: C_EQ },
        { t: '(1/', f: varFont, c: C_R }, { t: 'r', f: varFont, c: C_R },
        { t: 'γ−1', f: supFont, c: C_R, sup: 1 }, { t: ')', f: varFont, c: C_R },
        { t: '·[(', f: varFont, c: C_EQ },
        { t: 'ρ', f: varFont, c: '#ff8a65' }, { t: 'γ', f: supFont, c: '#ff8a65', sup: 1 },
        { t: '−1)/γ(', f: varFont, c: C_EQ },
        { t: 'ρ', f: varFont, c: '#ff8a65' }, { t: '−1)]', f: varFont, c: C_EQ },
        { t: '  → ', f: varFont, c: C_EQ },
        { t: (c.etaTh * 100).toFixed(1) + ' %', f: valFont, c: C_VAL }
      ];
    }
    var total = 0, i;
    for (i = 0; i < parts.length; i++) { ctx.font = parts[i].f; total += ctx.measureText(parts[i].t).width; }
    if (total > w) {   /* uniform shrink to the available gap */
      var k = Math.max(0.6, w / total);
      sz = { v: Math.max(10, Math.round(sz.v * k)), s: Math.max(7, Math.round(sz.s * k)),
             val: Math.max(9, Math.round(sz.val * k)) };
      varFont = 'italic 700 ' + sz.v + 'px "Cambria Math","Times New Roman",serif';
      supFont = '700 ' + sz.s + 'px "Cambria Math","Times New Roman",serif';
      valFont = '700 ' + sz.val + 'px "JetBrains Mono","Courier New",monospace';
      for (i = 0; i < parts.length; i++) {
        parts[i].f = (parts[i].f.indexOf('Mono') >= 0) ? valFont
                   : (parts[i].sup || parts[i].sub) ? supFont : varFont;
      }
      total = 0;
      for (i = 0; i < parts.length; i++) { ctx.font = parts[i].f; total += ctx.measureText(parts[i].t).width; }
    }
    var px = Math.round(x + (w - total) / 2), py = y + sz.v;
    ctx.textAlign = 'left'; ctx.textBaseline = 'alphabetic';
    for (i = 0; i < parts.length; i++) {
      var p = parts[i];
      var dy = p.sup ? -Math.round(sz.v * 0.42) : p.sub ? Math.round(sz.v * 0.22) : 0;
      haloText(p.t, px, py + dy, p.f, p.c, 'left');
      ctx.font = p.f; px += ctx.measureText(p.t).width;
    }
  }

  /* ── Spark plug ────────────────────────────────────────────────
     Drawn as the real component: terminal nut, ribbed ceramic
     insulator, hex body, threaded shank, and the centre and earth
     electrodes with a gap between them. The spark is an arc jumping
     that gap — the thing the part exists to do — not a glow pasted
     over the chamber. Ignition is shown from 10 deg before TDC, which is
     the spark advance a real engine runs. */
  function drawSparkPlug(x, headTop, boreTop, a, k, cylW, chamber) {
    var w      = 13 * k;                    /* hex flat-to-flat */
    var tipY   = boreTop + 5 * k;           /* centre electrode tip, in the chamber */
    var shankY = boreTop - 1;               /* where the thread meets the head */
    var topY   = headTop - 26 * k;

    ctx.save();
    /* terminal nut */
    ctx.fillStyle = '#9aa7b8';
    ctx.fillRect(x - 2.6 * k, topY, 5.2 * k, 4 * k);
    /* ceramic insulator, ribbed */
    var ins = ctx.createLinearGradient(x - w / 2, 0, x + w / 2, 0);
    ins.addColorStop(0, '#b9b3a4'); ins.addColorStop(0.35, '#efeadc');
    ins.addColorStop(0.75, '#d8d2c2'); ins.addColorStop(1, '#a9a394');
    ctx.fillStyle = ins;
    ctx.beginPath();
    ctx.moveTo(x - 3.4 * k, topY + 4 * k);
    ctx.lineTo(x + 3.4 * k, topY + 4 * k);
    ctx.lineTo(x + 4.6 * k, topY + 8 * k);
    ctx.lineTo(x + 4.6 * k, headTop - 1);
    ctx.lineTo(x - 4.6 * k, headTop - 1);
    ctx.lineTo(x - 4.6 * k, topY + 8 * k);
    ctx.closePath(); ctx.fill();
    ctx.strokeStyle = 'rgba(90,85,72,0.55)'; ctx.lineWidth = 0.8;
    for (var rb = 0; rb < 3; rb++) {
      var ry = topY + (9 + rb * 3.6) * k;
      if (ry > headTop - 3) break;
      ctx.beginPath(); ctx.moveTo(x - 4.6 * k, ry); ctx.lineTo(x + 4.6 * k, ry); ctx.stroke();
    }
    /* hex body */
    var hexG = ctx.createLinearGradient(x - w / 2, 0, x + w / 2, 0);
    hexG.addColorStop(0, '#6b7686'); hexG.addColorStop(0.4, '#aab4c2');
    hexG.addColorStop(0.75, '#7d8796'); hexG.addColorStop(1, '#5d6774');
    ctx.fillStyle = hexG;
    ctx.fillRect(x - w / 2, headTop - 1, w, 7 * k);
    ctx.strokeStyle = 'rgba(30,36,48,0.7)'; ctx.lineWidth = 0.8;
    ctx.strokeRect(x - w / 2, headTop - 1, w, 7 * k);
    /* threaded shank */
    ctx.fillStyle = '#78828f';
    ctx.fillRect(x - 4 * k, headTop + 6 * k, 8 * k, shankY - (headTop + 6 * k));
    ctx.strokeStyle = 'rgba(28,34,44,0.65)'; ctx.lineWidth = 0.9;
    for (var th = headTop + 8 * k; th < shankY - 1; th += 2.4 * k) {
      ctx.beginPath(); ctx.moveTo(x - 4 * k, th); ctx.lineTo(x + 4 * k, th + 1.1 * k); ctx.stroke();
    }
    /* centre electrode */
    ctx.fillStyle = '#cfd6de';
    ctx.fillRect(x - 0.9 * k, shankY, 1.8 * k, tipY - shankY);
    /* earth (ground) electrode — an L strap bent under the centre tip */
    var gapY = tipY + 2.6 * k;
    ctx.strokeStyle = '#b6bfca'; ctx.lineWidth = 2 * k; ctx.lineCap = 'butt';
    ctx.beginPath();
    ctx.moveTo(x + 3.4 * k, shankY);
    ctx.lineTo(x + 3.4 * k, gapY);
    ctx.lineTo(x - 1.6 * k, gapY);
    ctx.stroke();
    ctx.restore();

    /* ── The spark itself ── */
    var adv = 10;                                   /* deg BTDC */
    var fire = (a >= 360 - adv && a < 360 + 14);
    if (fire) {
      var t = (a - (360 - adv)) / (adv + 14);        /* 0..1 through the event */
      var energy = Math.max(0, 1 - t);
      /* Flame kernel, clipped to the gas above the piston so it cannot
         wash over the crown and the rings. */
      ctx.save();
      ctx.beginPath();
      ctx.rect(chamber.x, chamber.y, chamber.w, chamber.h);
      ctx.clip();
      var bl = ctx.createRadialGradient(x, gapY, 0, x, gapY, cylW * 0.45);
      bl.addColorStop(0, 'rgba(255,250,205,' + (0.6 * energy) + ')');
      bl.addColorStop(0.4, 'rgba(255,178,66,' + (0.32 * energy) + ')');
      bl.addColorStop(1, 'rgba(255,87,34,0)');
      ctx.fillStyle = bl;
      ctx.beginPath(); ctx.arc(x, gapY, cylW * 0.45, 0, Math.PI * 2); ctx.fill();
      ctx.restore();

      ctx.save();
      /* the arc across the gap — jagged, seeded from the crank angle so it
         flickers while the engine turns but never changes on a still frame */
      var seed = Math.floor(a * 3);
      function rnd(i) { var v = Math.sin((seed + i) * 12.9898) * 43758.5453; return v - Math.floor(v); }
      var pts = [[x, tipY]];
      var segs = 4;
      for (var sg2 = 1; sg2 <= segs; sg2++) {
        var f = sg2 / segs;
        pts.push([x + (rnd(sg2) - 0.5) * 3.2 * k * (1 - Math.abs(f - 0.5) * 1.2),
                  tipY + (gapY - tipY) * f]);
      }
      function traceArc() {
        ctx.beginPath();
        ctx.moveTo(pts[0][0], pts[0][1]);
        for (var q = 1; q < pts.length; q++) ctx.lineTo(pts[q][0], pts[q][1]);
        ctx.stroke();
      }
      ctx.lineJoin = 'round'; ctx.lineCap = 'round';
      /* ionised-air halo, then the white-hot core on top of it */
      ctx.strokeStyle = 'rgba(130,205,255,' + (0.5 + 0.5 * energy) + ')';
      ctx.lineWidth = 4.2 * k;
      ctx.shadowColor = 'rgba(140,210,255,0.95)'; ctx.shadowBlur = 10 * k;
      traceArc();
      ctx.shadowBlur = 0;
      ctx.strokeStyle = 'rgba(255,255,255,' + (0.8 + 0.2 * energy) + ')';
      ctx.lineWidth = 1.5 * k;
      traceArc();
      ctx.restore();
    }
    if (st.showLabels) {
      haloText('SPARK PLUG', x, headTop - 30 * k, 'bold 9px sans-serif', '#fdd835', 'center');
      if (fire) haloText(adv + '° BTDC', x + w, boreTop + 10 * k, 'bold 8px sans-serif', '#fdd835', 'left');
    }
  }

  /* ── Diesel injector ───────────────────────────────────────────
     Body, high-pressure fuel inlet, needle-valve stem and a nozzle that
     tapers to the tip. While injection is open the tip throws a real
     spray: overlapping droplet plumes fanning out from the holes, dense
     at the nozzle and breaking up as they penetrate. */
  function drawInjector(x, headTop, boreTop, a, c, k, cylW, maxReach, chamber) {
    var topY  = headTop - 30 * k;
    var tipY  = boreTop + 4 * k;
    var bodyW = 11 * k;

    ctx.save();
    /* high-pressure fuel line */
    ctx.strokeStyle = '#7e8b99'; ctx.lineWidth = 2.6 * k; ctx.lineCap = 'round';
    ctx.beginPath();
    ctx.moveTo(x + 7 * k, topY + 2 * k);
    ctx.lineTo(x + 1.5 * k, topY + 2 * k);
    ctx.stroke();
    ctx.fillStyle = '#66bb6a';
    ctx.beginPath(); ctx.arc(x + 8 * k, topY + 2 * k, 2 * k, 0, Math.PI * 2); ctx.fill();
    /* body */
    var bg = ctx.createLinearGradient(x - bodyW / 2, 0, x + bodyW / 2, 0);
    bg.addColorStop(0, '#4b5666'); bg.addColorStop(0.4, '#8794a5');
    bg.addColorStop(0.75, '#5f6a79'); bg.addColorStop(1, '#3f4855');
    ctx.fillStyle = bg;
    ctx.fillRect(x - bodyW / 2, topY, bodyW, headTop - topY);
    ctx.strokeStyle = 'rgba(26,32,42,0.75)'; ctx.lineWidth = 0.8;
    ctx.strokeRect(x - bodyW / 2, topY, bodyW, headTop - topY);
    /* clamp collar */
    ctx.fillStyle = '#9aa7b8';
    ctx.fillRect(x - (bodyW / 2 + 2.4 * k), headTop - 7 * k, bodyW + 4.8 * k, 5 * k);
    /* nozzle: parallel shank tapering to the tip */
    ctx.fillStyle = '#6f7a89';
    ctx.beginPath();
    ctx.moveTo(x - 3.6 * k, headTop);
    ctx.lineTo(x + 3.6 * k, headTop);
    ctx.lineTo(x + 3.6 * k, boreTop - 1);
    ctx.lineTo(x + 1.5 * k, tipY);
    ctx.lineTo(x - 1.5 * k, tipY);
    ctx.lineTo(x - 3.6 * k, boreTop - 1);
    ctx.closePath(); ctx.fill();
    ctx.strokeStyle = 'rgba(26,32,42,0.7)'; ctx.lineWidth = 0.8; ctx.stroke();
    ctx.restore();

    /* Injection runs from TDC until the cylinder reaches the cutoff
       volume — the same interval the constant-pressure burn occupies. */
    var cutoffAngle = 360;
    if (!c.otto) {
      for (var ca = 361; ca < 540; ca += 1) { if (volAt(ca) >= c.V3) { cutoffAngle = ca; break; } }
    }
    var injecting = (a >= 358 && a <= cutoffAngle);
    if (injecting) {
      var prog = Math.min(1, (a - 358) / Math.max(1, cutoffAngle - 358));
      var reach = maxReach * (0.45 + 0.55 * Math.min(1, prog * 2.4));
      var seedI = Math.floor(a * 2);
      function rndI(i) { var v = Math.sin((seedI + i) * 78.233) * 43758.5453; return v - Math.floor(v); }
      ctx.save();
      ctx.beginPath();
      ctx.rect(chamber.x, chamber.y, chamber.w, chamber.h);
      ctx.clip();
      ctx.globalCompositeOperation = 'lighter';
      /* Multi-hole nozzle: several plumes fanning out from the tip. */
      var holes = 5;
      for (var h = 0; h < holes; h++) {
        var ang = (-0.62 + (1.24 * h) / (holes - 1));      /* radians from vertical */
        var len = reach * (0.78 + 0.22 * rndI(h));
        var ex = x + Math.sin(ang) * len, ey = tipY + Math.cos(ang) * len;
        var pg = ctx.createLinearGradient(x, tipY, ex, ey);
        pg.addColorStop(0, 'rgba(198,232,201,0.55)');
        pg.addColorStop(0.45, 'rgba(129,199,132,0.26)');
        pg.addColorStop(1, 'rgba(102,187,106,0)');
        ctx.fillStyle = pg;
        var spread = len * 0.17;
        ctx.beginPath();
        ctx.moveTo(x + Math.cos(ang) * 1.1 * k, tipY - Math.sin(ang) * 1.1 * k);
        ctx.lineTo(ex + Math.cos(ang) * spread, ey - Math.sin(ang) * spread);
        ctx.lineTo(ex - Math.cos(ang) * spread, ey + Math.sin(ang) * spread);
        ctx.lineTo(x - Math.cos(ang) * 1.1 * k, tipY + Math.sin(ang) * 1.1 * k);
        ctx.closePath(); ctx.fill();
        /* droplets breaking up along the plume */
        for (var d = 0; d < 7; d++) {
          var f2 = 0.25 + 0.75 * rndI(h * 11 + d);
          var jitter = (rndI(h * 23 + d) - 0.5) * spread * 1.7 * f2;
          ctx.fillStyle = 'rgba(220,245,222,' + (0.5 * (1 - f2)) + ')';
          ctx.beginPath();
          ctx.arc(x + Math.sin(ang) * len * f2 + Math.cos(ang) * jitter,
                  tipY + Math.cos(ang) * len * f2 - Math.sin(ang) * jitter,
                  (0.7 + rndI(h * 31 + d) * 1.1) * k, 0, Math.PI * 2);
          ctx.fill();
        }
      }
      ctx.restore();
    }
    if (st.showLabels) {
      haloText('INJECTOR', x, topY - 5 * k, 'bold 9px sans-serif', '#66bb6a', 'center');
      if (injecting) haloText('INJECTING', x + bodyW, boreTop + 10 * k, 'bold 8px sans-serif', '#a5d6a7', 'left');
    }
  }

  /* ── Stroke progress indicator ── */
  function drawStrokeIndicator(x, y, w) {
    var names = ['Intake', 'Compression', 'Power', 'Exhaust'];
    var cols = ['#42a5f5', '#ffa726', '#ef5350', '#78909c'];
    var a = ((crankAngle % 720) + 720) % 720;
    var idx = Math.floor(a / 180);
    var sw = w / 4;
    for (var i = 0; i < 4; i++) {
      var sx = x + i * sw;
      ctx.fillStyle = (i === idx) ? cols[i] : 'rgba(100,116,139,0.28)';
      ctx.beginPath();
      if (ctx.roundRect) { ctx.roundRect(sx + 2, y, sw - 4, 20, 5); ctx.fill(); }
      else ctx.fillRect(sx + 2, y, sw - 4, 20);
      if (i === idx) {   /* progress fill within the active stroke */
        ctx.save();
        ctx.globalAlpha = 0.35; ctx.fillStyle = '#fff';
        ctx.fillRect(sx + 2, y, (sw - 4) * ((a % 180) / 180), 20);
        ctx.restore();
      }
      ctx.font = (i === idx) ? 'bold 11px sans-serif' : '11px sans-serif';
      ctx.fillStyle = (i === idx) ? '#0d1117' : '#7b8aa8';
      ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.fillText(names[i], sx + sw / 2, y + 10);
    }
    ctx.textBaseline = 'alphabetic';
  }

  /* ── Traced cycle path (used by the P-V pane and the CSV export) ── */
  function cyclePath() {
    var c = computeCycle(), pts = [], a;
    for (a = 0; a <= 360; a += 1.5) { var s1 = stateAt(a); pts.push({ a: a, V: s1.V, P: s1.P, T: s1.T }); }
    /* Explicit heat-addition segment so 2→3 renders exactly vertical
       (Otto) or exactly horizontal (Diesel) instead of being sampled. */
    if (c.otto) {
      pts.push({ a: 360, V: c.V2, P: c.P2, T: c.T2, seg: 'burn' });
      pts.push({ a: 360, V: c.V2, P: c.P3, T: c.T3, seg: 'burn' });
    } else {
      pts.push({ a: 360, V: c.V2, P: c.P2, T: c.T2, seg: 'burn' });
      pts.push({ a: 360, V: c.V3, P: c.P3, T: c.T3, seg: 'burn' });
    }
    for (a = 361; a <= 720; a += 1.5) { var s2 = stateAt(a); pts.push({ a: a, V: s2.V, P: s2.P, T: s2.T }); }
    return pts;
  }

  /* Numbered state markers. States 1 and 4 sit almost on top of each
     other whenever the expansion pressure is close to the intake
     pressure, so a colliding marker is pushed clear along the leader. */
  function drawStateMarks(marks) {
    var placed = [];
    for (var i = 0; i < marks.length; i++) {
      var m = marks[i], lx = m.x, ly = m.y, tries = 0;
      while (tries < 8) {
        var clash = false;
        for (var j = 0; j < placed.length; j++) {
          if (Math.abs(placed[j].x - lx) < 16 && Math.abs(placed[j].y - ly) < 16) { clash = true; break; }
        }
        if (!clash) break;
        ly -= 17; tries++;
      }
      if (ly !== m.y) {
        ctx.strokeStyle = 'rgba(255,213,79,0.65)'; ctx.lineWidth = 1;
        ctx.beginPath(); ctx.moveTo(m.x, m.y); ctx.lineTo(lx, ly + 7); ctx.stroke();
        ctx.fillStyle = '#ffd54f';
        ctx.beginPath(); ctx.arc(m.x, m.y, 2.5, 0, Math.PI * 2); ctx.fill();
      }
      ctx.fillStyle = '#0d1117'; ctx.strokeStyle = '#ffd54f'; ctx.lineWidth = 1.8;
      ctx.beginPath(); ctx.arc(lx, ly, 7, 0, Math.PI * 2); ctx.fill(); ctx.stroke();
      ctx.fillStyle = '#ffd54f'; ctx.font = 'bold 9px sans-serif';
      ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.fillText(m.n, lx, ly);
      placed.push({ x: lx, y: ly });
    }
    ctx.textBaseline = 'alphabetic';
  }

  /* Top inset the diagram pane must leave for the in-canvas selector,
     in logical units. Measured from the overlay itself in
     positionPaneToggle() rather than hard-coded, because its height
     depends on the font, the label text and the breakpoint — a guessed
     constant was too small on a phone and the selector sat on state 3. */
  var _paneTopInset = 54;
  function paneTopInset() { return _paneTopInset; }

  function paneFrame(x, y, w, h, title, sub) {
    ctx.fillStyle = 'rgba(13,17,30,0.55)';
    ctx.strokeStyle = 'rgba(139,157,195,0.20)'; ctx.lineWidth = 1;
    ctx.beginPath();
    if (ctx.roundRect) { ctx.roundRect(x, y, w, h, 10); ctx.fill(); ctx.stroke(); }
    else { ctx.fillRect(x, y, w, h); ctx.strokeRect(x, y, w, h); }
    /* Right-aligned so it shares the top band with the selector overlay
       on the left instead of costing the plot another line. Drawn on the
       canvas, not in the overlay, so an exported PNG still names the
       diagram. */
    ctx.textAlign = 'right';
    ctx.font = 'bold 13px sans-serif'; ctx.fillStyle = '#dde3f0';
    ctx.fillText(title, x + w - 14, y + 20);
    if (sub) {
      ctx.font = '10px sans-serif'; ctx.fillStyle = '#8b9dc3';
      ctx.fillText(sub, x + w - 14, y + 35);
    }
    ctx.textAlign = 'left';
  }

  /* ── P–V diagram ── */
  function drawPV(x, y, w, h) {
    var c = computeCycle();
    var pu = UN.mep(), vu = UN.vol();
    paneFrame(x, y, w, h,
              (narrow ? '' : 'P–V Diagram — ') + (c.otto ? 'Otto' : 'Diesel') + ' cycle',
              narrow ? 'area = net work' : 'enclosed area = net work per cycle');

    /* padB carries two stacked lines below the plot: the axis title and
       the work / heat callout. The old value also had to clear the
       calculation FAB, which now lives in the toolbar instead. */
    var padL = 52, padR = 16, padT = paneTopInset(), padB = 52;
    var px = x + padL, py = y + padT, pw = w - padL - padR, ph = h - padT - padB;

    var pts = cyclePath();
    var Pmax = Math.max(c.P3, c.P2) * 1.10, Pmin = 0;
    var Vmax = c.V1 * 1.10, Vmin = 0;
    function X(v) { return px + (v - Vmin) / (Vmax - Vmin) * pw; }
    function Y(p) { return py + ph - (p - Pmin) / (Pmax - Pmin) * ph; }

    if (st.showGrid) {
      ctx.save();
      ctx.strokeStyle = 'rgba(139,157,195,0.14)'; ctx.lineWidth = 1; ctx.setLineDash([3, 4]);
      for (var gi = 1; gi <= 4; gi++) {
        var gy = py + ph * (1 - gi / 4);
        ctx.beginPath(); ctx.moveTo(px, gy); ctx.lineTo(px + pw, gy); ctx.stroke();
        var gx = px + pw * gi / 4;
        ctx.beginPath(); ctx.moveTo(gx, py); ctx.lineTo(gx, py + ph); ctx.stroke();
      }
      ctx.restore();
    }

    /* Shade the enclosed work area (the closed part of the cycle only). */
    ctx.save();
    ctx.beginPath();
    var started = false;
    for (var i = 0; i < pts.length; i++) {
      if (pts[i].a < 180 || pts[i].a > 600) continue;
      var xx = X(pts[i].V), yy = Y(pts[i].P);
      if (started) ctx.lineTo(xx, yy); else { ctx.moveTo(xx, yy); started = true; }
    }
    ctx.closePath();
    ctx.fillStyle = 'rgba(61,220,132,0.10)';
    ctx.fill();
    ctx.restore();

    /* Trace, coloured by stroke. */
    ctx.lineWidth = 2.2; ctx.lineJoin = 'round'; ctx.lineCap = 'round';
    for (var k = 1; k < pts.length; k++) {
      var a0 = pts[k - 1], a1 = pts[k];
      if (!st.showPumping && a1.a < 180) continue;
      ctx.strokeStyle = a1.seg === 'burn' ? '#ef5350' : strokeColor(strokeName(a1.a));
      ctx.beginPath();
      ctx.moveTo(X(a0.V), Y(a0.P));
      ctx.lineTo(X(a1.V), Y(a1.P));
      ctx.stroke();
    }

    /* Axes over the trace. */
    ctx.strokeStyle = '#5a6b8c'; ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.moveTo(px, py - 4); ctx.lineTo(px, py + ph); ctx.lineTo(px + pw + 4, py + ph); ctx.stroke();

    /* Ticks */
    ctx.font = '9px monospace'; ctx.fillStyle = '#8b9dc3';
    ctx.textAlign = 'right';
    for (var ti = 0; ti <= 4; ti++) {
      var pv = Pmin + (Pmax - Pmin) * ti / 4;
      ctx.fillText((pv * pu.k).toFixed(pu.d), px - 5, Y(pv) + 3);
    }
    ctx.textAlign = 'center';
    for (var tj = 0; tj <= 4; tj++) {
      var vv = Vmin + (Vmax - Vmin) * tj / 4;
      ctx.fillText((vv * 1e6 * vu.k).toFixed(0), X(vv), py + ph + 13);
    }
    ctx.font = '10px sans-serif'; ctx.fillStyle = '#8b9dc3';
    ctx.fillText('Cylinder volume (' + vu.l + ')', px + pw / 2, py + ph + 28);
    ctx.save();
    ctx.translate(x + 14, py + ph / 2); ctx.rotate(-Math.PI / 2);
    ctx.fillText('Pressure (' + pu.l + ')', 0, 0);
    ctx.restore();

    /* State points 1–4 */
    var marks = [
      { n: '1', V: c.V1, P: c.P1 }, { n: '2', V: c.V2, P: c.P2 },
      { n: '3', V: c.V3, P: c.P3 }, { n: '4', V: c.V4, P: c.P4 }
    ];
    drawStateMarks(marks.map(function (m) { return { n: m.n, x: X(m.V), y: Y(m.P) }; }));

    /* Live cursor */
    var now = stateAt(crankAngle);
    var cx2 = X(now.V), cy2 = Y(now.P);
    ctx.save();
    ctx.shadowColor = 'rgba(255,255,255,0.7)'; ctx.shadowBlur = 8;
    ctx.fillStyle = '#fff';
    ctx.beginPath(); ctx.arc(cx2, cy2, 4.5, 0, Math.PI * 2); ctx.fill();
    ctx.restore();

    /* Work / MEP callout */
    var mepu = UN.mep();
    haloText('Wₙₑₜ = ' + fmtU(c.Wnet, UN.engy) + '/cyl · IMEP = ' +
             (c.imepN * mepu.k).toFixed(mepu.d) + ' ' + mepu.l,
             x + 14, y + h - 8, 'bold 10px monospace', '#3ddc84', 'left');
  }

  /* ── T–s diagram (closed cycle only — entropy per kg is only defined
       while the valves are shut and the mass is fixed) ── */
  function drawTS(x, y, w, h) {
    var c = computeCycle();
    var tu = UN.temp();
    paneFrame(x, y, w, h,
              (narrow ? '' : 'T–s Diagram — ') + (c.otto ? 'Otto' : 'Diesel') + ' cycle',
              narrow ? 'areas = qᵢₙ and qₒᵤₜ' : 'area under 2→3 = qᵢₙ, under 4→1 = qₒᵤₜ');

    /* padB carries two stacked lines below the plot: the axis title and
       the work / heat callout. The old value also had to clear the
       calculation FAB, which now lives in the toolbar instead. */
    var padL = 52, padR = 16, padT = paneTopInset(), padB = 52;
    var px = x + padL, py = y + padT, pw = w - padL - padR, ph = h - padT - padB;

    var sMax = Math.max(c.s3, c.s1) * 1.16 + 0.06, sMin = -0.10;
    var Tmax = c.T3 * 1.12, Tmin = 0;
    function X(s) { return px + (s - sMin) / (sMax - sMin) * pw; }
    function Y(t) { return py + ph - (t - Tmin) / (Tmax - Tmin) * ph; }

    if (st.showGrid) {
      ctx.save();
      ctx.strokeStyle = 'rgba(139,157,195,0.14)'; ctx.setLineDash([3, 4]); ctx.lineWidth = 1;
      for (var gi = 1; gi <= 4; gi++) {
        var gy = py + ph * (1 - gi / 4);
        ctx.beginPath(); ctx.moveTo(px, gy); ctx.lineTo(px + pw, gy); ctx.stroke();
      }
      ctx.restore();
    }

    /* Heat-in area (under 2→3 down to T = 0) */
    function curve23(f) {
      /* Constant volume (Otto): s = s2 + cv ln(T/T2); constant pressure
         (Diesel): s = s2 + cp ln(T/T2). Invert for T at a given s. */
      var T = c.T2 + (c.T3 - c.T2) * f;
      var s = c.otto ? c.s2 + CV * Math.log(T / c.T2) : c.s2 + CP * Math.log(T / c.T2);
      return { T: T, s: s };
    }
    function curve41(f) {
      var T = c.T4 + (c.T1 - c.T4) * f;
      return { T: T, s: c.s4 + CV * Math.log(T / c.T4) };
    }
    var fi;
    ctx.save();
    ctx.beginPath(); ctx.moveTo(X(c.s2), Y(0));
    for (fi = 0; fi <= 1.0001; fi += 0.02) { var q = curve23(fi); ctx.lineTo(X(q.s), Y(q.T)); }
    ctx.lineTo(X(c.s3), Y(0)); ctx.closePath();
    ctx.fillStyle = 'rgba(239,83,80,0.16)'; ctx.fill();
    ctx.beginPath(); ctx.moveTo(X(c.s4), Y(0));
    for (fi = 0; fi <= 1.0001; fi += 0.02) { var q2 = curve41(fi); ctx.lineTo(X(q2.s), Y(q2.T)); }
    ctx.lineTo(X(c.s1), Y(0)); ctx.closePath();
    ctx.fillStyle = 'rgba(66,165,245,0.14)'; ctx.fill();
    ctx.restore();

    /* Processes */
    ctx.lineWidth = 2.4; ctx.lineCap = 'round';
    ctx.strokeStyle = '#ffa726';
    ctx.beginPath(); ctx.moveTo(X(c.s1), Y(c.T1)); ctx.lineTo(X(c.s2), Y(c.T2)); ctx.stroke();
    ctx.strokeStyle = '#ef5350';
    ctx.beginPath();
    for (fi = 0; fi <= 1.0001; fi += 0.02) { var q3 = curve23(fi); if (fi === 0) ctx.moveTo(X(q3.s), Y(q3.T)); else ctx.lineTo(X(q3.s), Y(q3.T)); }
    ctx.stroke();
    ctx.strokeStyle = '#66bb6a';
    ctx.beginPath(); ctx.moveTo(X(c.s3), Y(c.T3)); ctx.lineTo(X(c.s4), Y(c.T4)); ctx.stroke();
    ctx.strokeStyle = '#42a5f5';
    ctx.beginPath();
    for (fi = 0; fi <= 1.0001; fi += 0.02) { var q4 = curve41(fi); if (fi === 0) ctx.moveTo(X(q4.s), Y(q4.T)); else ctx.lineTo(X(q4.s), Y(q4.T)); }
    ctx.stroke();

    ctx.strokeStyle = '#5a6b8c'; ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.moveTo(px, py - 4); ctx.lineTo(px, py + ph); ctx.lineTo(px + pw + 4, py + ph); ctx.stroke();

    ctx.font = '9px monospace'; ctx.fillStyle = '#8b9dc3'; ctx.textAlign = 'right';
    for (var ti = 0; ti <= 4; ti++) {
      var tv = Tmin + (Tmax - Tmin) * ti / 4;
      ctx.fillText((tv * tu.k).toFixed(0), px - 5, Y(tv) + 3);
    }
    ctx.textAlign = 'center';
    ctx.font = '10px sans-serif';
    ctx.fillText('Entropy change s − s₁ (kJ/kg·K)', px + pw / 2, py + ph + 26);
    ctx.save();
    ctx.translate(x + 14, py + ph / 2); ctx.rotate(-Math.PI / 2);
    ctx.fillText('Temperature (' + tu.l + ')', 0, 0);
    ctx.restore();

    var pts = [
      { n: '1', s: c.s1, T: c.T1 }, { n: '2', s: c.s2, T: c.T2 },
      { n: '3', s: c.s3, T: c.T3 }, { n: '4', s: c.s4, T: c.T4 }
    ];
    drawStateMarks(pts.map(function (m) { return { n: m.n, x: X(m.s), y: Y(m.T) }; }));

    /* ── Live state, tracking the crank ──────────────────────────
       The marker used to park at state 1 for the whole of the exhaust and
       intake strokes, which is 56% of every cycle — long enough that the
       diagram read as static next to the P–V and valve panes. It is also
       needlessly coy: the air-standard cycle *replaces* the gas-exchange
       strokes with constant-volume heat rejection 4→1, so the honest thing
       to show while the valves are open is the marker walking down that
       line. It now does, with the trail switching to the 4→1 curve, and
       the caption says which idealisation is on screen. */
    var aNow = ((crankAngle % 720) + 720) % 720;
    /* The hand-over is at BDC, not at EVO: process 3→4 is defined all the
       way down to bottom dead centre, and starting the 4→1 walk early left
       a 52 K step in the marker where the traced expansion had not finished. */
    var sealed = (aNow >= 180 && aNow <= 540);
    var lx, ly, trail = [];
    if (sealed) {
      for (var ta = 180; ta <= aNow; ta += 3) trail.push([X(entropyAt(ta)), Y(idealClosedState(ta).T)]);
      lx = X(entropyAt(aNow)); ly = Y(idealClosedState(aNow).T);
    } else {
      /* Fraction through the gas-exchange part of the cycle: BDC → 720 → 180. */
      var span = 180 + 180;
      var done = (aNow > 540) ? (aNow - 540) : (180 + aNow);
      var f4 = Math.max(0, Math.min(1, done / span));
      for (var q4 = 0; q4 <= f4 + 1e-9; q4 += 0.02) {
        var qq = curve41(Math.min(1, q4));
        trail.push([X(qq.s), Y(qq.T)]);
      }
      var here = curve41(f4);
      lx = X(here.s); ly = Y(here.T);
    }
    if (trail.length > 1) {
      ctx.save();
      ctx.strokeStyle = sealed ? 'rgba(255,255,255,0.5)' : 'rgba(66,165,245,0.65)';
      ctx.lineWidth = 3.2; ctx.lineCap = 'round'; ctx.lineJoin = 'round';
      ctx.beginPath();
      ctx.moveTo(trail[0][0], trail[0][1]);
      for (var tp = 1; tp < trail.length; tp++) ctx.lineTo(trail[tp][0], trail[tp][1]);
      ctx.stroke();
      ctx.restore();
    }
    ctx.save();
    ctx.shadowColor = 'rgba(255,255,255,0.75)'; ctx.shadowBlur = 8;
    ctx.fillStyle = '#fff';
    ctx.beginPath(); ctx.arc(lx, ly, 4.5, 0, Math.PI * 2); ctx.fill();
    ctx.restore();
    var flipL = lx > px + pw * 0.62;
    haloText(sealed ? strokeName(aNow) : strokeName(aNow) + ' \u2014 shown as 4\u21921',
             lx + (flipL ? -9 : 9), ly - 7, 'bold 9px sans-serif',
             sealed ? strokeColor(strokeName(aNow)) : '#42a5f5',
             flipL ? 'right' : 'left');
        haloText('qᵢₙ = ' + fmtU(c.qin, UN.spec) + '   qₒᵤₜ = ' + fmtU(c.qout, UN.spec),
             x + 14, y + h - 8, 'bold 10px monospace', '#3ddc84', 'left');
  }

  /* Entropy of the trapped charge relative to state 1, kJ/(kg·K).
     s − s₁ = c_v ln(T/T₁) + R ln(V/V₁). This reduces to zero along the
     isentropic compression and to c_p ln(T₃/T₂) at the diesel cutoff, so
     the same expression tracks both cycles without special cases. */
  function entropyAt(theta) {
    var c = computeCycle();
    var st2 = idealClosedState(theta);
    return CV * Math.log(st2.T / c.T1) + R_GAS * Math.log(st2.V / c.V1);
  }

  /* ── Valve timing diagram ── */
  function drawValveDiagram(x, y, w, h) {
    var v = valveEvents();
    paneFrame(x, y, w, h, narrow ? 'Valve Timing' : 'Valve Timing Diagram',
              narrow ? 'overlap ' + overlapDeg().toFixed(0) + '°'
                     : 'overlap = ' + overlapDeg().toFixed(0) + '° · cam turns at half crank speed');

    var cx = x + w / 2, cy = y + paneTopInset() + 10 + (h - 108 - paneTopInset()) / 2;
    var R = Math.min(w * 0.26, (h - 168 - paneTopInset()) / 2);
    if (R < 30) R = 30;

    /* Angle mapping: 0° (TDC) at the top, clockwise, one revolution. */
    function A(deg) { return (deg - 90) * Math.PI / 180; }
    function ring(r, from, to, color, width) {
      ctx.strokeStyle = color; ctx.lineWidth = width; ctx.lineCap = 'butt';
      ctx.beginPath(); ctx.arc(cx, cy, r, A(from), A(to)); ctx.stroke();
    }

    /* Base circle */
    ctx.strokeStyle = 'rgba(139,157,195,0.35)'; ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.arc(cx, cy, R, 0, Math.PI * 2); ctx.stroke();

    /* Intake: opens ivo° before TDC, closes ivc° after BDC.
       Exhaust: opens evo° before BDC, closes evc° after TDC. */
    ring(R + 13, -st.ivo, 180 + st.ivc, '#42a5f5', 9);
    ring(R + 24, 180 - st.evo, 360 + st.evc, '#ef5350', 9);
    /* Overlap wedge — both valves open across TDC. */
    ctx.save();
    ctx.globalAlpha = 0.5;
    ring(R + 18.5, -st.ivo, st.evc, '#ffd54f', 20);
    ctx.restore();

    /* TDC / BDC axis */
    ctx.strokeStyle = 'rgba(139,157,195,0.5)'; ctx.lineWidth = 1; ctx.setLineDash([4, 4]);
    ctx.beginPath(); ctx.moveTo(cx, cy - R - 32); ctx.lineTo(cx, cy + R + 32); ctx.stroke();
    ctx.setLineDash([]);
    haloText('TDC', cx + 9, cy - R - 34, 'bold 11px sans-serif', '#dde3f0', 'left');
    haloText('BDC', cx + 9, cy + R + 42, 'bold 11px sans-serif', '#dde3f0', 'left');

    /* Event ticks + labels */
    function tick(deg, r, label, color) {
      var ang = A(deg);
      var x1 = cx + (r - 8) * Math.cos(ang), y1 = cy + (r - 8) * Math.sin(ang);
      var x2 = cx + (r + 10) * Math.cos(ang), y2 = cy + (r + 10) * Math.sin(ang);
      ctx.strokeStyle = color; ctx.lineWidth = 2;
      ctx.beginPath(); ctx.moveTo(x1, y1); ctx.lineTo(x2, y2); ctx.stroke();
      var lx = cx + (r + 26) * Math.cos(ang), ly = cy + (r + 26) * Math.sin(ang);
      haloText(label, lx, ly + 3, 'bold 9px sans-serif', color,
               Math.cos(ang) < -0.25 ? 'right' : Math.cos(ang) > 0.25 ? 'left' : 'center');
    }
    tick(-st.ivo, R + 13, 'IVO ' + st.ivo + '° BTDC', '#42a5f5');
    tick(180 + st.ivc, R + 13, 'IVC ' + st.ivc + '° ABDC', '#42a5f5');
    tick(180 - st.evo, R + 24, 'EVO ' + st.evo + '° BBDC', '#ef5350');
    tick(st.evc, R + 24, 'EVC ' + st.evc + '° ATDC', '#ef5350');

    /* Live crank pointer (the cam sweeps this circle once per revolution) */
    var a = ((crankAngle % 360) + 360) % 360;
    var pa = A(a);
    ctx.strokeStyle = strokeColor(strokeName(crankAngle)); ctx.lineWidth = 2.5;
    ctx.beginPath(); ctx.moveTo(cx, cy); ctx.lineTo(cx + R * 0.85 * Math.cos(pa), cy + R * 0.85 * Math.sin(pa)); ctx.stroke();
    ctx.fillStyle = strokeColor(strokeName(crankAngle));
    ctx.beginPath(); ctx.arc(cx, cy, 5, 0, Math.PI * 2); ctx.fill();

    /* Centre readout */
    var iL = intakeLift(crankAngle), eL = exhaustLift(crankAngle);
    haloText('IN ' + (iL > 0.02 ? 'OPEN' : 'shut'), cx, cy - R * 0.42,
             'bold 10px sans-serif', iL > 0.02 ? '#42a5f5' : '#6b7a99', 'center');
    haloText('EX ' + (eL > 0.02 ? 'OPEN' : 'shut'), cx, cy + R * 0.5,
             'bold 10px sans-serif', eL > 0.02 ? '#ef5350' : '#6b7a99', 'center');

    /* Legend */
    var lgx = x + 16, lgy = y + h - 78;
    ctx.strokeStyle = '#42a5f5'; ctx.lineWidth = 6; ctx.lineCap = 'butt';
    ctx.beginPath(); ctx.moveTo(lgx, lgy); ctx.lineTo(lgx + 16, lgy); ctx.stroke();
    haloText('Intake', lgx + 21, lgy + 3.5, '9px sans-serif', '#8b9dc3', 'left');
    ctx.strokeStyle = '#ef5350';
    ctx.beginPath(); ctx.moveTo(lgx + 66, lgy); ctx.lineTo(lgx + 82, lgy); ctx.stroke();
    haloText('Exhaust', lgx + 87, lgy + 3.5, '9px sans-serif', '#8b9dc3', 'left');
    ctx.strokeStyle = '#ffd54f';
    ctx.beginPath(); ctx.moveTo(lgx + 142, lgy); ctx.lineTo(lgx + 158, lgy); ctx.stroke();
    haloText('Overlap', lgx + 163, lgy + 3.5, '9px sans-serif', '#8b9dc3', 'left');

    /* Lift strip across the full 720° cycle */
    var sy = y + h - 46, sh = 30, sx = x + 22, sw = w - 44;
    ctx.strokeStyle = 'rgba(139,157,195,0.3)'; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(sx, sy + sh); ctx.lineTo(sx + sw, sy + sh); ctx.stroke();
    function liftCurve(fn, color) {
      ctx.strokeStyle = color; ctx.lineWidth = 1.8;
      ctx.beginPath();
      for (var d = 0; d <= 720; d += 3) {
        var lx = sx + sw * d / 720, ly = sy + sh - fn(d) * sh;
        if (d === 0) ctx.moveTo(lx, ly); else ctx.lineTo(lx, ly);
      }
      ctx.stroke();
    }
    liftCurve(intakeLift, '#42a5f5');
    liftCurve(exhaustLift, '#ef5350');
    var mx2 = sx + sw * (((crankAngle % 720) + 720) % 720) / 720;
    ctx.strokeStyle = '#fff'; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(mx2, sy); ctx.lineTo(mx2, sy + sh); ctx.stroke();
    ctx.font = '9px sans-serif'; ctx.fillStyle = '#8b9dc3'; ctx.textAlign = 'left';
    ctx.fillText('0°', sx, sy + sh + 11);
    ctx.textAlign = 'center'; ctx.fillText('360°', sx + sw / 2, sy + sh + 11);
    ctx.textAlign = 'right'; ctx.fillText('720°  valve lift', sx + sw, sy + sh + 11);
  }

  /* ── Hi-DPI canvas sizing ─────────────────────────────────────── */
  var _lastCssW = 0, _lastDpr = 0;
  function resizeCanvas() {
    var rect = canvas.getBoundingClientRect();
    var cssW = rect.width;
    if (!cssW || cssW < 40) cssW = canvas.parentElement ? canvas.parentElement.clientWidth - 20 : 900;
    /* A collapsed or not-yet-laid-out card reports a couple of pixels, not
       zero, so a truthiness check is not enough — use a plausibility
       threshold or the backing store gets locked to a few pixels wide. */
    if (!cssW || cssW < 40) return;

    var dpr = Math.max(1, Math.min(3, window.devicePixelRatio || 1));
    /* This function writes canvas.style.height, which resizes the parent and
       re-fires the ResizeObserver watching it. Without this early-out the
       observer loops, the browser suppresses it, and the canvas then stops
       responding to genuine resizes altogether — a stretched, blurry canvas
       after rotating a phone or dragging a window wider. */
    if (Math.abs(cssW - _lastCssW) < 0.5 && dpr === _lastDpr) { draw(); return; }
    _lastCssW = cssW; _lastDpr = dpr;

    narrow = cssW < 640;
    LW = narrow ? 520 : 1000;
    LH = narrow ? 1000 : 600;

    var cssH = cssW * (LH / LW);
    canvas.style.height = cssH + 'px';
    canvas.width  = Math.round(cssW * dpr);
    canvas.height = Math.round(cssH * dpr);
    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.scale(canvas.width / LW, canvas.height / LH);
    if ('textRendering' in ctx) ctx.textRendering = 'geometricPrecision';
    ctx.imageSmoothingQuality = 'high';
    positionPaneToggle(cssW);
    draw();
  }

  /* Place the diagram selector on the top-left of the diagram pane. The
     canvas is scaled from logical coordinates to CSS pixels, so the same
     scale factor maps the pane rectangle onto the overlay's offsets. */
  function positionPaneToggle(cssW) {
    var el = document.getElementById('pane-toggle');
    if (!el) return;
    var scale = cssW / LW;
    var pane = layoutRects().pane;
    el.style.left = Math.round(pane.x * scale + 8 + canvas.offsetLeft) + 'px';
    el.style.top  = Math.round(pane.y * scale + 8 + canvas.offsetTop) + 'px';
    el.style.maxWidth = Math.round(pane.w * scale - 16) + 'px';
    /* Convert the overlay's real height back into logical units so the
       plot area starts below it at every breakpoint and pixel ratio. */
    var hCss = el.getBoundingClientRect().height;
    if (hCss > 0 && scale > 0) _paneTopInset = Math.round((hCss + 16) / scale);
  }

  /* ═══════════════════════════════════════════════════════════════
     ANIMATION
     ═══════════════════════════════════════════════════════════════ */
  var playing = false, stepping = false, stepTarget = 0;
  var rafId = null, lastT = 0;
  var STEP_DEG_PER_SEC = 110;

  function $(id) { return document.getElementById(id); }

  function tick(ts) {
    if (!playing && !stepping) return;
    if (!lastT) lastT = ts;
    var dt = (ts - lastT) / 1000;
    lastT = ts;
    if (dt > 0.12) dt = 0.12;

    if (stepping) {
      crankAngle += STEP_DEG_PER_SEC * st.animSpeed * dt;
      if (crankAngle >= stepTarget) { crankAngle = stepTarget % 720; stepping = false; lastT = 0; }
    } else {
      /* Real engine speed sets the physics; animation speed only scales
         how fast we watch it, so the rpm readout stays truthful. */
      crankAngle = (crankAngle + st.rpm * 6 * st.animSpeed * dt) % 720;
    }
    spawnParticles(dt);
    updateParticles(dt);
    updateReadouts();
    draw();
    if (playing || stepping) rafId = requestAnimationFrame(tick);
  }

  function startLoop() { lastT = 0; if (rafId) cancelAnimationFrame(rafId); rafId = requestAnimationFrame(tick); }
  function stopLoop()  { if (rafId) cancelAnimationFrame(rafId); rafId = null; lastT = 0; }

  function togglePlay() {
    stepping = false;
    playing = !playing;
    var b = $('btn-play');
    b.innerHTML = playing ? '&#10073;&#10073; Pause' : '&#9654; Play';
    b.setAttribute('aria-pressed', playing ? 'true' : 'false');
    if (playing) startLoop(); else stopLoop();
  }
  function stepStroke() {
    if (playing) togglePlay();
    if (stepping) return;
    var a = ((crankAngle % 720) + 720) % 720;
    stepTarget = (Math.floor(a / 180) + 1) * 180;
    if (stepTarget - a < 0.75) stepTarget += 180;      /* already at a boundary */
    crankAngle = a;
    stepping = true;
    startLoop();
  }

  /* ═══════════════════════════════════════════════════════════════
     READOUTS
     ═══════════════════════════════════════════════════════════════ */
  function setTxt(id, v) { var e = $(id); if (e) e.textContent = v; }

  function updateReadouts() {
    var c = computeCycle();
    var s = stateAt(crankAngle);
    var mu = UN.mep();

    setTxt('ro-stroke', strokeName(crankAngle));
    var el = $('ro-stroke'); if (el) el.style.color = strokeColor(strokeName(crankAngle));
    setTxt('ro-angle', Math.round(crankAngle) + '\u00B0');
    setTxt('ro-pressure', fmtU(s.P, UN.press));
    setTxt('ro-temp', fmtU(s.T, UN.temp));
    setTxt('ro-volume', fmtU(s.V * 1e6, UN.vol));
    setTxt('ro-eff', (c.etaTh * 100).toFixed(1) + '%');

    setTxt('ro-imep', (c.imepN * mu.k).toFixed(mu.d) + ' ' + mu.l);
    setTxt('ro-ip', fmtU(c.IP, UN.pow));
    setTxt('ro-bp', fmtU(c.BP, UN.pow));
    setTxt('ro-torque', fmtU(c.torque, UN.torq));
    setTxt('ro-bsfc', isFinite(c.bsfc) ? fmtU(c.bsfc, UN.sfc) : '\u2014');
    setTxt('ro-etab', isFinite(c.etaBrake) ? (c.etaBrake * 100).toFixed(1) + '%' : '\u2014');
    setTxt('ro-pmax', fmtU(c.P3, UN.press));
    setTxt('ro-tmax', fmtU(c.T3, UN.temp));
    setTxt('ro-disp', fmtU(c.g.dispL, UN.disp));
    setTxt('ro-etav', (c.etaVol * 100).toFixed(1) + '%');

    /* Cutoff-ratio card only means anything for the Diesel cycle. */
    var rhoCard = $('card-rho');
    if (rhoCard) {
      rhoCard.style.display = c.otto ? 'none' : '';
      setTxt('ro-rho', c.rho.toFixed(3));
    }

    updateWarnings(c);
    updateLearnPanels(c, s);
  }

  function updateWarnings(c) {
    var w = $('sim-warn'); if (!w) return;
    var msgs = [];
    if (c.cannotBreathe) {
      msgs.push('<strong>This cylinder cannot breathe.</strong> At ' + Math.round(c.P1) +
        ' kPa manifold against ' + Math.round(c.Pexh) + ' kPa exhaust, the burnt gas left in the ' +
        'clearance volume fills the cylinder before any fresh charge can enter, so there is no cycle ' +
        'to evaluate and the performance figures below are not meaningful. Raise the manifold ' +
        'pressure or lower the exhaust back-pressure.');
    } else if (c.imepN <= 0) {
      msgs.push('<strong>Net indicated work is negative</strong> (' + (c.imepN / 100).toFixed(2) +
        ' bar IMEP): the pumping loop is larger than the power loop, so the engine is being motored ' +
        'rather than producing work. Brake power and torque are negative for the same reason, and ' +
        'fuel-referenced figures such as BSFC do not apply.');
    }
    if (c.cutoffOver) {
      msgs.push('Heat input is so large that the constant-pressure burn would run past BDC — this is no longer a valid Diesel cycle. Reduce q<sub>in</sub> or raise the compression ratio.');
    }
    if (c.otto && c.T2 > 850) {
      msgs.push('Compression-end temperature is ' + Math.round(c.T2) + ' K. Above about 850 K a petrol charge auto-ignites before the spark — this is knock, and it is why petrol compression ratios stop near 12:1.');
    }
    if (!c.otto && c.T2 < 850) {
      msgs.push('Compression-end temperature is only ' + Math.round(c.T2) + ' K. A diesel needs roughly 850 K at TDC for the fuel spray to auto-ignite, so this engine would not fire.');
    }
    if (c.P3 > 20000) {
      msgs.push('Peak pressure is ' + (c.P3 / 100).toFixed(0) + ' bar — beyond what production cylinder heads and head gaskets are designed to hold.');
    }
    if (msgs.length) { w.innerHTML = msgs.join(' '); w.style.display = ''; }
    else { w.style.display = 'none'; }
  }

  /* ═══════════════════════════════════════════════════════════════
     LEARNING PANELS (KaTeX) — Pattern 1 + Pattern 5
     ═══════════════════════════════════════════════════════════════ */
  var _cache = { eq: '', tbl: '', perf: '', coach: '' };
  function n(v, d) { return (v == null || !isFinite(v)) ? '—' : v.toFixed(d == null ? 2 : d); }

  function updateLearnPanels(c, s) {
    var eq = $('lp-eq-body');
    if (eq) {
      var html = '';
      html += '<div class="eq-line">\\[ r = \\dfrac{V_{BDC}}{V_{TDC}} = \\dfrac{V_s + V_c}{V_c} = ' + n(c.r, 2) + ' \\]</div>';
      html += '<div class="eq-line">\\( V_s = \\dfrac{\\pi}{4}B^2L = \\dfrac{\\pi}{4}(' + n(st.bore, 1) + '\\,\\mathrm{mm})^2(' + n(st.strokeLen, 1) + '\\,\\mathrm{mm}) = ' + n(c.g.Vs * 1e6, 1) + '\\;\\mathrm{cm^3}\\)</div>';
      html += '<div class="eq-line">\\( T_2 = T_1 r^{\\gamma-1} = ' + n(c.T1, 1) + ' \\times ' + n(c.r, 2) + '^{0.4} = \\mathbf{' + n(c.T2, 0) + '\\;\\mathrm{K}} \\)</div>';
      if (c.otto) {
        html += '<div class="eq-line">\\( T_3 = T_2 + \\dfrac{q_{in}}{c_v} = ' + n(c.T2, 0) + ' + \\dfrac{' + n(c.qin, 0) + '}{0.718} = \\mathbf{' + n(c.T3, 0) + '\\;\\mathrm{K}} \\)</div>';
