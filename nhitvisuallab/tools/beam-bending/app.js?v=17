  /* Support position sliders (overhanging mode) */
  function syncSupportSliders() {
    var sa = $('#sup-a-slider'), sb = $('#sup-b-slider');
    if (sa) { sa.value = Math.round(supportA * 100); $('#sup-a-val').textContent = Math.round(supportA * 100) + ' %'; }
    if (sb) { sb.value = Math.round(supportB * 100); $('#sup-b-val').textContent = Math.round(supportB * 100) + ' %'; }
  }
  $('#sup-a-slider').addEventListener('input', function () {
    supportA = +this.value / 100;
    if (supportA >= supportB - 0.05) supportA = supportB - 0.05;
    syncSupportSliders();
    render();
