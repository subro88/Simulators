  /* ================================================================
     UPDATE READOUTS
     ================================================================ */
  function updateReadouts() {
    $('#r-ra').textContent = fmtD(Math.abs(reactions.Ra), 'force', 2);
    $('#r-rb').textContent = fmtD(Math.abs(reactions.Rb), 'force', 2);
    /* Show/hide beam-type-specific readout cards */
    var cardRb = $('#card-rb'), cardMa = $('#card-ma');
    if (cardRb) cardRb.style.display = (beamType === 'cantilever') ? 'none' : '';
    if (cardMa) cardMa.style.display = (beamType === 'cantilever') ? '' : 'none';
    $('#r-vmax').textContent = fmtD(Math.abs(getMaxShear()), 'force', 2);
    $('#r-mmax').textContent = fmtD(Math.abs(getMaxBM()), 'moment', 2);
    $('#r-wsum').textContent = fmtD(getTotalLoad(), 'force', 2);
    $('#r-len').textContent = fmtD(beamLength, 'length');
    $('#r-ma').textContent = fmtD(Math.abs(reactions.Ma), 'moment', 2);

    /* Max deflection from computed deflection curve (matches canvas) */
    $('#r-defl').textContent = toDisplay(Math.abs(computedMaxDefl), 'defl').toFixed(2);

    /* Update readout unit labels */
    var u = U();
    $$('.readout-card').forEach(function (card) {
      var unitEl = card.querySelector('.readout-unit');
      var labelEl = card.querySelector('.readout-label');
      if (!unitEl || !labelEl) return;
      var lab = labelEl.textContent.trim().toUpperCase();
      if (lab === 'REACTION A' || lab === 'REACTION B' || lab === 'MAX SHEAR' || lab === 'LOAD SUM')
        unitEl.textContent = ' ' + u.force.short;
      else if (lab === 'MAX BM' || lab === 'MOMENT AT A')
        unitEl.textContent = ' ' + u.moment.short;
      else if (lab === 'BEAM LENGTH')
        unitEl.textContent = ' ' + u.length.short;
      else if (lab === 'MAX DEFLECTION')
        unitEl.textContent = ' ' + u.defl.short;
    });
  }

  /* ================================================================
     UI — MODE SWITCHING
     ================================================================ */
  function setMode(m) {
    mode = m;
    selectedIdx = -1;
    hideInlineOverlay();
    $$('#mode-tabs .pill').forEach(function (p) {
      p.classList.toggle('active', p.dataset.mode === m);
    });
    var simPanels = ['#sim-panel'];
    var explorePanels = ['#cat-row', '#item-selector', '#item-info'];
    var practicePanels = ['#practice-panel', '#practice-bar'];
    var quizPanels = ['#quiz-panel', '#quiz-bar', '#quiz-result'];

    simPanels.concat(explorePanels, practicePanels, quizPanels).forEach(function (s) { hide($(s)); });

    if (m === 'simulate') {
      simPanels.forEach(function (s) { show($(s)); });
    }
    if (m === 'explore') {
      explorePanels.forEach(function (s) { show($(s)); });
      buildConceptGrid();
    }
    if (m === 'practice') {
      practicePanels.forEach(function (s) { show($(s)); });
      newPractice();
    }
    if (m === 'quiz') {
      show($('#quiz-panel')); show($('#quiz-bar'));
      startQuiz();
    }
    render();
  }

