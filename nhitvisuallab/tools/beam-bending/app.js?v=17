    ctx.fillText('P (kN)', 215, 65);
    ctx.font = '600 10px "Segoe UI", sans-serif';
    ctx.fillStyle = '#dde3f0';
    ctx.fillText('Point Load', 215, 150);

    /* UDL */
    drawMiniBeam(450, 120, 800, '#00acc1');
