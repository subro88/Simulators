  $('#sup-b-slider').addEventListener('input', function () {
    supportB = +this.value / 100;
    if (supportB <= supportA + 0.05) supportB = supportA + 0.05;
    syncSupportSliders();
    render();
  });

  /* ── Section & material → EI for deflection ───────────────── */
  function fmtSci(val, unit, dec) {
    /* Format a value in engineering form: mantissa ×10^exp */
    if (!isFinite(val) || val === 0) return '0 ' + unit;
    var exp = Math.floor(Math.log10(Math.abs(val)) / 3) * 3;
    var mant = val / Math.pow(10, exp);
    var supMap = { '-': '⁻', '0': '⁰', '1': '¹', '2': '²', '3': '³', '4': '⁴', '5': '⁵', '6': '⁶', '7': '⁷', '8': '⁸', '9': '⁹' };
    var sup = String(exp).replace(/[-0-9]/g, function (c) { return supMap[c]; });
    return mant.toFixed(dec === undefined ? 2 : dec) + (exp !== 0 ? '×10' + sup : '') + ' ' + unit;
  }

  function updateSection(reRender) {
    secI = computeSectionI();
    var iOut = $('#sec-i-out'), eiOut = $('#sec-ei-out');
    /* I in ×10⁻⁶ m⁴ (a readable scale for typical sections) */
    if (iOut) iOut.textContent = (secI * 1e6).toFixed(secI * 1e6 < 100 ? 2 : 1) + '×10⁻⁶ m⁴';
    if (eiOut) eiOut.textContent = fmtSci(matE * secI, 'N·m²', 2);
    if (reRender) render();
  }

  /* Material dropdown — preset E or reveal Custom input */
  $('#mat-sel').addEventListener('change', function () {
    var custom = this.value === 'custom';
    $('#mat-e').style.display = custom ? '' : 'none';
    $('#mat-e-unit').style.display = custom ? '' : 'none';
    if (!custom) matE = parseFloat(this.value) * 1e9;
    else { matE = (parseFloat($('#mat-e').value) || 200) * 1e9; $('#mat-e').focus(); }
    updateSection(true);
  });
  $('#mat-e').addEventListener('input', function () {
    var g = parseFloat(this.value);
    if (g > 0) { matE = g * 1e9; updateSection(true); }
  });

  /* Section shape dropdown — swap the dimension inputs */
  $('#sec-shape').addEventListener('change', function () {
    secShape = this.value;
    $('#sec-rect').style.display = secShape === 'rect' ? '' : 'none';
    $('#sec-circ').style.display = secShape === 'circle' ? '' : 'none';
    $('#sec-customI').style.display = secShape === 'custom' ? '' : 'none';
    updateSection(true);
  });

  /* Dimension inputs (mm → m). Custom I is entered in ×10⁻⁶ m⁴. */
  $('#sec-b').addEventListener('input', function () { var v = parseFloat(this.value); if (v > 0) { secB = v / 1000; updateSection(true); } });
  $('#sec-h').addEventListener('input', function () { var v = parseFloat(this.value); if (v > 0) { secH = v / 1000; updateSection(true); } });
  $('#sec-d').addEventListener('input', function () { var v = parseFloat(this.value); if (v > 0) { secD = v / 1000; updateSection(true); } });
  $('#sec-i').addEventListener('input', function () { var v = parseFloat(this.value); if (v > 0) { secICustom = v * 1e-6; updateSection(true); } });

  /* ── syncPanelToSelection — build context-sensitive property panel ── */
  function syncPanelToSelection() {
    var propsEl = $('#sel-props');
    if (!propsEl) return;

    buildLoadList();

    if (selectedIdx < 0 || selectedIdx >= loads.length) {
      hideInlineOverlay();
      propsEl.innerHTML =
        '<p class="hint-text">Select a tool above (\u2193 Point, \u2261 UDL, or \u21BB Moment), then click anywhere on the beam to place a load. Click an existing load to select and edit it.</p>' +
        '<div class="sim-slider-group"><span class="sim-slider-label">New Load Size</span>' +
        '<input class="sim-slider" id="def-mag" type="range" min="1" max="50" step="0.5" value="' + defaultMag + '">' +
        '<span class="sim-slider-val" id="def-mag-val">' + fmtD(defaultMag, 'force') + ' ' + U().force.short + '</span></div>';
      var dm = $('#def-mag');
      if (dm) dm.addEventListener('input', function () {
        defaultMag = +this.value;
        $('#def-mag-val').textContent = fmtD(defaultMag, 'force') + ' ' + U().force.short;
      });
      return;
    }

    var ld = loads[selectedIdx];
    var badgeClass = ld.type === 'udl' ? ' udl' : (ld.type === 'moment' ? ' moment' : '');
    var typeLabel = ld.type === 'point' ? '\u2193 Point Load #' : (ld.type === 'moment' ? '\u21BB Moment #' : '\u2261 UDL #');
    var html = '<div class="sel-header">' +
      '<span class="sel-type-badge' + badgeClass + '">' + typeLabel + (selectedIdx + 1) + '</span>' +
      '<button class="load-del-btn" id="btn-del-sel" title="Delete this load">\u00d7</button></div>';

    var lim = MAG_LIMITS[ld.type];

    if (ld.type === 'point' || ld.type === 'moment') {
      html += '<div class="sim-slider-group"><span class="sim-slider-label">Position</span>' +
        '<input class="sim-slider" id="sel-pos" type="range" min="0" max="100" step="1" value="' + Math.round(ld.pos * 100) + '">' +
        '<span class="sim-slider-val" id="sel-pos-val">' + Math.round(ld.pos * 100) + ' %</span></div>';
    } else {
      html += '<div class="sim-slider-group"><span class="sim-slider-label">Start</span>' +
        '<input class="sim-slider" id="sel-start" type="range" min="0" max="100" step="1" value="' + Math.round(ld.pos * 100) + '">' +
        '<span class="sim-slider-val" id="sel-start-val">' + Math.round(ld.pos * 100) + ' %</span></div>';
      html += '<div class="sim-slider-group"><span class="sim-slider-label">End</span>' +
        '<input class="sim-slider" id="sel-end" type="range" min="0" max="100" step="1" value="' + Math.round(ld.end * 100) + '">' +
        '<span class="sim-slider-val" id="sel-end-val">' + Math.round(ld.end * 100) + ' %</span></div>';
    }

    /* Magnitude stepper: − [input] + unit (display units) */
    var magLabel = ld.type === 'udl' ? 'Intensity' : 'Magnitude';
    var unitKey = ld.type === 'point' ? 'force' : (ld.type === 'moment' ? 'moment' : 'dist');
    var dispMag = toDisplay(ld.mag, unitKey);
    var dispMin = toDisplay(lim.min, unitKey);
    var dispMax = toDisplay(lim.max, unitKey);
    var dispStep = toDisplay(lim.step, unitKey);
    html += '<div class="mag-stepper">' +
      '<span class="sim-slider-label">' + magLabel + '</span>' +
      '<div class="stepper-row">' +
        '<button class="stepper-btn" id="mag-dec" title="Decrease">\u2212</button>' +
        '<input class="stepper-input" id="sel-mag-input" type="number"' +
          ' min="' + dispMin + '" max="' + dispMax + '" step="any"' +
          ' value="' + fmtMag(ld.mag, unitKey) + '">' +
        '<button class="stepper-btn" id="mag-inc" title="Increase">+</button>' +
        '<span class="stepper-unit">' + U()[unitKey].short + '</span>' +
      '</div>' +
      '<input class="sim-slider" id="sel-mag-slider" type="range"' +
        ' min="' + lim.min + '" max="' + lim.max + '" step="any"' +
        ' value="' + ld.mag + '">' +
    '</div>';

    propsEl.innerHTML = html;

    /* Wire up position sliders */
    var posS = $('#sel-pos');
    if (posS) posS.addEventListener('input', function () {
      loads[selectedIdx].pos = +this.value / 100;
      $('#sel-pos-val').textContent = this.value + ' %';
      render();
    });
    var startS = $('#sel-start');
    if (startS) startS.addEventListener('input', function () {
      var v = +this.value / 100;
      if (v < loads[selectedIdx].end - 0.02) loads[selectedIdx].pos = v;
      $('#sel-start-val').textContent = Math.round(loads[selectedIdx].pos * 100) + ' %';
      render();
    });
    var endS = $('#sel-end');
    if (endS) endS.addEventListener('input', function () {
      var v = +this.value / 100;
      if (v > loads[selectedIdx].pos + 0.02) loads[selectedIdx].end = v;
      $('#sel-end-val').textContent = Math.round(loads[selectedIdx].end * 100) + ' %';
      render();
    });

    /* Wire up magnitude stepper */
    var magInput = $('#sel-mag-input');
    var magSlider = $('#sel-mag-slider');

    function applyMagSI(siVal) {
      var ld2 = loads[selectedIdx];
      var uk = ld2.type === 'point' ? 'force' : (ld2.type === 'moment' ? 'moment' : 'dist');
      ld2.mag = clampMag(ld2.type, siVal);
      magInput.value = fmtMag(ld2.mag, uk);
      magSlider.value = ld2.mag;
      render();
    }

    if (magInput) {
      magInput.addEventListener('change', function () {
        var uk = loads[selectedIdx].type === 'point' ? 'force' : (loads[selectedIdx].type === 'moment' ? 'moment' : 'dist');
        applyMagSI(toSI(+this.value, uk));
      });
      magInput.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') { e.preventDefault(); this.blur(); }
      });
    }
    if (magSlider) {
      magSlider.addEventListener('input', function () {
        var v = Math.round(+this.value * 100) / 100; /* SI value, 2-dp */
        var uk = loads[selectedIdx].type === 'point' ? 'force' : (loads[selectedIdx].type === 'moment' ? 'moment' : 'dist');
        loads[selectedIdx].mag = v;
        magInput.value = fmtMag(v, uk);
        render();
      });
    }

    /* Stepper buttons with hold-to-repeat */
    var stepRepeatId = 0;
    function startStep(dir) {
      saveUndo();
      applyMagSI(loads[selectedIdx].mag + dir * lim.step);
      var delay = 300;
      function rep() {
        applyMagSI(loads[selectedIdx].mag + dir * lim.step);
        delay = Math.max(50, delay * 0.8);
        stepRepeatId = setTimeout(rep, delay);
      }
      stepRepeatId = setTimeout(rep, delay);
    }
    function stopStep() { clearTimeout(stepRepeatId); stepRepeatId = 0; }

    var decBtn = $('#mag-dec'), incBtn = $('#mag-inc');
    if (decBtn) {
      decBtn.addEventListener('pointerdown', function (e) { e.preventDefault(); startStep(-1); });
      decBtn.addEventListener('pointerup', stopStep);
      decBtn.addEventListener('pointerleave', stopStep);
    }
    if (incBtn) {
      incBtn.addEventListener('pointerdown', function (e) { e.preventDefault(); startStep(1); });
      incBtn.addEventListener('pointerup', stopStep);
      incBtn.addEventListener('pointerleave', stopStep);
    }

    /* Delete button */
    var delBtn = $('#btn-del-sel');
    if (delBtn) delBtn.addEventListener('click', function () { deleteLoad(selectedIdx); });
  }

  /* ── buildLoadList — render the load list with select/delete ── */
  function buildLoadList() {
    var list = $('#load-list');
    if (!list) return;
    list.innerHTML = '';
    if (loads.length === 0) {
      list.innerHTML = '<span class="hint-text" style="padding:6px 0;font-size:.75rem">No loads. Click the beam to add one.</span>';
      return;
    }
    loads.forEach(function (ld, i) {
      var div = document.createElement('div');
      div.className = 'load-item' + (i === selectedIdx ? ' selected' : '');
      var icon = ld.type === 'point' ? '\u2193' : (ld.type === 'moment' ? '\u21BB' : '\u2261');
      var desc = ld.type === 'point'
        ? 'Point ' + fmtMag(ld.mag, 'force') + ' ' + U().force.short + ' @ ' + fmtD(ld.pos * beamLength, 'length', 2) + ' ' + U().length.short
        : (ld.type === 'moment'
          ? 'Moment ' + fmtMag(ld.mag, 'moment') + ' ' + U().moment.short + ' @ ' + fmtD(ld.pos * beamLength, 'length', 2) + ' ' + U().length.short
          : 'UDL ' + fmtMag(ld.mag, 'dist') + ' ' + U().dist.short + ' (' + fmtD(ld.pos * beamLength, 'length', 1) + '\u2013' + fmtD(ld.end * beamLength, 'length', 1) + ' ' + U().length.short + ')');
      div.innerHTML = '<span class="load-icon">' + icon + '</span>' +
        '<span class="load-desc">' + desc + '</span>' +
        '<button class="load-del" title="Delete">\u00d7</button>';
      div.addEventListener('click', function (e) {
        if (e.target.classList.contains('load-del')) return;
        selectedIdx = i;
        syncPanelToSelection();
        render();
      });
      div.querySelector('.load-del').addEventListener('click', function (e) {
        e.stopPropagation();
        deleteLoad(i);
      });
      list.appendChild(div);
    });
  }

  /* Clear All */
  $('#btn-clear').addEventListener('click', function () {
    saveUndo();
    loads = []; selectedIdx = -1;
    $$('.preset-btn').forEach(function (b) { b.classList.remove('active'); });
    syncPanelToSelection();
    render();
  });

  /* Presets */
  $$('.preset-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var preset = btn.dataset.preset;
      if (!preset) return;
      saveUndo();
      loads = []; selectedIdx = -1;
      $$('.preset-btn').forEach(function (b) { b.classList.remove('active'); });
      btn.classList.add('active');
      if (preset === 'central') loads.push({ type: 'point', pos: 0.5, mag: 20 });
      else if (preset === 'quarter') loads.push({ type: 'point', pos: 0.25, mag: 15 });
      else if (preset === 'full-udl') loads.push({ type: 'udl', pos: 0, mag: 8, end: 1 });
      else if (preset === 'combined') {
        loads.push({ type: 'point', pos: 0.5, mag: 12 });
        loads.push({ type: 'udl', pos: 0, mag: 5, end: 1 });
      }
      syncPanelToSelection();
      render();
    });
  });

  /* Keyboard shortcuts */
  document.addEventListener('keydown', function (e) {
    if (mode !== 'simulate') return;
    if (document.activeElement && document.activeElement.tagName === 'INPUT') return;
    /* Undo: Ctrl+Z */
    if ((e.ctrlKey || e.metaKey) && !e.shiftKey && e.key === 'z') { e.preventDefault(); undo(); return; }
    /* Redo: Ctrl+Shift+Z or Ctrl+Y */
    if ((e.ctrlKey || e.metaKey) && (e.shiftKey && e.key === 'z' || e.key === 'y')) { e.preventDefault(); redo(); return; }
    /* Delete selected load */
    if (selectedIdx >= 0 && (e.key === 'Delete' || e.key === 'Backspace')) {
      e.preventDefault();
      deleteLoad(selectedIdx);
    }
  });

  /* ================================================================
     CANVAS INTERACTION — Direct manipulation
     ================================================================ */
  function canvasXY(e) {
    var rect = cvs.getBoundingClientRect();
    return {
      x: (e.clientX - rect.left) * (W / rect.width),
      y: (e.clientY - rect.top) * (H / rect.height)
    };
  }

  cvs.addEventListener('pointerdown', function (e) {
    if (mode !== 'simulate') return;
    cvs.setPointerCapture(e.pointerId);
    var p = canvasXY(e);
    var frac = Math.max(0, Math.min(1, (p.x - beamDrawL) / (beamDrawR - beamDrawL)));
    var beamY = BEAM_Y0 + 80;

    /* (Inline +/− now handled by HTML overlay — no canvas hit-test needed) */

    /* 0b. Hit-test supports (overhanging — draggable) */
    var supHit = hitTestSupports(p.x, p.y);
    if (supHit) {
      dragSupport.active = true;
      dragSupport.which = supHit;
      dragSupport.startFrac = frac;
      dragSupport.origVal = (supHit === 'a') ? supportA : supportB;
      cvs.style.cursor = 'grabbing';
      selectedIdx = -1; syncPanelToSelection();
      render();
      return;
    }

    /* 1. Hit-test existing loads */
    var hit = hitTestLoads(p.x, p.y);
    if (hit) {
      selectedIdx = hit.idx;
      drag.active = true;
      drag.loadIdx = hit.idx;
      drag.handle = hit.handle;
      drag.startFrac = frac;
      drag.origPos = loads[hit.idx].pos;
      drag.origEnd = loads[hit.idx].end || 0;
      drag.undone = false;
      cvs.style.cursor = (hit.handle === 'start' || hit.handle === 'end') ? 'ew-resize' : 'grabbing';
      syncPanelToSelection();
      render();
      return;
    }

    /* 2. Click on beam zone → place new load or deselect */
    if (p.y >= BEAM_Y0 && p.y <= BEAM_Y1 && p.x >= beamDrawL && p.x <= beamDrawR) {
      var snap = Math.round(frac * 40) / 40;
      saveUndo();
      if (activeTool === 'point') {
        loads.push({ type: 'point', pos: snap, mag: defaultMag });
        selectedIdx = loads.length - 1;
      } else if (activeTool === 'udl') {
        var hs = 0.15;
        loads.push({ type: 'udl', pos: Math.max(0, snap - hs), mag: defaultUDLMag, end: Math.min(1, snap + hs) });
        selectedIdx = loads.length - 1;
      } else if (activeTool === 'moment') {
        loads.push({ type: 'moment', pos: snap, mag: defaultMoment });
        selectedIdx = loads.length - 1;
      } else {
        selectedIdx = -1;
      }
      syncPanelToSelection();
      render();
      return;
    }

    /* 3. Click outside beam → deselect */
    if (selectedIdx >= 0) { selectedIdx = -1; syncPanelToSelection(); render(); }
  });

  cvs.addEventListener('pointermove', function (e) {
    if (mode !== 'simulate') return;
    var p = canvasXY(e);
    var frac = Math.max(0, Math.min(1, (p.x - beamDrawL) / (beamDrawR - beamDrawL)));

    /* Hover crosshair */
    hoverX = (p.x >= beamDrawL && p.x <= beamDrawR) ? frac : -1;

    /* Support dragging */
    if (dragSupport.active) {
      var delta = frac - dragSupport.startFrac;
      var newVal = Math.max(0.02, Math.min(0.98, dragSupport.origVal + delta));
      if (dragSupport.which === 'a') {
        supportA = Math.min(newVal, supportB - 0.05);
      } else {
        supportB = Math.max(newVal, supportA + 0.05);
      }
      syncSupportSliders();
      render();
      return;
    }

    /* Load dragging */
    if (drag.active) {
      if (!drag.undone) { saveUndo(); drag.undone = true; }
      var delta = frac - drag.startFrac;
      var ld = loads[drag.loadIdx];
      if (ld.type === 'point' || ld.type === 'moment') {
        ld.pos = Math.max(0, Math.min(1, drag.origPos + delta));
      } else if (ld.type === 'udl') {
        if (drag.handle === 'start') {
          ld.pos = Math.max(0, Math.min(ld.end - 0.02, drag.origPos + delta));
        } else if (drag.handle === 'end') {
          ld.end = Math.max(ld.pos + 0.02, Math.min(1, drag.origEnd + delta));
        } else {
          var span = drag.origEnd - drag.origPos;
          var np = Math.max(0, Math.min(1 - span, drag.origPos + delta));
          ld.pos = np; ld.end = np + span;
        }
      }
      syncPanelToSelection();
      render();
      return;
    }

    /* Hover detection for cursor */
    var supHov = hitTestSupports(p.x, p.y);
    var hit = hitTestLoads(p.x, p.y);
    var newHov = hit ? hit.idx : -1;
    var newHandle = hit ? hit.handle : null;
    if (newHov !== hoveredIdx || newHandle !== hoveredHandle || supHov !== hoveredSupport) {
      hoveredIdx = newHov;
      hoveredHandle = newHandle;
      hoveredSupport = supHov;
      updateCursor();
    }
    render();
  });

  cvs.addEventListener('pointerup', function () {
    stopImoStep();
    if (drag.active) {
      drag.active = false; drag.loadIdx = -1;
      updateCursor(); render();
    }
    if (dragSupport.active) {
      dragSupport.active = false; dragSupport.which = null;
      updateCursor(); render();
    }
  });

  cvs.addEventListener('pointerleave', function () {
    hoverX = -1; hoveredIdx = -1; hoveredHandle = null; hoveredSupport = null;
    stopImoStep();
    if (mode === 'simulate') render();
  });

  /* ── Right-click context menu ───────────────────────────── */
  var ctxMenu = document.createElement('div');
  ctxMenu.className = 'ctx-menu';
  ctxMenu.style.display = 'none';
  document.body.appendChild(ctxMenu);

  function hideCtxMenu() { ctxMenu.style.display = 'none'; }
  document.addEventListener('click', hideCtxMenu);
  document.addEventListener('scroll', hideCtxMenu, true);

  cvs.addEventListener('contextmenu', function (e) {
    if (mode !== 'simulate') return;
    e.preventDefault();
    var p = canvasXY(e);
    var hit = hitTestLoads(p.x, p.y);
    if (!hit) { hideCtxMenu(); return; }

    selectedIdx = hit.idx;
    syncPanelToSelection();
    render();

    var ld = loads[hit.idx];
    var label = ld.type === 'point'
      ? 'Point ' + fmtMag(ld.mag, 'force') + ' ' + U().force.short
      : (ld.type === 'moment'
        ? 'Moment ' + fmtMag(ld.mag, 'moment') + ' ' + U().moment.short
        : 'UDL ' + fmtMag(ld.mag, 'dist') + ' ' + U().dist.short);

    ctxMenu.innerHTML =
      '<div class="ctx-label">' + label + '</div>' +
      '<button class="ctx-item ctx-dup" data-act="dup">Duplicate</button>' +
      '<button class="ctx-item ctx-del" data-act="del">' +
      'Delete<span class="ctx-key">Del</span></button>';
    ctxMenu.style.display = 'block';
    ctxMenu.style.left = e.clientX + 'px';
    ctxMenu.style.top = e.clientY + 'px';

    /* Keep inside viewport */
    requestAnimationFrame(function () {
      var rect = ctxMenu.getBoundingClientRect();
      if (rect.right > window.innerWidth) ctxMenu.style.left = (e.clientX - rect.width) + 'px';
      if (rect.bottom > window.innerHeight) ctxMenu.style.top = (e.clientY - rect.height) + 'px';
    });

    var idx = hit.idx;
    ctxMenu.onclick = function (ev) {
      var act = ev.target.dataset.act || ev.target.parentElement.dataset.act;
      if (act === 'del') {
        deleteLoad(idx);
      } else if (act === 'dup') {
        saveUndo();
        var src = loads[idx];
        var dup = { type: src.type, pos: Math.min(1, src.pos + 0.05), mag: src.mag };
        if (src.type === 'udl') { dup.end = Math.min(1, src.end + 0.05); }
        loads.push(dup);
        selectedIdx = loads.length - 1;
        syncPanelToSelection();
        render();
      }
      hideCtxMenu();
    };
  });

  /* ================================================================
     EXPLORE MODE
     ================================================================ */
  function buildConceptGrid() {
    var grid = $('#concept-grid');
    grid.innerHTML = '';
    var filtered = CONCEPTS.filter(function (c) { return c.cat === selCat; });
    filtered.forEach(function (c, i) {
      var btn = document.createElement('button');
      btn.className = 'is-btn' + (i === selConcept ? ' active' : '');
      btn.innerHTML = '<span class="is-btn-name">' + c.name + '</span><span class="is-btn-sym">' + c.symbol + '</span>';
      btn.addEventListener('click', function () {
        selConcept = i;
        $$('.is-btn').forEach(function (b) { b.classList.remove('active'); });
        btn.classList.add('active');
        showConceptInfo(c);
        render();
      });
      grid.appendChild(btn);
    });
    if (filtered[selConcept]) showConceptInfo(filtered[selConcept]);
  }

  function showConceptInfo(c) {
    var el = $('#item-info');
    el.innerHTML =
      '<div class="ii-top"><span class="ii-name">' + c.name + '</span><span class="ii-cat-badge">' + c.cat + '</span></div>' +
      '<p class="ii-desc">' + c.desc + '</p>' +
      '<div class="formula-box"><span class="fb-formula">' + c.formula + '</span><span class="fb-unit">Unit: ' + c.unit + '</span></div>' +
      '<div class="example-box"><h4>Worked Example</h4><p class="ex-problem">' + c.example.problem + '</p>' +
      c.example.steps.map(function (s) { return '<p class="ex-step">' + s + '</p>'; }).join('') +
      '</div>';
    show(el);
  }

  $('#cat-tabs').addEventListener('click', function (e) {
    if (!e.target.matches('.pill')) return;
    selCat = e.target.dataset.cat;
    selConcept = 0;
    $$('#cat-tabs .pill').forEach(function (p) { p.classList.toggle('active', p === e.target); });
    buildConceptGrid();
    render();
  });

  /* ================================================================
     PRACTICE MODE
     ================================================================ */
  function newPractice() {
    pAnswered = false;
    var fn = PROBLEM_GEN[randInt(0, PROBLEM_GEN.length - 1)];
    pProblem = fn();
    $('#pp-prompt').textContent = pProblem.prompt;
    $('#pp-unit').textContent = pProblem.unit;
    $('#pp-input').value = '';
    $('#pp-input').disabled = false;
    $('#pp-feedback').textContent = '';
    hide($('#pp-next'));
    hide($('#pp-solution'));
    render();
  }

  $('#pp-check').addEventListener('click', function () {
    if (pAnswered || !pProblem) return;
    pAnswered = true;
    pTotal++;
    var val = parseFloat($('#pp-input').value);
    var tol = Math.max(Math.abs(pProblem.answer) * 0.02, 0.5);
    var ok = !isNaN(val) && Math.abs(val - pProblem.answer) <= tol;
    if (ok) pScore++;
    $('#pp-feedback').textContent = ok ? '\u2714 Correct!' : '\u2718 Incorrect \u2014 answer: ' + pProblem.answer + ' ' + pProblem.unit;
    $('#pp-feedback').className = 'feedback ' + (ok ? 'ok' : 'err');
    $('#pp-input').disabled = true;
    show($('#pp-next'));
    /* Show solution */
    var solEl = $('#pp-solution');
    solEl.innerHTML = '<h4>Step-by-Step Solution</h4>' +
      pProblem.steps.map(function (s) { return '<p class="sol-step">' + s.replace(/= ([0-9.]+)/, '= <strong>$1</strong>') + '</p>'; }).join('');
    show(solEl);
    $('#pbar-score-val').textContent = pScore + ' / ' + pTotal;
  });

  $('#pp-next').addEventListener('click', newPractice);

  /* Enter key submits practice */
  $('#pp-input').addEventListener('keydown', function (e) {
    if (e.key === 'Enter') $('#pp-check').click();
  });

  /* ================================================================
     QUIZ MODE
     ================================================================ */
  function startQuiz() {
    quizScore = 0; quizIdx = 0; quizAnswered = false;
    quizQs = shuffleArr(QUIZ_POOL).slice(0, 5);
    hide($('#quiz-result'));
    show($('#quiz-panel')); show($('#quiz-bar'));
    showQuizQ();
  }

  function showQuizQ() {
    quizAnswered = false;
    var q = quizQs[quizIdx];
    $('#qbar-num').textContent = quizIdx + 1;
    var panel = $('#quiz-panel');

    if (q.type === 'mcq') {
      var opts = q.options.slice();
      var correctText = opts[q.correct];
      var shuffled = shuffleArr(opts);
      q._correctIdx = shuffled.indexOf(correctText);
      panel.innerHTML = '<p class="qp-prompt">Q' + (quizIdx + 1) + '. ' + q.prompt + '</p>' +
        '<div class="answer-grid">' +
        shuffled.map(function (o, i) {
          return '<button class="answer-btn" data-idx="' + i + '">' + o + '</button>';
        }).join('') + '</div>' +
        '<p class="quiz-feedback" id="qfb"></p>' +
        '<button class="btn btn-ghost" id="q-next" style="display:none;margin-top:10px;">Next \u2192</button>';
      panel.querySelectorAll('.answer-btn').forEach(function (btn) {
        btn.addEventListener('click', function () { submitMCQ(+btn.dataset.idx, q._correctIdx, panel); });
      });
    } else {
      panel.innerHTML = '<p class="qp-prompt">Q' + (quizIdx + 1) + '. ' + q.prompt + '</p>' +
        '<div class="quiz-input-row"><input class="qi-input" id="qi-val" type="number" step="any" placeholder="Your answer"><span class="qi-unit">' + q.unit + '</span>' +
        '<button class="btn btn-primary" id="q-submit">Submit</button></div>' +
        '<p class="quiz-feedback" id="qfb"></p>' +
        '<button class="btn btn-ghost" id="q-next" style="display:none;margin-top:10px;">Next \u2192</button>';
      panel.querySelector('#q-submit').addEventListener('click', function () { submitNumeric(q, panel); });
      panel.querySelector('#qi-val').addEventListener('keydown', function (e) {
        if (e.key === 'Enter') panel.querySelector('#q-submit').click();
      });
    }
    var nextBtn = panel.querySelector('#q-next');
    if (nextBtn) nextBtn.addEventListener('click', nextQuizQ);
    render();
  }

  function submitMCQ(chosen, correct, panel) {
    if (quizAnswered) return;
    quizAnswered = true;
    var btns = panel.querySelectorAll('.answer-btn');
    btns.forEach(function (b, i) {
      b.classList.add('locked');
      if (i === correct) b.classList.add('correct');
      if (i === chosen && i !== correct) b.classList.add('wrong');
    });
    var ok = chosen === correct;
    if (ok) quizScore++;
    quizQs[quizIdx]._given = btns[chosen].textContent;
    quizQs[quizIdx]._ok = ok;
    panel.querySelector('#qfb').textContent = ok ? '\u2714 Correct!' : '\u2718 Incorrect';
    panel.querySelector('#qfb').className = 'quiz-feedback ' + (ok ? 'ok' : 'err');
    show(panel.querySelector('#q-next'));
  }

  function submitNumeric(q, panel) {
    if (quizAnswered) return;
    quizAnswered = true;
    var val = parseFloat(panel.querySelector('#qi-val').value);
    var tol = Math.max(Math.abs(q.answer) * 0.02, 0.5);
    var ok = !isNaN(val) && Math.abs(val - q.answer) <= tol;
    if (ok) quizScore++;
    q._given = isNaN(val) ? 'No answer' : val;
    q._ok = ok;
    panel.querySelector('#qfb').textContent = ok ? '\u2714 Correct!' : '\u2718 Answer: ' + q.answer + ' ' + q.unit;
    panel.querySelector('#qfb').className = 'quiz-feedback ' + (ok ? 'ok' : 'err');
    panel.querySelector('#qi-val').disabled = true;
    panel.querySelector('#q-submit').disabled = true;
    show(panel.querySelector('#q-next'));
  }

  function nextQuizQ() {
    quizIdx++;
    if (quizIdx >= quizQs.length) { showQuizResult(); return; }
    showQuizQ();
  }

  function showQuizResult() {
    hide($('#quiz-panel')); hide($('#quiz-bar'));
    var el = $('#quiz-result');
    var pct = quizScore / quizQs.length;
    var cls = pct === 1 ? 'perfect' : pct >= 0.6 ? 'good' : 'poor';
    var stars = pct === 1 ? '\u2605\u2605\u2605' : pct >= 0.6 ? '\u2605\u2605' : '\u2605';
    var verdict = pct === 1 ? 'Perfect Score!' : pct >= 0.6 ? 'Good Job!' : 'Keep Practising';

    el.innerHTML =
      '<div class="qr-header"><div class="qr-title-wrap"><span class="qr-title">Quiz Complete</span><span class="qr-stars">' + stars + '</span></div>' +
      '<div class="qr-score-wrap"><span class="qr-score ' + cls + '">' + quizScore + '/' + quizQs.length + '</span><div class="qr-verdict">' + verdict + '</div></div></div>' +
      '<div class="qr-rows">' +
      quizQs.map(function (q, i) {
        var rowCls = q._ok ? 'ok' : 'err';
        var mark = q._ok ? '\u2714' : '\u2718';
        var detail = q.type === 'mcq'
          ? '<strong>Your answer:</strong> ' + q._given
          : '<strong>Your answer:</strong> ' + q._given + ' &nbsp;|&nbsp; <strong>Correct:</strong> ' + q.answer + ' ' + q.unit;
        return '<div class="qr-row ' + rowCls + '"><span class="qr-qnum">Q' + (i + 1) + '</span><span class="qr-detail">' + detail + '</span><span class="qr-mark">' + mark + '</span></div>';
      }).join('') +
      '</div>' +
      '<button class="btn btn-primary" id="qr-retry" style="align-self:flex-start;">New Quiz</button>';
    el.querySelector('#qr-retry').addEventListener('click', startQuiz);
    show(el);
  }

  /* ================================================================
     EXPORT — PNG image + professional PDF report
     ================================================================ */

  function escapeHtml(s) {
    if (s === null || s === undefined) return '';
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;')
      .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function beamTypeLabel() {
    if (beamType === 'simply-supported') return 'Simply Supported';
    if (beamType === 'cantilever') return 'Cantilever';
    if (beamType === 'overhanging') return 'Overhanging';
    return beamType;
  }

  /* One-line human summary of the current model (display units). */
  function beamSummaryLine() {
    var nL = loads.length;
    return beamTypeLabel() + '  ·  L = ' + fmtD(beamLength, 'length') + ' ' + U().length.short +
      '  ·  ' + nL + ' load' + (nL === 1 ? '' : 's') +
      '  ·  ΣW = ' + fmtD(getTotalLoad(), 'force') + ' ' + U().force.short;
  }

  /* Describe one load in display units (used by report table + PNG). */
  function loadDesc(ld) {
    if (ld.type === 'point') {
      return { type: 'Point load', mag: fmtMag(ld.mag, 'force') + ' ' + U().force.short,
        at: 'x = ' + fmtD(ld.pos * beamLength, 'length') + ' ' + U().length.short };
    }
    if (ld.type === 'udl') {
      return { type: 'UDL', mag: fmtMag(ld.mag, 'dist') + ' ' + U().dist.short,
        at: fmtD(ld.pos * beamLength, 'length') + '–' + fmtD(ld.end * beamLength, 'length') + ' ' + U().length.short };
    }
    return { type: 'Moment (couple)', mag: fmtMag(ld.mag, 'moment') + ' ' + U().moment.short,
      at: 'x = ' + fmtD(ld.pos * beamLength, 'length') + ' ' + U().length.short };
  }

  /* ── PNG export — the live dark diagrams + title band + watermark ── */
  function exportPNG() {
    render(); /* ensure the canvas reflects current state */
    var headH = 56, footH = 26;
    var tmp = document.createElement('canvas');
    tmp.width = cvs.width;
    tmp.height = cvs.height + Math.round((headH + footH) * dpr);
    var t = tmp.getContext('2d');
    t.scale(dpr, dpr);
    var w = W;
    var dh = cvs.height / dpr;            /* diagram height in logical px */
    var totalH = dh + headH + footH;

    /* Background */
    t.fillStyle = '#0d1117';
    t.fillRect(0, 0, w, totalH);

    /* Title band */
    t.textAlign = 'left'; t.textBaseline = 'middle';
    t.fillStyle = '#00acc1';
    t.font = '700 18px "Segoe UI", system-ui, sans-serif';
    t.fillText('Beam Bending — SFD, BMD & Deflection', 16, 22);
    t.fillStyle = '#9fb0c8';
    t.font = '600 11px "Segoe UI", system-ui, sans-serif';
    t.fillText(beamSummaryLine(), 16, 43);

    /* Diagram (drawn at native resolution) */
    t.drawImage(cvs, 0, headH, w, dh);

    /* Watermark */
    t.fillStyle = 'rgba(255,255,255,0.28)';
    t.font = '600 13px "Segoe UI", system-ui, sans-serif';
    t.textAlign = 'right'; t.textBaseline = 'bottom';
    t.fillText('mechsimulator.com', w - 14, totalH - 7);

    var a = document.createElement('a');
    a.href = tmp.toDataURL('image/png');
    a.download = 'beam-bending-' + beamType + '.png';
    a.click();
  }

  /* ── Light-theme report figure (print-friendly) ─────────────── */
  function buildReportDiagram() {
    var sp = getSupportPositions();
    var sc = 2;                          /* supersample for crisp print */
    var Wr = 1000;
    var pad = 22, gap = 16;
    var rows = [
      { key: 'beam', h: 150, label: 'Beam & Loading' },
      { key: 'sfd', h: 168, label: 'Shear Force Diagram  (V)' },
      { key: 'bmd', h: 168, label: 'Bending Moment Diagram  (M)' },
      { key: 'defl', h: 168, label: 'Deflected Shape  (δ)' }
    ];
    var Hr = pad * 2 + gap * (rows.length - 1);
    rows.forEach(function (r) { Hr += r.h; });

    var c = document.createElement('canvas');
    c.width = Wr * sc; c.height = Hr * sc;
    var x = c.getContext('2d');
    x.scale(sc, sc);
    x.fillStyle = '#ffffff'; x.fillRect(0, 0, Wr, Hr);

    var L = 78, R = Wr - 34;
    function px(frac) { return L + frac * (R - L); }

    /* deflection samples as {x, v} */
    var deflPts = [];
    var Nd = computedDeflMM.length;
    for (var i = 0; i < Nd; i++) deflPts.push({ x: i / (Nd - 1), v: computedDeflMM[i] });

    var y = pad;
    rows.forEach(function (row) {
      x.fillStyle = '#0d47a1';
      x.font = 'bold 13px "Segoe UI", system-ui, sans-serif';
      x.textAlign = 'left'; x.textBaseline = 'top';
      x.fillText(row.label, L, y);
      var top = y + 20, bot = y + row.h;

      if (row.key === 'beam') {
        drawReportBeam(x, px, L, R, top, bot, sp);
      } else if (row.key === 'sfd') {
        plotReportDiagram(x, px, sfdData, 'V', '#1b8a4b', 'rgba(61,220,132,0.20)', top, bot, 'force');
      } else if (row.key === 'bmd') {
        plotReportDiagram(x, px, bmdData, 'M', '#b8860b', 'rgba(245,200,66,0.22)', top, bot, 'moment');
      } else {
        plotReportDiagram(x, px, deflPts, 'v', '#9c1fb0', 'rgba(224,64,251,0.16)', top, bot, 'defl', true);
      }
      y += row.h + gap;
    });

    /* Watermark */
    x.fillStyle = 'rgba(13,71,161,0.20)';
    x.font = '600 12px "Segoe UI", system-ui, sans-serif';
    x.textAlign = 'right'; x.textBaseline = 'bottom';
    x.fillText('mechsimulator.com', R, Hr - 6);

    return c.toDataURL('image/png');
  }

  /* Plot one SFD/BMD/Deflection panel (light theme). valKey indexes the
     data points; unitKey selects display units for the peak label. The
     `alreadyMM` flag marks deflection data that is already in mm. */
  function plotReportDiagram(x, px, data, valKey, color, fillColor, top, bot, unitKey, isDefl) {
    var mid = (top + bot) / 2;
    var amp = (bot - top) / 2 - 16;
    var maxA = 0;
    if (data && data.length) data.forEach(function (d) { var v = d[valKey]; if (Math.abs(v) > maxA) maxA = Math.abs(v); });
    if (maxA < 1e-9) maxA = 1;
    var s = amp / maxA;

    /* axis box */
    x.strokeStyle = '#cfd8dc'; x.lineWidth = 1;
    x.strokeRect(px(0), top, px(1) - px(0), bot - top);
    /* zero axis */
    x.strokeStyle = '#90a4ae'; x.setLineDash([4, 3]); x.lineWidth = 1;
    x.beginPath(); x.moveTo(px(0), mid); x.lineTo(px(1), mid); x.stroke(); x.setLineDash([]);

    if (data && data.length) {
      /* filled area */
      x.fillStyle = fillColor; x.beginPath(); x.moveTo(px(0), mid);
      data.forEach(function (d) { x.lineTo(px(d.x), mid - d[valKey] * s); });
      x.lineTo(px(1), mid); x.closePath(); x.fill();
      /* curve */
      x.strokeStyle = color; x.lineWidth = 2; x.beginPath();
      data.forEach(function (d, i) {
        var X = px(d.x), Y = mid - d[valKey] * s;
        if (i === 0) x.moveTo(X, Y); else x.lineTo(X, Y);
      });
      x.stroke();

      /* peak annotation */
      var pk = 0, pkX = 0;
      data.forEach(function (d) { if (Math.abs(d[valKey]) > Math.abs(pk)) { pk = d[valKey]; pkX = d.x; } });
      if (Math.abs(pk) > 1e-9) {
        var dotX = px(pkX), dotY = mid - pk * s;
        x.fillStyle = color; x.beginPath(); x.arc(dotX, dotY, 3, 0, Math.PI * 2); x.fill();
        var disp = isDefl ? toDisplay(pk, 'defl') : toDisplay(pk, unitKey);
        var unitShort = isDefl ? U().defl.short : (unitKey === 'moment' ? U().moment.short : U().force.short);
        var lbl = (disp > 0 ? '+' : '') + disp.toFixed(2) + ' ' + unitShort;
        x.font = 'bold 11px "Courier New", monospace'; x.fillStyle = '#263238';
        x.textAlign = 'center'; x.textBaseline = pk < 0 ? 'top' : 'bottom';
        x.fillText(lbl, dotX, dotY + (pk < 0 ? 5 : -5));
      }
    }
    /* y-axis label */
    x.save(); x.translate(L0(px) - 30, mid); x.rotate(-Math.PI / 2);
    x.fillStyle = '#546e7a'; x.font = '600 10px "Segoe UI", system-ui, sans-serif';
    x.textAlign = 'center'; x.textBaseline = 'middle';
    x.fillText(isDefl ? U().deflAx.label : (unitKey === 'moment' ? U().bmd.label : U().sfd.label), 0, 0);
    x.restore();
  }
  function L0(px) { return px(0); }

  /* Beam schematic for the report (light theme). */
  function drawReportBeam(x, px, L, R, top, bot, sp) {
    var beamY = bot - 34;
    /* beam */
    x.strokeStyle = '#00838f'; x.lineWidth = 4; x.lineCap = 'round';
    x.beginPath(); x.moveTo(px(0), beamY); x.lineTo(px(1), beamY); x.stroke(); x.lineCap = 'butt';

    function triangle(cx) {
      x.strokeStyle = '#6a1b9a'; x.lineWidth = 1.6; x.fillStyle = '#ede7f6';
      x.beginPath(); x.moveTo(cx, beamY); x.lineTo(cx - 8, beamY + 14); x.lineTo(cx + 8, beamY + 14);
      x.closePath(); x.fill(); x.stroke();
      x.beginPath(); x.moveTo(cx - 13, beamY + 16); x.lineTo(cx + 13, beamY + 16); x.stroke();
    }
    if (beamType === 'cantilever') {
      var fx = px(sp.a);
      x.strokeStyle = '#6a1b9a'; x.lineWidth = 2;
      x.beginPath(); x.moveTo(fx, beamY - 20); x.lineTo(fx, beamY + 20); x.stroke();
      x.lineWidth = 1;
      for (var i = -16; i <= 16; i += 6) { x.beginPath(); x.moveTo(fx, beamY + i); x.lineTo(fx - 9, beamY + i + 7); x.stroke(); }
    } else {
      triangle(px(sp.a));
      if (sp.b >= 0) triangle(px(sp.b));
    }

    /* loads */
    loads.forEach(function (ld) {
      if (ld.type === 'point') {
        var lx = px(ld.pos), aTop = beamY - 42;
        x.strokeStyle = '#c62828'; x.lineWidth = 2;
        x.beginPath(); x.moveTo(lx, aTop); x.lineTo(lx, beamY - 3); x.stroke();
        x.fillStyle = '#c62828'; x.beginPath();
        x.moveTo(lx, beamY - 1); x.lineTo(lx - 5, beamY - 11); x.lineTo(lx + 5, beamY - 11); x.closePath(); x.fill();
        x.font = 'bold 10px "Courier New", monospace'; x.textAlign = 'center'; x.textBaseline = 'bottom';
        x.fillText(fmtMag(ld.mag, 'force') + ' ' + U().force.short, lx, aTop - 3);
      } else if (ld.type === 'udl') {
        var x1 = px(ld.pos), x2 = px(ld.end), uTop = beamY - 34;
        x.fillStyle = 'rgba(198,40,40,0.12)'; x.fillRect(x1, uTop, x2 - x1, beamY - uTop - 3);
        x.strokeStyle = '#c62828'; x.lineWidth = 1.4;
        x.beginPath(); x.moveTo(x1, uTop); x.lineTo(x2, uTop); x.stroke();
        var n = Math.max(3, Math.round((x2 - x1) / 26));
        for (var j = 0; j <= n; j++) {
          var ax = x1 + (x2 - x1) * j / n;
          x.lineWidth = 1; x.beginPath(); x.moveTo(ax, uTop); x.lineTo(ax, beamY - 4); x.stroke();
          x.fillStyle = '#c62828'; x.beginPath();
          x.moveTo(ax, beamY - 2); x.lineTo(ax - 3, beamY - 8); x.lineTo(ax + 3, beamY - 8); x.closePath(); x.fill();
        }
        x.fillStyle = '#c62828'; x.font = 'bold 10px "Courier New", monospace';
        x.textAlign = 'center'; x.textBaseline = 'bottom';
        x.fillText(fmtMag(ld.mag, 'dist') + ' ' + U().dist.short, (x1 + x2) / 2, uTop - 3);
      } else if (ld.type === 'moment') {
        var mx = px(ld.pos);
        x.strokeStyle = '#ad6800'; x.lineWidth = 2;
        x.beginPath(); x.arc(mx, beamY, 12, Math.PI * 0.25, Math.PI * 1.75); x.stroke();
        x.fillStyle = '#ad6800'; x.beginPath();
        x.moveTo(mx + 8.5, beamY - 8.5); x.lineTo(mx + 14, beamY - 6); x.lineTo(mx + 11, beamY - 12); x.closePath(); x.fill();
        x.font = 'bold 10px "Courier New", monospace'; x.textAlign = 'center'; x.textBaseline = 'bottom';
        x.fillText(fmtMag(ld.mag, 'moment') + ' ' + U().moment.short, mx, beamY - 18);
      }
    });

    /* span dimension */
    var dimY = beamY + 26;
    x.strokeStyle = '#90a4ae'; x.lineWidth = 1;
    x.beginPath(); x.moveTo(px(0), dimY); x.lineTo(px(1), dimY); x.stroke();
    x.beginPath(); x.moveTo(px(0), dimY - 4); x.lineTo(px(0), dimY + 4);
    x.moveTo(px(1), dimY - 4); x.lineTo(px(1), dimY + 4); x.stroke();
    x.fillStyle = '#546e7a'; x.font = '600 10px "Segoe UI", system-ui, sans-serif';
    x.textAlign = 'center'; x.textBaseline = 'top';
    x.fillText('L = ' + fmtD(beamLength, 'length') + ' ' + U().length.short, (px(0) + px(1)) / 2, dimY + 4);
  }

  /* Section description string for the report (display-independent SI). */
  function sectionDesc() {
    if (secShape === 'rect') return 'Rectangle ' + (secB * 1000).toFixed(0) + ' × ' + (secH * 1000).toFixed(0) + ' mm (b×h)';
    if (secShape === 'circle') return 'Solid circle ⌀ ' + (secD * 1000).toFixed(0) + ' mm';
    return 'Custom section';
  }

  /* ── Professional PDF report (print-to-PDF, no dependencies) ─── */
  function exportReport() {
    render(); /* refresh reactions / SFD / BMD / deflection */

    if (loads.length === 0) {
      alert('Add at least one load before exporting a report.');
      return;
    }

    var diagram = buildReportDiagram();
    var now = new Date();
    var dateStr = now.toISOString().slice(0, 10);
    var timeStr = now.toTimeString().slice(0, 5);
    var reportNo = 'BB-' + dateStr.replace(/-/g, '') + '-' + Math.floor(Math.random() * 9000 + 1000);

    var isCant = beamType === 'cantilever';
    var EI = matE * secI;

    /* KPI values in display units */
    var kRa = fmtD(Math.abs(reactions.Ra), 'force', 2);
    var kRb = fmtD(Math.abs(reactions.Rb), 'force', 2);
    var kMa = fmtD(Math.abs(reactions.Ma), 'moment', 2);
    var kV = fmtD(Math.abs(getMaxShear()), 'force', 2);
    var kM = fmtD(Math.abs(getMaxBM()), 'moment', 2);
    var kDef = toDisplay(Math.abs(computedMaxDefl), 'defl').toFixed(2);
    var kW = fmtD(getTotalLoad(), 'force', 2);

    /* Loads table rows */
    var loadRows = loads.map(function (ld, i) {
      var d = loadDesc(ld);
      return '<tr><td>' + (i + 1) + '</td><td>' + escapeHtml(d.type) + '</td><td>' +
        escapeHtml(d.mag) + '</td><td>' + escapeHtml(d.at) + '</td></tr>';
    }).join('');

    /* Support row (config) */
    var sp = getSupportPositions();
    var supportInfo;
    if (isCant) supportInfo = 'Fixed at left end (x = 0)';
    else if (beamType === 'overhanging')
      supportInfo = 'Pin at x = ' + fmtD(sp.a * beamLength, 'length') + ', roller at x = ' +
        fmtD(sp.b * beamLength, 'length') + ' ' + U().length.short;
    else supportInfo = 'Pin at left end, roller at right end';

