  /* ================================================================
     RENDER
     ================================================================ */
  function render() {
    if (mode === 'simulate') recalcZones();
    ctx.clearRect(0, 0, W, H);
    /* Subtle vertical depth gradient instead of a flat fill — lifts the
       diagrams off a dead-black background without hurting contrast. */
    var bgGrad = ctx.createLinearGradient(0, 0, 0, H);
    bgGrad.addColorStop(0, '#10151d');
    bgGrad.addColorStop(0.5, '#0d1117');
    bgGrad.addColorStop(1, '#0b0e14');
    ctx.fillStyle = bgGrad;
    ctx.fillRect(0, 0, W, H);

    if (mode === 'simulate') {
      calculateAll();
      drawSimulate();
      updateReadouts();
    } else if (mode === 'explore') {
      var c = CONCEPTS.filter(function (cc) { return cc.cat === selCat; });
      if (c[selConcept]) drawConceptDiagram(c[selConcept]);
    } else if (mode === 'practice') {
      drawPracticeCanvas();
    } else if (mode === 'quiz') {
      drawQuizCanvas();
    }
  }

