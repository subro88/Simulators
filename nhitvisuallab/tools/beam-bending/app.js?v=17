  function U() { return UNITS[unitSystem]; }

  /* Convert SI value to display value */
  function toDisplay(siVal, unitKey) { return siVal * U()[unitKey].factor; }
  /* Convert display value back to SI */
  function toSI(dispVal, unitKey) { return dispVal / U()[unitKey].factor; }
  /* Format a display value */
  function fmtD(siVal, unitKey, dec) {
    return toDisplay(siVal, unitKey).toFixed(dec !== undefined ? dec : 1);
  }
  /* Format an EDITABLE magnitude for an input box: keep up to 2 decimals
     so values like 0.75 survive, but drop trailing zeros (10, 5.5, 0.75). */
  function fmtMag(siVal, unitKey) {
    var v = Math.round(toDisplay(siVal, unitKey) * 100) / 100;
    return String(v);
  }

  var mode = 'simulate';
  var beamType = 'simply-supported';
  var beamLength = 6;       /* m */
  var loads = [];            /* {type:'point'|'udl', pos:0-1, mag:kN, end:0-1 (for UDL)} */
  var reactions = { Ra: 0, Rb: 0, Ma: 0 };
  var sfdData = [];          /* [{x, V}] */
  var bmdData = [];          /* [{x, M}] */
  var hoverX = -1;           /* normalised 0-1, -1 = none */
  var computedMaxDefl = 0;   /* mm — set by drawDeflection(), read by updateReadouts() */

  /* Slider defaults (used when placing new loads) */
  var defaultMag = 10;       /* kN — default for new point loads */
  var defaultUDLMag = 5;     /* kN/m — default for new UDLs */
  var defaultMoment = 10;    /* kN·m — default for new moments */

  /* ── Section & material (drive the deflection curve) ──────────
     All internal values are SI: E in Pa, I in m⁴. The UI lets the
     user pick a material (E) and a cross-section (→ I) so the
     deflection reflects a real beam: δ ∝ 1/(E·I). */
  var matE = 200e9;          /* Pa — Young's modulus (steel default) */
  var secShape = 'rect';     /* 'rect' | 'circle' | 'custom' */
  var secB = 0.1;            /* m — rectangle width  (100 mm) */
  var secH = 0.2;            /* m — rectangle depth  (200 mm) */
  var secD = 0.15;           /* m — circle diameter  (150 mm) */
  var secICustom = 6.667e-5; /* m⁴ — directly-entered I */
  var secI = 6.667e-5;       /* m⁴ — current second moment of area (recomputed) */

  function computeSectionI() {
    if (secShape === 'rect') return secB * secH * secH * secH / 12;
    if (secShape === 'circle') return Math.PI * Math.pow(secD, 4) / 64;
    return secICustom;
  }

  /* Selection & Drag */
  var selectedIdx = -1;        /* index into loads[], -1 = none */
  var hoveredIdx = -1;         /* index of load under cursor */
  var hoveredHandle = null;    /* null | 'body' | 'start' | 'end' */
  var drag = { active: false, loadIdx: -1, handle: null, startFrac: 0, origPos: 0, origEnd: 0, undone: false };
  var activeTool = 'point';    /* 'point' | 'udl' | 'select' */

  /* Show load distance dimension lines */
  var showDimLines = true;

  /* Diagram visibility toggles */
  var showSFD = true;
  var showBMD = true;
  var showDefl = true;

  /* Undo / Redo */
  var undoStack = [];
  var redoStack = [];
  var MAX_UNDO = 40;

  function saveUndo() {
    undoStack.push(JSON.stringify(loads));
    if (undoStack.length > MAX_UNDO) undoStack.shift();
    redoStack = [];
  }
  function undo() {
    if (undoStack.length === 0) return;
    redoStack.push(JSON.stringify(loads));
    loads = JSON.parse(undoStack.pop());
    selectedIdx = -1;
    syncPanelToSelection();
    render();
  }
  function redo() {
    if (redoStack.length === 0) return;
    undoStack.push(JSON.stringify(loads));
    loads = JSON.parse(redoStack.pop());
    selectedIdx = -1;
    syncPanelToSelection();
    render();
  }

  /* Overhanging support positions (normalised 0-1) — draggable */
  var supportA = 0.15;
  var supportB = 0.85;
  var dragSupport = { active: false, which: null, startFrac: 0, origVal: 0 }; /* which: 'a' | 'b' */
  var hoveredSupport = null; /* null | 'a' | 'b' */

  /* Explore */
  var selCat = 'basics';
  var selConcept = 0;

  /* Practice */
  var pProblem = null, pScore = 0, pTotal = 0, pAnswered = false;

  /* Quiz */
  var quizQs = [], quizIdx = 0, quizScore = 0, quizAnswered = false;

  /* Support positions (normalised 0-1) */
  function getSupportPositions() {
    if (beamType === 'simply-supported') return { a: 0, b: 1 };
    if (beamType === 'cantilever') return { a: 0, b: -1 }; /* -1 = no second support */
    if (beamType === 'overhanging') return { a: supportA, b: supportB };
    return { a: 0, b: 1 };
  }

  /* ================================================================
     PHYSICS ENGINE
     ================================================================ */

  function calculateAll() {
    var sp = getSupportPositions();
    calculateReactions(sp);
    calculateSFD(sp);
    calculateBMD();
  }

  function calculateReactions(sp) {
    var totalForce = 0;
    var totalMomentAboutA = 0;
    var aPos = sp.a * beamLength;
    var bPos = sp.b >= 0 ? sp.b * beamLength : -1;

    loads.forEach(function (ld) {
      if (ld.type === 'point') {
        var xPos = ld.pos * beamLength;
        totalForce += ld.mag;
        totalMomentAboutA += ld.mag * (xPos - aPos);
      } else if (ld.type === 'udl') {
        var x1 = ld.pos * beamLength;
        var x2 = ld.end * beamLength;
        var udlLen = x2 - x1;
        var W = ld.mag * udlLen;
        var xCentroid = (x1 + x2) / 2;
        totalForce += W;
        totalMomentAboutA += W * (xCentroid - aPos);
      } else if (ld.type === 'moment') {
        /* Pure couple — no force, only moment contribution */
        totalMomentAboutA += ld.mag; /* positive = clockwise */
      }
    });

    if (beamType === 'cantilever') {
      /* Fixed at left: Ra = total load, Ma = total moment about fixed end */
      reactions.Ra = totalForce;
      reactions.Rb = 0;
      reactions.Ma = totalMomentAboutA; /* negative = anticlockwise restraint */
    } else {
      /* Simply supported or overhanging */
      var span = bPos - aPos;
      if (span <= 0) { reactions.Ra = totalForce; reactions.Rb = 0; reactions.Ma = 0; return; }
      reactions.Rb = totalMomentAboutA / span;
      reactions.Ra = totalForce - reactions.Rb;
      reactions.Ma = 0;
    }
  }

  /* Exact shear at a normalised position (same left-section convention
     as the sampled arrays — used for the plots AND for exact extremes at
     discontinuities, which a 200-point grid can miss by up to w·L/200). */
  function shearAtFrac(frac, sp) {
    var x = frac * beamLength;
    var V = 0;

    /* Add reaction at support A */
    var aPos = sp.a * beamLength;
    if (x >= aPos) V += reactions.Ra;

    /* Add reaction at support B */
    if (sp.b >= 0) {
      var bPos = sp.b * beamLength;
      if (x >= bPos) V += reactions.Rb;
    }

    /* Cantilever moment reaction doesn't affect shear directly */

    /* Subtract loads to the left */
    loads.forEach(function (ld) {
      if (ld.type === 'point') {
        var lx = ld.pos * beamLength;
        if (x >= lx) V -= ld.mag;
      } else if (ld.type === 'udl') {
        var x1 = ld.pos * beamLength;
        var x2 = ld.end * beamLength;
        if (x > x1) {
          var effEnd = Math.min(x, x2);
          var effLen = effEnd - x1;
          V -= ld.mag * effLen;
        }
      }
    });
    return V;
  }

  /* Exact bending moment at a normalised position */
  function momentAtFrac(frac, sp) {
    var x = frac * beamLength;
    var M = 0;

    /* Moment from reaction A */
    var aPos = sp.a * beamLength;
    if (x >= aPos) M += reactions.Ra * (x - aPos);

    /* Fixed-end moment (cantilever) */
    if (beamType === 'cantilever' && x >= aPos) {
      M -= reactions.Ma;
    }

    /* Moment from reaction B */
    if (sp.b >= 0) {
      var bPos = sp.b * beamLength;
      if (x >= bPos) M += reactions.Rb * (x - bPos);
    }

    /* Subtract moments from loads */
    loads.forEach(function (ld) {
      if (ld.type === 'point') {
        var lx = ld.pos * beamLength;
        if (x >= lx) M -= ld.mag * (x - lx);
      } else if (ld.type === 'udl') {
        var x1 = ld.pos * beamLength;
        var x2 = ld.end * beamLength;
        if (x > x1) {
          var effEnd = Math.min(x, x2);
          var effLen = effEnd - x1;
          M -= ld.mag * effLen * (x - x1 - effLen / 2);
        }
      } else if (ld.type === 'moment') {
        var mx = ld.pos * beamLength;
        /* CW couple (positive ld.mag) on the left of section adds +M0 to the
           sagging-positive bending moment (decompose couple into ±F at ±e). */
        if (x >= mx) M += ld.mag;
      }
    });
    return M;
  }

  /* Fractions where V or M can jump / kink: supports and load boundaries */
  function criticalFracs(sp) {
    var f = [0, 1, sp.a];
    if (sp.b >= 0) f.push(sp.b);
    loads.forEach(function (ld) {
      f.push(ld.pos);
      if (ld.type === 'udl') f.push(ld.end);
    });
    return f;
  }

  /* Exact extremes: sampled grid + evaluation just left/right of every
     discontinuity, so step values (e.g. V just left of a support) are exact. */
  function findExtremes(fn, data, key, sp) {
    var ext = { max: -Infinity, maxX: 0, min: Infinity, minX: 0 };
    function consider(x, v) {
      if (v > ext.max) { ext.max = v; ext.maxX = x; }
      if (v < ext.min) { ext.min = v; ext.minX = x; }
    }
    data.forEach(function (p) { consider(p.x, p[key]); });
    var EPS = 1e-6;
    criticalFracs(sp).forEach(function (c) {
      var lo = Math.max(0, c - EPS), hi = Math.min(1, c + EPS);
      consider(lo, fn(lo, sp));
      consider(hi, fn(hi, sp));
    });
    if (!isFinite(ext.max)) { ext.max = 0; ext.min = 0; }
    return ext;
  }

  var sfdExt = { max: 0, maxX: 0, min: 0, minX: 0 };
  var bmdExt = { max: 0, maxX: 0, min: 0, minX: 0 };

  function calculateSFD(sp) {
    var N = 200;
    sfdData = [];
    for (var i = 0; i <= N; i++) {
      var frac = i / N;
      sfdData.push({ x: frac, V: shearAtFrac(frac, sp) });
    }
    sfdExt = findExtremes(shearAtFrac, sfdData, 'V', sp);
  }

  function calculateBMD() {
    var sp = getSupportPositions();
    var N = 200;
    bmdData = [];
    for (var i = 0; i <= N; i++) {
      var frac = i / N;
      bmdData.push({ x: frac, M: momentAtFrac(frac, sp) });
    }
    bmdExt = findExtremes(momentAtFrac, bmdData, 'M', sp);
  }

  function getMaxShear() {
    return Math.abs(sfdExt.max) >= Math.abs(sfdExt.min) ? sfdExt.max : sfdExt.min;
  }

  function getMaxBM() {
    return Math.abs(bmdExt.max) >= Math.abs(bmdExt.min) ? bmdExt.max : bmdExt.min;
  }

  function getTotalLoad() {
    var total = 0;
    loads.forEach(function (ld) {
      if (ld.type === 'point') total += ld.mag;
      else if (ld.type === 'udl') total += ld.mag * (ld.end - ld.pos) * beamLength;
    });
    return total;
  }

  /* ================================================================
     DRAWING — SIMULATE MODE
     ================================================================ */

  /* Layout zones */
  /* Zone positions — recalculated by recalcZones() */
  var BEAM_Y0 = 10, BEAM_Y1 = 165;
  var SFD_Y0 = 175, SFD_Y1 = 340;
  var BMD_Y0 = 350, BMD_Y1 = 510;
  var DEFL_Y0 = 520, DEFL_Y1 = 670;
  var ZONE_H = 160; /* height per diagram zone */

  function recalcZones() {
    BEAM_Y0 = 10; BEAM_Y1 = 165;
    var y = BEAM_Y1 + 10;
    if (showSFD) { SFD_Y0 = y; SFD_Y1 = y + ZONE_H; y = SFD_Y1 + 10; }
    if (showBMD) { BMD_Y0 = y; BMD_Y1 = y + ZONE_H; y = BMD_Y1 + 10; }
    if (showDefl) { DEFL_Y0 = y; DEFL_Y1 = y + ZONE_H; y = DEFL_Y1 + 10; }
    H = Math.max(y, BEAM_Y1 + 20);
    cvs.width = W * dpr; cvs.height = H * dpr;
    ctx.scale(dpr, dpr);
    cvs.style.height = ''; /* let CSS auto-calc from width */
  }

  var MARGIN_L = 80, MARGIN_R = 40;
  var beamDrawL = MARGIN_L;
  var beamDrawR = W - MARGIN_R;

  function beamX(frac) { return beamDrawL + frac * (beamDrawR - beamDrawL); }

  function drawSimulate() {
    var sp = getSupportPositions();

    /* ── Zone labels ── */
    ctx.font = '600 10px "Segoe UI", sans-serif';
    ctx.textAlign = 'left'; ctx.textBaseline = 'top';
    ctx.fillStyle = '#00acc1';
    ctx.fillText('BEAM DIAGRAM', 8, BEAM_Y0 + 2);
    if (showSFD) { ctx.fillStyle = '#3ddc84'; ctx.fillText('SFD (V)', 8, SFD_Y0 + 2); }
    if (showBMD) { ctx.fillStyle = '#f5c842'; ctx.fillText('BMD (M)', 8, BMD_Y0 + 2); }
    if (showDefl) { ctx.fillStyle = '#e040fb'; ctx.fillText('DEFLECTION (\u03B4)', 8, DEFL_Y0 + 2); }

    /* ── Beam member ── neutral-axis line given depth: a soft drop shadow so
       it sits above the background, a vertical body gradient so it reads as a
       solid member rather than a flat stroke, and a thin top highlight. */
    var beamY = BEAM_Y0 + 80;
    var bL = beamX(0), bR = beamX(1);
    ctx.save();
    ctx.shadowColor = 'rgba(0,0,0,0.45)';
    ctx.shadowBlur = 6;
    ctx.shadowOffsetY = 3;
    var beamGrad = ctx.createLinearGradient(0, beamY - 3, 0, beamY + 3);
    beamGrad.addColorStop(0, '#4fd4e6');
    beamGrad.addColorStop(0.5, '#00acc1');
    beamGrad.addColorStop(1, '#00788a');
    ctx.strokeStyle = beamGrad;
    ctx.lineWidth = 6;
    ctx.lineCap = 'round';
    ctx.beginPath();
    ctx.moveTo(bL, beamY);
    ctx.lineTo(bR, beamY);
    ctx.stroke();
    ctx.restore();
    /* top highlight */
    ctx.strokeStyle = 'rgba(255,255,255,0.30)';
    ctx.lineWidth = 1;
    ctx.lineCap = 'round';
    ctx.beginPath();
    ctx.moveTo(bL + 2, beamY - 1.6);
    ctx.lineTo(bR - 2, beamY - 1.6);
    ctx.stroke();
    ctx.lineCap = 'butt';

    /* ── Supports ── */
    drawSupports(sp, beamY);

    /* ── Loads ── */
    drawLoads(beamY);

    /* ── Dimension lines ── */
    drawDimensionLines(beamY);

    /* ── Reactions ── */
    drawReactions(sp, beamY);

    /* ── SFD ── */
    if (showSFD) drawSFD();

    /* ── BMD ── */
    if (showBMD) drawBMD();

    /* ── Deflected shape (always compute for readout, only draw when toggled on) ── */
    computeDeflection();
    if (showDefl) drawDeflection();

    /* ── Inline +/− controls for selected load ── */
    if (selectedIdx >= 0 && selectedIdx < loads.length) {
      drawInlineControls(beamY);
    }

    /* ── Hover crosshair ── */
    if (hoverX >= 0 && hoverX <= 1 && !drag.active && !dragSupport.active) {
      drawHoverLine(beamY);
    }
  }

  /* ── Inline canvas controls — floating HTML overlay ─────── */
  /* Create the overlay: [ − ] [ input ] [ + ] positioned over the canvas */
  var inlineOverlay = document.createElement('div');
  inlineOverlay.className = 'inline-mag-overlay';
  inlineOverlay.style.display = 'none';
  inlineOverlay.innerHTML =
    '<button class="imo-btn" id="imo-dec">\u2212</button>' +
    '<input class="imo-input" id="imo-val" type="number" step="any">' +
    '<button class="imo-btn" id="imo-inc">+</button>' +
    '<span class="imo-unit" id="imo-unit">kN</span>';
  /* Insert inside the canvas-card for position:absolute to work relative to canvas */
  cvs.parentElement.appendChild(inlineOverlay);

  var imoInput = inlineOverlay.querySelector('#imo-val');
  var imoUnit  = inlineOverlay.querySelector('#imo-unit');

  /* Position the overlay above the selected load */
  function positionInlineOverlay() {
    if (selectedIdx < 0 || selectedIdx >= loads.length) {
      inlineOverlay.style.display = 'none';
      return;
    }
    var ld = loads[selectedIdx];
    var lim = MAG_LIMITS[ld.type];
    var rect = cvs.getBoundingClientRect();
    var scaleX = rect.width / W;
    var scaleY = rect.height / H;

    /* Find the X center and the label Y of the load */
    var beamY = BEAM_Y0 + 80;
    var cx, topOfLabel;
    if (ld.type === 'point') {
      cx = beamX(ld.pos);
      topOfLabel = beamY - 62; /* just above the "XX.X kN" label */
    } else if (ld.type === 'moment') {
      cx = beamX(ld.pos);
      topOfLabel = beamY - 38;
    } else {
      cx = (beamX(ld.pos) + beamX(ld.end)) / 2;
      topOfLabel = beamY - 52;
    }

    /* Position overlay above the label text, centered on load */
    var overlayW = inlineOverlay.offsetWidth || 170;
    var leftPx = cx * scaleX - overlayW / 2;
    var topPx = (topOfLabel - 28) * scaleY; /* 28px above the label */

    /* Clamp inside canvas bounds */
    leftPx = Math.max(4, Math.min(rect.width - overlayW - 4, leftPx));
    topPx = Math.max(2, topPx);

    inlineOverlay.style.left = leftPx + 'px';
    inlineOverlay.style.top = topPx + 'px';
    inlineOverlay.style.display = 'flex';

    /* Determine display unit key for this load type */
    var unitKey = ld.type === 'point' ? 'force' : (ld.type === 'moment' ? 'moment' : 'dist');

    /* Sync value (skip if user is actively typing) */
    if (document.activeElement !== imoInput) {
      imoInput.value = fmtMag(ld.mag, unitKey);
    }
    imoInput.min = toDisplay(lim.min, unitKey);
    imoInput.max = toDisplay(lim.max, unitKey);
    imoInput.step = 'any'; /* allow fine decimals (e.g. 0.75) */
    imoUnit.textContent = U()[unitKey].short;
  }

  function hideInlineOverlay() {
    inlineOverlay.style.display = 'none';
  }

  /* Wire up overlay input */
  var imoUndoSaved = false; /* save undo only once per edit session */

  function imoUnitKey() {
    if (selectedIdx < 0) return 'force';
    var t = loads[selectedIdx].type;
    return t === 'point' ? 'force' : (t === 'moment' ? 'moment' : 'dist');
  }

  imoInput.addEventListener('input', function () {
    if (selectedIdx < 0) return;
    var v = parseFloat(this.value);
    if (isNaN(v)) return;
    if (!imoUndoSaved) { saveUndo(); imoUndoSaved = true; }
    loads[selectedIdx].mag = clampMag(loads[selectedIdx].type, toSI(v, imoUnitKey()));
    syncPanelToSelection();
    render();
  });
  imoInput.addEventListener('blur', function () {
    if (selectedIdx >= 0) {
      var ld = loads[selectedIdx];
      var uk = imoUnitKey();
      ld.mag = clampMag(ld.type, toSI(+this.value || toDisplay(ld.mag, uk), uk));
      this.value = fmtMag(ld.mag, uk);
      syncPanelToSelection();
      render();
    }
    imoUndoSaved = false;
  });
  imoInput.addEventListener('keydown', function (e) {
    if (e.key === 'Enter') { e.preventDefault(); this.blur(); }
    e.stopPropagation(); /* prevent Ctrl+Z from triggering undo while typing */
  });
  imoInput.addEventListener('focus', function () {
    imoUndoSaved = false;
    this.select(); /* select all text on focus for easy overwrite */
  });

  /* Overlay stepper buttons with hold-to-repeat */
  var imoRepeatId = 0;
  function startImoStep(dir) {
    if (selectedIdx < 0) return;
    saveUndo();
    adjustMag(dir);
    if (selectedIdx >= 0) imoInput.value = toDisplay(loads[selectedIdx].mag, imoUnitKey()).toFixed(1);
    var delay = 300;
    function rep() {
      adjustMag(dir);
      if (selectedIdx >= 0) imoInput.value = fmtMag(loads[selectedIdx].mag, imoUnitKey());
      delay = Math.max(50, delay * 0.8);
      imoRepeatId = setTimeout(rep, delay);
    }
    imoRepeatId = setTimeout(rep, delay);
  }
  function stopImoStep() { clearTimeout(imoRepeatId); imoRepeatId = 0; }

  inlineOverlay.querySelector('#imo-dec').addEventListener('pointerdown', function (e) { e.preventDefault(); startImoStep(-1); });
  inlineOverlay.querySelector('#imo-dec').addEventListener('pointerup', stopImoStep);
  inlineOverlay.querySelector('#imo-dec').addEventListener('pointerleave', stopImoStep);
  inlineOverlay.querySelector('#imo-inc').addEventListener('pointerdown', function (e) { e.preventDefault(); startImoStep(1); });
  inlineOverlay.querySelector('#imo-inc').addEventListener('pointerup', stopImoStep);
  inlineOverlay.querySelector('#imo-inc').addEventListener('pointerleave', stopImoStep);

  /* Old canvas-drawn inline buttons removed — replaced by HTML overlay */
  function drawInlineControls(/* beamY */) {
    positionInlineOverlay();
  }

  /* Stubs for old hit-testing (no longer needed — HTML handles clicks) */
  function hitTestInlineBtn() { return null; }

  /* Load magnitude limits */
  var MAG_LIMITS = {
    point:  { min: 0.5, max: 500, step: 1,   unit: ' kN' },
    udl:    { min: 0.5, max: 100, step: 0.5,  unit: ' kN/m' },
    moment: { min: -200, max: 200, step: 1,   unit: ' kN\u00B7m' }
  };

  function clampMag(type, val) {
    var lim = MAG_LIMITS[type];
    return Math.max(lim.min, Math.min(lim.max, val));
  }

  function adjustMag(dir) {
    if (selectedIdx < 0 || selectedIdx >= loads.length) return;
    var ld = loads[selectedIdx];
    /* Adaptive step: bigger step for bigger current values */
    var absMag = Math.abs(ld.mag);
    var step = absMag >= 100 ? 10 : (absMag >= 50 ? 5 : (absMag >= 20 ? 2 : MAG_LIMITS[ld.type].step));
    ld.mag = clampMag(ld.type, ld.mag + dir * step);
    syncPanelToSelection();
    render();
  }

  function drawSupports(sp, beamY) {
    var triH = 18, triW = 14;

    /* Soft elliptical contact shadow so a support reads as sitting on ground. */
    function contactShadow(cx, groundY, rw) {
      var g = ctx.createRadialGradient(cx, groundY, 1, cx, groundY, rw);
      g.addColorStop(0, 'rgba(0,0,0,0.45)');
      g.addColorStop(1, 'rgba(0,0,0,0)');
      ctx.save();
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.ellipse(cx, groundY, rw, rw * 0.30, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    }
    /* Vertical gradient so a support body looks solid, not a hollow outline. */
    function bodyGrad(yTop, yBot, hov) {
      var g = ctx.createLinearGradient(0, yTop, 0, yBot);
      var rgb = hov ? '0,172,193' : '171,71,188';
      g.addColorStop(0, 'rgba(' + rgb + ',0.50)');
      g.addColorStop(1, 'rgba(' + rgb + ',0.12)');
      return g;
    }

    if (beamType === 'cantilever') {
      /* Fixed support at left — hatched wall */
      var fx = beamX(sp.a);
      /* solid gradient wall slab behind the hatching for depth */
      var wallGrad = ctx.createLinearGradient(fx - 11, 0, fx, 0);
      wallGrad.addColorStop(0, 'rgba(171,71,188,0.06)');
      wallGrad.addColorStop(1, 'rgba(171,71,188,0.34)');
      ctx.fillStyle = wallGrad;
      ctx.fillRect(fx - 11, beamY - 25, 11, 50);
      ctx.strokeStyle = '#ab47bc'; ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(fx, beamY - 25); ctx.lineTo(fx, beamY + 25);
      ctx.stroke();
      /* Hatching */
      ctx.lineWidth = 1;
      for (var i = -20; i <= 20; i += 6) {
        ctx.beginPath();
        ctx.moveTo(fx, beamY + i);
        ctx.lineTo(fx - 10, beamY + i + 8);
        ctx.stroke();
      }
    } else if (beamType === 'simply-supported') {
      /* Pin at A */
      var ax = beamX(sp.a);
      contactShadow(ax, beamY + triH + 3, triW + 2);
      ctx.fillStyle = bodyGrad(beamY, beamY + triH, false);
      ctx.strokeStyle = '#ab47bc'; ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(ax, beamY);
      ctx.lineTo(ax - triW / 2, beamY + triH);
      ctx.lineTo(ax + triW / 2, beamY + triH);
      ctx.closePath();
      ctx.fill();
      ctx.stroke();
      ctx.strokeStyle = '#ab47bc'; ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(ax - triW, beamY + triH + 2);
      ctx.lineTo(ax + triW, beamY + triH + 2);
      ctx.stroke();

      /* Roller at B */
      var bx = beamX(sp.b);
      contactShadow(bx, beamY + triH + 11, triW + 2);
      ctx.fillStyle = bodyGrad(beamY, beamY + triH, false);
      ctx.strokeStyle = '#ab47bc'; ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(bx, beamY);
      ctx.lineTo(bx - triW / 2, beamY + triH);
      ctx.lineTo(bx + triW / 2, beamY + triH);
      ctx.closePath();
      ctx.fill();
      ctx.stroke();
      /* Roller circle */
      ctx.fillStyle = 'rgba(171,71,188,0.35)';
      ctx.beginPath();
      ctx.arc(bx, beamY + triH + 5, 4, 0, Math.PI * 2);
      ctx.fill();
      ctx.stroke();
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(bx - triW, beamY + triH + 11);
      ctx.lineTo(bx + triW, beamY + triH + 11);
      ctx.stroke();
    } else if (beamType === 'overhanging') {
      /* Pin at A — draggable */
      var axO = beamX(sp.a);
      var isHovA = hoveredSupport === 'a' || (dragSupport.active && dragSupport.which === 'a');
      if (!isHovA) contactShadow(axO, beamY + triH + 3, triW + 2);
      if (isHovA) { ctx.shadowColor = '#00acc1'; ctx.shadowBlur = 12; }
      ctx.fillStyle = bodyGrad(beamY, beamY + triH, isHovA);
      ctx.strokeStyle = isHovA ? '#00acc1' : '#ab47bc'; ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(axO, beamY);
      ctx.lineTo(axO - triW / 2, beamY + triH);
      ctx.lineTo(axO + triW / 2, beamY + triH);
      ctx.closePath();
      ctx.fill();
      ctx.stroke();
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(axO - triW, beamY + triH + 2);
      ctx.lineTo(axO + triW, beamY + triH + 2);
      ctx.stroke();
      ctx.shadowBlur = 0;
      /* Drag hint arrows */
      if (isHovA) {
        ctx.fillStyle = '#00acc1'; ctx.font = '700 9px "Segoe UI", sans-serif';
        ctx.textAlign = 'center'; ctx.textBaseline = 'top';
        ctx.fillText('\u2194 drag', axO, beamY + triH + 6);
      }

      /* Roller at B — draggable */
      var bxO = beamX(sp.b);
      var isHovB = hoveredSupport === 'b' || (dragSupport.active && dragSupport.which === 'b');
      if (!isHovB) contactShadow(bxO, beamY + triH + 11, triW + 2);
      if (isHovB) { ctx.shadowColor = '#00acc1'; ctx.shadowBlur = 12; }
      ctx.fillStyle = bodyGrad(beamY, beamY + triH, isHovB);
      ctx.strokeStyle = isHovB ? '#00acc1' : '#ab47bc'; ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(bxO, beamY);
      ctx.lineTo(bxO - triW / 2, beamY + triH);
      ctx.lineTo(bxO + triW / 2, beamY + triH);
      ctx.closePath();
      ctx.fill();
      ctx.stroke();
      ctx.fillStyle = isHovB ? 'rgba(0,172,193,0.4)' : 'rgba(171,71,188,0.35)';
      ctx.beginPath();
      ctx.arc(bxO, beamY + triH + 5, 4, 0, Math.PI * 2);
      ctx.fill();
      ctx.stroke();
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(bxO - triW, beamY + triH + 11);
      ctx.lineTo(bxO + triW, beamY + triH + 11);
      ctx.stroke();
      ctx.shadowBlur = 0;
      if (isHovB) {
        ctx.fillStyle = '#00acc1'; ctx.font = '700 9px "Segoe UI", sans-serif';
        ctx.textAlign = 'center'; ctx.textBaseline = 'top';
        ctx.fillText('\u2194 drag', bxO, beamY + triH + 14);
      }
    }
  }

  /* ── Hit-testing for loads ──────────────────────────────── */
  var HIT_RADIUS = 14;
  var HANDLE_RADIUS = 10;

  function hitTestLoads(cx, cy) {
    var beamY = BEAM_Y0 + 80;
    for (var i = loads.length - 1; i >= 0; i--) {
      var ld = loads[i];
      if (ld.type === 'point') {
        var px = beamX(ld.pos);
        if (cx >= px - HIT_RADIUS && cx <= px + HIT_RADIUS &&
            cy >= beamY - 55 && cy <= beamY + 2) {
          return { idx: i, handle: 'body' };
        }
      } else if (ld.type === 'udl') {
        var x1 = beamX(ld.pos), x2 = beamX(ld.end);
        var topU = beamY - 47;
        if (cy >= topU && cy <= beamY + 2) {
          if (Math.abs(cx - x1) <= HANDLE_RADIUS) return { idx: i, handle: 'start' };
          if (Math.abs(cx - x2) <= HANDLE_RADIUS) return { idx: i, handle: 'end' };
          if (cx > x1 + HANDLE_RADIUS && cx < x2 - HANDLE_RADIUS) return { idx: i, handle: 'body' };
        }
      } else if (ld.type === 'moment') {
        var mx = beamX(ld.pos);
        if (Math.abs(cx - mx) <= 18 && cy >= beamY - 40 && cy <= beamY + 5) {
          return { idx: i, handle: 'body' };
        }
      }
    }
    return null;
  }

  function hitTestSupports(cx, cy) {
    if (beamType !== 'overhanging') return null;
    var beamY = BEAM_Y0 + 80;
    var aX = beamX(supportA), bX = beamX(supportB);
    /* Support triangles sit just below beam, extend to ~beamY+30 */
    if (cy >= beamY - 5 && cy <= beamY + 35) {
      if (Math.abs(cx - aX) <= 16) return 'a';
      if (Math.abs(cx - bX) <= 16) return 'b';
    }
    return null;
  }

  function updateCursor() {
    if (drag.active || dragSupport.active) { cvs.style.cursor = 'grabbing'; return; }
    if (hoveredSupport) { cvs.style.cursor = 'ew-resize'; return; }
    if (hoveredIdx >= 0) {
      cvs.style.cursor = (hoveredHandle === 'start' || hoveredHandle === 'end') ? 'ew-resize' : 'grab';
    } else {
      cvs.style.cursor = (activeTool === 'select') ? 'default' : 'crosshair';
    }
  }

  function deleteLoad(idx) {
    saveUndo();
    loads.splice(idx, 1);
    if (selectedIdx === idx) selectedIdx = -1;
    else if (selectedIdx > idx) selectedIdx--;
    syncPanelToSelection();
    render();
  }

  function drawLoads(beamY) {
    loads.forEach(function (ld, i) {
      var isSel = (i === selectedIdx);
      var isHov = (i === hoveredIdx && !drag.active);

      if (ld.type === 'point') {
        var px = beamX(ld.pos);
        var arrowTop = beamY - 50;
        /* Selection glow */
        if (isSel) { ctx.shadowColor = '#00acc1'; ctx.shadowBlur = 14; }
        else if (isHov) { ctx.shadowColor = 'rgba(0,172,193,0.4)'; ctx.shadowBlur = 8; }
        /* Arrow line */
        ctx.strokeStyle = isSel ? '#00acc1' : '#ff5555'; ctx.lineWidth = isSel ? 3 : 2.5;
        ctx.beginPath();
        ctx.moveTo(px, arrowTop);
        ctx.lineTo(px, beamY - 4);
        ctx.stroke();
        /* Arrow head */
        ctx.fillStyle = isSel ? '#00acc1' : '#ff5555';
        ctx.beginPath();
        ctx.moveTo(px, beamY - 2);
        ctx.lineTo(px - 6, beamY - 13);
        ctx.lineTo(px + 6, beamY - 13);
        ctx.closePath();
        ctx.fill();
        ctx.shadowBlur = 0;
        /* Grab handle circle when selected */
        if (isSel) {
          ctx.beginPath(); ctx.arc(px, arrowTop, 5, 0, Math.PI * 2);
          ctx.fillStyle = '#00acc1'; ctx.fill();
          ctx.strokeStyle = '#0d1117'; ctx.lineWidth = 1.5; ctx.stroke();
        }
        /* Label */
        ctx.font = '700 10px "Courier New", monospace';
        ctx.fillStyle = isSel ? '#00acc1' : '#ff5555';
        ctx.textAlign = 'center'; ctx.textBaseline = 'bottom';
        ctx.fillText(fmtMag(ld.mag, 'force') + ' ' + U().force.short, px, arrowTop - 6);
      } else if (ld.type === 'udl') {
        var x1 = beamX(ld.pos), x2 = beamX(ld.end);
        var arrowTopU = beamY - 42;
        var fillAlpha = isSel ? 0.28 : (isHov ? 0.22 : 0.15);
        var color = isSel ? '#00acc1' : '#ff5555';
        /* Selection glow */
        if (isSel) { ctx.shadowColor = '#00acc1'; ctx.shadowBlur = 10; }
        else if (isHov) { ctx.shadowColor = 'rgba(0,172,193,0.3)'; ctx.shadowBlur = 6; }
        /* Distributed region shading */
        ctx.fillStyle = isSel ? 'rgba(0,172,193,' + fillAlpha + ')' : 'rgba(255,85,85,' + fillAlpha + ')';
        ctx.fillRect(x1, arrowTopU, x2 - x1, beamY - arrowTopU - 4);
        /* Top line */
        ctx.strokeStyle = color; ctx.lineWidth = isSel ? 2 : 1.5;
        ctx.beginPath();
        ctx.moveTo(x1, arrowTopU); ctx.lineTo(x2, arrowTopU);
        ctx.stroke();
        ctx.shadowBlur = 0;
        /* Individual arrows */
        var nArrows = Math.max(3, Math.round((x2 - x1) / 25));
        for (var j = 0; j <= nArrows; j++) {
          var ax = x1 + (x2 - x1) * j / nArrows;
          ctx.strokeStyle = color; ctx.lineWidth = 1;
          ctx.beginPath(); ctx.moveTo(ax, arrowTopU); ctx.lineTo(ax, beamY - 6); ctx.stroke();
          ctx.fillStyle = color;
          ctx.beginPath();
          ctx.moveTo(ax, beamY - 3); ctx.lineTo(ax - 3, beamY - 9); ctx.lineTo(ax + 3, beamY - 9);
          ctx.closePath(); ctx.fill();
        }
        /* Selection border + edge handles */
        if (isSel) {
          ctx.strokeStyle = '#00acc1'; ctx.lineWidth = 1.5;
          ctx.setLineDash([5, 3]);
          ctx.strokeRect(x1, arrowTopU - 2, x2 - x1, beamY - arrowTopU);
          ctx.setLineDash([]);
          /* Edge handles */
          var hH = 10;
          ctx.fillStyle = '#00acc1';
          ctx.fillRect(x1 - 3, arrowTopU + (beamY - arrowTopU) / 2 - hH / 2, 6, hH);
          ctx.fillRect(x2 - 3, arrowTopU + (beamY - arrowTopU) / 2 - hH / 2, 6, hH);
        }
        /* Label */
        ctx.font = '700 10px "Courier New", monospace';
        ctx.fillStyle = color;
        ctx.textAlign = 'center'; ctx.textBaseline = 'bottom';
        ctx.fillText(fmtMag(ld.mag, 'dist') + ' ' + U().dist.short, (x1 + x2) / 2, arrowTopU - 3);
      } else if (ld.type === 'moment') {
        var mx = beamX(ld.pos);
        var radius = 16;
        var color = isSel ? '#00acc1' : '#f5c842';
        var dir = ld.mag >= 0 ? 1 : -1; /* positive = clockwise */

        if (isSel) { ctx.shadowColor = '#00acc1'; ctx.shadowBlur = 14; }
        else if (isHov) { ctx.shadowColor = 'rgba(0,172,193,0.4)'; ctx.shadowBlur = 8; }

        /* Curved arrow (arc) */
        ctx.strokeStyle = color; ctx.lineWidth = 2.5;
        var startA = -Math.PI * 0.8;
        var endA = Math.PI * 0.4;
        ctx.beginPath();
        ctx.arc(mx, beamY - 8, radius, startA, endA, dir < 0);
        ctx.stroke();
        ctx.shadowBlur = 0;

        /* Arrowhead at end of arc */
        var tipAngle = dir < 0 ? startA : endA;
        var tx = mx + radius * Math.cos(tipAngle);
        var ty = (beamY - 8) + radius * Math.sin(tipAngle);
        var perpAngle = tipAngle + (dir < 0 ? -Math.PI / 2 : Math.PI / 2);
        ctx.fillStyle = color;
        ctx.beginPath();
        ctx.moveTo(tx, ty);
        ctx.lineTo(tx + 6 * Math.cos(perpAngle - 0.5), ty + 6 * Math.sin(perpAngle - 0.5));
        ctx.lineTo(tx + 6 * Math.cos(perpAngle + 0.5), ty + 6 * Math.sin(perpAngle + 0.5));
        ctx.closePath();
        ctx.fill();

        /* Selection handle */
        if (isSel) {
          ctx.beginPath(); ctx.arc(mx, beamY - 8, 4, 0, Math.PI * 2);
          ctx.fillStyle = '#00acc1'; ctx.fill();
          ctx.strokeStyle = '#0d1117'; ctx.lineWidth = 1.5; ctx.stroke();
        }

        /* Label */
        ctx.font = '700 10px "Courier New", monospace';
        ctx.fillStyle = color;
        ctx.textAlign = 'center'; ctx.textBaseline = 'bottom';
        ctx.fillText(fmtD(Math.abs(ld.mag), 'moment') + ' ' + U().moment.short, mx, beamY - 28);
      }
    });
  }

  /* ── Deflection computation (separated from drawing) ────── */
  var computedDeflMM = [];

  function computeDeflection() {
    computedDeflMM = [];
    computedMaxDefl = 0;
    if (bmdData.length < 2 || loads.length === 0) return;

    var EI = matE * secI; /* N·m² — from user-selected material (E) and section (I) */
    if (!(EI > 0)) EI = 1; /* guard against zero/NaN section */
    var N = bmdData.length;
    var dx = beamLength / (N - 1);
    var sp = getSupportPositions();

    /* First integration: slope = integral(M/EI) */
    var slope = [0];
    for (var i = 1; i < N; i++) {
      var mAvg = (bmdData[i - 1].M + bmdData[i].M) / 2 * 1000;
      slope.push(slope[i - 1] + mAvg / EI * dx);
    }

    /* Second integration: deflection = integral(slope) */
    var defl = [0];
    for (var j = 1; j < N; j++) {
      var sAvg = (slope[j - 1] + slope[j]) / 2;
      defl.push(defl[j - 1] + sAvg * dx);
    }

    var idxA = Math.round(sp.a * (N - 1));
    var idxB = sp.b >= 0 ? Math.round(sp.b * (N - 1)) : -1;

    if (beamType === 'cantilever') {
      var slopeCorr = slope[idxA];
      var deflCorr = defl[idxA];
      for (var k = 0; k < N; k++) {
        slope[k] -= slopeCorr;
        defl[k] -= deflCorr - slopeCorr * (k / (N - 1) * beamLength - sp.a * beamLength);
      }
      /* Re-integrate with corrected slope */
      defl = [0];
      for (var k2 = 1; k2 < N; k2++) {
        defl.push(defl[k2 - 1] + (slope[k2 - 1] + slope[k2]) / 2 * dx);
      }
      var dA = defl[idxA];
      for (var k3 = 0; k3 < N; k3++) defl[k3] -= dA;
    } else if (idxB >= 0 && idxB !== idxA) {
      /* Simply supported / overhanging: defl=0 at A and B */
      var dA2 = defl[idxA];
      var dB = defl[idxB];
      var span = idxB - idxA;
      for (var m = 0; m < N; m++) {
        var correction = dA2 + (dB - dA2) * (m - idxA) / span;
        defl[m] -= correction;
      }
    }

    /* Convert to mm and store */
    computedDeflMM = defl.map(function (d) { return d * 1000; });

    /* Find max deflection */
    var maxVal2 = 0;
    computedDeflMM.forEach(function (d) {
      if (Math.abs(d) > Math.abs(maxVal2)) maxVal2 = d;
    });
    computedMaxDefl = maxVal2;
  }

  /* ── Deflected shape diagram (drawing only) ────────────────── */
  function drawDeflection() {
    if (computedDeflMM.length === 0) return;

    var zoneH = DEFL_Y1 - DEFL_Y0;
    var midY = DEFL_Y0 + zoneH / 2;
    var N = computedDeflMM.length;
    var deflMM = computedDeflMM;

    var maxD = 0;
    deflMM.forEach(function (d) { if (Math.abs(d) > maxD) maxD = Math.abs(d); });
    if (maxD < 0.001) maxD = 1;
    var scale = (zoneH / 2 - 20) / maxD;

    /* Zero axis */
    ctx.strokeStyle = '#4a5578'; ctx.lineWidth = 1;
    ctx.setLineDash([4, 3]);
    ctx.beginPath();
    ctx.moveTo(beamDrawL, midY); ctx.lineTo(beamDrawR, midY);
    ctx.stroke();
    ctx.setLineDash([]);

    /* Y-axis label */
    ctx.save();
    ctx.translate(MARGIN_L - 40, midY);
    ctx.rotate(-Math.PI / 2);
    ctx.font = '700 11px "Courier New", monospace';
    ctx.fillStyle = '#e040fb';
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.fillText(U().deflAx.label, 0, 0);
    ctx.restore();

    /* Deflection curve fill — flip sign so sagging-down (negative δ in
       y-up physics convention) plots BELOW midline on screen (canvas y is +down). */
    ctx.fillStyle = 'rgba(224,64,251,0.2)';
    ctx.beginPath();
    ctx.moveTo(beamX(0), midY);
    for (var p = 0; p < N; p++) {
      ctx.lineTo(beamX(p / (N - 1)), midY - deflMM[p] * scale);
    }
    ctx.lineTo(beamX(1), midY);
    ctx.closePath();
    ctx.fill();

    /* Deflection curve line */
    ctx.strokeStyle = '#e040fb'; ctx.lineWidth = 2.5;
    ctx.beginPath();
    for (var q = 0; q < N; q++) {
      var px = beamX(q / (N - 1));
      var py = midY - deflMM[q] * scale;
      if (q === 0) ctx.moveTo(px, py);
      else ctx.lineTo(px, py);
    }
    ctx.stroke();

    /* Max deflection label */
    var maxVal = 0, maxIdx = 0;
    deflMM.forEach(function (d, i) {
      if (Math.abs(d) > Math.abs(maxVal)) { maxVal = d; maxIdx = i; }
    });
    if (Math.abs(maxVal) > 0.01) {
      var dotX = beamX(maxIdx / (N - 1));
      var dotY = midY - maxVal * scale;
      ctx.fillStyle = '#e040fb';
      ctx.beginPath(); ctx.arc(dotX, dotY, 4, 0, Math.PI * 2); ctx.fill();
      ctx.font = '700 10px "Courier New", monospace';
      ctx.textAlign = 'center';
      ctx.textBaseline = maxVal < 0 ? 'top' : 'bottom';
      var dDisp = toDisplay(maxVal, 'defl');
      ctx.fillText((dDisp > 0 ? '+' : '') + dDisp.toFixed(2) + ' ' + U().defl.short, dotX, dotY + (maxVal < 0 ? 6 : -6));
    }
  }

  /* ── Dimension lines — beam total + per-load distances ──── */
  function drawDimensionLines(beamY) {
    var baseY = beamY + 48;
    var rowH = 18;
    var originX = beamX(0);

    /* ── Total beam length (always shown) ── */
    drawDimArrow(originX, beamX(1), baseY, fmtD(beamLength, 'length') + ' ' + U().length.short, '#6b7a99');

    /* ── Per-load distance lines (only when toggle is on) ── */
    if (!showDimLines || loads.length === 0) return;

    /* Collect dimension positions, sort by position to stack smartly */
    var dims = [];
    loads.forEach(function (ld, i) {
      if (ld.type === 'point') {
        dims.push({ pos: ld.pos, idx: i });
      } else if (ld.type === 'udl') {
        dims.push({ pos: ld.pos, idx: i, isStart: true });
        dims.push({ pos: ld.end, idx: i, isEnd: true });
      }
    });
    dims.sort(function (a, b) { return a.pos - b.pos; });

    /* Assign rows — simple greedy: if two dims overlap in X, push to next row */
    var rows = [];
    dims.forEach(function (d) {
      var dxL = beamX(d.pos);
      var textW = 55; /* approximate text width in pixels */
      var placed = false;
      for (var r = 0; r < rows.length; r++) {
        var ok = true;
        for (var k = 0; k < rows[r].length; k++) {
          var prev = rows[r][k];
          var prevX = beamX(prev.pos);
          /* Check if the midpoints of these two dim lines are too close */
          var mid1 = (originX + dxL) / 2;
          var mid2 = (originX + prevX) / 2;
          if (Math.abs(mid1 - mid2) < textW) { ok = false; break; }
        }
        if (ok) { rows[r].push(d); d.row = r; placed = true; break; }
      }
      if (!placed) { d.row = rows.length; rows.push([d]); }
    });

    /* Draw each dimension line */
    var isSel, color;
    dims.forEach(function (d) {
      var y = baseY + (d.row + 1) * rowH;
      isSel = (d.idx === selectedIdx);
      color = isSel ? '#00acc1' : 'rgba(107,122,153,0.6)';
      var dist = toDisplay(d.pos * beamLength, 'length').toFixed(2);
      var label = dist + ' ' + U().length.short;
      /* Skip full-length dims (duplicate of the always-shown total) */
      if (d.pos > 0.005 && d.pos < 0.995) {
        drawDimArrow(originX, beamX(d.pos), y, label, color);
        /* Vertical tick from load to dim line */
        ctx.strokeStyle = color; ctx.lineWidth = 0.7;
        ctx.setLineDash([2, 2]);
        ctx.beginPath();
        ctx.moveTo(beamX(d.pos), beamY + 2);
        ctx.lineTo(beamX(d.pos), y);
        ctx.stroke();
        ctx.setLineDash([]);
      }
    });
  }

  /* Draw a dimension arrow line with label breaking the line at center */
  function drawDimArrow(x1, x2, y, label, color) {
    ctx.font = '600 9px "Segoe UI", sans-serif';
    var tw = ctx.measureText(label).width + 8;
    var midX = (x1 + x2) / 2;
    var halfT = tw / 2;
    var arrowSize = 4;

    /* Don't draw if span is too small */
    if (Math.abs(x2 - x1) < 20) return;

    ctx.strokeStyle = color; ctx.lineWidth = 1;

    /* Left segment: x1 → midX - halfT */
    if (midX - halfT > x1 + arrowSize + 2) {
      ctx.beginPath();
      ctx.moveTo(x1, y); ctx.lineTo(midX - halfT, y);
      ctx.stroke();
    }
    /* Right segment: midX + halfT → x2 */
    if (midX + halfT < x2 - arrowSize - 2) {
      ctx.beginPath();
      ctx.moveTo(midX + halfT, y); ctx.lineTo(x2, y);
      ctx.stroke();
    }

    /* Arrowhead at x1 (pointing left) */
    ctx.fillStyle = color;
    ctx.beginPath();
    ctx.moveTo(x1, y);
    ctx.lineTo(x1 + arrowSize + 2, y - arrowSize);
    ctx.lineTo(x1 + arrowSize + 2, y + arrowSize);
    ctx.closePath(); ctx.fill();

    /* Arrowhead at x2 (pointing right) */
    ctx.beginPath();
    ctx.moveTo(x2, y);
    ctx.lineTo(x2 - arrowSize - 2, y - arrowSize);
    ctx.lineTo(x2 - arrowSize - 2, y + arrowSize);
    ctx.closePath(); ctx.fill();

    /* Vertical ticks at ends */
    ctx.beginPath();
    ctx.moveTo(x1, y - 4); ctx.lineTo(x1, y + 4);
    ctx.moveTo(x2, y - 4); ctx.lineTo(x2, y + 4);
    ctx.stroke();

    /* Label at center (breaking the line) */
    ctx.fillStyle = color;
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.fillText(label, midX, y);
  }

  function drawReactions(sp, beamY) {
    /* Reaction A — upward arrow at support A */
    if (Math.abs(reactions.Ra) > 0.001) {
      var aX = beamX(sp.a);
      var dir = reactions.Ra > 0 ? -1 : 1; /* -1 = upward (positive) */
      var arrowLen = 35;
      var tipY = beamY + 22 + dir * 0 + (beamType === 'cantilever' ? 28 : 22);
      var baseY = tipY + dir * arrowLen;
      ctx.strokeStyle = '#42a5f5'; ctx.lineWidth = 2.5;
      ctx.beginPath(); ctx.moveTo(aX, tipY); ctx.lineTo(aX, baseY); ctx.stroke();
      /* Arrow head pointing up (or down if negative) */
      var headY = reactions.Ra > 0 ? tipY : baseY;
      var headDir = reactions.Ra > 0 ? 1 : -1;
      ctx.fillStyle = '#42a5f5';
      ctx.beginPath();
      ctx.moveTo(aX, headY - headDir * 2);
      ctx.lineTo(aX - 5, headY + headDir * 8);
      ctx.lineTo(aX + 5, headY + headDir * 8);
      ctx.closePath(); ctx.fill();
      /* Label */
      ctx.font = '700 9px "Courier New", monospace';
      ctx.fillStyle = '#42a5f5';
      ctx.textAlign = 'center'; ctx.textBaseline = 'top';
      ctx.fillText('Ra=' + fmtD(Math.abs(reactions.Ra), 'force'), aX, baseY + 3);
    }

    /* Reaction B */
    if (sp.b >= 0 && Math.abs(reactions.Rb) > 0.001) {
      var bX = beamX(sp.b);
      var arrowLenB = 35;
      var tipYB = beamY + (beamType === 'overhanging' ? 22 : 22) + 22;
      var baseYB = tipYB + arrowLenB;
      ctx.strokeStyle = '#42a5f5'; ctx.lineWidth = 2.5;
      ctx.beginPath(); ctx.moveTo(bX, tipYB); ctx.lineTo(bX, baseYB); ctx.stroke();
      var headYB = reactions.Rb > 0 ? tipYB : baseYB;
      var headDirB = reactions.Rb > 0 ? 1 : -1;
      ctx.fillStyle = '#42a5f5';
      ctx.beginPath();
      ctx.moveTo(bX, headYB - headDirB * 2);
      ctx.lineTo(bX - 5, headYB + headDirB * 8);
      ctx.lineTo(bX + 5, headYB + headDirB * 8);
      ctx.closePath(); ctx.fill();
      ctx.font = '700 9px "Courier New", monospace';
      ctx.fillStyle = '#42a5f5';
      ctx.textAlign = 'center'; ctx.textBaseline = 'top';
      ctx.fillText('Rb=' + fmtD(Math.abs(reactions.Rb), 'force'), bX, baseYB + 3);
    }

    /* Moment reaction at fixed end (cantilever) — drawn ABOVE the beam so it
       is not occluded by the beam stroke or the load arrow. Sign convention:
       reactions.Ma stores the load's moment about A (positive = CW), so the
       support's restraining reaction is the OPPOSITE direction. */
    if (beamType === 'cantilever' && Math.abs(reactions.Ma) > 0.001) {
      var maCcw = reactions.Ma > 0; /* CW load moment → CCW reaction couple */
      var mxA = beamX(sp.a) + 26;
      var myA = beamY - 36;          /* clear of beam line and load arrows */
      var rA  = 18;
      ctx.strokeStyle = '#42a5f5'; ctx.lineWidth = 2.5;
      /* Open ~270° arc. With canvas y-down, anticlockwise=true draws a
         visually CCW arc; anticlockwise=false draws visually CW. */
      var aStart, aEnd, aCcw;
      if (maCcw) {
        /* Visually CCW reaction couple: sweep top → left → bottom → right */
        aStart =  Math.PI * 1.25; aEnd = -Math.PI * 0.25; aCcw = true;
      } else {
        /* Visually CW reaction couple */
        aStart = -Math.PI * 1.25; aEnd =  Math.PI * 0.25; aCcw = false;
      }
      ctx.beginPath();
      ctx.arc(mxA, myA, rA, aStart, aEnd, aCcw);
      ctx.stroke();

      /* Arrow head at the END of the arc */
      var headAng = aEnd;
      var hx = mxA + rA * Math.cos(headAng);
      var hy = myA + rA * Math.sin(headAng);
      /* Tangent direction at end (perpendicular to radius, in sweep direction) */
      var tang = headAng + (aCcw ? -Math.PI / 2 : Math.PI / 2);
      var tdx = Math.cos(tang), tdy = Math.sin(tang);
      var ndx = -tdy, ndy = tdx; /* normal */
      ctx.fillStyle = '#42a5f5';
      ctx.beginPath();
      ctx.moveTo(hx + tdx * 6, hy + tdy * 6);
      ctx.lineTo(hx - tdx * 2 + ndx * 4, hy - tdy * 2 + ndy * 4);
      ctx.lineTo(hx - tdx * 2 - ndx * 4, hy - tdy * 2 - ndy * 4);
      ctx.closePath(); ctx.fill();

      /* Label above the arc, centred */
      ctx.font = '700 10px "Courier New", monospace';
      ctx.fillStyle = '#42a5f5';
      ctx.textAlign = 'center'; ctx.textBaseline = 'bottom';
      ctx.fillText('Ma=' + fmtD(Math.abs(reactions.Ma), 'moment') + ' ' + U().moment.short,
                   mxA, myA - rA - 4);
    }
  }

  function drawSFD() {
    if (sfdData.length < 2) return;
    var zoneH = SFD_Y1 - SFD_Y0;
    var midY = SFD_Y0 + zoneH / 2;

    /* Find max |V| for scaling (exact extremes incl. discontinuities) */
    var maxV = Math.max(Math.abs(sfdExt.max), Math.abs(sfdExt.min));
    if (maxV < 0.01) maxV = 1;
    var scale = (zoneH / 2 - 20) / maxV;

    /* Zero axis */
    ctx.strokeStyle = '#4a5578'; ctx.lineWidth = 1;
    ctx.setLineDash([4, 3]);
    ctx.beginPath();
    ctx.moveTo(beamDrawL, midY); ctx.lineTo(beamDrawR, midY);
    ctx.stroke();
    ctx.setLineDash([]);

    /* Y-axis label */
    ctx.save();
    ctx.translate(MARGIN_L - 40, midY);
    ctx.rotate(-Math.PI / 2);
    ctx.font = '700 11px "Courier New", monospace';
    ctx.fillStyle = '#3ddc84';
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.fillText(U().sfd.label, 0, 0);
    ctx.restore();

    /* Draw shaded regions and line */
    ctx.beginPath();
    ctx.moveTo(beamX(sfdData[0].x), midY);
    for (var i = 0; i < sfdData.length; i++) {
      var px = beamX(sfdData[i].x);
      var py = midY - sfdData[i].V * scale;
      ctx.lineTo(px, py);
    }
    ctx.lineTo(beamX(sfdData[sfdData.length - 1].x), midY);
    ctx.closePath();

    /* Shading — split pos/neg */
    ctx.save();
    /* Positive region (green) */
    ctx.fillStyle = 'rgba(61,220,132,0.35)';
    ctx.beginPath();
    ctx.moveTo(beamX(0), midY);
    for (var j = 0; j < sfdData.length; j++) {
      var pxJ = beamX(sfdData[j].x);
      var valJ = Math.max(0, sfdData[j].V);
      ctx.lineTo(pxJ, midY - valJ * scale);
    }
    ctx.lineTo(beamX(1), midY);
    ctx.closePath();
    ctx.fill();

    /* Negative region (red) */
    ctx.fillStyle = 'rgba(255,85,85,0.35)';
    ctx.beginPath();
    ctx.moveTo(beamX(0), midY);
    for (var k = 0; k < sfdData.length; k++) {
      var pxK = beamX(sfdData[k].x);
      var valK = Math.min(0, sfdData[k].V);
      ctx.lineTo(pxK, midY - valK * scale);
    }
    ctx.lineTo(beamX(1), midY);
    ctx.closePath();
    ctx.fill();
    ctx.restore();

    /* SFD line */
    ctx.strokeStyle = '#3ddc84'; ctx.lineWidth = 2.5;
    ctx.beginPath();
    for (var m = 0; m < sfdData.length; m++) {
      var pxM = beamX(sfdData[m].x);
      var pyM = midY - sfdData[m].V * scale;
      if (m === 0) ctx.moveTo(pxM, pyM);
      else ctx.lineTo(pxM, pyM);
    }
    ctx.stroke();

    /* Max/min labels — exact values at discontinuities */
    var maxSf = Math.max(0, sfdExt.max), maxSfX = sfdExt.maxX;
    var minSf = Math.min(0, sfdExt.min), minSfX = sfdExt.minX;
    if (Math.abs(maxSf) > 0.01) {
      ctx.font = '700 10px "Courier New", monospace';
      ctx.fillStyle = '#3ddc84';
      ctx.textAlign = 'center'; ctx.textBaseline = 'bottom';
      ctx.fillText('+' + fmtD(maxSf, 'force'), beamX(maxSfX), midY - maxSf * scale - 4);
    }
    if (Math.abs(minSf) > 0.01) {
      ctx.font = '700 10px "Courier New", monospace';
      ctx.fillStyle = '#ff5555';
      ctx.textAlign = 'center'; ctx.textBaseline = 'top';
      ctx.fillText(fmtD(minSf, 'force'), beamX(minSfX), midY - minSf * scale + 4);
    }
  }

  function drawBMD() {
    if (bmdData.length < 2) return;
    var zoneH = BMD_Y1 - BMD_Y0;
    var midY = BMD_Y0 + zoneH / 2;

    /* Find max |M| for scaling (exact extremes incl. discontinuities) */
    var maxM = Math.max(Math.abs(bmdExt.max), Math.abs(bmdExt.min));
    if (maxM < 0.01) maxM = 1;
    var scale = (zoneH / 2 - 20) / maxM;

    /* Zero axis */
    ctx.strokeStyle = '#4a5578'; ctx.lineWidth = 1;
    ctx.setLineDash([4, 3]);
    ctx.beginPath();
    ctx.moveTo(beamDrawL, midY); ctx.lineTo(beamDrawR, midY);
    ctx.stroke();
    ctx.setLineDash([]);

    /* Y-axis label */
    ctx.save();
    ctx.translate(MARGIN_L - 40, midY);
    ctx.rotate(-Math.PI / 2);
    ctx.font = '700 11px "Courier New", monospace';
    ctx.fillStyle = '#f5c842';
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.fillText(U().bmd.label, 0, 0);
    ctx.restore();

    /* Positive (sagging) region — gold */
    ctx.fillStyle = 'rgba(245,200,66,0.35)';
    ctx.beginPath();
    ctx.moveTo(beamX(0), midY);
    for (var j = 0; j < bmdData.length; j++) {
      var pxJ = beamX(bmdData[j].x);
      var valJ = Math.max(0, bmdData[j].M);
      ctx.lineTo(pxJ, midY - valJ * scale);
    }
    ctx.lineTo(beamX(1), midY);
    ctx.closePath();
    ctx.fill();

    /* Negative (hogging) region — red */
    ctx.fillStyle = 'rgba(255,85,85,0.35)';
    ctx.beginPath();
    ctx.moveTo(beamX(0), midY);
    for (var k = 0; k < bmdData.length; k++) {
      var pxK = beamX(bmdData[k].x);
      var valK = Math.min(0, bmdData[k].M);
      ctx.lineTo(pxK, midY - valK * scale);
    }
    ctx.lineTo(beamX(1), midY);
    ctx.closePath();
    ctx.fill();

    /* BMD line */
    ctx.strokeStyle = '#f5c842'; ctx.lineWidth = 2.5;
    ctx.beginPath();
    for (var m = 0; m < bmdData.length; m++) {
      var pxM = beamX(bmdData[m].x);
      var pyM = midY - bmdData[m].M * scale;
      if (m === 0) ctx.moveTo(pxM, pyM);
      else ctx.lineTo(pxM, pyM);
    }
    ctx.stroke();

    /* Maximum BM label with dot — exact values at discontinuities */
    var maxBm = Math.max(0, bmdExt.max), maxBmX = bmdExt.maxX;
    var minBm = Math.min(0, bmdExt.min), minBmX = bmdExt.minX;
    if (Math.abs(maxBm) > 0.01) {
      var dotX = beamX(maxBmX);
      var dotY = midY - maxBm * scale;
      ctx.fillStyle = '#f5c842';
      ctx.beginPath(); ctx.arc(dotX, dotY, 4, 0, Math.PI * 2); ctx.fill();
      ctx.font = '700 10px "Courier New", monospace';
      ctx.textAlign = 'center'; ctx.textBaseline = 'bottom';
      ctx.fillText('+' + fmtD(maxBm, 'moment'), dotX, dotY - 6);
    }
    if (Math.abs(minBm) > 0.01) {
      var dotXN = beamX(minBmX);
      var dotYN = midY - minBm * scale;
      ctx.fillStyle = '#ff5555';
      ctx.beginPath(); ctx.arc(dotXN, dotYN, 4, 0, Math.PI * 2); ctx.fill();
      ctx.font = '700 10px "Courier New", monospace';
      ctx.textAlign = 'center'; ctx.textBaseline = 'top';
      ctx.fillText(fmtD(minBm, 'moment'), dotXN, dotYN + 6);
    }

    /* Mark points of contraflexure */
    for (var c = 1; c < bmdData.length; c++) {
      var prev = bmdData[c - 1].M;
      var curr = bmdData[c].M;
      if ((prev > 0.01 && curr < -0.01) || (prev < -0.01 && curr > 0.01)) {
        /* Linear interpolation */
        var frac = Math.abs(prev) / (Math.abs(prev) + Math.abs(curr));
        var cfX = bmdData[c - 1].x + frac * (bmdData[c].x - bmdData[c - 1].x);
        var cpx = beamX(cfX);
        ctx.fillStyle = '#dde3f0';
        ctx.beginPath(); ctx.arc(cpx, midY, 5, 0, Math.PI * 2); ctx.fill();
        ctx.strokeStyle = '#dde3f0'; ctx.lineWidth = 1.5;
        ctx.beginPath(); ctx.arc(cpx, midY, 5, 0, Math.PI * 2); ctx.stroke();
        ctx.font = '600 8px "Segoe UI", sans-serif';
        ctx.fillStyle = '#dde3f0';
        ctx.textAlign = 'center'; ctx.textBaseline = 'top';
        ctx.fillText('C.F.', cpx, midY + 8);
      }
    }
  }

  function drawHoverLine(beamY) {
    var hx = beamX(hoverX);
    ctx.strokeStyle = 'rgba(221,227,240,0.3)'; ctx.lineWidth = 1;
    ctx.setLineDash([3, 3]);
    ctx.beginPath();
    var hoverBottom = showDefl ? DEFL_Y1 : (showBMD ? BMD_Y1 : (showSFD ? SFD_Y1 : BEAM_Y1));
    ctx.moveTo(hx, BEAM_Y0); ctx.lineTo(hx, hoverBottom);
    ctx.stroke();
    ctx.setLineDash([]);

    /* Find SFD and BMD values at hover */
    var idx = Math.round(hoverX * 200);
    idx = Math.max(0, Math.min(200, idx));
    var vVal = sfdData[idx] ? sfdData[idx].V : 0;
    var mVal = bmdData[idx] ? bmdData[idx].M : 0;
    var xVal = toDisplay(hoverX * beamLength, 'length').toFixed(2);

    /* Info badge */
    ctx.fillStyle = 'rgba(13,17,23,0.9)';
    ctx.strokeStyle = '#4a5578'; ctx.lineWidth = 1;
    var bx = Math.min(hx + 10, W - 160);
    ctx.beginPath(); ctx.roundRect(bx, BEAM_Y0 + 10, 150, 60, 8); ctx.fill(); ctx.stroke();
    ctx.font = '600 10px "Segoe UI", sans-serif';
    ctx.fillStyle = '#dde3f0'; ctx.textAlign = 'left'; ctx.textBaseline = 'top';
    ctx.fillText('x = ' + xVal + ' ' + U().length.short, bx + 8, BEAM_Y0 + 16);
    ctx.fillStyle = '#3ddc84';
    ctx.fillText('V = ' + fmtD(vVal, 'force', 2) + ' ' + U().force.short, bx + 8, BEAM_Y0 + 32);
    ctx.fillStyle = '#f5c842';
    ctx.fillText('M = ' + fmtD(mVal, 'moment', 2) + ' ' + U().moment.short, bx + 8, BEAM_Y0 + 48);
  }

  /* ================================================================
     DRAWING — EXPLORE MINI-DIAGRAMS
     ================================================================ */

  function drawConceptDiagram(concept) {
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = '#0d1117';
    ctx.fillRect(0, 0, W, H);

    var fn = {
      'beamTypes': drawBeamTypesDiag,
      'supportTypes': drawSupportTypesDiag,
      'loadTypes': drawLoadTypesDiag,
      'spanOverhang': drawSpanOverhangDiag,
      'equilibrium': drawEquilibriumDiag,
      'reactions': drawReactionsDiag,
      'shearForce': drawShearForceDiag,
      'bendingMoment': drawBendingMomentDiag,
      'sfdConstruction': drawSFDConstructionDiag,
      'bmdConstruction': drawBMDConstructionDiag,
      'contraflexure': drawContraflexureDiag,
      'sfdBmdRelation': drawSFDBMDRelationDiag
    };

    if (fn[concept.diagram]) fn[concept.diagram]();

    /* Formula at bottom */
    ctx.font = '700 16px "Courier New", monospace';
    ctx.fillStyle = '#00acc1';
    ctx.textAlign = 'center'; ctx.textBaseline = 'bottom';
    ctx.fillText(concept.formula, W / 2, H - 16);
  }

  function drawMiniBeam(x1, y, x2, color) {
    ctx.strokeStyle = color || '#00acc1'; ctx.lineWidth = 4; ctx.lineCap = 'round';
    ctx.beginPath(); ctx.moveTo(x1, y); ctx.lineTo(x2, y); ctx.stroke();
    ctx.lineCap = 'butt';
  }

  function drawMiniTriangle(x, y, color) {
    ctx.strokeStyle = color || '#ab47bc'; ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(x, y); ctx.lineTo(x - 7, y + 14); ctx.lineTo(x + 7, y + 14); ctx.closePath();
    ctx.stroke();
  }

  function drawMiniFixedWall(x, y, h, color) {
    ctx.strokeStyle = color || '#ab47bc'; ctx.lineWidth = 2;
    ctx.beginPath(); ctx.moveTo(x, y - h / 2); ctx.lineTo(x, y + h / 2); ctx.stroke();
    ctx.lineWidth = 1;
    for (var i = -h / 2; i <= h / 2; i += 5) {
      ctx.beginPath(); ctx.moveTo(x, y + i); ctx.lineTo(x - 8, y + i + 6); ctx.stroke();
    }
  }

  function drawMiniArrowDown(x, y, len, color) {
    ctx.strokeStyle = color; ctx.lineWidth = 2;
    ctx.beginPath(); ctx.moveTo(x, y); ctx.lineTo(x, y + len); ctx.stroke();
    ctx.fillStyle = color;
    ctx.beginPath(); ctx.moveTo(x, y + len + 2); ctx.lineTo(x - 4, y + len - 6); ctx.lineTo(x + 4, y + len - 6); ctx.closePath(); ctx.fill();
  }

  function drawMiniArrowUp(x, y, len, color) {
    ctx.strokeStyle = color; ctx.lineWidth = 2;
    ctx.beginPath(); ctx.moveTo(x, y); ctx.lineTo(x, y - len); ctx.stroke();
    ctx.fillStyle = color;
    ctx.beginPath(); ctx.moveTo(x, y - len - 2); ctx.lineTo(x - 4, y - len + 6); ctx.lineTo(x + 4, y - len + 6); ctx.closePath(); ctx.fill();
  }

  function drawBeamTypesDiag() {
    ctx.font = '700 14px "Segoe UI", sans-serif';
