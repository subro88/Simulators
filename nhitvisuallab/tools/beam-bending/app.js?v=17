    /* Moment couple */
    drawMiniBeam(200, 280, 500, '#00acc1');
    ctx.strokeStyle = '#f5c842'; ctx.lineWidth = 2.5;
    ctx.beginPath(); ctx.arc(350, 280, 18, -Math.PI * 0.7, Math.PI * 0.5); ctx.stroke();
    ctx.fillStyle = '#f5c842';
    ctx.beginPath();
    var ax2 = 350 + 18 * Math.cos(Math.PI * 0.5);
