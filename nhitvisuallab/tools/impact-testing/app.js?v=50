     ================================================================ */
  /* Charpy specimen drawn to its real aspect ratio. It used to be 90 x 10 px
     for a 55 x 10 mm bar — 9:1 where the specimen is 5.5:1 — which made the
     section too thin for a true-scale 2 mm notch to be visible at all. */
  var SPEC_DRAW_LEN = 90;
  var SPEC_DRAW_H = Math.round(SPEC_DRAW_LEN * CHARPY_SPEC.height / CHARPY_SPEC.length);

  var PIVOT_X = 250, PIVOT_Y = 95;
  var PEND_LEN = 340;
  var FRAME_L = 45, FRAME_R = 480;
  var BASE_Y = 640, BASE_H = 35;
  var ANVIL_Y = 445;
  var SPEC_X = 250, SPEC_Y = 445;
  var DIAL_CX = 480, DIAL_CY = 165, DIAL_R = 52;

  /* Uniform fit: map the machine's full swing envelope into the canvas.
     The follow-through swings past vertical to the far side, so BOTH sides of
     the circle are in play — the envelope is the full disc of radius
     (arm + hammer reach) about the pivot, plus the base below it. */
  var SWING_R = PEND_LEN + 22;
  var MACHINE_K, MACHINE_TX, MACHINE_TY;
  /* Machine-SPACE envelope. Everything drawn inside the fit transform must
     anchor to these, never to MW / MH / MACHINE_H — those are CANVAS-space and
     using them inside the transform pushes artwork off the canvas. */
  var M_MINX = PIVOT_X - SWING_R, M_MAXX = PIVOT_X + SWING_R;
  var M_MINY = PIVOT_Y - SWING_R, M_MAXY = BASE_Y + BASE_H;
  (function fitMachine() {
    var minX = M_MINX, maxX = M_MAXX;
    var minY = M_MINY, maxY = M_MAXY;
    MACHINE_K = Math.min(MW / (maxX - minX), MACHINE_H / (maxY - minY));
    MACHINE_TX = -minX * MACHINE_K;
    MACHINE_TY = -minY * MACHINE_K;
  })();

  /* Reset every context property a draw helper might set but not restore, so a
     frame renders identically regardless of which optional layers were drawn in
     the PREVIOUS frame. Without this, toggling the notch inset or the equation
     band off and on again left the canvas subtly different, because later text
     inherited whatever textAlign the skipped helper used to leave behind. */
  function resetCtxState(c) {
    c.textAlign = 'left';
    c.textBaseline = 'alphabetic';
    c.globalAlpha = 1;
    c.lineWidth = 1;
    c.lineCap = 'butt';
    c.lineJoin = 'miter';
    c.setLineDash([]);
  }

  function drawMachine() {
    if (!mCtx) return;
    resetCtxState(mCtx);
    mCtx.clearRect(0, 0, MW, MH);
    drawMachineBackground();          /* full canvas, unscaled */

    mCtx.save();
    mCtx.translate(MACHINE_TX, MACHINE_TY);
    mCtx.scale(MACHINE_K, MACHINE_K);
    drawFrame();
    drawPivot();
    if (disp.protractor) drawProtractor();
    if (disp.guard) drawSafetyGuard();
    if (state.method === 'charpy') { drawAnvil(); } else { drawVice(); }
    if (!state.fractured) {
      drawSpecimen();
    } else {
      drawFracturedSpecimen();
    }
    drawTongs();
    drawPendulumArm(state.pendulumAngle);
    drawHammer(state.pendulumAngle);
    if (state.animPhase === 'impact') { drawImpactFlash(); }
    drawFractureParticles();
    if (disp.dial) drawDialGauge();
    if (disp.digital) drawDigitalPanel();
    drawStatusLEDs();
    if (disp.notchDetail) drawNotchDetail();
    if (disp.protractor) drawScaleLabels();
    drawMachineLabel();
    if (state.animPhase === 'complete' && disp.fractureInset) { drawFractureSurface(); }
    mCtx.restore();

    /* Equation band is laid out in CANVAS coords, not machine coords. */
    if (disp.equation) drawEquationBand();
  }

  function drawMachineBackground() {
    mCtx.fillStyle = '#0d1117';
    mCtx.fillRect(0, 0, MW, MH);
    mCtx.strokeStyle = 'rgba(42,48,80,0.15)';
    mCtx.lineWidth = 0.5;
    for (var x = 0; x < MW; x += 20) {
      mCtx.beginPath(); mCtx.moveTo(x, 0); mCtx.lineTo(x, MH); mCtx.stroke();
    }
    for (var y = 0; y < MH; y += 20) {
      mCtx.beginPath(); mCtx.moveTo(0, y); mCtx.lineTo(MW, y); mCtx.stroke();
    }
  }

  function metalGrad(ctx, x, y, w, h, vertical) {
    var g;
    if (vertical) {
      g = ctx.createLinearGradient(x, y, x + w, y);
    } else {
      g = ctx.createLinearGradient(x, y, x, y + h);
    }
    g.addColorStop(0, '#37474f');
    g.addColorStop(0.15, '#607d8b');
    g.addColorStop(0.5, '#78909c');
    g.addColorStop(0.85, '#607d8b');
    g.addColorStop(1, '#37474f');
    return g;
  }

  function drawFrame() {
    /* Base plate */
    var bx = FRAME_L - 10, by = BASE_Y, bw = FRAME_R - FRAME_L + 20, bh = BASE_H;
    mCtx.fillStyle = metalGrad(mCtx, bx, by, bw, bh, false);
    roundRect(mCtx, bx, by, bw, bh, 4);
    mCtx.fill();
    mCtx.strokeStyle = 'rgba(255,255,255,0.12)';
    mCtx.lineWidth = 1;
    mCtx.beginPath(); mCtx.moveTo(bx + 4, by + 1); mCtx.lineTo(bx + bw - 4, by + 1); mCtx.stroke();
    /* Shadow under base */
    mCtx.fillStyle = 'rgba(0,0,0,0.3)';
    roundRect(mCtx, bx + 4, by + bh, bw - 8, 6, 3);
    mCtx.fill();
    /* Leveling feet */
    for (var fi = 0; fi < 3; fi++) {
      var fx = bx + 20 + fi * (bw - 40) / 2;
      mCtx.fillStyle = '#455a64';
      mCtx.beginPath(); mCtx.arc(fx, by + bh + 4, 5, 0, Math.PI * 2); mCtx.fill();
      mCtx.fillStyle = '#37474f';
      mCtx.beginPath(); mCtx.arc(fx, by + bh + 4, 2.5, 0, Math.PI * 2); mCtx.fill();
    }

    /* Left upright */
    var colW = 22, colH = BASE_Y - 60;
    mCtx.fillStyle = metalGrad(mCtx, FRAME_L, 60, colW, colH, true);
    mCtx.fillRect(FRAME_L, 60, colW, colH);
    mCtx.strokeStyle = 'rgba(255,255,255,0.15)';
    mCtx.lineWidth = 1;
    mCtx.beginPath(); mCtx.moveTo(FRAME_L + 3, 60); mCtx.lineTo(FRAME_L + 3, 60 + colH); mCtx.stroke();

    /* Right upright */
    mCtx.fillStyle = metalGrad(mCtx, FRAME_R - colW, 60, colW, colH, true);
    mCtx.fillRect(FRAME_R - colW, 60, colW, colH);
    mCtx.strokeStyle = 'rgba(255,255,255,0.15)';
    mCtx.beginPath(); mCtx.moveTo(FRAME_R - colW + 3, 60); mCtx.lineTo(FRAME_R - colW + 3, 60 + colH); mCtx.stroke();

    /* Top beam */
    var tbH = 18;
    mCtx.fillStyle = metalGrad(mCtx, FRAME_L, 50, FRAME_R - FRAME_L, tbH, false);
    roundRect(mCtx, FRAME_L, 50, FRAME_R - FRAME_L, tbH, 4);
    mCtx.fill();
    mCtx.strokeStyle = 'rgba(255,255,255,0.12)';
    mCtx.lineWidth = 1;
    mCtx.beginPath(); mCtx.moveTo(FRAME_L + 4, 51); mCtx.lineTo(FRAME_R - 4, 51); mCtx.stroke();

    /* Side reinforcement plates */
    mCtx.fillStyle = '#455a64';
    mCtx.fillRect(FRAME_L + colW, 68, 6, 50);
    mCtx.fillRect(FRAME_R - colW - 6, 68, 6, 50);
