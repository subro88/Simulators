  /* Notch preparation quality. ASTM E23 holds the V-notch root radius to
     0.25 +/- 0.025 mm and the depth to 2 +/- 0.025 mm. An out-of-tolerance notch
     does not merely add scatter — it biases the result HIGH, so a badly machined
     notch makes a material look tougher than it is. That is why E23 treats it as
     invalidating rather than as an uncertainty.
       dDepth  mm change to the notch depth (shallow notch leaves more ligament)
       rMul    multiplier on the root radius
       eMul    constraint effect at full ductility, blended toward 1 as the
               fracture turns brittle (cleavage barely cares about the root) */
  var NOTCH_CONDITIONS = {
    'to-spec': { label: 'To spec (ASTM E23)', dDepth: 0,    rMul: 1, eMul: 1.00, valid: true  },
    'blunt':   { label: 'Blunt root',         dDepth: 0,    rMul: 2, eMul: 1.20, valid: false },
    'shallow': { label: 'Shallow notch',      dDepth: -0.3, rMul: 1, eMul: 1.00, valid: false }
  };

  /* Notch geometry AFTER the preparation-quality deviation is applied. */
  function effNotch(notchType, cond) {
    var n = NOTCH_TYPES[notchType] || NOTCH_TYPES['V-notch'];
    var c = NOTCH_CONDITIONS[cond] || NOTCH_CONDITIONS['to-spec'];
    return {
      depth: Math.max(0.2, n.depth + c.dDepth),
      radius: n.radius * c.rMul,
      angle: n.angle,
      eFactor: n.eFactor,
      nominalDepth: n.depth
    };
  }

  /* Pendulum — standard ISO 148-1 300 J machine.
     E_cap = m·g·R·(1 − cos 150deg) = 20.5 × 9.81 × 0.8 × 1.86603 = 300.2 J
     v     = sqrt(2·g·R·(1 − cos 150deg))                        = 5.41 m/s
     (ISO 148-1 requires an impact velocity of 5.0–5.5 m/s.) */
  var PEND_MASS = 20.5;
  var PEND_R = 0.8;
  var GRAVITY = 9.81;
  /* Default latch angle. The live value is state.alpha — the release angle is a
     real machine setting: it fixes both the stored energy and the striking
     speed. (beta is NOT settable: it is what the machine measures.) */
  var RELEASE_ANGLE_DEG = 150;
  var ALPHA_MIN = 90, ALPHA_MAX = 160;
  function alphaDeg() { return state.alpha; }
  var MAX_ENERGY = 300;

  /* Izod values run below Charpy for the same material and notch: the specimen is
     a clamped cantilever struck on the notched face, so the stressed ligament is
     smaller and loading is less symmetric. 0.80 is a representative ratio. */
  var IZOD_METHOD_FACTOR = 0.80;

  /* Machine capacity actually available from the pendulum, in J. */
  function machineCapacity() {
    return PEND_MASS * GRAVITY * PEND_R * (1 - Math.cos(degToRad(alphaDeg())));
  }

  /* ASTM E23 §"Precision": a result is only quantitatively valid when the
     absorbed energy is below ~80 % of the machine's capacity. */
  function capacityLimit() { return machineCapacity() * 0.8; }

  /* `z` is a shared normalised scatter deviate in [-0.5, +0.5]. Passing the SAME
     deviate to the energy and the shear-fraction models keeps a low-energy
     specimen reading a low shear percentage — they are two measurements of one
     fracture, not two independent random draws. */
  function getEnergyAtTemp(mat, T, z) {
    if (z === undefined) z = Math.random() - 0.5;
    if (mat.DBTT === null || mat.transWidth === 0) {
      /* No transition: the material sits at its room-temperature level.
         `energyRT` is the authoritative value (it is what the user types for a
         custom material); the shelf mean is only a fallback. */
      var base = isFinite(mat.energyRT) && mat.energyRT > 0
        ? mat.energyRT
        : (mat.upperShelf + mat.lowerShelf) / 2;
      return Math.max(0, base + z * (mat.upperShelf - mat.lowerShelf) * 0.3);
    }
    var e = tanhSigmoid(T, mat.lowerShelf, mat.upperShelf, mat.DBTT, mat.transWidth);
    return Math.max(0, e + z * 4);
  }

  function getShearFracPercent(mat, T, z) {
    if (z === undefined) z = Math.random() - 0.5;
    if (mat.DBTT === null || mat.transWidth === 0) {
      if (mat.crystal === 'BCC-graphite') return clamp(5 + z * 5, 0, 100);
      return clamp(92 + z * 15, 0, 100);
    }
    return clamp(tanhSigmoid(T, 0, 100, mat.DBTT, mat.transWidth) + z * 4, 0, 100);
  }

  /* Lateral expansion is derived from the SAME shear fraction that is reported,
     so the two readouts can never disagree. */
  function lateralFromShear(mat, shearPct) {
    var maxExp = mat.crystal === 'polymer' ? 1.5 : 2.0;
    return shearPct / 100 * maxExp;
  }

  /* Solve the tanh transition width w from
        E(23) = lower + (upper−lower)·½·(1 + tanh((23 − DBTT)/w))
     so a custom material's stated room-temperature energy, its shelves and its
     DBTT describe one self-consistent curve. Falls back to 25 degC when the
     inputs are degenerate (RT at the DBTT, or RT energy on a shelf). */
  function deriveTransWidth(v) {
    var span = v.upperShelf - v.lowerShelf;
    if (!(span > 0)) return 25;
    var frac = 2 * (v.energyRT - v.lowerShelf) / span - 1;   /* target tanh value */
    frac = clamp(frac, -0.999, 0.999);
    var dT = 23 - v.DBTT;
    var at = Math.atanh ? Math.atanh(frac) : 0.5 * Math.log((1 + frac) / (1 - frac));
    if (!isFinite(at) || Math.abs(at) < 1e-6 || Math.abs(dT) < 1e-6) return 25;
    var w = dT / at;
    /* w <= 0 means the inputs contradict each other (RT energy on the wrong side
       of the shelf midpoint for the given DBTT). validateCustomCurve() rejects
       that combination before we ever get here; 25 is a defensive fallback. */
    if (!isFinite(w) || w <= 0) return 25;
    return clamp(w, 3, 400);
  }

  /* A rising tanh sigmoid cannot be below its midpoint at a temperature above
     its DBTT (or above the midpoint below the DBTT). Returns an error string,
     or null when the three inputs describe one consistent curve. */
  function validateCustomCurve(v) {
    if (v.DBTT === null) return null;              /* no transition modelled */
    var mid = (v.upperShelf + v.lowerShelf) / 2;
    var aboveMid = v.energyRT > mid;
    var aboveDBTT = 23 > v.DBTT;
    if (Math.abs(v.energyRT - mid) < 1e-9 || Math.abs(23 - v.DBTT) < 1e-9) return null;
    if (aboveMid !== aboveDBTT) {
      return aboveDBTT
        ? 'With a DBTT below 23 °C, the room-temperature energy must be ABOVE the shelf midpoint (' +
          roundN(mid, 1) + ' J). Raise the RT energy or raise the DBTT above 23 °C.'
        : 'With a DBTT above 23 °C, the room-temperature energy must be BELOW the shelf midpoint (' +
          roundN(mid, 1) + ' J). Lower the RT energy or lower the DBTT below 23 °C.';
    }
    return null;
  }

  /* Notch energy multiplier, blended toward 1.0 as the fracture turns brittle. */
  function notchEnergyFactor(notchType, shearPct) {
    var n = NOTCH_TYPES[notchType] || NOTCH_TYPES['V-notch'];
    return 1 + (n.eFactor - 1) * clamp(shearPct / 100, 0, 1);
  }

  /* One fracture event = one set of mutually consistent measurements. */
  function sampleTest(mat, T, method, notchType) {
    var z = Math.random() - 0.5;
    var shear = getShearFracPercent(mat, T, z);
    var cond = NOTCH_CONDITIONS[state.notchCond] || NOTCH_CONDITIONS['to-spec'];
    var duct = clamp(shear / 100, 0, 1);

    /* Geometric scaling — sub-size thickness AND any notch-depth deviation both
       act through the remaining ligament area. notchEnergyFactor already carries
       the NET measured ratio between notch TYPES (KV vs KU), so the area ratio
       here is taken against the same type's nominal area to avoid counting the
       type's own area change twice. */
    var areaRatio = ligamentAreaCm2(notchType, method) / nominalAreaCm2(notchType, method);
    /* Blunt root relieves crack-tip constraint: a real effect on a ductile
       fracture, negligible once the crack runs by cleavage. */
    var condFactor = 1 + (cond.eMul - 1) * duct;

    var raw = getEnergyAtTemp(mat, T, z) *
              notchEnergyFactor(notchType, shear) *
              (method === 'izod' ? IZOD_METHOD_FACTOR : 1) *
              areaRatio * condFactor;
    var cap = machineCapacity();
    /* The pendulum cannot give up more energy than it carries. If the specimen
       demands more, it is not broken through — it bends or is dragged past. */
    var unbroken = raw >= cap * 0.98;
    var energy = clamp(raw, 0, cap * 0.98);
    return {
      energy: energy,
      shearFrac: shear,
      lateralExp: lateralFromShear(mat, shear),
      unbroken: unbroken,
      overCapacity: energy > capacityLimit(),
      notchInvalid: !cond.valid,
      specWidth: state.specWidth
    };
  }

  function getFractureType(shearPct) {
    if (shearPct >= 80) return 'Ductile';
    if (shearPct <= 20) return 'Brittle';
    return 'Mixed';
  }

  function calcImpactVelocity(alphaDeg) {
    var alpha = degToRad(alphaDeg);
    return Math.sqrt(2 * GRAVITY * PEND_R * (1 - Math.cos(alpha)));
  }

  function calcBetaAngle(alphaDeg, absorbedEnergy) {
    var alpha = degToRad(alphaDeg);
    var totalE = PEND_MASS * GRAVITY * PEND_R * (1 - Math.cos(alpha));
    var remaining = totalE - absorbedEnergy;
    if (remaining <= 0) return 0;
    var cosBeta = 1 - remaining / (PEND_MASS * GRAVITY * PEND_R);
    cosBeta = clamp(cosBeta, -1, 1);
    return radToDeg(Math.acos(cosBeta));
  }

  /* Remaining ligament area behind the notch, in cm^2.
     The notch is cut into the 10 mm HEIGHT, so the ligament is
     (height − notch depth); the full 10 mm width is the breadth. */
  function ligamentAreaCm2(notchType, method, specW, cond) {
    var notch = effNotch(notchType, cond || state.notchCond);
    var spec = method === 'izod' ? IZOD_SPEC : CHARPY_SPEC;
    var w = (specW === undefined) ? state.specWidth : specW;
    var ligament = Math.max(0.1, spec.height - notch.depth);
    return w * ligament / 100;
  }

  /* Nominal (full-size, in-tolerance) ligament area for the same notch type —
     the reference the material's tabulated energy corresponds to. */
  function nominalAreaCm2(notchType, method) {
    return ligamentAreaCm2(notchType, method, FULL_WIDTH, 'to-spec');
  }

  function calcImpactToughness(energy, notchType, method) {
    return energy / ligamentAreaCm2(notchType, method);
  }

