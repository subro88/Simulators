  /* ── Release angle alpha ──────────────────────────────────────────
     alpha is a genuine machine setting: it sets both the stored energy
     E_cap = m.g.R.(1 - cos alpha) and the striking speed
     v = sqrt(2.g.R.(1 - cos alpha)). beta deliberately has NO control — it is
     the angle the pendulum swings THROUGH after breaking the specimen, i.e.
     the quantity the machine measures and the one E is solved from. */
  var elSliderAlpha = $('slider-alpha'), elValAlpha = $('val-alpha');

  function syncAlphaDisplay() {
    if (elSliderAlpha && document.activeElement !== elSliderAlpha) elSliderAlpha.value = state.alpha;
    if (elValAlpha && document.activeElement !== elValAlpha) elValAlpha.value = state.alpha;
    /* Filled-progress track. Firefox uses ::-moz-range-progress natively and
       ignores --pct; every other engine reads it from the gradient. */
    if (elSliderAlpha) {
      var pct = (state.alpha - ALPHA_MIN) / (ALPHA_MAX - ALPHA_MIN) * 100;
      elSliderAlpha.style.setProperty('--pct', roundN(pct, 1) + '%');
    }
    var note = $('alpha-note');
    if (note) {
      var v = calcImpactVelocity(state.alpha);
      var cap = machineCapacity();
      /* ISO 148-1 requires a striking velocity of 5.0-5.5 m/s. */
      var inSpec = v >= 5.0 && v <= 5.5;
      note.className = 'ctrl-note ' + (inSpec ? 'cn-ok' : 'cn-warn');
      note.innerHTML = roundN(toD(v, 'vel'), 2) + ' ' + uLabel('vel') + ' &middot; ' +
                       roundN(toD(cap, 'energy'), 0) + ' ' + uLabel('energy') +
                       (inSpec ? '' : ' &middot; off ISO spec');
      note.title = inSpec
        ? 'Striking velocity is inside the ISO 148-1 window of 5.0-5.5 m/s.'
        : 'ISO 148-1 requires a striking velocity of 5.0-5.5 m/s; this setting is outside it.';
    }
  }

  function setAlpha(deg, live) {
