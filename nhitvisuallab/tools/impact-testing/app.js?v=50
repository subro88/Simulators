  /* Render a side-view of the fractured specimen with notch + fracture
     surface, plus a small shear-vs-cleavage ratio bar. Light theme. */
  function buildImpactSpecimenSketch(mat, r) {
    var W = 520, H = 380;
    var c = document.createElement('canvas');
    c.width = W; c.height = H;
    var x = c.getContext('2d');

    /* Background */
    x.fillStyle = '#ffffff'; x.fillRect(0, 0, W, H);

    /* Title */
    x.fillStyle = '#0d47a1';
    x.font = 'bold 14px "Segoe UI", system-ui, sans-serif';
    x.textAlign = 'center';
    x.fillText('Fractured Specimen (side view)', W / 2, 22);

    /* Specimen bar */
    var sx = 60, sy = 80, sw = W - 120, sh = 70;
    var mid = sx + sw / 2;

    /* Left half */
    var matCol = mat.color || '#90a4ae';
    var grad1 = x.createLinearGradient(0, sy, 0, sy + sh);
    grad1.addColorStop(0, '#eceff1');
    grad1.addColorStop(1, '#b0bec5');
    x.fillStyle = grad1;
    x.fillRect(sx, sy, (sw / 2) - 3, sh);
    x.fillStyle = matCol; x.globalAlpha = 0.20;
    x.fillRect(sx, sy, (sw / 2) - 3, sh);
    x.globalAlpha = 1;
    x.strokeStyle = '#546e7a'; x.lineWidth = 1.2;
    x.strokeRect(sx, sy, (sw / 2) - 3, sh);

    /* Right half (separated by small gap) */
    x.fillStyle = grad1;
    x.fillRect(mid + 3, sy, (sw / 2) - 3, sh);
    x.fillStyle = matCol; x.globalAlpha = 0.20;
    x.fillRect(mid + 3, sy, (sw / 2) - 3, sh);
    x.globalAlpha = 1;
    x.strokeRect(mid + 3, sy, (sw / 2) - 3, sh);

    /* V-notch on top center of each half */
    x.fillStyle = '#37474f';
    x.beginPath();
    x.moveTo(mid - 10, sy);
    x.lineTo(mid - 3, sy + 18);
    x.lineTo(mid - 3, sy);
    x.closePath();
    x.fill();
    x.beginPath();
    x.moveTo(mid + 10, sy);
    x.lineTo(mid + 3, sy + 18);
    x.lineTo(mid + 3, sy);
    x.closePath();
    x.fill();

    /* Jagged fracture surface \u2014 left edge of right half */
    x.strokeStyle = '#37474f';
    x.lineWidth = 1.2;
    x.beginPath();
    x.moveTo(mid - 3, sy + 18);
    var jagX = mid - 3, jagY = sy + 18;
    for (var jy = sy + 22; jy <= sy + sh; jy += 6) {
      var jdx = (Math.random() - 0.5) * 6;
      x.lineTo(jagX + jdx, jy);
    }
    x.stroke();
    x.beginPath();
    x.moveTo(mid + 3, sy + 18);
    for (var jy2 = sy + 22; jy2 <= sy + sh; jy2 += 6) {
      var jdx2 = (Math.random() - 0.5) * 6;
      x.lineTo(mid + 3 + jdx2, jy2);
    }
    x.stroke();

    /* Dimension labels */
    x.fillStyle = '#37474f';
    x.font = '11px "Courier New", monospace';
    x.textAlign = 'center';
    x.fillText('10 mm \u00D7 10 mm \u00D7 ' + (state.method === 'charpy' ? '55' : '75') + ' mm',
      W / 2, sy + sh + 22);

    /* Shear fracture % bar */
    var barY = sy + sh + 60;
    var barH = 18;
    var barX = 60;
    var barW = W - 120;
    x.fillStyle = '#eceff1';
    x.fillRect(barX, barY, barW, barH);
    x.strokeStyle = '#90a4ae';
    x.lineWidth = 1;
    x.strokeRect(barX, barY, barW, barH);
    var shearPx = Math.max(0, Math.min(100, r.shearFrac)) / 100 * barW;
    x.fillStyle = '#2e7d32';
    x.fillRect(barX, barY, shearPx, barH);
    /* Cleavage portion */
    if (shearPx < barW) {
      x.fillStyle = 'rgba(198,40,40,0.85)';
      x.fillRect(barX + shearPx, barY, barW - shearPx, barH);
    }
    /* Label */
    x.fillStyle = '#37474f';
    x.font = '600 11px "Segoe UI", sans-serif';
    x.textAlign = 'left';
    x.fillText('Shear (fibrous) ' + Math.round(r.shearFrac) + '%', barX, barY - 6);
    x.textAlign = 'right';
    x.fillText('Cleavage (brittle) ' + Math.round(100 - r.shearFrac) + '%', barX + barW, barY - 6);

    /* Fracture mode label */
    x.fillStyle = '#0d47a1';
    x.font = 'bold 13px "Segoe UI", sans-serif';
    x.textAlign = 'center';
    x.fillText(r.fracType, W / 2, barY + barH + 28);

    /* Watermark */
    x.fillStyle = 'rgba(0,0,0,0.30)';
    x.font = '10px "Segoe UI", sans-serif';
    x.textAlign = 'right';
    x.fillText('mechsimulator.com', W - 10, H - 4);

    return c.toDataURL('image/png');
  }

