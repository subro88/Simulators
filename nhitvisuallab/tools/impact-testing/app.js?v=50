    var r2 = Math.round(lerp(176, 255, t2));
    var g2 = Math.round(lerp(190, 87, t2));
    var b2 = Math.round(lerp(197, 34, t2));
    return 'rgb(' + r2 + ',' + g2 + ',' + b2 + ')';
  }

