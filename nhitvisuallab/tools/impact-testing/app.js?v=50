  ];

  var disp = {};
  DISPLAY_TOGGLES.forEach(function (t) { disp[t[1]] = true; });

  function applyDisplayToDOM() {
    DISPLAY_TOGGLES.forEach(function (t) {
      var el = $(t[0]); if (el) el.checked = !!disp[t[1]];
    });
  }

  (function wireCanvasToggles() {
    DISPLAY_TOGGLES.forEach(function (t) {
      var el = $(t[0]); if (!el) return;
      el.addEventListener('change', function () {
        disp[t[1]] = this.checked;
        drawMachine();
        drawGraph();
      });
    });
    var rst = $('cvt-reset');
    if (rst) rst.addEventListener('click', function () {
      DISPLAY_TOGGLES.forEach(function (t) { disp[t[1]] = true; });
      applyDisplayToDOM();
      drawMachine();
      drawGraph();
    });
  })();


  /* ================================================================
     S19d — ON-CANVAS CLASSICAL EQUATION (Pattern 3)
     ================================================================ */
  /* 0 before the hammer passes through, ramping to 1 as the pendulum
     completes its follow-through — so the absorbed energy visibly counts up. */
  function equationRoll() {
    switch (state.animPhase) {
      case 'swingThrough': return clamp(state.animProgress, 0, 1);
      case 'returning':
      case 'dialReading':
      case 'complete':     return 1;
      default:             return 0;
    }
  }

  function drawEquationBand() {
    if (!mCtx) return;
    var roll = equationRoll();
    var stale = roll < 0.001;
    var cy = EQ_BAND_Y;

    var C_E = '#ff8a65', C_M = '#42a5f5', C_ANG = '#ffd54f', C_OP = '#c8d7f0';

    /* Symbolic line and substituted line, as coloured token runs. */
    var alphaD = alphaDeg();
    var betaD = stale ? null : state.finalAngle;
    var eNow = stale ? null : state.absorbedEnergy * roll;

    var line1 = [
      ['E', C_E], [' = ', C_OP], ['m', C_M], [' g ', C_M], ['R ', C_M],
      ['(cos ', C_OP], ['\u03B2', C_ANG], [' \u2212 cos ', C_OP], ['\u03B1', C_ANG], [')', C_OP]
    ];
    var line2 = [
      ['E', C_E], [' = ', C_OP],
      [roundN(PEND_MASS, 1) + ' \u00D7 ' + GRAVITY + ' \u00D7 ' + PEND_R + ' \u00D7 ', C_M],
      ['(cos ', C_OP],
      [betaD === null ? '\u03B2' : roundN(betaD, 1) + '\u00B0', C_ANG],
      [' \u2212 cos ', C_OP],
      [alphaD + '\u00B0', C_ANG],
      [') = ', C_OP],
      [eNow === null ? '\u2014 ' + uLabel('energy')
                     : roundN(toD(eNow, 'energy'), 1) + ' ' + uLabel('energy'), C_E]
    ];

    /* Uniform auto-shrink so the widest line clears the canvas margins. */
    var maxW = MW - 32;
    var s1 = 15, s2 = 12;
    function measure(tokens, size, bold) {
      mCtx.font = (bold ? '700 ' : '') + size + 'px "Cambria Math","Times New Roman",serif';
      var w = 0;
      for (var i = 0; i < tokens.length; i++) w += mCtx.measureText(tokens[i][0]).width;
      return w;
    }
    var w1 = measure(line1, s1, true), w2 = measure(line2, s2, true);
    var widest = Math.max(w1, w2);
    if (widest > maxW) {
      var sc = Math.max(0.6, maxW / widest);
      s1 = Math.max(10, Math.round(s1 * sc));
      s2 = Math.max(9, Math.round(s2 * sc));
      w1 = measure(line1, s1, true); w2 = measure(line2, s2, true);
    }

    function drawTokens(tokens, size, y) {
      mCtx.font = '700 ' + size + 'px "Cambria Math","Times New Roman",serif';
      var total = 0, i;
      for (i = 0; i < tokens.length; i++) total += mCtx.measureText(tokens[i][0]).width;
      var x = Math.round((MW - total) / 2);
      mCtx.textAlign = 'left';
      mCtx.textBaseline = 'middle';
      for (i = 0; i < tokens.length; i++) {
        mCtx.fillStyle = tokens[i][1];
        mCtx.fillText(tokens[i][0], x, y);
        x += mCtx.measureText(tokens[i][0]).width;
      }
    }

    /* Band background so the equation reads against the machine artwork. */
    mCtx.fillStyle = 'rgba(22,27,39,0.92)';
    roundRect(mCtx, 10, cy - 34, MW - 20, 62, 10);
    mCtx.fill();
    mCtx.strokeStyle = 'rgba(255,61,0,0.30)';
    mCtx.lineWidth = 1;
    mCtx.stroke();

    drawTokens(line1, s1, cy - 15);
    drawTokens(line2, s2, cy + 11);
    mCtx.textAlign = 'left';
    mCtx.textBaseline = 'alphabetic';
  }

  /* ================================================================
     S19d2 — INFERENCE PANEL (reads the completed test back in words)
     ================================================================
     Distinct from the What-if coach: the coach describes the SETTINGS before a
     test, this reads the RESULT after one. */
  function updateInferencePanel() {
    var panel = $('inference-panel'), body = $('inf-body'), verdict = $('inf-verdict');
    if (!panel || !body) return;
    var r = state.results;
    if (!r) { panel.style.display = 'none'; return; }

    var mat = MATERIALS[state.matIdx];
    var T = state.temperature;
    var uE = uLabel('energy');
    var degU = unitSystem === 'imperial' ? '°F' : '°C';
    var items = [];
    function add(cls, ico, html, wide) {
      items.push('<div class="inf-item ' + cls + (wide ? ' ii-wide' : '') + '">' +
                 '<span class="inf-ico">' + ico + '</span><span>' + html + '</span></div>');
    }

    /* Verdict chip */
    var vCls = r.fracType === 'Ductile' ? 'v-ductile' : (r.fracType === 'Brittle' ? 'v-brittle' : 'v-mixed');
    verdict.className = 'inf-verdict ' + vCls;
    verdict.textContent = r.fracType + ' fracture';

    /* 1 — headline energy reading */
    add('ii-info', '⚡',
      '<strong>' + mat.name + '</strong> absorbed <em>' + fmtE(r.energy) + ' ' + uE + '</em> at ' +
      fmtT(T) + '&nbsp;' + degU + ' (' + (state.method === 'charpy' ? 'Charpy' : 'Izod') + ', ' +
      state.notch + '). The pendulum carried ' + fmtE(machineCapacity(), 0) + '&nbsp;' + uE +
      ' and came through to ' + roundN(r.beta, 1) + '&deg; instead of ' + roundN(r.alpha, 0) +
      '&deg; — that lost height <em>is</em> the measurement.');

    /* 2 — what the fracture surface says */
    var surf;
    if (r.shearFrac >= 80) {
      surf = 'a dull, fibrous, grey surface with clear shear lips at the edges. The material tore ' +
             'slowly, absorbing energy through plastic deformation.';
    } else if (r.shearFrac <= 20) {
      surf = 'a bright, granular, faceted surface with no shear lips. The crack ran by cleavage ' +
             'almost instantly, absorbing almost nothing.';
    } else {
      surf = 'a mixed surface — a fibrous ring around a bright granular centre. This is the ' +
             'transition region, where results scatter most between identical specimens.';
    }
    add(r.shearFrac >= 80 ? 'ii-good' : (r.shearFrac <= 20 ? 'ii-bad' : 'ii-warn'), '🔍',
      '<strong>' + roundN(r.shearFrac, 0) + '% shear fracture</strong> means ' + surf +
      ' Lateral expansion of <em>' + roundN(toD(r.lateralExp, 'length'), 2) + ' ' + uLabel('length') +
      '</em> confirms it: the more the specimen squashed sideways, the more ductile it was.');

    /* 3 — position relative to the transition */
    if (mat.DBTT === null || mat.transWidth === 0) {
      if (mat.crystal === 'FCC') {
        add('ii-good', '❄️',
          '<strong>No transition to worry about.</strong> ' + mat.name + ' is face-centred cubic, so ' +
          'it has no ductile-to-brittle transition — this same energy would be measured at ' +
          '&minus;196&nbsp;&deg;C. That is why FCC alloys are specified for cryogenic service.');
      } else {
        add('ii-bad', '⚠️',
          '<strong>Brittle at every temperature.</strong> ' + mat.name + ' contains graphite flakes ' +
          'that act as internal notches, so there is no transition curve to map and no temperature ' +
          'at which it becomes tough.');
      }
    } else {
      var margin = Math.round(T - mat.DBTT);
      if (margin < -mat.transWidth) {
        add('ii-bad', '❗',
          '<strong>You are ' + Math.abs(margin) + '&nbsp;&deg;C below the ' + mat.DBTT +
          '&nbsp;&deg;C DBTT</strong> — on the lower shelf. This is precisely the Liberty Ship ' +
          'condition: a steel that is perfectly tough in the workshop behaving like glass in service.');
      } else if (margin > mat.transWidth) {
        add('ii-good', '✅',
          '<strong>You are ' + margin + '&nbsp;&deg;C above the ' + mat.DBTT +
          '&nbsp;&deg;C DBTT</strong> — on the upper shelf, where toughness is limited by the alloy ' +
          'rather than by temperature. ' + (isVCharpy()
            ? 'The Charpy V-notch upper shelf for this material is ' + mat.upperShelf + '&nbsp;J.'
            : 'Note the upper shelf of ' + mat.upperShelf + '&nbsp;J is a <em>Charpy V-notch</em> ' +
              'figure — the ' + basisLabel() + ' reading above is on a different basis.'));
      } else {
        add('ii-warn', '⚠️',
          '<strong>You are inside the transition</strong> (' + mat.DBTT + '&nbsp;&deg;C &plusmn;' +
          mat.transWidth + '&nbsp;&deg;C). Energy changes fastest here and scatter is worst — ' +
          'ASTM E23 requires three specimens per temperature in this band, not one.');
      }
    }

    /* 4 — service / code implication.
       Code minima are written against Charpy V-notch, so a U-notch, keyhole or
       Izod number must not be compared with them directly. Rather than compare
       the wrong quantity, say so and fall back to the equivalent V-notch value. */
    var eSI = r.energy;
    var kSize = r.specWidth / FULL_WIDTH;
    var min18 = 18 * kSize, min27 = 27 * kSize, min40 = 40 * kSize;
    if (r.specWidth !== FULL_WIDTH && !r.notchInvalid && state.notch === 'V-notch' && state.method === 'charpy') {
      /* Sub-size but otherwise on-basis: the comparison IS valid once scaled. */
      add(eSI >= min40 ? 'ii-good' : (eSI >= min18 ? 'ii-warn' : 'ii-bad'), '\uD83D\uDCCB',
        '<strong>Sub-size specimen &mdash; criteria scale with it.</strong> A ' + sizeLabel() +
        '-size bar is held to ' + sizeLabel() + ' of the full-size requirement, so the ASME ' +
        '18&ndash;27 J band becomes <em>' + fmtE(min18) + '&ndash;' + fmtE(min27) + ' ' + uE +
        '</em> and the 40 J sub-Arctic figure becomes <em>' + fmtE(min40) + ' ' + uE + '</em>. ' +
        'Your ' + fmtE(eSI) + ' ' + uE + ' ' +
        (eSI >= min40 ? 'clears both.' : (eSI >= min18 ? 'clears the ASME band but not the pipeline figure.' : 'fails both.')) +
        ' Comparing a sub-size result against the unscaled numbers is the most common error in ' +
        'Charpy acceptance testing.');
    } else if (!isVCharpy()) {
      var vEquiv = predictEnergyFor(mat, T, 'V-notch', 'charpy');
      add('ii-warn', '📋',
        '<strong>Not directly comparable to code minima.</strong> ASME and pipeline acceptance ' +
        'criteria (18&ndash;27&nbsp;J and 40&nbsp;J) are written against the <em>Charpy V-notch</em> ' +
        'test. Your ' + basisLabel() + ' reading of <em>' + fmtE(eSI) + '&nbsp;' + uE +
        '</em> cannot be checked against them. The equivalent Charpy V-notch value here would be ' +
        'about <em>' + fmtE(vEquiv) + '&nbsp;' + uE + '</em> — switch to Charpy V-notch to test ' +
        'against a specification.');
    } else if (eSI < 18) {
      add('ii-bad', '📋',
        '<strong>Fails common code minima.</strong> ASME pressure-vessel practice wants at least ' +
        '18&ndash;27&nbsp;J at the lowest service temperature, and sub-Arctic pipeline steel is often ' +
        'specified at 40&nbsp;J. This material must not be used at this temperature.');
    } else if (eSI < 40) {
      add('ii-warn', '📋',
        '<strong>Marginal.</strong> Clears the 18&ndash;27&nbsp;J ASME band but falls short of the ' +
        '40&nbsp;J typically demanded for sub-Arctic pipeline service. Acceptable only with a ' +
        'documented minimum service temperature.');
    } else {
      add('ii-good', '📋',
        '<strong>Comfortably above code minima.</strong> Clears both the 18&ndash;27&nbsp;J ASME ' +
        'band and the 40&nbsp;J sub-Arctic pipeline requirement at this temperature.');
    }

    /* 4b — notch preparation */
    if (r.notchInvalid) {
      var ncL = NOTCH_CONDITIONS[r.notchCond];
      add('ii-bad', '\uD83D\uDD27',
        '<strong>Notch was ' + ncL.label.toLowerCase() + ' &mdash; this reading is not usable.</strong> ' +
        (r.notchCond === 'blunt'
          ? 'A root radius above the ASTM E23 0.25 &plusmn; 0.025 mm band relieves crack-tip constraint, so the specimen absorbs more energy than a correctly machined one would.'
          : 'A notch shallower than 2 &plusmn; 0.025 mm leaves extra ligament, so more material has to be broken.') +
        ' Either way the error pushes the answer <em>high</em>, which is the dangerous direction &mdash; ' +
        'it makes a steel look safer than it is. Notch machining is checked on an optical comparator ' +
        'precisely because of this.', true);
    }

    /* 5 — validity, only when it is not a clean pass */
    if (r.unbroken) {
      add('ii-bad', '🚫',
        '<strong>Not a valid number.</strong> The specimen did not separate — the pendulum ran out ' +
        'of energy. Report it as “did not break” and repeat on a higher-capacity machine.', true);
    } else if (r.overCapacity) {
      add('ii-warn', '⚙️',
        '<strong>Above 80% of machine capacity.</strong> Friction and vibration losses are no longer ' +
        'negligible at this energy, so ASTM E23 treats the value as indicative only.', true);
    }

    /* 6 — what to do next */
    var next;
    if (mat.DBTT !== null && mat.transWidth > 0) {
      var target = Math.round(mat.DBTT + (T > mat.DBTT ? -mat.transWidth : mat.transWidth));
      next = 'Run the same specimen at <em>' + fmtT(target) + '&nbsp;' + degU + '</em> to add the ' +
             'other side of the transition, then fill in the middle. Five points across ' +
             '&minus;100 to +100&nbsp;&deg;C draw the full sigmoid.';
    } else {
      next = 'Switch to <strong>Mild Steel</strong> and run &minus;100&nbsp;&deg;C against ' +
             '+23&nbsp;&deg;C to see a transition this material does not have — the contrast is the lesson.';
    }
    add('ii-info', '➡️', '<strong>Next step:</strong> ' + next +
        ' You have <em>' + state.testPoints.length + '</em> point' +
        (state.testPoints.length === 1 ? '' : 's') + ' on the curve so far.', true);

    body.innerHTML = items.join('');
    panel.style.display = '';
  }

  /* ================================================================
     S19e — LEARNING PANELS (Live equations / Coach / History)
     ================================================================ */
  var _learnCache = { eq: '', coach: '', hist: '' };

  function fmtT(tSI, d) { return roundN(toD(tSI, 'temp'), d === undefined ? 0 : d); }
  function fmtE(eSI, d) { return roundN(toD(eSI, 'energy'), d === undefined ? 1 : d); }

  function updateLearnPanels() {
    updateEquationsPanel();
    updateCoachPanel();
    updateHistoryPanel();
  }

  /* Debounced variant for CONTINUOUS input (the temperature slider).
     Every rebuild replaces #lp-eq-body's innerHTML, and shared/latex-auto.js
     re-renders it through an async MutationObserver — so at slider-drag rate the
     panel is repainted with raw \(...\) source before KaTeX catches up, which
     reads as flicker. The _learnCache string compare cannot help here because
     the content genuinely differs at every step. Coalescing to one rebuild once
     the drag settles removes the flicker without making the panel feel stale. */
  var _learnTimer = null;
  function scheduleLearnPanels() {
    if (_learnTimer) clearTimeout(_learnTimer);
    _learnTimer = setTimeout(function () {
      _learnTimer = null;
      updateLearnPanels();
    }, 130);
  }

  function updateEquationsPanel() {
    var el = $('lp-eq-body'); if (!el) return;
    var mat = MATERIALS[state.matIdx];
    var r = state.results;
    var uE = unitSystem === 'imperial' ? '\\mathrm{ft{\\cdot}lbf}' : '\\mathrm{J}';
    var uV = unitSystem === 'imperial' ? '\\mathrm{ft/s}' : '\\mathrm{m/s}';
    var uK = unitSystem === 'imperial' ? '\\mathrm{ft{\\cdot}lbf/in^2}' : '\\mathrm{J/cm^2}';
    var v = calcImpactVelocity(alphaDeg());
    var area = ligamentAreaCm2(state.notch, state.method);
    var cap = machineCapacity();

    var html = '';
    html += '<div class="eq-line">\\[ v = \\sqrt{2\\,g\\,R\\,(1-\\cos\\alpha)} = ' +
            roundN(toD(v, 'vel'), 2) + '\\;' + uV + ' \\]</div>';
    html += '<div class="eq-line">\\[ E = m\\,g\\,R\\,(\\cos\\beta - \\cos\\alpha) \\]</div>';

    if (r) {
      html += '<div class="eq-line">\\(E = ' + PEND_MASS + ' \\times ' + GRAVITY + ' \\times ' + PEND_R +
              ' \\times (\\cos ' + roundN(r.beta, 1) + '^\\circ - \\cos ' + roundN(r.alpha, 0) +
              '^\\circ) = \\mathbf{' + fmtE(r.energy) + '\\;' + uE + '}\\)</div>';
      html += '<div class="eq-line">\\[ K = \\dfrac{E}{A_{\\text{lig}}} = \\dfrac{' + fmtE(r.energy) +
              '}{' + roundN(area, 2) + '} = \\mathbf{' + roundN(toD(r.toughness, 'tough'), 1) +
              '\\;' + uK + '} \\]</div>';
      html += '<p class="eq-note">Ligament area \\(A_{\\text{lig}} = ' + (state.method === 'izod' ? IZOD_SPEC.width : CHARPY_SPEC.width) +
              '\\,\\mathrm{mm} \\times (10 - ' + NOTCH_TYPES[state.notch].depth + ')\\,\\mathrm{mm} = ' +
              roundN(area, 2) + '\\;\\mathrm{cm^2}\\) for the ' + state.notch + '. ' +
              'Machine capacity \\(' + fmtE(cap, 0) + '\\;' + uE + '\\).</p>';
    } else {
      html += '<div class="eq-line">\\[ K = \\dfrac{E}{A_{\\text{lig}}}, \\qquad A_{\\text{lig}} = ' +
              roundN(area, 2) + '\\;\\mathrm{cm^2} \\]</div>';
      html += '<p class="eq-note">Release the pendulum to substitute measured values. ' +
              /* ^\circ needs a base immediately before it — a \, in between
                 makes KaTeX bail and dump the raw source into the page. */
              'Predicted energy for ' + mat.name + ' at \\(' + fmtT(state.temperature) +
              (unitSystem === 'imperial' ? '^\\circ\\mathrm{F}' : '^\\circ\\mathrm{C}') + '\\): about ' +
              '\\(' + fmtE(predictEnergy(mat, state.temperature)) + '\\;' + uE + '\\).</p>';
    }

    if (html !== _learnCache.eq) {
      el.innerHTML = html;
      _learnCache.eq = html;
      /* shared/latex-auto.js renders on a MutationObserver deferred by
         setTimeout(...,0), so the browser gets a chance to paint the raw
         \(...\) source first — one frame of visible LaTeX on every rebuild.
         Rendering synchronously here closes that gap; the observer's later
         pass then finds no delimiters left and is a no-op. */
      if (window.MMLatex && window.MMLatex.render) window.MMLatex.render(el);
    }
  }

  /* Noise-free expected value on an arbitrary basis. Published shelf energies
     and code acceptance criteria are all Charpy V-notch, so being able to ask
     for the V-notch equivalent of the current setup matters. */
  function predictEnergyFor(mat, T, notchType, method) {
    var shear = getShearFracPercent(mat, T, 0);
    return getEnergyAtTemp(mat, T, 0) *
           notchEnergyFactor(notchType, shear) *
           (method === 'izod' ? IZOD_METHOD_FACTOR : 1);
  }
  function predictEnergy(mat, T) {
    return predictEnergyFor(mat, T, state.notch, state.method);
  }
  /* True when the current setup is the basis codes and shelf data are quoted on:
     full-size, in-tolerance, Charpy V-notch. */
  function isVCharpy() {
    return state.notch === 'V-notch' && state.method === 'charpy' &&
           state.specWidth === FULL_WIDTH && state.notchCond === 'to-spec';
  }
  /* Acceptance criteria are written for full-size specimens; a sub-size specimen
     is held to the same fraction of the requirement as its thickness ratio.
     The scaling is applied at report time from the RESULT's own specWidth, not
     from current state, so an old result is never re-scaled by a later change. */
  function sizeLabel() {
    for (var i = 0; i < SPEC_SIZES.length; i++) {
      if (SPEC_SIZES[i].w === state.specWidth) return SPEC_SIZES[i].frac;
    }
    return String(state.specWidth) + ' mm';
  }
  function basisLabel() {
    var parts = [(state.method === 'charpy' ? 'Charpy' : 'Izod'), state.notch];
    if (state.specWidth !== FULL_WIDTH) parts.push(sizeLabel() + '-size');
    if (state.notchCond !== 'to-spec') parts.push(NOTCH_CONDITIONS[state.notchCond].label.toLowerCase());
    return parts.join(' ');
  }

  function updateCoachPanel() {
    var el = $('lp-coach-body'); if (!el) return;
    var mat = MATERIALS[state.matIdx];
    var T = state.temperature;
    var items = [];

    function add(cls, ico, text) { items.push({ cls: cls, ico: ico, text: text }); }

    /* Crystal structure / transition behaviour */
    if (mat.DBTT === null || mat.transWidth === 0) {
      if (mat.crystal === 'FCC') {
        add('ci-good', '\u2744\uFE0F', '<strong>' + mat.name + ' is FCC.</strong> Face-centred cubic metals have ' +
            'no ductile-to-brittle transition &mdash; toughness stays high all the way to liquid-nitrogen ' +
            'temperature. This is why 304 stainless and aluminium are used for cryogenic vessels.');
      } else {
        add('ci-info', '\u26A0\uFE0F', '<strong>' + mat.name + '</strong> is brittle across the whole temperature ' +
            'range. Its graphite flakes act as internal notches, so there is no useful transition curve to map.');
      }
    } else {
      var margin = T - mat.DBTT;
      if (margin < -mat.transWidth) {
        add('ci-warn', '\u2757', '<strong>Lower shelf.</strong> At ' + fmtT(T) + '&deg;' +
            (unitSystem === 'imperial' ? 'F' : 'C') + ' you are ' + Math.round(Math.abs(margin)) +
            '&deg;C below the ' + mat.DBTT + '&deg;C DBTT. Expect cleavage fracture and near-minimum energy &mdash; ' +
            'this is the Liberty Ship failure regime.');
      } else if (margin > mat.transWidth) {
        add('ci-good', '\u2705', '<strong>Upper shelf.</strong> ' + Math.round(margin) + '&deg;C above the ' +
            mat.DBTT + '&deg;C DBTT, so fracture is fully ductile and energy is near the ' +
            mat.upperShelf + ' J upper shelf.');
      } else {
        add('ci-warn', '\u26A0\uFE0F', '<strong>Transition zone.</strong> Within &plusmn;' + mat.transWidth +
            '&deg;C of the ' + mat.DBTT + '&deg;C DBTT, scatter between nominally identical specimens is at its ' +
            'worst. ASTM E23 requires three specimens per temperature here, not one.');
      }
    }

    /* Notch effect */
    var nf = NOTCH_TYPES[state.notch];
    if (state.notch === 'V-notch') {
      add('ci-info', '\uD83D\uDD2C', '<strong>V-notch (ASTM E23 Type A).</strong> 0.25 mm root radius gives the ' +
          'sharpest stress concentration, so it reads the lowest energy and is the most sensitive to ' +
          'toughness differences. Switch to U-notch to see energy rise on the same material.');
    } else {
      add('ci-info', '\uD83D\uDD2C', '<strong>' + state.notch + ' (' + nf.depth + ' mm deep, r = ' + nf.radius +
          ' mm).</strong> The blunter root relieves crack-tip constraint, so a ductile specimen absorbs about ' +
          Math.round((nf.eFactor - 1) * 100) + '% more energy than the same material V-notched. The gain ' +
          'disappears once the fracture turns brittle.');
    }

    /* Method */
    if (state.method === 'izod') {
      add('ci-info', '\uD83D\uDCD0', '<strong>Izod.</strong> The specimen is a clamped cantilever struck on the ' +
          'notched face, so values read roughly ' + Math.round((1 - IZOD_METHOD_FACTOR) * 100) +
          '% below Charpy for the same material. Never compare an Izod number with a Charpy number directly.');
    }

    /* Code thresholds \u2014 only meaningful on the Charpy V-notch basis they are
       written against. */
    var pred = predictEnergy(mat, T);
    if (!isVCharpy()) {
      add('ci-info', '\uD83D\uDCCB', '<strong>Expect about ' + fmtE(pred) + ' ' + uLabel('energy') +
          '</strong> on this ' + basisLabel() + ' basis. Code minima (18&ndash;27 J ASME, 40 J ' +
          'sub-Arctic pipeline) are written for Charpy V-notch and cannot be applied to this ' +
          'reading directly.');
    } else if (pred < 27) {
      add('ci-warn', '\uD83D\uDCCB', '<strong>Below common code minima.</strong> About ' + fmtE(pred) + ' ' +
          uLabel('energy') + ' expected here. ASME pressure-vessel practice looks for 18&ndash;27 J at the ' +
          'lowest service temperature; sub-Arctic pipeline steel is often specified at 40 J.');
    } else {
      add('ci-good', '\uD83D\uDCCB', '<strong>Meets typical code minima.</strong> About ' + fmtE(pred) + ' ' +
          uLabel('energy') + ' expected &mdash; above the 18&ndash;27 J ASME range for service at this temperature.');
    }

    /* Capacity */
    if (pred > capacityLimit()) {
      add('ci-warn', '\u2699\uFE0F', '<strong>Near machine capacity.</strong> Expected energy exceeds 80% of the ' +
          fmtE(machineCapacity(), 0) + ' ' + uLabel('energy') + ' pendulum. ASTM E23 treats results in this ' +
          'range as indicative only.');
    }

    var html = '<ul class="coach-list">';
    items.forEach(function (it) {
      html += '<li class="coach-item ' + it.cls + '"><span class="coach-ico">' + it.ico + '</span><span>' +
              it.text + '</span></li>';
    });
    html += '</ul>';
    if (html !== _learnCache.coach) { el.innerHTML = html; _learnCache.coach = html; }
  }

  function updateHistoryPanel() {
    var el = $('lp-hist-body'); if (!el) return;
    var html;
    if (!state.testPoints.length) {
      html = '<p class="hist-empty">No tests recorded yet. Run the same material at several ' +
             'temperatures &mdash; for example \u2212100, \u221250, 0, +23 and +100 &deg;C &mdash; and each ' +
             'result is plotted on the DBTT curve.</p>';
    } else {
      html = '<table class="hist-table"><thead><tr><th>#</th><th>Temp (' + uLabel('temp') +
             ')</th><th>Energy (' + uLabel('energy') + ')</th><th>Material</th></tr></thead><tbody>';
      for (var i = 0; i < state.testPoints.length; i++) {
        var p = state.testPoints[i];
        html += '<tr><td>' + (i + 1) + '</td><td>' + fmtT(p.T) + '</td><td>' + fmtE(p.E) +
                '</td><td>' + (p.mat || '') + '</td></tr>';
      }
      html += '</tbody></table><div class="hist-actions">' +
              '<button type="button" class="hist-clear" id="hist-clear">Clear history</button></div>';
    }
    if (html !== _learnCache.hist) {
      el.innerHTML = html;
      _learnCache.hist = html;
      var cb = $('hist-clear');
      if (cb) cb.addEventListener('click', function () {
        state.testPoints = [];
        updateHistoryPanel();
        drawGraph();
      });
    }
  }

  (function wireLearnPanels() {
    var expAll = $('learn-expand-all'), colAll = $('learn-collapse-all');
    var cards = Array.prototype.slice.call(document.querySelectorAll('.learn-card'));
    if (expAll) expAll.addEventListener('click', function () {
      cards.forEach(function (c) { c.open = true; });
    });
    if (colAll) colAll.addEventListener('click', function () {
      cards.forEach(function (c) { c.open = false; });
    });
  })();

  /* ================================================================
     S20 — INIT
     ================================================================ */
  initCanvases();
  canvasReady = true;
  buildLabSteps();
  buildMaterialTabs();
  buildPresets();
  buildSizeAndCond();
  buildCatTabs();
  syncTempDisplay();
  syncAlphaDisplay();
  updateLearnPanels();
  drawMachine();
  drawGraph();
  updateBadges();
  refreshUnits();
  /* Layout settles after ads/fonts land — re-measure once more. */
  requestAnimationFrame(function () { resizeCanvases(); });
  scheduleResize();

})();
