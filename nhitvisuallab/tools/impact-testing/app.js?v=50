  /* Explore: Impact Energy diagram */
  function drawExploreImpactEnergy(cx, cy) {
    var px = cx - 60, py = 60;
    /* Pivot */
    eCtx.fillStyle = '#90a4ae';
    eCtx.beginPath(); eCtx.arc(px, py, 6, 0, Math.PI * 2); eCtx.fill();
    /* Pendulum at alpha */
    var alpha = degToRad(140);
    var R = 180;
    var ax = px + R * Math.sin(-alpha), ay = py + R * Math.cos(-alpha);
    eCtx.strokeStyle = 'rgba(255,61,0,0.4)'; eCtx.lineWidth = 2;
    eCtx.beginPath(); eCtx.moveTo(px, py); eCtx.lineTo(ax, ay); eCtx.stroke();
    eCtx.fillStyle = '#ff3d00';
    eCtx.beginPath(); eCtx.arc(ax, ay, 8, 0, Math.PI * 2); eCtx.fill();
    /* Pendulum at beta */
    var beta = degToRad(60);
    var bx = px + R * Math.sin(beta), by = py + R * Math.cos(beta);
    eCtx.strokeStyle = 'rgba(61,220,132,0.4)'; eCtx.lineWidth = 2;
    eCtx.beginPath(); eCtx.moveTo(px, py); eCtx.lineTo(bx, by); eCtx.stroke();
    eCtx.fillStyle = '#3ddc84';
    eCtx.beginPath(); eCtx.arc(bx, by, 8, 0, Math.PI * 2); eCtx.fill();
    /* Arc */
    eCtx.strokeStyle = 'rgba(200,215,240,0.2)'; eCtx.lineWidth = 1;
    eCtx.beginPath(); eCtx.arc(px, py, R, Math.PI / 2 - alpha, Math.PI / 2 + beta); eCtx.stroke();
    /* Height lines */
    eCtx.strokeStyle = '#ffb74d'; eCtx.lineWidth = 1; eCtx.setLineDash([4, 4]);
    var impactY = py + R;
    eCtx.beginPath(); eCtx.moveTo(ax, ay); eCtx.lineTo(ax, impactY); eCtx.stroke();
    eCtx.beginPath(); eCtx.moveTo(bx, by); eCtx.lineTo(bx, impactY); eCtx.stroke();
    eCtx.setLineDash([]);
    /* h1, h2 labels */
