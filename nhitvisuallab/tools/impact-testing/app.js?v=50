    /* Labels */
    eCtx.fillStyle = '#ff3d00'; eCtx.font = 'bold 12px "Segoe UI", system-ui, sans-serif'; eCtx.textAlign = 'center';
    eCtx.fillText('ISO 180 \u2014 Izod for Plastics', cx, 50);
    eCtx.fillStyle = '#dde3f0'; eCtx.font = '10px "Segoe UI", system-ui, sans-serif';
