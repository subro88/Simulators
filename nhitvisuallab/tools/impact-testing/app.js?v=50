  function genProblems() {
    var pool = [];

    /* 1. Impact energy from angles */
    pool.push(function () {
      var m = randFloat(20, 30);
      var R = randFloat(0.7, 0.9);
      var alpha = randInt(140, 160);
      var beta = randInt(30, 120);
      var ans = m * 9.81 * R * (Math.cos(degToRad(beta)) - Math.cos(degToRad(alpha)));
      return {
        prompt: 'A Charpy pendulum has mass m = ' + roundN(m, 1) + ' kg and arm length R = ' + roundN(R, 2) + ' m. It is released from \u03b1 = ' + alpha + '\u00b0 and swings through to \u03b2 = ' + beta + '\u00b0 after breaking the specimen. Calculate the absorbed energy.',
        answer: roundN(ans, 1), unit: 'J', tol: 2,
        solution: [
          '<strong>Formula:</strong> E = mgR(cos\u03b2 \u2212 cos\u03b1)',
          '<strong>cos ' + alpha + '\u00b0</strong> = ' + roundN(Math.cos(degToRad(alpha)), 4),
          '<strong>cos ' + beta + '\u00b0</strong> = ' + roundN(Math.cos(degToRad(beta)), 4),
          '<strong>E</strong> = ' + roundN(m, 1) + ' \u00d7 9.81 \u00d7 ' + roundN(R, 2) + ' \u00d7 (' + roundN(Math.cos(degToRad(beta)), 4) + ' \u2212 (' + roundN(Math.cos(degToRad(alpha)), 4) + '))',
          '<strong>E = ' + roundN(ans, 1) + ' J</strong>'
        ]
      };
    });

    /* 2. Impact velocity */
    pool.push(function () {
      var alpha = randInt(130, 160);
      var R = randFloat(0.7, 0.9);
      var ans = Math.sqrt(2 * 9.81 * R * (1 - Math.cos(degToRad(alpha))));
      return {
        prompt: 'A pendulum with arm length R = ' + roundN(R, 2) + ' m is released from \u03b1 = ' + alpha + '\u00b0. Calculate the impact velocity at the bottom of the swing.',
        answer: roundN(ans, 2), unit: 'm/s', tol: 0.1,
        solution: [
          '<strong>Formula:</strong> v = \u221a(2gR(1 \u2212 cos\u03b1))',
          '<strong>cos ' + alpha + '\u00b0</strong> = ' + roundN(Math.cos(degToRad(alpha)), 4),
          '<strong>v</strong> = \u221a(2 \u00d7 9.81 \u00d7 ' + roundN(R, 2) + ' \u00d7 (1 \u2212 (' + roundN(Math.cos(degToRad(alpha)), 4) + ')))',
          '<strong>v</strong> = \u221a(' + roundN(2 * 9.81 * R * (1 - Math.cos(degToRad(alpha))), 3) + ')',
          '<strong>v = ' + roundN(ans, 2) + ' m/s</strong>'
        ]
      };
    });

    /* 3. Impact toughness */
    pool.push(function () {
      var energy = randInt(20, 200);
      var depth = [2, 5, 2.5][randInt(0, 2)];
      var netW = 10 - depth;
      var area = netW * 10 / 100;
      var ans = energy / area;
      return {
        prompt: 'A Charpy V-notch test gives absorbed energy E = ' + energy + ' J. The specimen is 10\u00d710 mm with a notch depth of ' + depth + ' mm. Calculate the impact toughness.',
        answer: roundN(ans, 1), unit: 'J/cm\u00b2', tol: 2,
        solution: [
          '<strong>Net width</strong> = 10 \u2212 ' + depth + ' = ' + netW + ' mm',
          '<strong>Net area</strong> = ' + netW + ' \u00d7 10 = ' + (netW * 10) + ' mm\u00b2 = ' + roundN(area, 2) + ' cm\u00b2',
          '<strong>Impact toughness</strong> = ' + energy + ' / ' + roundN(area, 2),
          '<strong>= ' + roundN(ans, 1) + ' J/cm\u00b2</strong>'
        ]
      };
    });

    /* 4. % shear fracture area */
    pool.push(function () {
      var totalW = 10, totalH = randInt(8, 10);
      var brittleW = randInt(3, 8);
      var brittleH = randInt(4, totalH - 1);
      var totalA = totalW * totalH;
      var brittleA = brittleW * brittleH;
      var shearA = totalA - brittleA;
      var ans = (shearA / totalA) * 100;
      return {
        prompt: 'A fracture surface of a 10\u00d7' + totalH + ' mm (net) Charpy specimen has a brittle zone measuring ' + brittleW + '\u00d7' + brittleH + ' mm in the center. Calculate the % shear fracture area.',
        answer: roundN(ans, 1), unit: '%', tol: 2,
        solution: [
          '<strong>Total area</strong> = 10 \u00d7 ' + totalH + ' = ' + totalA + ' mm\u00b2',
          '<strong>Brittle area</strong> = ' + brittleW + ' \u00d7 ' + brittleH + ' = ' + brittleA + ' mm\u00b2',
          '<strong>Shear area</strong> = ' + totalA + ' \u2212 ' + brittleA + ' = ' + shearA + ' mm\u00b2',
          '<strong>%Shear</strong> = (' + shearA + '/' + totalA + ') \u00d7 100 = <strong>' + roundN(ans, 1) + '%</strong>'
        ]
      };
    });

    /* 5. DBTT identification */
    pool.push(function () {
      var dbtt = randInt(-50, 50);
      var upper = randInt(100, 200);
      var lower = randInt(5, 15);
      var width = randInt(15, 35);
      var midE = (upper + lower) / 2;
      return {
        prompt: 'A DBTT curve for a steel has upper shelf = ' + upper + ' J, lower shelf = ' + lower + ' J. The midpoint energy (' + roundN(midE, 0) + ' J) occurs at T = ' + dbtt + '\u00b0C. What is the DBTT?',
        answer: dbtt, unit: '\u00b0C', tol: 1,
        solution: [
          '<strong>DBTT</strong> is defined as the temperature at the midpoint of the transition curve.',
          '<strong>Midpoint energy</strong> = (' + upper + ' + ' + lower + ') / 2 = ' + roundN(midE, 0) + ' J',
          '<strong>This occurs at T = ' + dbtt + '\u00b0C</strong>',
          'Therefore, <strong>DBTT = ' + dbtt + '\u00b0C</strong>'
        ]
      };
    });

    /* 6. Lateral expansion */
    pool.push(function () {
      var shearPct = randInt(10, 95);
      var maxExp = [1.5, 2.0][randInt(0, 1)];
      var type = maxExp === 1.5 ? 'polymer' : 'metal';
      var ans = shearPct / 100 * maxExp;
      return {
        prompt: 'A ' + type + ' specimen shows ' + shearPct + '% shear fracture area. Given maximum lateral expansion of ' + roundN(maxExp, 1) + ' mm at 100% ductile, estimate the lateral expansion.',
        answer: roundN(ans, 2), unit: 'mm', tol: 0.05,
        solution: [
          '<strong>Lateral expansion</strong> = (%Shear / 100) \u00d7 max expansion',
          '<strong>=</strong> (' + shearPct + '/100) \u00d7 ' + roundN(maxExp, 1),
          '<strong>= ' + roundN(ans, 2) + ' mm</strong>'
        ]
      };
    });

    /* 7. Notch sensitivity */
    pool.push(function () {
      var eV = randInt(40, 120);
      var eU = randInt(eV + 10, eV + 60);
      var ratio = eV / eU;
      return {
        prompt: 'A material absorbs ' + eV + ' J with a V-notch and ' + eU + ' J with a U-notch in Charpy testing. Calculate the notch sensitivity ratio (V/U).',
        answer: roundN(ratio, 3), unit: '\u2014', tol: 0.01,
        solution: [
          '<strong>V-notch energy</strong> = ' + eV + ' J',
          '<strong>U-notch energy</strong> = ' + eU + ' J',
          '<strong>Notch sensitivity ratio</strong> = E_V / E_U',
          '<strong>= ' + eV + ' / ' + eU + ' = ' + roundN(ratio, 3) + '</strong>',
          'A lower ratio indicates higher notch sensitivity.'
        ]
      };
    });

    /* 8. Energy loss correction */
    pool.push(function () {
      var gross = randInt(50, 250);
      var lossPct = randFloat(1, 3);
      var loss = gross * lossPct / 100;
      var net = gross - loss;
      return {
        prompt: 'A Charpy test measures gross energy of ' + gross + ' J. Friction and windage losses account for ' + roundN(lossPct, 1) + '%. Calculate the net absorbed energy.',
        answer: roundN(net, 1), unit: 'J', tol: 1,
        solution: [
          '<strong>Loss</strong> = ' + gross + ' \u00d7 ' + roundN(lossPct, 1) + '/100 = ' + roundN(loss, 1) + ' J',
          '<strong>Net energy</strong> = ' + gross + ' \u2212 ' + roundN(loss, 1),
          '<strong>= ' + roundN(net, 1) + ' J</strong>'
        ]
      };
    });

    /* 9. Upper shelf energy */
    pool.push(function () {
      var upper = randInt(80, 200);
      var lower = randInt(5, 20);
      return {
        prompt: 'A DBTT curve levels off at ' + upper + ' J above 50\u00b0C and at ' + lower + ' J below \u221280\u00b0C. What is the upper shelf energy?',
        answer: upper, unit: 'J', tol: 1,
        solution: [
          '<strong>Upper shelf</strong> = plateau energy at high temperatures',
          '<strong>= ' + upper + ' J</strong>',
          'The lower shelf energy is ' + lower + ' J.'
        ]
      };
    });

    /* 10. Temperature for 50% shear */
    pool.push(function () {
      var dbtt = randInt(-40, 40);
      return {
        prompt: 'For a material with DBTT = ' + dbtt + '\u00b0C, at what temperature does 50% shear fracture occur? (Assume symmetric sigmoid)',
        answer: dbtt, unit: '\u00b0C', tol: 1,
        solution: [
          '50% shear fracture corresponds to the midpoint of the transition curve.',
          'By definition, <strong>DBTT = ' + dbtt + '\u00b0C</strong> is where 50% occurs.',
          'At DBTT, tanh(0) = 0, so %Shear = 50%.'
        ]
      };
    });

    /* 11. Net cross-section area */
    pool.push(function () {
      var w = 10, h = 10;
      var notchNames = ['V-notch', 'U-notch', 'Keyhole'];
      var depths = [2, 5, 2.5];
      var idx = randInt(0, 2);
      var depth = depths[idx];
      var netW = w - depth;
      var area = netW * h;
      return {
        prompt: 'Calculate the net cross-sectional area behind a ' + notchNames[idx] + ' (' + depth + ' mm deep) in a standard 10\u00d710 mm Charpy specimen.',
        answer: area, unit: 'mm\u00b2', tol: 1,
        solution: [
          '<strong>Specimen</strong> = ' + w + '\u00d7' + h + ' mm',
          '<strong>Notch depth</strong> = ' + depth + ' mm',
          '<strong>Net width</strong> = ' + w + ' \u2212 ' + depth + ' = ' + netW + ' mm',
          '<strong>Net area</strong> = ' + netW + ' \u00d7 ' + h + ' = <strong>' + area + ' mm\u00b2</strong>'
        ]
      };
    });

    /* 12. Beta angle from energy */
    pool.push(function () {
      var m = 27.2, R = 0.8, alpha = 150;
      var energy = randInt(30, 250);
      var beta = calcBetaAngle(alpha, energy);
      return {
        prompt: 'A standard Charpy machine (m=27.2 kg, R=0.8 m, \u03b1=150\u00b0) absorbs ' + energy + ' J during fracture. Calculate the swing-through angle \u03b2.',
        answer: roundN(beta, 1), unit: '\u00b0', tol: 2,
        solution: [
          '<strong>Total energy</strong> = mgR(1\u2212cos\u03b1) = 27.2\u00d79.81\u00d70.8\u00d7(1\u2212cos150\u00b0)',
          '<strong>= ' + roundN(PEND_MASS * GRAVITY * PEND_R * (1 - Math.cos(degToRad(150))), 1) + ' J</strong>',
          '<strong>Remaining</strong> = ' + roundN(PEND_MASS * GRAVITY * PEND_R * (1 - Math.cos(degToRad(150))) - energy, 1) + ' J',
          '<strong>cos\u03b2</strong> = 1 \u2212 remaining/(mgR)',
          '<strong>\u03b2 = ' + roundN(beta, 1) + '\u00b0</strong>'
        ]
      };
    });

    return pool;
  }
  var PROBLEM_POOL = genProblems();

