  function applyPreset(p) {
    var mi = -1;
    for (var i = 0; i < MATERIALS.length; i++) if (MATERIALS[i].id === p.mat) { mi = i; break; }
    if (mi < 0) return;

    /* Changing material invalidates the DBTT points already plotted;
       staying on the same material (e.g. the U-notch comparison) keeps them. */
    if (state.matIdx !== mi) state.testPoints = [];

    resetTest();
    state.matIdx = mi;
    state.notch = p.notch;
    state.method = p.method;
    /* Presets are full-size, in-tolerance scenarios. */
    state.specWidth = FULL_WIDTH;
    state.notchCond = 'to-spec';
    if (elSizeSelect) elSizeSelect.value = String(FULL_WIDTH);
    if (elCondSelect) elCondSelect.value = 'to-spec';
    syncCondNote();
    state.temperature = clamp(p.T, TEMP_MIN, TEMP_MAX);

    /* Mirror into every control that shows one of these values. */
    if (elMatSelect) elMatSelect.value = String(mi);
    if (elNotchSelect) elNotchSelect.value = p.notch;
    syncPillGroup('method-tabs', 'method', p.method);
    syncTempDisplay();

    activePreset = p.id;
    if (elPresetSelect) elPresetSelect.value = p.id;

    advanceStep(3);
    updateLearnPanels();
    drawMachine();
    drawGraph();
  }

