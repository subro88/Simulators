  };

  /* ASTM E23 standard sub-size Charpy specimens. Only the struck THICKNESS is
     reduced; length and the 10 mm notched face stay full size. Used whenever the
     stock is too thin for a full specimen — thin plate, tube wall, weld HAZ.
     Absorbed energy scales roughly with the remaining ligament AREA, and code
     acceptance criteria scale with it too (a 2/3-size specimen is held to 2/3 of
     the full-size requirement) — the single most misapplied point in Charpy
     acceptance testing. */
  var SPEC_SIZES = [
    { w: 10,  label: 'Full size — 10 mm',  frac: '1'   },
    { w: 7.5, label: '3/4 size — 7.5 mm',  frac: '3/4' },
    { w: 6.7, label: '2/3 size — 6.7 mm',  frac: '2/3' },
    { w: 5,   label: '1/2 size — 5 mm',    frac: '1/2' },
    { w: 3.3, label: '1/3 size — 3.3 mm',  frac: '1/3' },
    { w: 2.5, label: '1/4 size — 2.5 mm',  frac: '1/4' }
  ];
