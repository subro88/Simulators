  /* Explore: Ductile Fracture */
  function drawExploreDuctileFrac(cx, cy) {
    /* Fracture surface cross-section */
    var sx = cx, sy = cy, sw = 140, sh = 100;
    eCtx.strokeStyle = 'rgba(200,215,240,0.3)'; eCtx.lineWidth = 1;
    eCtx.strokeRect(sx - sw / 2, sy - sh / 2, sw, sh);
    /* Fibrous center */
    eCtx.fillStyle = '#8d6e63';
    eCtx.fillRect(sx - sw / 2, sy - sh / 2, sw, sh);
    /* Wavy lines */
    eCtx.strokeStyle = 'rgba(255,200,150,0.5)'; eCtx.lineWidth = 0.8;
    for (var wi = 0; wi < 12; wi++) {
      var wy = sy - sh / 2 + 6 + wi * 8;
      eCtx.beginPath();
      for (var wx = sx - sw / 2; wx < sx + sw / 2; wx += 2) {
        var yOff = Math.sin(wx * 0.3 + wi * 1.5) * 2;
        if (wx === sx - sw / 2) eCtx.moveTo(wx, wy + yOff); else eCtx.lineTo(wx, wy + yOff);
      }
      eCtx.stroke();
    }
    /* Shear lips */
    eCtx.fillStyle = 'rgba(255,160,100,0.5)';
    eCtx.beginPath();
    eCtx.moveTo(sx - sw / 2, sy - sh / 2); eCtx.lineTo(sx - sw / 2 + 15, sy - sh / 2 + 10);
    eCtx.lineTo(sx - sw / 2 + 15, sy + sh / 2 - 10); eCtx.lineTo(sx - sw / 2, sy + sh / 2); eCtx.closePath(); eCtx.fill();
    eCtx.beginPath();
    eCtx.moveTo(sx + sw / 2, sy - sh / 2); eCtx.lineTo(sx + sw / 2 - 15, sy - sh / 2 + 10);
    eCtx.lineTo(sx + sw / 2 - 15, sy + sh / 2 - 10); eCtx.lineTo(sx + sw / 2, sy + sh / 2); eCtx.closePath(); eCtx.fill();
    /* Labels */
    eCtx.fillStyle = '#dde3f0'; eCtx.font = '600 11px "Segoe UI", system-ui, sans-serif'; eCtx.textAlign = 'left';
    eCtx.fillText('Fibrous center (MVC)', sx + sw / 2 + 20, sy - 15);
    eCtx.fillText('Shear lips (45\u00b0)', sx + sw / 2 + 20, sy + 5);
    eCtx.fillText('High energy absorption', sx + sw / 2 + 20, sy + 25);
    /* Annotation lines */
    eCtx.strokeStyle = '#8b9dc3'; eCtx.lineWidth = 0.8; eCtx.setLineDash([3, 3]);
    eCtx.beginPath(); eCtx.moveTo(sx + 10, sy); eCtx.lineTo(sx + sw / 2 + 18, sy - 15); eCtx.stroke();
    eCtx.beginPath(); eCtx.moveTo(sx - sw / 2 + 8, sy); eCtx.lineTo(sx + sw / 2 + 18, sy + 5); eCtx.stroke();
    eCtx.setLineDash([]);
    eCtx.fillStyle = '#ff3d00'; eCtx.font = 'bold 12px "Segoe UI", system-ui, sans-serif'; eCtx.textAlign = 'center';
    eCtx.fillText('Ductile Fracture Surface', cx, 40);
    drawExploreTitleLabel('Ductile Fracture (%Shear \u2265 80%)');
  }

  /* Explore: Brittle Fracture */
  function drawExploreBrittleFrac(cx, cy) {
    var sx = cx, sy = cy, sw = 140, sh = 100;
    eCtx.strokeStyle = 'rgba(200,215,240,0.3)'; eCtx.lineWidth = 1;
    eCtx.strokeRect(sx - sw / 2, sy - sh / 2, sw, sh);
    /* Granular base */
    eCtx.fillStyle = '#78909c';
    eCtx.fillRect(sx - sw / 2, sy - sh / 2, sw, sh);
    /* Stippled dots */
    eCtx.fillStyle = 'rgba(200,215,240,0.35)';
    for (var di = 0; di < 200; di++) {
      var dx = sx - sw / 2 + 2 + Math.random() * (sw - 4);
      var dy = sy - sh / 2 + 2 + Math.random() * (sh - 4);
      eCtx.fillRect(dx, dy, 1.5, 1.5);
    }
    /* Cleavage lines radiating from origin */
    eCtx.strokeStyle = 'rgba(200,215,240,0.25)'; eCtx.lineWidth = 0.6;
    var origin = { x: sx - 20, y: sy - 10 };
    for (var ci = 0; ci < 12; ci++) {
      var angle = (ci / 12) * Math.PI * 2;
      var len = 40 + Math.random() * 30;
      eCtx.beginPath();
      eCtx.moveTo(origin.x, origin.y);
      eCtx.lineTo(origin.x + len * Math.cos(angle), origin.y + len * Math.sin(angle));
      eCtx.stroke();
    }
    /* Chevron marks */
    eCtx.strokeStyle = 'rgba(255,85,85,0.4)'; eCtx.lineWidth = 1;
    eCtx.beginPath(); eCtx.moveTo(origin.x - 5, origin.y - 5); eCtx.lineTo(origin.x, origin.y); eCtx.lineTo(origin.x - 5, origin.y + 5); eCtx.stroke();
    /* Origin marker */
    eCtx.fillStyle = '#ff5555';
    eCtx.beginPath(); eCtx.arc(origin.x, origin.y, 3, 0, Math.PI * 2); eCtx.fill();
    /* Labels */
    eCtx.fillStyle = '#dde3f0'; eCtx.font = '600 11px "Segoe UI", system-ui, sans-serif'; eCtx.textAlign = 'left';
    eCtx.fillText('Granular/crystalline texture', sx + sw / 2 + 20, sy - 20);
    eCtx.fillText('Cleavage lines', sx + sw / 2 + 20, sy);
    eCtx.fillText('Chevron marks \u2192 origin', sx + sw / 2 + 20, sy + 20);
    eCtx.fillText('Low energy, flat surface', sx + sw / 2 + 20, sy + 40);
    eCtx.fillStyle = '#ff3d00'; eCtx.font = 'bold 12px "Segoe UI", system-ui, sans-serif'; eCtx.textAlign = 'center';
    eCtx.fillText('Brittle Fracture Surface', cx, 40);
    drawExploreTitleLabel('Brittle Fracture (%Shear \u2264 20%)');
  }

  /* Explore: Mixed Fracture */
  function drawExploreMixedFrac(cx, cy) {
    var sx = cx, sy = cy, sw = 140, sh = 100;
    eCtx.strokeStyle = 'rgba(200,215,240,0.3)'; eCtx.lineWidth = 1;
    eCtx.strokeRect(sx - sw / 2, sy - sh / 2, sw, sh);
    /* Inner cleavage zone */
    var innerW = sw * 0.5, innerH = sh * 0.6;
    eCtx.fillStyle = '#78909c';
    eCtx.fillRect(sx - innerW / 2, sy - innerH / 2, innerW, innerH);
    /* Stipple in center */
    eCtx.fillStyle = 'rgba(200,215,240,0.2)';
    for (var di = 0; di < 50; di++) {
      eCtx.fillRect(sx - innerW / 2 + Math.random() * innerW, sy - innerH / 2 + Math.random() * innerH, 1.2, 1.2);
    }
    /* Outer shear zone */
    eCtx.fillStyle = '#8d6e63';
    /* Top strip */
    eCtx.fillRect(sx - sw / 2, sy - sh / 2, sw, (sh - innerH) / 2);
    /* Bottom strip */
    eCtx.fillRect(sx - sw / 2, sy + innerH / 2, sw, (sh - innerH) / 2);
    /* Left strip */
    eCtx.fillRect(sx - sw / 2, sy - sh / 2, (sw - innerW) / 2, sh);
    /* Right strip */
    eCtx.fillRect(sx + innerW / 2, sy - sh / 2, (sw - innerW) / 2, sh);
    /* Measurement grid overlay */
    eCtx.strokeStyle = 'rgba(255,183,77,0.3)'; eCtx.lineWidth = 0.4;
    for (var gxi = 0; gxi < 5; gxi++) {
      var x = sx - sw / 2 + gxi * sw / 4;
      eCtx.beginPath(); eCtx.moveTo(x, sy - sh / 2); eCtx.lineTo(x, sy + sh / 2); eCtx.stroke();
    }
    for (var gyi = 0; gyi < 5; gyi++) {
      var y = sy - sh / 2 + gyi * sh / 4;
      eCtx.beginPath(); eCtx.moveTo(sx - sw / 2, y); eCtx.lineTo(sx + sw / 2, y); eCtx.stroke();
    }
    /* Labels */
    eCtx.fillStyle = '#dde3f0'; eCtx.font = '600 11px "Segoe UI", system-ui, sans-serif'; eCtx.textAlign = 'left';
    eCtx.fillText('Outer: Shear (ductile)', sx + sw / 2 + 20, sy - 15);
    eCtx.fillText('Inner: Cleavage (brittle)', sx + sw / 2 + 20, sy + 5);
    eCtx.fillText('%Shear = shear area / total \u00d7 100', sx + sw / 2 + 20, sy + 30);
    eCtx.fillStyle = '#ff3d00'; eCtx.font = 'bold 12px "Segoe UI", system-ui, sans-serif'; eCtx.textAlign = 'center';
    eCtx.fillText('Mixed-Mode Fracture Surface', cx, 40);
    drawExploreTitleLabel('Mixed Fracture (20% < %Shear < 80%)');
  }

  /* ================================================================
     S16 — PRACTICE MODE
     ================================================================ */
  function newPractice() {
    var gen = PROBLEM_POOL[randInt(0, PROBLEM_POOL.length - 1)];
    state.pProb = gen();
    state.pDone = false;
    if (elPPPrompt) elPPPrompt.textContent = state.pProb.prompt;
    if (elPPInput) { elPPInput.value = ''; elPPInput.disabled = false; }
    if (elPPUnit) elPPUnit.textContent = state.pProb.unit;
    if (elPracFeed) { elPracFeed.textContent = ''; elPracFeed.className = 'feedback'; }
    hide(elSolPanel);
  }

  function checkPractice() {
    if (!state.pProb || state.pDone) return;
    var val = parseFloat(elPPInput.value);
    if (isNaN(val)) { if (elPracFeed) { elPracFeed.textContent = 'Please enter a number.'; elPracFeed.className = 'feedback err'; } return; }

    state.pDone = true;
    state.pTotal++;
    var diff = Math.abs(val - state.pProb.answer);
    if (diff <= state.pProb.tol) {
      state.pScore++;
      if (elPracFeed) { elPracFeed.innerHTML = '<strong>Correct!</strong> Answer: ' + state.pProb.answer + ' ' + state.pProb.unit; elPracFeed.className = 'feedback ok'; }
    } else {
      if (elPracFeed) { elPracFeed.innerHTML = '<strong>Incorrect.</strong> Your answer: ' + val + ', Correct: ' + state.pProb.answer + ' ' + state.pProb.unit; elPracFeed.className = 'feedback err'; }
    }
    if (elPPInput) elPPInput.disabled = true;
    showSolution();
    if (elPScore) elPScore.textContent = state.pScore;
    if (elPTotal) elPTotal.textContent = state.pTotal;
  }

  function showSolution() {
    if (!state.pProb || !state.pProb.solution) return;
    if (elSolPanel) {
      var html = '<div class="sol-title">Solution</div>';
      state.pProb.solution.forEach(function (s) { html += '<div class="sol-step">' + s + '</div>'; });
      elSolPanel.innerHTML = html;
      show(elSolPanel);
    }
  }

  function showSolBtn() {
    if (!state.pProb) return;
    state.pDone = true;
    if (elPPInput) elPPInput.disabled = true;
    showSolution();
  }

  /* ================================================================
     S17 — QUIZ MODE
     ================================================================ */
  function startQuiz() {
    state.qSet = shuffleArr(QUIZ_POOL).slice(0, 5);
    state.qIdx = 0;
    state.qScore = 0;
    state.qDone = false;
    state.qResults = [];
    hide(elQuizResult);
    show(elQuizPanel);
    if (elQTotal) elQTotal.textContent = '5';
    showQuestion();
  }

  function showQuestion() {
    var q = state.qSet[state.qIdx];
    if (!q) return;
    state.qAnswered = false;
    if (elQNum) elQNum.textContent = (state.qIdx + 1) + '';
    if (elQPPrompt) elQPPrompt.textContent = q.prompt;
    if (elQuizFeed) { elQuizFeed.textContent = ''; elQuizFeed.className = 'feedback'; }
    hide(elBtnQuizNext);
    if (elQuizAnswers) elQuizAnswers.innerHTML = '';

    if (q.type === 'mcq') {
      q.choices.forEach(function (ch, ci) {
        var btn = document.createElement('button');
        btn.className = 'answer-btn';
        btn.textContent = ch;
        btn.addEventListener('click', function () { handleMCQ(ci); });
        elQuizAnswers.appendChild(btn);
      });
    } else {
      var row = document.createElement('div');
      row.className = 'pp-input-row';
      row.innerHTML = '<input type="number" step="any" class="qi-input" id="qi-val" placeholder="Your answer"> <span class="pp-unit">' + q.unit + '</span> <button class="btn primary" id="qi-sub">Submit</button>';
      elQuizAnswers.appendChild(row);
      var subBtn = $('qi-sub');
      if (subBtn) subBtn.addEventListener('click', handleNumeric);
    }
  }

  function handleMCQ(chosenIdx) {
    if (state.qAnswered) return;
    state.qAnswered = true;
    var q = state.qSet[state.qIdx];
    var btns = elQuizAnswers.querySelectorAll('.answer-btn');
    for (var bi = 0; bi < btns.length; bi++) {
      btns[bi].classList.add('locked');
      if (bi === q.correct) btns[bi].classList.add('correct');
      if (bi === chosenIdx && bi !== q.correct) btns[bi].classList.add('wrong');
    }
    var isCorrect = chosenIdx === q.correct;
    if (isCorrect) { state.qScore++; }
    state.qResults.push({ q: q.prompt, correct: isCorrect, answer: q.choices[q.correct] });
    if (elQuizFeed) {
      elQuizFeed.textContent = isCorrect ? 'Correct!' : 'Incorrect. Answer: ' + q.choices[q.correct];
      elQuizFeed.className = 'feedback ' + (isCorrect ? 'ok' : 'err');
    }
    show(elBtnQuizNext);
  }

  function handleNumeric() {
    if (state.qAnswered) return;
    state.qAnswered = true;
    var q = state.qSet[state.qIdx];
    var inp = $('qi-val');
    var val = parseFloat(inp ? inp.value : '');
    var isCorrect = !isNaN(val) && Math.abs(val - q.answer) <= q.tol;
    if (isCorrect) state.qScore++;
    state.qResults.push({ q: q.prompt, correct: isCorrect, answer: q.answer + ' ' + q.unit });
    if (inp) inp.disabled = true;
    var sub = $('qi-sub');
    if (sub) sub.disabled = true;
    if (elQuizFeed) {
      elQuizFeed.textContent = isCorrect ? 'Correct!' : 'Incorrect. Answer: ' + q.answer + ' ' + q.unit;
      elQuizFeed.className = 'feedback ' + (isCorrect ? 'ok' : 'err');
    }
    show(elBtnQuizNext);
  }

  function advanceQuiz() {
    state.qIdx++;
    if (state.qIdx >= state.qSet.length) {
      showQuizResult();
    } else {
      showQuestion();
    }
  }

  function showQuizResult() {
    state.qDone = true;
    hide(elQuizPanel);
    show(elQuizResult);
    var pct = (state.qScore / 5) * 100;
    if (elQRScore) elQRScore.textContent = state.qScore + ' / 5';
    var stars = '', nStars = pct >= 100 ? 5 : pct >= 80 ? 4 : pct >= 60 ? 3 : pct >= 40 ? 2 : 1;
    for (var si = 0; si < 5; si++) stars += si < nStars ? '\u2605' : '\u2606';
    if (elQRStars) elQRStars.textContent = stars;
    var verdicts = ['Keep studying!', 'Room for improvement', 'Good effort!', 'Great job!', 'Perfect score!'];
    if (elQRVerdict) elQRVerdict.textContent = verdicts[nStars - 1];

    if (elQRTable) {
      var html = '';
      state.qResults.forEach(function (r, i) {
        html += '<div class="qr-row ' + (r.correct ? 'ok' : 'err') + '">';
        html += '<span class="qr-qnum">Q' + (i + 1) + '</span>';
        html += '<span class="qr-q">' + r.q.substring(0, 60) + (r.q.length > 60 ? '...' : '') + '</span>';
        html += '<span class="qr-a">' + r.answer + '</span>';
        html += '<span class="qr-mark">' + (r.correct ? '\u2713' : '\u2717') + '</span>';
        html += '</div>';
      });
      elQRTable.innerHTML = html;
    }
  }

  /* ================================================================
     S18 — EVENT HANDLERS
     ================================================================ */
  /* Mode tabs */
  var modeTabs = $('mode-tabs');
  if (modeTabs) {
    modeTabs.addEventListener('click', function (e) {
      var pill = e.target.closest('.pill');
      if (pill && pill.dataset.value) setMode(pill.dataset.value);
    });
  }

  /* Specimen size + notch condition dropdowns */
  var elSizeSelect = $('sel-size'), elCondSelect = $('sel-notchcond');

  function buildSizeAndCond() {
    if (elSizeSelect) {
      elSizeSelect.innerHTML = '';
      SPEC_SIZES.forEach(function (sz) {
        var o = document.createElement('option');
        o.value = String(sz.w); o.textContent = sz.label;
        elSizeSelect.appendChild(o);
      });
      elSizeSelect.value = String(state.specWidth);
    }
    if (elCondSelect) {
      elCondSelect.innerHTML = '';
      Object.keys(NOTCH_CONDITIONS).forEach(function (k) {
        var o = document.createElement('option');
        o.value = k; o.textContent = NOTCH_CONDITIONS[k].label;
        elCondSelect.appendChild(o);
      });
      elCondSelect.value = state.notchCond;
    }
    syncCondNote();
  }

  function syncCondNote() {
    var n = $('notchcond-note'); if (!n) return;
    var ok = state.notchCond === 'to-spec';
    n.className = 'ctrl-note ' + (ok ? 'cn-ok' : 'cn-warn');
    n.textContent = ok ? 'in tolerance' : 'invalidates test';
    n.title = ok
      ? 'Root radius and depth are inside the ASTM E23 tolerance band.'
      : 'ASTM E23 requires the notch to be within tolerance; a deviating notch biases the result high and the test must be discarded.';
  }

  if (elSizeSelect) {
    elSizeSelect.addEventListener('change', function () {
      state.specWidth = parseFloat(this.value);
      resetTest();
      clearPresetHighlight();
      updateLearnPanels();
      drawMachine(); drawGraph();
    });
