    /* Alpha arc */
    if (state.placed || state.animPhase !== 'idle') {
      mCtx.strokeStyle = hexToRGBA('#ff3d00', 0.5);
      mCtx.lineWidth = 3;
      mCtx.beginPath();
      mCtx.arc(0, 0, innerR + 8, Math.PI / 2, Math.PI / 2 - state.releaseAngle, true);
      mCtx.stroke();
      /* Alpha label */
      var aLabelRad = state.releaseAngle * 0.5;
      mCtx.fillStyle = '#ff3d00';
      mCtx.font = 'bold 10px monospace';
      mCtx.textAlign = 'center';
      mCtx.fillText('\u03b1', -(innerR + 24) * Math.sin(aLabelRad), (innerR + 24) * Math.cos(aLabelRad));
    }

    /* Beta arc (after test) */
    if (state.animPhase === 'complete' && state.finalAngle > 0) {
      var betaRad = degToRad(state.finalAngle);
      mCtx.strokeStyle = hexToRGBA('#3ddc84', 0.5);
      mCtx.lineWidth = 3;
      mCtx.beginPath();
      mCtx.arc(0, 0, innerR + 4, Math.PI / 2, Math.PI / 2 + betaRad);
      mCtx.stroke();
      /* Beta label */
      mCtx.fillStyle = '#3ddc84';
      mCtx.font = 'bold 10px monospace';
      mCtx.fillText('\u03b2', (innerR + 24) * Math.sin(betaRad * 0.5), (innerR + 24) * Math.cos(betaRad * 0.5));
    }

    mCtx.restore();
  }

  /* Drawn scale of the specimen, so anvil geometry can be stated in mm. */
  function pxPerMm() { return SPEC_DRAW_LEN / CHARPY_SPEC.length; }
  /* Isometric depth cue, shared by the specimen and the anvils so the bar sits
     on a surface rather than balancing on a flat outline. */
  function isoDepth(mm) { return 13 * (mm / FULL_WIDTH); }

  function drawAnvil() {
    var mm = pxPerMm();
    var spanPx = CHARPY_SPEC.span * mm;        /* 40 mm between the INNER faces */
    var ay = ANVIL_Y;
    var innerL = SPEC_X - spanPx / 2;
    var innerR = SPEC_X + spanPx / 2;
    var h = 34;                                 /* anvil height below the seat */
    var topW = 17;                              /* seat width outward from inner face */
    var flare = 9;                              /* outward taper (ASTM anvils relieve away) */
    var rad = Math.max(1.2, 1 * mm);            /* 1 mm radius on the striking edge */
    var dep = isoDepth(state.specWidth);        /* matches the specimen's depth cue */

    /* One anvil. dir = +1 for the right-hand block, -1 for the left. */
    function anvil(xInner, dir) {
      var xOut = xInner + dir * topW;

      /* Seat depth face — the surface the specimen actually rests on. Drawn
         first so the specimen (drawn later) sits visually on top of it. */
      mCtx.beginPath();
      mCtx.moveTo(xInner, ay);
      mCtx.lineTo(xInner + dep * 0.85, ay - dep * 0.62);
      mCtx.lineTo(xOut + dep * 0.85, ay - dep * 0.62);
      mCtx.lineTo(xOut, ay);
      mCtx.closePath();
      mCtx.fillStyle = '#8a9aa8';
      mCtx.fill();
      mCtx.strokeStyle = 'rgba(255,255,255,0.18)';
      mCtx.lineWidth = 0.7;
      mCtx.stroke();

      /* Body: vertical inner face (this is what sets the span), radiused
         striking edge at the top, relieved outward on the far side. */
      mCtx.beginPath();
      mCtx.moveTo(xInner, ay + rad);
      mCtx.quadraticCurveTo(xInner, ay, xInner + dir * rad, ay);
      mCtx.lineTo(xOut, ay);
      mCtx.lineTo(xOut + dir * flare, ay + h);
      mCtx.lineTo(xInner - dir * 2, ay + h);
      mCtx.closePath();
      mCtx.fillStyle = metalGrad(mCtx, Math.min(xInner, xOut) - 2, ay, topW + flare + 4, h, false);
      mCtx.fill();
      mCtx.strokeStyle = 'rgba(0,0,0,0.35)';
      mCtx.lineWidth = 0.8;
      mCtx.stroke();

      /* Hardened striking edge highlight along the radiused corner */
      mCtx.strokeStyle = 'rgba(255,255,255,0.5)';
      mCtx.lineWidth = 1.1;
      mCtx.beginPath();
      mCtx.moveTo(xInner, ay + rad * 2.2);
      mCtx.quadraticCurveTo(xInner, ay, xInner + dir * rad, ay);
      mCtx.stroke();

      /* Contact shadow under the seated specimen */
      mCtx.fillStyle = 'rgba(0,0,0,0.28)';
      mCtx.fillRect(Math.min(xInner, xOut), ay, topW, 1.6);
    }

    anvil(innerL, -1);
    anvil(innerR, +1);

    /* Back stops behind the specimen — one per anvil, NOT spanning the gap.
       A single bar across the whole width reads as a continuous shelf and hides
       the fact that the 40 mm span is open: it is the space the specimen bends
       into and the striker passes through. */
    function backStop(xa, xb) {
      mCtx.beginPath();
      mCtx.moveTo(xa + dep * 0.85, ay - dep * 0.62);
      mCtx.lineTo(xb + dep * 0.85, ay - dep * 0.62);
      mCtx.lineTo(xb + dep * 0.85, ay - dep * 0.62 - 7);
      mCtx.lineTo(xa + dep * 0.85, ay - dep * 0.62 - 7);
      mCtx.closePath();
      mCtx.fillStyle = 'rgba(120,144,156,0.55)';
      mCtx.fill();
      mCtx.strokeStyle = 'rgba(0,0,0,0.3)';
      mCtx.lineWidth = 0.6;
      mCtx.stroke();
    }
    backStop(innerL - topW, innerL);
    backStop(innerR, innerR + topW);

    /* Support base plate */
    mCtx.fillStyle = '#455a64';
    roundRect(mCtx, innerL - topW - flare - 12, ay + h, spanPx + 2 * (topW + flare) + 24, 8, 2);
    mCtx.fill();

    /* Riser from base */
    mCtx.fillStyle = metalGrad(mCtx, SPEC_X - 15, ay + h + 8, 30, BASE_Y - ay - h - 8, true);
    mCtx.fillRect(SPEC_X - 15, ay + h + 8, 30, BASE_Y - ay - h - 8);

  }

  function drawVice() {
    var vx = SPEC_X, vy = ANVIL_Y;
    var jawW = 30, jawH = 60;

    /* Left jaw */
    mCtx.fillStyle = metalGrad(mCtx, vx - jawW - 6, vy - jawH / 2, jawW, jawH, true);
    roundRect(mCtx, vx - jawW - 6, vy - jawH / 2, jawW, jawH, 3);
    mCtx.fill();
    /* Serrations */
    mCtx.strokeStyle = 'rgba(0,0,0,0.3)';
    mCtx.lineWidth = 0.5;
    for (var si = 0; si < 8; si++) {
      var sy = vy - jawH / 2 + 6 + si * 7;
      mCtx.beginPath(); mCtx.moveTo(vx - 8, sy); mCtx.lineTo(vx - 3, sy); mCtx.stroke();
    }

    /* Right jaw */
    mCtx.fillStyle = metalGrad(mCtx, vx + 6, vy - jawH / 2, jawW, jawH, true);
    roundRect(mCtx, vx + 6, vy - jawH / 2, jawW, jawH, 3);
    mCtx.fill();
    mCtx.strokeStyle = 'rgba(0,0,0,0.3)';
    mCtx.lineWidth = 0.5;
    for (var si2 = 0; si2 < 8; si2++) {
      var sy2 = vy - jawH / 2 + 6 + si2 * 7;
      mCtx.beginPath(); mCtx.moveTo(vx + 8, sy2); mCtx.lineTo(vx + 3 + jawW, sy2); mCtx.stroke();
    }

    /* Clamping bolts */
    mCtx.fillStyle = '#78909c';
    mCtx.beginPath(); mCtx.arc(vx - jawW - 10, vy - 10, 4, 0, Math.PI * 2); mCtx.fill();
    mCtx.beginPath(); mCtx.arc(vx - jawW - 10, vy + 10, 4, 0, Math.PI * 2); mCtx.fill();
    mCtx.fillStyle = '#546e7a';
    mCtx.beginPath(); mCtx.arc(vx - jawW - 10, vy - 10, 2, 0, Math.PI * 2); mCtx.fill();
    mCtx.beginPath(); mCtx.arc(vx - jawW - 10, vy + 10, 2, 0, Math.PI * 2); mCtx.fill();

    /* Vice base */
    mCtx.fillStyle = '#455a64';
    roundRect(mCtx, vx - jawW - 20, vy + jawH / 2, jawW * 2 + 52, 10, 2);
    mCtx.fill();

    /* Riser */
    mCtx.fillStyle = metalGrad(mCtx, vx - 15, vy + jawH / 2 + 10, 30, BASE_Y - vy - jawH / 2 - 10, true);
    mCtx.fillRect(vx - 15, vy + jawH / 2 + 10, 30, BASE_Y - vy - jawH / 2 - 10);
  }

  function drawSpecimen() {
    if (state.animPhase === 'idle' && !state.placed) return;
    var mat = MATERIALS[state.matIdx];
    var tc = temperatureColor(state.temperature);

    if (state.method === 'charpy') {
      /* Horizontal specimen */
      var sx = SPEC_X - SPEC_DRAW_LEN / 2, sy = ANVIL_Y - SPEC_DRAW_H;
      var sw = SPEC_DRAW_LEN, sh = SPEC_DRAW_H;
      /* Shadow */
      mCtx.fillStyle = 'rgba(0,0,0,0.2)';
      roundRect(mCtx, sx + 2, sy + 2, sw, sh, 1);
      mCtx.fill();
      /* Body */
      var sg = mCtx.createLinearGradient(sx, sy, sx, sy + sh);
      sg.addColorStop(0, tc);
      sg.addColorStop(0.5, hexToRGBA(mat.color, 0.9));
      sg.addColorStop(1, hexToRGBA(mat.color, 0.6));
      mCtx.fillStyle = sg;
      roundRect(mCtx, sx, sy, sw, sh, 1);
      mCtx.fill();
      /* Top face — a shallow isometric sliver whose depth is the specimen
         THICKNESS. In a pure side view thickness is the dimension into the
         screen and would be invisible, so a sub-size bar would look identical
         to a full-size one. This is the cue that makes the size control read. */
      var dep = isoDepth(state.specWidth);
      mCtx.beginPath();
      mCtx.moveTo(sx, sy);
      mCtx.lineTo(sx + dep * 0.85, sy - dep * 0.62);
      mCtx.lineTo(sx + sw + dep * 0.85, sy - dep * 0.62);
      mCtx.lineTo(sx + sw, sy);
      mCtx.closePath();
      mCtx.fillStyle = hexToRGBA(mat.color, 0.5);
      mCtx.fill();
      mCtx.strokeStyle = 'rgba(255,255,255,0.16)';
      mCtx.lineWidth = 0.7;
      mCtx.stroke();
      /* End face, so the thickness reads as a solid bar rather than a flap */
      mCtx.beginPath();
      mCtx.moveTo(sx + sw, sy);
      mCtx.lineTo(sx + sw + dep * 0.85, sy - dep * 0.62);
      mCtx.lineTo(sx + sw + dep * 0.85, sy + sh - dep * 0.62);
      mCtx.lineTo(sx + sw, sy + sh);
      mCtx.closePath();
      mCtx.fillStyle = hexToRGBA(mat.color, 0.32);
      mCtx.fill();
      mCtx.stroke();

      /* Highlight */
      mCtx.strokeStyle = 'rgba(255,255,255,0.15)';
      mCtx.lineWidth = 0.8;
      mCtx.beginPath(); mCtx.moveTo(sx + 2, sy + 1); mCtx.lineTo(sx + sw - 2, sy + 1); mCtx.stroke();
      /* Notch — Charpy is struck on the face OPPOSITE the notch. The hammer
         descends onto the top face, so the notch is cut into the bottom face
         (the tension side, where the crack opens). */
      drawNotchOnSpecimen(SPEC_X, sy, sh);
    } else {
      /* Vertical specimen (Izod) */
      var sx2 = SPEC_X - 5, sy2 = ANVIL_Y - 55, sw2 = 10, sh2 = 65;
      mCtx.fillStyle = 'rgba(0,0,0,0.2)';
      roundRect(mCtx, sx2 + 2, sy2 + 2, sw2, sh2, 1);
      mCtx.fill();
      var sg2 = mCtx.createLinearGradient(sx2, sy2, sx2 + sw2, sy2);
      sg2.addColorStop(0, tc);
      sg2.addColorStop(0.5, hexToRGBA(mat.color, 0.9));
      sg2.addColorStop(1, hexToRGBA(mat.color, 0.6));
      mCtx.fillStyle = sg2;
      roundRect(mCtx, sx2, sy2, sw2, sh2, 1);
      mCtx.fill();
      mCtx.strokeStyle = 'rgba(255,255,255,0.15)';
      mCtx.lineWidth = 0.8;
      mCtx.beginPath(); mCtx.moveTo(sx2 + 1, sy2 + 2); mCtx.lineTo(sx2 + 1, sy2 + sh2 - 2); mCtx.stroke();
      /* Notch — Izod is struck on the SAME face as the notch. The pendulum is
         latched to the right and swings right-to-left, so the notch faces
         right, level with the top of the vice jaws (ANVIL_Y - jawH/2). */
      drawNotchOnSpecimenIzod(sx2 + sw2, ANVIL_Y - 30, sw2);
    }
  }

  /* Notch depth in canvas pixels.
     The specimen's 10 mm cross-section is drawn `dim` px across, so the true
     scale is dim/10 px per mm. A 1.4x exaggeration keeps the shallow 2 mm
     V-notch legible, and the 0.7*dim cap guarantees a notch can never sever the
     bar — `depth * 2.5` previously gave 12.5 px into a 10 px section for the
     5 mm U-notch and keyhole, which drew them as a broken specimen. */
  function notchDepthPx(dim) {
    var d = effNotch(state.notch, state.notchCond).depth;
    var trueDepth = d / CHARPY_SPEC.height * dim;
    /* Deep notches (5 mm U and keyhole) are drawn at TRUE proportion so the
       remaining ligament reads correctly — half the section, not a sliver.
       A blanket 1.4x exaggeration left only 30% ligament and made the specimen
       look nearly severed. Only the shallow 2 mm V-notch gets a small floor so
       it stays visible at this scale. */
    return Math.min(Math.max(trueDepth, 2.5), dim * 0.55);
  }

  /* Charpy: notch cut UPWARD into the bottom face at mid-span. */
  function drawNotchOnSpecimen(cx, sy, sh) {
    var nd = notchDepthPx(sh);
    var base = sy + sh;                 /* bottom face */
    var halfW = Math.max(2, nd * 0.55);
    mCtx.fillStyle = '#0d1117';
    if (state.notch === 'V-notch') {
      mCtx.beginPath();
      mCtx.moveTo(cx - halfW, base);
      mCtx.lineTo(cx, base - nd);
      mCtx.lineTo(cx + halfW, base);
      mCtx.closePath();
      mCtx.fill();
    } else if (state.notch === 'U-notch') {
      var r = Math.min(halfW, nd / 2);
      mCtx.beginPath();
      mCtx.moveTo(cx - r, base);
      mCtx.lineTo(cx - r, base - nd + r);
      mCtx.arc(cx, base - nd + r, r, Math.PI, 0);
      mCtx.lineTo(cx + r, base);
      mCtx.closePath();
      mCtx.fill();
    } else {
      /* Keyhole: narrow slot from the face opening into a drilled root hole. */
      var rk = Math.min(halfW, nd / 2.6);
      var slotW = Math.max(1, rk * 0.6);
      mCtx.beginPath();
      mCtx.moveTo(cx - slotW, base);
      mCtx.lineTo(cx - slotW, base - nd + rk);
      mCtx.lineTo(cx + slotW, base - nd + rk);
      mCtx.lineTo(cx + slotW, base);
      mCtx.closePath();
      mCtx.fill();
      mCtx.beginPath();
      mCtx.arc(cx, base - nd + rk, rk, 0, Math.PI * 2);
      mCtx.fill();
    }
  }

  /* Izod: notch cut LEFTWARD into the struck (right) face, at the vice top.
     `rx` is the specimen's right edge. */
  function drawNotchOnSpecimenIzod(rx, ny, sw) {
    var nd = notchDepthPx(sw);
    var halfW = Math.max(2, nd * 0.55);
    mCtx.fillStyle = '#0d1117';
    if (state.notch === 'V-notch') {
      mCtx.beginPath();
      mCtx.moveTo(rx, ny - halfW);
      mCtx.lineTo(rx - nd, ny);
      mCtx.lineTo(rx, ny + halfW);
      mCtx.closePath();
      mCtx.fill();
    } else if (state.notch === 'U-notch') {
      var r = Math.min(halfW, nd / 2);
      mCtx.beginPath();
      mCtx.moveTo(rx, ny - r);
      mCtx.lineTo(rx - nd + r, ny - r);
      mCtx.arc(rx - nd + r, ny, r, -Math.PI / 2, Math.PI / 2, true);
      mCtx.lineTo(rx, ny + r);
      mCtx.closePath();
      mCtx.fill();
    } else {
      var rk = Math.min(halfW, nd / 2.6);
      var slotW = Math.max(1, rk * 0.6);
      mCtx.beginPath();
      mCtx.moveTo(rx, ny - slotW);
      mCtx.lineTo(rx - nd + rk, ny - slotW);
      mCtx.lineTo(rx - nd + rk, ny + slotW);
      mCtx.lineTo(rx, ny + slotW);
      mCtx.closePath();
      mCtx.fill();
      mCtx.beginPath();
      mCtx.arc(rx - nd + rk, ny, rk, 0, Math.PI * 2);
      mCtx.fill();
    }
  }

  function drawNotchDetail() {
    var bx = 10, by = 10, bw = 120, bh = 85;
    roundRect(mCtx, bx, by, bw, bh, 4);
    mCtx.fillStyle = 'rgba(13,17,23,0.9)';
    mCtx.fill();
    mCtx.strokeStyle = 'rgba(255,61,0,0.4)';
    mCtx.lineWidth = 1;
    mCtx.stroke();
    mCtx.fillStyle = '#ff3d00';
    mCtx.font = 'bold 9px monospace';
    mCtx.textAlign = 'left';
    /* One scale for every notch type: the 30 px block height represents the
       10 mm section, i.e. 3 px/mm. The old code used depth*5 for the V-notch
       but depth*4 for U and keyhole, so the inset misstated their relative
       depths (and the "x5" caption was only ever true for the V-notch). */
    var PXMM = 3;
    mCtx.fillText('Notch Detail \u00d7' + PXMM, bx + 6, by + 14);

    var nx = bx + bw / 2, ny = by + 52;
    var notch = NOTCH_TYPES[state.notch];
    var nd = notch.depth * PXMM;
    var base = ny + 15;                 /* struck-opposite face of the block */

    /* Specimen block */
    mCtx.fillStyle = '#607d8b';
    mCtx.fillRect(nx - 30, ny - 15, 60, 30);

    /* Notch cut \u2014 always drawn into the bottom face of the block */
    mCtx.fillStyle = '#0d1117';
    if (state.notch === 'V-notch') {
      var vw = nd * 0.83;               /* 45 deg included angle */
      mCtx.beginPath();
      mCtx.moveTo(nx - vw, base);
      mCtx.lineTo(nx, base - nd);
      mCtx.lineTo(nx + vw, base);
      mCtx.closePath();
      mCtx.fill();
    } else if (state.notch === 'U-notch') {
      var r = notch.radius * PXMM;
      mCtx.beginPath();
      mCtx.moveTo(nx - r, base);
      mCtx.lineTo(nx - r, base - nd + r);
      mCtx.arc(nx, base - nd + r, r, Math.PI, 0);
      mCtx.lineTo(nx + r, base);
      mCtx.closePath();
      mCtx.fill();
    } else {
      var rk = notch.radius * PXMM;     /* 0.8 mm radius = 1.6 mm drilled hole */
      var sw = rk * 0.55;
      mCtx.beginPath();
      mCtx.moveTo(nx - sw, base);
      mCtx.lineTo(nx - sw, base - nd + rk);
      mCtx.lineTo(nx + sw, base - nd + rk);
      mCtx.lineTo(nx + sw, base);
      mCtx.closePath();
      mCtx.fill();
      mCtx.beginPath();
      mCtx.arc(nx, base - nd + rk, rk, 0, Math.PI * 2);
      mCtx.fill();
    }

    /* Depth leader line, so the dimension reads against the actual cut */
    mCtx.strokeStyle = 'rgba(255,183,77,0.7)';
    mCtx.lineWidth = 0.7;
    mCtx.beginPath();
    mCtx.moveTo(nx + 16, base);
    mCtx.lineTo(nx + 16, base - nd);
    mCtx.stroke();

    mCtx.fillStyle = '#ffb74d';
    mCtx.font = '7px monospace';
    mCtx.textAlign = 'left';
    mCtx.fillText(notch.depth + 'mm', nx + 19, base - nd / 2 + 2);
    mCtx.fillText('r=' + notch.radius, nx + 19, base - nd / 2 + 11);
    if (state.notch === 'V-notch') {
      mCtx.textAlign = 'center';
      mCtx.fillText('45\u00b0', nx, base - nd - 4);
    }

    mCtx.fillStyle = 'rgba(200,215,240,0.5)';
    mCtx.font = '7px monospace';
    mCtx.textAlign = 'center';
    mCtx.fillText(state.notch + ' \u2014 ' + (state.method === 'charpy'
      ? 'struck opposite' : 'struck on notch'), nx, by + 26);
    /* Specimen size + notch condition, so the drawn geometry is also stated. */
    var szTxt = CHARPY_SPEC.height + '\u00D7' + state.specWidth + '\u00D7' +
                (state.method === 'izod' ? IZOD_SPEC.length : CHARPY_SPEC.length) + ' mm';
    if (state.specWidth !== FULL_WIDTH) szTxt += '  (' + sizeLabel() + ' size)';
    mCtx.fillStyle = state.specWidth !== FULL_WIDTH ? '#ffb74d' : 'rgba(200,215,240,0.45)';
    mCtx.font = '7px monospace';
    mCtx.fillText(szTxt, nx, by + bh - 4);
    if (state.notchCond !== 'to-spec') {
      mCtx.fillStyle = '#ff5555';
      mCtx.fillText('\u26A0 ' + NOTCH_CONDITIONS[state.notchCond].label + ' \u2014 invalid', nx, by + bh - 13);
    }
  }

  function drawDialGauge() {
    /* Outer bezel */
    var bg = mCtx.createRadialGradient(DIAL_CX, DIAL_CY, DIAL_R - 6, DIAL_CX, DIAL_CY, DIAL_R + 2);
    bg.addColorStop(0, '#455a64');
    bg.addColorStop(0.4, '#607d8b');
    bg.addColorStop(0.7, '#546e7a');
    bg.addColorStop(1, '#37474f');
    mCtx.fillStyle = bg;
    mCtx.beginPath(); mCtx.arc(DIAL_CX, DIAL_CY, DIAL_R + 4, 0, Math.PI * 2); mCtx.fill();

    /* Glass face */
    var gg = mCtx.createRadialGradient(DIAL_CX - 10, DIAL_CY - 10, 5, DIAL_CX, DIAL_CY, DIAL_R);
    gg.addColorStop(0, 'rgba(255,255,255,0.06)');
    gg.addColorStop(0.5, 'rgba(13,17,23,0.95)');
    gg.addColorStop(1, '#0d1117');
    mCtx.fillStyle = gg;
    mCtx.beginPath(); mCtx.arc(DIAL_CX, DIAL_CY, DIAL_R, 0, Math.PI * 2); mCtx.fill();

    /* Scale arc: 0J at ~225deg (bottom-left) to 300J at ~315deg (bottom-right), sweeping 270deg clockwise */
    var startAngle = Math.PI * 0.75; /* 135 deg = bottom-left */
    var sweepAngle = Math.PI * 1.5;  /* 270 deg sweep */

    /* Major ticks every 50J, minor every 10J */
    for (var j = 0; j <= MAX_ENERGY; j += 10) {
      var frac = j / MAX_ENERGY;
      var angle = startAngle + frac * sweepAngle;
      var isMajor = j % 50 === 0;
      var r1 = DIAL_R - (isMajor ? 12 : 8);
      var r2 = DIAL_R - 3;

      mCtx.strokeStyle = isMajor ? 'rgba(200,215,240,0.7)' : 'rgba(200,215,240,0.25)';
      mCtx.lineWidth = isMajor ? 1.5 : 0.7;
      mCtx.beginPath();
      mCtx.moveTo(DIAL_CX + r1 * Math.cos(angle), DIAL_CY + r1 * Math.sin(angle));
      mCtx.lineTo(DIAL_CX + r2 * Math.cos(angle), DIAL_CY + r2 * Math.sin(angle));
      mCtx.stroke();

      if (isMajor) {
        mCtx.fillStyle = 'rgba(200,215,240,0.6)';
        mCtx.font = '8px monospace';
        mCtx.textAlign = 'center';
        mCtx.textBaseline = 'middle';
        var lr = DIAL_R - 18;
        mCtx.fillText(j.toString(), DIAL_CX + lr * Math.cos(angle), DIAL_CY + lr * Math.sin(angle));
      }
    }

    /* Needle */
    var needleFrac = clamp(state.dialNeedleAngle / MAX_ENERGY, 0, 1);
    var needleAngle = startAngle + needleFrac * sweepAngle;
    var needleLen = DIAL_R - 8;
    mCtx.strokeStyle = '#ff3d00';
    mCtx.lineWidth = 2;
    mCtx.beginPath();
    mCtx.moveTo(DIAL_CX, DIAL_CY);
    mCtx.lineTo(DIAL_CX + needleLen * Math.cos(needleAngle), DIAL_CY + needleLen * Math.sin(needleAngle));
    mCtx.stroke();

    /* Needle tail */
    var tailLen = 10;
    mCtx.strokeStyle = '#ff3d00';
    mCtx.lineWidth = 3;
    mCtx.beginPath();
    mCtx.moveTo(DIAL_CX, DIAL_CY);
    mCtx.lineTo(DIAL_CX - tailLen * Math.cos(needleAngle), DIAL_CY - tailLen * Math.sin(needleAngle));
    mCtx.stroke();

    /* Center cap */
    var cg = mCtx.createRadialGradient(DIAL_CX, DIAL_CY, 1, DIAL_CX, DIAL_CY, 5);
    cg.addColorStop(0, '#b0bec5');
    cg.addColorStop(1, '#455a64');
    mCtx.fillStyle = cg;
    mCtx.beginPath(); mCtx.arc(DIAL_CX, DIAL_CY, 5, 0, Math.PI * 2); mCtx.fill();

    /* Labels */
    mCtx.fillStyle = '#ff3d00';
    mCtx.font = 'bold 8px monospace';
    mCtx.textAlign = 'center';
    mCtx.fillText('ENERGY (J)', DIAL_CX, DIAL_CY + DIAL_R - 18);
    mCtx.fillStyle = 'rgba(200,215,240,0.3)';
    mCtx.font = '6px monospace';
    mCtx.fillText('MechSimulator', DIAL_CX, DIAL_CY + DIAL_R - 10);
  }

  function drawTongs() {
    if (state.animPhase !== 'loading') return;
    var p = state.tongsProgress;
    /* Tongs come from left, place specimen, retract */
    var startX = FRAME_L - 80;
    var endX = state.method === 'charpy' ? SPEC_X - 45 : SPEC_X - 5;
    var ty = state.method === 'charpy' ? ANVIL_Y - 15 : ANVIL_Y - 55;

    var tx;
    if (p < 0.5) {
      tx = lerp(startX, endX, easeInOut(p * 2));
    } else {
      tx = lerp(endX, startX - 30, easeInOut((p - 0.5) * 2));
    }

    /* Tongs handle */
    mCtx.strokeStyle = '#78909c';
    mCtx.lineWidth = 4;
    mCtx.lineCap = 'round';
    mCtx.beginPath();
    mCtx.moveTo(tx - 40, ty - 10);
    mCtx.lineTo(tx, ty);
    mCtx.stroke();
    mCtx.beginPath();
    mCtx.moveTo(tx - 40, ty + 20);
    mCtx.lineTo(tx, ty + 10);
    mCtx.stroke();

    /* Tongs tips */
    mCtx.strokeStyle = '#90a4ae';
    mCtx.lineWidth = 2.5;
    mCtx.beginPath();
    mCtx.moveTo(tx, ty);
    mCtx.lineTo(tx + 15, ty + 2);
    mCtx.stroke();
    mCtx.beginPath();
    mCtx.moveTo(tx, ty + 10);
    mCtx.lineTo(tx + 15, ty + 8);
    mCtx.stroke();

    /* Specimen in tongs (if moving to position) */
    if (p < 0.45) {
      var mat = MATERIALS[state.matIdx];
      var tc = temperatureColor(state.temperature);
      mCtx.fillStyle = tc;
      if (state.method === 'charpy') {
        mCtx.fillRect(tx + 5, ty, 30, 10);
      } else {
        mCtx.fillRect(tx + 5, ty, 10, 30);
      }
    }
    mCtx.lineCap = 'butt';
  }

  function drawSafetyGuard() {
    var gx = SPEC_X - 70, gy = ANVIL_Y - 80, gw = 140, gh = 120;
    mCtx.strokeStyle = 'rgba(30,136,229,0.08)';
    mCtx.lineWidth = 1;
    mCtx.setLineDash([6, 4]);
    mCtx.strokeRect(gx, gy, gw, gh);
    mCtx.setLineDash([]);

    /* Corner brackets */
    var bl = 8;
    mCtx.strokeStyle = 'rgba(30,136,229,0.2)';
    mCtx.lineWidth = 1.5;
    /* TL */
    mCtx.beginPath(); mCtx.moveTo(gx, gy + bl); mCtx.lineTo(gx, gy); mCtx.lineTo(gx + bl, gy); mCtx.stroke();
    /* TR */
    mCtx.beginPath(); mCtx.moveTo(gx + gw - bl, gy); mCtx.lineTo(gx + gw, gy); mCtx.lineTo(gx + gw, gy + bl); mCtx.stroke();
    /* BL */
    mCtx.beginPath(); mCtx.moveTo(gx, gy + gh - bl); mCtx.lineTo(gx, gy + gh); mCtx.lineTo(gx + bl, gy + gh); mCtx.stroke();
    /* BR */
    mCtx.beginPath(); mCtx.moveTo(gx + gw - bl, gy + gh); mCtx.lineTo(gx + gw, gy + gh); mCtx.lineTo(gx + gw, gy + gh - bl); mCtx.stroke();

    mCtx.fillStyle = 'rgba(30,136,229,0.12)';
