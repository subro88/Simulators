  /* ================================================================
     S10 — PENDULUM PHYSICS & SPECIMEN STATE
     ================================================================ */
  /* Real rigid-pendulum motion: theta'' = -(g/R) sin(theta).
     The previous version faked all three phases with easeIn/easeOut curves on a
     unitless 0..1 time axis, so the plotted shape and the time to impact were
     cosmetic. Integrating the actual equation makes the curve — and the time
     axis, now in real seconds — something a student can check against
     t = sqrt(R/g)*F(alpha) or simply against a stopwatch.

     `absorbedEnergy` is removed from the kinetic energy at bottom-of-arc, which
     is exactly the measurement the machine makes. Returns points AND the
     impact time so the graph can mark it honestly. */
  function generateAngleTimeData(alphaDeg, betaDeg, absorbedEnergy) {
    var data = [];
    var g = GRAVITY, R = PEND_R;
    var dt = 0.002;
    var theta = degToRad(alphaDeg);     /* measured from the downward vertical */
    var omega = 0;
    var t = 0;
    var tImpact = null;

    /* Phase 1 — free fall from the latch down to theta = 0. */
    var guard = 0;
    while (theta > 0 && guard++ < 20000) {
      omega += -(g / R) * Math.sin(theta) * dt;
      theta += omega * dt;
      t += dt;
      if (theta <= 0) break;
      data.push({ time: t, angle: radToDeg(theta) });
    }
    tImpact = t;
    data.push({ time: t, angle: 0 });

    /* Impact — remove the absorbed energy from the pendulum's kinetic energy.
       v = omega*R, so (1/2)m v^2 - E = (1/2)m v'^2. */
    var vBefore = Math.abs(omega) * R;
    var keAfter = 0.5 * PEND_MASS * vBefore * vBefore - (absorbedEnergy || 0);
    if (keAfter < 0) keAfter = 0;
    var vAfter = Math.sqrt(2 * keAfter / PEND_MASS);
    omega = -vAfter / R;                /* continues through, now negative side */

    /* Phase 2 — follow-through to the first peak. This peak IS the measured
       beta, so it is integrated UNDAMPED: damping here would make the plotted
       swing-through angle disagree with the beta shown in the readouts. */
    var tEnd = t + 2.6;
    guard = 0;
    while (omega < 0 && t < tEnd && guard++ < 40000) {
      omega += -(g / R) * Math.sin(theta) * dt;
      theta += omega * dt;
      t += dt;
      data.push({ time: t, angle: radToDeg(theta) });
    }

    /* Phase 3 — free swinging afterwards, with a light damping term standing
       in for bearing friction and windage as the pendulum coasts to rest. */
    var damp = 0.35;
    guard = 0;
    while (t < tEnd && guard++ < 40000) {
      omega += (-(g / R) * Math.sin(theta) - damp * omega) * dt;
      theta += omega * dt;
      t += dt;
      data.push({ time: t, angle: radToDeg(theta) });
    }

    /* Thin to ~400 points — plenty for a smooth line, cheap to redraw. */
    var out = [];
    var step = Math.max(1, Math.floor(data.length / 400));
    for (var i = 0; i < data.length; i += step) out.push(data[i]);
    if (out[out.length - 1] !== data[data.length - 1]) out.push(data[data.length - 1]);
    out.tImpact = tImpact;
    out.tTotal = t;
    return out;
  }

  /* Fires the fracture exactly once, deterministically.

     This used to live inside the 'impact' tick as
         if (state.animProgress < 0.1 && state.fractureParts.length === 0)
     i.e. it needed a frame to land inside the first 25 ms of a 250 ms phase.
     At 60 fps that leaves an 8 ms margin; at 30 fps (or on any dropped frame,
     background tab, or slower device) the window is missed entirely and the
     specimen NEVER breaks — the test still completes and reports energy, so it
     looks like a rendering fault rather than a timing one. Adding per-frame
     work to the render made the miss far more likely.

     A one-shot event guarded by its own flag has no timing dependency at all. */
  function fractureNow() {
    if (state.fractured) return;
    state.fractured = true;
    initFractureParticles();
  }

  function initFractureParticles() {
    state.fractureParts = [];
    var mat = MATERIALS[state.matIdx];
    var ix = SPEC_X, iy = ANVIL_Y - 5;
    var colors = ['#ff3d00', '#ff8a65', '#ffcc80', '#ffffff', mat.color];
    for (var i = 0; i < 25; i++) {
      state.fractureParts.push({
        x: ix + (Math.random() - 0.5) * 10,
        y: iy + (Math.random() - 0.5) * 6,
        vx: (Math.random() - 0.5) * 6,
        vy: -Math.random() * 5 - 1,
        alpha: 0.8 + Math.random() * 0.2,
        rot: Math.random() * Math.PI * 2,
        size: 1.5 + Math.random() * 3.5,
        color: colors[Math.floor(Math.random() * colors.length)]
      });
    }
    /* Play impact sound */
    if (typeof playImpactSound === 'function') playImpactSound();
  }

  function updateFractureParticles() {
    for (var i = 0; i < state.fractureParts.length; i++) {
      var p = state.fractureParts[i];
      p.x += p.vx;
      p.y += p.vy;
      p.vy += 0.2;
      p.rot += 0.1;
      p.alpha *= 0.96;
    }
  }

  /* ================================================================
     S11 — GRAPH CANVAS DRAWING
     ================================================================ */
  var GOX = 70, GOY = 440, GGW = 440, GGH = 390;

  function drawGraph() {
    if (!gCtx) return;
    resetCtxState(gCtx);
    gCtx.clearRect(0, 0, GW, GH);
    drawGraphBackground();
    if (disp.grid) drawGraphGrid();

    if (state.graphMode === 'dbtt') {
      drawDBTTGraph();
    } else {
      drawAngleTimeGraph();
    }
  }

  function drawGraphBackground() {
    gCtx.fillStyle = '#0d1117';
    gCtx.fillRect(0, 0, GW, GH);
  }

  function drawGraphGrid() {
    gCtx.strokeStyle = 'rgba(42,48,80,0.15)';
    gCtx.lineWidth = 0.5;
    var dx = GGW / 10, dy = GGH / 8;
    for (var i = 0; i <= 10; i++) {
      var x = GOX + i * dx;
      gCtx.beginPath(); gCtx.moveTo(x, GOY); gCtx.lineTo(x, GOY - GGH); gCtx.stroke();
    }
    for (var j = 0; j <= 8; j++) {
      var y = GOY - j * dy;
      gCtx.beginPath(); gCtx.moveTo(GOX, y); gCtx.lineTo(GOX + GGW, y); gCtx.stroke();
    }
  }

  function drawAngleTimeGraph() {
    /* Axes */
    gCtx.strokeStyle = 'rgba(200,215,240,0.5)';
    gCtx.lineWidth = 1.5;
    gCtx.beginPath();
    gCtx.moveTo(GOX, GOY - GGH);
    gCtx.lineTo(GOX, GOY);
    gCtx.lineTo(GOX + GGW, GOY);
    gCtx.stroke();

    /* Axis labels */
    gCtx.fillStyle = 'rgba(200,215,240,0.6)';
    gCtx.font = '10px monospace';
    gCtx.textAlign = 'center';
    gCtx.fillText('Time (s)', GOX + GGW / 2, GOY + 35);

    gCtx.save();
    gCtx.translate(20, GOY - GGH / 2);
    gCtx.rotate(-Math.PI / 2);
    gCtx.fillText('Pendulum Angle (\u00b0)', 0, 0);
    gCtx.restore();

    /* Title */
    gCtx.fillStyle = '#ff3d00';
    gCtx.font = 'bold 12px "Segoe UI", system-ui, sans-serif';
    gCtx.textAlign = 'center';
    gCtx.fillText('Pendulum Angle vs Time', GOX + GGW / 2, 25);
    gCtx.fillStyle = 'rgba(200,215,240,0.4)';
    gCtx.font = '10px "Segoe UI", system-ui, sans-serif';
    gCtx.fillText(MATERIALS[state.matIdx].name + ' \u2014 ' + (state.method === 'charpy' ? 'Charpy' : 'Izod'), GOX + GGW / 2, 42);

    /* Y-axis ticks: -180 to 180 */
    var maxAngle = 180;
    gCtx.fillStyle = 'rgba(200,215,240,0.4)';
    gCtx.font = '8px monospace';
    gCtx.textAlign = 'right';
    for (var a = -maxAngle; a <= maxAngle; a += 60) {
      var yy = GOY - ((a + maxAngle) / (2 * maxAngle)) * GGH;
      gCtx.fillText(a + '\u00b0', GOX - 6, yy + 3);
      gCtx.strokeStyle = 'rgba(200,215,240,0.1)';
      gCtx.lineWidth = 0.5;
      gCtx.beginPath(); gCtx.moveTo(GOX, yy); gCtx.lineTo(GOX + GGW, yy); gCtx.stroke();
    }

    /* Zero line */
    var zeroY = GOY - (maxAngle / (2 * maxAngle)) * GGH;
    gCtx.strokeStyle = 'rgba(200,215,240,0.2)';
    gCtx.lineWidth = 1;
    gCtx.setLineDash([4, 4]);
    gCtx.beginPath(); gCtx.moveTo(GOX, zeroY); gCtx.lineTo(GOX + GGW, zeroY); gCtx.stroke();
    gCtx.setLineDash([]);

    /* Time axis spans the whole integrated record, in real seconds. */
    var tSpan = state.angleTimeData.tTotal || 1;
    var tickStep = tSpan > 2 ? 0.5 : 0.25;
    gCtx.fillStyle = 'rgba(200,215,240,0.4)';
    gCtx.font = '8px monospace';
    gCtx.textAlign = 'center';
    for (var tk = 0; tk <= tSpan + 1e-6; tk += tickStep) {
      var tx = GOX + (tk / tSpan) * GGW;
      gCtx.fillText(tk.toFixed(2), tx, GOY + 14);
    }

    /* Plot data */
    if (state.angleTimeData.length > 0) {
      var plotN = Math.min(state.anglePlotIdx, state.angleTimeData.length);
      if (plotN > 1) {
        gCtx.strokeStyle = '#ff3d00';
        gCtx.lineWidth = 2;
        gCtx.lineJoin = 'round';
        gCtx.beginPath();
        for (var pi = 0; pi < plotN; pi++) {
          var pt = state.angleTimeData[pi];
          var px = GOX + (pt.time / tSpan) * GGW;
          var py = GOY - ((pt.angle + maxAngle) / (2 * maxAngle)) * GGH;
          px = clamp(px, GOX, GOX + GGW);
          py = clamp(py, GOY - GGH, GOY);
          if (pi === 0) gCtx.moveTo(px, py); else gCtx.lineTo(px, py);
        }
        gCtx.stroke();

        /* Cursor dot at current position */
        if (plotN > 0) {
          var last = state.angleTimeData[plotN - 1];
          var lx = clamp(GOX + (last.time / tSpan) * GGW, GOX, GOX + GGW);
          var ly = clamp(GOY - ((last.angle + maxAngle) / (2 * maxAngle)) * GGH, GOY - GGH, GOY);
          gCtx.fillStyle = hexToRGBA('#ff3d00', 0.2);
          gCtx.beginPath(); gCtx.arc(lx, ly, 8, 0, Math.PI * 2); gCtx.fill();
          gCtx.fillStyle = '#ff3d00';
          gCtx.beginPath(); gCtx.arc(lx, ly, 4, 0, Math.PI * 2); gCtx.fill();
          gCtx.fillStyle = '#fff';
          gCtx.beginPath(); gCtx.arc(lx, ly, 1.5, 0, Math.PI * 2); gCtx.fill();
        }
      }

      /* Impact marker */
      var impactTime = state.angleTimeData.tImpact || 0;
      if (plotN > 1 && state.angleTimeData[plotN - 1].time >= impactTime) {
        var impactX = GOX + (impactTime / tSpan) * GGW;
        gCtx.strokeStyle = 'rgba(255,61,0,0.5)';
        gCtx.lineWidth = 1;
        gCtx.setLineDash([4, 3]);
        gCtx.beginPath(); gCtx.moveTo(impactX, GOY); gCtx.lineTo(impactX, GOY - GGH); gCtx.stroke();
        gCtx.setLineDash([]);
        gCtx.fillStyle = '#ff3d00';
        gCtx.font = 'bold 10px monospace';
        gCtx.textAlign = 'center';
        gCtx.fillText('IMPACT  t=' + impactTime.toFixed(3) + 's', impactX, GOY - GGH + 15);
      }
    }
  }

  function drawDBTTGraph() {
    var mat = MATERIALS[state.matIdx];

    /* Axes */
    gCtx.strokeStyle = 'rgba(200,215,240,0.5)';
    gCtx.lineWidth = 1.5;
    gCtx.beginPath();
    gCtx.moveTo(GOX, GOY - GGH);
    gCtx.lineTo(GOX, GOY);
    gCtx.lineTo(GOX + GGW, GOY);
    gCtx.stroke();

    /* Axis labels */
    gCtx.fillStyle = 'rgba(200,215,240,0.6)';
    gCtx.font = '10px monospace';
    gCtx.textAlign = 'center';
    gCtx.fillText('Temperature (\u00b0C)', GOX + GGW / 2, GOY + 35);

    gCtx.save();
    gCtx.translate(20, GOY - GGH / 2);
    gCtx.rotate(-Math.PI / 2);
    gCtx.fillText('Impact Energy (J)', 0, 0);
    gCtx.restore();

    /* Title */
    gCtx.fillStyle = '#ff3d00';
    gCtx.font = 'bold 12px "Segoe UI", system-ui, sans-serif';
    gCtx.textAlign = 'center';
    gCtx.fillText('Impact Energy vs Temperature (DBTT Curve)', GOX + GGW / 2, 25);
    gCtx.fillStyle = 'rgba(200,215,240,0.4)';
    gCtx.font = '10px "Segoe UI", system-ui, sans-serif';
    gCtx.fillText(mat.name, GOX + GGW / 2, 42);

    /* Scale */
    var minT = -200, maxT = 200;
    var maxE = Math.max(mat.upperShelf * 1.3, 50);

    /* X ticks */
    gCtx.fillStyle = 'rgba(200,215,240,0.4)';
    gCtx.font = '8px monospace';
    gCtx.textAlign = 'center';
    for (var t = -200; t <= 200; t += 50) {
      var tx = GOX + ((t - minT) / (maxT - minT)) * GGW;
      gCtx.fillText(t + '', tx, GOY + 14);
      gCtx.strokeStyle = 'rgba(200,215,240,0.08)';
      gCtx.lineWidth = 0.5;
      gCtx.beginPath(); gCtx.moveTo(tx, GOY); gCtx.lineTo(tx, GOY - GGH); gCtx.stroke();
    }

    /* Y ticks */
    gCtx.textAlign = 'right';
    var yStep = maxE > 100 ? 50 : 10;
    for (var e = 0; e <= maxE; e += yStep) {
      var ey = GOY - (e / maxE) * GGH;
      gCtx.fillText(e + '', GOX - 6, ey + 3);
    }

    /* Sigmoid curve */
    if (mat.DBTT !== null && mat.transWidth > 0) {
      gCtx.strokeStyle = hexToRGBA('#ff3d00', 0.4);
      gCtx.lineWidth = 2;
      gCtx.beginPath();
      for (var ci = 0; ci <= 200; ci++) {
        var cT = minT + (ci / 200) * (maxT - minT);
        var cE = tanhSigmoid(cT, mat.lowerShelf, mat.upperShelf, mat.DBTT, mat.transWidth);
        var cx = GOX + ((cT - minT) / (maxT - minT)) * GGW;
        var cy = GOY - (cE / maxE) * GGH;
        if (ci === 0) gCtx.moveTo(cx, cy); else gCtx.lineTo(cx, cy);
      }
      gCtx.stroke();

      /* Upper shelf line */
      if (disp.shelves) {
      gCtx.strokeStyle = 'rgba(61,220,132,0.3)';
      gCtx.lineWidth = 1;
      gCtx.setLineDash([5, 4]);
      var usY = GOY - (mat.upperShelf / maxE) * GGH;
      gCtx.beginPath(); gCtx.moveTo(GOX, usY); gCtx.lineTo(GOX + GGW, usY); gCtx.stroke();
      gCtx.fillStyle = '#3ddc84';
      gCtx.font = '8px monospace';
      gCtx.textAlign = 'left';
      gCtx.fillText('Upper Shelf (' + mat.upperShelf + ' J)', GOX + GGW - 130, usY - 4);

      /* Lower shelf line */
      var lsY = GOY - (mat.lowerShelf / maxE) * GGH;
      gCtx.strokeStyle = 'rgba(255,85,85,0.3)';
      gCtx.beginPath(); gCtx.moveTo(GOX, lsY); gCtx.lineTo(GOX + GGW, lsY); gCtx.stroke();
      gCtx.fillStyle = '#ff5555';
      gCtx.fillText('Lower Shelf (' + mat.lowerShelf + ' J)', GOX + GGW - 130, lsY + 12);

      /* DBTT vertical line */
      gCtx.strokeStyle = 'rgba(255,183,77,0.5)';
      var dbttX = GOX + ((mat.DBTT - minT) / (maxT - minT)) * GGW;
      gCtx.beginPath(); gCtx.moveTo(dbttX, GOY); gCtx.lineTo(dbttX, GOY - GGH); gCtx.stroke();
      gCtx.setLineDash([]);
      gCtx.fillStyle = '#ffb74d';
      gCtx.font = 'bold 9px monospace';
      gCtx.textAlign = 'center';
      gCtx.fillText('DBTT = ' + mat.DBTT + '\u00b0C', dbttX, GOY - GGH + 15);

      /* Transition zone label */
      gCtx.fillStyle = 'rgba(255,183,77,0.3)';
      gCtx.font = '8px monospace';
      gCtx.fillText('Transition Zone', dbttX, GOY - GGH / 2);
      }
    } else {
      /* FCC or no-DBTT: flat energy band */
      var flatE = (mat.upperShelf + mat.lowerShelf) / 2;
      var flatY = GOY - (flatE / maxE) * GGH;
      var upperY = GOY - (mat.upperShelf / maxE) * GGH;
      var lowerY = GOY - (mat.lowerShelf / maxE) * GGH;

      /* Shaded energy band */
      gCtx.fillStyle = hexToRGBA('#ff3d00', 0.06);
      gCtx.fillRect(GOX, upperY, GGW, lowerY - upperY);

      /* Upper and lower shelf dashed lines */
      if (disp.shelves) {
      gCtx.setLineDash([4, 4]);
      gCtx.strokeStyle = hexToRGBA('#ff3d00', 0.25);
      gCtx.lineWidth = 1;
      gCtx.beginPath(); gCtx.moveTo(GOX, upperY); gCtx.lineTo(GOX + GGW, upperY); gCtx.stroke();
      gCtx.beginPath(); gCtx.moveTo(GOX, lowerY); gCtx.lineTo(GOX + GGW, lowerY); gCtx.stroke();
      gCtx.setLineDash([]);
      }

      /* Average energy line */
      gCtx.strokeStyle = hexToRGBA('#ff3d00', 0.5);
      gCtx.lineWidth = 2;
      gCtx.beginPath();
      gCtx.moveTo(GOX, flatY);
      gCtx.lineTo(GOX + GGW, flatY);
      gCtx.stroke();

      /* Shelf labels */
      gCtx.fillStyle = hexToRGBA('#ff3d00', 0.6);
      gCtx.font = '8px monospace';
      gCtx.textAlign = 'right';
      gCtx.fillText(mat.upperShelf + ' J', GOX + GGW - 4, upperY - 3);
      gCtx.fillText(mat.lowerShelf + ' J', GOX + GGW - 4, lowerY + 10);

      /* Title annotation */
      gCtx.textAlign = 'center';
      gCtx.fillStyle = '#ffb74d';
      gCtx.font = 'bold 10px "Segoe UI", system-ui, sans-serif';
      var isFCC = mat.crystal === 'FCC';
      var crystalLabel = isFCC ? 'FCC Crystal Structure' : mat.crystal;
      gCtx.fillText('No DBTT \u2014 ' + crystalLabel, GOX + GGW / 2, flatY - 22);

      /* Educational explanation */
      gCtx.fillStyle = 'rgba(200,215,240,0.5)';
      gCtx.font = '9px "Segoe UI", system-ui, sans-serif';
      if (isFCC) {
        gCtx.fillText('FCC metals remain ductile at all temperatures', GOX + GGW / 2, flatY - 10);
      } else if (mat.crystal === 'BCC-graphite') {
        gCtx.fillText('Graphite flakes cause inherently brittle behavior', GOX + GGW / 2, flatY - 10);
      }

      /* Avg energy label */
      gCtx.fillStyle = 'rgba(200,215,240,0.35)';
      gCtx.font = '8px monospace';
      gCtx.textAlign = 'left';
      gCtx.fillText('Avg: ' + roundN(flatE, 0) + ' J', GOX + 6, flatY - 3);
    }

    /* Test points */
    for (var ti = 0; disp.points && ti < state.testPoints.length; ti++) {
      var tp = state.testPoints[ti];
      var tpx = GOX + ((tp.T - minT) / (maxT - minT)) * GGW;
      var tpy = GOY - (tp.E / maxE) * GGH;
      var isLatest = ti === state.testPoints.length - 1;

      if (isLatest) {
        /* Glow */
        gCtx.fillStyle = hexToRGBA('#ff3d00', 0.15);
        gCtx.beginPath(); gCtx.arc(tpx, tpy, 10, 0, Math.PI * 2); gCtx.fill();
        gCtx.fillStyle = '#ff3d00';
        gCtx.beginPath(); gCtx.arc(tpx, tpy, 5, 0, Math.PI * 2); gCtx.fill();
        gCtx.fillStyle = '#fff';
        gCtx.beginPath(); gCtx.arc(tpx, tpy, 2, 0, Math.PI * 2); gCtx.fill();
      } else {
        gCtx.fillStyle = hexToRGBA('#ff3d00', 0.6);
        gCtx.beginPath(); gCtx.arc(tpx, tpy, 4, 0, Math.PI * 2); gCtx.fill();
      }
    }
  }

  /* ================================================================
     S12 — ANIMATION ENGINE
     ================================================================ */
  var PHASE_DUR = {
    loading: 1500,
    latching: 1200,
    releasing: 800,
    impact: 250,
    swingThrough: 1000,
    returning: 1500,
    dialReading: 800
  };
  var animRAF = null;

  function startPlace() {
    if (state.animPhase !== 'idle' || state.placed) return;
    state.animPhase = 'loading';
    state.animStart = performance.now();
    state.animProgress = 0;
    state.fractured = false;
    state.fractureParts = [];
    state.impactFlashAlpha = 0;
    setGraphMode('angle-time', false);
    state.angleTimeData = [];
    state.anglePlotIdx = 0;
    state.dialNeedleAngle = 0;
    if (elBtnPlace) elBtnPlace.disabled = true;
    if (elBtnRelease) elBtnRelease.disabled = true;
    hide(elResultsRow);
    hide($('inference-panel'));
    advanceStep(4);
    if (typeof updateGuideBlink === 'function') updateGuideBlink();
    animRAF = requestAnimationFrame(tick);
  }

  function startRelease() {
    if (state.animPhase !== 'idle' || !state.placed) return;

    /* Calculate test results — ONE sample, so every readout describes the
       same fracture event (energy, % shear and lateral expansion agree). */
    var mat = MATERIALS[state.matIdx];
    var sample = sampleTest(mat, state.temperature, state.method, state.notch);
    var energy = sample.energy;
    state.absorbedEnergy = energy;
    state.shearFrac = sample.shearFrac;
    state.lateralExp = sample.lateralExp;
    state.unbroken = sample.unbroken;
    state.overCapacity = sample.overCapacity;
    state.notchInvalid = sample.notchInvalid;
    state.finalAngle = calcBetaAngle(alphaDeg(), energy);
    state.angleTimeData = generateAngleTimeData(alphaDeg(), state.finalAngle, energy);
    state.anglePlotIdx = 0;

    state.animPhase = 'releasing';
    state.animStart = performance.now();
    state.animProgress = 0;
    if (elBtnRelease) elBtnRelease.disabled = true;
    if (elBtnPlace) elBtnPlace.disabled = true;
    advanceStep(5);
    if (typeof updateGuideBlink === 'function') updateGuideBlink();
    animRAF = requestAnimationFrame(tick);
  }

  /* Map an animation fraction onto the integrated angle-time record. The plot
     index used to assume fixed 30/30/40 phase splits; the real record puts
     impact wherever the integration lands, so derive it from tImpact. */
  function fImpact() {
    var d = state.angleTimeData;
    if (!d || !d.tTotal) return 0.3;
    return clamp((d.tImpact || 0) / d.tTotal, 0, 1);
  }
  function plotIdxFor(frac) {
    var d = state.angleTimeData;
    if (!d || !d.length) return 0;
    return Math.floor(clamp(frac, 0, 1) * d.length);
  }

  function tick(now) {
    var elapsed = now - state.animStart;
    var dur = PHASE_DUR[state.animPhase] || 1;
    state.animProgress = clamp(elapsed / dur, 0, 1);

    switch (state.animPhase) {
      case 'loading':
        state.tongsProgress = state.animProgress;
        if (state.animProgress > 0.45 && !state.placed) {
          state.placed = true;
        }
        break;
      case 'latching':
        state.pendulumAngle = lerp(0, -state.releaseAngle, easeInOut(state.animProgress));
        break;
      case 'releasing':
        state.pendulumAngle = lerp(-state.releaseAngle, 0, easeIn(state.animProgress));
        state.anglePlotIdx = plotIdxFor(state.animProgress * fImpact());
        break;
      case 'impact':
        state.impactFlashAlpha = 1 - state.animProgress;
        /* Fracture is an EVENT, fired on entry to this phase — never a state
           sampled inside a progress window. See fractureNow(). */
        fractureNow();
        updateFractureParticles();
        state.anglePlotIdx = plotIdxFor(fImpact());
        break;
      case 'swingThrough':
        state.pendulumAngle = lerp(0, degToRad(state.finalAngle), easeOut(state.animProgress));
        state.anglePlotIdx = plotIdxFor(fImpact() + state.animProgress * (1 - fImpact()) * 0.5);
        updateFractureParticles();
        break;
      case 'returning':
        var damping = 1 - easeInOut(state.animProgress);
        state.pendulumAngle = degToRad(state.finalAngle) * damping * Math.cos(state.animProgress * Math.PI * 2);
        state.anglePlotIdx = plotIdxFor(fImpact() + (1 - fImpact()) * (0.5 + state.animProgress * 0.5));
        break;
      case 'dialReading':
        var overshoot = 1 + 0.08 * Math.sin(state.animProgress * Math.PI * 3) * (1 - state.animProgress);
        state.dialNeedleAngle = state.absorbedEnergy * easeOut(state.animProgress) * overshoot;
        break;
    }

    drawMachine();
    drawGraph();
    updateBadges();

    if (state.animProgress >= 1) {
      switch (state.animPhase) {
        case 'loading':
          state.animPhase = 'latching';
          state.animStart = performance.now();
          break;
        case 'latching':
          state.animPhase = 'idle';
          state.pendulumAngle = -state.releaseAngle;
          if (elBtnRelease) elBtnRelease.disabled = false;
          if (typeof updateGuideBlink === 'function') updateGuideBlink();
          return;
        case 'releasing':
          state.animPhase = 'impact';
          state.animStart = performance.now();
          fractureNow();
          break;
        case 'impact':
          state.animPhase = 'swingThrough';
          state.animStart = performance.now();
          break;
        case 'swingThrough':
          state.animPhase = 'returning';
          state.animStart = performance.now();
          setGraphMode('dbtt', true);
          break;
        case 'returning':
          state.animPhase = 'dialReading';
          state.animStart = performance.now();
          state.pendulumAngle = 0;
          break;
        case 'dialReading':
          state.dialNeedleAngle = state.absorbedEnergy;
          completeTest();
          return;
      }
      animRAF = requestAnimationFrame(tick);
      return;
    }

    animRAF = requestAnimationFrame(tick);
  }

  function completeTest() {
    state.animPhase = 'complete';
    state.results = calculateResults();
    /* Record the point BEFORE rendering — the inference panel reports how many
       points are on the curve, and would otherwise always be one behind. */
    state.testPoints.push({
      T: state.temperature, E: state.absorbedEnergy,
      mat: MATERIALS[state.matIdx].name
    });
    displayResults();
    advanceStep(6);
    updateBadges();
    updateLearnPanels();
    drawMachine();
    drawGraph();
    if (elBtnPlace) elBtnPlace.disabled = false;
    if (elBtnReset) elBtnReset.disabled = false;
    if (typeof updateGuideBlink === 'function') updateGuideBlink();
  }

  /* ================================================================
     S13 — LAB PROCEDURE STATE MACHINE
     ================================================================ */
  var LAB_STEPS = [
    { label: 'Select Material', icon: '1' },
    { label: 'Notch Type', icon: '2' },
    { label: 'Set Temperature', icon: '3' },
    { label: 'Test Method', icon: '4' },
    { label: 'Place Specimen', icon: '5' },
    { label: 'Release Pendulum', icon: '6' },
    { label: 'View Results', icon: '7' }
  ];

  function buildLabSteps() {
    if (!elLabSteps) return;
    elLabSteps.innerHTML = '';
    LAB_STEPS.forEach(function (s, i) {
      var div = document.createElement('div');
      div.className = 'lab-step' + (i === 0 ? ' active' : '') + (i < state.labStep ? ' done' : '');
      div.innerHTML = '<span class="lab-step-num">' + s.icon + '</span><span>' + s.label + '</span>';
      elLabSteps.appendChild(div);
    });
  }

  function advanceStep(target) {
    if (target <= state.labStep && target !== 0) return;
    state.labStep = target;
    buildLabSteps();
  }

  /* Material list as a dropdown. The final entry opens the custom-material
     modal and reverts the selection, so "+ Custom" behaves like an action
     rather than a selectable material. */
  var CUSTOM_OPT = '__custom__';

  function buildMaterialTabs() {
    if (!elMatSelect) return;
    elMatSelect.innerHTML = '';
    MATERIALS.forEach(function (m, i) {
      var o = document.createElement('option');
      o.value = String(i);
      o.textContent = m.name;
      elMatSelect.appendChild(o);
    });
    var oc = document.createElement('option');
    oc.value = CUSTOM_OPT;
    oc.textContent = '+ Define custom material…';
    elMatSelect.appendChild(oc);
    elMatSelect.value = String(state.matIdx);
  }

  function selectMaterial(idx) {
    state.matIdx = idx;
    state.testPoints = [];
    resetTest();
    advanceStep(0);
    clearPresetHighlight();
    updateLearnPanels();
    drawMachine();
    drawGraph();
  }

  function calculateResults() {
    var shearFrac = state.shearFrac;
    return {
      energy: state.absorbedEnergy,
      toughness: calcImpactToughness(state.absorbedEnergy, state.notch, state.method),
      area: ligamentAreaCm2(state.notch, state.method),
      specWidth: state.specWidth,
      notchCond: state.notchCond,
      notchInvalid: !!state.notchInvalid,
      alpha: alphaDeg(),
      beta: state.finalAngle,
      velocity: calcImpactVelocity(alphaDeg()),
      shearFrac: shearFrac,
      lateralExp: state.lateralExp,
      fracType: getFractureType(shearFrac),
      unbroken: !!state.unbroken,
      overCapacity: !!state.overCapacity
    };
  }

  function displayResults() {
    if (!state.results) return;
    var r = state.results;
    if (elResEnergy) elResEnergy.textContent = roundN(toD(r.energy, 'energy'), 1);
    if (elResTough) elResTough.textContent = roundN(toD(r.toughness, 'tough'), 1);
    if (elResAlpha) elResAlpha.textContent = roundN(r.alpha, 0);
    if (elResBeta) elResBeta.textContent = roundN(r.beta, 1);
    if (elResVel) elResVel.textContent = roundN(toD(r.velocity, 'vel'), 2);
    if (elResShear) elResShear.textContent = roundN(r.shearFrac, 0);
    if (elResLateral) elResLateral.textContent = roundN(toD(r.lateralExp, 'length'), 2);
    if (elResFracType) elResFracType.textContent = r.fracType;
    updateResultUnits();
    show(elResultsRow);
    updateValidityNote(r);
    updateInferencePanel();
  }

  /* ASTM E23 validity guidance — a result above ~80 % of machine capacity is not
     quantitatively valid, and a specimen that never separates has no valid value. */
  function updateValidityNote(r) {
    var el = $('validity-note');
    if (!el) return;
    var capD = roundN(toD(machineCapacity(), 'energy'), 0) + ' ' + uLabel('energy');
    var limD = roundN(toD(capacityLimit(), 'energy'), 0) + ' ' + uLabel('energy');
    var html, cls;
    if (r.notchInvalid) {
      var nc = NOTCH_CONDITIONS[r.notchCond];
      cls = 'vn-bad';
      html = '<strong>Invalid &mdash; notch out of tolerance (' + nc.label.toLowerCase() + ').</strong> ' +
             'ASTM E23 holds the V-notch root radius to 0.25 &plusmn; 0.025 mm and the depth to ' +
             '2 &plusmn; 0.025 mm. A notch outside that band biases the reading <em>high</em>, so the ' +
             'material looks tougher than it is &mdash; the result must be discarded, not corrected.';
    } else if (r.unbroken) {
      cls = 'vn-bad';
      html = '<strong>Specimen not broken.</strong> The pendulum ran out of energy before ' +
             'separating the specimen (machine capacity ' + capD + '). ASTM E23 requires the ' +
             'result to be reported as &ldquo;did not break&rdquo; &mdash; use a higher-capacity machine.';
    } else if (r.overCapacity) {
      cls = 'vn-warn';
      html = '<strong>Above 80 % of machine capacity.</strong> Absorbed energy exceeds ' + limD +
             ' on this ' + capD + ' machine, so friction and vibration losses are no longer ' +
             'negligible. ASTM E23 treats such a value as indicative only.';
    } else {
      cls = 'vn-ok';
      html = '<strong>Valid result.</strong> Absorbed energy is within the ASTM E23 working ' +
             'range (below 80 % of the ' + capD + ' machine capacity = ' + limD + ').';
      if (r.specWidth !== FULL_WIDTH) {
        html += ' Reported on a <strong>' + sizeLabel() + '-size (' + r.specWidth +
                ' mm)</strong> specimen &mdash; acceptance criteria scale to ' + sizeLabel() +
                ' of the full-size figure.';
      }
    }
    el.className = 'validity-note ' + cls;
    el.innerHTML = html;
    el.style.display = '';
  }

  function updateResultUnits() {
    var unitMap = {
      'res-energy': 'energy', 'res-toughness': 'tough', 'res-velocity': 'vel', 'res-lateral': 'length'
    };
    for (var id in unitMap) {
      var el = $(id);
      if (el) {
        var unitEl = el.parentElement.querySelector('.readout-unit');
        if (unitEl) unitEl.textContent = uLabel(unitMap[id]);
      }
    }
  }

  function updateBadges() {
    var eVal = state.animPhase === 'complete' ? roundN(toD(state.absorbedEnergy, 'energy'), 1) : '0';
    var vVal = (state.placed || state.animPhase === 'complete') ? roundN(toD(calcImpactVelocity(alphaDeg()), 'vel'), 1) : '0';
    if (elBadgeEnergy) elBadgeEnergy.textContent = eVal;
    if (elBadgeVel) elBadgeVel.textContent = vVal;
    if (elBadgeAlpha) elBadgeAlpha.textContent = (state.placed || state.animPhase === 'complete') ? roundN(alphaDeg(), 0) : '0';
    if (elBadgeBeta) elBadgeBeta.textContent = state.animPhase === 'complete' ? roundN(state.finalAngle, 1) : '0';
  }

  function resetTest() {
    if (animRAF) { cancelAnimationFrame(animRAF); animRAF = null; }
    state.animPhase = 'idle';
    state.animProgress = 0;
    state.placed = false;
    state.fractured = false;
    state.fractureParts = [];
    state.pendulumAngle = 0;
    state.releaseAngle = degToRad(state.alpha);
    state.impactFlashAlpha = 0;
    state.tongsProgress = 0;
    state.dialNeedleAngle = 0;
    state.absorbedEnergy = 0;
    state.shearFrac = 0;
    state.lateralExp = 0;
    state.unbroken = false;
    state.overCapacity = false;
    state.notchInvalid = false;
    state.finalAngle = 0;
    state.results = null;
    setGraphMode('angle-time', false);
    state.angleTimeData = [];
    state.anglePlotIdx = 0;
    state.labStep = 0;
    if (elBtnPlace) elBtnPlace.disabled = false;
    if (elBtnRelease) elBtnRelease.disabled = true;
    hide(elResultsRow);
    hide($('validity-note'));
    hide($('inference-panel'));
    buildLabSteps();
    updateLearnPanels();
    drawMachine();
    drawGraph();
    updateBadges();
    if (typeof updateGuideBlink === 'function') updateGuideBlink();
  }

  /* ================================================================
     S14 — MODE SWITCHING
     ================================================================ */
  function setMode(m) {
    state.mode = m;
    var modePills = $('mode-tabs');
    if (modePills) {
      var pills = modePills.querySelectorAll('.pill');
      for (var pi = 0; pi < pills.length; pi++) {
        pills[pi].classList.toggle('active', pills[pi].dataset.value === m);
      }
    }
    if (elSimWrapper) elSimWrapper.style.display = m === 'simulate' ? '' : 'none';
    if (elExpWrapper) elExpWrapper.style.display = m === 'explore' ? '' : 'none';
    if (elPracWrapper) elPracWrapper.style.display = m === 'practice' ? '' : 'none';
    if (elQuizWrapper) elQuizWrapper.style.display = m === 'quiz' ? '' : 'none';

    /* Canvases hidden at init measure 0 wide — size them once revealed. */
    initCanvases();

    if (m === 'explore') {
      buildConceptGrid();
      selectConcept(state.expIdx);
    }
    if (m === 'practice') {
      if (!state.pProb) newPractice();
    }
    if (m === 'quiz') {
      if (state.qSet.length === 0) startQuiz();
    }
    if (m === 'simulate') {
      drawMachine();
      drawGraph();
    }
  }

  /* ================================================================
     S15 — EXPLORE MODE
     ================================================================ */
  var EXPLORE_CATS = [
    { id: 'components', label: 'Components' },
    { id: 'standards', label: 'Standards' },
    { id: 'properties', label: 'Properties' },
    { id: 'failure', label: 'Failure Analysis' }
  ];

  function buildCatTabs() {
    if (!elExpCatTabs) return;
    elExpCatTabs.innerHTML = '';
    EXPLORE_CATS.forEach(function (cat) {
      var btn = document.createElement('button');
      btn.className = 'pill' + (cat.id === state.expCat ? ' active' : '');
      btn.textContent = cat.label;
      btn.dataset.cat = cat.id;
      btn.addEventListener('click', function () {
        state.expCat = this.dataset.cat;
        var pills = elExpCatTabs.querySelectorAll('.pill');
        for (var pi = 0; pi < pills.length; pi++) pills[pi].classList.remove('active');
        this.classList.add('active');
        buildConceptGrid();
        var firstInCat = CONCEPTS.findIndex(function (c) { return c.cat === state.expCat; });
        if (firstInCat >= 0) { state.expIdx = firstInCat; selectConcept(firstInCat); }
      });
      elExpCatTabs.appendChild(btn);
    });
  }

  function buildConceptGrid() {
    if (!elISGrid) return;
    elISGrid.innerHTML = '';
    var filtered = CONCEPTS.filter(function (c) { return c.cat === state.expCat; });
    filtered.forEach(function (c) {
      var absIdx = CONCEPTS.indexOf(c);
      var btn = document.createElement('button');
      btn.className = 'is-btn' + (absIdx === state.expIdx ? ' active' : '');
      btn.innerHTML = '<span class="is-btn-name">' + c.name + '</span><span class="is-btn-sym">' + c.symbol + '</span>';
      btn.addEventListener('click', function () {
        state.expIdx = absIdx;
        buildConceptGrid();
        selectConcept(absIdx);
      });
      elISGrid.appendChild(btn);
    });
  }

  function selectConcept(idx) {
    var c = CONCEPTS[idx];
    if (!c) return;
    if (elIIName) elIIName.textContent = c.name;
    if (elIIDesc) elIIDesc.textContent = c.desc;
    if (elFormulaBox) {
      if (c.formula && c.formula !== '\u2014') {
        show(elFormulaBox);
        if (elFBFormula) elFBFormula.textContent = c.formula;
        if (elFBUnit) elFBUnit.textContent = c.unit;
      } else { hide(elFormulaBox); }
    }
    if (elExampleBox && elEBBody) {
      if (c.example) {
        show(elExampleBox);
        var html = '';
        if (c.example.problem) html += '<p class="eb-problem">' + c.example.problem + '</p>';
        if (c.example.steps) c.example.steps.forEach(function (s) { html += '<div class="eb-step">' + s + '</div>'; });
        elEBBody.innerHTML = html;
      } else { hide(elExampleBox); }
    }
    drawExploreDiagram(c);
  }

  function drawExploreDiagram(concept) {
    if (!eCtx) return;
    eCtx.clearRect(0, 0, EW, EH);
    eCtx.fillStyle = '#0d1117';
    eCtx.fillRect(0, 0, EW, EH);
    eCtx.strokeStyle = 'rgba(42,48,80,0.12)';
    eCtx.lineWidth = 0.5;
    for (var gx = 0; gx < EW; gx += 30) { eCtx.beginPath(); eCtx.moveTo(gx, 0); eCtx.lineTo(gx, EH); eCtx.stroke(); }
    for (var gy = 0; gy < EH; gy += 30) { eCtx.beginPath(); eCtx.moveTo(0, gy); eCtx.lineTo(EW, gy); eCtx.stroke(); }
    var cx = EW / 2, cy = EH / 2;
    switch (concept.id) {
      case 'pendulum-striker': drawExplorePendulum(cx, cy); break;
      case 'specimen-notch': drawExploreNotches(cx, cy); break;
      case 'anvil-supports': drawExploreAnvilSupports(cx, cy); break;
      case 'astm-e23': drawExploreASTME23(cx, cy); break;
      case 'iso-148': drawExploreISO148(cx, cy); break;
      case 'iso-180': drawExploreISO180(cx, cy); break;
      case 'impact-energy': drawExploreImpactEnergy(cx, cy); break;
      case 'dbtt': drawExploreDBTT(cx, cy); break;
      case 'fracture-toughness': drawExploreFracToughness(cx, cy); break;
      case 'ductile-fracture': drawExploreDuctileFrac(cx, cy); break;
      case 'brittle-fracture': drawExploreBrittleFrac(cx, cy); break;
      case 'mixed-fracture': drawExploreMixedFrac(cx, cy); break;
    }
  }

  function drawExploreTitleLabel(title) {
    eCtx.fillStyle = 'rgba(200,215,240,0.35)';
    eCtx.font = '10px monospace';
    eCtx.textAlign = 'center';
    eCtx.fillText(title, EW / 2, EH - 10);
  }

  /* Explore: Pendulum & Striker */
  function drawExplorePendulum(cx, cy) {
    var px = cx - 50, py = 60;
    /* Frame outline */
    eCtx.strokeStyle = '#607d8b'; eCtx.lineWidth = 3;
    eCtx.strokeRect(cx - 120, 40, 240, 300);
    /* Pivot */
    eCtx.fillStyle = '#90a4ae';
    eCtx.beginPath(); eCtx.arc(px, py, 8, 0, Math.PI * 2); eCtx.fill();
    /* Arm */
    eCtx.strokeStyle = '#78909c'; eCtx.lineWidth = 4; eCtx.lineCap = 'round';
    eCtx.beginPath(); eCtx.moveTo(px, py); eCtx.lineTo(px - 80, py + 200); eCtx.stroke();
    /* Hammer */
    eCtx.fillStyle = '#455a64';
    eCtx.save(); eCtx.translate(px - 80, py + 200); eCtx.rotate(-0.38);
    roundRect(eCtx, -15, -10, 30, 20, 3); eCtx.fill();
    eCtx.fillStyle = '#ff3d00'; eCtx.fillRect(-12, 8, 24, 4);
    eCtx.restore();
    /* Center of mass marker */
    eCtx.fillStyle = '#3ddc84';
    eCtx.beginPath(); eCtx.arc(px - 50, py + 130, 4, 0, Math.PI * 2); eCtx.fill();
    eCtx.lineCap = 'butt';
    /* Labels */
    eCtx.fillStyle = '#dde3f0'; eCtx.font = '600 11px "Segoe UI", system-ui, sans-serif'; eCtx.textAlign = 'left';
    eCtx.fillText('Pivot Point', cx + 50, py);
    eCtx.fillText('Pendulum Arm (R)', cx + 50, py + 80);
    eCtx.fillText('Center of Mass', cx + 50, py + 130);
    eCtx.fillText('Striker / Hammer', cx + 50, py + 200);
    eCtx.fillStyle = '#ffb74d'; eCtx.font = '10px monospace';
    eCtx.fillText('E = mgR(1 \u2212 cos\u03b1)', cx + 50, py + 240);
    /* Annotation lines */
    eCtx.strokeStyle = '#8b9dc3'; eCtx.lineWidth = 0.8; eCtx.setLineDash([3, 3]);
    eCtx.beginPath(); eCtx.moveTo(px + 8, py); eCtx.lineTo(cx + 48, py); eCtx.stroke();
    eCtx.beginPath(); eCtx.moveTo(px - 45, py + 130); eCtx.lineTo(cx + 48, py + 130); eCtx.stroke();
    eCtx.beginPath(); eCtx.moveTo(px - 65, py + 200); eCtx.lineTo(cx + 48, py + 200); eCtx.stroke();
    eCtx.setLineDash([]);
    drawExploreTitleLabel('Pendulum & Striker Components');
  }

  /* Explore: Notch Types */
  function drawExploreNotches(cx, cy) {
    var notches = [
      { name: 'V-Notch (Type A)', depth: '2 mm', angle: '45\u00b0', radius: '0.25 mm' },
      { name: 'U-Notch (Type C)', depth: '5 mm', angle: '\u2014', radius: '1 mm' },
      { name: 'Keyhole', depth: '2.5 mm', angle: '\u2014', radius: '1 mm' }
    ];
    for (var ni = 0; ni < 3; ni++) {
      var nx = cx - 250 + ni * 250, ny = cy;
      /* Specimen block */
      eCtx.fillStyle = '#607d8b';
      eCtx.fillRect(nx - 40, ny - 30, 80, 60);
      /* Notch */
      eCtx.fillStyle = '#0d1117';
      if (ni === 0) {
        eCtx.beginPath();
        eCtx.moveTo(nx - 8, ny + 30); eCtx.lineTo(nx, ny + 30 - 20); eCtx.lineTo(nx + 8, ny + 30);
        eCtx.closePath(); eCtx.fill();
      } else if (ni === 1) {
        eCtx.beginPath();
        eCtx.moveTo(nx - 10, ny + 30); eCtx.lineTo(nx - 10, ny + 30 - 35);
        eCtx.arc(nx, ny + 30 - 35, 10, Math.PI, 0);
        eCtx.lineTo(nx + 10, ny + 30); eCtx.closePath(); eCtx.fill();
      } else {
        eCtx.beginPath();
        eCtx.moveTo(nx - 4, ny + 30); eCtx.lineTo(nx - 4, ny + 30 - 18);
        eCtx.arc(nx, ny + 30 - 22, 7, Math.PI, Math.PI * 3, true);
        eCtx.lineTo(nx + 4, ny + 30); eCtx.closePath(); eCtx.fill();
      }
      /* Labels */
      eCtx.fillStyle = '#ff3d00'; eCtx.font = 'bold 11px "Segoe UI", system-ui, sans-serif'; eCtx.textAlign = 'center';
      eCtx.fillText(notches[ni].name, nx, ny - 50);
      eCtx.fillStyle = '#ffb74d'; eCtx.font = '9px monospace';
      eCtx.fillText('Depth: ' + notches[ni].depth, nx, ny + 50);
      eCtx.fillText('Angle: ' + notches[ni].angle, nx, ny + 62);
      eCtx.fillText('Radius: ' + notches[ni].radius, nx, ny + 74);
    }
    drawExploreTitleLabel('Standard Notch Types (ASTM E23)');
  }

  /* Explore: Anvil & Supports */
  function drawExploreAnvilSupports(cx, cy) {
    /* Charpy - left side */
    var lx = cx - 180, ly = cy;
    eCtx.fillStyle = '#ff3d00'; eCtx.font = 'bold 12px "Segoe UI", system-ui, sans-serif'; eCtx.textAlign = 'center';
    eCtx.fillText('CHARPY', lx, ly - 80);
    /* Specimen horizontal */
    eCtx.fillStyle = '#b0bec5';
    eCtx.fillRect(lx - 50, ly - 6, 100, 12);
    /* Notch */
    eCtx.fillStyle = '#0d1117';
    eCtx.beginPath(); eCtx.moveTo(lx - 4, ly + 6); eCtx.lineTo(lx, ly - 2); eCtx.lineTo(lx + 4, ly + 6); eCtx.closePath(); eCtx.fill();
    /* Supports */
    eCtx.fillStyle = '#607d8b';
    eCtx.beginPath(); eCtx.moveTo(lx - 30, ly + 6); eCtx.lineTo(lx - 35, ly + 30); eCtx.lineTo(lx - 25, ly + 30); eCtx.closePath(); eCtx.fill();
    eCtx.beginPath(); eCtx.moveTo(lx + 30, ly + 6); eCtx.lineTo(lx + 25, ly + 30); eCtx.lineTo(lx + 35, ly + 30); eCtx.closePath(); eCtx.fill();
    /* Strike arrow */
    eCtx.strokeStyle = '#ff3d00'; eCtx.lineWidth = 2;
    eCtx.beginPath(); eCtx.moveTo(lx, ly - 50); eCtx.lineTo(lx, ly - 15); eCtx.stroke();
    eCtx.beginPath(); eCtx.moveTo(lx - 5, ly - 22); eCtx.lineTo(lx, ly - 15); eCtx.lineTo(lx + 5, ly - 22); eCtx.stroke();
    eCtx.fillStyle = '#3ddc84'; eCtx.font = '9px monospace';
    eCtx.fillText('40 mm span', lx, ly + 45);
    eCtx.fillText('Strike behind notch', lx, ly + 60);

    /* Izod - right side */
    var rx = cx + 180, ry = cy;
    eCtx.fillStyle = '#ff3d00'; eCtx.font = 'bold 12px "Segoe UI", system-ui, sans-serif';
    eCtx.fillText('IZOD', rx, ry - 80);
    /* Specimen vertical */
    eCtx.fillStyle = '#b0bec5';
    eCtx.fillRect(rx - 6, ry - 50, 12, 80);
    /* Notch on left */
    eCtx.fillStyle = '#0d1117';
    eCtx.beginPath(); eCtx.moveTo(rx - 6, ry - 15); eCtx.lineTo(rx + 2, ry - 10); eCtx.lineTo(rx - 6, ry - 5); eCtx.closePath(); eCtx.fill();
    /* Vice jaws */
    eCtx.fillStyle = '#607d8b';
    eCtx.fillRect(rx - 25, ry, 19, 35);
    eCtx.fillRect(rx + 6, ry, 19, 35);
    /* Strike arrow */
    eCtx.strokeStyle = '#ff3d00'; eCtx.lineWidth = 2;
    eCtx.beginPath(); eCtx.moveTo(rx - 40, ry - 10); eCtx.lineTo(rx - 12, ry - 10); eCtx.stroke();
    eCtx.beginPath(); eCtx.moveTo(rx - 18, ry - 15); eCtx.lineTo(rx - 12, ry - 10); eCtx.lineTo(rx - 18, ry - 5); eCtx.stroke();
    eCtx.fillStyle = '#3ddc84'; eCtx.font = '9px monospace';
    eCtx.fillText('Cantilever clamp', rx, ry + 55);
    eCtx.fillText('Strike at notch', rx, ry + 70);

    drawExploreTitleLabel('Charpy vs Izod Configuration');
  }

  /* Explore: ASTM E23 */
  function drawExploreASTME23(cx, cy) {
    /* Standard specimen */
    var sx = cx - 100, sy = cy - 15, sw = 200, sh = 30;
    eCtx.fillStyle = '#607d8b';
    eCtx.fillRect(sx, sy, sw, sh);
    /* V-notch */
    eCtx.fillStyle = '#0d1117';
    eCtx.beginPath(); eCtx.moveTo(cx - 5, sy + sh); eCtx.lineTo(cx, sy + sh - 12); eCtx.lineTo(cx + 5, sy + sh); eCtx.closePath(); eCtx.fill();
    /* Dimensions */
    eCtx.strokeStyle = '#3ddc84'; eCtx.lineWidth = 1; eCtx.setLineDash([3, 3]);
    /* Length */
    eCtx.beginPath(); eCtx.moveTo(sx, sy + sh + 15); eCtx.lineTo(sx + sw, sy + sh + 15); eCtx.stroke();
    eCtx.fillStyle = '#3ddc84'; eCtx.font = '10px monospace'; eCtx.textAlign = 'center';
    eCtx.fillText('55 mm', cx, sy + sh + 28);
    /* Height */
    eCtx.beginPath(); eCtx.moveTo(sx - 15, sy); eCtx.lineTo(sx - 15, sy + sh); eCtx.stroke();
    eCtx.fillText('10', sx - 30, cy + 2);
    /* Notch depth */
    eCtx.strokeStyle = '#ffb74d';
    eCtx.beginPath(); eCtx.moveTo(cx + 12, sy + sh); eCtx.lineTo(cx + 12, sy + sh - 12); eCtx.stroke();
    eCtx.fillStyle = '#ffb74d'; eCtx.fillText('2 mm', cx + 30, sy + sh - 4);
    eCtx.setLineDash([]);
    /* Title and labels */
    eCtx.fillStyle = '#ff3d00'; eCtx.font = 'bold 12px "Segoe UI", system-ui, sans-serif';
    eCtx.fillText('ASTM E23 \u2014 Charpy V-Notch Specimen', cx, sy - 35);
    eCtx.fillStyle = '#dde3f0'; eCtx.font = '10px "Segoe UI", system-ui, sans-serif';
    eCtx.fillText('V-notch: 45\u00b0, 2 mm deep, r = 0.25 mm', cx, sy + sh + 50);
    eCtx.fillText('Standard: 10 \u00d7 10 \u00d7 55 mm', cx, sy + sh + 65);
    drawExploreTitleLabel('ASTM E23 Standard Specimen');
  }

  /* Explore: ISO 148 */
  function drawExploreISO148(cx, cy) {
    eCtx.fillStyle = '#ff3d00'; eCtx.font = 'bold 12px "Segoe UI", system-ui, sans-serif'; eCtx.textAlign = 'center';
    eCtx.fillText('ISO 148-1 vs ASTM E23', cx, 50);
    /* Table */
    var headers = ['Parameter', 'ISO 148-1', 'ASTM E23'];
    var rows = [
      ['Specimen', '10\u00d710\u00d755 mm', '10\u00d710\u00d755 mm'],
      ['V-Notch', '2mm, 45\u00b0, r=0.25', '2mm, 45\u00b0, r=0.25'],
      ['Energy Symbol', 'KV or KU', 'CVN'],
      ['Striker Radius', '2 or 8 mm', '8 mm'],
      ['Verification', 'Reference blocks req.', 'Optional']
    ];
    var ty = 80, tx = cx - 200, colW = [100, 120, 120];
    eCtx.fillStyle = 'rgba(255,61,0,0.2)';
    eCtx.fillRect(tx, ty, 340, 22);
    eCtx.fillStyle = '#dde3f0'; eCtx.font = 'bold 10px monospace'; eCtx.textAlign = 'left';
    for (var h = 0; h < 3; h++) eCtx.fillText(headers[h], tx + 5 + (h === 0 ? 0 : h === 1 ? colW[0] : colW[0] + colW[1]), ty + 15);
