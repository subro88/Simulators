    var topW = 4, botW = 7;
    var armEnd = PEND_LEN - 10; /* Connect flush with hammer top */
    mCtx.beginPath();
    mCtx.moveTo(-topW, 0);
    mCtx.lineTo(-botW, armEnd);
    mCtx.lineTo(botW, armEnd);
    mCtx.lineTo(topW, 0);
    mCtx.closePath();
    var armGrad = mCtx.createLinearGradient(-botW, 0, botW, 0);
    armGrad.addColorStop(0, '#37474f');
    armGrad.addColorStop(0.3, '#78909c');
    armGrad.addColorStop(0.7, '#607d8b');
    armGrad.addColorStop(1, '#37474f');
    mCtx.fillStyle = armGrad;
    mCtx.fill();
    /* Highlight stripe */
    mCtx.strokeStyle = 'rgba(255,255,255,0.12)';
    mCtx.lineWidth = 1;
    mCtx.beginPath(); mCtx.moveTo(-topW + 2, 5); mCtx.lineTo(-botW + 2, armEnd - 5); mCtx.stroke();
    mCtx.restore();
  }

  function drawHammer(theta) {
    /* Draw hammer in same rotated coordinate system as the arm */
    mCtx.save();
    mCtx.translate(PIVOT_X, PIVOT_Y);
    mCtx.rotate(theta);

    /* Hammer body — centered at arm end */
    var hw = 28, hh = 22;
    var hammerCenter = PEND_LEN - 10 + hh / 2; /* Flush with arm end */
    var hGrad = mCtx.createLinearGradient(-hw / 2, hammerCenter - hh / 2, hw / 2, hammerCenter - hh / 2);
    hGrad.addColorStop(0, '#263238');
    hGrad.addColorStop(0.3, '#546e7a');
    hGrad.addColorStop(0.7, '#455a64');
    hGrad.addColorStop(1, '#263238');
    mCtx.fillStyle = hGrad;
    roundRect(mCtx, -hw / 2, hammerCenter - hh / 2, hw, hh, 3);
    mCtx.fill();

    /* Striker edge (bottom) */
    mCtx.fillStyle = '#ff3d00';
    mCtx.fillRect(-hw / 2 + 2, hammerCenter + hh / 2 - 3, hw - 4, 3);

    /* Weight marking */
    mCtx.fillStyle = 'rgba(255,255,255,0.08)';
    mCtx.fillRect(-hw / 2 + 3, hammerCenter - hh / 2 + 3, hw - 6, hh / 2 - 3);

    /* Bolt holes */
    mCtx.fillStyle = '#1a1a2e';
    mCtx.beginPath(); mCtx.arc(-hw / 2 + 5, hammerCenter, 2, 0, Math.PI * 2); mCtx.fill();
    mCtx.beginPath(); mCtx.arc(hw / 2 - 5, hammerCenter, 2, 0, Math.PI * 2); mCtx.fill();

    mCtx.restore();
  }

  function drawProtractor() {
    mCtx.save();
    mCtx.translate(PIVOT_X, PIVOT_Y);

    var innerR = PEND_LEN * 0.12;
    var outerR = PEND_LEN * 0.18;

    /* Scale arc background */
    mCtx.strokeStyle = 'rgba(100,120,160,0.15)';
    mCtx.lineWidth = outerR - innerR;
    mCtx.beginPath();
    mCtx.arc(0, 0, (innerR + outerR) / 2, -Math.PI * 0.95, Math.PI * 0.95);
    mCtx.stroke();

    /* Tick marks */
    for (var deg = -150; deg <= 150; deg += 10) {
      var rad = degToRad(deg);
      var cos = Math.cos(rad + Math.PI / 2);
      var sin = Math.sin(rad + Math.PI / 2);
      var isMajor = deg % 30 === 0;
      var r1 = isMajor ? innerR - 2 : innerR + 2;
      var r2 = outerR + (isMajor ? 4 : 0);

      mCtx.strokeStyle = isMajor ? 'rgba(200,215,240,0.5)' : 'rgba(200,215,240,0.2)';
      mCtx.lineWidth = isMajor ? 1.2 : 0.6;
      mCtx.beginPath();
      mCtx.moveTo(-sin * r1, cos * r1);
      mCtx.lineTo(-sin * r2, cos * r2);
      mCtx.stroke();

      if (isMajor && deg !== 0) {
        mCtx.fillStyle = 'rgba(200,215,240,0.4)';
        mCtx.font = '8px monospace';
        mCtx.textAlign = 'center';
        mCtx.textBaseline = 'middle';
        mCtx.fillText(Math.abs(deg) + '\u00b0', -sin * (outerR + 14), cos * (outerR + 14));
      }
