      for (var ci = 0; ci < 3; ci++) eCtx.fillText(rows[ri][ci], tx + 5 + (ci === 0 ? 0 : ci === 1 ? colW[0] : colW[0] + colW[1]), ry + 15);
    }
    drawExploreTitleLabel('ISO 148-1 International Standard');
  }

  /* Explore: ISO 180 */
  function drawExploreISO180(cx, cy) {
    /* Izod specimen diagram */
    var sx = cx, sy = cy;
    eCtx.fillStyle = '#90caf9'; eCtx.fillRect(sx - 6, sy - 60, 12, 90);
