  /* ── Custom Material Modal ── */
  var CM_FIELDS = [
    { key: 'name',       label: 'Material Name',       type: 'text',   min: null, max: null, uType: '', impFactor: 1 },
    { key: 'energyRT',   label: 'Energy at RT',         type: 'number', min: 1,    max: 500, uType: 'energy', impFactor: 0.7376 },
    { key: 'DBTT',       label: 'DBTT (blank if none)',  type: 'number', min: -200, max: 200, uType: 'temp', impFactor: 0 },
    { key: 'upperShelf', label: 'Upper Shelf Energy',    type: 'number', min: 1,    max: 600, uType: 'energy', impFactor: 0.7376 },
    { key: 'lowerShelf', label: 'Lower Shelf Energy',    type: 'number', min: 0,    max: 100, uType: 'energy', impFactor: 0.7376 },
    { key: 'density',    label: 'Density',               type: 'number', min: 100,  max: 25000, uType: 'density', impFactor: 0.06243 }
  ];

  function openCustomMaterialModal() {
    var overlay = document.createElement('div');
    overlay.className = 'cm-overlay';
    var modal = document.createElement('div');
    modal.className = 'cm-modal';
    var isImp = unitSystem === 'imperial';

    modal.innerHTML =
      '<div class="cm-title">Custom Material</div>' +
      '<div class="cm-subtitle">Enter impact test properties' + (isImp ? ' (Imperial)' : ' (SI)') + '. All fields required except DBTT.</div>' +
      '<div class="cm-grid" id="cm-grid"></div>' +
      '<div class="cm-error-msg" id="cm-error"></div>' +
      '<div class="cm-actions">' +
        '<button class="btn ghost" id="cm-cancel">Cancel</button>' +
        '<button class="btn primary" id="cm-submit">Add Material</button>' +
      '</div>';

    overlay.appendChild(modal);
    document.body.appendChild(overlay);

    var grid = modal.querySelector('#cm-grid');
    for (var fi = 0; fi < CM_FIELDS.length; fi++) {
      var f = CM_FIELDS[fi];
      var field = document.createElement('div');
      field.className = 'cm-field' + (f.key === 'name' ? ' full' : '');
      var unitLabel = '';
      if (f.uType === 'energy') unitLabel = isImp ? 'ft\u00B7lbf' : 'J';
      else if (f.uType === 'temp') unitLabel = isImp ? '\u00B0F' : '\u00B0C';
      else if (f.uType === 'density') unitLabel = isImp ? 'lb/ft\u00B3' : 'kg/m\u00B3';

      field.innerHTML =
        '<span class="cm-label">' + f.label + (unitLabel ? ' (' + unitLabel + ')' : '') + '</span>' +
        '<input class="cm-input" id="cm-' + f.key + '" type="' + f.type + '"' +
        (f.type === 'number' ? ' step="any"' : '') +
        ' placeholder="' + (f.key === 'name' ? 'e.g. Titanium Ti-6Al-4V' : f.key === 'DBTT' ? 'Leave empty if FCC/no transition' : '') + '">';
      grid.appendChild(field);
    }

    modal.querySelector('#cm-cancel').addEventListener('click', function () { overlay.remove(); });
    overlay.addEventListener('click', function (e) { if (e.target === overlay) overlay.remove(); });

    modal.querySelector('#cm-submit').addEventListener('click', function () {
      var errEl = modal.querySelector('#cm-error');
      errEl.textContent = '';
      var vals = {};
      var isImpNow = unitSystem === 'imperial';

      for (var vi = 0; vi < CM_FIELDS.length; vi++) {
        var cf = CM_FIELDS[vi];
        var inp = modal.querySelector('#cm-' + cf.key);
        var raw = inp.value.trim();
        inp.classList.remove('error');

        /* DBTT is optional */
        if (!raw && cf.key === 'DBTT') { vals.DBTT = null; continue; }
        if (!raw && cf.key !== 'DBTT') {
          inp.classList.add('error');
          errEl.textContent = cf.label + ' is required.';
          inp.focus(); return;
        }

        if (cf.type === 'number') {
          var num = parseFloat(raw);
          if (isNaN(num)) {
            inp.classList.add('error');
            errEl.textContent = cf.label + ': enter a valid number.';
            inp.focus(); return;
          }
          /* Convert from display to SI */
          var siVal;
          if (cf.uType === 'temp' && isImpNow) siVal = (num - 32) / 1.8;
          else if (cf.uType && cf.impFactor && isImpNow) siVal = num / cf.impFactor;
          else siVal = num;
          vals[cf.key] = siVal;
        } else {
          if (raw.length > 20) {
            inp.classList.add('error');
            errEl.textContent = 'Name too long (max 20 characters).';
            inp.focus(); return;
          }
          vals[cf.key] = raw;
        }
      }

      if (vals.upperShelf <= vals.lowerShelf) {
        errEl.textContent = 'Upper shelf must be greater than lower shelf.';
        return;
      }

      if (vals.energyRT < vals.lowerShelf || vals.energyRT > vals.upperShelf) {
        errEl.textContent = 'Energy at RT must lie between the lower and upper shelf.';
        return;
      }
      var curveErr = validateCustomCurve(vals);
      if (curveErr) { errEl.textContent = curveErr; return; }

      var customMat = {
        id: 'custom-' + Date.now(),
        name: vals.name,
        energyRT: vals.energyRT,
        DBTT: vals.DBTT,
        upperShelf: vals.upperShelf,
        lowerShelf: vals.lowerShelf,
        /* Derive the transition width so the sigmoid actually passes through the
           room-temperature energy the user entered — otherwise DBTT, the shelves
           and energyRT would silently contradict each other. */
        transWidth: vals.DBTT !== null ? deriveTransWidth(vals) : 0,
        color: '#e040fb',
        density: vals.density,
        crystal: vals.DBTT !== null ? 'BCC' : 'FCC'
      };

      MATERIALS.push(customMat);
      /* Select the new material, then rebuild so the dropdown includes it. */
      state.matIdx = MATERIALS.length - 1;
      buildMaterialTabs();
      if (elMatSelect) elMatSelect.value = String(state.matIdx);
      state.testPoints = [];
      advanceStep(0);
