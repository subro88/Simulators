  /* ── Export functions (attached to buttons after dynamic creation below) ── */
  function doExportCSV() {
    if (!state.results) return;
    var r = state.results;
    var mat = MATERIALS[state.matIdx];
    var rows = [
      'Material,Method,Notch,Temperature (' + uLabel('temp') + '),Energy (' + uLabel('energy') + '),Toughness (' + uLabel('tough') + '),Velocity (' + uLabel('vel') + '),Alpha (deg),Beta (deg),Shear (%),Lateral (' + uLabel('length') + '),Fracture Type',
      mat.name + ',' + state.method + ',' + state.notch + ',' +
      roundN(toD(state.temperature, 'temp'), 0) + ',' +
      roundN(toD(r.energy, 'energy'), 1) + ',' +
      roundN(toD(r.toughness, 'tough'), 1) + ',' +
      roundN(toD(r.velocity, 'vel'), 2) + ',' +
      roundN(r.alpha, 0) + ',' + roundN(r.beta, 1) + ',' +
      roundN(r.shearFrac, 0) + ',' +
      roundN(toD(r.lateralExp, 'length'), 2) + ',' + r.fracType
    ];
    if (state.testPoints.length > 0) {
      rows.push('');
      rows.push('Temperature (' + uLabel('temp') + '),Energy (' + uLabel('energy') + ')');
      for (var ti = 0; ti < state.testPoints.length; ti++) {
        var tp = state.testPoints[ti];
        rows.push(roundN(toD(tp.T, 'temp'), 0) + ',' + roundN(toD(tp.E, 'energy'), 1));
      }
    }
    var blob = new Blob([rows.join('\n')], { type: 'text/csv' });
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url;
    a.download = 'impact-' + mat.id + '-' + state.method + '.csv';
    a.click();
    URL.revokeObjectURL(url);
  }

  function doExportPNG() {
    if (!gCanvas) return;
    var tmp = document.createElement('canvas');
    tmp.width = gCanvas.width; tmp.height = gCanvas.height;
    var tc = tmp.getContext('2d');
    tc.drawImage(gCanvas, 0, 0);
