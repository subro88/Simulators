  /* Explore: DBTT Curve */
  function drawExploreDBTT(cx, cy) {
    var ox = 120, oy = EH - 60, gw = EW - 200, gh = EH - 120;
    /* Axes */
    eCtx.strokeStyle = 'rgba(200,215,240,0.5)'; eCtx.lineWidth = 1.5;
    eCtx.beginPath(); eCtx.moveTo(ox, oy - gh); eCtx.lineTo(ox, oy); eCtx.lineTo(ox + gw, oy); eCtx.stroke();
    eCtx.fillStyle = 'rgba(200,215,240,0.5)'; eCtx.font = '10px monospace'; eCtx.textAlign = 'center';
    eCtx.fillText('Temperature (\u00b0C)', ox + gw / 2, oy + 30);
    eCtx.save(); eCtx.translate(30, oy - gh / 2); eCtx.rotate(-Math.PI / 2);
    eCtx.fillText('Impact Energy (J)', 0, 0); eCtx.restore();
    /* Sigmoid */
    eCtx.strokeStyle = '#ff3d00'; eCtx.lineWidth = 2.5;
    eCtx.beginPath();
    for (var i = 0; i <= 100; i++) {
      var t = -200 + i * 4;
      var e = tanhSigmoid(t, 10, 160, -20, 25);
      var x = ox + ((t + 200) / 400) * gw;
      var y = oy - (e / 200) * gh;
      if (i === 0) eCtx.moveTo(x, y); else eCtx.lineTo(x, y);
    }
    eCtx.stroke();
    /* Shelf lines */
    eCtx.setLineDash([5, 4]);
    eCtx.strokeStyle = '#3ddc84'; eCtx.lineWidth = 1;
    var usY = oy - (160 / 200) * gh;
    eCtx.beginPath(); eCtx.moveTo(ox, usY); eCtx.lineTo(ox + gw, usY); eCtx.stroke();
    eCtx.fillStyle = '#3ddc84'; eCtx.font = '9px monospace'; eCtx.textAlign = 'left';
    eCtx.fillText('Upper Shelf', ox + gw - 80, usY - 5);
    eCtx.strokeStyle = '#ff5555';
    var lsY = oy - (10 / 200) * gh;
    eCtx.beginPath(); eCtx.moveTo(ox, lsY); eCtx.lineTo(ox + gw, lsY); eCtx.stroke();
    eCtx.fillStyle = '#ff5555'; eCtx.fillText('Lower Shelf', ox + gw - 80, lsY + 12);
    /* DBTT line */
    eCtx.strokeStyle = '#ffb74d';
    var dbttX = ox + ((-20 + 200) / 400) * gw;
    eCtx.beginPath(); eCtx.moveTo(dbttX, oy); eCtx.lineTo(dbttX, oy - gh); eCtx.stroke();
    eCtx.setLineDash([]);
    eCtx.fillStyle = '#ffb74d'; eCtx.font = 'bold 10px monospace'; eCtx.textAlign = 'center';
    eCtx.fillText('DBTT', dbttX, oy - gh - 5);
    /* Zone labels */
    eCtx.fillStyle = 'rgba(200,215,240,0.3)'; eCtx.font = '9px monospace';
    eCtx.fillText('Brittle', ox + 60, oy - gh / 2 + 40);
    eCtx.fillText('Transition', dbttX, oy - gh / 2 + 40);
    eCtx.fillText('Ductile', ox + gw - 80, oy - gh / 2 + 40);
    /* BCC vs FCC note */
    eCtx.fillStyle = '#dde3f0'; eCtx.font = '10px "Segoe UI", system-ui, sans-serif'; eCtx.textAlign = 'center';
    eCtx.fillText('BCC metals show DBTT; FCC metals remain ductile at all temperatures', cx, oy + 45);
    drawExploreTitleLabel('Ductile-Brittle Transition Temperature');
  }

  /* Explore: Fracture Toughness */
  function drawExploreFracToughness(cx, cy) {
    var ox = 150, oy = EH - 80, gw = EW - 300, gh = EH - 160;
    eCtx.strokeStyle = 'rgba(200,215,240,0.5)'; eCtx.lineWidth = 1.5;
    eCtx.beginPath(); eCtx.moveTo(ox, oy - gh); eCtx.lineTo(ox, oy); eCtx.lineTo(ox + gw, oy); eCtx.stroke();
    eCtx.fillStyle = 'rgba(200,215,240,0.5)'; eCtx.font = '10px monospace'; eCtx.textAlign = 'center';
    eCtx.fillText('CVN Energy (J)', ox + gw / 2, oy + 25);
    eCtx.save(); eCtx.translate(60, oy - gh / 2); eCtx.rotate(-Math.PI / 2);
    eCtx.fillText('K\u1d62\u1d04 (MPa\u221am)', 0, 0); eCtx.restore();
    /* Correlation curve */
    eCtx.strokeStyle = '#ff3d00'; eCtx.lineWidth = 2;
