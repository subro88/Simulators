  function drawFractureSurface() {
    if (!state.results) return;
    /* Anchored in MACHINE space (M_MAXX / M_MAXY), not canvas space. Using
       MW / MACHINE_H here placed the inset at machine y 725 — below the
       artwork's own bottom of 675 — which the fit transform then mapped clean
       off the bottom edge of the canvas. */
    var bw = 130, bh = 100;
    var bx = M_MAXX - bw - 14, by = M_MAXY - bh - 14;
    roundRect(mCtx, bx, by, bw, bh, 4);
    mCtx.fillStyle = 'rgba(13,17,23,0.92)';
    mCtx.fill();
    mCtx.strokeStyle = 'rgba(255,61,0,0.4)';
    mCtx.lineWidth = 1;
    mCtx.stroke();

    mCtx.fillStyle = '#ff3d00';
    mCtx.font = 'bold 8px monospace';
    mCtx.textAlign = 'left';
    mCtx.fillText('Fracture Surface', bx + 6, by + 14);
    mCtx.fillStyle = 'rgba(200,215,240,0.55)';
    mCtx.font = '7px monospace';
    mCtx.fillText((state.results.specWidth || FULL_WIDTH) + ' \u00D7 ' +
      roundN(Math.max(0.1, CHARPY_SPEC.height - effNotch(state.notch, state.results.notchCond).depth), 1) +
      ' mm ligament', bx + 6, by + 24);

    var shearPct = state.results.shearFrac;
    var cx = bx + bw / 2, cy = by + 55;
    /* This inset is the broken FACE, i.e. the ligament: specimen thickness B
       across, (height - notch depth) tall. It is the one view in which sub-size
       thickness is actually visible, so it must scale with it. */
    var rw = state.results.specWidth || FULL_WIDTH;
    var rLig = Math.max(0.1, CHARPY_SPEC.height - effNotch(state.notch, state.results.notchCond).depth);
    var sw = 40 * (rw / FULL_WIDTH);
    var sh = 35 * (rLig / CHARPY_SPEC.height);

    /* Cross-section rectangle */
    mCtx.strokeStyle = 'rgba(200,215,240,0.3)';
    mCtx.lineWidth = 0.8;
    mCtx.strokeRect(cx - sw / 2, cy - sh / 2, sw, sh);

    if (shearPct >= 80) {
      /* Ductile: fibrous center + shear lips */
      mCtx.fillStyle = '#8d6e63';
      mCtx.fillRect(cx - sw / 2, cy - sh / 2, sw, sh);
      /* Wavy lines for fibrous texture */
      mCtx.strokeStyle = 'rgba(255,200,150,0.4)';
      mCtx.lineWidth = 0.6;
      for (var wi = 0; wi < 6; wi++) {
        var wy = cy - sh / 2 + 5 + wi * 5;
        mCtx.beginPath();
        for (var wx = cx - sw / 2; wx < cx + sw / 2; wx += 3) {
          var yOff = Math.sin(wx * 0.5 + wi) * 1.5;
          if (wx === cx - sw / 2) mCtx.moveTo(wx, wy + yOff);
          else mCtx.lineTo(wx, wy + yOff);
        }
        mCtx.stroke();
      }
      /* Shear lips at edges */
      mCtx.fillStyle = 'rgba(255,160,100,0.4)';
      mCtx.fillRect(cx - sw / 2, cy - sh / 2, 4, sh);
      mCtx.fillRect(cx + sw / 2 - 4, cy - sh / 2, 4, sh);
    } else if (shearPct <= 20) {
      /* Brittle: granular texture */
      mCtx.fillStyle = '#78909c';
      mCtx.fillRect(cx - sw / 2, cy - sh / 2, sw, sh);
      /* Stippled dots */
      mCtx.fillStyle = 'rgba(200,215,240,0.3)';
      for (var di = 0; di < 60; di++) {
        var dx = cx - sw / 2 + 2 + Math.random() * (sw - 4);
        var dy = cy - sh / 2 + 2 + Math.random() * (sh - 4);
        mCtx.fillRect(dx, dy, 1.2, 1.2);
      }
      /* Cleavage lines */
      mCtx.strokeStyle = 'rgba(200,215,240,0.2)';
      mCtx.lineWidth = 0.4;
      for (var ci = 0; ci < 5; ci++) {
        mCtx.beginPath();
        mCtx.moveTo(cx, cy);
        mCtx.lineTo(cx + (Math.random() - 0.5) * sw, cy + (Math.random() - 0.5) * sh);
        mCtx.stroke();
      }
    } else {
      /* Mixed: outer shear + inner cleavage */
      /* Inner cleavage */
      var innerW = sw * (1 - shearPct / 100);
      mCtx.fillStyle = '#78909c';
      mCtx.fillRect(cx - innerW / 2, cy - sh / 2 + 3, innerW, sh - 6);
      /* Stipple */
      mCtx.fillStyle = 'rgba(200,215,240,0.2)';
      for (var mi = 0; mi < 20; mi++) {
        mCtx.fillRect(cx - innerW / 2 + Math.random() * innerW, cy - sh / 2 + 4 + Math.random() * (sh - 8), 1, 1);
      }
      /* Outer shear */
      mCtx.fillStyle = '#8d6e63';
      mCtx.fillRect(cx - sw / 2, cy - sh / 2, (sw - innerW) / 2, sh);
      mCtx.fillRect(cx + innerW / 2, cy - sh / 2, (sw - innerW) / 2, sh);
    }

    /* Label */
    mCtx.fillStyle = '#dde3f0';
    mCtx.font = '8px monospace';
    mCtx.textAlign = 'center';
    mCtx.fillText('Shear: ' + roundN(shearPct, 0) + '%', cx, by + bh - 6);
  }

