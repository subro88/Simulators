  /* ── Impact sound (Web Audio API) ── */
  var audioCtx = null;
  function ensureAudio() {
    if (!audioCtx) {
      try { audioCtx = new (window.AudioContext || window.webkitAudioContext)(); }
      catch (e) { /* unavailable */ }
    }
    if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();
    return audioCtx;
  }
  document.addEventListener('pointerdown', function () { ensureAudio(); }, { once: true });

  function playImpactSound() {
    var ctx = ensureAudio();
    if (!ctx) return;
    var now = ctx.currentTime;

    /* Metal clang — filtered noise burst */
    var len = 0.08;
    var buf = ctx.createBuffer(1, Math.ceil(ctx.sampleRate * len), ctx.sampleRate);
    var data = buf.getChannelData(0);
    for (var i = 0; i < data.length; i++) data[i] = (Math.random() * 2 - 1) * 0.7;
    var src = ctx.createBufferSource();
    src.buffer = buf;
    var bpf = ctx.createBiquadFilter();
    bpf.type = 'bandpass'; bpf.frequency.value = 3000; bpf.Q.value = 1.2;
    var gain = ctx.createGain();
    gain.gain.setValueAtTime(0.5, now);
    gain.gain.exponentialRampToValueAtTime(0.001, now + len);
    src.connect(bpf); bpf.connect(gain); gain.connect(ctx.destination);
    src.start(now); src.stop(now + len);

    /* Low thud */
    var osc = ctx.createOscillator();
    osc.type = 'sine';
    osc.frequency.setValueAtTime(120, now);
    osc.frequency.exponentialRampToValueAtTime(40, now + 0.12);
    var tg = ctx.createGain();
    tg.gain.setValueAtTime(0.4, now);
    tg.gain.exponentialRampToValueAtTime(0.001, now + 0.15);
    osc.connect(tg); tg.connect(ctx.destination);
    osc.start(now); osc.stop(now + 0.18);
  }

