  function drawPivot() {
    /* Bearing housing */
    var g = mCtx.createRadialGradient(PIVOT_X, PIVOT_Y, 2, PIVOT_X, PIVOT_Y, 14);
    g.addColorStop(0, '#90a4ae');
    g.addColorStop(0.5, '#607d8b');
    g.addColorStop(1, '#37474f');
    mCtx.fillStyle = g;
    mCtx.beginPath(); mCtx.arc(PIVOT_X, PIVOT_Y, 14, 0, Math.PI * 2); mCtx.fill();
    /* Inner bearing */
    mCtx.fillStyle = '#263238';
    mCtx.beginPath(); mCtx.arc(PIVOT_X, PIVOT_Y, 6, 0, Math.PI * 2); mCtx.fill();
    /* Center pin */
    mCtx.fillStyle = '#b0bec5';
    mCtx.beginPath(); mCtx.arc(PIVOT_X, PIVOT_Y, 3, 0, Math.PI * 2); mCtx.fill();
  }

  function drawPendulumArm(theta) {
    mCtx.save();
    mCtx.translate(PIVOT_X, PIVOT_Y);
