    eCtx.fill();
    eCtx.fillStyle = '#ff5555';
    eCtx.font = '11px sans-serif';
    eCtx.fillText('FAILURE', ox + gw * 0.55, oy - gh * 0.7);

    eCtx.fillStyle = '#5e35b1';
    eCtx.font = 'bold 13px monospace';
    eCtx.fillText('\u03c3_a/Se + \u03c3_m/\u03c3_u = 1', cx, 55);
