  function escFat(s) {
    if (s === null || s === undefined) return '';
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;')
      .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  /* Parse strings like "1.2e5", "1,234,567", "∞ (>10⁷)" back to a number */
  function parseCycleString(s) {
    if (typeof s === 'number') return s;
    if (!s || typeof s !== 'string') return NaN;
    if (s.indexOf('∞') > -1 || s.indexOf('∞') > -1) return Infinity;
    var cleaned = s.replace(/,/g, '').replace(/\s+/g, '');
    var n = parseFloat(cleaned);
    return isFinite(n) ? n : NaN;
  }

  /* Build a light-theme S-N (Wöhler) curve image for the report */
  function buildFatigueSNSnapshot(mat) {
    var W = 1100, H = 520;
    var c = document.createElement('canvas');
    c.width = W; c.height = H;
    var x = c.getContext('2d');
    x.fillStyle = '#ffffff'; x.fillRect(0, 0, W, H);

    /* Title */
    x.fillStyle = '#0d47a1';
    x.font = 'bold 18px "Segoe UI", system-ui, sans-serif';
    x.textAlign = 'center';
    x.fillText('S–N Curve (Wöhler diagram)', W / 2, 22);
    x.fillStyle = '#37474f';
    x.font = '12px "Segoe UI", sans-serif';
    x.fillText(mat.name + '  —  fully-reversed rotating bending, R = −1',
      W / 2, 42);

    var padL = 80, padR = 30, padT = 60, padB = 60;
    var pw = W - padL - padR, ph = H - padT - padB;

    /* Log10 N axis from 10^2 to 10^8 */
    var logNmin = 2, logNmax = 8;
    /* Stress axis from 0 to 1.1 * Sᵤ */
    var sMax = mat.sigmaU * 1.1;

    /* Grid + ticks */
    x.strokeStyle = '#cfd8dc';
    x.lineWidth = 0.6;
    x.font = '11px "Courier New", monospace';
    x.fillStyle = '#455a64';
    x.textAlign = 'right';
    for (var gy = 0; gy <= 5; gy++) {
      var y0 = padT + ph - (gy / 5) * ph;
      x.beginPath(); x.moveTo(padL, y0); x.lineTo(padL + pw, y0); x.stroke();
      x.fillText(Math.round((gy / 5) * sMax), padL - 6, y0 + 4);
    }
    x.textAlign = 'center';
    for (var dec = logNmin; dec <= logNmax; dec++) {
      var x0 = padL + ((dec - logNmin) / (logNmax - logNmin)) * pw;
      x.beginPath(); x.moveTo(x0, padT); x.lineTo(x0, padT + ph); x.stroke();
      x.fillText('10^' + dec, x0, padT + ph + 16);
    }

    /* Axes */
    x.strokeStyle = '#263238'; x.lineWidth = 1.5;
    x.beginPath();
    x.moveTo(padL, padT); x.lineTo(padL, padT + ph); x.lineTo(padL + pw, padT + ph);
    x.stroke();
    x.fillStyle = '#263238';
    x.font = '600 13px "Segoe UI", sans-serif';
    x.textAlign = 'center';
    x.fillText('Cycles to Failure  N  (log scale)', padL + pw / 2, H - 18);
    x.save();
    x.translate(22, padT + ph / 2);
    x.rotate(-Math.PI / 2);
    x.textAlign = 'center';
    x.fillText('Stress amplitude σₐ  (' + uStress() + ')', 0, 0);
    x.restore();

    /* Curve points via existing generator */
    var curve = generateSNCurve(mat);
    var sx = function (N) {
      var lg = Math.log10(Math.max(1, N));
      return padL + ((lg - logNmin) / (logNmax - logNmin)) * pw;
    };
    var sy = function (s) { return padT + ph - (s / sMax) * ph; };

    /* Plot S-N curve */
    x.strokeStyle = '#1565c0';
    x.lineWidth = 2.5;
    x.beginPath();
    var started = false;
    for (var i = 0; i < curve.length; i++) {
      var pt = curve[i];
      var Nplot = isFinite(pt.N) ? pt.N : 1e7;
      var px = sx(Nplot), py = sy(toStress(pt.sigma));
      if (!started) { x.moveTo(px, py); started = true; }
      else x.lineTo(px, py);
    }
    x.stroke();

    /* Endurance limit horizontal line */
    if (mat.Se && mat.hasEndurance) {
      x.strokeStyle = '#2e7d32';
      x.setLineDash([8, 4]);
      x.lineWidth = 1.4;
      var seY = sy(toStress(mat.Se));
      x.beginPath();
      x.moveTo(padL, seY); x.lineTo(padL + pw, seY);
      x.stroke();
      x.setLineDash([]);
      x.fillStyle = '#2e7d32';
      x.font = '600 11px "Courier New", monospace';
      x.textAlign = 'left';
      x.fillText('Sₑ = ' + Math.round(toStress(mat.Se)) + ' ' + uStress(),
        padL + 8, seY - 4);
    }

    /* Plot all test points for this material */
    if (state.testPoints) {
      for (var ti = 0; ti < state.testPoints.length; ti++) {
        var tp = state.testPoints[ti];
        if (tp.matId !== mat.id) continue;
        var Nx = isFinite(tp.N) ? tp.N : 1e7;
        var tx = sx(Nx), ty = sy(toStress(tp.sigma));
        if (!isFinite(tp.N)) {
          /* Run-out: open right-pointing arrow */
          x.strokeStyle = '#2e7d32';
          x.fillStyle = '#fff';
          x.lineWidth = 1.5;
          x.beginPath(); x.arc(tx, ty, 5, 0, Math.PI * 2);
          x.fill(); x.stroke();
          x.strokeStyle = '#2e7d32';
          x.beginPath(); x.moveTo(tx + 6, ty);
          x.lineTo(tx + 18, ty); x.stroke();
          x.beginPath();
          x.moveTo(tx + 18, ty); x.lineTo(tx + 13, ty - 4);
          x.moveTo(tx + 18, ty); x.lineTo(tx + 13, ty + 4);
          x.stroke();
        } else {
          x.fillStyle = '#c62828';
          x.beginPath(); x.arc(tx, ty, 5, 0, Math.PI * 2); x.fill();
          x.strokeStyle = '#fff'; x.lineWidth = 1.2;
          x.beginPath(); x.arc(tx, ty, 5, 0, Math.PI * 2); x.stroke();
        }
      }
      /* Legend */
      x.fillStyle = '#37474f';
      x.font = '11px "Segoe UI", sans-serif';
      x.textAlign = 'right';
      x.fillText('● test failure   ○→ run-out',
        padL + pw - 8, padT + 14);
    }

    /* Watermark */
    x.fillStyle = 'rgba(0,0,0,0.30)';
    x.font = '10px "Segoe UI", sans-serif';
    x.textAlign = 'right';
    x.fillText('mechsimulator.com', W - 12, H - 6);

    return c.toDataURL('image/png');
  }

  /* Schematic of the fracture surface — beachmarks + final fast zone */
  function buildFractoSurfaceSketch(mat, r, isRunout) {
    var W = 520, H = 380;
    var c = document.createElement('canvas');
    c.width = W; c.height = H;
    var x = c.getContext('2d');
    x.fillStyle = '#ffffff'; x.fillRect(0, 0, W, H);

    x.fillStyle = '#0d47a1';
    x.font = 'bold 14px "Segoe UI", system-ui, sans-serif';
    x.textAlign = 'center';
    x.fillText(isRunout ? 'Specimen (intact — run-out)' : 'Fracture Surface (schematic)', W / 2, 22);

    var cx = W / 2, cy = H / 2 + 10, R = 110;

    /* Specimen cross-section circle */
    var rg = x.createRadialGradient(cx - R * 0.3, cy - R * 0.3, R * 0.1, cx, cy, R);
    rg.addColorStop(0, '#eceff1');
    rg.addColorStop(1, '#b0bec5');
    x.fillStyle = rg;
    x.beginPath(); x.arc(cx, cy, R, 0, Math.PI * 2); x.fill();
    x.strokeStyle = '#546e7a';
    x.lineWidth = 1.6;
    x.beginPath(); x.arc(cx, cy, R, 0, Math.PI * 2); x.stroke();
    /* Material tint */
    x.fillStyle = mat.color || '#90a4ae';
    x.globalAlpha = 0.18;
    x.beginPath(); x.arc(cx, cy, R, 0, Math.PI * 2); x.fill();
    x.globalAlpha = 1;

    if (isRunout) {
      x.fillStyle = '#2e7d32';
      x.font = 'bold 14px "Segoe UI", sans-serif';
      x.textAlign = 'center';
      x.fillText('RUN-OUT', cx, cy + 4);
      x.font = '11px "Segoe UI", sans-serif';
      x.fillStyle = '#37474f';
      x.fillText('No fracture surface — survived 10⁷ cycles', cx, cy + 24);
    } else {
      /* Initiation point at top (12 o'clock) */
      var initAngle = -Math.PI / 2;
      var initX = cx + R * Math.cos(initAngle);
      var initY = cy + R * Math.sin(initAngle);

      /* Beachmark arcs — concentric around init point */
      var nBeach = 5;
      x.strokeStyle = 'rgba(55,71,79,0.55)';
      x.lineWidth = 1;
      for (var bi = 1; bi <= nBeach; bi++) {
        var rB = R * 0.22 * bi;
        /* Clip to specimen circle */
        x.save();
        x.beginPath(); x.arc(cx, cy, R - 2, 0, Math.PI * 2); x.clip();
        x.beginPath();
        x.arc(initX, initY + 2, rB, 0, Math.PI * 2);
        x.stroke();
        x.restore();
      }

      /* Final fast-fracture zone — rough granular patch opposite init point */
      var fastR = R * 0.55;
      var fastCx = cx;
      var fastCy = cy + R * 0.45;
      x.save();
      x.beginPath(); x.arc(cx, cy, R - 2, 0, Math.PI * 2); x.clip();
      var gradF = x.createRadialGradient(fastCx, fastCy, 4, fastCx, fastCy, fastR);
      gradF.addColorStop(0, 'rgba(0,0,0,0.55)');
      gradF.addColorStop(1, 'rgba(0,0,0,0.05)');
      x.fillStyle = gradF;
      x.beginPath();
      x.arc(fastCx, fastCy, fastR, 0, Math.PI * 2);
      x.fill();
      /* Granular speckle */
      x.fillStyle = 'rgba(0,0,0,0.45)';
      for (var sp = 0; sp < 80; sp++) {
        var a = Math.random() * Math.PI * 2;
        var rr = Math.sqrt(Math.random()) * fastR;
        var px = fastCx + rr * Math.cos(a);
        var py = fastCy + rr * Math.sin(a);
        x.beginPath(); x.arc(px, py, 0.6 + Math.random() * 0.9, 0, Math.PI * 2);
        x.fill();
      }
      x.restore();

      /* Mark initiation point */
      x.fillStyle = '#c62828';
      x.beginPath(); x.arc(initX, initY, 4, 0, Math.PI * 2); x.fill();
      x.strokeStyle = '#fff'; x.lineWidth = 1;
      x.beginPath(); x.arc(initX, initY, 4, 0, Math.PI * 2); x.stroke();

      /* Labels with leader lines */
      x.strokeStyle = '#37474f';
      x.lineWidth = 0.8;
      x.fillStyle = '#37474f';
      x.font = '11px "Segoe UI", sans-serif';

      /* Initiation label */
      x.beginPath(); x.moveTo(initX, initY);
      x.lineTo(initX + 80, initY - 24); x.stroke();
      x.textAlign = 'left';
      x.fillText('Crack initiation', initX + 84, initY - 22);

      /* Beachmark label */
      x.beginPath(); x.moveTo(cx - R * 0.5, cy - R * 0.15);
      x.lineTo(cx - R - 30, cy - 30); x.stroke();
      x.textAlign = 'right';
      x.fillText('Beachmarks', cx - R - 32, cy - 28);

      /* Fast fracture zone label */
      x.beginPath(); x.moveTo(fastCx + 20, fastCy);
      x.lineTo(cx + R + 20, fastCy + 12); x.stroke();
      x.textAlign = 'left';
      x.fillText('Fast-fracture zone', cx + R + 22, fastCy + 16);
    }

    /* Watermark */
    x.fillStyle = 'rgba(0,0,0,0.30)';
    x.font = '10px "Segoe UI", sans-serif';
    x.textAlign = 'right';
    x.fillText('mechsimulator.com', W - 10, H - 4);

    return c.toDataURL('image/png');
  }

  /* Right-click context menu */
  var ctxMenu = $('ctx-menu');
  var gCanvas = $('graph-canvas');
  gCanvas.addEventListener('contextmenu', function (e) {
    e.preventDefault();
    ctxMenu.style.display = 'block';
    var mw = ctxMenu.offsetWidth, mh = ctxMenu.offsetHeight;
    var vw = window.innerWidth, vh = window.innerHeight;
    var lx = Math.min(e.clientX, vw - mw - 8);
    var ly = Math.min(e.clientY, vh - mh - 8);
    ctxMenu.style.position = 'fixed';
    ctxMenu.style.left = Math.max(4, lx) + 'px';
    ctxMenu.style.top  = Math.max(4, ly) + 'px';
  });
  document.addEventListener('click', function () { ctxMenu.style.display = 'none'; });
  ctxMenu.querySelectorAll('.ctx-item').forEach(function (item) {
    item.addEventListener('click', function () {
      var action = item.dataset.action;
      if (action === 'save-png') exportPNG();
      else if (action === 'export-csv') exportCSV();
      else if (action === 'reset') $('btn-reset').click();
      ctxMenu.style.display = 'none';
    });
  });

