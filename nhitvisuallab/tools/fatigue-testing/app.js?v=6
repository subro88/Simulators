  var MPA_TO_PSI  = 145.038;
  var MM_TO_IN    = 1 / 25.4;
  var N_TO_LBF    = 0.224809;

  function toStress(mpa)  { return state.imperial ? roundN(mpa * MPA_TO_PSI, 1) : mpa; }
  function toLength(mm)   { return state.imperial ? roundN(mm * MM_TO_IN, 3) : mm; }
