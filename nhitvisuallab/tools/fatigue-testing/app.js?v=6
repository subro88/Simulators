    var d = Math.pow(32 * M / (Math.PI * sigmaAllow), 1 / 3);
    return {
      prompt: 'A rotating beam fatigue test requires a stress amplitude of ' + sigmaAllow + ' MPa with a load of ' + W + ' N (span = ' + L + ' mm). What minimum gauge diameter (d) is needed?',
      answer: roundN(d, 1), unit: 'mm', tol: 0.3,
      solution: [
        'M = W \u00d7 L/2 = ' + W + ' \u00d7 ' + L + '/2 = ' + M + ' N\u00b7mm',
        '\u03c3_a = 32M/(\u03c0d\u00b3) \u2192 d\u00b3 = 32M/(\u03c0\u03c3_a)',
        'd\u00b3 = 32 \u00d7 ' + M + ' / (\u03c0 \u00d7 ' + sigmaAllow + ') = ' + roundN(32 * M / (Math.PI * sigmaAllow), 1),
        '<strong>d = ' + roundN(d, 1) + ' mm</strong>'
      ]
    };
  }

  function genStressFromMoment() {
    var M = randInt(1, 20) * 1000;
    var d = randInt(6, 12);
    var sigma = 32 * M / (Math.PI * d * d * d);
    return {
      prompt: 'A rotating beam specimen with gauge diameter ' + d + ' mm is subjected to a bending moment of ' + M + ' N\u00b7mm. Calculate the stress amplitude.',
      answer: roundN(sigma, 1), unit: 'MPa', tol: 1,
      solution: [
        '\u03c3_a = 32M/(\u03c0d\u00b3)',
        '\u03c3_a = 32 \u00d7 ' + M + ' / (\u03c0 \u00d7 ' + d + '\u00b3)',
        '\u03c3_a = ' + (32 * M) + ' / ' + roundN(Math.PI * d * d * d, 1),
        '<strong>\u03c3_a = ' + roundN(sigma, 1) + ' MPa</strong>'
      ]
    };
  }

  function genFatigueLifeAtStress() {
    var mi = randInt(0, MATERIALS.length - 1);
    var mat = MATERIALS[mi];
    var sigmaA = randInt(Math.round(mat.Se || mat.sigmaU * 0.3), Math.round(mat.sigma1k * 0.9));
    if (sigmaA < 50) sigmaA = 50;
    var N = getCyclesToFailure(mat, sigmaA);
    if (!isFinite(N) || N > 1e8) {
      sigmaA = Math.round(mat.sigma1k * 0.8);
      N = getCyclesToFailure(mat, sigmaA);
    }
    return {
      prompt: 'For ' + mat.name + ', find the expected fatigue life at a stress amplitude of ' + sigmaA + ' MPa. (Use material S-N curve data.)',
      answer: Math.round(N), unit: 'cycles', tol: Math.round(N * 0.10),
      solution: [
        'Using the S-N curve for ' + mat.name + ':',
        'At \u03c3_a = ' + sigmaA + ' MPa, lookup on S-N curve',
        '<strong>N_f \u2248 ' + formatCycles(N) + ' cycles</strong>'
      ]
    };
  }

  function genGoodmanStress() {
    var Se = randInt(15, 35) * 10;
    var sigmaU = Se * 2 + randInt(0, 10) * 10;
    var sigmaM = randInt(3, Math.floor(sigmaU / 20)) * 10;
    var sigmaA = Se * (1 - sigmaM / sigmaU);
    return {
      prompt: 'Using the Goodman criterion: Se = ' + Se + ' MPa, \u03c3_u = ' + sigmaU + ' MPa, mean stress \u03c3_m = ' + sigmaM + ' MPa. Find the allowable alternating stress \u03c3_a.',
      answer: roundN(sigmaA, 1), unit: 'MPa', tol: 1,
      solution: [
        'Goodman: \u03c3_a/Se + \u03c3_m/\u03c3_u = 1',
        '\u03c3_a/' + Se + ' + ' + sigmaM + '/' + sigmaU + ' = 1',
        '\u03c3_a/' + Se + ' = 1 \u2212 ' + roundN(sigmaM / sigmaU, 3),
        '<strong>\u03c3_a = ' + roundN(sigmaA, 1) + ' MPa</strong>'
      ]
    };
  }

  function genSoderbergStress() {
    var Se = randInt(15, 30) * 10;
    var sigmaY = Se + randInt(5, 15) * 10;
    var sigmaM = randInt(2, Math.floor(sigmaY / 20)) * 10;
    var sigmaA = Se * (1 - sigmaM / sigmaY);
    return {
      prompt: 'Using the Soderberg criterion: Se = ' + Se + ' MPa, \u03c3_y = ' + sigmaY + ' MPa, mean stress \u03c3_m = ' + sigmaM + ' MPa. Find the allowable alternating stress \u03c3_a.',
      answer: roundN(sigmaA, 1), unit: 'MPa', tol: 1,
      solution: [
        'Soderberg: \u03c3_a/Se + \u03c3_m/\u03c3_y = 1',
        '\u03c3_a/' + Se + ' + ' + sigmaM + '/' + sigmaY + ' = 1',
        '\u03c3_a/' + Se + ' = 1 \u2212 ' + roundN(sigmaM / sigmaY, 3),
        '<strong>\u03c3_a = ' + roundN(sigmaA, 1) + ' MPa</strong>'
      ]
    };
  }

  function genMinerDamage() {
    var N1 = randInt(5, 50) * 1e4;
    var Nf1 = N1 * randInt(2, 5);
    var N2 = randInt(5, 50) * 1e4;
    var Nf2 = N2 * randInt(3, 8);
    var D = N1 / Nf1 + N2 / Nf2;
    return {
      prompt: 'A shaft sees ' + formatCycles(N1) + ' cycles at stress level 1 (N_f1 = ' + formatCycles(Nf1) + ') and ' + formatCycles(N2) + ' cycles at stress level 2 (N_f2 = ' + formatCycles(Nf2) + '). Calculate cumulative damage D using Miner\'s rule.',
      answer: roundN(D, 3), unit: '', tol: 0.02,
      solution: [
        'D = n\u2081/N\u2081 + n\u2082/N\u2082',
        'D = ' + formatCycles(N1) + '/' + formatCycles(Nf1) + ' + ' + formatCycles(N2) + '/' + formatCycles(Nf2),
        'D = ' + roundN(N1 / Nf1, 3) + ' + ' + roundN(N2 / Nf2, 3),
        '<strong>D = ' + roundN(D, 3) + '</strong>' + (D >= 1 ? ' (\u2265 1.0 \u2014 failure predicted)' : ' (< 1.0 \u2014 life remaining)')
      ]
    };
  }

  function genStressConcentration() {
    var Kt = roundN(randFloat(1.5, 3.5), 1);
    var q = roundN(randFloat(0.5, 0.95), 2);
    var sigmaNom = randInt(5, 20) * 10;
    var Kf = 1 + q * (Kt - 1);
    var sigmaEff = Kf * sigmaNom;
    return {
      prompt: 'A notched shaft has Kt = ' + Kt + ', notch sensitivity q = ' + q + ', and nominal stress = ' + sigmaNom + ' MPa. Find the effective fatigue stress (\u03c3_eff = Kf \u00d7 \u03c3_nom).',
      answer: roundN(sigmaEff, 1), unit: 'MPa', tol: 1,
      solution: [
        'Kf = 1 + q(Kt \u2212 1) = 1 + ' + q + '(' + Kt + ' \u2212 1)',
        'Kf = 1 + ' + q + ' \u00d7 ' + roundN(Kt - 1, 1) + ' = ' + roundN(Kf, 2),
        '\u03c3_eff = Kf \u00d7 \u03c3_nom = ' + roundN(Kf, 2) + ' \u00d7 ' + sigmaNom,
        '<strong>\u03c3_eff = ' + roundN(sigmaEff, 1) + ' MPa</strong>'
      ]
    };
  }

  function genModifiedEndurance() {
    var Se0 = randInt(15, 35) * 10;
    var ka = roundN(randFloat(0.6, 0.95), 2);
    var kb = roundN(randFloat(0.7, 0.95), 2);
    var kc = roundN(randFloat(0.8, 1.0), 2);
    var Se = Se0 * ka * kb * kc;
    return {
      prompt: 'Uncorrected endurance limit Se\' = ' + Se0 + ' MPa. Surface factor ka = ' + ka + ', size factor kb = ' + kb + ', reliability factor kc = ' + kc + '. Find the modified endurance limit Se.',
      answer: roundN(Se, 1), unit: 'MPa', tol: 1,
      solution: [
        'Se = ka \u00d7 kb \u00d7 kc \u00d7 Se\u2019',
        'Se = ' + ka + ' \u00d7 ' + kb + ' \u00d7 ' + kc + ' \u00d7 ' + Se0,
        '<strong>Se = ' + roundN(Se, 1) + ' MPa</strong>'
      ]
    };
  }

