  function drawCrackInset() {
    var ix = 420, iy = 480, iw = 120, ih = 100;
    /* Inset background */
    mCtx.fillStyle = 'rgba(13,17,23,0.92)';
    mCtx.strokeStyle = '#5e35b1';
    mCtx.lineWidth = 1;
    mCtx.beginPath();
    mCtx.moveTo(ix + 4, iy); mCtx.lineTo(ix + iw - 4, iy);
    mCtx.quadraticCurveTo(ix + iw, iy, ix + iw, iy + 4);
    mCtx.lineTo(ix + iw, iy + ih - 4);
    mCtx.quadraticCurveTo(ix + iw, iy + ih, ix + iw - 4, iy + ih);
    mCtx.lineTo(ix + 4, iy + ih);
    mCtx.quadraticCurveTo(ix, iy + ih, ix, iy + ih - 4);
    mCtx.lineTo(ix, iy + 4);
    mCtx.quadraticCurveTo(ix, iy, ix + 4, iy);
    mCtx.closePath();
    mCtx.fill();
    mCtx.stroke();

    /* Title */
    mCtx.fillStyle = '#5e35b1';
    mCtx.font = 'bold 7px monospace';
    mCtx.textAlign = 'center';
    mCtx.fillText('CRACK DETAIL (10\u00d7)', ix + iw / 2, iy + 12);

    /* Specimen cross-section */
    var cx = ix + iw / 2, cy2 = iy + 58;
    var rad = 30;
    mCtx.fillStyle = MATERIALS[state.matIdx].color;
    mCtx.beginPath(); mCtx.arc(cx, cy2, rad, 0, Math.PI * 2); mCtx.fill();
    mCtx.strokeStyle = '#78909c';
    mCtx.lineWidth = 1;
    mCtx.stroke();

    /* Crack from top surface */
    var crackAngle = -Math.PI / 2;
    var depth = state.crackSize * rad * 1.5;
    depth = Math.min(depth, rad * 1.8);
    /* Beach marks */
    var numMarks = Math.floor(state.crackSize * 8);
    for (var m = 1; m <= numMarks; m++) {
      var markR = (m / numMarks) * depth * 0.8;
      mCtx.strokeStyle = 'rgba(94,53,177,' + (0.2 + m * 0.06) + ')';
      mCtx.lineWidth = 0.8;
      mCtx.beginPath();
      mCtx.arc(cx, cy2 - rad, markR, 0.3, Math.PI - 0.3);
      mCtx.stroke();
    }
    /* Main crack line */
    mCtx.strokeStyle = '#0d1117';
    mCtx.lineWidth = 2;
    mCtx.beginPath();
    mCtx.moveTo(cx, cy2 - rad);
    mCtx.lineTo(cx, cy2 - rad + depth);
    mCtx.stroke();

    /* Crack depth label */
    mCtx.fillStyle = '#ff5555';
    mCtx.font = '7px monospace';
    mCtx.fillText(Math.round(state.crackSize * 100) + '%', ix + iw / 2, iy + ih - 6);
  }

  function drawFractureSurface() {
    var ix = 30, iy = 480, iw = 130, ih = 110;
    /* Background */
    mCtx.fillStyle = 'rgba(13,17,23,0.92)';
    mCtx.strokeStyle = '#5e35b1';
    mCtx.lineWidth = 1;
    mCtx.beginPath();
    mCtx.moveTo(ix + 4, iy); mCtx.lineTo(ix + iw - 4, iy);
    mCtx.quadraticCurveTo(ix + iw, iy, ix + iw, iy + 4);
    mCtx.lineTo(ix + iw, iy + ih - 4);
    mCtx.quadraticCurveTo(ix + iw, iy + ih, ix + iw - 4, iy + ih);
    mCtx.lineTo(ix + 4, iy + ih);
    mCtx.quadraticCurveTo(ix, iy + ih, ix, iy + ih - 4);
    mCtx.lineTo(ix, iy + 4);
    mCtx.quadraticCurveTo(ix, iy, ix + 4, iy);
    mCtx.closePath();
    mCtx.fill();
    mCtx.stroke();

    mCtx.fillStyle = '#5e35b1';
    mCtx.font = 'bold 7px monospace';
    mCtx.textAlign = 'center';
    mCtx.fillText('FRACTURE SURFACE', ix + iw / 2, iy + 12);

    var cx = ix + iw / 2, cy = iy + 62;
    var rad = 32;

    if (state.results && state.results.failMode === 'Infinite Life') {
      /* Run-out: show intact cross section */
      mCtx.fillStyle = MATERIALS[state.matIdx].color;
      mCtx.beginPath(); mCtx.arc(cx, cy, rad, 0, Math.PI * 2); mCtx.fill();
      mCtx.strokeStyle = '#78909c';
      mCtx.lineWidth = 1;
      mCtx.stroke();
      mCtx.fillStyle = '#3ddc84';
      mCtx.font = 'bold 8px monospace';
      mCtx.fillText('NO FRACTURE', ix + iw / 2, iy + ih - 6);
      mCtx.fillText('(Run-out)', ix + iw / 2, iy + ih + 4);
      return;
    }

    /* Fatigue zone (smooth, with beach marks) — top portion */
    var fatigueRatio = state.crackSize > 0 ? clamp(state.crackSize, 0.3, 0.85) : 0.6;
    mCtx.save();
    mCtx.beginPath(); mCtx.arc(cx, cy, rad, 0, Math.PI * 2); mCtx.clip();

    /* Fatigue zone - smooth */
    mCtx.fillStyle = '#607d8b';
    mCtx.fillRect(cx - rad, cy - rad, rad * 2, rad * 2 * fatigueRatio);

    /* Fast fracture zone - rough */
    mCtx.fillStyle = '#8d6e63';
    mCtx.fillRect(cx - rad, cy - rad + rad * 2 * fatigueRatio, rad * 2, rad * 2 * (1 - fatigueRatio));

    /* Beach marks in fatigue zone */
    for (var b = 1; b <= 6; b++) {
      var markR = (b / 7) * rad * fatigueRatio * 1.8;
      mCtx.strokeStyle = 'rgba(120,144,156,' + (0.3 + b * 0.05) + ')';
      mCtx.lineWidth = 0.8;
      mCtx.beginPath();
      mCtx.arc(cx, cy - rad, markR, 0.2, Math.PI - 0.2);
      mCtx.stroke();
    }

    /* Ratchet marks at origin */
    mCtx.strokeStyle = 'rgba(255,85,85,0.5)';
    mCtx.lineWidth = 0.5;
    for (var r = -2; r <= 2; r++) {
      mCtx.beginPath();
      mCtx.moveTo(cx + r * 4, cy - rad);
      mCtx.lineTo(cx + r * 3, cy - rad + 6);
      mCtx.stroke();
    }

    /* Stippled texture in fast fracture */
    var ffTop = cy - rad + rad * 2 * fatigueRatio;
    for (var s = 0; s < 30; s++) {
      var sx2 = cx + (Math.random() - 0.5) * rad * 1.6;
      var sy2 = ffTop + Math.random() * rad * 2 * (1 - fatigueRatio);
      mCtx.fillStyle = 'rgba(188,170,164,' + (0.3 + Math.random() * 0.3) + ')';
      mCtx.fillRect(sx2, sy2, 1.5, 1.5);
    }

    mCtx.restore();

    /* Outline */
    mCtx.strokeStyle = '#78909c';
    mCtx.lineWidth = 1;
    mCtx.beginPath(); mCtx.arc(cx, cy, rad, 0, Math.PI * 2); mCtx.stroke();

    /* Labels */
    mCtx.fillStyle = '#90a4ae';
    mCtx.font = '6px monospace';
    mCtx.fillText('Fatigue zone', ix + iw / 2, cy - rad + rad * fatigueRatio * 0.5);
    mCtx.fillStyle = '#bcaaa4';
    mCtx.fillText('Fast fracture', ix + iw / 2, cy - rad + rad * 2 * fatigueRatio + rad * (1 - fatigueRatio));
  }

  function drawFractureFlash() {
    var fx = SPEC_CX, fy = SHAFT_Y;
    var alpha = 1 - state.animProgress;
    var fg = mCtx.createRadialGradient(fx, fy, 0, fx, fy, 50);
    fg.addColorStop(0, 'rgba(255,255,255,' + (alpha * 0.8) + ')');
    fg.addColorStop(0.3, 'rgba(94,53,177,' + (alpha * 0.5) + ')');
    fg.addColorStop(1, 'rgba(94,53,177,0)');
    mCtx.fillStyle = fg;
    mCtx.beginPath(); mCtx.arc(fx, fy, 50, 0, Math.PI * 2); mCtx.fill();
  }

  function initFractureParticles() {
    var mat = MATERIALS[state.matIdx];
    var colors = ['#5e35b1', '#b39ddb', '#d1c4e9', '#ffffff', mat.color];
    state.fractureParts = [];
    for (var i = 0; i < 25; i++) {
      state.fractureParts.push({
        x: SPEC_CX + (Math.random() - 0.5) * 10,
        y: SHAFT_Y + (Math.random() - 0.5) * 6,
        vx: (Math.random() - 0.5) * 6,
        vy: -Math.random() * 5 - 1,
        alpha: 0.8 + Math.random() * 0.2,
        rot: Math.random() * Math.PI * 2,
        size: 1.5 + Math.random() * 3.5,
        color: colors[Math.floor(Math.random() * colors.length)]
      });
    }
  }

  function updateFractureParticles() {
    for (var i = 0; i < state.fractureParts.length; i++) {
      var p = state.fractureParts[i];
      p.x += p.vx;
      p.y += p.vy;
      p.vy += 0.2;
      p.rot += 0.1;
      p.alpha *= 0.96;
    }
  }

  function drawFractureParticles() {
    for (var i = 0; i < state.fractureParts.length; i++) {
      var p = state.fractureParts[i];
      if (p.alpha < 0.02) continue;
      mCtx.save();
      mCtx.translate(p.x, p.y);
      mCtx.rotate(p.rot);
      mCtx.globalAlpha = p.alpha;
      mCtx.fillStyle = p.color;
      mCtx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size);
      mCtx.restore();
    }
  }

  /* ═══════════════════════════════════════════════════════════════
     S10  SPECIMEN PHYSICS & ROTATION
     ═══════════════════════════════════════════════════════════════ */

  function updateSpecimenPhysics(dt) {
    /* Motor speed ramp */
    if (state.animPhase === 'spinning_up') {
      state.motorSpeed = lerp(0, state.speed, easeInOut(state.animProgress));
    } else if (state.animPhase === 'decelerating') {
      state.motorSpeed = lerp(state.speed, 0, easeOut(state.animProgress));
    } else if (state.animPhase === 'running' || state.animPhase === 'crack_critical') {
      state.motorSpeed = state.speed;
    }

    /* Specimen rotation */
    if (state.motorSpeed > 0) {
      var rps = state.motorSpeed / 60; /* revolutions per second */
      state.specAngle += rps * Math.PI * 2 * dt;
    }
  }

  /* ═══════════════════════════════════════════════════════════════
     S11  GRAPH DRAWING
     ═══════════════════════════════════════════════════════════════ */
  var GOX = 65, GOY = GH - 55;  /* graph origin */
  var GGW = GW - 90, GGH = GH - 95; /* graph area */

  function drawGraph() {
    gCtx.clearRect(0, 0, GW, GH);
    drawGraphBackground();
    if (state.graphMode === 'cycle') {
      drawStressCycleGraph();
    } else {
      drawSNCurveGraph();
    }
  }

  function drawGraphBackground() {
    gCtx.fillStyle = '#0a0e14';
    gCtx.fillRect(0, 0, GW, GH);
    gCtx.strokeStyle = 'rgba(42,48,80,0.25)';
    gCtx.lineWidth = 0.5;
    for (var x = GOX; x <= GOX + GGW; x += 40) {
      gCtx.beginPath(); gCtx.moveTo(x, GOY - GGH); gCtx.lineTo(x, GOY); gCtx.stroke();
    }
    for (var y = GOY; y >= GOY - GGH; y -= 40) {
      gCtx.beginPath(); gCtx.moveTo(GOX, y); gCtx.lineTo(GOX + GGW, y); gCtx.stroke();
    }
  }

  function drawStressCycleGraph() {
    var mat = MATERIALS[state.matIdx];
    var sigma = state.stressAmplitude;
    if (sigma <= 0) sigma = 100;

    /* Title */
    gCtx.fillStyle = '#dde3f0';
    gCtx.font = 'bold 12px sans-serif';
    gCtx.textAlign = 'center';
    gCtx.fillText('Stress Cycle (\u03c3 vs \u03b8) \u2014 ' + mat.name, GW / 2, 22);
    gCtx.fillStyle = '#6b7a99';
    gCtx.font = '9px sans-serif';
    gCtx.fillText('Fully Reversed Bending (R = \u22121)', GW / 2, 36);

    /* Axes */
    gCtx.strokeStyle = '#6b7a99';
    gCtx.lineWidth = 1;
    gCtx.beginPath(); gCtx.moveTo(GOX, GOY - GGH); gCtx.lineTo(GOX, GOY); gCtx.lineTo(GOX + GGW, GOY); gCtx.stroke();

    /* Y-axis labels */
    gCtx.fillStyle = '#6b7a99';
    gCtx.font = '8px monospace';
    gCtx.textAlign = 'right';
    var midY = GOY - GGH / 2;
    gCtx.fillText('+' + Math.round(toStress(sigma)), GOX - 5, GOY - GGH + 4);
    gCtx.fillText('0', GOX - 5, midY + 3);
    gCtx.fillText('\u2212' + Math.round(toStress(sigma)), GOX - 5, GOY);

    /* Y-axis title */
    gCtx.save();
    gCtx.translate(12, GOY - GGH / 2);
    gCtx.rotate(-Math.PI / 2);
    gCtx.fillStyle = '#6b7a99';
    gCtx.font = '9px sans-serif';
    gCtx.textAlign = 'center';
    gCtx.fillText('Stress \u03c3 (' + uStress() + ')', 0, 0);
    gCtx.restore();

    /* X-axis labels */
    gCtx.textAlign = 'center';
    gCtx.fillStyle = '#6b7a99';
    gCtx.font = '8px monospace';
    for (var deg = 0; deg <= 720; deg += 180) {
      var xp = GOX + (deg / 720) * GGW;
      gCtx.fillText(deg + '\u00b0', xp, GOY + 14);
      if (deg > 0 && deg < 720) {
        gCtx.strokeStyle = 'rgba(42,48,80,0.3)';
        gCtx.lineWidth = 0.5;
        gCtx.beginPath(); gCtx.moveTo(xp, GOY); gCtx.lineTo(xp, GOY - GGH); gCtx.stroke();
      }
    }
    gCtx.font = '9px sans-serif';
    gCtx.fillText('Rotation Angle \u03b8', GOX + GGW / 2, GOY + 28);

    /* Zero line */
    gCtx.strokeStyle = 'rgba(94,53,177,0.3)';
    gCtx.lineWidth = 1;
    gCtx.setLineDash([4, 4]);
    gCtx.beginPath(); gCtx.moveTo(GOX, midY); gCtx.lineTo(GOX + GGW, midY); gCtx.stroke();
    gCtx.setLineDash([]);

    /* Tension / Compression labels */
    gCtx.fillStyle = '#3ddc84';
    gCtx.font = '8px sans-serif';
    gCtx.textAlign = 'left';
    gCtx.fillText('Tension (+)', GOX + GGW - 60, GOY - GGH + 14);
    gCtx.fillStyle = '#ff5555';
    gCtx.fillText('Compression (\u2212)', GOX + GGW - 80, GOY - 6);

    /* Sinusoidal curve */
    gCtx.strokeStyle = '#5e35b1';
    gCtx.lineWidth = 2;
    gCtx.beginPath();
    var drawEnd = state.animPhase === 'running' ? state.testProgress : 1;
    if (state.animPhase === 'idle' || state.animPhase === 'mounting' || state.animPhase === 'spinning_up') drawEnd = 0;
    var totalPoints = Math.floor(drawEnd * 200);
    for (var i = 0; i <= totalPoints; i++) {
      var t = i / 200;
      var angle = t * 720 * Math.PI / 180;
      var sx = GOX + t * GGW;
      var sy = midY - Math.sin(angle) * (GGH / 2 - 10);
      if (i === 0) gCtx.moveTo(sx, sy);
      gCtx.lineTo(sx, sy);
    }
    gCtx.stroke();

    /* Moving dot */
    if (totalPoints > 0 && state.animPhase === 'running') {
      var tCur = totalPoints / 200;
      var aCur = tCur * 720 * Math.PI / 180;
      var dx = GOX + tCur * GGW;
      var dy = midY - Math.sin(aCur) * (GGH / 2 - 10);
      gCtx.fillStyle = '#f5c842';
      gCtx.beginPath(); gCtx.arc(dx, dy, 5, 0, Math.PI * 2); gCtx.fill();
      gCtx.fillStyle = hexToRGBA('#f5c842', 0.3);
      gCtx.beginPath(); gCtx.arc(dx, dy, 10, 0, Math.PI * 2); gCtx.fill();
    }

    /* Amplitude markers */
    gCtx.strokeStyle = 'rgba(94,53,177,0.4)';
    gCtx.lineWidth = 1;
    gCtx.setLineDash([2, 2]);
    gCtx.beginPath(); gCtx.moveTo(GOX, GOY - GGH + 10); gCtx.lineTo(GOX + GGW, GOY - GGH + 10); gCtx.stroke();
    gCtx.beginPath(); gCtx.moveTo(GOX, GOY - 10); gCtx.lineTo(GOX + GGW, GOY - 10); gCtx.stroke();
    gCtx.setLineDash([]);

    /* σ_a label */
    gCtx.fillStyle = '#5e35b1';
    gCtx.font = 'bold 9px sans-serif';
    gCtx.textAlign = 'left';
    gCtx.fillText('\u03c3_a = ' + toStress(roundN(sigma, 1)) + ' ' + uStress(), GOX + 5, GOY - GGH + 8);
  }

  function drawSNCurveGraph() {
    var mat = MATERIALS[state.matIdx];

    /* Title */
    gCtx.fillStyle = '#dde3f0';
    gCtx.font = 'bold 12px sans-serif';
    gCtx.textAlign = 'center';
    gCtx.fillText('S-N Curve (W\u00f6hler Diagram) \u2014 ' + mat.name, GW / 2, 22);
    gCtx.fillStyle = '#6b7a99';
    gCtx.font = '9px sans-serif';
    gCtx.fillText(mat.hasEndurance ? 'With Endurance Limit (Se = ' + toStress(mat.Se) + ' ' + uStress() + ')' : 'No Endurance Limit (continuous decline)', GW / 2, 36);

    /* Axes */
    gCtx.strokeStyle = '#6b7a99';
    gCtx.lineWidth = 1;
    gCtx.beginPath(); gCtx.moveTo(GOX, GOY - GGH); gCtx.lineTo(GOX, GOY); gCtx.lineTo(GOX + GGW, GOY); gCtx.stroke();

    /* X-axis: log scale N = 10^1 to 10^8 */
    var logMin = 1, logMax = 8;
    gCtx.fillStyle = '#6b7a99';
    gCtx.font = '8px monospace';
    gCtx.textAlign = 'center';
    for (var e = logMin; e <= logMax; e++) {
      var xp = GOX + ((e - logMin) / (logMax - logMin)) * GGW;
      gCtx.fillText('10' + superscript(e), xp, GOY + 14);
      if (e > logMin) {
        gCtx.strokeStyle = 'rgba(42,48,80,0.25)';
        gCtx.lineWidth = 0.5;
        gCtx.beginPath(); gCtx.moveTo(xp, GOY); gCtx.lineTo(xp, GOY - GGH); gCtx.stroke();
      }
    }
    gCtx.font = '9px sans-serif';
    gCtx.fillText('Number of Cycles N', GOX + GGW / 2, GOY + 28);

    /* Y-axis: stress 0 to maxSigma */
    var maxSigma = mat.sigmaU * 1.2;
    gCtx.save();
    gCtx.translate(12, GOY - GGH / 2);
    gCtx.rotate(-Math.PI / 2);
    gCtx.fillStyle = '#6b7a99';
    gCtx.font = '9px sans-serif';
    gCtx.textAlign = 'center';
    gCtx.fillText('Stress Amplitude \u03c3_a (' + uStress() + ')', 0, 0);
    gCtx.restore();

    gCtx.textAlign = 'right';
    gCtx.font = '8px monospace';
    var ySteps = 5;
    for (var ys = 0; ys <= ySteps; ys++) {
      var sv = (ys / ySteps) * maxSigma;
      var yp = GOY - (ys / ySteps) * GGH;
      gCtx.fillStyle = '#6b7a99';
      gCtx.fillText(Math.round(toStress(sv)), GOX - 5, yp + 3);
    }

    /* S-N curve line */
    var curve = generateSNCurve(mat);
    gCtx.strokeStyle = '#5e35b1';
    gCtx.lineWidth = 2;
    gCtx.globalAlpha = 0.8;
    gCtx.beginPath();
    for (var i = 0; i < curve.length; i++) {
      var p = curve[i];
      var px = GOX + ((p.logN - logMin) / (logMax - logMin)) * GGW;
      var py = GOY - (p.sigma / maxSigma) * GGH;
      py = clamp(py, GOY - GGH, GOY);
      if (i === 0) gCtx.moveTo(px, py); else gCtx.lineTo(px, py);
    }
    gCtx.stroke();
    gCtx.globalAlpha = 1;

    /* Endurance limit line */
    if (mat.hasEndurance && mat.Se !== null) {
      var seY = GOY - (mat.Se / maxSigma) * GGH;
      gCtx.strokeStyle = '#3ddc84';
      gCtx.lineWidth = 1;
      gCtx.setLineDash([4, 4]);
      gCtx.beginPath(); gCtx.moveTo(GOX, seY); gCtx.lineTo(GOX + GGW, seY); gCtx.stroke();
      gCtx.setLineDash([]);
      gCtx.fillStyle = '#3ddc84';
      gCtx.font = '8px monospace';
      gCtx.textAlign = 'left';
      gCtx.fillText('Se = ' + toStress(mat.Se) + ' ' + uStress(), GOX + GGW - 80, seY - 4);

      /* Knee point */
      var kneeLogN = log10(mat.Ne);
      var kneeX = GOX + ((kneeLogN - logMin) / (logMax - logMin)) * GGW;
      gCtx.fillStyle = '#f5c842';
      gCtx.beginPath(); gCtx.arc(kneeX, seY, 4, 0, Math.PI * 2); gCtx.fill();
      gCtx.fillStyle = '#f5c842';
      gCtx.font = '7px monospace';
      gCtx.textAlign = 'center';
      gCtx.fillText('Knee (N_e)', kneeX, seY + 14);
    } else {
      /* No endurance limit annotation */
      gCtx.fillStyle = hexToRGBA('#5e35b1', 0.06);
      gCtx.fillRect(GOX, GOY - GGH, GGW, GGH);
      gCtx.fillStyle = '#ff8a65';
      gCtx.font = 'bold 10px sans-serif';
      gCtx.textAlign = 'center';
      gCtx.fillText('No Endurance Limit \u2014 ' + mat.crystal.toUpperCase() + ' Structure', GOX + GGW / 2, GOY - GGH + 20);
      gCtx.fillStyle = '#6b7a99';
      gCtx.font = '9px sans-serif';
      gCtx.fillText('S-N curve declines continuously; use fatigue strength at N', GOX + GGW / 2, GOY - GGH + 34);
    }

    /* Zone labels */
    gCtx.fillStyle = 'rgba(94,53,177,0.12)';
    var lcX = GOX + ((3 - logMin) / (logMax - logMin)) * GGW;
    gCtx.fillRect(GOX, GOY - GGH, lcX - GOX, GGH);
    gCtx.fillStyle = 'rgba(94,53,177,0.4)';
    gCtx.font = '8px sans-serif';
    gCtx.textAlign = 'center';
    gCtx.fillText('Low-Cycle', GOX + (lcX - GOX) / 2, GOY - 8);
    gCtx.fillText('High-Cycle Fatigue', lcX + (GOX + GGW - lcX) / 2, GOY - 8);

    /* Test points */
    for (var tp = 0; tp < state.testPoints.length; tp++) {
      var pt = state.testPoints[tp];
      if (pt.matId !== mat.id) continue;
      var ptLogN = isFinite(pt.N) ? log10(Math.max(pt.N, 1)) : logMax;
      var ptX = GOX + ((ptLogN - logMin) / (logMax - logMin)) * GGW;
      var ptY = GOY - (pt.sigma / maxSigma) * GGH;
      ptX = clamp(ptX, GOX, GOX + GGW);
      ptY = clamp(ptY, GOY - GGH, GOY);
      var isLatest = (tp === state.testPoints.length - 1);
      /* Point */
      gCtx.fillStyle = isLatest ? '#f5c842' : hexToRGBA('#5e35b1', 0.6);
      gCtx.beginPath(); gCtx.arc(ptX, ptY, isLatest ? 5 : 3, 0, Math.PI * 2); gCtx.fill();
      if (isLatest) {
        gCtx.fillStyle = hexToRGBA('#f5c842', 0.2);
        gCtx.beginPath(); gCtx.arc(ptX, ptY, 10, 0, Math.PI * 2); gCtx.fill();
      }
      /* Run-out arrow */
      if (!isFinite(pt.N) || pt.N >= 1e7) {
        gCtx.strokeStyle = isLatest ? '#f5c842' : '#5e35b1';
        gCtx.lineWidth = 1.5;
        gCtx.beginPath(); gCtx.moveTo(ptX, ptY); gCtx.lineTo(ptX + 12, ptY); gCtx.stroke();
        gCtx.beginPath();
        gCtx.moveTo(ptX + 12, ptY);
        gCtx.lineTo(ptX + 8, ptY - 3);
        gCtx.lineTo(ptX + 8, ptY + 3);
        gCtx.closePath();
        gCtx.fillStyle = isLatest ? '#f5c842' : '#5e35b1';
        gCtx.fill();
      }
    }
  }

  function superscript(n) {
    var sup = { '0': '\u2070', '1': '\u00b9', '2': '\u00b2', '3': '\u00b3', '4': '\u2074', '5': '\u2075', '6': '\u2076', '7': '\u2077', '8': '\u2078', '9': '\u2079' };
    return String(n).split('').map(function (c) { return sup[c] || c; }).join('');
  }

  /* ═══════════════════════════════════════════════════════════════
     S12  ANIMATION ENGINE (7 phases)
     ═══════════════════════════════════════════════════════════════ */
  var PHASE_DUR = {
    mounting: 1500,
    spinning_up: 1000,
    running: 5000, /* base, adjusted by cycles */
    crack_critical: 500,
    fracture: 300,
    decelerating: 1000
  };
  var animRAF = null;

  function startAnimation(phase) {
    state.animPhase = phase;
    state.animProgress = 0;
    state.animStartTime = performance.now();
    if (!animRAF) animLoop();
  }

  function animLoop() {
    animRAF = null; /* Clear so startAnimation can restart */
    var now = performance.now();
    var elapsed = now - state.animStartTime;
    var dur = PHASE_DUR[state.animPhase] || 1000;

    /* Adjust running duration based on cycles */
    if (state.animPhase === 'running') {
      var logNf = isFinite(state.targetCycles) ? log10(Math.max(state.targetCycles, 100)) : 7;
      dur = clamp(logNf * 800, 3000, 8000);
    }

    state.animProgress = clamp(elapsed / dur, 0, 1);

    /* Phase-specific updates */
    var dt = 1 / 60;
    switch (state.animPhase) {
      case 'mounting':
        if (state.animProgress >= 1) {
          state.mounted = true;
          state.animPhase = 'idle';
          advanceStep(5);
          elBtnStart.disabled = false;
        }
        break;

      case 'spinning_up':
        updateSpecimenPhysics(dt);
        if (state.animProgress >= 1) {
          startAnimation('running');
          return;
        }
        break;

      case 'running':
        updateSpecimenPhysics(dt);
        state.testProgress = state.animProgress;
        /* Update cycle count */
        if (isFinite(state.targetCycles)) {
          state.cycleCount = state.testProgress * state.targetCycles;
        } else {
          state.cycleCount = state.testProgress * 1e7;
        }
        /* Crack growth */
        if (isFinite(state.targetCycles)) {
          if (state.testProgress > 0.1) {
            state.crackSize = clamp((state.testProgress - 0.1) / 0.8, 0, 1);
          }
        }
        if (state.animProgress >= 1) {
          if (isFinite(state.targetCycles) && state.targetCycles < 1e7) {
            startAnimation('crack_critical');
          } else {
            /* Run-out */
            state.cycleCount = 1e7;
            state.animPhase = 'runout';
            completeTest(true);
          }
          return;
        }
        break;

      case 'crack_critical':
        updateSpecimenPhysics(dt);
        state.crackSize = 0.9 + state.animProgress * 0.1;
        if (state.animProgress >= 1) {
          initFractureParticles();
          playCrack();
          startAnimation('fracture');
          return;
        }
        break;

      case 'fracture':
        updateFractureParticles();
        if (state.animProgress >= 1) {
          startAnimation('decelerating');
          return;
        }
        break;

      case 'decelerating':
        updateSpecimenPhysics(dt);
        updateFractureParticles();
        if (state.animProgress >= 1) {
          state.motorSpeed = 0;
          state.animPhase = 'complete';
          completeTest(false);
          return;
        }
        break;

      default:
        animRAF = null;
        drawMachine();
        drawGraph();
        return;
    }

    drawMachine();
    drawGraph();
    updateBadges();
    animRAF = requestAnimationFrame(animLoop);
  }

  function completeTest(isRunout) {
    var mat = MATERIALS[state.matIdx];
    var sigma = state.stressAmplitude;
    var Nf = isRunout ? Infinity : state.targetCycles;
    var Se = mat.Se || getFatigueStrengthAt1e7(mat);
    var lifeRatio = sigma / Se * 100;
    var safetyFactor = Se / sigma;
    var fracType, failMode;

    if (isRunout) {
      fracType = 'Run-out';
      failMode = 'Infinite Life';
    } else if (Nf < 1000) {
      fracType = 'Low-Cycle';
      failMode = 'Fatigue (LCF)';
    } else if (Nf >= 1000 && Nf < 1e6) {
      fracType = 'High-Cycle';
      failMode = 'Fatigue (HCF)';
    } else {
      fracType = 'Very High-Cycle';
      failMode = 'Fatigue (VHCF)';
    }

    if (sigma >= mat.sigmaU) {
      fracType = 'Static';
      failMode = 'Static Overload';
    }

    state.results = {
      stress: roundN(sigma, 1),
      cycles: isRunout ? '\u221e (>10\u2077)' : formatCycles(Nf),
      endurance: mat.Se !== null ? mat.Se : 'N/A',
      uts: mat.sigmaU,
      lifeRatio: roundN(lifeRatio, 1),
      fracType: fracType,
      safetyFactor: roundN(safetyFactor, 2),
      failMode: failMode
    };

    /* Add test point */
    state.testPoints.push({
      matId: mat.id,
      sigma: sigma,
      N: isRunout ? Infinity : Nf
    });

    displayResults();
    advanceStep(7);
    state.graphMode = 'sn';
    drawGraph();
    drawMachine();
    updateBadges();
  }

  /* ═══════════════════════════════════════════════════════════════
     S13  LAB PROCEDURE STATE MACHINE
     ═══════════════════════════════════════════════════════════════ */
  var LAB_STEPS = [
    'Select Material',
    'Set Diameter',
    'Set Load',
    'Set Speed',
    'Mount Specimen',
    'Start Motor',
    'View Results'
  ];

  function buildLabSteps() {
    elLabSteps.innerHTML = '';
    LAB_STEPS.forEach(function (s, i) {
      if (i > 0) {
        var sep = document.createElement('span');
        sep.className = 'lab-step-sep';
        sep.textContent = '\u25b8';
        elLabSteps.appendChild(sep);
      }
      var step = document.createElement('span');
      step.className = 'lab-step' + (i === 0 ? ' active' : '');
      step.innerHTML = '<span class="lab-step-num">' + (i + 1) + '</span> ' + s;
      step.dataset.step = i;
      elLabSteps.appendChild(step);
    });
  }

  function advanceStep(n) {
    state.labStep = Math.max(state.labStep, n);
    var steps = elLabSteps.querySelectorAll('.lab-step');
    steps.forEach(function (s) {
      var si = parseInt(s.dataset.step);
      s.classList.remove('active', 'done');
      if (si < state.labStep) s.classList.add('done');
      else if (si === state.labStep) s.classList.add('active');
    });
  }

  function buildMaterialTabs() {
    elMatTabs.innerHTML = '';
    MATERIALS.forEach(function (m, i) {
      var pill = document.createElement('button');
      pill.className = 'mat-pill' + (i === state.matIdx ? ' active' : '');
      pill.textContent = m.name;
      pill.dataset.idx = i;
      pill.addEventListener('click', function () {
        state.matIdx = i;
        elMatTabs.querySelectorAll('.mat-pill').forEach(function (p) { p.classList.remove('active'); });
        pill.classList.add('active');
        advanceStep(1);
        updateStress();
        if (state.animPhase === 'idle' || state.animPhase === 'complete' || state.animPhase === 'runout') {
          drawMachine();
          drawGraph();
          updateBadges();
        }
      });
      elMatTabs.appendChild(pill);
    });
    /* + Custom button */
    var customBtn = document.createElement('button');
    customBtn.className = 'mat-pill mat-pill-custom';
    customBtn.textContent = '+ Custom';
    customBtn.addEventListener('click', openCustomMaterialModal);
    elMatTabs.appendChild(customBtn);
  }

  /* ── Custom Material Modal ── */
  var CM_FIELDS = [
    { key: 'name',   label: 'Material Name', type: 'text', min: null, max: null, uType: '', hint: 'e.g. Inconel 718' },
    { key: 'sigmaU', label: 'Ultimate Tensile Strength', type: 'number', min: 50, max: 2500, uType: 'stress', hint: '50\u20132500' },
    { key: 'Se',     label: 'Endurance Limit (Se)', type: 'number', min: 0, max: 1500, uType: 'stress', optional: true, hint: 'Leave empty if none' },
    { key: 'A',      label: 'Basquin A', type: 'number', min: 100, max: 5000, uType: 'stress', hint: '100\u20135000' },
    { key: 'b',      label: 'Basquin b (negative)', type: 'number', min: -0.3, max: -0.03, uType: '', hint: '\u22120.3 to \u22120.03' }
  ];

  function openCustomMaterialModal() {
    var overlay = document.createElement('div');
    overlay.className = 'cm-overlay';
    var modal = document.createElement('div');
    modal.className = 'cm-modal';
    var isImp = state.imperial;
    var su = isImp ? 'psi' : 'MPa';

    modal.innerHTML =
      '<div class="cm-title">Custom Fatigue Material</div>' +
      '<div class="cm-subtitle">Enter fatigue properties' + (isImp ? ' (Imperial)' : ' (SI)') + '. Se is optional (leave empty for no endurance limit).</div>' +
      '<div class="cm-grid" id="cm-grid"></div>' +
      '<div class="cm-error-msg" id="cm-error"></div>' +
      '<div class="cm-actions">' +
        '<button class="btn btn-ghost" id="cm-cancel">Cancel</button>' +
        '<button class="btn btn-primary" id="cm-submit">Add Material</button>' +
      '</div>';

    overlay.appendChild(modal);
    document.body.appendChild(overlay);

    var grid = modal.querySelector('#cm-grid');
    CM_FIELDS.forEach(function (f) {
      var field = document.createElement('div');
      field.className = 'cm-field' + (f.key === 'name' ? ' full' : '');
      var unitLabel = f.uType === 'stress' ? su : '';
      var rangeHint = '';
      if (f.min !== null && f.max !== null && f.type === 'number') {
        var dispMin = f.uType === 'stress' && isImp ? Math.round(f.min * MPA_TO_PSI) : f.min;
        var dispMax = f.uType === 'stress' && isImp ? Math.round(f.max * MPA_TO_PSI) : f.max;
        rangeHint = ' <span class="cm-range">(' + dispMin + ' \u2013 ' + dispMax + ')</span>';
      }
      var placeholder = f.hint || '';
      if (f.uType === 'stress' && isImp && f.min !== null) {
        placeholder = Math.round(f.min * MPA_TO_PSI) + '\u2013' + Math.round(f.max * MPA_TO_PSI);
      }
      field.innerHTML =
        '<span class="cm-label">' + f.label + (unitLabel ? ' (' + unitLabel + ')' : '') + rangeHint + '</span>' +
        '<input class="cm-input" id="cm-' + f.key + '" type="' + f.type + '"' +
        (f.type === 'number' ? ' step="any"' : '') +
        ' placeholder="' + placeholder + '">';
      grid.appendChild(field);
    });

    modal.querySelector('#cm-cancel').addEventListener('click', function () { overlay.remove(); });
    overlay.addEventListener('click', function (e) { if (e.target === overlay) overlay.remove(); });

    modal.querySelector('#cm-submit').addEventListener('click', function () {
      var errEl = modal.querySelector('#cm-error');
      errEl.textContent = '';
      var vals = {};

      for (var vi = 0; vi < CM_FIELDS.length; vi++) {
        var cf = CM_FIELDS[vi];
        var inp = modal.querySelector('#cm-' + cf.key);
        var raw = inp.value.trim();
        inp.classList.remove('error');

        if (!raw && cf.optional) { vals[cf.key] = null; continue; }
        if (!raw) {
          inp.classList.add('error');
          errEl.textContent = cf.label + ' is required.';
          inp.focus(); return;
        }

        if (cf.type === 'number') {
          var num = parseFloat(raw);
          if (isNaN(num)) {
            inp.classList.add('error');
            errEl.textContent = cf.label + ': enter a valid number.';
            inp.focus(); return;
          }
          /* Convert from display units to SI (MPa) for validation */
          var siVal = (cf.uType === 'stress' && isImp) ? num / MPA_TO_PSI : num;
          /* Range validation */
          if (cf.min !== null && siVal < cf.min) {
            inp.classList.add('error');
            errEl.textContent = cf.label + ': minimum is ' + (cf.uType === 'stress' && isImp ? Math.round(cf.min * MPA_TO_PSI) : cf.min) + '.';
            inp.focus(); return;
          }
          if (cf.max !== null && siVal > cf.max) {
            inp.classList.add('error');
            errEl.textContent = cf.label + ': maximum is ' + (cf.uType === 'stress' && isImp ? Math.round(cf.max * MPA_TO_PSI) : cf.max) + '.';
            inp.focus(); return;
          }
          vals[cf.key] = siVal;
        } else {
          if (raw.length > 20) {
            inp.classList.add('error');
            errEl.textContent = 'Name too long (max 20 chars).';
            inp.focus(); return;
          }
          vals[cf.key] = raw;
        }
      }

      /* Build the custom material object */
      var hasSe = vals.Se !== null && vals.Se > 0;
      var customMat = {
        name: vals.name,
        sigmaU: vals.sigmaU,
        Se: hasSe ? vals.Se : null,
        A: vals.A,
        b: vals.b,
        hasEndurance: hasSe,
        Ne: hasSe ? 1e6 : null,
        lowN: 1000,
        lowSigma: vals.sigmaU * 0.9,
        color: '#e040fb'
      };

      MATERIALS.push(customMat);
      state.matIdx = MATERIALS.length - 1;
      buildMaterialTabs();
      updateStress();
      resetTest();
      drawMachine();
      drawGraph();
      updateBadges();
      overlay.remove();
    });
  }

  function updateStress() {
    state.stressAmplitude = calcStressAmplitude(state.load, state.dia);
    state.targetCycles = getCyclesToFailure(MATERIALS[state.matIdx], state.stressAmplitude);
  }

  function displayResults() {
    if (!state.results) return;
    show(elReadoutGrid);
    $('res-stress').textContent = toStress(state.results.stress);
    $('res-cycles').textContent = state.results.cycles;
    var endVal = state.results.endurance;
    $('res-endurance').textContent = (endVal !== 'N/A' && typeof endVal === 'number') ? toStress(endVal) : endVal;
    $('res-uts').textContent = toStress(state.results.uts);
    $('res-ratio').textContent = state.results.lifeRatio;
    $('res-fractype').textContent = state.results.fracType;
    $('res-safety').textContent = state.results.safetyFactor;
    $('res-failmode').textContent = state.results.failMode;
  }

  function updateBadges() {
    elBadgeStress.textContent = toStress(roundN(state.stressAmplitude, 1));
    elBadgeCycles.textContent = formatCycles(Math.round(state.cycleCount));
    elBadgeSpeed.textContent = Math.round(state.motorSpeed);
    if (state.results) {
      elBadgeLife.textContent = state.results.failMode === 'Infinite Life' ? '\u221e' : state.results.cycles;
    } else {
      elBadgeLife.textContent = '\u2014';
    }
  }

  function resetTest() {
    if (animRAF) { cancelAnimationFrame(animRAF); animRAF = null; }
    state.mounted = false;
    state.animPhase = 'idle';
    state.animProgress = 0;
    state.testProgress = 0;
    state.specAngle = 0;
    state.motorSpeed = 0;
    state.crackSize = 0;
    state.cycleCount = 0;
    state.graphMode = 'cycle';
    state.results = null;
    state.fractureParts = [];
    state.labStep = 0;
    advanceStep(0);
    /* Reset readout values to dashes (grid stays visible) */
    ['res-stress','res-cycles','res-endurance','res-uts','res-ratio','res-fractype','res-safety','res-failmode'].forEach(function(id) { $(id).textContent = '\u2014'; });
    elBtnMount.disabled = false;
    elBtnStart.disabled = true;
    updateStress();
    drawMachine();
    drawGraph();
    updateBadges();
  }

  /* ═══════════════════════════════════════════════════════════════
     S14  MODE SWITCHING
     ═══════════════════════════════════════════════════════════════ */
  function setMode(m) {
    state.mode = m;
    hide(elSimWrapper); hide(elExploreWrapper); hide(elPracticeWrapper); hide(elQuizWrapper);
    switch (m) {
      case 'simulate': show(elSimWrapper); drawMachine(); drawGraph(); break;
      case 'explore':  show(elExploreWrapper); buildExploreUI(); break;
      case 'practice': show(elPracticeWrapper); if (!state.pProb) newPractice(); break;
      case 'quiz':     show(elQuizWrapper); if (state.qSet.length === 0) startQuiz(); break;
    }
  }

  /* ═══════════════════════════════════════════════════════════════
     S15  EXPLORE MODE (12 diagrams)
     ═══════════════════════════════════════════════════════════════ */
  var EXP_CATS = ['Components', 'Theory', 'Failure', 'Design'];

  function buildExploreUI() {
    /* Category tabs */
    elExploreCats.innerHTML = '';
    EXP_CATS.forEach(function (cat) {
      var btn = document.createElement('button');
      btn.className = 'pill' + (cat === state.expCat ? ' active' : '');
      btn.textContent = cat;
      btn.addEventListener('click', function () {
        state.expCat = cat;
        elExploreCats.querySelectorAll('.pill').forEach(function (p) { p.classList.remove('active'); });
        btn.classList.add('active');
        buildExploreGrid();
      });
      elExploreCats.appendChild(btn);
    });
    buildExploreGrid();
  }

  function buildExploreGrid() {
    elExploreGrid.innerHTML = '';
    var filtered = CONCEPTS.filter(function (c) { return c.cat === state.expCat; });
    filtered.forEach(function (c, i) {
      var btn = document.createElement('button');
      btn.className = 'explore-btn' + (i === 0 ? ' active' : '');
      btn.textContent = c.name;
      btn.addEventListener('click', function () {
        elExploreGrid.querySelectorAll('.explore-btn').forEach(function (b) { b.classList.remove('active'); });
        btn.classList.add('active');
        selectConcept(c);
      });
      elExploreGrid.appendChild(btn);
    });
    if (filtered.length > 0) selectConcept(filtered[0]);
  }

  function selectConcept(concept) {
    state.expIdx = CONCEPTS.indexOf(concept);
    elExploreInfo.innerHTML = '';
    var h = document.createElement('h3');
    h.textContent = concept.name;
    if (concept.symbol) h.textContent += ' (' + concept.symbol + ')';
    elExploreInfo.appendChild(h);

    var p = document.createElement('p');
    p.textContent = concept.desc;
    elExploreInfo.appendChild(p);

    if (concept.formula) {
      var fb = document.createElement('div');
      fb.className = 'formula-box';
      fb.textContent = concept.formula;
      elExploreInfo.appendChild(fb);
    }

    if (concept.example) {
      var eb = document.createElement('div');
      eb.className = 'example-box';
      eb.innerHTML = '<strong>Example: </strong>' + concept.example.problem + '<br>';
      concept.example.steps.forEach(function (s) {
        eb.innerHTML += '\u2022 ' + s + '<br>';
      });
      elExploreInfo.appendChild(eb);
    }

    drawExploreDiagram(concept);
  }

  function drawExploreDiagram(concept) {
    eCtx.clearRect(0, 0, EW, EH);
    eCtx.fillStyle = '#0a0e14';
    eCtx.fillRect(0, 0, EW, EH);

    switch (concept.id) {
      case 'rr-moore':       drawExploreRRMoore(); break;
      case 'specimen':       drawExploreSpecimen(); break;
      case 'loading':        drawExploreLoading(); break;
      case 'sn-curve':       drawExploreSNCurve(); break;
      case 'endurance':      drawExploreEndurance(); break;
      case 'stress-conc':    drawExploreStressConc(); break;
      case 'crack-init':     drawExploreCrackInit(); break;
      case 'crack-prop':     drawExploreCrackProp(); break;
      case 'fracture-surface': drawExploreFracSurface(); break;
      case 'goodman':        drawExploreGoodman(); break;
      case 'soderberg':      drawExploreSoderberg(); break;
      case 'miners-rule':    drawExploreMiner(); break;
    }

    /* Title bar */
    eCtx.fillStyle = 'rgba(94,53,177,0.15)';
    eCtx.fillRect(0, EH - 30, EW, 30);
    eCtx.fillStyle = '#b39ddb';
    eCtx.font = 'bold 11px sans-serif';
    eCtx.textAlign = 'center';
    eCtx.fillText(concept.name, EW / 2, EH - 10);
  }

  function drawExploreRRMoore() {
    var cx = EW / 2, cy = 180;
    /* Simplified machine schematic */
    /* Motor */
    eCtx.fillStyle = '#455a64';
    eCtx.fillRect(100, cy - 35, 80, 70);
    eCtx.strokeStyle = '#78909c';
    eCtx.lineWidth = 1;
    eCtx.strokeRect(100, cy - 35, 80, 70);
    eCtx.fillStyle = '#5e35b1';
    eCtx.font = '10px sans-serif';
    eCtx.textAlign = 'center';
    eCtx.fillText('MOTOR', 140, cy + 4);

    /* Shaft */
    eCtx.fillStyle = '#78909c';
    eCtx.fillRect(180, cy - 4, 450, 8);

    /* Bearings */
    [270, 450].forEach(function (bx) {
      eCtx.fillStyle = '#607d8b';
      eCtx.fillRect(bx - 15, cy - 20, 30, 40);
      eCtx.strokeStyle = '#78909c';
      eCtx.strokeRect(bx - 15, cy - 20, 30, 40);
      eCtx.fillStyle = '#b39ddb';
      eCtx.font = '8px sans-serif';
      eCtx.fillText('Bearing', bx, cy - 25);
    });

    /* Specimen (highlighted) */
    eCtx.fillStyle = '#5e35b1';
    eCtx.fillRect(285, cy - 6, 150, 12);
    eCtx.fillStyle = '#fff';
    eCtx.font = 'bold 9px sans-serif';
    eCtx.fillText('SPECIMEN', 360, cy + 3);

    /* Counter */
    eCtx.fillStyle = '#0d1117';
    eCtx.strokeStyle = '#5e35b1';
    eCtx.fillRect(640, cy - 20, 80, 40);
    eCtx.strokeRect(640, cy - 20, 80, 40);
    eCtx.fillStyle = '#5e35b1';
    eCtx.font = '9px monospace';
    eCtx.fillText('COUNTER', 680, cy + 4);

    /* Weights */
    [270, 450].forEach(function (bx) {
      eCtx.strokeStyle = '#5e35b1';
      eCtx.lineWidth = 2;
      eCtx.beginPath(); eCtx.moveTo(bx, cy + 20); eCtx.lineTo(bx, cy + 80); eCtx.stroke();
      eCtx.fillStyle = '#5e35b1';
      eCtx.fillRect(bx - 18, cy + 80, 36, 20);
      eCtx.fillStyle = '#fff';
      eCtx.font = 'bold 9px sans-serif';
      eCtx.fillText('W', bx, cy + 94);
    });

    /* Labels */
    eCtx.fillStyle = '#dde3f0';
    eCtx.font = 'bold 12px sans-serif';
    eCtx.fillText('R.R. Moore Rotating Beam Fatigue Tester', cx, 30);
    eCtx.fillStyle = '#6b7a99';
    eCtx.font = '10px sans-serif';
    eCtx.fillText('Pure bending in gauge section \u2014 constant moment, zero shear', cx, 50);

    /* Bending moment diagram */
    eCtx.strokeStyle = '#ff5555';
    eCtx.lineWidth = 1.5;
    eCtx.beginPath();
    eCtx.moveTo(270, cy + 130);
    eCtx.lineTo(290, cy + 130);
    eCtx.lineTo(330, cy + 110);
    eCtx.lineTo(390, cy + 110);
    eCtx.lineTo(430, cy + 130);
    eCtx.lineTo(450, cy + 130);
    eCtx.stroke();
    eCtx.fillStyle = 'rgba(255,85,85,0.1)';
    eCtx.beginPath();
    eCtx.moveTo(290, cy + 130);
    eCtx.lineTo(330, cy + 110);
    eCtx.lineTo(390, cy + 110);
    eCtx.lineTo(430, cy + 130);
    eCtx.closePath();
    eCtx.fill();
    eCtx.fillStyle = '#ff5555';
    eCtx.font = '9px sans-serif';
