  function exportCSV() {
    var mat = MATERIALS[state.matIdx];
    var curve = generateSNCurve(mat);
    var header = 'Cycles,Stress_' + uStress() + ',Material\n';
    /* Include test points after curve data */
    var rows = curve.map(function (pt) {
      var n = isFinite(pt.N) ? Math.round(pt.N) : 'RUNOUT';
      return n + ',' + roundN(toStress(pt.sigma), 1) + ',' + mat.name;
    }).join('\n');
    /* Append completed test points */
    if (state.testPoints && state.testPoints.length) {
      rows += '\n\n# Test Results\nCycles,Stress_' + uStress() + ',Material\n';
      state.testPoints.forEach(function (tp) {
        if (tp.matId === mat.id) {
          var nc = isFinite(tp.N) ? Math.round(tp.N) : 'RUNOUT';
          rows += nc + ',' + roundN(toStress(tp.sigma), 1) + ',' + mat.name + '\n';
        }
      });
    }
    var blob = new Blob([header + rows], { type: 'text/csv' });
    var a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'fatigue_SN_' + mat.name.replace(/\s+/g, '_') + '.csv';
    a.click();
    URL.revokeObjectURL(a.href);
  }

