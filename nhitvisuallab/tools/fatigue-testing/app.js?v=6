    mCtx.beginPath();
    mCtx.moveTo(rx + 6, ry); mCtx.lineTo(rx + rw - 6, ry);
    mCtx.quadraticCurveTo(rx + rw, ry, rx + rw, ry + 6);
    mCtx.lineTo(rx + rw, ry + rh - 6);
    mCtx.quadraticCurveTo(rx + rw, ry + rh, rx + rw - 6, ry + rh);
    mCtx.lineTo(rx + 6, ry + rh);
    mCtx.quadraticCurveTo(rx, ry + rh, rx, ry + rh - 6);
    mCtx.lineTo(rx, ry + 6);
