  function drawExploreMiner() {
    var cx = EW / 2, cy = 180;
    eCtx.fillStyle = '#dde3f0';
    eCtx.font = 'bold 12px sans-serif';
    eCtx.textAlign = 'center';
    eCtx.fillText('Miner\u2019s Rule (Palmgren-Miner Cumulative Damage)', cx, 25);

    /* Damage bar visualization */
    var ox = 150, oy = 130, bw = 500, bh = 35;
    /* Bar outline */
    eCtx.strokeStyle = '#6b7a99';
    eCtx.lineWidth = 1;
    eCtx.strokeRect(ox, oy, bw, bh);

    /* Damage segments */
    var segments = [
      { label: 'n\u2081/N\u2081 = 0.3', w: 0.3, color: '#5e35b1' },
      { label: 'n\u2082/N\u2082 = 0.2', w: 0.2, color: '#7c4dff' },
      { label: 'n\u2083/N\u2083 = 0.15', w: 0.15, color: '#b39ddb' }
    ];
    var dx = ox;
    segments.forEach(function (seg) {
      var sw = seg.w * bw;
      eCtx.fillStyle = seg.color;
      eCtx.fillRect(dx, oy, sw, bh);
      eCtx.fillStyle = '#fff';
      eCtx.font = '8px monospace';
      eCtx.textAlign = 'center';
      eCtx.fillText(seg.label, dx + sw / 2, oy + bh / 2 + 3);
      dx += sw;
    });

    /* Remaining life */
    eCtx.fillStyle = 'rgba(61,220,132,0.15)';
    eCtx.fillRect(dx, oy, ox + bw - dx, bh);
    eCtx.fillStyle = '#3ddc84';
    eCtx.font = '9px sans-serif';
    eCtx.fillText('Remaining: 35%', dx + (ox + bw - dx) / 2, oy + bh / 2 + 3);

    /* D = 0.65 */
    eCtx.fillStyle = '#f5c842';
    eCtx.font = 'bold 12px monospace';
    eCtx.textAlign = 'center';
    eCtx.fillText('D = 0.3 + 0.2 + 0.15 = 0.65 < 1.0 \u2192 No failure', cx, oy + bh + 25);

    /* Failure threshold */
    eCtx.strokeStyle = '#ff5555';
    eCtx.lineWidth = 2;
    eCtx.setLineDash([4, 4]);
    eCtx.beginPath(); eCtx.moveTo(ox + bw, oy - 10); eCtx.lineTo(ox + bw, oy + bh + 10); eCtx.stroke();
    eCtx.setLineDash([]);
    eCtx.fillStyle = '#ff5555';
    eCtx.font = 'bold 10px sans-serif';
    eCtx.fillText('D = 1.0 (Failure)', ox + bw, oy - 15);

    /* Formula */
    eCtx.fillStyle = '#5e35b1';
    eCtx.font = 'bold 14px monospace';
    eCtx.fillText('D = \u2211(n_i / N_i) = 1.0 at failure', cx, 60);

    /* Example S-N curve with multiple stress levels */
    var gox = 150, goy = 330, ggw = 500, ggh = 120;
    eCtx.strokeStyle = '#6b7a99';
    eCtx.lineWidth = 1;
    eCtx.beginPath(); eCtx.moveTo(gox, goy - ggh); eCtx.lineTo(gox, goy); eCtx.lineTo(gox + ggw, goy); eCtx.stroke();
    /* S-N curve */
    eCtx.strokeStyle = '#5e35b1';
    eCtx.lineWidth = 1.5;
    eCtx.beginPath();
    eCtx.moveTo(gox, goy - ggh * 0.9);
    eCtx.bezierCurveTo(gox + ggw * 0.3, goy - ggh * 0.6, gox + ggw * 0.5, goy - ggh * 0.35, gox + ggw * 0.65, goy - ggh * 0.3);
    eCtx.lineTo(gox + ggw, goy - ggh * 0.3);
    eCtx.stroke();

    /* Stress levels */
    var stressLevels = [
      { sigma: 0.8, N: 0.2, label: '\u03c3\u2081', color: '#5e35b1' },
      { sigma: 0.55, N: 0.45, label: '\u03c3\u2082', color: '#7c4dff' },
      { sigma: 0.4, N: 0.65, label: '\u03c3\u2083', color: '#b39ddb' }
    ];
    stressLevels.forEach(function (sl) {
      var sx = gox + sl.N * ggw;
      var sy = goy - sl.sigma * ggh;
      eCtx.fillStyle = sl.color;
      eCtx.beginPath(); eCtx.arc(sx, sy, 4, 0, Math.PI * 2); eCtx.fill();
      eCtx.font = '9px sans-serif';
      eCtx.textAlign = 'left';
      eCtx.fillText(sl.label, sx + 6, sy + 3);
    });
  }

