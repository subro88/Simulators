  });

  /* Sliders */
  /* ── Slider + direct input system ── */
  function makeSliderEditable(slider, valEl, opts) {
    /* Normal slider drag */
    slider.addEventListener('input', function () {
      var v = opts.parse(this.value);
      opts.setState(v);
      opts.updateLabel(v);
      opts.onStep();
      opts.refresh();
    });

    /* Click on value label → show inline input */
    valEl.style.cursor = 'pointer';
    valEl.title = 'Click to type a value';
    valEl.addEventListener('click', function () {
      if (valEl.querySelector('input')) return; /* already editing */
      var current = opts.getCurrent();
      var inp = document.createElement('input');
      inp.type = 'number';
      inp.step = opts.step || 'any';
      inp.value = opts.toDisplay ? opts.toDisplay(current) : current;
      inp.className = 'inline-val-input';
      inp.style.cssText = 'width:60px;padding:2px 4px;border:1px solid var(--accent);border-radius:4px;background:var(--bg);color:var(--accent);font-family:var(--mono);font-size:0.82rem;text-align:center;outline:none;';
      valEl.textContent = '';
      valEl.appendChild(inp);
      inp.focus();
      inp.select();

      function commit() {
        var raw = parseFloat(inp.value);
        if (!isNaN(raw)) {
          /* Convert from display to SI if needed */
          var si = opts.fromDisplay ? opts.fromDisplay(raw) : raw;
          si = Math.max(parseFloat(slider.min), Math.min(parseFloat(slider.max), si));
          slider.value = si;
          opts.setState(si);
        }
        opts.updateLabel(opts.getCurrent());
        opts.onStep();
        opts.refresh();
      }
      inp.addEventListener('blur', commit);
      inp.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') { e.preventDefault(); inp.blur(); }
        if (e.key === 'Escape') { opts.updateLabel(opts.getCurrent()); }
      });
    });
  }

