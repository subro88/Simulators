    eCtx.strokeStyle = '#6b7a99';
    eCtx.lineWidth = 1.5;
    eCtx.beginPath(); eCtx.moveTo(ox, oy - gh); eCtx.lineTo(ox, oy); eCtx.lineTo(ox + gw, oy); eCtx.stroke();
    eCtx.fillStyle = '#6b7a99';
    eCtx.font = '10px sans-serif';
    eCtx.textAlign = 'center';
    eCtx.fillText('Mean Stress \u03c3_m', ox + gw / 2, oy + 25);

    /* Se point */
    eCtx.fillStyle = '#3ddc84';
    eCtx.beginPath(); eCtx.arc(ox, oy - gh * 0.7, 4, 0, Math.PI * 2); eCtx.fill();
    eCtx.font = '9px sans-serif';
    eCtx.textAlign = 'right';
    eCtx.fillText('Se', ox - 8, oy - gh * 0.7 + 4);

    /* Sy and Su points */
    eCtx.fillStyle = '#ffa000';
    eCtx.beginPath(); eCtx.arc(ox + gw * 0.55, oy, 4, 0, Math.PI * 2); eCtx.fill();
    eCtx.textAlign = 'center';
    eCtx.fillText('\u03c3_y', ox + gw * 0.55, oy + 14);
    eCtx.fillStyle = '#ff5555';
    eCtx.beginPath(); eCtx.arc(ox + gw * 0.85, oy, 4, 0, Math.PI * 2); eCtx.fill();
    eCtx.fillText('\u03c3_u', ox + gw * 0.85, oy + 14);

    /* Goodman line */
    eCtx.strokeStyle = '#5e35b1';
    eCtx.lineWidth = 2;
    eCtx.beginPath(); eCtx.moveTo(ox, oy - gh * 0.7); eCtx.lineTo(ox + gw * 0.85, oy); eCtx.stroke();
    eCtx.fillStyle = '#5e35b1';
    eCtx.font = '10px sans-serif';
    eCtx.textAlign = 'left';
    eCtx.fillText('Goodman', ox + gw * 0.4, oy - gh * 0.32);

    /* Soderberg line */
    eCtx.strokeStyle = '#ffa000';
    eCtx.lineWidth = 2;
    eCtx.setLineDash([6, 4]);
    eCtx.beginPath(); eCtx.moveTo(ox, oy - gh * 0.7); eCtx.lineTo(ox + gw * 0.55, oy); eCtx.stroke();
    eCtx.setLineDash([]);
    eCtx.fillStyle = '#ffa000';
    eCtx.fillText('Soderberg (more conservative)', ox + gw * 0.15, oy - gh * 0.28);

    eCtx.fillStyle = '#5e35b1';
    eCtx.font = 'bold 12px monospace';
    eCtx.textAlign = 'center';
    eCtx.fillText('Soderberg: \u03c3_a/Se + \u03c3_m/\u03c3_y = 1', cx, 55);
