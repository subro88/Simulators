  /* Get S-N curve data for a material (for plotting) */
  function generateSNCurve(mat) {
    var points = [];
    /* from N = 100 to N = 1e8 on log scale */
    var logMin = 2, logMax = 8;
    var steps = 200;
    for (var i = 0; i <= steps; i++) {
      var logN = logMin + (logMax - logMin) * i / steps;
      var N = Math.pow(10, logN);
      var sigma = getSigmaAtN(mat, N);
      points.push({ N: N, sigma: sigma, logN: logN });
    }
    return points;
  }

  /* Get stress amplitude at N cycles for a material */
  function getSigmaAtN(mat, N) {
    if (N <= 0) return mat.sigmaU;
    if (N < 1000) {
      /* Interpolate from sigmaU at N=1 to sigma1k at N=1000 */
      var t = log10(N) / 3;
      return lerp(mat.sigmaU, mat.sigma1k, t);
    }
    if (mat.hasEndurance && mat.Se !== null) {
      /* With endurance limit: Basquin from 1e3 to Ne, then flat */
      if (N >= mat.Ne) return mat.Se;
      var logNorm = (log10(N) - 3) / (log10(mat.Ne) - 3);
      return lerp(mat.sigma1k, mat.Se, logNorm);
    } else {
      /* No endurance limit: continuous Basquin decline */
      var sigma = mat.A * Math.pow(N, mat.b);
      return Math.max(sigma, 1);
    }
  }

  /* Get cycles to failure at given stress amplitude */
  function getCyclesToFailure(mat, sigmaA) {
    if (sigmaA <= 0) return Infinity;
    if (sigmaA >= mat.sigmaU) return 0; /* static fracture */
    if (sigmaA >= mat.sigma1k) {
      /* Low-cycle region: interpolate N=1 to N=1e3 */
      var t = (mat.sigmaU - sigmaA) / (mat.sigmaU - mat.sigma1k);
      return Math.pow(10, 3 * t);
    }
    if (mat.hasEndurance && mat.Se !== null) {
      if (sigmaA <= mat.Se) return Infinity; /* infinite life */
      /* High-cycle: interpolate from sigma1k to Se */
      var logNe = log10(mat.Ne);
      var t2 = (mat.sigma1k - sigmaA) / (mat.sigma1k - mat.Se);
      var logN = 3 + t2 * (logNe - 3);
      return Math.pow(10, logN);
    } else {
      /* No endurance limit: Basquin inversion */
      var N = Math.pow(sigmaA / mat.A, 1 / mat.b);
      return Math.min(N, 1e8);
    }
  }

  /* Calculate bending stress amplitude */
  function calcStressAmplitude(load, dia) {
    /* M = W * L / 2 where L = span = 100mm */
    var M = load * 0.1 / 2; /* N·m (L=100mm=0.1m) */
    var d = dia / 1000; /* m */
    var sigma = 32 * M / (Math.PI * d * d * d); /* Pa */
    return sigma / 1e6; /* MPa */
  }

