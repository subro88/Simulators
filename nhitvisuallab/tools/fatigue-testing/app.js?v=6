  function drawExploreSpecimen() {
    var cx = EW / 2, cy = 200;
    /* Draw specimen profile */
    eCtx.fillStyle = '#607d8b';
    eCtx.beginPath();
    eCtx.moveTo(150, cy - 30); /* left shoulder top */
    eCtx.lineTo(250, cy - 30);
    eCtx.quadraticCurveTo(280, cy - 30, 300, cy - 15); /* fillet */
    eCtx.lineTo(500, cy - 15); /* gauge section */
    eCtx.quadraticCurveTo(520, cy - 30, 550, cy - 30); /* fillet */
    eCtx.lineTo(650, cy - 30);
    eCtx.lineTo(650, cy + 30);
    eCtx.lineTo(550, cy + 30);
    eCtx.quadraticCurveTo(520, cy + 30, 500, cy + 15);
    eCtx.lineTo(300, cy + 15);
    eCtx.quadraticCurveTo(280, cy + 30, 250, cy + 30);
    eCtx.lineTo(150, cy + 30);
    eCtx.closePath();
    eCtx.fill();
    eCtx.strokeStyle = '#90a4ae';
    eCtx.lineWidth = 1;
    eCtx.stroke();

    /* Dimension lines */
    eCtx.strokeStyle = '#5e35b1';
    eCtx.lineWidth = 0.8;
    eCtx.setLineDash([3, 3]);
    /* Gauge length */
