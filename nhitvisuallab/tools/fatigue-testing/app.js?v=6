  function drawSpecimen() {
    var mat = MATERIALS[state.matIdx];
    var sx = BEARING_L_X;
    var ex = BEARING_R_X;
    var cy = SHAFT_Y;
    var halfH = 4 + (state.dia - 6) / 6 * 4; /* 4-8px visual half-height */
    var shoulderH = halfH * 1.5;

    if (state.animPhase === 'complete' && state.results && state.results.failMode !== 'Infinite Life') {
      /* Draw fractured specimen — two halves with gap */
      var gapX = SPEC_CX + randInt(-5, 5);
      /* Left half */
      mCtx.fillStyle = mat.color;
      mCtx.beginPath();
      mCtx.moveTo(sx, cy - shoulderH);
      mCtx.lineTo(sx + 25, cy - shoulderH);
      mCtx.quadraticCurveTo(sx + 35, cy - shoulderH, sx + 40, cy - halfH);
      mCtx.lineTo(gapX - 5, cy - halfH);
      mCtx.lineTo(gapX - 3, cy + halfH);
      mCtx.lineTo(sx + 40, cy + halfH);
      mCtx.quadraticCurveTo(sx + 35, cy + shoulderH, sx + 25, cy + shoulderH);
      mCtx.lineTo(sx, cy + shoulderH);
      mCtx.closePath();
      mCtx.fill();
      /* Right half */
      mCtx.beginPath();
      mCtx.moveTo(gapX + 5, cy - halfH);
      mCtx.lineTo(ex - 40, cy - halfH);
      mCtx.quadraticCurveTo(ex - 35, cy - shoulderH, ex - 25, cy - shoulderH);
      mCtx.lineTo(ex, cy - shoulderH);
      mCtx.lineTo(ex, cy + shoulderH);
      mCtx.lineTo(ex - 25, cy + shoulderH);
      mCtx.quadraticCurveTo(ex - 35, cy + shoulderH, ex - 40, cy + halfH);
      mCtx.lineTo(gapX + 3, cy + halfH);
      mCtx.closePath();
      mCtx.fill();
      return;
    }

    if (!state.mounted && state.animPhase === 'idle') return;

    /* Mounting animation */
    var mountAlpha = 1;
    if (state.animPhase === 'mounting') {
      mountAlpha = easeOut(state.animProgress);
    }

    mCtx.save();
    mCtx.globalAlpha = mountAlpha;

    /* Draw specimen profile: shoulder → fillet → gauge → fillet → shoulder */
    mCtx.fillStyle = mat.color;
    mCtx.beginPath();
    /* Top profile */
    mCtx.moveTo(sx, cy - shoulderH);
    mCtx.lineTo(sx + 25, cy - shoulderH);
    mCtx.quadraticCurveTo(sx + 35, cy - shoulderH, sx + 40, cy - halfH);
    mCtx.lineTo(ex - 40, cy - halfH);
    mCtx.quadraticCurveTo(ex - 35, cy - shoulderH, ex - 25, cy - shoulderH);
    mCtx.lineTo(ex, cy - shoulderH);
    /* Bottom profile */
    mCtx.lineTo(ex, cy + shoulderH);
    mCtx.lineTo(ex - 25, cy + shoulderH);
    mCtx.quadraticCurveTo(ex - 35, cy + shoulderH, ex - 40, cy + halfH);
    mCtx.lineTo(sx + 40, cy + halfH);
    mCtx.quadraticCurveTo(sx + 35, cy + shoulderH, sx + 25, cy + shoulderH);
    mCtx.lineTo(sx, cy + shoulderH);
    mCtx.closePath();
    mCtx.fill();

    /* Surface shading (rotation effect) */
    if (state.motorSpeed > 0) {
      var shadePhase = state.specAngle % (Math.PI * 2);
      for (var i = 0; i < 6; i++) {
        var px = sx + 50 + i * 25;
        var shade = 0.15 + 0.1 * Math.sin(shadePhase + i * 0.8);
        mCtx.fillStyle = 'rgba(255,255,255,' + shade + ')';
        mCtx.fillRect(px, cy - halfH + 1, 3, halfH * 2 - 2);
      }
    }

    /* Crack visualization */
    if (state.crackSize > 0.05) {
      var crackX = SPEC_CX;
      var crackDepth = state.crackSize * halfH * 1.6;
      mCtx.strokeStyle = '#0d1117';
      mCtx.lineWidth = 1.5;
      mCtx.beginPath();
      mCtx.moveTo(crackX, cy - halfH);
      mCtx.lineTo(crackX - 1, cy - halfH + crackDepth * 0.3);
      mCtx.lineTo(crackX + 1, cy - halfH + crackDepth * 0.6);
      mCtx.lineTo(crackX, cy - halfH + crackDepth);
      mCtx.stroke();
      /* Crack glow */
      if (state.crackSize > 0.5) {
        mCtx.strokeStyle = hexToRGBA('#ff5555', 0.3 + state.crackSize * 0.3);
        mCtx.lineWidth = 3;
        mCtx.beginPath();
        mCtx.moveTo(crackX, cy - halfH);
        mCtx.lineTo(crackX, cy - halfH + crackDepth);
        mCtx.stroke();
      }
    }

    /* Dimension annotation */
    mCtx.strokeStyle = 'rgba(94,53,177,0.5)';
    mCtx.lineWidth = 0.5;
    mCtx.setLineDash([2, 2]);
    mCtx.beginPath();
    mCtx.moveTo(sx + 40, cy + halfH + 15);
    mCtx.lineTo(ex - 40, cy + halfH + 15);
    mCtx.stroke();
    mCtx.setLineDash([]);
    mCtx.fillStyle = 'rgba(94,53,177,0.7)';
    mCtx.font = '7px monospace';
    mCtx.textAlign = 'center';
    mCtx.fillText('\u00d8' + toLength(state.dia) + ' ' + uLength(), SPEC_CX, cy + halfH + 24);

    mCtx.restore();
  }

  function drawForceArrows() {
    if (!state.mounted) return;
    var cy = SHAFT_Y;
