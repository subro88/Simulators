  /* Machine layout constants */
  var BASE_Y = 620;
  var MOTOR_X = 40, MOTOR_Y = 380;
  var MOTOR_W = 100, MOTOR_H = 110;
  var SHAFT_Y = MOTOR_Y + MOTOR_H / 2;
  var BEARING_L_X = 180, BEARING_R_X = 400;
  var BEARING_W = 40, BEARING_H = 50;
  var SPEC_LEN = BEARING_R_X - BEARING_L_X; /* 220px */
  var SPEC_CX = (BEARING_L_X + BEARING_R_X) / 2;
  var WEIGHT_DROP = 100;

  function drawMachine() {
    mCtx.clearRect(0, 0, MW, MH);
    drawMachineBackground();
    drawBasePlate();
    drawMotor();
    drawBeltDrive();
    drawBearingBlock(BEARING_L_X, 'L');
    drawBearingBlock(BEARING_R_X, 'R');
    drawLoadArm(BEARING_L_X);
    drawLoadArm(BEARING_R_X);
    drawDeadWeights(BEARING_L_X);
    drawDeadWeights(BEARING_R_X);
    drawSpecimen();
    drawForceArrows();
    drawRevCounter();
    drawDigitalPanel();
    drawStatusLEDs();
    drawSafetyGuard();
    drawMachineLabel();
    if (state.crackSize > 0.05 && state.animPhase !== 'idle') {
      drawCrackInset();
    }
    if (state.animPhase === 'fracture') {
      drawFractureFlash();
    }
    if (state.animPhase === 'complete' || state.animPhase === 'runout') {
      drawFractureSurface();
    }
    drawFractureParticles();
  }

  function drawMachineBackground() {
    mCtx.fillStyle = '#0a0e14';
    mCtx.fillRect(0, 0, MW, MH);
    mCtx.strokeStyle = 'rgba(42,48,80,0.3)';
    mCtx.lineWidth = 0.5;
    for (var x = 0; x < MW; x += 20) { mCtx.beginPath(); mCtx.moveTo(x, 0); mCtx.lineTo(x, MH); mCtx.stroke(); }
    for (var y = 0; y < MH; y += 20) { mCtx.beginPath(); mCtx.moveTo(0, y); mCtx.lineTo(MW, y); mCtx.stroke(); }
  }

  function drawBasePlate() {
    var bx = 20, by = BASE_Y, bw = MW - 40, bh = 30;
    var g = mCtx.createLinearGradient(bx, by, bx, by + bh);
    g.addColorStop(0, '#546e7a');
    g.addColorStop(0.5, '#455a64');
    g.addColorStop(1, '#37474f');
    mCtx.fillStyle = g;
    mCtx.beginPath();
    mCtx.moveTo(bx + 4, by); mCtx.lineTo(bx + bw - 4, by);
    mCtx.quadraticCurveTo(bx + bw, by, bx + bw, by + 4);
    mCtx.lineTo(bx + bw, by + bh - 4);
    mCtx.quadraticCurveTo(bx + bw, by + bh, bx + bw - 4, by + bh);
    mCtx.lineTo(bx + 4, by + bh);
    mCtx.quadraticCurveTo(bx, by + bh, bx, by + bh - 4);
    mCtx.lineTo(bx, by + 4);
    mCtx.quadraticCurveTo(bx, by, bx + 4, by);
    mCtx.closePath();
    mCtx.fill();
    mCtx.strokeStyle = '#78909c';
    mCtx.lineWidth = 1;
    mCtx.stroke();
    /* Mounting bolts */
    var boltY = by + bh / 2;
    [bx + 15, bx + bw - 15].forEach(function (x) {
      mCtx.fillStyle = '#607d8b';
      mCtx.beginPath(); mCtx.arc(x, boltY, 4, 0, Math.PI * 2); mCtx.fill();
      mCtx.fillStyle = '#78909c';
      mCtx.beginPath(); mCtx.arc(x, boltY, 2, 0, Math.PI * 2); mCtx.fill();
    });
    /* Floor shadow */
    mCtx.fillStyle = 'rgba(0,0,0,0.3)';
    mCtx.fillRect(bx + 5, by + bh, bw - 10, 6);
    /* Support legs */
    [bx + 30, bx + bw - 30].forEach(function (x) {
      mCtx.fillStyle = '#37474f';
      mCtx.fillRect(x - 8, by + bh, 16, 40);
    });
  }

  function drawMotor() {
    var mx = MOTOR_X, my = MOTOR_Y, mw = MOTOR_W, mh = MOTOR_H;
    /* Motor body */
    var g = mCtx.createLinearGradient(mx, my, mx, my + mh);
    g.addColorStop(0, '#546e7a');
    g.addColorStop(0.3, '#455a64');
    g.addColorStop(0.7, '#37474f');
    g.addColorStop(1, '#263238');
    mCtx.fillStyle = g;
    mCtx.beginPath();
    mCtx.moveTo(mx + 6, my); mCtx.lineTo(mx + mw - 6, my);
    mCtx.quadraticCurveTo(mx + mw, my, mx + mw, my + 6);
    mCtx.lineTo(mx + mw, my + mh - 6);
    mCtx.quadraticCurveTo(mx + mw, my + mh, mx + mw - 6, my + mh);
    mCtx.lineTo(mx + 6, my + mh);
    mCtx.quadraticCurveTo(mx, my + mh, mx, my + mh - 6);
    mCtx.lineTo(mx, my + 6);
    mCtx.quadraticCurveTo(mx, my, mx + 6, my);
    mCtx.closePath();
    mCtx.fill();
    mCtx.strokeStyle = '#78909c';
    mCtx.lineWidth = 1.5;
    mCtx.stroke();

    /* Cooling fins */
    mCtx.strokeStyle = '#546e7a';
    mCtx.lineWidth = 1;
    for (var i = 0; i < 8; i++) {
      var fy = my + 12 + i * (mh - 24) / 7;
      mCtx.beginPath(); mCtx.moveTo(mx + 5, fy); mCtx.lineTo(mx + mw - 5, fy); mCtx.stroke();
    }

    /* Motor nameplate */
    mCtx.fillStyle = '#1f2535';
    mCtx.fillRect(mx + 15, my + mh - 30, mw - 30, 18);
    mCtx.strokeStyle = '#5e35b1';
    mCtx.lineWidth = 0.5;
    mCtx.strokeRect(mx + 15, my + mh - 30, mw - 30, 18);
    mCtx.fillStyle = '#5e35b1';
    mCtx.font = '8px monospace';
    mCtx.textAlign = 'center';
    mCtx.fillText(state.speed + ' RPM', mx + mw / 2, my + mh - 18);

    /* Motor shaft output */
    mCtx.fillStyle = '#78909c';
    mCtx.fillRect(mx + mw, SHAFT_Y - 5, 15, 10);
    mCtx.fillStyle = '#607d8b';
    mCtx.beginPath(); mCtx.arc(mx + mw + 15, SHAFT_Y, 5, 0, Math.PI * 2); mCtx.fill();

    /* Rotation indicator on shaft end */
    if (state.motorSpeed > 0) {
      mCtx.save();
      mCtx.translate(mx + mw + 15, SHAFT_Y);
      mCtx.rotate(state.specAngle);
      mCtx.strokeStyle = '#5e35b1';
      mCtx.lineWidth = 1.5;
      mCtx.beginPath(); mCtx.moveTo(-3, 0); mCtx.lineTo(3, 0); mCtx.stroke();
      mCtx.beginPath(); mCtx.moveTo(0, -3); mCtx.lineTo(0, 3); mCtx.stroke();
      mCtx.restore();
    }

    /* Motor mount to base */
    mCtx.fillStyle = '#37474f';
    mCtx.fillRect(mx + 10, my + mh, 15, BASE_Y - my - mh);
    mCtx.fillRect(mx + mw - 25, my + mh, 15, BASE_Y - my - mh);
  }

  function drawBeltDrive() {
    var pulleyX = MOTOR_X + MOTOR_W + 15;
    var chuckX = BEARING_L_X - 20;
    /* Belt */
    mCtx.strokeStyle = '#455a64';
    mCtx.lineWidth = 6;
    mCtx.setLineDash([8, 4]);
    mCtx.beginPath();
    mCtx.moveTo(pulleyX, SHAFT_Y - 8);
    mCtx.lineTo(chuckX, SHAFT_Y - 8);
    mCtx.stroke();
    mCtx.beginPath();
    mCtx.moveTo(pulleyX, SHAFT_Y + 8);
    mCtx.lineTo(chuckX, SHAFT_Y + 8);
    mCtx.stroke();
    mCtx.setLineDash([]);

    /* Motor pulley */
    mCtx.fillStyle = '#607d8b';
    mCtx.beginPath(); mCtx.arc(pulleyX, SHAFT_Y, 12, 0, Math.PI * 2); mCtx.fill();
    mCtx.fillStyle = '#78909c';
    mCtx.beginPath(); mCtx.arc(pulleyX, SHAFT_Y, 6, 0, Math.PI * 2); mCtx.fill();

    /* Rotation marks on pulley */
    if (state.motorSpeed > 0) {
      mCtx.save();
      mCtx.translate(pulleyX, SHAFT_Y);
      mCtx.rotate(state.specAngle);
      mCtx.strokeStyle = '#90a4ae';
      mCtx.lineWidth = 1;
      for (var i = 0; i < 4; i++) {
        mCtx.beginPath();
        mCtx.moveTo(6 * Math.cos(i * Math.PI / 2), 6 * Math.sin(i * Math.PI / 2));
        mCtx.lineTo(11 * Math.cos(i * Math.PI / 2), 11 * Math.sin(i * Math.PI / 2));
        mCtx.stroke();
      }
      mCtx.restore();
    }

    /* Specimen chuck */
    mCtx.fillStyle = '#546e7a';
    mCtx.fillRect(chuckX - 5, SHAFT_Y - 10, 25, 20);
    mCtx.strokeStyle = '#78909c';
    mCtx.lineWidth = 1;
    mCtx.strokeRect(chuckX - 5, SHAFT_Y - 10, 25, 20);
    /* Chuck jaws */
    mCtx.fillStyle = '#607d8b';
    mCtx.fillRect(chuckX + 16, SHAFT_Y - 7, 6, 4);
    mCtx.fillRect(chuckX + 16, SHAFT_Y + 3, 6, 4);
  }

  function drawBearingBlock(bx, side) {
    var by = SHAFT_Y - BEARING_H / 2;
    /* Bearing housing */
    var g = mCtx.createLinearGradient(bx - BEARING_W / 2, by, bx + BEARING_W / 2, by);
    g.addColorStop(0, '#546e7a');
    g.addColorStop(0.5, '#607d8b');
    g.addColorStop(1, '#546e7a');
    mCtx.fillStyle = g;
    mCtx.beginPath();
    mCtx.moveTo(bx - BEARING_W / 2 + 4, by);
    mCtx.lineTo(bx + BEARING_W / 2 - 4, by);
    mCtx.quadraticCurveTo(bx + BEARING_W / 2, by, bx + BEARING_W / 2, by + 4);
    mCtx.lineTo(bx + BEARING_W / 2, by + BEARING_H - 4);
    mCtx.quadraticCurveTo(bx + BEARING_W / 2, by + BEARING_H, bx + BEARING_W / 2 - 4, by + BEARING_H);
    mCtx.lineTo(bx - BEARING_W / 2 + 4, by + BEARING_H);
    mCtx.quadraticCurveTo(bx - BEARING_W / 2, by + BEARING_H, bx - BEARING_W / 2, by + BEARING_H - 4);
    mCtx.lineTo(bx - BEARING_W / 2, by + 4);
    mCtx.quadraticCurveTo(bx - BEARING_W / 2, by, bx - BEARING_W / 2 + 4, by);
    mCtx.closePath();
    mCtx.fill();
    mCtx.strokeStyle = '#78909c';
    mCtx.lineWidth = 1;
    mCtx.stroke();

    /* Bearing bore */
    mCtx.fillStyle = '#0d1117';
    mCtx.beginPath(); mCtx.arc(bx, SHAFT_Y, 8, 0, Math.PI * 2); mCtx.fill();
    mCtx.strokeStyle = '#455a64';
    mCtx.lineWidth = 1;
    mCtx.stroke();

    /* Bearing label */
    mCtx.fillStyle = '#5e35b1';
    mCtx.font = '7px monospace';
    mCtx.textAlign = 'center';
    mCtx.fillText(side === 'L' ? 'B1' : 'B2', bx, by - 4);

    /* Support pedestal to base */
    mCtx.fillStyle = '#37474f';
    mCtx.fillRect(bx - 8, by + BEARING_H, 16, BASE_Y - by - BEARING_H);
    mCtx.strokeStyle = '#455a64';
    mCtx.lineWidth = 0.5;
    mCtx.strokeRect(bx - 8, by + BEARING_H, 16, BASE_Y - by - BEARING_H);
  }

  function drawLoadArm(bx) {
    var armTop = SHAFT_Y + BEARING_H / 2 + 5;
    var armBot = armTop + WEIGHT_DROP;
    /* Yoke arm */
    mCtx.strokeStyle = '#5e35b1';
    mCtx.lineWidth = 3;
    mCtx.beginPath();
    mCtx.moveTo(bx, armTop);
    mCtx.lineTo(bx, armBot);
    mCtx.stroke();
