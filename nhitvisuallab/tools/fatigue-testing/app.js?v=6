    g.addColorStop(1, '#4527a0');
    mCtx.fillStyle = g;
    mCtx.beginPath();
    mCtx.moveTo(bx - ww / 2 + 3, armBot);
    mCtx.lineTo(bx + ww / 2 - 3, armBot);
    mCtx.quadraticCurveTo(bx + ww / 2, armBot, bx + ww / 2, armBot + 3);
    mCtx.lineTo(bx + ww / 2, armBot + wh - 3);
    mCtx.quadraticCurveTo(bx + ww / 2, armBot + wh, bx + ww / 2 - 3, armBot + wh);
    mCtx.lineTo(bx - ww / 2 + 3, armBot + wh);
    mCtx.quadraticCurveTo(bx - ww / 2, armBot + wh, bx - ww / 2, armBot + wh - 3);
    mCtx.lineTo(bx - ww / 2, armBot + 3);
    mCtx.quadraticCurveTo(bx - ww / 2, armBot, bx - ww / 2 + 3, armBot);
