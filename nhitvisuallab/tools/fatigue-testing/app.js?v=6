  function genBendingStress() {
    var W = randInt(2, 40) * 10;
    var d = randInt(6, 12);
    var L = 100;
    var M = W * L / 2; /* N·mm */
    var sigma = 32 * M / (Math.PI * d * d * d);
    return {
      prompt: 'A rotating beam fatigue test uses dead weights of ' + W + ' N on each side with a loading span of ' + L + ' mm. The specimen gauge diameter is ' + d + ' mm. Calculate the bending stress amplitude (\u03c3_a) in MPa.',
      answer: roundN(sigma, 1), unit: 'MPa', tol: 1,
      solution: [
        'Bending moment M = W \u00d7 L/2 = ' + W + ' \u00d7 ' + L + '/2 = ' + (W * L / 2) + ' N\u00b7mm',
        '\u03c3_a = 32M/(\u03c0d\u00b3) = 32 \u00d7 ' + (W * L / 2) + ' / (\u03c0 \u00d7 ' + d + '\u00b3)',
        '\u03c3_a = ' + (32 * W * L / 2) + ' / ' + roundN(Math.PI * d * d * d, 1),
        '<strong>\u03c3_a = ' + roundN(sigma, 1) + ' MPa</strong>'
      ]
    };
  }

  function genCyclesToFailure() {
    var A = randInt(5, 15) * 100;
    var b = -roundN(randFloat(0.08, 0.14), 2);
    var sigma = randInt(15, 40) * 10;
    var N = Math.pow(sigma / A, 1 / b);
    return {
      prompt: 'A material has Basquin constants A = ' + A + ' MPa and b = ' + b + '. Calculate the fatigue life (N_f) at a stress amplitude of ' + sigma + ' MPa.',
      answer: Math.round(N), unit: 'cycles', tol: Math.round(N * 0.05),
      solution: [
        '\u03c3_a = A \u00d7 N^b \u2192 N = (\u03c3_a / A)^(1/b)',
        'N = (' + sigma + ' / ' + A + ')^(1/' + b + ')',
        'N = (' + roundN(sigma / A, 4) + ')^(' + roundN(1 / b, 2) + ')',
        '<strong>N \u2248 ' + formatCycles(N) + ' cycles</strong>'
      ]
    };
  }

