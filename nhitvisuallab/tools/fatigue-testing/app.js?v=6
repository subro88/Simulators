  function drawExploreSoderberg() {
    var cx = EW / 2;
    eCtx.fillStyle = '#dde3f0';
    eCtx.font = 'bold 12px sans-serif';
    eCtx.textAlign = 'center';
    eCtx.fillText('Soderberg vs Goodman Comparison', cx, 25);

