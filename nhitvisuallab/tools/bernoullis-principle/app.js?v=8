  function drawDynamicPDiagram() {
    /* Bar chart showing dynamic pressure at different velocities */
    ctx.font = '700 14px "Segoe UI", sans-serif';
    ctx.fillStyle = '#dde3f0'; ctx.textAlign = 'center';
    ctx.fillText('Dynamic Pressure vs Velocity', 450, 40);
    var speeds = [5, 10, 20, 30, 40];
    var maxH = 250;
    var barW = 60;
    var startX = 150;
    for (var i = 0; i < speeds.length; i++) {
      var q = 0.5 * 1.225 * speeds[i] * speeds[i];
      var h = Math.min(maxH, q / 980 * maxH);
      var bx = startX + i * 120;
      ctx.fillStyle = 'rgba(139,195,74,' + (0.3 + i * 0.12) + ')';
      ctx.strokeStyle = '#8bc34a';
      ctx.lineWidth = 1.5;
      ctx.beginPath(); ctx.roundRect(bx, 370 - h, barW, h, 4); ctx.fill(); ctx.stroke();
      ctx.font = '700 11px "Courier New", monospace';
      ctx.fillStyle = '#8bc34a'; ctx.textAlign = 'center';
      ctx.fillText(q.toFixed(0) + ' Pa', bx + barW / 2, 365 - h);
      ctx.font = '600 10px "Segoe UI", sans-serif';
      ctx.fillStyle = '#dde3f0';
      ctx.fillText(speeds[i] + ' m/s', bx + barW / 2, 388);
    }
    ctx.font = '600 10px "Segoe UI", sans-serif';
    ctx.fillStyle = '#8b9dc3'; ctx.textAlign = 'center';
    ctx.fillText('(Air, \u03C1 = 1.225 kg/m\u00B3)', 450, 410);
  }

