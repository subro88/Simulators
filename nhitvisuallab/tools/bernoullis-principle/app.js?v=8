  function drawMiniPipe(cx, cy, wideR, narrowR, len) {
    var half = len / 2;
    var tl = cx - half * 0.3, tr = cx + half * 0.3;
    /* Fill */
    ctx.fillStyle = 'rgba(139,195,74,0.3)';
    ctx.beginPath();
    ctx.moveTo(cx - half, cy - wideR);
    ctx.lineTo(tl, cy - wideR);
    ctx.quadraticCurveTo(tl + 10, cy - wideR, tl + 15, cy - narrowR);
    ctx.lineTo(tr - 15, cy - narrowR);
    ctx.quadraticCurveTo(tr - 10, cy - wideR, tr, cy - wideR);
    ctx.lineTo(cx + half, cy - wideR);
    ctx.lineTo(cx + half, cy + wideR);
    ctx.lineTo(tr, cy + wideR);
    ctx.quadraticCurveTo(tr - 10, cy + wideR, tr - 15, cy + narrowR);
    ctx.lineTo(tl + 15, cy + narrowR);
    ctx.quadraticCurveTo(tl + 10, cy + wideR, tl, cy + wideR);
    ctx.lineTo(cx - half, cy + wideR);
    ctx.closePath();
    ctx.fill();
    /* Walls */
    ctx.strokeStyle = '#4a5578';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(cx - half, cy - wideR); ctx.lineTo(tl, cy - wideR);
    ctx.quadraticCurveTo(tl + 10, cy - wideR, tl + 15, cy - narrowR);
    ctx.lineTo(tr - 15, cy - narrowR);
    ctx.quadraticCurveTo(tr - 10, cy - wideR, tr, cy - wideR);
    ctx.lineTo(cx + half, cy - wideR);
    ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(cx - half, cy + wideR); ctx.lineTo(tl, cy + wideR);
    ctx.quadraticCurveTo(tl + 10, cy + wideR, tl + 15, cy + narrowR);
    ctx.lineTo(tr - 15, cy + narrowR);
    ctx.quadraticCurveTo(tr - 10, cy + wideR, tr, cy + wideR);
    ctx.lineTo(cx + half, cy + wideR);
    ctx.stroke();
  }

