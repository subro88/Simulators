     ================================================================ */
  function getFluid() { return FLUIDS[fluidKey]; }
  function getRho() { return getFluid().rho; }
  function getVisc() { return getFluid().visc; }
  function getA1() { var r = d1mm / 2000; return Math.PI * r * r; }
  function getA2() { var r = d2mm / 2000; return Math.PI * r * r; }
  function getV2() { return velocity * getA1() / getA2(); }
  function getQ() { return getA1() * velocity; }
  function getP1() { return 200000; /* baseline 200 kPa at wide section */ }
  function getDynP1() { return 0.5 * getRho() * velocity * velocity; }
  function getDynP2() { var v2 = getV2(); return 0.5 * getRho() * v2 * v2; }
  function getHydroDrop() { return getRho() * G * deltaH; /* ρg(h2-h1) */ }
  function getP2() { return getP1() + getDynP1() - getDynP2() - getHydroDrop(); }
  function getDeltaP() { return getP1() - getP2(); }
  function getSpeedRatio() { return getV2() / velocity; }
  function getRe1() { return getRho() * velocity * (d1mm / 1000) / getVisc(); }
  function getRe2() { return getRho() * getV2() * (d2mm / 1000) / getVisc(); }
