    var hydroStep = Math.abs(dh) > 0.001
      ? '&rho;g&Delta;h = ' + rho + ' &times; 9.81 &times; ' + rN(dh,2) + '\n'
        + '       = ' + hydro + ' Pa'
      : '&Delta;h = 0 m  &rArr;  hydrostatic term = 0 Pa (same elevation)';
    html += calcStep(5,
      'Hydrostatic Term  &rho;g&Delta;h',
      '\\[ \\rhog\\Deltah  (height difference between inlet and throat) \\]',
      hydroStep,
      '&rho;g&Delta;h = ' + hydro + ' Pa'
    );

    /* ── Step 6: Throat pressure (Bernoulli) ─────────────────────── */
    html += calcStep(6,
      'Throat Pressure P&#8322;  &mdash;  Bernoulli&rsquo;s Equation',
      'P&#8321; + &frac12;&rho;v&#8321;&sup2; = P&#8322; + &frac12;&rho;v&#8322;&sup2; + &rho;g&Delta;h<br>'
        + '&rArr; P&#8322; = P&#8321; + q&#8321; &minus; q&#8322; &minus; &rho;g&Delta;h',
      'P&#8322; = ' + rN(P1,0) + ' + ' + dynP1 + ' &minus; ' + dynP2 + ' &minus; ' + hydro + '\n'
      + '   = ' + rN(P1,0) + ' + (' + rN(dynP1-dynP2-hydro,1) + ')\n'
      + '   = ' + rN(P2,1) + ' Pa\n'
      + '   = ' + rN(P2/1000,3) + ' kPa'
      + (P2 < 0 ? '\n\n\u26A0\uFE0F  Negative pressure \u2014 cavitation risk!' : ''),
      'P&#8322; = ' + rN(P2/1000,3) + ' kPa' + (P2 < 0 ? '  &#9888; Cavitation!' : '')
    );

    /* ── Step 7: Pressure drop ───────────────────────────────────── */
    var dp = rN(getDeltaP(), 1);
    html += calcStep(7,
      'Pressure Drop &Delta;P',
      '\\[ \\DeltaP = P_{1} - P_{2} = \\tfrac{1}{2}\\rho(v_{2}^{2} - v_{1}^{2}) + \\rhog\\Deltah \\]',
      '&Delta;P = ' + rN(P1,0) + ' &minus; ' + rN(P2,1) + '\n'
      + '   = ' + dp + ' Pa\n'
      + '   = ' + rN(dp/1000,3) + ' kPa',
      '&Delta;P = ' + rN(dp/1000,3) + ' kPa'
    );

    /* ── Step 8: Volumetric flow rate ────────────────────────────── */
    var Qls = rN(Q*1000, 4);
    html += calcStep(8,
      'Volumetric Flow Rate Q',
      '\\[ Q = A_{1} \\times v_{1} = A_{2} \\times v_{2}  (continuity check) \\]',
      'Q = A&#8321; &times; v&#8321;\n'
      + '  = ' + rN(A1,6) + ' &times; ' + rN(v1,2) + '\n'
      + '  = ' + rN(Q,6) + ' m&sup3;/s  =  ' + Qls + ' L/s\n\n'
      + 'Verify via throat: A&#8322; &times; v&#8322;\n'
      + '  = ' + rN(A2,6) + ' &times; ' + rN(v2,2) + '\n'
      + '  = ' + rN(A2*v2,6) + ' m&sup3;/s  \u2713',
      'Q = ' + Qls + ' L/s'
    );

    /* ── Step 9: Reynolds numbers ────────────────────────────────── */
    var Re1r = rN(Re1, 0);
    var Re2r = rN(Re2, 0);
    html += calcStep(9,
      'Reynolds Numbers  &mdash;  Flow Regime',
      '\\[ Re = \\rhovD / \\mu \\]',
      'Re&#8321; = ' + rho + ' &times; ' + rN(v1,2) + ' &times; ' + rN(d1mm/1000,4) + ' / ' + mu + '\n'
      + '    = ' + Re1r + '  &rarr; ' + regimeOf(Re1) + '\n\n'
      + 'Re&#8322; = ' + rho + ' &times; ' + rN(v2,2) + ' &times; ' + rN(d2mm/1000,4) + ' / ' + mu + '\n'
      + '    = ' + Re2r + '  &rarr; ' + regimeOf(Re2),
      'Re&#8321; = ' + fmtRe(Re1) + ' (' + regimeOf(Re1) + ')  |  Re&#8322; = ' + fmtRe(Re2) + ' (' + regimeOf(Re2) + ')'
    );

    /* ── Step 10: Speed ratio & energy summary ───────────────────── */
    var sr = rN(getSpeedRatio(), 3);
    var ke1kPa = rN(dynP1/1000, 3);
    var ke2kPa = rN(dynP2/1000, 3);
    html += calcStep(10,
      'Speed Ratio &amp; Energy Conservation Check',
      '\\[ v_{2}/v_{1} = (d_{1}/d_{2})^{2}   \, | \,   P_{1} + q_{1} + \\rhogh_{1} = P_{2} + q_{2} + \\rhogh_{2} \\]',
      'Speed ratio = v&#8322;/v&#8321; = ' + rN(v2,2) + ' / ' + rN(v1,2) + ' = ' + sr + '&times;\n\n'
      + 'Energy conservation (per unit volume):\n'
      + '  LHS: P&#8321; + q&#8321; = ' + rN(P1/1000,2) + ' + ' + ke1kPa + ' = ' + rN(P1/1000+ke1kPa,3) + ' kPa\n'
      + '  RHS: P&#8322; + q&#8322; + &rho;g&Delta;h = ' + rN(P2/1000,2) + ' + ' + ke2kPa + ' + ' + rN(hydro/1000,3) + ' = ' + rN(P2/1000+ke2kPa+hydro/1000,3) + ' kPa\n'
      + '  (Small rounding differences are expected)',
      'Speed ratio = ' + sr + '&times;'
    );

    return html;
  }

  function openCalcModal() {
    var modal = $('#calc-modal');
    var body  = $('#calc-modal-body');
    if (!modal || !body) return;
    body.innerHTML = buildCalcSteps();
    modal.classList.add('active');
    var cb = $('#calc-modal-close');
    if (cb) cb.focus();
    document.body.style.overflow = 'hidden';
  }

  function closeCalcModal() {
    var modal = $('#calc-modal');
    if (!modal) return;
    modal.classList.remove('active');
    document.body.style.overflow = '';
    cvs.focus();
  }

  /* ================================================================
     GRAPHICS HELPERS — colour, lighting, materials
     ================================================================ */
  function parseRGBA(s) {
    var m = /rgba?\(([^)]+)\)/.exec(s);
    if (!m) return { r: 140, g: 180, b: 220, a: 1 };
    var p = m[1].split(',').map(parseFloat);
    return { r: p[0], g: p[1], b: p[2], a: p.length > 3 ? p[3] : 1 };
  }
  function rgba(o, a) { return 'rgba(' + (o.r | 0) + ',' + (o.g | 0) + ',' + (o.b | 0) + ',' + (a == null ? o.a : a) + ')'; }
  function shade(o, f) { return { r: Math.min(255, o.r * f), g: Math.min(255, o.g * f), b: Math.min(255, o.b * f), a: o.a }; }

  /* Studio background — pure, drawn first. glow args optional. */
  function drawSceneBackground() {
    var base = ctx.createLinearGradient(0, 0, 0, H);
    base.addColorStop(0, '#111725');
    base.addColorStop(0.55, '#0c111c');
    base.addColorStop(1, '#080b12');
    ctx.fillStyle = base;
    ctx.fillRect(0, 0, W, H);
  }

  /* Pressure-field lighting: warm (high-P) glows over the two wide sections,
     cool (low-P) glow over the throat. Lighting reinforces the physics. */
  function drawPressureField(PY, wideMidL, throatMid, wideMidR, lowFrac) {
    ctx.save();
    ctx.globalCompositeOperation = 'lighter';
    function glow(x, y, r, col) {
      var g = ctx.createRadialGradient(x, y, 10, x, y, r);
      g.addColorStop(0, col); g.addColorStop(1, 'rgba(0,0,0,0)');
      ctx.fillStyle = g; ctx.fillRect(0, 0, W, H);
    }
    /* high-pressure red zones (wide sections) */
    glow(wideMidL, PY, 200, 'rgba(255,90,80,0.10)');
    glow(wideMidR, PY, 200, 'rgba(255,90,80,0.10)');
    /* low-pressure cool zone (throat) — deepens as speed ratio grows */
    var lo = 0.10 + Math.min(0.14, (lowFrac - 1) * 0.05);
    glow(throatMid, PY, 190, 'rgba(80,200,140,' + lo.toFixed(3) + ')');
    ctx.restore();
  }

  /* ================================================================
     DRAWING — SIMULATE MODE
     ================================================================ */
  function drawSimulate() {
    /* Title */
    ctx.font = '700 14px "Segoe UI", sans-serif';
    ctx.fillStyle = '#dde3f0';
    ctx.textAlign = 'center'; ctx.textBaseline = 'top';
    ctx.fillText("Bernoulli\u2019s Principle \u2014 Venturi Tube Flow", W / 2, 10);
    ctx.font = '600 11px "Segoe UI", sans-serif';
    ctx.fillStyle = '#8b9dc3';
    ctx.fillText('Adjust velocity and pipe diameters to see pressure and velocity changes', W / 2, 28);

    /* Layout */
    var PY = 240;        /* pipe center Y */
    var LX = 60;         /* left start X */
    var RX = 840;        /* right end X */
    var TL = 330;        /* throat left X */
    var TR = 570;        /* throat right X */
    var TX1 = 260;       /* transition start */
    var TX2 = 640;       /* transition end */

    var r1 = Math.max(25, d1mm * 0.45);    /* wide half-height */
    var r2 = Math.max(10, d2mm * 0.45);    /* throat half-height */

    /* ── Pressure-field lighting (behind the pipe) ── */
    drawPressureField(PY, (LX + TX1) / 2, (TL + TR) / 2, (TX2 + RX) / 2, getSpeedRatio());

    /* Helper: trace the pipe interior outline (top wall L→R, then bottom R→L) */
    function tracePipe(inset) {
      var a = inset || 0;
      ctx.moveTo(LX, PY - r1 + a);
      ctx.lineTo(TX1, PY - r1 + a);
      ctx.quadraticCurveTo(TL - 10, PY - r1 + a, TL, PY - r2 + a);
      ctx.lineTo(TR, PY - r2 + a);
      ctx.quadraticCurveTo(TR + 10, PY - r1 + a, TX2, PY - r1 + a);
      ctx.lineTo(RX, PY - r1 + a);
      ctx.lineTo(RX, PY + r1 - a);
      ctx.lineTo(TX2, PY + r1 - a);
      ctx.quadraticCurveTo(TR + 10, PY + r1 - a, TR, PY + r2 - a);
      ctx.lineTo(TL, PY + r2 - a);
      ctx.quadraticCurveTo(TL - 10, PY + r1 - a, TX1, PY + r1 - a);
      ctx.lineTo(LX, PY + r1 - a);
      ctx.closePath();
    }

    /* ── Ground/contact shadow under the pipe assembly ── */
    ctx.save();
    var csh = ctx.createRadialGradient(W / 2, PY + r1 + 96, 20, W / 2, PY + r1 + 96, 420);
    csh.addColorStop(0, 'rgba(0,0,0,0.30)');
    csh.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.fillStyle = csh;
    ctx.beginPath();
    ctx.ellipse(W / 2, PY + r1 + 100, 380, 26, 0, 0, Math.PI * 2);
    ctx.fill();
    ctx.restore();

    /* ── Fluid fill — vertical depth gradient (lighter top → deeper bottom) ── */
    var fcol = parseRGBA(getFluid().flow);
    var fluidGrad = ctx.createLinearGradient(0, PY - r1, 0, PY + r1);
    fluidGrad.addColorStop(0, rgba(shade(fcol, 1.35), Math.min(0.9, fcol.a + 0.10)));
    fluidGrad.addColorStop(0.5, rgba(fcol, Math.min(0.9, fcol.a + 0.20)));
    fluidGrad.addColorStop(1, rgba(shade(fcol, 0.7), Math.min(0.95, fcol.a + 0.28)));
    ctx.fillStyle = fluidGrad;
    ctx.beginPath(); tracePipe(0); ctx.fill();

    /* Top-of-fluid sheen streak (reads as a curved liquid surface under glass) */
    ctx.save();
    ctx.beginPath(); tracePipe(0); ctx.clip();
    ctx.strokeStyle = rgba(shade(fcol, 1.6), 0.30);
    ctx.lineWidth = 3;
    ctx.beginPath();
    ctx.moveTo(LX, PY - r1 + 6);
    ctx.lineTo(TX1, PY - r1 + 6);
    ctx.quadraticCurveTo(TL - 10, PY - r1 + 6, TL, PY - r2 + 6);
    ctx.lineTo(TR, PY - r2 + 6);
    ctx.quadraticCurveTo(TR + 10, PY - r1 + 6, TX2, PY - r1 + 6);
    ctx.lineTo(RX, PY - r1 + 6);
    ctx.stroke();
    ctx.restore();

    /* ── Pipe walls — steel tube: dark base + mid body + inner glass highlight ── */
    /* dark outer casing */
    ctx.strokeStyle = '#161c2c';
    ctx.lineWidth = 7;
    ctx.lineJoin = 'round'; ctx.lineCap = 'round';
    ctx.beginPath(); tracePipe(0); ctx.stroke();
    /* mid steel body */
    ctx.strokeStyle = '#586489';
    ctx.lineWidth = 3.5;
    ctx.beginPath(); tracePipe(0); ctx.stroke();
    /* inner bright glass edge (top rim only, offset inward) */
    ctx.strokeStyle = 'rgba(210,228,255,0.32)';
    ctx.lineWidth = 1.4;
    ctx.beginPath();
    ctx.moveTo(LX, PY - r1 + 2.5);
    ctx.lineTo(TX1, PY - r1 + 2.5);
    ctx.quadraticCurveTo(TL - 10, PY - r1 + 2.5, TL, PY - r2 + 2.5);
    ctx.lineTo(TR, PY - r2 + 2.5);
    ctx.quadraticCurveTo(TR + 10, PY - r1 + 2.5, TX2, PY - r1 + 2.5);
    ctx.lineTo(RX, PY - r1 + 2.5);
    ctx.stroke();
    ctx.lineJoin = 'miter'; ctx.lineCap = 'butt';

    /* ── Streamlines / flow arrows ── */
    if (showStreamlines) {
      ctx.save();
      ctx.shadowColor = 'rgba(120,230,160,0.9)';
      ctx.shadowBlur = 5;
      var nLines = 5;
      var v2 = getV2();
      for (var i = 0; i < nLines; i++) {
        var frac = (i + 1) / (nLines + 1);
        var yWide = PY - r1 + frac * 2 * r1;
        var yNarrow = PY - r2 + frac * 2 * r2;

        ctx.strokeStyle = 'rgba(139,195,74,0.55)';
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        ctx.moveTo(LX + 10, yWide);
        ctx.lineTo(TX1, yWide);
        ctx.quadraticCurveTo(TL, yWide, TL + 5, yNarrow);
        ctx.lineTo(TR - 5, yNarrow);
        ctx.quadraticCurveTo(TR, yWide, TX2, yWide);
        ctx.lineTo(RX - 10, yWide);
        ctx.stroke();

        /* Flow dots (animated) */
        ctx.fillStyle = '#8bc34a';
        var dotSpacing = 40;
        /* Wide left */
        for (var dx = 0; dx < 4; dx++) {
          var px = LX + 20 + ((animOffset * velocity / 3 + dx * dotSpacing) % (TX1 - LX - 20));
          if (px < TX1 - 10) {
            ctx.beginPath(); ctx.arc(px, yWide, 2, 0, Math.PI * 2); ctx.fill();
          }
        }
        /* Throat (faster dots) */
        ctx.fillStyle = '#3ddc84';
        for (var dx2 = 0; dx2 < 6; dx2++) {
          var px2 = TL + 10 + ((animOffset * v2 / 3 + dx2 * 25) % (TR - TL - 20));
          if (px2 < TR - 5) {
            ctx.beginPath(); ctx.arc(px2, yNarrow, 2.5, 0, Math.PI * 2); ctx.fill();
          }
        }
        /* Wide right */
        ctx.fillStyle = '#8bc34a';
        for (var dx3 = 0; dx3 < 4; dx3++) {
          var px3 = TX2 + 10 + ((animOffset * velocity / 3 + dx3 * dotSpacing) % (RX - TX2 - 20));
          if (px3 < RX - 10) {
            ctx.beginPath(); ctx.arc(px3, yWide, 2, 0, Math.PI * 2); ctx.fill();
          }
        }
      }
      ctx.restore();
    }

    /* ── Velocity arrows ── */
    /* Wide section */
    var arrowLen1 = Math.min(velocity * 8, 60) + 10;
    drawFlowArrow(LX + 20, PY, arrowLen1, '#8bc34a');
    ctx.font = '700 12px "Segoe UI", sans-serif';
    ctx.fillStyle = '#8bc34a';
    ctx.textAlign = 'left'; ctx.textBaseline = 'bottom';
    ctx.fillText('v\u2081 = ' + toD(velocity, 'velocity').toFixed(1) + ' ' + uLbl('velocity'), LX + 20, PY - r1 - 8);

    /* Throat section */
    var v2 = getV2();
    var arrowLen2 = Math.min(v2 * 8, 80) + 10;
    var throatMid = (TL + TR) / 2;
    drawFlowArrow(throatMid - arrowLen2 / 2, PY, arrowLen2, '#3ddc84');
    ctx.fillStyle = '#3ddc84';
    ctx.textAlign = 'center';
    ctx.fillText('v\u2082 = ' + toD(v2, 'velocity').toFixed(1) + ' ' + uLbl('velocity'), throatMid, PY - r2 - 8);

    /* Wide right */
    drawFlowArrow(RX - 20 - arrowLen1, PY, arrowLen1, '#8bc34a');

    /* ── Pressure indicators ── */
    if (showPressure) {
      var P1 = getP1();
      var P2 = getP2();
      var maxBarH = 80;

      /* Gradient-filled pressure gauge bar (value↔visual: height ∝ pressure) */
      function pressureBar(x, y, h, hi) {
        var top = hi ? 'rgba(255,120,110,0.62)' : 'rgba(150,210,90,0.60)';
        var bot = hi ? 'rgba(200,50,50,0.30)'   : 'rgba(90,170,60,0.28)';
        var g = ctx.createLinearGradient(x, y, x, y + h);
        g.addColorStop(0, top); g.addColorStop(1, bot);
        ctx.fillStyle = g;
        ctx.strokeStyle = hi ? '#ff6b6b' : '#8bc34a';
        ctx.lineWidth = 1.5;
        ctx.beginPath(); ctx.roundRect(x, y, 30, h, 4); ctx.fill(); ctx.stroke();
        /* left-edge sheen */
        ctx.fillStyle = 'rgba(255,255,255,0.18)';
        ctx.beginPath(); ctx.roundRect(x + 2.5, y + 2.5, 6, Math.max(2, h - 5), 3); ctx.fill();
      }

      /* Pressure bar — wide left */
      var barH1 = maxBarH;
      var barX1 = (LX + TX1) / 2 - 15;
      var barY1 = PY - r1 - 20 - barH1;
      pressureBar(barX1, barY1, barH1, true);
      ctx.font = '700 10px "Courier New", monospace';
      ctx.fillStyle = '#ff8a80';
      ctx.textAlign = 'center'; ctx.textBaseline = 'bottom';
      ctx.fillText(toD(P1 / 1000, 'pressure').toFixed(imperial ? 2 : 1) + ' ' + uLbl('pressure'), barX1 + 15, barY1 - 4);

      /* Pressure bar — throat */
      var barH2 = Math.max(5, maxBarH * Math.max(P2 / P1, 0.05));
      var barX2 = throatMid - 15;
      var barY2 = PY - r2 - 20 - barH2;
      pressureBar(barX2, barY2, barH2, false);
      ctx.font = '700 10px "Courier New", monospace';
      ctx.fillStyle = '#a5d66f';
      ctx.textAlign = 'center'; ctx.textBaseline = 'bottom';
      ctx.fillText(toD(P2 / 1000, 'pressure').toFixed(imperial ? 2 : 1) + ' ' + uLbl('pressure'), barX2 + 15, barY2 - 4);

      /* Pressure bar — wide right */
      var barX3 = (TX2 + RX) / 2 - 15;
      pressureBar(barX3, barY1, barH1, true);
      ctx.fillStyle = '#ff8a80';
      ctx.textAlign = 'center'; ctx.textBaseline = 'bottom';
      ctx.fillText(toD(P1 / 1000, 'pressure').toFixed(imperial ? 2 : 1) + ' ' + uLbl('pressure'), barX3 + 15, barY1 - 4);

      /* Labels */
      ctx.font = '600 9px "Segoe UI", sans-serif';
      ctx.fillStyle = 'rgba(255,85,85,0.7)';
      ctx.textAlign = 'center'; ctx.textBaseline = 'top';
      ctx.fillText('HIGH P', barX1 + 15, barY1 + barH1 + 3);
      ctx.fillStyle = 'rgba(139,195,74,0.7)';
      ctx.fillText('LOW P', barX2 + 15, barY2 + barH2 + 3);
      ctx.fillStyle = 'rgba(255,85,85,0.7)';
      ctx.fillText('HIGH P', barX3 + 15, barY1 + barH1 + 3);
    }

    /* ── Diameter labels ── */
    ctx.font = '600 11px "Segoe UI", sans-serif';
    ctx.fillStyle = '#c5e1a5';
    ctx.textAlign = 'center'; ctx.textBaseline = 'top';
    /* d1 bracket - left */
    var brkX1 = (LX + TX1) / 2;
    ctx.beginPath();
    ctx.strokeStyle = '#c5e1a5'; ctx.lineWidth = 1;
    ctx.moveTo(brkX1 - 15, PY + r1 + 5); ctx.lineTo(brkX1 - 15, PY + r1 + 15);
    ctx.moveTo(brkX1 + 15, PY + r1 + 5); ctx.lineTo(brkX1 + 15, PY + r1 + 15);
    ctx.moveTo(brkX1 - 15, PY + r1 + 10); ctx.lineTo(brkX1 + 15, PY + r1 + 10);
    ctx.stroke();
    ctx.fillText('d\u2081 = ' + toD(d1mm, 'diam').toFixed(imperial ? 2 : 0) + ' ' + uLbl('diam'), brkX1, PY + r1 + 18);
    /* d2 bracket - throat */
    ctx.beginPath();
    ctx.moveTo(throatMid - 12, PY + r2 + 5); ctx.lineTo(throatMid - 12, PY + r2 + 15);
    ctx.moveTo(throatMid + 12, PY + r2 + 5); ctx.lineTo(throatMid + 12, PY + r2 + 15);
    ctx.moveTo(throatMid - 12, PY + r2 + 10); ctx.lineTo(throatMid + 12, PY + r2 + 10);
    ctx.stroke();
    ctx.fillText('d\u2082 = ' + toD(d2mm, 'diam').toFixed(imperial ? 2 : 0) + ' ' + uLbl('diam'), throatMid, PY + r2 + 18);

    /* ── Info badges ── */
    /* Speed ratio badge */
    var sr = getSpeedRatio();
    ctx.fillStyle = 'rgba(139,195,74,0.15)';
    ctx.strokeStyle = 'rgba(139,195,74,0.4)';
    ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.roundRect(throatMid - 70, PY + r2 + 45, 140, 48, 10); ctx.fill(); ctx.stroke();
    ctx.font = '600 10px "Segoe UI", sans-serif';
    ctx.fillStyle = '#8b9dc3';
    ctx.textAlign = 'center'; ctx.textBaseline = 'top';
    ctx.fillText('SPEED RATIO (v\u2082/v\u2081)', throatMid, PY + r2 + 50);
    ctx.font = '700 18px "Courier New", monospace';
    ctx.fillStyle = '#8bc34a';
    ctx.fillText(sr.toFixed(1) + '\u00D7', throatMid, PY + r2 + 66);

    /* \u0394P badge */
    var dp = getDeltaP();
    ctx.fillStyle = 'rgba(139,195,74,0.15)';
    ctx.strokeStyle = 'rgba(139,195,74,0.4)';
    ctx.beginPath(); ctx.roundRect(LX + 10, PY + r1 + 45, 170, 48, 10); ctx.fill(); ctx.stroke();
    ctx.font = '600 10px "Segoe UI", sans-serif';
    ctx.fillStyle = '#8b9dc3';
    ctx.textAlign = 'center'; ctx.textBaseline = 'top';
    ctx.fillText('PRESSURE DROP (\u0394P)', LX + 95, PY + r1 + 50);
    ctx.font = '700 16px "Courier New", monospace';
    ctx.fillStyle = '#f5c842';
    ctx.fillText(toD(dp / 1000, 'pressure').toFixed(imperial ? 2 : 1) + ' ' + uLbl('pressure'), LX + 95, PY + r1 + 66);

    /* Flow rate badge */
    var Q = getQ();
    ctx.fillStyle = 'rgba(139,195,74,0.15)';
    ctx.strokeStyle = 'rgba(139,195,74,0.4)';
    ctx.beginPath(); ctx.roundRect(RX - 180, PY + r1 + 45, 170, 48, 10); ctx.fill(); ctx.stroke();
    ctx.font = '600 10px "Segoe UI", sans-serif';
    ctx.fillStyle = '#8b9dc3';
    ctx.textAlign = 'center'; ctx.textBaseline = 'top';
    ctx.fillText('FLOW RATE (Q)', RX - 95, PY + r1 + 50);
    ctx.font = '700 16px "Courier New", monospace';
    ctx.fillStyle = '#42a5f5';
    ctx.fillText(toD(Q * 1000, 'flow').toFixed(imperial ? 3 : 2) + ' ' + uLbl('flow'), RX - 95, PY + r1 + 66);

    /* Fluid + height annotation */
    ctx.font = '600 11px "Segoe UI", sans-serif';
    ctx.fillStyle = getFluid().line;
    ctx.textAlign = 'left'; ctx.textBaseline = 'top';
    ctx.fillText(getFluid().name + '  \u03C1=' + (imperial ? (getRho() * 0.062428).toFixed(2) + ' lb/ft\u00B3' : getRho() + ' kg/m\u00B3'), LX, 52);
    if (Math.abs(deltaH) > 0.01) {
      ctx.fillStyle = '#f5c842';
      ctx.textAlign = 'right';
      ctx.fillText('\u0394h = ' + toD(deltaH, 'height').toFixed(1) + ' ' + uLbl('height'), RX, 52);
    }

    /* Manometer (optional overlay) */
    if (showManometer) drawManometer(PY, r1, r2, (LX + TX1) / 2, (TL + TR) / 2);

    /* ── "Show Calculations" button — bottom-right ─────────────── */
    var bx = CALC_BTN.x, by = CALC_BTN.y, bw = CALC_BTN.w, bh = CALC_BTN.h;
    /* Gradient fill */
    var grad = ctx.createLinearGradient(bx, by, bx + bw, by);
    grad.addColorStop(0, 'rgba(245,200,66,0.22)');
    grad.addColorStop(1, 'rgba(245,200,66,0.10)');
    ctx.fillStyle = grad;
    ctx.beginPath(); ctx.roundRect(bx, by, bw, bh, 7); ctx.fill();
    /* Border */
    ctx.strokeStyle = 'rgba(245,200,66,0.50)';
    ctx.lineWidth = 1.2;
    ctx.beginPath(); ctx.roundRect(bx, by, bw, bh, 7); ctx.stroke();
    /* Label */
    ctx.font = '700 11px "Segoe UI", sans-serif';
    ctx.fillStyle = '#f5c842';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText('\uD83E\uDDEE  Show Calculations', bx + bw / 2, by + bh / 2);
    ctx.textBaseline = 'alphabetic';
  }

  /* ================================================================
     MANOMETER — U-tube overlay
     ================================================================ */
  function drawManometer(PY, r1, r2, x1, x2) {
    var P1 = getP1();
    var P2 = Math.max(0, getP2());
    var maxP = Math.max(P1, P2, 1);
    var tubeTop = 85;
    var tubeBase = PY - Math.max(r1, r2) - 30;
    var maxH = Math.max(20, tubeBase - tubeTop - 10);
    var h1 = (P1 / maxP) * maxH;
    var h2 = (P2 / maxP) * maxH;

    /* Tube outlines */
    ctx.strokeStyle = '#8b9dc3';
    ctx.lineWidth = 1.4;
    ctx.beginPath();
    ctx.moveTo(x1 - 7, tubeTop); ctx.lineTo(x1 - 7, tubeBase);
    ctx.lineTo(x2 - 7, tubeBase); ctx.lineTo(x2 - 7, tubeTop);
    ctx.moveTo(x1 + 7, tubeTop); ctx.lineTo(x1 + 7, tubeBase - 2);
    ctx.lineTo(x2 + 7, tubeBase - 2); ctx.lineTo(x2 + 7, tubeTop);
    ctx.stroke();

    /* Fluid columns (mercury-blue) */
    var colY1 = tubeBase - h1;
    var colY2 = tubeBase - h2;
    ctx.fillStyle = 'rgba(66,165,245,0.55)';
    ctx.fillRect(x1 - 6, colY1, 12, h1);
    ctx.fillRect(x2 - 6, colY2, 12, h2);
    /* U-bend fluid */
