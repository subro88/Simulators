  /* Unit system */
  var imperial = false;
  var UNITS = {
    velocity: { si: 'm/s',   imp: 'ft/s',  factor: 3.2808  },
    diam:     { si: 'mm',    imp: 'in',    factor: 0.03937 },
    pressure: { si: 'kPa',   imp: 'psi',   factor: 0.14504 },
    flow:     { si: 'L/s',   imp: 'gal/s', factor: 0.2642  },
    height:   { si: 'm',     imp: 'ft',    factor: 3.2808  },
    area:     { si: 'cm²',   imp: 'in²',   factor: 0.155   }
  };
  function toD(val, key) { return imperial ? val * UNITS[key].factor : val; }
  function fromD(val, key) { return imperial ? val / UNITS[key].factor : val; }
  function uLbl(key) { return imperial ? UNITS[key].imp : UNITS[key].si; }

