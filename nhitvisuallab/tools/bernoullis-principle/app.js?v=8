    var A2    = getA2();                        /* m² */
    var v1    = velocity;                       /* m/s */
    var v2    = getV2();                        /* m/s */
    var P1    = getP1();                        /* Pa */
    var P2    = getP2();                        /* Pa */
    var Q     = getQ();                         /* m³/s */
    var Re1   = getRe1();
    var Re2   = getRe2();
    var dh    = deltaH;
    var r1mm  = d1mm / 2;
    var r2mm  = d2mm / 2;
    var A1cm2 = rN(A1 * 1e4, 4);
    var A2cm2 = rN(A2 * 1e4, 4);
    var dynP1 = rN(getDynP1(), 1);
    var dynP2 = rN(getDynP2(), 1);
    var hydro = rN(getHydroDrop(), 1);

    var html = '';

    /* ── Inputs summary ──────────────────────────────────────────── */
    html += '<div class="cs-inputs">';
    html += '<span class="cs-badge">Given &mdash; Current Simulation State</span>';
    html += '<div class="cs-given">';
    html += '<span>v&#8321; = ' + rN(v1,2) + ' m/s</span>';
    html += '<span>d&#8321; = ' + d1mm + ' mm</span>';
    html += '<span>d&#8322; = ' + d2mm + ' mm</span>';
    html += '<span>&Delta;h = ' + rN(dh,2) + ' m</span>';
    html += '<span>Fluid: ' + getFluid().name + '</span>';
    html += '<span>&rho; = ' + rho + ' kg/m&sup3;</span>';
    html += '<span>&mu; = ' + mu + ' Pa&middot;s</span>';
    html += '<span>P&#8321; = 200 kPa (baseline)</span>';
    html += '</div>';
    html += '<p class="cs-si-note">&#9432; All calculations in SI. Displayed units follow the SI / Imperial toggle.</p>';
    html += '</div>';

    /* ── Step 1: Cross-sectional areas ──────────────────────────── */
    html += calcStep(1,
      'Cross-Sectional Areas',
      '\\[ A = \\pi \\times (d/2)^{2} \\]',
      'A&#8321; = &pi; &times; (' + r1mm + '/1000)&sup2;\n'
      + '    = &pi; &times; ' + rN(Math.pow(r1mm/1000,2),6) + '\n'
      + '    = ' + rN(A1,6) + ' m&sup2; = ' + A1cm2 + ' cm&sup2;\n\n'
      + 'A&#8322; = &pi; &times; (' + r2mm + '/1000)&sup2;\n'
      + '    = &pi; &times; ' + rN(Math.pow(r2mm/1000,2),6) + '\n'
      + '    = ' + rN(A2,6) + ' m&sup2; = ' + A2cm2 + ' cm&sup2;',
      'A&#8321; = ' + A1cm2 + ' cm&sup2;,  A&#8322; = ' + A2cm2 + ' cm&sup2;'
    );

    /* ── Step 2: Area ratio ──────────────────────────────────────── */
    var areaRatio = rN(A1/A2, 4);
    var diamRatio = rN(d1mm/d2mm, 4);
    html += calcStep(2,
      'Area Ratio  (Continuity Equation Multiplier)',
      '\\[ A_{1}/A_{2} = (d_{1}/d_{2})^{2} \\]',
      'A&#8321;/A&#8322; = (' + d1mm + '/' + d2mm + ')&sup2;\n'
      + '       = ' + diamRatio + '&sup2;\n'
      + '       = ' + areaRatio,
      'A&#8321;/A&#8322; = ' + areaRatio
    );

    /* ── Step 3: Throat velocity (continuity) ────────────────────── */
    html += calcStep(3,
      'Throat Velocity v&#8322;  &mdash;  Continuity Equation',
      '\\[ A_{1}v_{1} = A_{2}v_{2}  \\Rightarrow  v_{2} = v_{1} \\times (A_{1}/A_{2}) \\]',
      'v&#8322; = ' + rN(v1,2) + ' &times; ' + areaRatio + '\n'
      + '   = ' + rN(v2,4) + ' m/s',
      'v&#8322; = ' + rN(v2,2) + ' m/s'
    );

    /* ── Step 4: Dynamic pressures ───────────────────────────────── */
    html += calcStep(4,
      'Dynamic Pressures  &frac12;&rho;v&sup2;',
      '\\[ q = \\tfrac{1}{2}\\rhov^{2} \\]',
      'q&#8321; = 0.5 &times; ' + rho + ' &times; ' + rN(v1,2) + '&sup2;\n'
      + '   = 0.5 &times; ' + rho + ' &times; ' + rN(v1*v1,4) + '\n'
      + '   = ' + dynP1 + ' Pa\n\n'
      + 'q&#8322; = 0.5 &times; ' + rho + ' &times; ' + rN(v2,2) + '&sup2;\n'
      + '   = 0.5 &times; ' + rho + ' &times; ' + rN(v2*v2,4) + '\n'
      + '   = ' + dynP2 + ' Pa',
      'q&#8321; = ' + dynP1 + ' Pa,  q&#8322; = ' + dynP2 + ' Pa'
    );

