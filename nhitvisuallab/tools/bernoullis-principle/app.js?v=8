    ctx.fillStyle = '#dde3f0'; ctx.textAlign = 'center';
    ctx.fillText('Bernoulli with Elevation \u2014 P + \u00BD\u03C1v\u00B2 + \u03C1gh', 450, 40);
    /* Inclined pipe */
    ctx.fillStyle = 'rgba(66,165,245,0.35)';
    ctx.strokeStyle = '#4a5578'; ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(150, 310); ctx.lineTo(430, 310);
    ctx.lineTo(700, 140); ctx.lineTo(700, 180);
    ctx.lineTo(430, 350); ctx.lineTo(150, 350); ctx.closePath();
    ctx.fill(); ctx.stroke();
    /* Arrows */
    drawFlowArrow(180, 330, 40, '#42a5f5');
    ctx.save();
    ctx.translate(540, 240);
    ctx.rotate(-Math.atan2(170, 270));
    drawFlowArrow(-25, 0, 50, '#42a5f5');
    ctx.restore();
    /* Labels */
    ctx.font = '600 11px "Segoe UI", sans-serif';
    ctx.fillStyle = '#42a5f5'; ctx.textAlign = 'center';
    ctx.fillText('Point 1: h\u2081 = 0', 230, 380);
    ctx.fillStyle = '#f5c842';
    ctx.fillText('Point 2: h\u2082 = \u0394h (higher)', 650, 125);
    /* Δh dimension */
    ctx.strokeStyle = '#f5c842'; ctx.lineWidth = 1.2;
    ctx.setLineDash([4, 3]);
    ctx.beginPath();
    ctx.moveTo(735, 160); ctx.lineTo(770, 160);
    ctx.moveTo(735, 330); ctx.lineTo(770, 330);
    ctx.stroke();
    ctx.setLineDash([]);
    ctx.beginPath();
    ctx.moveTo(760, 160); ctx.lineTo(760, 330);
    ctx.stroke();
    ctx.fillStyle = '#f5c842';
    ctx.fillText('\u0394h', 778, 245);
    /* Formula */
    ctx.font = '700 12px "Courier New", monospace';
    ctx.fillStyle = '#8bc34a'; ctx.textAlign = 'center';
    ctx.fillText('\u0394P = \u00BD\u03C1(v\u2082\u00B2\u2212v\u2081\u00B2) + \u03C1g\u0394h', 450, 410);
  }

  /* ================================================================
     RENDER
     ================================================================ */
  function render() {
    ctx.clearRect(0, 0, W, H);
    drawSceneBackground();

    if (mode === 'simulate') {
      drawSimulate();
    } else if (mode === 'explore') {
      var c = CONCEPTS.filter(function (cc) { return cc.cat === selCat; });
      if (c[selConcept]) drawConceptDiagram(c[selConcept]);
    } else if (mode === 'quiz') {
      drawQuizCanvas();
    }
  }

  function drawQuizCanvas() {
    ctx.font = '700 18px "Segoe UI", sans-serif';
    ctx.fillStyle = '#dde3f0'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.fillText('Quiz Mode', W / 2, 40);
    ctx.font = '600 12px "Segoe UI", sans-serif';
    ctx.fillStyle = '#8bc34a';
    ctx.fillText('Answer the question below', W / 2, 65);
    drawMiniPipe(450, 250, 50, 22, 500);
    drawFlowArrow(250, 250, 50, '#8bc34a');
    drawFlowArrow(425, 250, 60, '#3ddc84');
  }

  /* Animation loop */
  function animate() {
    animOffset += 0.8;
    if (animOffset > 10000) animOffset = 0;
    render();
    if (mode === 'simulate') {
      animFrame = requestAnimationFrame(animate);
    }
  }

  function startAnimation() {
    if (animFrame) cancelAnimationFrame(animFrame);
    animate();
  }

  function stopAnimation() {
    if (animFrame) { cancelAnimationFrame(animFrame); animFrame = null; }
  }

  /* ================================================================
     UPDATE READOUTS
     ================================================================ */
  function updateReadouts() {
    var v2 = getV2();
    var P1 = getP1();
    var P2 = getP2();
    var dp = getDeltaP();
    var Q = getQ();
    var sr = getSpeedRatio();
    var Re1 = getRe1();
    var regime = regimeOf(Re1);
    var pDec = imperial ? 2 : 1;

    /* Velocities */
    $('#r-v1').textContent = toD(velocity, 'velocity').toFixed(1);
    $('#r-v2').textContent = toD(v2, 'velocity').toFixed(1);
    var vUnit = ' ' + uLbl('velocity');
    var ruV = $('#ru-v'); if (ruV) ruV.textContent = vUnit;
    var ruV2 = $('#ru-v2'); if (ruV2) ruV2.textContent = vUnit;

    /* Pressures */
    var pFactor = imperial ? 0.14504 : 1;
    var pUnit = ' ' + uLbl('pressure');
    $('#r-p1').textContent = (P1 / 1000 * pFactor).toFixed(pDec);
    $('#r-p2').textContent = (P2 / 1000 * pFactor).toFixed(pDec);
    $('#r-dp').textContent = (dp / 1000 * pFactor).toFixed(pDec);
    var ruP = $('#ru-p'); if (ruP) ruP.textContent = pUnit;
    var ruP2 = $('#ru-p2'); if (ruP2) ruP2.textContent = pUnit;
    var ruDp = $('#ru-dp'); if (ruDp) ruDp.textContent = pUnit;

    /* Flow rate */
    $('#r-q').textContent = toD(Q * 1000, 'flow').toFixed(imperial ? 3 : 2);
    var ruQ = $('#ru-q'); if (ruQ) ruQ.textContent = ' ' + uLbl('flow');

    /* Speed ratio */
    $('#r-sr').textContent = sr.toFixed(1);

    /* Area */
    var a1cm2 = getA1() * 1e4;
    $('#r-a1').textContent = (imperial ? a1cm2 * 0.155 : a1cm2).toFixed(2);
    var ruA = $('#ru-a'); if (ruA) ruA.textContent = ' ' + uLbl('area');

    /* Reynolds */
    var reEl = $('#r-re1'); if (reEl) reEl.textContent = fmtRe(Re1);

    /* Flow regime */
    var regEl = $('#r-regime');
    if (regEl) {
      regEl.textContent = regime;
      regEl.style.color = regime === 'Laminar' ? '#3ddc84' : regime === 'Transitional' ? '#f5c842' : '#ff5555';
    }

    /* Density display */
    var rhoEl = $('#fluid-rho');
    if (rhoEl) rhoEl.textContent = '\u03C1 = ' + (imperial
      ? (getRho() * 0.06243).toFixed(3) + ' lb/ft\u00B3'
      : getRho() + ' kg/m\u00B3');

    /* Cavitation warning */
    var warnEl = $('#cavitation-warn');
    if (warnEl) warnEl.classList.toggle('visible', P2 < 0);

    /* Sync stepper displays */
    syncSteppers();
  }

  /* Sync stepper number inputs to current SI state (respecting unit toggle) */
  function syncSteppers() {
    var vNum = $('#velocity-num');
    if (vNum && document.activeElement !== vNum) {
      vNum.value = toD(velocity, 'velocity').toFixed(1);
    }
    var d1Num = $('#d1-num');
    if (d1Num && document.activeElement !== d1Num) {
      d1Num.value = toD(d1mm, 'diam').toFixed(imperial ? 3 : 0);
    }
    var d2Num = $('#d2-num');
    if (d2Num && document.activeElement !== d2Num) {
      d2Num.value = toD(d2mm, 'diam').toFixed(imperial ? 3 : 0);
    }
    var dhNum = $('#dh-num');
    if (dhNum && document.activeElement !== dhNum) {
      dhNum.value = toD(deltaH, 'height').toFixed(1);
    }
  }

  /* Update all stepper unit labels */
  function syncStepperUnits() {
    var vu = $('#velocity-unit'); if (vu) vu.textContent = uLbl('velocity');
    var d1u = $('#d1-unit'); if (d1u) d1u.textContent = uLbl('diam');
    var d2u = $('#d2-unit'); if (d2u) d2u.textContent = uLbl('diam');
    var dhu = $('#dh-unit'); if (dhu) dhu.textContent = uLbl('height');
    syncStepperRanges();
  }

  /* Number inputs carry min/max/step in SI markup — restate them in the
     displayed unit system so Imperial entries aren't rejected as out of range. */
  var STEPPER_RANGE = [
    { id: 'velocity-num', key: 'velocity', min: 0.5, max: 20,  step: 0.5 },
    { id: 'd1-num',       key: 'diam',     min: 40,  max: 150, step: 5   },
    { id: 'd2-num',       key: 'diam',     min: 10,  max: 95,  step: 5   },
    { id: 'dh-num',       key: 'height',   min: -2,  max: 2,   step: 0.1 }
  ];
  function syncStepperRanges() {
    STEPPER_RANGE.forEach(function (r) {
      var el = $('#' + r.id);
      if (!el) return;
      var lo = toD(r.min, r.key), hi = toD(r.max, r.key);
      if (lo > hi) { var t = lo; lo = hi; hi = t; }
      var dec = imperial ? 3 : 2;
      el.min  = (+lo.toFixed(dec));
      el.max  = (+hi.toFixed(dec));
      /* 'any' keeps the browser from snapping a converted value to a stale grid */
      el.step = imperial ? 'any' : r.step;
    });
  }

  /* ================================================================
     UI — MODE SWITCHING
     ================================================================ */
  function setMode(m) {
    mode = m;
    $$('#mode-tabs .pill').forEach(function (p) {
      p.classList.toggle('active', p.dataset.mode === m);
    });
    /* Panels visibility */
    var simPanels = ['#sim-panel'];
    var explorePanels = ['#cat-row', '#item-selector', '#item-info'];
    var practicePanels = ['#practice-panel', '#practice-bar'];
    var quizPanels = ['#quiz-panel', '#quiz-bar', '#quiz-result'];

    simPanels.concat(explorePanels, practicePanels, quizPanels).forEach(function (s) { hide($(s)); });

    if (m === 'simulate') {
      simPanels.forEach(function (s) { show($(s)); });
      startAnimation();
    } else {
      stopAnimation();
    }
    if (m === 'explore') {
      explorePanels.forEach(function (s) { show($(s)); });
      buildConceptGrid();
    }
    if (m === 'practice') {
      practicePanels.forEach(function (s) { show($(s)); });
      newPractice();
    }
    if (m === 'quiz') {
      show($('#quiz-panel')); show($('#quiz-bar'));
      startQuiz();
    }
    /* Export bar: only visible in simulate mode */
    var eb = $('#export-bar');
    if (eb) eb.style.display = (m === 'simulate') ? '' : 'none';
    render();
  }

  $('#mode-tabs').addEventListener('click', function (e) {
    if (!e.target.matches('.pill')) return;
    setMode(e.target.dataset.mode);
  });

  /* ================================================================
     UI — SIMULATE CONTROLS
     ================================================================ */
  var forceSlider = $('#velocity-slider');
  var d1Slider = $('#d1-slider');
  var d2Slider = $('#d2-slider');

  forceSlider.addEventListener('input', function () {
    velocity = +this.value;
    updateReadouts();
  });
  d1Slider.addEventListener('input', function () {
    d1mm = +this.value;
    if (d2mm >= d1mm) { d2mm = d1mm - 5; d2Slider.value = d2mm; }
    d2Slider.max = d1mm - 5;
    updateReadouts();
  });
  d2Slider.addEventListener('input', function () {
    d2mm = +this.value;
    updateReadouts();
  });

  /* Presets */
  $$('.preset-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      velocity = +btn.dataset.v;
      d1mm = +btn.dataset.d1;
      d2mm = +btn.dataset.d2;
      if (btn.dataset.fluid && FLUIDS[btn.dataset.fluid]) fluidKey = btn.dataset.fluid;
      if (btn.dataset.dh !== undefined) deltaH = +btn.dataset.dh;
      forceSlider.value = velocity;
      d1Slider.value = d1mm;
      d2Slider.value = d2mm;
      d2Slider.max = d1mm - 5;
