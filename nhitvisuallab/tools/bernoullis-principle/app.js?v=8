  /* ================================================================
     CANVAS SETUP — responsive via ResizeObserver
     ================================================================ */
  var cvs = document.getElementById('sim-canvas');
  var ctx = cvs.getContext('2d');
  var W = 900, H = 480; /* logical drawing space — never changes */

  function resizeCanvas() {
    /* Hi-DPI: size the backing store to the ACTUAL displayed size × DPR so the
       render is crisp at any width (a fixed 900-wide store softens on wide
       desktops). We still draw in logical 0..W / 0..H space by folding the
       logical→CSS scale into the transform together with DPR.
       Pointer mapping stays logical: (clientX-rect.left)*(W/rect.width). */
    var dpr = Math.max(1, Math.min(window.devicePixelRatio || 1, 2));
    var displayW = Math.max(320, cvs.parentElement.clientWidth - 16);
    var scale = displayW / W;                 /* logical → CSS px */
    cvs.width  = Math.round(displayW * dpr);
    cvs.height = Math.round(H * scale * dpr);
    cvs.style.width  = displayW + 'px';
    cvs.style.height = (H * scale) + 'px';
    ctx.setTransform(scale * dpr, 0, 0, scale * dpr, 0, 0);  /* draw in 0..W, 0..H */
  }
  var _ro = new ResizeObserver(function () { resizeCanvas(); render(); });
  _ro.observe(cvs.parentElement);
  resizeCanvas();

  /* ================================================================
     STATE
     ================================================================ */
  var mode = 'simulate';
