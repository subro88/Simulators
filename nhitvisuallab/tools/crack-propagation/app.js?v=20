  // ── Practice mode ───────────────────────────────────────────
  function randInt(min, max) { return Math.floor(Math.random() * (max - min + 1)) + min; }
  function randChoice(arr) { return arr[Math.floor(Math.random() * arr.length)]; }

  function nextPractice() {
    var p = state.pq;
    var type = randChoice(['kI', 'ac', 'cycles', 'rp']);
    var m = randChoice(MATERIALS.filter(function(x){ return x.KIC > 1; }));
    var sigma = randInt(50, 300);
    var W_p = 200;
    var a_p = randInt(2, 30);
    var geo = randChoice(['center','edge','dedge']);
    var Y = Yfactor(geo, a_p, W_p);
    var prob = { type: type, m: m, sigma: sigma, W: W_p, a: a_p, geo: geo, Y: Y };

    // Choose the right label for 'a' depending on geometry
    var aDescr = (geo === 'center') ? 'half-crack length a' : 'crack length a';
    var prompt = '';
    if (type === 'kI') {
      prob.answer = Y * sigma * Math.sqrt(Math.PI * a_p / 1000);
      prob.unit = 'MPa·√m'; prob.tol = 0.05;
      prompt = 'A <b>' + m.name + '</b> plate (<b>' + geoLabel(geo) + '</b>) of width W = ' + W_p + ' mm has ' + aDescr + ' = <b>' + a_p + ' mm</b>. Applied stress σ = ' + sigma + ' MPa. Geometry factor Y = ' + Y.toFixed(3) + '. Compute <b>K<sub>I</sub></b> in MPa·√m.';
    } else if (type === 'ac') {
      var ac_real = computeAc(m.KIC, sigma);
      prob.answer = ac_real; prob.unit = 'mm'; prob.tol = 0.07;
      var acDescr = (geo === 'center') ? 'critical half-crack length a<sub>c</sub>' : 'critical crack length a<sub>c</sub>';
      prompt = 'A <b>' + m.name + '</b> (K<sub>IC</sub> = ' + m.KIC + ' MPa·√m) plate carries σ = ' + sigma + ' MPa. Geometry: <b>' + geoLabel(geo) + '</b>, W = ' + W_p + ' mm. Find the <b>' + acDescr + '</b> in mm.';
    } else if (type === 'cycles') {
      // simplified: small initial crack, integrate
      var a0_p = 1, dS = sigma;
      var savedGeo = state.geo, savedW = state.W, savedDS = state.dSigma, savedA0 = state.a0, savedMat = state.matId;
      state.geo = geo; state.W = W_p; state.dSigma = dS; state.a0 = a0_p; state.matId = m.id;
      var N = predictCycles();
      state.geo = savedGeo; state.W = savedW; state.dSigma = savedDS; state.a0 = savedA0; state.matId = savedMat;
      if (!isFinite(N) || N <= 0 || N > 1e9) { nextPractice(); return; }
      prob.answer = N; prob.unit = 'cycles'; prob.tol = 0.15; prob.a0 = a0_p; prob.dSigma = dS;
      prompt = 'A <b>' + m.name + '</b> plate (C = ' + m.C.toExponential(2) + ', m = ' + m.m.toFixed(1) + ') has an initial flaw a₀ = 1 mm. Cyclic stress range Δσ = ' + dS + ' MPa. Geometry: <b>' + geoLabel(geo) + '</b>. Predict <b>cycles to fracture N<sub>f</sub></b> (Paris law).';
    } else {
      var KI_real = Y * sigma * Math.sqrt(Math.PI * a_p / 1000);
      prob.answer = (1 / (2 * Math.PI)) * Math.pow(KI_real / m.sy, 2) * 1000; // mm
      prob.unit = 'mm'; prob.tol = 0.07;
      prompt = 'A cracked plate of <b>' + m.name + '</b> (σ<sub>y</sub> = ' + m.sy + ' MPa) has K<sub>I</sub> = ' + KI_real.toFixed(1) + ' MPa·√m at the tip. Compute the <b>Irwin plastic zone radius r<sub>p</sub></b> (plane stress) in mm.';
    }

    p.pCurrent = prob;
    $('practice-prompt').innerHTML = prompt;
    $('practice-input').value = '';
    $('practice-unit').textContent = prob.unit;
    $('practice-feedback').textContent = '';
    $('practice-feedback').className = 'practice-feedback';
    $('practice-solution').style.display = 'none';
  }
  function geoLabel(g) {
    return ({ center: 'centre crack', edge: 'single edge crack', dedge: 'double edge crack', surface: 'surface crack' })[g] || g;
  }
  function checkPractice() {
    var p = state.pq, prob = p.pCurrent;
    if (!prob) return;
    var v = parseFloat($('practice-input').value);
    if (isNaN(v)) return;
    p.pTotal++;
    var rel = Math.abs(v - prob.answer) / Math.max(Math.abs(prob.answer), 1e-9);
    if (rel <= prob.tol) {
      p.pScore++;
      $('practice-feedback').textContent = '✓ Correct! Answer: ' + prob.answer.toFixed(2) + ' ' + prob.unit;
      $('practice-feedback').className = 'practice-feedback feedback-ok';
      playSuccess();
    } else {
      $('practice-feedback').textContent = '✗ Not quite. Expected ' + prob.answer.toFixed(2) + ' ' + prob.unit + ' (yours: ' + v.toFixed(2) + ').';
      $('practice-feedback').className = 'practice-feedback feedback-err';
      playError();
    }
    $('practice-score').textContent = p.pScore + ' / ' + p.pTotal;
  }
  function showSolution() {
    var p = state.pq, prob = p.pCurrent;
    if (!prob) return;
    var html = '';
    if (prob.type === 'kI') {
      html = '<b>Step 1 — Identify variables:</b><br>Y = ' + prob.Y.toFixed(3) + ', σ = ' + prob.sigma + ' MPa, a = ' + prob.a + ' mm = ' + (prob.a/1000) + ' m.<br>' +
             '<b>Step 2 — Apply K_I formula:</b><br><span class="step-eq">K_I = Y · σ · √(π a) = ' + prob.Y.toFixed(3) + ' × ' + prob.sigma + ' × √(π × ' + (prob.a/1000) + ')</span><br>' +
             '<b>Step 3 — Result:</b><br>K_I = <b>' + prob.answer.toFixed(2) + ' MPa·√m</b>';
    } else if (prob.type === 'ac') {
      html = '<b>Step 1 — Set K_I = K_IC and invert:</b><br><span class="step-eq">a_c = (1/π) · (K_IC / (Y σ))²</span><br>' +
             '<b>Step 2 — Y depends on a/W</b>, so we iterate (the simulator uses bisection). Approximate Y ≈ ' + prob.Y.toFixed(3) + ':<br>' +
             '<span class="step-eq">a_c ≈ (1/π) × (' + prob.m.KIC + ' / (' + prob.Y.toFixed(3) + ' × ' + prob.sigma + '))² × 1000 mm</span><br>' +
             '<b>Step 3 — Result:</b><br>a_c = <b>' + prob.answer.toFixed(2) + ' mm</b>';
    } else if (prob.type === 'cycles') {
      html = '<b>Step 1 — Paris law:</b> <span class="step-eq">da/dN = C(ΔK)^m</span><br>' +
             '<b>Step 2 — Integrate from a₀ = ' + prob.a0 + ' mm to a_c</b>; for Y nearly constant and m≠2, closed-form exists:<br>' +
             '<span class="step-eq">N = (2 / ((m−2) · C · (YΔσ√π)^m)) · (a₀^(1−m/2) − a_c^(1−m/2))</span><br>' +
             '<b>Step 3 — Numerical result:</b><br>N_f ≈ <b>' + Math.round(prob.answer).toLocaleString() + ' cycles</b>';
    } else {
      html = '<b>Step 1 — Irwin plastic zone (plane stress):</b><br><span class="step-eq">r_p = (1/(2π)) · (K_I / σ_y)²</span><br>' +
             '<b>Step 2 — Substitute:</b><br><span class="step-eq">r_p = (1/(2π)) · (K_I in MPa√m / σ_y in MPa)² · 1000 mm</span><br>' +
             '<b>Step 3 — Result:</b><br>r_p = <b>' + prob.answer.toFixed(3) + ' mm</b>';
    }
    $('practice-solution').innerHTML = html;
    $('practice-solution').style.display = '';
  }

  // ── Quiz mode ───────────────────────────────────────────────
  function buildQuizQuestion() {
    var t = randChoice(['mc_geo', 'mc_concept', 'num_kI', 'num_ac', 'num_cycles']);
    if (t === 'mc_geo') {
      var pairs = [
        ['Centre crack in plate (Feddersen)', 'Y = √(sec(π a/W))'],
        ['Single edge crack', 'Y = 1.12 (small a)'],
        ['Double edge crack', 'Y = 1.12 / √(1−a/W) (small a)'],
        ['Semi-elliptical surface crack', 'Y from Newman–Raju']
      ];
      var pick = randChoice(pairs);
      var opts = pairs.map(function(p){ return p[1]; });
      return { prompt: 'Which Y(a/W) expression matches the <b>' + pick[0] + '</b>?', options: opts, correct: pick[1], type: 'mc' };
    }
    if (t === 'mc_concept') {
      var qs = [
        { q: 'Doubling the applied stress σ changes the critical crack length a_c by what factor?', opts: ['×1/2','×1/4','×2','unchanged'], correct: '×1/4' },
        { q: 'Below the threshold ΔK<sub>th</sub>:', opts: ['Fatigue crack grows faster','Crack does not grow','Crack arrests immediately','Material fractures'], correct: 'Crack does not grow' },
        { q: 'K<sub>IC</sub> (plane-strain) is typically:', opts: ['Higher than plane-stress K<sub>C</sub>','Lower than plane-stress K<sub>C</sub>','Same as plane-stress K<sub>C</sub>','Always > 200 MPa·√m'], correct: 'Lower than plane-stress K<sub>C</sub>' },
        { q: 'Which material has the LOWEST K<sub>IC</sub>?', opts: ['Mild steel','Soda-lime glass','Polycarbonate','Al 7075'], correct: 'Soda-lime glass' },
        { q: 'Increasing yield strength σ<sub>y</sub> within a steel family generally:', opts: ['Increases K<sub>IC</sub>','Decreases K<sub>IC</sub>','Has no effect on K<sub>IC</sub>','Doubles K<sub>IC</sub>'], correct: 'Decreases K<sub>IC</sub>' }
      ];
      var pickQ = randChoice(qs);
      return { prompt: pickQ.q, options: pickQ.opts.slice(), correct: pickQ.correct, type: 'mc' };
    }
    if (t === 'num_kI') {
      var sigma = randInt(80,250), a = randInt(3,15), Y = 1.0;
      return { prompt: 'For a single-edge cracked plate (Y ≈ 1.12, a small), σ = ' + sigma + ' MPa, a = ' + a + ' mm. Compute K_I in MPa·√m.',
               correct: 1.12 * sigma * Math.sqrt(Math.PI * a/1000), tol: 0.07, unit: 'MPa·√m', type: 'num' };
    }
    if (t === 'num_ac') {
      var m = randChoice([MATERIALS[0], MATERIALS[4], MATERIALS[5], MATERIALS[6]]);
      var sigma2 = randInt(100,300);
      var Y2 = 1.0;
      var ac = (1/Math.PI) * Math.pow(m.KIC / (Y2 * sigma2), 2) * 1000;
      return { prompt: 'Find a_c (mm) for <b>' + m.name + '</b> (K<sub>IC</sub> = ' + m.KIC + ' MPa·√m) under σ = ' + sigma2 + ' MPa, Y = 1.0.',
               correct: ac, tol: 0.1, unit: 'mm', type: 'num' };
    }
    // num_cycles simplified
    var mC = randChoice([MATERIALS[0], MATERIALS[4]]);
    var dS3 = randInt(100, 250); var a0_3 = 1;
    var savedG = state.geo, savedW3 = state.W, savedDS = state.dSigma, savedA0 = state.a0, savedMat = state.matId;
    state.geo = 'edge'; state.W = 200; state.dSigma = dS3; state.a0 = a0_3; state.matId = mC.id;
    var N = predictCycles();
    state.geo = savedG; state.W = savedW3; state.dSigma = savedDS; state.a0 = savedA0; state.matId = savedMat;
    return { prompt: 'Predict cycles to failure for <b>' + mC.name + '</b>: edge crack, a₀ = 1 mm, Δσ = ' + dS3 + ' MPa, W = 200 mm.',
             correct: N, tol: 0.2, unit: 'cycles', type: 'num' };
  }

  function startQuiz() {
    var p = state.pq;
    p.qList = []; p.qAnswers = []; p.qIdx = 0; p.qSelected = null; p.qSubmitted = false;
    for (var i = 0; i < p.qSize; i++) p.qList.push(buildQuizQuestion());
    $('quiz-result').style.display = 'none';
    $('quiz-bar').style.display = '';
    showQuizQ();
  }
  function showQuizQ() {
    var p = state.pq, q = p.qList[p.qIdx];
    $('quiz-counter').textContent = 'Q ' + (p.qIdx + 1) + ' / ' + p.qSize;
    $('quiz-prompt').innerHTML = q.prompt;
    p.qSubmitted = false; p.qSelected = null;
    $('quiz-feedback').textContent = ''; $('quiz-feedback').className = 'practice-feedback';
    $('quiz-next').disabled = true;

    if (q.type === 'mc') {
      $('quiz-options').style.display = '';
      $('quiz-input-group').style.display = 'none';
      // shuffle options
      var opts = q.options.slice();
      for (var i = opts.length - 1; i > 0; i--) { var j = Math.floor(Math.random()*(i+1)); var t=opts[i]; opts[i]=opts[j]; opts[j]=t; }
      $('quiz-options').innerHTML = '';
      opts.forEach(function (o) {
        var b = document.createElement('div'); b.className = 'quiz-opt'; b.innerHTML = o;
        b.addEventListener('click', function () {
          if (p.qSubmitted) return;
          $$('#quiz-options .quiz-opt').forEach(function(x){ x.classList.remove('selected'); });
          b.classList.add('selected');
          p.qSelected = o;
        });
        $('quiz-options').appendChild(b);
      });
    } else {
      $('quiz-options').style.display = 'none';
      $('quiz-input-group').style.display = '';
      $('quiz-input').value = '';
      $('quiz-unit').textContent = q.unit;
    }
  }
  function submitQuiz() {
    var p = state.pq, q = p.qList[p.qIdx];
    if (p.qSubmitted) return;
    var ok;
    if (q.type === 'mc') {
      if (!p.qSelected) return;
      ok = (p.qSelected === q.correct);
      $$('#quiz-options .quiz-opt').forEach(function (x) {
        if (x.textContent.replace(/\s+/g,' ').trim() === q.correct.replace(/<[^>]+>/g,'').trim()) x.classList.add('correct');
        if (x.classList.contains('selected') && !ok) x.classList.add('wrong');
      });
    } else {
      var v = parseFloat($('quiz-input').value);
      if (isNaN(v)) return;
      ok = Math.abs(v - q.correct) / Math.max(Math.abs(q.correct),1e-9) <= q.tol;
    }
    p.qAnswers.push({ q: q, ok: ok, given: (q.type === 'mc' ? p.qSelected : parseFloat($('quiz-input').value)) });
    p.qSubmitted = true;
    $('quiz-feedback').textContent = ok ? '✓ Correct' : ('✗ Expected: ' + (q.type === 'mc' ? q.correct : (q.correct.toFixed(2) + ' ' + q.unit)));
    $('quiz-feedback').className = ok ? 'practice-feedback feedback-ok' : 'practice-feedback feedback-err';
    $('quiz-next').disabled = false;
    if (ok) playSuccess(); else playError();
  }
  function nextQuizQ() {
    var p = state.pq;
    p.qIdx++;
    if (p.qIdx >= p.qSize) showQuizResult(); else showQuizQ();
  }
  function showQuizResult() {
    var p = state.pq;
    var sc = p.qAnswers.filter(function(x){return x.ok;}).length;
    var stars = sc >= 5 ? '★★★★★' : sc === 4 ? '★★★★☆' : sc === 3 ? '★★★☆☆' : sc === 2 ? '★★☆☆☆' : sc === 1 ? '★☆☆☆☆' : '☆☆☆☆☆';
    var klass = sc === 5 ? 'perfect' : sc >= 3 ? 'good' : 'poor';
    var html = '<div class="qr-header"><div class="qr-score ' + klass + '">' + sc + ' / ' + p.qSize + '</div><div class="qr-stars">' + stars + '</div></div>';
    html += '<div class="qr-rows">';
    p.qAnswers.forEach(function (a, i) {
      html += '<div class="qr-row ' + (a.ok ? 'ok' : 'err') + '"><div class="qr-q">Q' + (i+1) + ': ' + a.q.prompt + '</div>' +
              '<div class="qr-a">' + (a.ok ? '✓ ' : '✗ ') + 'Expected: ' + (a.q.type === 'mc' ? a.q.correct : (a.q.correct.toFixed(2) + ' ' + a.q.unit)) + '</div></div>';
    });
    html += '</div>';
    html += '<div style="text-align:center"><button class="btn btn-primary" id="quiz-retry" type="button">Try Again</button></div>';
    $('quiz-result').innerHTML = html;
    $('quiz-result').style.display = '';
    $('quiz-bar').style.display = 'none';
    $('quiz-retry').addEventListener('click', startQuiz);
  }

  // ── Export ───────────────────────────────────────────────────
  function exportCSV() {
    var m = getMaterial();
    var sigma = (state.analysis === 'static' ? state.sigma : state.dSigma);
    var aMax = state.W * 0.45;
    var rows = ['a_mm,K_I_MPa_sqrt_m,Y'];
    for (var i = 0; i <= 50; i++) {
      var a = (i / 50) * aMax;
      if (a < 0.1) a = 0.1;
      var Y = Yfactor(state.geo, a, state.W);
      var K = Y * sigma * Math.sqrt(Math.PI * a / 1000);
      rows.push(a.toFixed(2) + ',' + K.toFixed(3) + ',' + Y.toFixed(4));
    }
    var blob = new Blob([rows.join('\n')], { type: 'text/csv' });
    var a2 = document.createElement('a');
    a2.href = URL.createObjectURL(blob);
    a2.download = 'crack-propagation_' + state.geo + '_' + m.id + '.csv';
    a2.click();
    playClick();
  }
  function exportPNG() {
    var src = mainCv;
    var tmp = document.createElement('canvas');
    tmp.width = src.width; tmp.height = src.height;
    var tc = tmp.getContext('2d');
    tc.drawImage(src, 0, 0);
    var fs = Math.round(tmp.width * 0.022); if (fs < 10) fs = 10;
    tc.font = '600 ' + fs + 'px "Segoe UI", system-ui, sans-serif';
    tc.textAlign = 'right'; tc.textBaseline = 'bottom';
    tc.fillStyle = 'rgba(255,255,255,0.25)';
    tc.fillText('mechsimulator.com', tmp.width - 12, tmp.height - 8);
    var a = document.createElement('a');
    a.href = tmp.toDataURL('image/png');
    a.download = 'crack-propagation_snapshot.png';
    a.click();
    playClick();
  }

  // ── Show Calculation modal ─────────────────────────────────
  function showCalcModal() {
    var m = getMaterial();
    var sigma = (state.analysis === 'static' ? state.sigma : state.dSigma);
    var Y = Yfactor(state.geo, state.a, state.W);
    var KI = computeKI();
    var R = state.Rratio || 0;
    var sigMax = (state.analysis === 'paris') ? sigmaMaxFromRange(sigma, R) : sigma;
    var ac = computeAc(m.KIC, sigMax);
    var rp = plasticZoneMm(KI, m.sy);
    var aDescr = (state.geo === 'center') ? 'a (half-crack)' : 'a (crack length)';
    var html = '';
    html += '<div class="calc-step"><b>Step 1 — Inputs</b>' +
            'Geometry: <em>' + geoLabel(state.geo) + '</em>; W = ' + state.W + ' mm; ' + aDescr + ' = ' + state.a.toFixed(2) + ' mm; ' +
            (state.analysis === 'paris' ? 'Δσ = ' + sigma + ' MPa, R = ' + R.toFixed(2) + ' ⇒ σ_max = Δσ/(1−R) = ' + sigMax.toFixed(1) + ' MPa' : 'σ = ' + sigma + ' MPa') +
            '<br>Material: <em>' + m.name + '</em>; K<sub>IC</sub> = ' + m.KIC + ' MPa·√m; σ<sub>y</sub> = ' + m.sy + ' MPa</div>';
    // format a number in scientific notation as LaTeX (e.g. 6.90×10⁻¹²)
    function sciL(x) { var p = x.toExponential(2).split('e'); return p[0] + '\\times 10^{' + parseInt(p[1], 10) + '}'; }

    html += '<div class="calc-step"><b>Step 2 — Geometry factor</b>' +
            '<span class="calc-eq">\\[ \\frac{a}{W} = ' + (state.a/state.W).toFixed(3) + ' \\;\\Rightarrow\\; Y = ' + Y.toFixed(3) + ' \\]</span></div>';
    html += '<div class="calc-step"><b>Step 3 — Stress intensity factor</b>' +
            '<span class="calc-eq">\\[ K_I = Y\\,\\sigma\\sqrt{\\pi a} = ' + Y.toFixed(3) + ' \\times ' + sigma + ' \\times \\sqrt{\\pi \\times ' + (state.a/1000).toFixed(5) + '} = ' + KI.toFixed(2) + '\\ \\mathrm{MPa\\sqrt{m}} \\]</span></div>';
    html += '<div class="calc-step"><b>Step 4 — Critical crack length</b>' +
            'Set \\( K_I = K_{IC} \\) at \\( \\sigma = \\sigma_{\\max} \\) and solve for \\(a\\):' +
            '<span class="calc-eq">\\[ a_c = \\frac{1}{\\pi}\\left(\\frac{K_{IC}}{Y\\,\\sigma_{\\max}}\\right)^2 = ' + ac.toFixed(2) + '\\ \\mathrm{mm} \\]</span>' +
            '<em style="color:var(--text-dim);font-size:0.78rem">Note: Y depends on a/W, so this is solved iteratively (bisection) — the simulator uses Y evaluated AT a_c, not at the current a.</em></div>';
    html += '<div class="calc-step"><b>Step 5 — Plastic zone</b>' +
            '<span class="calc-eq">\\[ r_p = \\frac{1}{2\\pi}\\left(\\frac{K_I}{\\sigma_y}\\right)^2 = ' + rp.toFixed(3) + '\\ \\mathrm{mm}\\ \\text{(plane stress)} \\]</span>' +
            '<em style="color:var(--text-dim);font-size:0.78rem">Plane-strain value is 3× smaller. Valid LEFM requires r_p ≪ a and r_p ≪ (W−a).</em></div>';
    if (state.analysis === 'paris') {
      var dKeff = effectiveDeltaK(KI, R);
      html += '<div class="calc-step"><b>Step 6 — Fatigue (Walker effective ΔK)</b>' +
              '<span class="calc-eq">\\[ \\Delta K_{\\mathrm{eff}} = \\frac{\\Delta K}{\\sqrt{1-R}} = \\frac{' + KI.toFixed(2) + '}{\\sqrt{' + (1-R).toFixed(2) + '}} = ' + dKeff.toFixed(2) + '\\ \\mathrm{MPa\\sqrt{m}} \\]</span>' +
              '<span class="calc-eq">\\[ \\frac{da}{dN} = C(\\Delta K_{\\mathrm{eff}})^{m} = ' + sciL(m.C) + '\\cdot(' + dKeff.toFixed(2) + ')^{' + m.m.toFixed(1) + '} \\]</span></div>';
    }
    html += '<div class="calc-step"><b>Verdict</b>';
    if (KI >= m.KIC) html += '\\( K_I \\ge K_{IC} \\) ⇒ <span style="color:#ff5555">FRACTURE</span>';
    else html += '\\( K_I = ' + (KI/m.KIC*100).toFixed(0) + '\\% \\) of \\( K_{IC} \\) ⇒ <span style="color:#3ddc84">stable</span>';
    html += '</div>';
    $('calc-modal-body').innerHTML = html;
    $('calc-modal').style.display = 'flex';
    // Render KaTeX immediately (the MutationObserver also catches it)
    if (window.MMLatex && window.MMLatex.render) window.MMLatex.render($('calc-modal-body'));
  }

  // ── Context menu ────────────────────────────────────────────
  function setupContextMenu() {
    var menu = $('ctx-menu');
    function show(e, cv) {
      e.preventDefault();
      menu.innerHTML = '';
      var items = [
        { l: 'Save canvas as PNG', a: function(){ exportPNG(); } },
        { l: 'Copy K_I to clipboard', a: function(){
            var v = fmt(dispK(computeKI()), 3) + ' ' + uK();
            if (navigator.clipboard) navigator.clipboard.writeText(v);
          } },
        { l: 'Export K vs a CSV', a: exportCSV },
        { l: 'sep' },
        { l: 'Reset state', a: resetState }
      ];
      items.forEach(function (it) {
        var li = document.createElement('li');
        if (it.l === 'sep') li.className = 'sep';
        else { li.textContent = it.l; li.addEventListener('click', function () { it.a(); menu.style.display = 'none'; }); }
        menu.appendChild(li);
      });
      menu.style.left = e.clientX + 'px';
      menu.style.top = e.clientY + 'px';
      menu.style.display = 'block';
    }
    mainCv.addEventListener('contextmenu', function (e) { show(e, mainCv); });
    chartCv.addEventListener('contextmenu', function (e) { show(e, chartCv); });
    document.addEventListener('click', function () { menu.style.display = 'none'; });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') { $('calc-modal').style.display = 'none'; menu.style.display = 'none'; }
    });
  }
  function resetState() {
    state.W = 200; state.a = 10; state.sigma = 100; state.dSigma = 80; state.a0 = 1.0; state.Rratio = 0.1;
    pauseParis();
    buildControls();
    requestDraw();
  }

  // ── Init ─────────────────────────────────────────────────────
  function init() {
    mainCv = $('main-canvas'); mainCtx = mainCv.getContext('2d');
    chartCv = $('chart-canvas'); chartCtx = chartCv.getContext('2d');
    histCv = $('history-canvas'); histCtx = histCv.getContext('2d');
    fitAllCanvases();
    observeCanvases();

    // Mode tabs
    $$('#mode-tabs .pill').forEach(function (p) {
      p.addEventListener('click', function () { setMode(p.dataset.value); playClick(); });
    });
    $$('#unit-tabs .pill').forEach(function (p) {
      p.addEventListener('click', function () { setUnit(p.dataset.value); playClick(); });
    });
    $$('#analysis-tabs .pill').forEach(function (p) {
      p.addEventListener('click', function () { setAnalysis(p.dataset.value); playClick(); });
    });
    $$('#geo-tabs .geo-btn').forEach(function (b) {
      b.addEventListener('click', function () { setGeo(b.dataset.geo); });
    });
    $$('#explore-tabs .pill').forEach(function (p) {
      p.addEventListener('click', function () {
        $$('#explore-tabs .pill').forEach(function(x){ x.classList.remove('active'); });
        p.classList.add('active');
        renderExplore(); playClick();
      });
    });

    // Toggle chips
    $('dim-toggle').addEventListener('change', function (e) { state.showDim = e.target.checked; requestDraw(); });
    $('field-toggle').addEventListener('change', function (e) { state.showField = e.target.checked; requestDraw(); });
    $('pzone-toggle').addEventListener('change', function (e) { state.showPzone = e.target.checked; requestDraw(); });
    $('eqn-toggle').addEventListener('change', function (e) { state.showEqn = e.target.checked; requestDraw(); });

    // Hint bar
    $('hint-close').addEventListener('click', function () { $('hint-bar').style.display = 'none'; });

    // Show calculation
    $('show-calc-btn').addEventListener('click', showCalcModal);
    $('calc-modal-close').addEventListener('click', function(){ $('calc-modal').style.display = 'none'; });
    $('calc-modal').addEventListener('click', function (e) { if (e.target === $('calc-modal')) $('calc-modal').style.display = 'none'; });

    // Export
    $('export-csv-btn').addEventListener('click', exportCSV);
    $('export-png-btn').addEventListener('click', exportPNG);

    // Learning panel toggle
    $('learn-expand-all').addEventListener('click', function () {
      $$('.learn-card').forEach(function (d) { d.open = true; });
    });
    $('learn-collapse-all').addEventListener('click', function () {
      $$('.learn-card').forEach(function (d) { d.open = false; });
    });

    // Paris controls
    $('paris-play').addEventListener('click', startParis);
    $('paris-pause').addEventListener('click', pauseParis);
    $('paris-reset').addEventListener('click', resetParis);

    // Practice
    $('practice-check').addEventListener('click', checkPractice);
    $('practice-next').addEventListener('click', nextPractice);
    $('practice-show').addEventListener('click', showSolution);
    $('practice-input').addEventListener('keydown', function (e) { if (e.key === 'Enter') checkPractice(); });

    // Quiz
    $('quiz-submit').addEventListener('click', submitQuiz);
    $('quiz-next').addEventListener('click', nextQuizQ);
    $('quiz-input').addEventListener('keydown', function (e) { if (e.key === 'Enter') submitQuiz(); });

    // Scenario picker
    buildScenarioSelect();
    // About button — toggles the scenario description card open/closed
    var sb = $('scenario-info-btn');
    if (sb) sb.addEventListener('click', function () {
      var sel = $('scenario-select');
      if (!sel.value) { sel.focus(); return; }   // no scenario picked yet
      var d = $('scenario-desc');
      var open = d.style.display !== 'none' && d.innerHTML.trim() !== '';
      setScenarioDescOpen(!open);
    });
    // Material
    buildMaterialSelect();
    // Sliders
    buildControls();
    // Context menu
    setupContextMenu();

    setMode('simulate');
    setAnalysis('paris');   // default to scenario-run so Play/Pause/Reset are visible on load
    // Preload the Aircraft-skin scenario so pressing Play immediately shows propagation
    var defaultScenarioSel = $('scenario-select');
    if (defaultScenarioSel) {
      defaultScenarioSel.value = 'aircraft_skin';
      applyScenario('aircraft_skin');
    }
    requestDraw();
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
