  // ── Paris-law integration ──────────────────────────────────
  // da/dN = C·(ΔK_eff)^m  with Walker effective ΔK and R-dependent threshold.
  // Fracture trigger: K_max = σ_max·Y·√(πa) ≥ K_IC, where σ_max = Δσ/(1−R).
  function predictCycles() {
    var m = getMaterial();
    var dS = state.dSigma;
    var R = state.Rratio || 0;
    var sigMax = sigmaMaxFromRange(dS, R);
    var dKth = thresholdDeltaK(m.dKth, R);
    var a = state.a0 / 1000; // m
    var ac = computeAc(m.KIC, sigMax) / 1000; // m
    if (ac <= a) return 0;

    // Log-spaced adaptive integration — robust for high-m materials (ceramics m=8, glass m=16)
    var N = 0;
    var dlnA = 0.01; // relative crack growth per step
    var maxSteps = 200000;
    var steps = 0;
    while (a < ac && steps < maxSteps) {
      var a_mm = a * 1000;
      var Y = Yfactor(state.geo, a_mm, state.W);
      var dK = Y * dS * Math.sqrt(Math.PI * a);
      var dKeff = effectiveDeltaK(dK, R);
      if (dKeff < dKth) break;
      var dadN = m.C * Math.pow(dKeff, m.m); // m/cycle
      if (!isFinite(dadN) || dadN <= 0) break;
      var da = Math.min(a * dlnA, ac - a);
      var dN = da / dadN;
      if (!isFinite(dN) || dN <= 0) break;
      N += dN;
      a += da;
      steps++;
    }
    return N;
  }

  function parisStep() {
    if (!state.parisRunning) return;
    var m = getMaterial();
    var dS = state.dSigma;
    var R = state.Rratio || 0;
    var sigMax = sigmaMaxFromRange(dS, R);
    var dKth = thresholdDeltaK(m.dKth, R);
    var a_mm = state.parisA;
    var a_m = a_mm / 1000;
    var Y = Yfactor(state.geo, a_mm, state.W);
    var dK = Y * dS * Math.sqrt(Math.PI * a_m);
    var dKeff = effectiveDeltaK(dK, R);
    var ac = computeAc(m.KIC, sigMax);

    if (dKeff < dKth) {
      // Below threshold for the active R — no growth
      state.parisRunning = false;
      return;
    }
    var dadN = m.C * Math.pow(dKeff, m.m); // m/cycle, Walker effective
    // adaptive cycles-per-frame (visual growth ~0.02 mm)
    var targetDa = 0.02; // mm per frame
    var dN = (targetDa / 1000) / Math.max(dadN, 1e-15);
    dN = Math.min(Math.max(dN, 1), 1e5);
    state.parisCycle += dN;
    state.parisA = a_mm + dadN * dN * 1000;
    state.a = state.parisA;
    state.parisHistory.push({ N: state.parisCycle, a: state.parisA });
    if (state.parisHistory.length > 600) state.parisHistory.shift();

    $('paris-cycle').textContent = Math.round(state.parisCycle).toLocaleString();
    $('paris-a').textContent = fmt(dispLen(state.parisA), 2) + ' ' + uLen();
    sliders.a && sliders.a.refresh();

    if (state.parisA >= ac) {
      state.parisRunning = false;
      state.fractured = true;
      state.fractureCycle = state.parisCycle;
      state.fractureAnim = 0;
      state.shake = 8;
      playCrack();
      drawMain(); drawChart(); drawHistorySpark();
      // Animate the catastrophic split over 1.5s
      startFractureAnim();
      updateReadouts();
      return;
    }
    drawMain(); drawChart(); drawHistorySpark();
    state.rafId = setTimeout(parisStep, 16);
  }
  function startParis() {
    // Always cancel any prior loop and restart fresh
    if (state.rafId) clearTimeout(state.rafId);
    state.parisRunning = false;
    state.parisA = state.a0;
    state.a = state.a0;
    state.parisCycle = 0;
    state.parisHistory = [{ N: 0, a: state.parisA }];
    state.parisRunning = true;
    playClick();
    sliders.a && sliders.a.refresh();
    state.rafId = setTimeout(parisStep, 16);
  }
  function pauseParis() { state.parisRunning = false; if (state.rafId) clearTimeout(state.rafId); }

  // ── Catastrophic fracture animation ───────────────────────
  var _fractureStart = 0;
  function startFractureAnim() {
    if (state.fractureRafId) clearTimeout(state.fractureRafId);
    _fractureStart = Date.now();
    state.fractureAnim = 0;
    state.shake = 10;
    fractureStep();
  }
  function fractureStep() {
    var dt = (Date.now() - _fractureStart) / 1500;
    state.fractureAnim = Math.min(1, dt);
    state.shake = Math.max(0, 10 * (1 - dt));
    drawMain();
    if (dt < 1) {
      state.fractureRafId = setTimeout(fractureStep, 30);
    } else {
      state.shake = 0;
      drawMain();
    }
  }
  function resetParis() {
    pauseParis();
    if (state.fractureRafId) { clearTimeout(state.fractureRafId); state.fractureRafId = null; }
    state.fractured = false;
    state.fractureAnim = 0;
    state.shake = 0;
    state.parisA = state.a0;
    state.a = state.a0;
    state.parisCycle = 0;
    state.parisHistory = [];
    $('paris-cycle').textContent = '0';
    $('paris-a').textContent = '—';
    sliders.a && sliders.a.refresh();
    drawHistorySpark();
    requestDraw();
  }

