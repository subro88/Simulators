  // ── Unit helpers ─────────────────────────────────────────────
  // SI internal: mm for lengths, MPa for stress, MPa*sqrt(m) for K
  // Imperial display: in, ksi, ksi*sqrt(in)
  // 1 in = 25.4 mm; 1 MPa = 0.145038 ksi; 1 MPa*sqrt(m) = 0.910058 ksi*sqrt(in)
  var IMP = {
    len: { f: 1/25.4, unit: 'in', dp: 3 },
    sig: { f: 0.145038, unit: 'ksi', dp: 2 },
    K:   { f: 0.910058, unit: 'ksi·√in', dp: 2 }
  };
  function dispLen(mm)   { return state.unit === 'si' ? mm : mm * IMP.len.f; }
  function dispSig(mpa)  { return state.unit === 'si' ? mpa : mpa * IMP.sig.f; }
  function dispK(mpaSm)  { return state.unit === 'si' ? mpaSm : mpaSm * IMP.K.f; }
  function uLen() { return state.unit === 'si' ? 'mm' : 'in'; }
  function uSig() { return state.unit === 'si' ? 'MPa' : 'ksi'; }
  function uK()   { return state.unit === 'si' ? 'MPa·√m' : 'ksi·√in'; }
  function fmt(n, dp) { if (!isFinite(n)) return '—'; return n.toFixed(dp == null ? 2 : dp); }

  // ── Geometry factor Y(a/W) ───────────────────────────────────
  // References:
  //   Centre crack:   Feddersen secant       Y = sqrt(sec(π·a/W)), a = half-crack
  //   Single edge:    Tada/Paris/Irwin 1985  universal trigonometric form (accurate to 0.5% for all α)
  //   Double edge:    Anderson "Fracture Mechanics" 3rd ed., Table 2.4
  //   Surface crack:  Newman-Raju 1981, semi-elliptical a/c = 0.4, deepest point
  function Yfactor(geo, a_mm, W_mm) {
    var x = a_mm / W_mm;
    if (x < 0) x = 0;
    if (geo === 'center') {
      // Feddersen secant — a is half-crack length, valid for 2a < W (i.e. a/W < 0.5)
      if (x > 0.49) x = 0.49;
      var arg = Math.PI * x;
      var c = Math.cos(arg);
      if (c < 0.02) c = 0.02;
      return Math.sqrt(1 / c);
    }
    if (geo === 'edge') {
      // Tada universal trig form (single-edge cracked plate in tension):
      //   F(α) = √(tan(πα/2)/(πα/2)) · [0.752 + 2.02α + 0.37·(1−sin(πα/2))³] / cos(πα/2)
      //   accurate to 0.5% for 0 ≤ α ≤ 1
      if (x > 0.95) x = 0.95;
      var ha = Math.PI * x / 2;
      var tanHa = Math.tan(ha);
      var cosHa = Math.cos(ha);
      var sinHa = Math.sin(ha);
      if (cosHa < 0.02) cosHa = 0.02;
      var pref = (x < 1e-6) ? 1.0 : Math.sqrt(tanHa / ha);
      var bracket = 0.752 + 2.02 * x + 0.37 * Math.pow(1 - sinHa, 3);
      return pref * bracket / cosHa;
    }
    if (geo === 'dedge') {
      // Anderson 2005, Table 2.4 (double-edge cracked plate in tension):
      //   F(a/W) = 1.12 + 0.43(a/W) − 4.79(a/W)² + 15.46(a/W)³,  a/W ≤ 0.7
      // For a/W → 0.5 (cracks meet in middle) the polynomial still gives finite values —
      // physically Y diverges, so cap at 0.49.
      if (x > 0.49) x = 0.49;
      return 1.12 + 0.43 * x - 4.79 * x * x + 15.46 * x * x * x;
    }
    if (geo === 'surface') {
      // Newman-Raju 1981 for semi-elliptical surface crack with a/c = 0.4, deepest point φ = π/2:
      //   Q = 1 + 1.464·(a/c)^1.65 = 1.316   (constant for a/c = 0.4)
      //   M1 = 1.13 − 0.09(a/c) = 1.094
      //   Y_base = M1/√Q = 0.953
      //   Finite-width correction f_w = √(sec(π·c/W · √(a/t)))  assumed t ≈ W (implicit thickness),
      //   absorbed into a simple polynomial fit so the function stays smooth for all a/W ≤ 0.5.
      if (x > 0.49) x = 0.49;
      var fw = 1 + 1.5 * x * x;   // approximates Newman-Raju f_w for shallow flaws
      return 0.953 * fw;
    }
    return 1.0;
  }

  // ── Core LEFM calculations ──────────────────────────────────
  function computeKI() {
    // K_I = Y * sigma * sqrt(pi * a) with a in metres, sigma in MPa => K in MPa*sqrt(m)
    var Y = Yfactor(state.geo, state.a, state.W);
    var a_m = state.a / 1000;
    return Y * state.sigma * Math.sqrt(Math.PI * a_m);
  }
  function computeKIfor(a_mm, sigma) {
    var Y = Yfactor(state.geo, a_mm, state.W);
    var a_m = a_mm / 1000;
    return Y * sigma * Math.sqrt(Math.PI * a_m);
  }
  function computeAc(KIC, sigma) {
    // Solve Y(a)*sigma*sqrt(pi*a) = KIC by bisection (Y depends on a/W)
    var lo = 0.001, hi = state.W * 0.499;
    var lhsLo = computeKIfor(lo, sigma) - KIC;
    var lhsHi = computeKIfor(hi, sigma) - KIC;
    if (lhsLo > 0) return lo;
    if (lhsHi < 0) return hi;
    for (var i = 0; i < 50; i++) {
      var mid = 0.5 * (lo + hi);
      var f = computeKIfor(mid, sigma) - KIC;
      if (f > 0) hi = mid; else lo = mid;
    }
    return 0.5 * (lo + hi);
  }
  function getMaterial() {
    for (var i = 0; i < MATERIALS.length; i++) if (MATERIALS[i].id === state.matId) return MATERIALS[i];
    return MATERIALS[0];
  }
  function plasticZoneMm(KI, sy) {
    // Irwin plastic zone (plane stress): r_p = (1/(2π))·(K/σ_y)²
    // For plane strain, divide by 3 → (1/(6π))·(K/σ_y)²
    // The label everywhere is "plane stress" (conservative — larger zone → fails LEFM
    // small-scale-yielding check sooner).
    if (sy <= 0) return 0;
    var rp_m = (1 / (2 * Math.PI)) * Math.pow(KI / sy, 2);
    return rp_m * 1000; // mm
  }

  // ── R-ratio physics ──────────────────────────────────────────
  // σ_max from cyclic stress range and R = σ_min/σ_max:
  //   R ≥ 0:  σ_max = Δσ / (1 − R)
  //   R < 0:  crack is closed in compression, K_min effectively 0; σ_max ≈ Δσ.
  function sigmaMaxFromRange(dSigma, R) {
    if (R >= 0.99) R = 0.99;
    if (R < 0) return dSigma;          // compression half ignored (crack closure)
    return dSigma / (1 - R);
  }
  // Walker effective ΔK (γ = 0.5) for fatigue crack growth.
  // For R ≥ 0:  ΔK_eff = ΔK / (1 − R)^(1 − γ) = ΔK / √(1 − R)
  // For R < 0:  ΔK_eff = ΔK (only tensile part drives growth; compressive part absorbed by closure)
  function effectiveDeltaK(dK, R) {
    if (R < 0) return dK;
    if (R >= 0.99) R = 0.99;
    return dK / Math.sqrt(1 - R);
  }
  // R-dependent threshold (NASGRO-style simple form): ΔK_th(R) = ΔK_th0 · (1−R)^γ_th, γ_th ≈ 0.5
  function thresholdDeltaK(dKth0, R) {
    if (R < 0) R = 0;
    if (R >= 0.99) R = 0.99;
    return dKth0 * Math.sqrt(1 - R);
  }

  // ── Audio ────────────────────────────────────────────────────
  function getAudio() {
    if (!state.audioCtx) {
      try { state.audioCtx = new (window.AudioContext || window.webkitAudioContext)(); }
      catch (e) { return null; }
    }
    return state.audioCtx;
  }
  function playTone(freq, dur, type, vol) {
    var ac = getAudio(); if (!ac) return;
    var o = ac.createOscillator(); var g = ac.createGain();
    o.type = type || 'sine'; o.frequency.value = freq;
    g.gain.value = vol || 0.05;
    o.connect(g); g.connect(ac.destination);
    o.start();
    g.gain.exponentialRampToValueAtTime(0.0001, ac.currentTime + dur);
    o.stop(ac.currentTime + dur + 0.02);
  }
  function playClick()   { playTone(800, 0.04, 'square', 0.03); }
  function playSuccess() { playTone(880, 0.1, 'sine', 0.08); setTimeout(function(){ playTone(1320, 0.14, 'sine', 0.08); }, 110); }
  function playError()   { playTone(220, 0.18, 'sawtooth', 0.06); }
  function playCrack()   { playTone(180, 0.28, 'sawtooth', 0.1); setTimeout(function(){ playTone(90, 0.3, 'sawtooth', 0.08); }, 100); }
  function playTick()    { playTone(1200, 0.02, 'square', 0.015); }

  // ── Slider builder ───────────────────────────────────────────
  // opts: {label, key, min, max, step, fmtFn, unit, onInput}
  function makeSlider(opts) {
    var wrap = document.createElement('div'); wrap.className = 'slider-group';
    var lbl = document.createElement('label');
    var nm = document.createElement('span'); nm.textContent = opts.label;
    var val = document.createElement('span'); val.className = 'val-span';
    val.title = 'Click to type a value';
    lbl.appendChild(nm); lbl.appendChild(val);
    wrap.appendChild(lbl);

    var row = document.createElement('div'); row.className = 'slider-row';
    var minus = document.createElement('button'); minus.className = 'step-btn'; minus.type = 'button'; minus.textContent = '−';
    var slider = document.createElement('input'); slider.type = 'range';
    slider.className = 'sim-slider';
    slider.min = opts.min; slider.max = opts.max; slider.step = opts.step; slider.value = state[opts.key];
    var plus = document.createElement('button'); plus.className = 'step-btn'; plus.type = 'button'; plus.textContent = '+';
    row.appendChild(minus); row.appendChild(slider); row.appendChild(plus);
    wrap.appendChild(row);

    function refresh() {
      val.textContent = opts.fmtFn(state[opts.key]) + ' ' + (opts.unit || '');
    }
    function setVal(v) {
      v = Math.max(opts.min, Math.min(opts.max, v));
      state[opts.key] = +v.toFixed(4);
      slider.value = state[opts.key];
      refresh();
      if (opts.onInput) opts.onInput();
      requestDraw();
    }
    slider.addEventListener('input', function () { setVal(parseFloat(slider.value)); playTick(); });
    minus.addEventListener('click', function () { setVal(state[opts.key] - parseFloat(opts.step)); playClick(); });
    plus.addEventListener('click', function () { setVal(state[opts.key] + parseFloat(opts.step)); playClick(); });
    val.addEventListener('click', function () {
      var inp = document.createElement('input');
      inp.type = 'number'; inp.className = 'step-input'; inp.value = state[opts.key]; inp.step = opts.step;
      val.replaceWith(inp); inp.focus(); inp.select();
      function commit() {
        var nv = parseFloat(inp.value);
        if (!isNaN(nv)) setVal(nv);
        inp.replaceWith(val); refresh();
      }
      inp.addEventListener('blur', commit);
      inp.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') { commit(); }
        else if (e.key === 'Escape') { inp.replaceWith(val); refresh(); }
      });
    });
    refresh();
    return { wrap: wrap, refresh: refresh, setVal: setVal };
  }

  // ── Build controls (left panel sliders) ─────────────────────
  var sliders = {};
  function buildControls() {
    var box = $('sim-controls');
    box.innerHTML = '';
    sliders = {};

    // Geometry-aware label for 'a'
    var aLabel = (state.geo === 'center') ? 'a (half-crack)' : 'a (crack length)';

    sliders.a = makeSlider({
      label: aLabel, key: 'a',
      min: 0.01, max: state.W * 0.45, step: 0.05,
      fmtFn: function (v) { return fmt(dispLen(v), state.unit === 'si' ? 2 : 3); },
      unit: uLen(),
      onInput: function () { updateMatInfo(); }
    });
    box.appendChild(sliders.a.wrap);

    sliders.W = makeSlider({
      label: 'W (plate width)', key: 'W',
      min: 50, max: 600, step: 1,
      fmtFn: function (v) { return fmt(dispLen(v), state.unit === 'si' ? 1 : 3); },
      unit: uLen(),
      onInput: function () {
        // re-clamp a if needed
        var maxA = state.W * 0.45;
        if (state.a > maxA) state.a = maxA;
        sliders.a.refresh();
      }
    });
    box.appendChild(sliders.W.wrap);

    if (state.analysis === 'static') {
      sliders.sigma = makeSlider({
        label: 'σ (applied)', key: 'sigma',
        min: 1, max: 800, step: 1,
        fmtFn: function (v) { return fmt(dispSig(v), state.unit === 'si' ? 1 : 2); },
        unit: uSig()
      });
      box.appendChild(sliders.sigma.wrap);
    } else {
      // Paris-law sliders — the applied cyclic load is Δσ together with R
      sliders.dSigma = makeSlider({
        label: 'Δσ (applied stress range)', key: 'dSigma',
        min: 5, max: 500, step: 1,
        fmtFn: function (v) { return fmt(dispSig(v), state.unit === 'si' ? 1 : 2); },
        unit: uSig()
      });
      box.appendChild(sliders.dSigma.wrap);

      sliders.Rratio = makeSlider({
        label: 'R (stress ratio)', key: 'Rratio',
        min: -0.5, max: 0.8, step: 0.05,
        fmtFn: function (v) { return fmt(v, 2); },
        unit: ''
      });
      box.appendChild(sliders.Rratio.wrap);

      // Derived peak applied stress that actually drives the crack
      var loadNote = document.createElement('div');
      loadNote.id = 'load-note';
      loadNote.className = 'load-note';
      box.appendChild(loadNote);

      sliders.a0 = makeSlider({
        label: 'a₀ (initial flaw)', key: 'a0',
        min: 0.01, max: 20, step: 0.01,    // allow micron-scale flaws for ceramics
        fmtFn: function (v) { return fmt(dispLen(v), state.unit === 'si' ? 3 : 4); },
        unit: uLen()
      });
      box.appendChild(sliders.a0.wrap);
    }
  }

  // ── Scenario UI ──────────────────────────────────────────────
  function buildScenarioSelect() {
    var sel = $('scenario-select');
    sel.innerHTML = '';
    var def = document.createElement('option');
    def.value = ''; def.textContent = '— Custom setup (use sliders below) —';
    sel.appendChild(def);
    SCENARIOS.forEach(function (s) {
      var o = document.createElement('option');
      o.value = s.id;
      o.textContent = s.emoji + '  ' + s.name;
      sel.appendChild(o);
    });
    sel.addEventListener('change', function () {
      if (!sel.value) { setScenarioDescOpen(false); return; }
      applyScenario(sel.value);
    });
  }
  // Show/hide the scenario description and reflect the state on the About button.
  function setScenarioDescOpen(open) {
    var d = $('scenario-desc'); if (!d) return;
    d.style.display = open ? '' : 'none';
    var sb = $('scenario-info-btn');
    if (sb) {
      sb.setAttribute('aria-expanded', open ? 'true' : 'false');
      sb.innerHTML = open ? '&#10005; Hide' : '&#8505;&#65038; About';
    }
  }
  function applyScenario(id) {
    var s = null;
    for (var i = 0; i < SCENARIOS.length; i++) if (SCENARIOS[i].id === id) { s = SCENARIOS[i]; break; }
    if (!s) return;
    // Apply
    state.matId = s.mat;
    state.geo = s.geo;
    state.W = s.W;
    state.a0 = s.a0;
    state.a = s.a0;
    state.dSigma = s.dSigma;
    state.sigma = s.dSigma;       // also seed sigma for static view
    state.Rratio = s.R;
    state.parisA = s.a0;
    state.parisCycle = 0;
    state.parisHistory = [];
    state.fractured = false;
    state.fractureAnim = 0;
    pauseParis();
    // Sync UI
    $('material-select').value = s.mat;
    $$('#geo-tabs .geo-btn').forEach(function (b) { b.classList.toggle('active', b.dataset.geo === s.geo); });
    // Auto-switch to Paris mode so user can press Play
    setAnalysis('paris');
    updateMatInfo();
    // Show description
    var d = $('scenario-desc');
    d.innerHTML = '<span class="sc-name">' + s.emoji + ' ' + s.name + '</span>' +
                  s.desc +
                  '<span class="sc-expect"><b>Expect:</b> ' + s.expect + '</span>';
    setScenarioDescOpen(true);
    requestDraw();
    playClick();
  }

  // ── Material UI ──────────────────────────────────────────────
  function buildMaterialSelect() {
    var sel = $('material-select');
    sel.innerHTML = '';
    // Group by class
    var classes = {};
    MATERIALS.forEach(function (m) { (classes[m.klass] = classes[m.klass] || []).push(m); });
    Object.keys(classes).forEach(function (k) {
      var g = document.createElement('optgroup'); g.label = k;
      classes[k].forEach(function (m) {
        var o = document.createElement('option'); o.value = m.id; o.textContent = m.name;
        g.appendChild(o);
      });
      sel.appendChild(g);
    });
    sel.value = state.matId;
    sel.addEventListener('change', function () {
      state.matId = sel.value;
      updateMatInfo();
      resetParis();
      requestDraw();
      playClick();
    });
    updateMatInfo();
  }
  function updateMatInfo() {
    var m = getMaterial();
    $('mat-info').innerHTML = 'K<sub>IC</sub> = <b>' + fmt(dispK(m.KIC), 1) + ' ' + uK() + '</b> · σ<sub>y</sub> = <b>' + fmt(dispSig(m.sy), 0) + ' ' + uSig() + '</b>';
  }

  // ── Drawing — main canvas ───────────────────────────────────
  var mainCv, mainCtx, chartCv, chartCtx, histCv, histCtx;
  // Logical drawing sizes (match the original <canvas> width/height attrs) —
  // everything below draws in this coordinate space; fitCanvas() maps it onto a
  // Hi-DPI backing store so the render stays crisp at any display width.
  var MAIN_W = 760, MAIN_H = 460, CHART_W = 760, CHART_H = 260, HIST_W = 700, HIST_H = 160;

  // Size a canvas' backing store to (display width × device-pixel-ratio) and set
  // the transform so 0..LW × 0..LH is the logical drawing space. No pointer
  // hit-testing maps into these canvases (only a contextmenu using clientX/Y),
  // so this needs no coordinate-mapping counterpart — convention A throughout.
  // Returns true if the backing store actually changed (worth a redraw).
  function fitCanvas(cv, ctx, LW, LH) {
    if (!cv || !ctx) return false;
    var dpr = Math.max(1, Math.min(window.devicePixelRatio || 1, 2));
    var measured = Math.round(cv.getBoundingClientRect().width);
    // Guard: during layout the canvas can momentarily measure ~0. Never shrink to
    // a broken tiny backing — fall back to the logical width until real layout.
    var cssW = measured >= 40 ? measured : LW;
    var wDev = Math.max(1, Math.round(cssW * dpr));
    var hDev = Math.max(1, Math.round(cssW * (LH / LW) * dpr));
    var changed = (cv.width !== wDev || cv.height !== hDev);
    if (changed) { cv.width = wDev; cv.height = hDev; }
    var s = (cssW / LW) * dpr;              // uniform scale (aspect preserved)
    ctx.setTransform(s, 0, 0, s, 0, 0);     // reset every call (width change wipes it)
    return changed;
  }
  function fitAllCanvases() {
    fitCanvas(mainCv, mainCtx, MAIN_W, MAIN_H);
    fitCanvas(chartCv, chartCtx, CHART_W, CHART_H);
    fitCanvas(histCv, histCtx, HIST_W, HIST_H);
  }
  // Robust sizing: a ResizeObserver fits each canvas the moment it receives its
  // real layout size (fixes fragile init-time measurement) and on every resize.
  function observeCanvases() {
    if (!window.ResizeObserver) {
      var _t = null;
      window.addEventListener('resize', function () {
        if (_t) clearTimeout(_t);
        _t = setTimeout(function () { fitAllCanvases(); drawMain(); drawChart(); drawHistorySpark(); }, 120);
      });
      return;
    }
    var pairs = [[mainCv, mainCtx, MAIN_W, MAIN_H, drawMain],
                 [chartCv, chartCtx, CHART_W, CHART_H, drawChart],
                 [histCv, histCtx, HIST_W, HIST_H, drawHistorySpark]];
    pairs.forEach(function (p) {
      var ro = new ResizeObserver(function () {
        if (fitCanvas(p[0], p[1], p[2], p[3])) p[4]();
      });
      ro.observe(p[0]);
    });
  }

  // ── Small render helpers (material kit) ─────────────────────
  function shadeHex(hex, f) {
    var h = hex.replace('#', '');
    var r = parseInt(h.substr(0, 2), 16), g = parseInt(h.substr(2, 2), 16), b = parseInt(h.substr(4, 2), 16);
    r = Math.max(0, Math.min(255, Math.round(r * f)));
    g = Math.max(0, Math.min(255, Math.round(g * f)));
    b = Math.max(0, Math.min(255, Math.round(b * f)));
    return 'rgb(' + r + ',' + g + ',' + b + ')';
  }
  function contactShadow(ctx, cx, cy, rx, ry, a) {
    var g = ctx.createRadialGradient(cx, cy, 0, cx, cy, rx);
    g.addColorStop(0, 'rgba(0,0,0,' + a + ')');
    g.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.save();
    ctx.translate(cx, cy); ctx.scale(1, ry / rx); ctx.translate(-cx, -cy);
    ctx.fillStyle = g;
    ctx.beginPath(); ctx.arc(cx, cy, rx, 0, Math.PI * 2); ctx.fill();
    ctx.restore();
  }
  // Base body tint per material class — metals cool grey-blue, ceramics/glass
  // pale, polymers warm — so the specimen reads as its actual material.
  function plateBase() {
    var k = getMaterial().klass;
    if (k === 'Glass' || k === 'Brittle') return '#7d93ab';
    if (k === 'Ceramic') return '#9aa6b0';
    if (k === 'Polymer') return '#8a7f9c';
    if (k === 'Aluminium') return '#8791a3';
    if (k === 'Titanium') return '#8b8f98';
    return '#78849c'; // steels / superalloys
  }

  var _drawPending = false;
  function requestDraw() {
    if (_drawPending) return;
    _drawPending = true;
    requestAnimationFrame(function () { _drawPending = false; draw(); });
  }

  function colorRamp(t) {
    // viridis-like: blue -> cyan -> green -> yellow -> orange -> red
    t = Math.max(0, Math.min(1, t));
    var stops = [
      [13, 8, 135],     // dark blue
      [84, 2, 163],
      [156, 23, 158],
      [205, 52, 117],
      [237, 121, 83],
      [253, 199, 50],
      [240, 249, 33]    // bright yellow
    ];
    var n = stops.length - 1;
    var idx = Math.min(n - 1, Math.floor(t * n));
    var f = t * n - idx;
    var a = stops[idx], b = stops[idx + 1];
    var r = Math.round(a[0] + (b[0] - a[0]) * f);
    var g = Math.round(a[1] + (b[1] - a[1]) * f);
    var bl = Math.round(a[2] + (b[2] - a[2]) * f);
    return [r, g, bl];
  }

  function draw() {
    drawMain();
    drawChart();
    updateReadouts();
    updateEquations();
    updateCoach();
  }

  function drawMain() {
    var cv = mainCv, ctx = mainCtx;
    if (!ctx) return;
    var W = MAIN_W, H = MAIN_H;
    ctx.save();
    // Camera shake on fracture
    if (state.shake > 0) {
      var sx = (Math.random() - 0.5) * state.shake;
      var sy = (Math.random() - 0.5) * state.shake;
      ctx.translate(sx, sy);
    }
    ctx.clearRect(-24, -24, W + 48, H + 48);

    // Specimen drawing area
    var pad = 60;
    var plateAreaW = W - 2 * pad;
    var plateAreaH = H - 2 * pad - 30; // leave room for arrows

    // Plate dimensions in canvas pixels
    var px_per_mm = Math.min(plateAreaW / state.W, plateAreaH / (state.W * 0.6)) * 0.95;
    var plateW_px = state.W * px_per_mm;
    var plateH_px = state.W * 0.6 * px_per_mm;
    var x0 = (W - plateW_px) / 2;
    var y0 = (H - plateH_px) / 2 + 10;
    var cxPlate = x0 + plateW_px / 2, cyPlate = y0 + plateH_px / 2;

    // Studio background + accent spotlight centred on the specimen (fill the
    // shake margin too, so shake never exposes a transparent strip).
    var grad = ctx.createLinearGradient(0, -24, 0, H + 24);
    if (state.fractured && state.fractureAnim < 0.4) {
      var flash = 1 - state.fractureAnim / 0.4;
      grad.addColorStop(0, 'rgba(80, 12, 12, ' + (0.85 * flash + 0.15) + ')');
      grad.addColorStop(1, '#0b0e15');
    } else {
      grad.addColorStop(0, '#121722'); grad.addColorStop(0.55, '#0e131c'); grad.addColorStop(1, '#0a0d14');
    }
    ctx.fillStyle = grad; ctx.fillRect(-24, -24, W + 48, H + 48);
    var glow = ctx.createRadialGradient(cxPlate, cyPlate, 20, cxPlate, cyPlate, Math.max(W, H) * 0.55);
    glow.addColorStop(0, 'rgba(255,110,64,0.10)'); glow.addColorStop(1, 'rgba(255,110,64,0)');
    ctx.fillStyle = glow; ctx.fillRect(-24, -24, W + 48, H + 48);

    // Contact shadow grounds the specimen
    contactShadow(ctx, cxPlate, y0 + plateH_px + 26, plateW_px * 0.60, 16, 0.45);

    // Specimen — intact, or catastrophically fracturing into two halves
    if (state.fractured) {
      drawFracture(ctx, x0, y0, plateW_px, plateH_px, px_per_mm);
    } else {
      paintSpecimen(ctx, x0, y0, plateW_px, plateH_px, px_per_mm, null);
    }

    // Equation overlay (screen-space, not part of the separating halves)
    if (state.showEqn) drawEqnOverlay(ctx, W, H);

    // Fracture / near-fracture badge
    if (state.fractured) {
      drawFractureBadge(ctx, W, H);
    } else {
      var mMat = getMaterial();
      if (computeKI() >= mMat.KIC) drawFractureBadge(ctx, W, H);
    }
    ctx.restore();
  }

  // Paint the whole physical specimen (grips → plate → field → load arrows →
  // crack → plastic zone → dims). Extracted so the fracture code can render it
  // clipped+translated as two separating halves. opts:
  //   { minimal:true }  skip crack/pzone/prop-arrows/dims (used mid-separation)
  //   { fieldAlpha:x }  fade the stress field as stored energy releases
  function paintSpecimen(ctx, x0, y0, pw, ph, px_per_mm, opts) {
    opts = opts || {};
    drawGrips(ctx, x0, y0, pw, ph);
    drawSteelPlate(ctx, x0, y0, pw, ph);
    if (state.showField) {
      if (opts.fieldAlpha != null) {
        ctx.save(); ctx.globalAlpha = Math.max(0, opts.fieldAlpha);
        drawStressField(ctx, x0, y0, pw, ph, px_per_mm); ctx.restore();
      } else {
        drawStressField(ctx, x0, y0, pw, ph, px_per_mm);
      }
    }
    drawStressArrows(ctx, x0, y0, pw, ph);
    if (!opts.minimal) {
      drawCrack(ctx, x0, y0, pw, ph, px_per_mm);
      if (state.showPzone) drawPlasticZone(ctx, x0, y0, pw, ph, px_per_mm);
      drawPropagationArrows(ctx, x0, y0, pw, ph, px_per_mm);
      if (state.showDim) drawDimensions(ctx, x0, y0, pw, ph);
    }
  }

  // Solid material plate — metal gradient body, chamfered bright edge, faint
  // brushed lines. Geometry (x0,y0,pw,ph) is untouched so every tip/label/dim
  // anchored to the plate rect stays valid.
  function drawSteelPlate(ctx, x0, y0, pw, ph) {
    var base = plateBase();
    ctx.save();
    // Body: vertical gradient, light from upper-left
    var g = ctx.createLinearGradient(x0, y0, x0, y0 + ph);
    g.addColorStop(0, shadeHex(base, 1.28));
    g.addColorStop(0.45, shadeHex(base, 1.02));
    g.addColorStop(1, shadeHex(base, 0.72));
    ctx.fillStyle = g;
    ctx.fillRect(x0, y0, pw, ph);
    // Subtle diagonal sheen band (rolled-metal highlight)
    var sh = ctx.createLinearGradient(x0, y0, x0 + pw, y0 + ph);
    sh.addColorStop(0, 'rgba(255,255,255,0)');
    sh.addColorStop(0.32, 'rgba(255,255,255,0.06)');
    sh.addColorStop(0.4, 'rgba(255,255,255,0.11)');
    sh.addColorStop(0.5, 'rgba(255,255,255,0)');
    ctx.fillStyle = sh; ctx.fillRect(x0, y0, pw, ph);
    // Faint brushed horizontal lines
    ctx.save();
    ctx.beginPath(); ctx.rect(x0, y0, pw, ph); ctx.clip();
    ctx.strokeStyle = 'rgba(255,255,255,0.035)'; ctx.lineWidth = 1;
    for (var yy = y0 + 6; yy < y0 + ph; yy += 7) {
      ctx.beginPath(); ctx.moveTo(x0, yy + 0.5); ctx.lineTo(x0 + pw, yy + 0.5); ctx.stroke();
    }
    ctx.restore();
    // Chamfered edges: bright top/left, dark bottom/right
    ctx.lineWidth = 2;
    ctx.strokeStyle = 'rgba(255,255,255,0.32)';
    ctx.beginPath(); ctx.moveTo(x0, y0 + ph); ctx.lineTo(x0, y0); ctx.lineTo(x0 + pw, y0); ctx.stroke();
    ctx.strokeStyle = 'rgba(0,0,0,0.40)';
    ctx.beginPath(); ctx.moveTo(x0 + pw, y0); ctx.lineTo(x0 + pw, y0 + ph); ctx.lineTo(x0, y0 + ph); ctx.stroke();
    // Crisp outline
    ctx.strokeStyle = shadeHex(base, 0.5); ctx.lineWidth = 1.2;
    ctx.strokeRect(x0 + 0.5, y0 + 0.5, pw - 1, ph - 1);
    ctx.restore();
  }

  // Serrated grip jaws clamping the top & bottom edges of the plate — the load
  // path made visible (tensile-coupon look). Drawn behind the plate body.
  function drawGrips(ctx, x0, y0, pw, ph) {
    var gw = pw + 26;             // grips a little wider than the plate
    var gx = x0 - 13;
    var gh = 16;                  // jaw thickness
    var bite = 8;                 // how far the jaw overlaps onto the plate
    [[y0 - gh + bite, 1], [y0 + ph - bite, -1]].forEach(function (j) {
      var jy = j[0];
      ctx.save();
      var g = ctx.createLinearGradient(0, jy, 0, jy + gh);
      g.addColorStop(0, '#3b414f'); g.addColorStop(0.5, '#20242e'); g.addColorStop(1, '#14171e');
      ctx.fillStyle = g;
      ctx.strokeStyle = '#0c0e13'; ctx.lineWidth = 1;
      roundRectPath(ctx, gx, jy, gw, gh, 3);
      ctx.fill(); ctx.stroke();
      // top highlight
      ctx.strokeStyle = 'rgba(255,255,255,0.14)'; ctx.lineWidth = 1;
      ctx.beginPath(); ctx.moveTo(gx + 3, jy + 1.5); ctx.lineTo(gx + gw - 3, jy + 1.5); ctx.stroke();
      // serrated teeth on the biting face (toward the plate)
      var teethY = (j[1] > 0) ? jy + gh : jy;
      ctx.fillStyle = 'rgba(0,0,0,0.55)';
      for (var tx = gx + 8; tx < gx + gw - 6; tx += 9) {
        ctx.beginPath();
        ctx.moveTo(tx, teethY);
        ctx.lineTo(tx + 4.5, teethY - j[1] * 4);
        ctx.lineTo(tx + 9, teethY);
        ctx.closePath(); ctx.fill();
      }
      ctx.restore();
    });
  }

  function roundRectPath(ctx, x, y, w, h, r) {
    r = Math.min(r, w / 2, h / 2);
    ctx.beginPath();
    ctx.moveTo(x + r, y);
    ctx.arcTo(x + w, y, x + w, y + h, r);
    ctx.arcTo(x + w, y + h, x, y + h, r);
    ctx.arcTo(x, y + h, x, y, r);
    ctx.arcTo(x, y, x + w, y, r);
    ctx.closePath();
  }

  // ── Catastrophic fracture: crack runs suddenly along its own plane, then the
  //    specimen fully separates into two halves pulled apart by the grips. ──
  function easeOutCubic(t) { return 1 - Math.pow(1 - t, 3); }
  function clamp01(t) { return t < 0 ? 0 : (t > 1 ? 1 : t); }
  // Deterministic fracture-surface roughness (jag) along the split line.
  function jagAt(u) {
    return (Math.sin(u * 0.13) + Math.cos(u * 0.31 + 1.1) * 0.7 + Math.sin(u * 0.77 + 2.3) * 0.42) * 3.6;
  }

  function drawFracture(ctx, x0, y0, pw, ph, px_per_mm) {
    var t = state.fractureAnim;
    var horizontal = (state.geo !== 'surface');
    var midX = x0 + pw / 2, midY = y0 + ph / 2;
    // Phase A: the crack RUNS along its plane to the plate edges (sudden, ~0.18).
    var run = easeOutCubic(clamp01(t / 0.18));
    // Phase B: the two halves SEPARATE, pulled apart along the load direction.
    var sepRaw = clamp01((t - 0.18) / 0.82);
    var maxSep = horizontal ? Math.min(ph * 0.34, 82) : Math.min(pw * 0.26, 92);
    var sep = easeOutCubic(sepRaw) * maxSep;

    if (sep < 1) {
      // Still one piece: intact specimen + the fracture racing along the line.
      paintSpecimen(ctx, x0, y0, pw, ph, px_per_mm, null);
      drawRunningCrack(ctx, x0, y0, pw, ph, px_per_mm, run, horizontal, midX, midY);
    } else {
      drawSeparatedHalves(ctx, x0, y0, pw, ph, px_per_mm, sep, sepRaw, horizontal, midX, midY);
    }
  }

  // The fracture front sweeping along the crack plane during the run phase.
  function drawRunningCrack(ctx, x0, y0, pw, ph, px_per_mm, run, horizontal, midX, midY) {
    // spans (along the propagation axis) that are cracked at this instant
    var spans = [], fronts = [];
    if (horizontal) {
      var L = x0, R = x0 + pw;
      if (state.geo === 'center') {
        var a = state.a * px_per_mm;
        var xa = midX - a - run * (midX - a - L), xb = midX + a + run * (R - (midX + a));
        spans.push([xa, xb]); fronts.push([xa, midY], [xb, midY]);
      } else if (state.geo === 'dedge') {
        var s1 = L + run * (midX - L), s2 = R - run * (R - midX);
        spans.push([L, s1], [s2, R]); fronts.push([s1, midY], [s2, midY]);
      } else { // edge (or any single-edge) — races across from the cracked edge
        var xr = L + run * pw; spans.push([L, xr]); fronts.push([xr, midY]);
      }
    } else { // surface — runs down from the tip to the far edge
      var tip = getCrackTips(x0, y0, pw, ph, px_per_mm)[0] || { x: midX, y: y0 };
      var yb = tip.y + run * (y0 + ph - tip.y);
      spans.push([tip.y, yb]); fronts.push([midX, yb]);
    }

    ctx.save();
    ctx.lineCap = 'round'; ctx.lineJoin = 'round';
    spans.forEach(function (sp) {
      var A = Math.min(sp[0], sp[1]), B = Math.max(sp[0], sp[1]);
      if (B - A < 0.5) return;
      ctx.beginPath();
      var step = 5, u;
      if (horizontal) {
        ctx.moveTo(A, midY + jagAt(A));
        for (u = A + step; u <= B; u += step) ctx.lineTo(u, midY + jagAt(u));
        ctx.lineTo(B, midY + jagAt(B));
      } else {
        ctx.moveTo(midX + jagAt(A), A);
        for (u = A + step; u <= B; u += step) ctx.lineTo(midX + jagAt(u), u);
        ctx.lineTo(midX + jagAt(B), B);
      }
      // dark open crack with a hot glow
      ctx.shadowColor = 'rgba(255,150,50,0.95)'; ctx.shadowBlur = 16;
      ctx.strokeStyle = '#05070b'; ctx.lineWidth = 4.5; ctx.stroke();
      ctx.strokeStyle = 'rgba(255,190,70,0.9)'; ctx.lineWidth = 2; ctx.shadowBlur = 22; ctx.stroke();
    });
    // bright hot fronts at the advancing crack tips
    fronts.forEach(function (f) {
      var g = ctx.createRadialGradient(f[0], f[1], 0, f[0], f[1], 20);
      g.addColorStop(0, 'rgba(255,255,235,0.95)');
      g.addColorStop(0.4, 'rgba(255,200,80,0.7)');
      g.addColorStop(1, 'rgba(255,120,40,0)');
      ctx.fillStyle = g; ctx.beginPath(); ctx.arc(f[0], f[1], 20, 0, Math.PI * 2); ctx.fill();
    });
    ctx.restore();
  }

  // Clip to one side of the jagged fracture line, then draw that half.
  function clipHalf(ctx, side, horizontal, mid) {
    var LO = -400, HIP = MAIN_W + 400, VLO = -400, VHI = MAIN_H + 400, u;
    ctx.beginPath();
    if (horizontal) {
      // side +1 = above the line, -1 = below
      if (side > 0) {
        ctx.moveTo(LO, VLO); ctx.lineTo(HIP, VLO); ctx.lineTo(HIP, mid + jagAt(HIP));
        for (u = HIP; u >= LO; u -= 6) ctx.lineTo(u, mid + jagAt(u));
      } else {
        ctx.moveTo(LO, VHI); ctx.lineTo(HIP, VHI); ctx.lineTo(HIP, mid + jagAt(HIP));
        for (u = HIP; u >= LO; u -= 6) ctx.lineTo(u, mid + jagAt(u));
      }
    } else {
      // side +1 = left of the line, -1 = right
      if (side > 0) {
        ctx.moveTo(LO, VLO); ctx.lineTo(LO, VHI); ctx.lineTo(mid + jagAt(VHI), VHI);
        for (u = VHI; u >= VLO; u -= 6) ctx.lineTo(mid + jagAt(u), u);
      } else {
        ctx.moveTo(HIP, VLO); ctx.lineTo(HIP, VHI); ctx.lineTo(mid + jagAt(VHI), VHI);
        for (u = VHI; u >= VLO; u -= 6) ctx.lineTo(mid + jagAt(u), u);
      }
    }
    ctx.closePath(); ctx.clip();
  }

  // Hot, cooling fracture face drawn along the jagged mating surface.
  function drawHotFace(ctx, x0, y0, pw, ph, horizontal, mid, sepRaw) {
    var cool = clamp01(Math.pow(sepRaw, 1.4));
    // hot → cool colour as the surfaces separate
    var r = Math.round(255 - 40 * cool), g = Math.round(190 - 150 * cool), b = Math.round(90 - 80 * cool);
    var a = 0.95 - 0.7 * cool;
    ctx.save();
    ctx.lineCap = 'round'; ctx.lineJoin = 'round';
    ctx.strokeStyle = 'rgba(' + r + ',' + g + ',' + b + ',' + a.toFixed(3) + ')';
    ctx.lineWidth = 2.4;
    ctx.shadowColor = 'rgba(255,140,50,' + (0.85 * (1 - cool)).toFixed(3) + ')';
    ctx.shadowBlur = 18 * (1 - cool) + 3;
    ctx.beginPath();
    var u, A, B;
    if (horizontal) {
      A = x0 - 30; B = x0 + pw + 30;
      ctx.moveTo(A, mid + jagAt(A));
      for (u = A; u <= B; u += 5) ctx.lineTo(u, mid + jagAt(u));
    } else {
      A = y0 - 30; B = y0 + ph + 30;
      ctx.moveTo(mid + jagAt(A), A);
      for (u = A; u <= B; u += 5) ctx.lineTo(mid + jagAt(u), u);
    }
    ctx.stroke();
    ctx.restore();
  }

  function drawSeparatedHalves(ctx, x0, y0, pw, ph, px_per_mm, sep, sepRaw, horizontal, midX, midY) {
    var mid = horizontal ? midY : midX;
    var drift = sep * 0.08;            // slight lateral fling for realism
    var fieldAlpha = 1 - clamp01(sepRaw * 1.15);   // stored energy released
    var opts = { minimal: true, fieldAlpha: fieldAlpha };
    var halves = horizontal
      ? [{ tx: drift, ty: -sep, side: 1 }, { tx: -drift, ty: sep, side: -1 }]
      : [{ tx: -sep, ty: drift, side: 1 }, { tx: sep, ty: -drift, side: -1 }];
    halves.forEach(function (h) {
      ctx.save();
      ctx.translate(h.tx, h.ty);
      clipHalf(ctx, h.side, horizontal, mid);
      paintSpecimen(ctx, x0, y0, pw, ph, px_per_mm, opts);
      drawHotFace(ctx, x0, y0, pw, ph, horizontal, mid, sepRaw);
      ctx.restore();
    });
  }

  function drawStressArrows(ctx, x0, y0, pw, ph) {
    // External tensile load — Mode I: arrows point AWAY from the body
    // (top arrowheads point up, bottom arrowheads point down) so the body is being PULLED APART
    var nArrows = 7;
    var spacing = pw / (nArrows + 1);
    var gTop = y0 - 8;            // top grip outer face
    var gBot = y0 + ph + 8;      // bottom grip outer face
    ctx.save();
    ctx.strokeStyle = '#ff8a5c'; ctx.fillStyle = '#ff8a5c'; ctx.lineWidth = 2.4;
    ctx.lineCap = 'round';
    ctx.shadowColor = 'rgba(255,110,64,0.5)'; ctx.shadowBlur = 4;
    for (var i = 1; i <= nArrows; i++) {
      var x = x0 + i * spacing;
      // ── Top: shaft from grip outward, arrowhead apex pointing UP (away) ──
      ctx.beginPath(); ctx.moveTo(x, gTop - 2); ctx.lineTo(x, gTop - 22); ctx.stroke();
      ctx.beginPath();
      ctx.moveTo(x - 5, gTop - 22); ctx.lineTo(x, gTop - 32); ctx.lineTo(x + 5, gTop - 22);
      ctx.closePath(); ctx.fill();
      // ── Bottom: shaft from grip outward, arrowhead apex pointing DOWN (away) ──
      ctx.beginPath(); ctx.moveTo(x, gBot + 2); ctx.lineTo(x, gBot + 22); ctx.stroke();
      ctx.beginPath();
      ctx.moveTo(x - 5, gBot + 22); ctx.lineTo(x, gBot + 32); ctx.lineTo(x + 5, gBot + 22);
      ctx.closePath(); ctx.fill();
    }
    ctx.restore();
    // sigma label — clearly identify as external applied load
    ctx.fillStyle = '#dde3f0'; ctx.font = '600 12px "Courier New", monospace';
    var sigDisp = (state.analysis === 'static' ? state.sigma : state.dSigma);
    var sigLabel = (state.analysis === 'static' ? 'σ (applied) = ' : 'Δσ (applied) = ') + fmt(dispSig(sigDisp), 1) + ' ' + uSig();
    ctx.textAlign = 'left';
    ctx.fillText(sigLabel, x0 + 8, gTop - 40);
    // Mode marker
    ctx.fillStyle = '#6b7a99'; ctx.font = '600 10px "Segoe UI", system-ui';
    ctx.fillText('External tensile load — Mode I (opening)', x0 + 8, gBot + 46);
  }

  // Cached offscreen field bitmap — recomputed only when an input that shapes
  // the field changes. putImageData ignores the ctx transform, so the field is
  // rendered into its own canvas at native pixels and drawImage'd (which DOES
  // respect the DPR transform) into the plate rect.
  var _fieldCv = null, _fieldKey = '';
  function buildFieldCanvas(pw, ph, px_per_mm) {
    var fw = Math.max(1, Math.floor(pw)), fh = Math.max(1, Math.floor(ph));
    var sigma = (state.analysis === 'static' ? state.sigma : state.dSigma);
    // Key on BOTH stress values: the field's normalization uses the mode-selected
    // `sigma`, but the near-tip bloom comes from computeKI() which reads state.sigma
    // unconditionally — including both makes the cache impossible to leave stale.
    var key = [state.geo, state.a.toFixed(4), state.sigma.toFixed(3), state.dSigma.toFixed(3),
               state.W, state.mat, fw, fh, state.analysis].join('|');
    if (_fieldCv && _fieldKey === key) return _fieldCv;

    var off = _fieldCv || document.createElement('canvas');
    off.width = fw; off.height = fh;
    var octx = off.getContext('2d');
    var img = octx.createImageData(fw, fh);
    var data = img.data;
    // tips in field-local coordinates (origin at plate top-left)
    var tips = getCrackTips(0, 0, pw, ph, px_per_mm);
    var maxStress = Math.max(sigma * 3, 50);
    for (var py = 0; py < fh; py++) {
      for (var px = 0; px < fw; px++) {
        var stress = computeFieldStress(px, py, sigma, tips, px_per_mm);
        var t = Math.min(1, Math.max(0, (stress - sigma * 0.45) / maxStress));
        var rgb = colorRamp(t);
        // Alpha ∝ stress, steeply: the far field is a faint tint so the steel
        // reads through it, and the crack-tip singularity blooms opaque-hot —
        // the stress CONCENTRATION (the lesson) becomes the dominant visual.
        var alpha = Math.min(255, 10 + 245 * Math.pow(t, 1.5));
        var idx = (py * fw + px) * 4;
        data[idx] = rgb[0]; data[idx + 1] = rgb[1]; data[idx + 2] = rgb[2];
        data[idx + 3] = alpha | 0;
      }
    }
    octx.putImageData(img, 0, 0);
    _fieldCv = off; _fieldKey = key;
    return off;
  }

  function drawStressField(ctx, x0, y0, pw, ph, px_per_mm) {
    var fc = buildFieldCanvas(pw, ph, px_per_mm);
    ctx.save();
    ctx.beginPath(); ctx.rect(x0, y0, pw, ph); ctx.clip();
    ctx.imageSmoothingEnabled = true;
    ctx.drawImage(fc, x0, y0, pw, ph);
    ctx.restore();
  }

  function getCrackTips(x0, y0, pw, ph, px_per_mm) {
    var midY = y0 + ph / 2;
    var midX = x0 + pw / 2;
    var a_px = state.a * px_per_mm;
    var W_px = state.W * px_per_mm;
    if (state.geo === 'center') {
      return [{ x: midX - a_px, y: midY }, { x: midX + a_px, y: midY }];
    }
    if (state.geo === 'edge') {
      return [{ x: x0 + a_px, y: midY }];
    }
    if (state.geo === 'dedge') {
      return [{ x: x0 + a_px, y: midY }, { x: x0 + pw - a_px, y: midY }];
    }
    if (state.geo === 'surface') {
      // semi-elliptical surface crack on top surface, centred. show as a half-ellipse, tip at depth a
      return [{ x: midX, y: y0 + a_px }];
    }
    return [];
  }

  function computeFieldStress(x, y, sigma, tips, px_per_mm) {
    // Near-tip K-field: sigma_yy ~ K / sqrt(2*pi*r) * cos(theta/2) * (1 + sin(theta/2)*sin(3*theta/2))
    // Use simplified for visualization. r in mm.
    var KI = computeKI();
    if (KI <= 0) return sigma;
    var maxField = sigma;
    for (var i = 0; i < tips.length; i++) {
      var dx_px = x - tips[i].x;
      var dy_px = y - tips[i].y;
      var r_mm = Math.sqrt(dx_px * dx_px + dy_px * dy_px) / px_per_mm;
      if (r_mm < 0.2) r_mm = 0.2; // avoid singularity
      var r_m = r_mm / 1000;
      var theta = Math.atan2(dy_px, dx_px);
      // For centre/edge crack, theta=0 is along crack line. We want stress on plane perpendicular to load
      // sigma_yy = K/sqrt(2*pi*r) * cos(theta/2) * (1 + sin(theta/2)*sin(3*theta/2))
      var ct = Math.cos(theta / 2);
      var st = Math.sin(theta / 2);
      var s3 = Math.sin(3 * theta / 2);
      var nearTip = (KI / Math.sqrt(2 * Math.PI * r_m)) * ct * (1 + st * s3);
      // Add to far-field sigma (linear superposition limit)
      var contrib = sigma + nearTip;
      if (contrib > maxField) maxField = contrib;
    }
    return maxField;
  }

  // Elliptical crack-opening profile: half-width `mouthHalf` at the mouth,
  // tapering to a sharp point at the tip. Honest scale — tiny cracks read tiny;
  // the hot tip marker carries locatability.
  function crackOpeningPath(ctx, mouthX, mouthY, tipX, tipY, mouthHalf, horizontal) {
    var N = 22, i, f, o, x, y;
    ctx.beginPath();
    for (i = 0; i <= N; i++) {
      f = i / N; o = mouthHalf * Math.sqrt(Math.max(0, 1 - f * f));
      x = mouthX + (tipX - mouthX) * f; y = mouthY + (tipY - mouthY) * f;
      if (horizontal) { if (i === 0) ctx.moveTo(x, y - o); else ctx.lineTo(x, y - o); }
      else { if (i === 0) ctx.moveTo(x - o, y); else ctx.lineTo(x - o, y); }
    }
    for (i = N; i >= 0; i--) {
      f = i / N; o = mouthHalf * Math.sqrt(Math.max(0, 1 - f * f));
      x = mouthX + (tipX - mouthX) * f; y = mouthY + (tipY - mouthY) * f;
      if (horizontal) ctx.lineTo(x, y + o); else ctx.lineTo(x + o, y);
    }
    ctx.closePath();
  }

  function fillCrackSeg(ctx, mouthX, mouthY, tipX, tipY, mouthHalf, horizontal) {
    ctx.save();
    // dark open crack, faint fresh-fracture bright edge
    crackOpeningPath(ctx, mouthX, mouthY, tipX, tipY, mouthHalf, horizontal);
    ctx.shadowColor = 'rgba(0,0,0,0.6)'; ctx.shadowBlur = 5;
    ctx.fillStyle = '#05070b'; ctx.fill();
    ctx.shadowBlur = 0;
    ctx.lineWidth = 1; ctx.strokeStyle = 'rgba(220,232,255,0.30)'; ctx.stroke();
    ctx.restore();
  }

  function drawCrack(ctx, x0, y0, pw, ph, px_per_mm) {
    var midY = y0 + ph / 2;
    var midX = x0 + pw / 2;
    var a_px = state.a * px_per_mm;
    var mouthHalf = Math.max(1.3, Math.min(a_px * 0.16, 8));

    if (state.geo === 'center') {
      fillCrackSeg(ctx, midX, midY, midX + a_px, midY, mouthHalf, true);
      fillCrackSeg(ctx, midX, midY, midX - a_px, midY, mouthHalf, true);
      drawTipGlow(ctx, midX - a_px, midY);
      drawTipGlow(ctx, midX + a_px, midY);
    } else if (state.geo === 'edge') {
      fillCrackSeg(ctx, x0, midY, x0 + a_px, midY, mouthHalf, true);
      drawTipGlow(ctx, x0 + a_px, midY);
    } else if (state.geo === 'dedge') {
      fillCrackSeg(ctx, x0, midY, x0 + a_px, midY, mouthHalf, true);
      fillCrackSeg(ctx, x0 + pw, midY, x0 + pw - a_px, midY, mouthHalf, true);
      drawTipGlow(ctx, x0 + a_px, midY);
      drawTipGlow(ctx, x0 + pw - a_px, midY);
    } else if (state.geo === 'surface') {
      // semi-elliptical surface flaw: opens at the top surface, extends DOWN into
      // the material to depth a (half-width ≈ 2.5a). Clipped to the plate so the
      // flaw stays inside the specimen; the mouth sits on the surface.
      var aDepth = a_px;
      var cHalf = Math.min(Math.max(2, a_px / 0.4), pw * 0.45);
      ctx.save();
      ctx.beginPath(); ctx.rect(x0, y0, pw, ph); ctx.clip();
      ctx.beginPath();
      ctx.ellipse(midX, y0, cHalf, aDepth, 0, 0, Math.PI);   // lower semi-ellipse
      ctx.closePath();
      ctx.shadowColor = 'rgba(0,0,0,0.6)'; ctx.shadowBlur = 5;
      ctx.fillStyle = '#05070b'; ctx.fill();
      ctx.shadowBlur = 0;
      ctx.lineWidth = 1; ctx.strokeStyle = 'rgba(220,232,255,0.30)'; ctx.stroke();
      ctx.restore();
      drawTipGlow(ctx, midX, y0 + aDepth);
    }
  }

  function drawTipGlow(ctx, x, y) {
    var pulse = 1;
    if (state.analysis === 'paris' && state.parisRunning) pulse = 0.8 + 0.2 * Math.sin(Date.now() / 140);
    ctx.save();
    // Outer soft halo — marks the stress-concentration focus at the tip
    var Ro = 30 * pulse;
    var halo = ctx.createRadialGradient(x, y, 2, x, y, Ro);
    halo.addColorStop(0, 'rgba(255,150,50,0.42)');
    halo.addColorStop(0.5, 'rgba(255,110,40,0.16)');
    halo.addColorStop(1, 'rgba(255,110,40,0)');
    ctx.fillStyle = halo;
    ctx.beginPath(); ctx.arc(x, y, Ro, 0, Math.PI * 2); ctx.fill();
    // Inner hot core
    var Ri = 12 * pulse;
    var core = ctx.createRadialGradient(x, y, 0, x, y, Ri);
    core.addColorStop(0, 'rgba(255,255,238,0.98)');
    core.addColorStop(0.32, 'rgba(255,210,80,0.85)');
    core.addColorStop(0.7, 'rgba(255,120,45,0.45)');
    core.addColorStop(1, 'rgba(255,120,45,0)');
    ctx.fillStyle = core;
    ctx.beginPath(); ctx.arc(x, y, Ri, 0, Math.PI * 2); ctx.fill();
    ctx.restore();
  }

  function drawPlasticZone(ctx, x0, y0, pw, ph, px_per_mm) {
    var m = getMaterial();
    var KI = computeKI();
    var rp_mm = plasticZoneMm(KI, m.sy);
    var rp_px = rp_mm * px_per_mm;
    if (rp_px < 1.5) return;
    var tips = getCrackTips(x0, y0, pw, ph, px_per_mm);
    ctx.save();
    ctx.strokeStyle = 'rgba(245,200,66,0.9)';
    ctx.fillStyle = 'rgba(245,200,66,0.18)';
    ctx.lineWidth = 1.5;
    ctx.setLineDash([4, 3]);
    for (var i = 0; i < tips.length; i++) {
      var t = tips[i];
      ctx.beginPath(); ctx.arc(t.x, t.y, Math.min(rp_px, 60), 0, Math.PI * 2);
      ctx.fill(); ctx.stroke();
    }
    ctx.restore();
  }

  function drawDimensions(ctx, x0, y0, pw, ph) {
    ctx.save();
    ctx.fillStyle = '#dde3f0';
    ctx.strokeStyle = '#6b7a99';
    ctx.lineWidth = 1;
    ctx.font = '600 11px "Courier New", monospace';

    // W dimension (above plate)
    var yDim = y0 - 50;
    ctx.beginPath();
    ctx.moveTo(x0, yDim); ctx.lineTo(x0 + pw, yDim);
    ctx.moveTo(x0, yDim - 4); ctx.lineTo(x0, yDim + 4);
    ctx.moveTo(x0 + pw, yDim - 4); ctx.lineTo(x0 + pw, yDim + 4);
    ctx.stroke();
    ctx.textAlign = 'center';
    ctx.fillText('W = ' + fmt(dispLen(state.W), state.unit === 'si' ? 0 : 2) + ' ' + uLen(), x0 + pw / 2, yDim - 6);

    // a dimension (small arrow near crack)
    var midY = y0 + ph / 2;
    var midX = x0 + pw / 2;
    var px_per_mm = pw / state.W;
    var a_px = state.a * px_per_mm;
    var ay = midY - 18;
    if (state.geo === 'center') {
      ctx.beginPath();
      ctx.moveTo(midX, ay); ctx.lineTo(midX + a_px, ay);
      ctx.stroke();
      ctx.fillText('a = ' + fmt(dispLen(state.a), state.unit === 'si' ? 2 : 3) + ' ' + uLen(),
        midX + a_px / 2, ay - 4);
    } else if (state.geo === 'edge') {
      ctx.beginPath();
      ctx.moveTo(x0, ay); ctx.lineTo(x0 + a_px, ay);
      ctx.stroke();
      ctx.fillText('a = ' + fmt(dispLen(state.a), state.unit === 'si' ? 2 : 3) + ' ' + uLen(),
        x0 + a_px / 2, ay - 4);
    } else if (state.geo === 'dedge') {
      ctx.beginPath();
      ctx.moveTo(x0, ay); ctx.lineTo(x0 + a_px, ay);
      ctx.moveTo(x0 + pw, ay); ctx.lineTo(x0 + pw - a_px, ay);
      ctx.stroke();
      ctx.fillText('a', x0 + a_px / 2, ay - 4);
      ctx.fillText('a', x0 + pw - a_px / 2, ay - 4);
    } else if (state.geo === 'surface') {
      // depth indicator on the left side of crack
      ctx.beginPath();
      ctx.moveTo(midX - 60, y0); ctx.lineTo(midX - 60, y0 + a_px);
      ctx.stroke();
      ctx.textAlign = 'right';
      ctx.fillText('a', midX - 64, y0 + a_px / 2);
      ctx.textAlign = 'center';
    }
    ctx.restore();
  }

  function drawEqnOverlay(ctx, W, H) {
    ctx.save();
    var KI = computeKI();
    var m = getMaterial();
    var ratio = KI / m.KIC;
    var col = ratio < 0.7 ? '#3ddc84' : (ratio < 1 ? '#f5c842' : '#ff5555');
    ctx.font = '700 14px "Courier New", monospace';
    ctx.textAlign = 'left'; ctx.textBaseline = 'top';
    // halo
    ctx.fillStyle = 'rgba(13,17,23,0.75)';
    ctx.fillRect(10, H - 56, 320, 46);
    // K_I value (stress-field intensity AT the crack tip)
    ctx.fillStyle = col;
    ctx.fillText('K_I (tip) = ' + fmt(dispK(KI), 2) + ' ' + uK(), 16, H - 50);
    // Legend: distinguish field from load
    ctx.fillStyle = '#dde3f0'; ctx.font = '600 10px "Segoe UI", system-ui';
    ctx.fillText('▮ colour = σ_yy field developed in body (r⁻¹ᐟ² singularity)', 16, H - 28);
    ctx.fillText('▲ arrows = external applied tensile load', 16, H - 16);
  }

  // Small arrow at each crack tip showing the direction the crack PROPAGATES
  function drawPropagationArrows(ctx, x0, y0, pw, ph, px_per_mm) {
    if (state.analysis !== 'paris' || !state.parisRunning) return;
    var tips = getCrackTips(x0, y0, pw, ph, px_per_mm);
    var midX = x0 + pw / 2;
    var midY = y0 + ph / 2;
    ctx.save();
    ctx.fillStyle = '#3ddc84'; ctx.strokeStyle = '#3ddc84'; ctx.lineWidth = 2;
    ctx.shadowColor = 'rgba(61,220,132,0.9)'; ctx.shadowBlur = 8;
    var pulse = 0.6 + 0.4 * Math.sin(Date.now() / 180);
    ctx.globalAlpha = pulse;
    tips.forEach(function (t, idx) {
      // Propagation direction depends on geometry:
      //  • centre crack    — tips at midX ± a; grow AWAY from centre (outward)
      //  • edge crack      — tip at x0 + a; grows INTO the plate (rightward)
      //  • double-edge     — tips at x0+a and x0+pw−a; grow toward EACH OTHER (toward centre)
      //  • surface crack   — tip at depth a from top; grows DOWNWARD into thickness
      var dx = 0, dy = 0;
      if (state.geo === 'surface') {
        dx = 0; dy = 1;
      } else if (state.geo === 'edge') {
        dx = 1; dy = 0;       // always into the plate (rightward, since edge crack starts at left edge)
      } else if (state.geo === 'dedge') {
        // tips[0] = left tip (grows right), tips[1] = right tip (grows left)
        dx = (idx === 0) ? 1 : -1; dy = 0;
      } else { // 'center'
        dx = (t.x < midX) ? -1 : 1; dy = 0;
      }
      var sx = t.x + dx * 12, sy = t.y + dy * 12;
      var ex = t.x + dx * 32, ey = t.y + dy * 32;
      // Shaft
      ctx.beginPath(); ctx.moveTo(sx, sy); ctx.lineTo(ex, ey); ctx.stroke();
      // Arrowhead
      var pxAx = -dy, pxAy = dx; // perpendicular
      ctx.beginPath();
      ctx.moveTo(ex + dx * 6, ey + dy * 6);
      ctx.lineTo(ex - dx * 3 + pxAx * 5, ey - dy * 3 + pxAy * 5);
      ctx.lineTo(ex - dx * 3 - pxAx * 5, ey - dy * 3 - pxAy * 5);
      ctx.closePath(); ctx.fill();
    });
    ctx.globalAlpha = 1;
    ctx.restore();
  }

  function drawFractureBadge(ctx, W, H) {
    ctx.save();
    var t = Date.now() / 200;
    var alpha = 0.7 + 0.3 * Math.sin(t);
    ctx.fillStyle = 'rgba(255,85,85,' + alpha.toFixed(2) + ')';
    ctx.fillRect(W - 170, 14, 156, 30);
    ctx.fillStyle = '#fff';
    ctx.font = '900 14px "Segoe UI", system-ui, sans-serif';
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    ctx.fillText('⚠ FRACTURE: K_I ≥ K_IC', W - 92, 29);
    ctx.restore();
    if (state.analysis === 'static') requestAnimationFrame(function(){ drawMain(); });
  }

  // ── Chart canvas (K_I vs a) ─────────────────────────────────
  function drawChart() {
    var cv = chartCv, ctx = chartCtx; if (!ctx) return;
    var W = CHART_W, H = CHART_H;
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = '#0d1117'; ctx.fillRect(0, 0, W, H);

    var pad = { l: 60, r: 30, t: 24, b: 40 };
    var plotW = W - pad.l - pad.r;
    var plotH = H - pad.t - pad.b;

    var m = getMaterial();
    var sigmaUsed = (state.analysis === 'static' ? state.sigma : state.dSigma);
    var aMax = state.W * 0.45;
    var KIC = m.KIC;
    // sample K vs a curve
    var n = 80;
    var pts = [];
    var maxK = KIC * 1.6;
    for (var i = 0; i <= n; i++) {
      var a_mm = (i / n) * aMax;
      if (a_mm < 0.3) a_mm = 0.3;
      var k = computeKIfor(a_mm, sigmaUsed);
      pts.push({ a: a_mm, k: k });
      if (k > maxK) maxK = k;
    }
    maxK = Math.min(maxK, KIC * 3);

    function X(a) { return pad.l + (a / aMax) * plotW; }
    function Y(k) { return pad.t + plotH - (k / maxK) * plotH; }

    // Grid
    ctx.strokeStyle = '#2a3050'; ctx.lineWidth = 1; ctx.font = '11px "Courier New", monospace';
    ctx.fillStyle = '#6b7a99'; ctx.textAlign = 'right'; ctx.textBaseline = 'middle';
    for (var gi = 0; gi <= 5; gi++) {
      var ky = (gi / 5) * maxK;
      var py = Y(ky);
      ctx.beginPath(); ctx.moveTo(pad.l, py); ctx.lineTo(W - pad.r, py); ctx.stroke();
      ctx.fillText(fmt(dispK(ky), 1), pad.l - 6, py);
    }
    ctx.textAlign = 'center'; ctx.textBaseline = 'top';
    for (var xi = 0; xi <= 5; xi++) {
      var ax = (xi / 5) * aMax;
      var px = X(ax);
      ctx.beginPath(); ctx.moveTo(px, pad.t); ctx.lineTo(px, pad.t + plotH); ctx.stroke();
      ctx.fillText(fmt(dispLen(ax), 1), px, pad.t + plotH + 6);
    }

    // Axis labels
    ctx.fillStyle = '#dde3f0'; ctx.font = '600 12px "Segoe UI", system-ui, sans-serif';
    ctx.textAlign = 'center';
    ctx.fillText('Crack length a (' + uLen() + ')', pad.l + plotW / 2, H - 6);
    ctx.save();
    ctx.translate(14, pad.t + plotH / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.fillText('Stress Intensity K_I (' + uK() + ')', 0, 0);
    ctx.restore();

    // K_IC horizontal line
    var yKIC = Y(KIC);
    ctx.strokeStyle = '#ff5555'; ctx.lineWidth = 2; ctx.setLineDash([6, 4]);
    ctx.beginPath(); ctx.moveTo(pad.l, yKIC); ctx.lineTo(W - pad.r, yKIC); ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = '#ff5555'; ctx.font = '700 11px "Courier New", monospace';
    ctx.textAlign = 'right';
    ctx.fillText('K_IC = ' + fmt(dispK(KIC), 1), W - pad.r - 6, yKIC - 6);

    // K curve
    ctx.strokeStyle = '#ff6e40'; ctx.lineWidth = 2.5; ctx.shadowColor = 'rgba(255,110,64,0.5)'; ctx.shadowBlur = 6;
    ctx.beginPath();
    for (var j = 0; j < pts.length; j++) {
      var X2 = X(pts[j].a), Y2 = Y(pts[j].k);
      if (j === 0) ctx.moveTo(X2, Y2); else ctx.lineTo(X2, Y2);
    }
    ctx.stroke();
    ctx.shadowBlur = 0;

    // Critical a marker
    var ac = computeAc(KIC, sigmaUsed);
    if (ac > 0 && ac < aMax) {
      var xAc = X(ac);
      ctx.strokeStyle = '#f5c842'; ctx.setLineDash([3, 3]); ctx.lineWidth = 1.5;
      ctx.beginPath(); ctx.moveTo(xAc, pad.t); ctx.lineTo(xAc, pad.t + plotH); ctx.stroke();
      ctx.setLineDash([]);
      ctx.fillStyle = '#f5c842';
      ctx.beginPath(); ctx.arc(xAc, yKIC, 5, 0, Math.PI * 2); ctx.fill();
      ctx.textAlign = 'left'; ctx.font = '700 11px "Courier New", monospace';
      ctx.fillText('a_c = ' + fmt(dispLen(ac), 1) + ' ' + uLen(), xAc + 8, pad.t + 12);
    }

    // Current state point
    var aNow = (state.analysis === 'paris' && state.parisRunning) ? state.parisA : state.a;
    var kNow = computeKIfor(aNow, sigmaUsed);
    var px2 = X(aNow), py2 = Y(Math.min(kNow, maxK));
    ctx.fillStyle = '#3ddc84';
    ctx.beginPath(); ctx.arc(px2, py2, 6, 0, Math.PI * 2); ctx.fill();
    ctx.strokeStyle = '#fff'; ctx.lineWidth = 1.5; ctx.stroke();
  }

  // ── Sparkline (a vs N) ──────────────────────────────────────
  function drawHistorySpark() {
    var cv = histCv, ctx = histCtx; if (!ctx) return;
    var W = HIST_W, H = HIST_H;
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = '#0d1117'; ctx.fillRect(0, 0, W, H);

    var pad = { l: 50, r: 14, t: 14, b: 26 };
    var pw = W - pad.l - pad.r, ph = H - pad.t - pad.b;

    var hist = state.parisHistory;
    if (hist.length < 2) {
      ctx.fillStyle = '#6b7a99'; ctx.font = '12px "Segoe UI", system-ui';
      ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.fillText('Run Paris-law animation to populate', W/2, H/2);
      return;
    }
    var Nmax = hist[hist.length - 1].N;
    var aMaxVal = hist[hist.length - 1].a;
    var aMaxScale = Math.max(aMaxVal, state.W * 0.45);

    function X(n) { return pad.l + (n / Nmax) * pw; }
    function Y(a) { return pad.t + ph - (a / aMaxScale) * ph; }

    ctx.strokeStyle = '#2a3050'; ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(pad.l, pad.t); ctx.lineTo(pad.l, pad.t + ph); ctx.lineTo(pad.l + pw, pad.t + ph);
    ctx.stroke();

    ctx.fillStyle = '#6b7a99'; ctx.font = '10px "Courier New", monospace';
    ctx.textAlign = 'right'; ctx.textBaseline = 'middle';
    ctx.fillText(fmt(dispLen(aMaxScale), 1) + ' ' + uLen(), pad.l - 4, pad.t);
    ctx.fillText('0', pad.l - 4, pad.t + ph);
    ctx.textAlign = 'center'; ctx.textBaseline = 'top';
    ctx.fillText('N = 0', pad.l, pad.t + ph + 4);
    ctx.fillText('N = ' + Math.round(Nmax).toLocaleString(), pad.l + pw, pad.t + ph + 4);

    // curve
    ctx.strokeStyle = '#ff6e40'; ctx.lineWidth = 2;
    ctx.beginPath();
    for (var i = 0; i < hist.length; i++) {
      var x = X(hist[i].N), y = Y(hist[i].a);
      if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
    }
    ctx.stroke();
    // endpoint
    var last = hist[hist.length - 1];
    ctx.fillStyle = '#3ddc84';
    ctx.beginPath(); ctx.arc(X(last.N), Y(last.a), 4, 0, Math.PI * 2); ctx.fill();
  }

