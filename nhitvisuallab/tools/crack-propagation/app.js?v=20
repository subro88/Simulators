  // ── State ────────────────────────────────────────────────────
  var state = {
    mode: 'simulate',
    analysis: 'static',       // 'static' | 'paris'
    geo: 'center',            // 'center' | 'edge' | 'dedge' | 'surface'
    matId: 'steel_4340',
    unit: 'si',
    // Geometry (all in SI: mm internally for geometry sliders, but converted to m for K)
    // Defaults chosen so the Aircraft-skin preset preloads on init and Play produces
    // visible propagation immediately.
    W: 100,                   // plate width, mm
    a: 0.5,                   // crack half-length (centre) or edge crack length, mm
    sigma: 140,               // applied stress, MPa
    // Paris specific
    dSigma: 140,              // stress range, MPa (above threshold for default material)
    Rratio: 0.1,              // R = sigma_min / sigma_max
    a0: 0.5,                  // initial crack, mm
    // UI
