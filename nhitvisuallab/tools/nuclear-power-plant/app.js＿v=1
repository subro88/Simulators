function setTourStep(stepIdx) {
  S.tourStep = Math.max(0, Math.min(TOUR_STOPS.length - 1, stepIdx));
  const stop = TOUR_STOPS[S.tourStep];
  
  // Smooth Camera Target
  S.targetZoom = stop.targetZoom;
  S.targetPanX = stop.targetPanX;
  S.targetPanY = stop.targetPanY;
  
  // Update Tour Card
  tourStepBadge.textContent = stop.badge;
  tourTitle.textContent = stop.title;
  tourText.textContent = stop.text;
  
  // Update step dots
  tourDots.forEach((dot, idx) => {
    dot.classList.toggle('active', idx === S.tourStep);
  });
  
  // Voice Narration
  if (S.voiceEnabled && 'speechSynthesis' in window) {
    window.speechSynthesis.cancel();
    const utterance = new SpeechSynthesisUtterance(stop.text);
    utterance.rate = 1.0;
    utterance.pitch = 1.0;
    window.speechSynthesis.speak(utterance);
  }
}

function nextTourStep() {
  if (S.tourStep < TOUR_STOPS.length - 1) {
    setTourStep(S.tourStep + 1);
  } else {
    setTourStep(0);
  }
}

function prevTourStep() {
  if (S.tourStep > 0) {
    setTourStep(S.tourStep - 1);
  } else {
    setTourStep(TOUR_STOPS.length - 1);
  }
}

/* ─────────────────────────────────────────────────────────────
   GRID DEMAND & REACTOR DYNAMICS
   ───────────────────────────────────────────────────────────── */
function updateSimulation(dt) {
  S.t += dt;
  
  // Day-Night progression
  const dayProgress = (S.t % S.daySeconds) / S.daySeconds;
  S.day = 1 + Math.floor(S.t / S.daySeconds);
  S.timeOfDay = dayProgress;
  
  const totalMinutes = Math.floor(dayProgress * 24 * 60);
  const hours24 = Math.floor(totalMinutes / 60);
  const mins = totalMinutes % 60;
  const hours12 = (hours24 % 12) || 12;
  const ampm = hours24 >= 12 ? 'PM' : 'AM';
  const minStr = mins < 10 ? `0${mins}` : `${mins}`;
  const icon = (hours24 >= 6 && hours24 < 19) ? '&#9728;' : '&#9790;';
  lcdDay.innerHTML = `${icon} DAY ${S.day}: ${hours12}:${minStr} ${ampm}`;
  
  // Demand Curve
  const p = dayProgress;
  const morning = Math.exp(-Math.pow((p - 0.38) / 0.12, 2));
  const evening = Math.exp(-Math.pow((p - 0.82) / 0.11, 2));
  const demandShape = 0.45 + 0.55 * Math.max(morning, evening);
  const scale = 1000 + 450 * demandShape + Math.sin(S.t * 0.4) * 25;
  S.demandMW = Math.round(scale);
  lcdDemand.textContent = `${S.demandMW} MW`;
  
  // Controls Smoothing
  S.rodActual += (S.rodTarget - S.rodActual) * Math.min(1, 2.0 * dt);
  S.steamActual += (S.steamTarget - S.steamActual) * Math.min(1, 2.5 * dt);
  const targetPump = S.pumpsOn ? 100 : 0;
  S.pumpSpeed += (targetPump - S.pumpSpeed) * Math.min(1, 1.8 * dt);
  
  // Kinetics
  const fissionPower = S.rodActual * 14.5;
  const coolantFactor = S.pumpSpeed / 100.0;
  const coolingRate = coolantFactor * 12.0;
  
  const targetTcore = 260 + (fissionPower * 0.12) - (coolingRate * 3.5);
  S.Tcore += (targetTcore - S.Tcore) * Math.min(1, 0.8 * dt);
  
  const heatTransferred = Math.max(0, (S.Tcore - 240) * 8.5 * coolantFactor);
  const steamExtracted = S.steamActual * 12.0;
  const targetPs = 20 + (heatTransferred - steamExtracted * 0.6) * 0.15;
  S.Ps += (targetPs - S.Ps) * Math.min(1, 1.2 * dt);
  
  const drive = Math.min(1.4, S.Ps / 50.0);
  const generatedMW = Math.round((S.steamActual / 100.0) * 1400 * drive);
  S.outputMW = Math.max(0, generatedMW);
  lcdOutput.textContent = `${S.outputMW} MW`;
  
  // Score & Ticker
  const err = S.outputMW - S.demandMW;
  const matchTolerance = S.demandMW * 0.08;
  
  if (Math.abs(err) <= matchTolerance) {
    S.score += Math.round(15 * dt);
    topTicker.textContent = 'OUTPUT MATCHES GRID DEMAND. SYSTEM OPTIMAL!';
    topTicker.style.color = '#00e676';
  } else if (err < 0) {
    const pen = Math.round(Math.abs(err) / 100);
    S.score -= Math.round(8 * dt);
    topTicker.textContent = `WARNING: ENERGY OUTPUT TOO LOW. PENALTY: ${pen} POINTS`;
    topTicker.style.color = '#ffd600';
  } else {
    topTicker.textContent = 'WARNING: ENERGY OUTPUT TOO HIGH. WASTING STEAM!';
    topTicker.style.color = '#ff3b30';
  }
  
  lcdScore.textContent = `SCORE: ${S.score >= 0 ? '+' : ''}${S.score} PT`;
  lcdScore.className = `lcd-val ${S.score >= 0 ? 'val-score' : 'val-demand'}`;
  
  S.TcoreGauge = Math.max(0, Math.min(1, (S.Tcore - 240) / 140.0));
  S.PsGauge = Math.max(0, Math.min(1, S.Ps / 90.0));
  
  // Virtual Tour Auto-Play Timer
  if (S.mode === 'tour' && S.tourPlaying) {
    S.tourTimer += dt;
    if (S.tourTimer >= 10.0) {
      S.tourTimer = 0;
      nextTourStep();
    }
  }
  
  // Smooth Camera Interpolation
  S.zoom += (S.targetZoom - S.zoom) * Math.min(1, 3.5 * dt);
  S.panX += (S.targetPanX - S.panX) * Math.min(1, 3.5 * dt);
  S.panY += (S.targetPanY - S.panY) * Math.min(1, 3.5 * dt);
  
  updateAudio();
}

/* ─────────────────────────────────────────────────────────────
   ANALOG DIAL GAUGES
   ───────────────────────────────────────────────────────────── */
function drawGauge(ctx, val) {
  ctx.clearRect(0, 0, 180, 120);
  const cx = 90, cy = 95, r = 70;
  
  ctx.lineWidth = 14;
  ctx.lineCap = 'butt';
  
  ctx.strokeStyle = '#d32f2f';
  ctx.beginPath(); ctx.arc(cx, cy, r, Math.PI * 0.85, Math.PI * 1.15); ctx.stroke();
  
  ctx.strokeStyle = '#00e676';
  ctx.beginPath(); ctx.arc(cx, cy, r, Math.PI * 1.15, Math.PI * 1.85); ctx.stroke();
  
  ctx.strokeStyle = '#d32f2f';
  ctx.beginPath(); ctx.arc(cx, cy, r, Math.PI * 1.85, Math.PI * 2.15); ctx.stroke();
  
  ctx.beginPath();
  ctx.arc(cx, cy, 10, 0, Math.PI * 2);
  ctx.fillStyle = '#334155';
  ctx.fill();
  ctx.strokeStyle = '#64748b';
  ctx.lineWidth = 2;
  ctx.stroke();
  
  const clampedVal = Math.max(0, Math.min(1, val));
  const needleAngle = Math.PI * 0.85 + clampedVal * (Math.PI * 1.3);
  
  ctx.beginPath();
  ctx.moveTo(cx, cy);
  ctx.lineTo(cx + Math.cos(needleAngle) * (r + 4), cy + Math.sin(needleAngle) * (r + 4));
  ctx.strokeStyle = '#f8fafc';
  ctx.lineWidth = 3.5;
  ctx.lineCap = 'round';
  ctx.stroke();
}

function renderGauges() {
  drawGauge(ctxPump, S.pumpSpeed / 100.0);
  drawGauge(ctxCore, S.TcoreGauge);
  drawGauge(ctxSteam, S.PsGauge);
}

/* ─────────────────────────────────────────────────────────────
   3D PLANT CANVAS RENDERER
   ───────────────────────────────────────────────────────────── */
function render3DPlant() {
  plantCtx.clearRect(0, 0, CW, CH);
  plantCtx.save();
  
  // Apply Zoom & Pan
  plantCtx.translate(CW/2 + S.panX, CH/2 + S.panY);
  plantCtx.scale(S.zoom, S.zoom);
  plantCtx.translate(-CW/2, -CH/2);
  
  if (S.viewMode === '2d') {
    draw2DPAndID();
    plantCtx.restore();
    return;
  }
  
  const t = S.t * 2.0;
  
  // 1. 4 Steam Generators
  draw3DSteamGenerator(160, 360, 68, 230, 'SG 1');
  draw3DSteamGenerator(270, 310, 68, 230, 'SG 2');
  draw3DSteamGenerator(420, 310, 68, 230, 'SG 3');
  draw3DSteamGenerator(530, 360, 68, 230, 'SG 4');
  
  // 2. Reactor Core (Center)
  draw3DReactorCore(350, 420);
  
  // 3. Pressuriser
  draw3DPressuriser(350, 210);
  
  // 4. 4 Reactor Coolant Pumps
  draw3DCoolantPump(200, 460);
  draw3DCoolantPump(280, 420);
  draw3DCoolantPump(420, 420);
  draw3DCoolantPump(500, 460);
  
  // 5. Primary Loops
  drawPrimaryPipes(t);
  
  // 6. Secondary Steam
  drawSecondarySteamPipes(t);
  
  // 7. Turbine - Generator Train
  draw3DTurbineGeneratorTrain(t);
  
  // 8. Condenser & Sea Cooling
  draw3DCondenserAndSea(t);
  
  // 9. Feedwater Return
  drawFeedwaterReturnPipes(t);
  
  // 10. Labels
  drawDiagramLabels();
  
  // 11. Virtual Tour Spotlight Beacon
  if (S.mode === 'tour') {
    drawTourSpotlight();
  }
  
  plantCtx.restore();
}

