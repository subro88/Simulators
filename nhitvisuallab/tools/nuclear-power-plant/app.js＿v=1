/* ── Web Audio Synthesizer ── */
let audioCtx = null, humOsc = null, humGain = null;

function initAudio() {
  if (audioCtx) return;
  try {
    const AudioContext = window.AudioContext || window.webkitAudioContext;
    audioCtx = new AudioContext();
    humOsc = audioCtx.createOscillator();
    humGain = audioCtx.createGain();
    humOsc.type = 'sawtooth';
    humOsc.frequency.setValueAtTime(50, audioCtx.currentTime);
    humGain.gain.setValueAtTime(0.0, audioCtx.currentTime);
    humOsc.connect(humGain);
    humGain.connect(audioCtx.destination);
    humOsc.start();
  } catch (e) {}
}

function updateAudio() {
  if (!audioCtx || S.audioMuted) {
    if (humGain) humGain.gain.setValueAtTime(0.0, audioCtx ? audioCtx.currentTime : 0);
    return;
  }
  const targetGain = S.pumpsOn ? (0.02 + (S.outputMW / 1500) * 0.04) : 0.005;
  humGain.gain.setValueAtTime(targetGain, audioCtx.currentTime);
}

