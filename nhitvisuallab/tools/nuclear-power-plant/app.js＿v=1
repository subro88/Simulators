function drawFlowPipe(pts, color, width, flowPhase, dashColor) {
  plantCtx.strokeStyle = '#0f172a';
  plantCtx.lineWidth = width + 4;
  plantCtx.lineCap = 'round';
  plantCtx.lineJoin = 'round';
  plantCtx.beginPath();
  plantCtx.moveTo(pts[0][0], pts[0][1]);
  for (let i = 1; i < pts.length; i++) plantCtx.lineTo(pts[i][0], pts[i][1]);
  plantCtx.stroke();
  
  plantCtx.strokeStyle = color;
  plantCtx.lineWidth = width;
  plantCtx.stroke();
  
  if (S.running && flowPhase !== 0) {
    plantCtx.strokeStyle = dashColor || '#ffffff';
    plantCtx.lineWidth = width * 0.55;
    plantCtx.setLineDash([8, 14]);
    plantCtx.lineDashOffset = -flowPhase * 30;
    plantCtx.stroke();
    plantCtx.setLineDash([]);
  }
}

