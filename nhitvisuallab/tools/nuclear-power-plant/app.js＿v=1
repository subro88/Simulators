/* ─── 3D Turbine - Generator Train ─── */
function draw3DTurbineGeneratorTrain(t) {
  plantCtx.fillStyle = '#94a3b8';
  plantCtx.fillRect(620, 312, 360, 8);
  plantCtx.strokeStyle = '#334155';
  plantCtx.lineWidth = 1;
  plantCtx.strokeRect(620, 312, 360, 8);
  
  const hx = 645, hy = 316;
  plantCtx.beginPath();
  plantCtx.moveTo(hx - 20, hy - 18);
  plantCtx.lineTo(hx + 20, hy - 26);
  plantCtx.lineTo(hx + 20, hy + 26);
  plantCtx.lineTo(hx - 20, hy + 18);
  plantCtx.closePath();
  
  const hpGrad = plantCtx.createLinearGradient(hx - 20, hy, hx + 20, hy);
  hpGrad.addColorStop(0, '#64748b');
  hpGrad.addColorStop(0.5, '#cbd5e1');
  hpGrad.addColorStop(1, '#475569');
  plantCtx.fillStyle = hpGrad;
  plantCtx.fill();
  plantCtx.strokeStyle = '#1e293b';
  plantCtx.lineWidth = 2;
  plantCtx.stroke();
  
  const lps = [720, 785, 850];
  const rotAngle = S.outputMW > 10 ? t * 8.0 : 0;
  
  for (let i = 0; i < 3; i++) {
    const lx = lps[i];
    plantCtx.beginPath();
    plantCtx.moveTo(lx - 22, hy - 32);
    plantCtx.lineTo(lx, hy - 18);
    plantCtx.lineTo(lx + 22, hy - 32);
    plantCtx.lineTo(lx + 22, hy + 32);
    plantCtx.lineTo(lx, hy + 18);
    plantCtx.lineTo(lx - 22, hy + 32);
    plantCtx.closePath();
    
    plantCtx.fillStyle = '#475569';
    plantCtx.fill();
    plantCtx.strokeStyle = '#0f172a';
    plantCtx.lineWidth = 2;
    plantCtx.stroke();
    
    for (let b = 0; b < 4; b++) {
      const a = rotAngle + (b / 4) * Math.PI * 2;
      plantCtx.strokeStyle = '#38bdf8';
      plantCtx.lineWidth = 2;
      plantCtx.beginPath();
      plantCtx.moveTo(lx, hy);
      plantCtx.lineTo(lx + Math.cos(a) * 18, hy + Math.sin(a) * 26);
      plantCtx.stroke();
    }
  }
  
  const gx = 930, gy = hy, gw = 70, gh = 46;
  plantCtx.beginPath();
  plantCtx.roundRect(gx - gw/2, gy - gh/2, gw, gh, 8);
  
  const genGrad = plantCtx.createLinearGradient(gx - gw/2, gy, gx + gw/2, gy);
  genGrad.addColorStop(0, '#b45309');
  genGrad.addColorStop(0.3, '#f59e0b');
  genGrad.addColorStop(0.7, '#fbbf24');
  genGrad.addColorStop(1, '#92400e');
  plantCtx.fillStyle = genGrad;
  plantCtx.fill();
  plantCtx.strokeStyle = '#451a03';
  plantCtx.lineWidth = 2;
  plantCtx.stroke();
  
  for (let w = 1; w < 6; w++) {
    const wx = gx - gw/2 + w * (gw / 6);
    plantCtx.strokeStyle = '#78350f';
    plantCtx.lineWidth = 2;
    plantCtx.beginPath();
    plantCtx.moveTo(wx, gy - gh/2 + 2);
    plantCtx.lineTo(wx, gy + gh/2 - 2);
    plantCtx.stroke();
  }
}

