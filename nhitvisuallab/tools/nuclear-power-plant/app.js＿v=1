/* ─── 3D Reactor Core with Moving Control Rods ─── */
function draw3DReactorCore(cx, cy) {
  const cw = 75, ch = 130;
  
  plantCtx.beginPath();
  plantCtx.roundRect(cx - cw/2, cy - ch/2, cw, ch - 15, [10, 10, 0, 0]);
  plantCtx.arc(cx, cy + ch/2 - 15, cw/2, 0, Math.PI);
  plantCtx.closePath();
  
  const rpvGrad = plantCtx.createLinearGradient(cx - cw/2, cy, cx + cw/2, cy);
  rpvGrad.addColorStop(0, '#334155');
  rpvGrad.addColorStop(0.3, '#64748b');
  rpvGrad.addColorStop(0.7, '#94a3b8');
  rpvGrad.addColorStop(1, '#1e293b');
  plantCtx.fillStyle = rpvGrad;
  plantCtx.fill();
  plantCtx.strokeStyle = '#0f172a';
  plantCtx.lineWidth = 2.5;
  plantCtx.stroke();
  
  for (let r = 0; r < 5; r++) {
    const rx = cx - 24 + r * 12;
    plantCtx.strokeStyle = '#1e293b';
    plantCtx.lineWidth = 2;
    plantCtx.beginPath();
    plantCtx.moveTo(rx, cy - ch/2 + 20);
    plantCtx.lineTo(rx, cy + ch/2 - 20);
    plantCtx.stroke();
  }
  
  plantCtx.fillStyle = '#0f172a';
  plantCtx.fillRect(cx - cw/2 - 2, cy + 20, cw + 4, 12);
  
  // Moving Control Rods
  const rodLift = (S.rodActual / 100.0) * 35;
  const rodBaseY = cy - ch/2 - 15 - rodLift;
  
  plantCtx.fillStyle = '#f8fafc';
  plantCtx.strokeStyle = '#94a3b8';
  plantCtx.lineWidth = 1;
  for (let i = 0; i < 9; i++) {
    const rx = cx - 28 + i * 7;
    plantCtx.fillRect(rx, rodBaseY, 4, 38 + rodLift);
    plantCtx.strokeRect(rx, rodBaseY, 4, 38 + rodLift);
  }
  
  plantCtx.fillStyle = '#cbd5e1';
  plantCtx.fillRect(cx - 32, rodBaseY - 6, 64, 8);
  plantCtx.strokeStyle = '#64748b';
  plantCtx.strokeRect(cx - 32, rodBaseY - 6, 64, 8);
  
  // Cherenkov Glow
  const coreGlow = plantCtx.createRadialGradient(cx, cy + 15, 2, cx, cy + 15, 30);
  const tempFrac = S.TcoreGauge;
  coreGlow.addColorStop(0, `rgba(0, 229, 255, ${0.8 * tempFrac})`);
  coreGlow.addColorStop(0.6, `rgba(2, 136, 209, ${0.4 * tempFrac})`);
  coreGlow.addColorStop(1, 'rgba(0, 0, 0, 0)');
  plantCtx.fillStyle = coreGlow;
  plantCtx.fillRect(cx - cw/2 + 6, cy - 20, cw - 12, 60);
}

/* ─── 3D Pressuriser ─── */
function draw3DPressuriser(px, py) {
  const pw = 40, ph = 140;
  plantCtx.beginPath();
  plantCtx.roundRect(px - pw/2, py - ph/2, pw, ph, 18);
  
  const pzrGrad = plantCtx.createLinearGradient(px - pw/2, py, px + pw/2, py);
  pzrGrad.addColorStop(0, '#475569');
  pzrGrad.addColorStop(0.4, '#94a3b8');
  pzrGrad.addColorStop(1, '#334155');
  plantCtx.fillStyle = pzrGrad;
  plantCtx.fill();
  plantCtx.strokeStyle = '#1e293b';
  plantCtx.lineWidth = 2;
  plantCtx.stroke();
  
  plantCtx.beginPath();
  plantCtx.arc(px, py - ph/2 + 10, 12, 0, Math.PI * 2);
  plantCtx.fillStyle = '#64748b';
  plantCtx.fill();
}

/* ─── 3D Steam Generator Tower ─── */
function draw3DSteamGenerator(sx, sy, sw, sh, label) {
  const lowerH = sh * 0.58;
  const lowerY = sy + sh/2 - lowerH;
  
  plantCtx.beginPath();
  plantCtx.roundRect(sx - sw/2, lowerY, sw, lowerH, [0, 0, 8, 8]);
  const sgGrad = plantCtx.createLinearGradient(sx - sw/2, sy, sx + sw/2, sy);
  sgGrad.addColorStop(0, '#7c2d12');
  sgGrad.addColorStop(0.3, '#c2410c');
  sgGrad.addColorStop(0.7, '#ea580c');
  sgGrad.addColorStop(1, '#9a3412');
  plantCtx.fillStyle = sgGrad;
  plantCtx.fill();
  plantCtx.strokeStyle = '#431407';
  plantCtx.lineWidth = 2;
  plantCtx.stroke();
  
  for (let r = 1; r < 4; r++) {
    const ry = lowerY + r * (lowerH / 4);
    plantCtx.strokeStyle = '#431407';
    plantCtx.lineWidth = 2;
    plantCtx.beginPath();
    plantCtx.moveTo(sx - sw/2, ry); plantCtx.lineTo(sx + sw/2, ry);
    plantCtx.stroke();
  }
  
  const midY = lowerY - 26;
  plantCtx.fillStyle = '#475569';
  plantCtx.fillRect(sx - sw/2 - 4, midY, sw + 8, 26);
  plantCtx.strokeStyle = '#1e293b';
  plantCtx.strokeRect(sx - sw/2 - 4, midY, sw + 8, 26);
  
  for (let i = 0; i < 7; i++) {
    const tx = sx - sw/2 + 6 + i * 8;
    plantCtx.fillStyle = '#cbd5e1';
    plantCtx.fillRect(tx, midY + 3, 4, 20);
  }
  
  const topH = sh * 0.32;
